        function get_exact_suffix_first_unit_for_context_local(
            const suffix_pos: Integer): string;
        const
            c_probe_limit = 4;
        var
            cached_text: string;
            span_len: Integer;
            query_key: string;
            lookup_results: TncCandidateList;
            single_results: TncCandidateList;
            result_idx: Integer;
            span_text: string;
            single_key: string;
        begin
            Result := '';
            if (suffix_pos < 0) or (suffix_pos >= Length(exact_syllables)) then
            begin
                Exit;
            end;
            if (exact_suffix_first_unit_cache <> nil) and
                exact_suffix_first_unit_cache.TryGetValue(suffix_pos,
                cached_text) then
            begin
                Exit(cached_text);
            end;

            for span_len := Min(4, Length(exact_syllables) - suffix_pos) downto 2 do
            begin
                query_key := build_exact_syllable_text(suffix_pos, span_len);
                if (query_key = '') or
                    (not dictionary_exact_lookup_cached(query_key, lookup_results)) then
                begin
                    Continue;
                end;
                for result_idx := 0 to High(lookup_results) do
                begin
                    if result_idx >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(lookup_results[result_idx]) or
                        is_runtime_common_pattern_candidate(
                        lookup_results[result_idx]) or
                        is_runtime_redup_candidate(lookup_results[result_idx]) then
                    begin
                        Continue;
                    end;
                    span_text := Trim(lookup_results[result_idx].text);
                    if get_candidate_text_unit_count(span_text) <> span_len then
                    begin
                        Continue;
                    end;
                    Result := exact_first_text_unit_local(span_text);
                    Break;
                end;
                if Result <> '' then
                begin
                    Break;
                end;
            end;

            if Result = '' then
            begin
                single_key := normalize_pinyin_text(
                    exact_syllables[suffix_pos].text);
                if (single_key <> '') and (m_dictionary <> nil) then
                begin
                    m_dictionary.lookup(single_key, single_results);
                    for result_idx := 0 to High(single_results) do
                    begin
                        if result_idx >= c_probe_limit then
                        begin
                            Break;
                        end;
                        span_text := Trim(single_results[result_idx].text);
                        if (Trim(single_results[result_idx].comment) = '') and
                            (get_candidate_text_unit_count(span_text) = 1) then
                        begin
                            Result := exact_first_text_unit_local(span_text);
                            Break;
                        end;
                    end;
                end;
            end;
            if exact_suffix_first_unit_cache <> nil then
            begin
                exact_suffix_first_unit_cache.AddOrSetValue(suffix_pos, Result);
            end;
        end;

        function get_exact_yu_context_adjustment_local(
            const segment_last_syllable: string; const candidate_text: string;
            const suffix_pos: Integer): Integer;
        var
            normalized_tail_syllable: string;
            candidate_last_unit: string;
            suffix_first_unit: string;
            suffix_is_predicate: Boolean;
            suffix_is_location: Boolean;
            suffix_is_nominal: Boolean;
        begin
            Result := 0;
            normalized_tail_syllable := normalize_pinyin_text(segment_last_syllable);
            candidate_last_unit := exact_last_text_unit_local(candidate_text);
            if candidate_last_unit = '' then
            begin
                Exit;
            end;

            suffix_first_unit := get_exact_suffix_first_unit_for_context_local(
                suffix_pos);
            suffix_is_predicate := is_exact_predicate_head_unit_local(
                suffix_first_unit);
            suffix_is_location := is_exact_location_head_unit_local(
                suffix_first_unit);
            suffix_is_nominal := suffix_is_location or
                is_exact_nominal_head_unit_local(suffix_first_unit);

            if normalized_tail_syllable = 'yu' then
            begin
                if exact_unit_code_local(candidate_last_unit, $4E8E) and
                    (suffix_is_location or suffix_is_nominal) then
                begin
                    Inc(Result, 2600);
                end
                else if exact_unit_code_local(candidate_last_unit, $4E0E) and
                    suffix_is_location then
                begin
                    Dec(Result, 2600);
                end;
            end
            else if normalized_tail_syllable = 'de' then
            begin
                if exact_unit_code_local(candidate_last_unit, $5730) then
                begin
                    if suffix_is_predicate then
                    begin
                        Inc(Result, 3200);
                    end
                    else if suffix_is_nominal then
                    begin
                        Dec(Result, 4200);
                    end;
                    if suffix_first_unit = '' then
                    begin
                        Dec(Result, 1600);
                    end;
                end
                else if exact_unit_code_local(candidate_last_unit, $7684) then
                begin
                    if suffix_is_predicate then
                    begin
                        Dec(Result, 2200);
                    end
                    else if suffix_is_nominal then
                    begin
                        Inc(Result, 2600);
                    end;
                    if suffix_first_unit = '' then
                    begin
                        Inc(Result, 1400);
                    end;
                end
                else if exact_unit_code_local(candidate_last_unit, $5F97) and
                    suffix_is_predicate then
                begin
                    Inc(Result, 2200);
                end;
            end
            else if normalized_tail_syllable = 'zai' then
            begin
                if exact_unit_code_local(candidate_last_unit, $5728) and
                    (suffix_is_location or suffix_is_nominal) then
                begin
                    Inc(Result, 2200);
                end
                else if exact_unit_code_local(candidate_last_unit, $518D) and
                    suffix_is_location then
                begin
                    Dec(Result, 2200);
                end;
            end
            else if normalized_tail_syllable = 'dao' then
            begin
                if exact_unit_code_local(candidate_last_unit, $5230) and
                    (suffix_is_location or suffix_is_predicate) then
                begin
                    Inc(Result, 1800);
                end
                else if exact_unit_code_local(candidate_last_unit, $9053) and
                    suffix_is_location then
                begin
                    Dec(Result, 1800);
                end;
            end;
        end;

        function try_get_protected_exact_span_local(const span_start: Integer;
            const span_len: Integer; out out_text: string; out out_weight: Integer;
            out out_rank: Integer): Boolean;
        const
            c_probe_limit = 8;
        var
            cache_key: string;
            query_key: string;
            span_results: TncCandidateList;
            span_idx: Integer;
            span_text: string;
            span_units: Integer;
            span_weight: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            out_rank := 0;
            if (span_start < 0) or (span_len < 2) or
                (span_len > c_long_sentence_protected_span_max_len) or
                (span_start + span_len > Length(exact_syllables)) then
            begin
                Exit;
            end;

            cache_key := IntToStr(span_start) + ':' + IntToStr(span_len);
            if (exact_protected_span_weight_cache <> nil) and
                exact_protected_span_weight_cache.TryGetValue(cache_key, out_weight) then
            begin
                if out_weight <= 0 then
                begin
                    Exit(False);
                end;
                if exact_protected_span_text_cache <> nil then
                begin
                    exact_protected_span_text_cache.TryGetValue(cache_key, out_text);
                end;
                if exact_protected_span_rank_cache <> nil then
                begin
                    exact_protected_span_rank_cache.TryGetValue(cache_key, out_rank);
                end;
                Exit(out_text <> '');
            end;

            query_key := build_exact_syllable_text(span_start, span_len);
            if (query_key = '') or
                (not dictionary_exact_lookup_cached(query_key, span_results)) then
            begin
                if exact_protected_span_weight_cache <> nil then
                begin
                    exact_protected_span_weight_cache.AddOrSetValue(cache_key, -1);
                end;
                Exit;
            end;

            for span_idx := 0 to High(span_results) do
            begin
                if span_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(span_results[span_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(span_results[span_idx]) or
                    is_runtime_common_pattern_candidate(span_results[span_idx]) or
                    is_runtime_redup_candidate(span_results[span_idx]) then
                begin
                    Continue;
                end;

                span_text := Trim(span_results[span_idx].text);
                span_units := get_candidate_text_unit_count(span_text);
                if span_units <> span_len then
                begin
                    Continue;
                end;

                span_weight := get_candidate_raw_weight_local(span_results[span_idx]);
                if span_weight < c_long_sentence_protected_span_min_weight then
                begin
                    Continue;
                end;

                out_text := span_text;
                out_weight := span_weight;
                out_rank := span_idx + 1;
                Result := True;
                Break;
            end;

            if exact_protected_span_weight_cache <> nil then
            begin
                if Result then
                begin
                    exact_protected_span_weight_cache.AddOrSetValue(cache_key,
                        out_weight);
                    if exact_protected_span_text_cache <> nil then
                    begin
                        exact_protected_span_text_cache.AddOrSetValue(cache_key,
                            out_text);
                    end;
                    if exact_protected_span_rank_cache <> nil then
                    begin
                        exact_protected_span_rank_cache.AddOrSetValue(cache_key,
                            out_rank);
                    end;
                end
                else
                begin
                    exact_protected_span_weight_cache.AddOrSetValue(cache_key, -1);
                end;
            end;
        end;

        function get_protected_exact_span_adjustment_local(
            const segment_start: Integer; const segment_syllables: Integer;
            const candidate_text: string): Integer;
        var
            span_start: Integer;
            span_len: Integer;
            span_end: Integer;
            segment_end: Integer;
            protected_text: string;
            protected_weight: Integer;
            protected_rank: Integer;
            overlap_penalty: Integer;
            exact_bonus: Integer;

            function is_confident_protected_exact_span_local(
                const span_len_value: Integer; const span_weight_value: Integer;
                const span_rank_value: Integer): Boolean;
            begin
                Result := False;
                if span_rank_value <= 0 then
                begin
                    Exit;
                end;

                if span_rank_value = 1 then
                begin
                    case span_len_value of
                        2:
                            Result := span_weight_value >= 650;
                        3:
                            Result := span_weight_value >= 420;
                        4:
                            Result := span_weight_value >= 360;
                    end;
                end
                else if (span_rank_value = 2) and (span_len_value >= 3) then
                begin
                    Result := span_weight_value >= 900;
                end;
            end;

            function candidate_matches_protected_overlap_local(
                const protected_start: Integer; const protected_len: Integer;
                const protected_value: string): Boolean;
            var
                candidate_units: TArray<string>;
                protected_units: TArray<string>;
                overlap_start: Integer;
                overlap_end: Integer;
                unit_pos: Integer;
            begin
                Result := False;
                candidate_units := split_text_units(Trim(candidate_text));
                protected_units := split_text_units(Trim(protected_value));
                if (Length(candidate_units) <> segment_syllables) or
                    (Length(protected_units) <> protected_len) then
                begin
                    Exit;
                end;

                overlap_start := Max(segment_start, protected_start);
                overlap_end := Min(segment_start + segment_syllables,
                    protected_start + protected_len);
                if overlap_start >= overlap_end then
                begin
                    Exit(True);
                end;

                for unit_pos := overlap_start to overlap_end - 1 do
                begin
                    if not SameText(candidate_units[unit_pos - segment_start],
                        protected_units[unit_pos - protected_start]) then
                    begin
                        Exit(False);
                    end;
                end;
                Result := True;
            end;
        begin
            Result := 0;
            if (segment_start < 0) or (segment_syllables <= 0) or
                (candidate_text = '') then
            begin
                Exit;
            end;

            segment_end := segment_start + segment_syllables;

            if (segment_syllables >= 2) and
                try_get_protected_exact_span_local(segment_start, segment_syllables,
                protected_text, protected_weight, protected_rank) and
                is_confident_protected_exact_span_local(segment_syllables,
                protected_weight, protected_rank) and
                SameText(protected_text, candidate_text) then
            begin
                exact_bonus := 180 + (segment_syllables * 90) +
                    Min(620, protected_weight div 2);
                if protected_rank > 1 then
                begin
                    Dec(exact_bonus, (protected_rank - 1) * 160);
                end;
                if exact_bonus > 0 then
                begin
                    Inc(Result, exact_bonus);
                end;
            end;

            for span_start := Max(0, segment_start -
                (c_long_sentence_protected_span_max_len - 1)) to
                Min(segment_end - 1, Length(exact_syllables) - 1) do
            begin
                for span_len := 2 to c_long_sentence_protected_span_max_len do
                begin
                    span_end := span_start + span_len;
                    if span_end > Length(exact_syllables) then
                    begin
                        Break;
                    end;
                    if (span_start = segment_start) and
                        (span_len = segment_syllables) then
                    begin
                        Continue;
                    end;
                    if (span_start >= segment_end) or (segment_start >= span_end) then
                    begin
                        Continue;
                    end;
                    if (Min(segment_end, span_end) -
                        Max(segment_start, span_start)) <= 0 then
                    begin
                        Continue;
                    end;
                    if not try_get_protected_exact_span_local(span_start, span_len,
                        protected_text, protected_weight, protected_rank) then
                    begin
                        Continue;
                    end;
                    if not is_confident_protected_exact_span_local(span_len,
                        protected_weight, protected_rank) then
                    begin
                        Continue;
                    end;
                    if SameText(protected_text, candidate_text) then
                    begin
                        Continue;
                    end;
                    if candidate_matches_protected_overlap_local(span_start,
                        span_len, protected_text) then
                    begin
                        Continue;
                    end;

                    overlap_penalty := 260 + (span_len * 110) +
                        ((Min(segment_end, span_end) -
                        Max(segment_start, span_start)) * 180) +
                        Min(1200, protected_weight);
                    if protected_rank > 1 then
                    begin
                        Dec(overlap_penalty, (protected_rank - 1) * 260);
                    end;
                    if overlap_penalty > 0 then
                    begin
                        Dec(Result, overlap_penalty);
                    end;
                end;
            end;
        end;

        function get_exact_phrase_bridge_bonus_local(const left_pinyin: string;
            const left_text: string; const right_pinyin: string;
            const right_text: string): Integer;
        var
            cache_key: string;
            combined_pinyin: string;
            combined_text: string;
            bridge_results: TncCandidateList;
            bridge_idx: Integer;
            bridge_effective_weight: Integer;
        begin
            Result := 0;
            if (Trim(left_pinyin) = '') or (Trim(left_text) = '') or
                (Trim(right_pinyin) = '') or (Trim(right_text) = '') then
            begin
                Exit;
            end;

            combined_pinyin := normalize_pinyin_text(left_pinyin + right_pinyin);
            combined_text := Trim(left_text) + Trim(right_text);
            if (combined_pinyin = '') or (combined_text = '') then
            begin
                Exit;
            end;

            cache_key := combined_pinyin + #1 + combined_text;
            if (exact_bridge_bonus_cache <> nil) and
                exact_bridge_bonus_cache.TryGetValue(cache_key, Result) then
            begin
                Exit;
            end;

            if dictionary_exact_lookup_cached(combined_pinyin, bridge_results) then
            begin
                for bridge_idx := 0 to High(bridge_results) do
                begin
                    if bridge_results[bridge_idx].comment <> '' then
                    begin
                        Continue;
                    end;
                    if not SameText(Trim(bridge_results[bridge_idx].text), combined_text) then
                    begin
                        Continue;
                    end;

                    if bridge_results[bridge_idx].source = cs_user then
                    begin
                        Result := c_long_sentence_bridge_bonus_top;
                    end
                    else
                    begin
                        bridge_effective_weight := get_candidate_effective_weight_local(
                            bridge_results[bridge_idx]);
                        if bridge_effective_weight >= 760 then
                        begin
                            Result := c_long_sentence_bridge_bonus_top;
                        end
                        else if bridge_effective_weight >= 560 then
                        begin
                            Result := c_long_sentence_bridge_bonus_high;
                        end
                        else if bridge_effective_weight >= 360 then
                        begin
                            Result := c_long_sentence_bridge_bonus_mid;
                        end
                        else
                        begin
                            Result := c_long_sentence_bridge_bonus_low;
                        end;
                    end;
                    Break;
                end;
            end;

            if exact_bridge_bonus_cache <> nil then
            begin
                exact_bridge_bonus_cache.AddOrSetValue(cache_key, Result);
            end;
        end;

        function get_exact_query_choice_bonus_local(const query_key: string;
            const candidate_text: string): Integer;
        const
            c_single_query_base = 44;
            c_single_query_step = 34;
            c_single_query_cap = 176;
            c_multi_query_base = 96;
            c_multi_query_step = 56;
            c_multi_query_cap = 980;
            c_query_recent_latest = 900;
            c_query_recent_top = 180;
            c_query_recent_mid = 96;
            c_query_recent_tail = 52;
        var
            key: string;
            count: Integer;
            last_seen_serial: Int64;
            recent_bonus: Integer;
            serial_gap: Int64;
            text_units: Integer;
        begin
            Result := 0;
            key := build_session_query_choice_key(normalize_pinyin_text(query_key), candidate_text);
            if (key = '') or (candidate_text = '') then
            begin
                Exit;
            end;

            count := 0;
            last_seen_serial := 0;
            serial_gap := High(Int64);
            if (m_session_query_choice_counts <> nil) and
                m_session_query_choice_counts.TryGetValue(key, count) and (count > 0) then
            begin
                if (m_session_query_choice_last_seen <> nil) and
                    m_session_query_choice_last_seen.TryGetValue(key, last_seen_serial) and
                    (last_seen_serial > 0) and (m_session_commit_serial >= last_seen_serial) then
                begin
                    serial_gap := m_session_commit_serial - last_seen_serial;
                end;

                recent_bonus := 0;
                if serial_gap = 0 then
                begin
                    recent_bonus := c_query_recent_latest;
                end
                else if serial_gap <= 1 then
                begin
                    recent_bonus := c_query_recent_top;
                end
                else if serial_gap <= 3 then
                begin
                    recent_bonus := c_query_recent_mid;
                end
                else if serial_gap <= 6 then
                begin
                    recent_bonus := c_query_recent_tail;
                end;

                text_units := get_candidate_text_unit_count(Trim(candidate_text));
                if text_units <= 1 then
                begin
                    Result := c_single_query_base + ((count - 1) * c_single_query_step) +
                        (recent_bonus div 3);
                    if count >= 3 then
                    begin
                        Inc(Result, 18);
                    end;
                    if Result > c_single_query_cap then
                    begin
                        Result := c_single_query_cap;
                    end;
                end
                else
                begin
                    Result := c_multi_query_base + ((count - 1) * c_multi_query_step) +
                        recent_bonus;
                    if (count >= 2) and (serial_gap <= 2) then
                    begin
                        Inc(Result, 56);
                    end;
                    if (count >= 3) and (serial_gap <= 4) then
                    begin
                        Inc(Result, 32);
                    end;
                    if Result > c_multi_query_cap then
                    begin
                        Result := c_multi_query_cap;
                    end;
                end;
                Exit;
            end;

            if m_dictionary <> nil then
            begin
                Result := m_dictionary.get_query_choice_bonus(normalize_pinyin_text(query_key),
                    candidate_text);
            end;
        end;

        function is_exact_latest_query_choice_local(const query_key: string;
            const candidate_text: string): Boolean;
        var
            latest_text: string;
            normalized_query: string;
        begin
            Result := False;
            normalized_query := normalize_pinyin_text(query_key);
            if (normalized_query = '') or (candidate_text = '') then
            begin
                Exit;
            end;

            latest_text := '';
            if (m_session_query_latest_text <> nil) and
                m_session_query_latest_text.TryGetValue(normalized_query, latest_text) then
            begin
                Result := SameText(Trim(candidate_text), Trim(latest_text));
                if Result then
                begin
                    Exit;
                end;
            end;

            if m_dictionary <> nil then
            begin
                latest_text := get_cached_query_latest_choice_text(normalized_query);
                Result := SameText(Trim(candidate_text), latest_text);
            end;
        end;

        function get_exact_context_pair_bonus(const left_text: string;
            const candidate_text: string): Integer;
        const
            c_segment_pair_context_cap = 520;
            c_segment_pair_bonus_scale = 75;
        var
            pair_key: string;
            local_bonus: Integer;
            persistent_bonus: Integer;
            secondary_bonus: Integer;
            count: Integer;
        begin
            Result := 0;
            if (left_text = '') or (candidate_text = '') then
            begin
                Exit;
            end;

            local_bonus := 0;
            persistent_bonus := 0;
            if m_context_pairs <> nil then
            begin
                pair_key := left_text + #1 + candidate_text;
                if m_context_pairs.TryGetValue(pair_key, count) and (count > 0) then
                begin
                    local_bonus := count * c_context_score_bonus;
                    if local_bonus > c_context_score_bonus_max then
                    begin
                        local_bonus := c_context_score_bonus_max;
                    end;
                end;
            end;

            if m_dictionary <> nil then
            begin
                persistent_bonus := m_dictionary.get_context_bonus(left_text, candidate_text);
            end;

            if local_bonus >= persistent_bonus then
            begin
                Result := local_bonus;
                secondary_bonus := persistent_bonus;
            end
            else
            begin
                Result := persistent_bonus;
                secondary_bonus := local_bonus;
            end;

            if secondary_bonus > 0 then
            begin
                Inc(Result, secondary_bonus div 2);
            end;
            if Result > c_segment_pair_context_cap then
            begin
                Result := c_segment_pair_context_cap;
            end;
            Result := (Result * c_segment_pair_bonus_scale) div 100;
        end;

        function get_phrase_trigram_transition_bonus(const prev_prev_text: string;
            const prev_text: string; const candidate_text: string): Integer;
        const
            c_segment_trigram_step = 96;
            c_segment_trigram_cap = 300;
            c_segment_trigram_recent_top = 140;
            c_segment_trigram_recent_mid = 84;
            c_segment_trigram_recent_tail = 40;
        var
            trigram_key: string;
            trigram_count: Integer;
            last_seen_serial: Int64;
            serial_gap: Int64;
        begin
            Result := 0;
            if (prev_prev_text = '') or (prev_text = '') or (candidate_text = '') or
                (m_phrase_context_pairs = nil) then
            begin
                Exit;
            end;

            trigram_key := prev_prev_text + #2 + prev_text + #1 + candidate_text;
            if (not m_phrase_context_pairs.TryGetValue(trigram_key, trigram_count)) or
                (trigram_count <= 0) then
            begin
                Exit;
            end;

            Result := trigram_count * c_segment_trigram_step;
            if Result > c_segment_trigram_cap then
            begin
                Result := c_segment_trigram_cap;
            end;

            if (m_phrase_context_last_seen <> nil) and
                m_phrase_context_last_seen.TryGetValue(trigram_key, last_seen_serial) and
                (last_seen_serial > 0) and (m_session_commit_serial >= last_seen_serial) then
            begin
                serial_gap := m_session_commit_serial - last_seen_serial;
                if serial_gap <= 1 then
                begin
                    Inc(Result, c_segment_trigram_recent_top);
                end
                else if serial_gap <= 3 then
                begin
                    Inc(Result, c_segment_trigram_recent_mid);
                end
                else if serial_gap <= 6 then
                begin
                    Inc(Result, c_segment_trigram_recent_tail);
                end;
            end;
        end;

        function get_compound_prev_trigram_bonus(const combined_prev_text: string;
            const candidate_text: string): Integer;
        var
            combined_units: TArray<string>;
            split_idx: Integer;
            unit_idx: Integer;
            left_part: string;
            right_part: string;
            local_session_bonus: Integer;
            local_persistent_bonus: Integer;
            local_secondary_bonus: Integer;
            local_bonus: Integer;
        begin
            Result := 0;
            if (combined_prev_text = '') or (candidate_text = '') then
            begin
                Exit;
            end;

            combined_units := split_text_units(combined_prev_text);
            if Length(combined_units) < 2 then
            begin
                Exit;
            end;

            for split_idx := 1 to High(combined_units) do
            begin
                left_part := '';
                for unit_idx := 0 to split_idx - 1 do
                begin
                    left_part := left_part + combined_units[unit_idx];
                end;

                right_part := '';
                for unit_idx := split_idx to High(combined_units) do
                begin
                    right_part := right_part + combined_units[unit_idx];
                end;

                if (left_part = '') or (right_part = '') then
                begin
                    Continue;
                end;

                local_session_bonus := get_phrase_trigram_transition_bonus(
                    left_part, right_part, candidate_text);
                local_persistent_bonus := 0;
                if m_dictionary <> nil then
                begin
                    local_persistent_bonus := m_dictionary.get_context_trigram_bonus(
                        left_part, right_part, candidate_text);
                end;

                if local_session_bonus >= local_persistent_bonus then
                begin
                    local_bonus := local_session_bonus;
                    local_secondary_bonus := local_persistent_bonus;
                end
                else
                begin
                    local_bonus := local_persistent_bonus;
                    local_secondary_bonus := local_session_bonus;
                end;

                if local_secondary_bonus > 0 then
                begin
                    Inc(local_bonus, local_secondary_bonus div 2);
                end;

                if local_bonus > Result then
                begin
                    Result := local_bonus;
                end;
            end;
        end;

        function take_trailing_text_units_local(const value: string;
            const max_units: Integer): string;
        var
            units: TArray<string>;
            unit_idx: Integer;
            start_idx: Integer;
        begin
            Result := '';
            if (Trim(value) = '') or (max_units <= 0) then
            begin
                Exit;
            end;

            units := split_text_units(Trim(value));
            if Length(units) <= 0 then
            begin
                Exit;
            end;

            start_idx := Length(units) - max_units;
            if start_idx < 0 then
            begin
                start_idx := 0;
            end;

            for unit_idx := start_idx to High(units) do
            begin
                Result := Result + units[unit_idx];
            end;
        end;

        function get_exact_base_prefix_transition_bonus_local(
            const prev_prev_text: string; const prev_text: string;
            const candidate_text: string): Integer;
        const
            c_prefix_bonus_cap = 2200;
        var
            combined_text: string;
            raw_bonus: Integer;
            best_bonus: Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (Trim(prev_text) = '') or
                (Trim(candidate_text) = '') then
            begin
                Exit;
            end;

            best_bonus := 0;

            combined_text := take_trailing_text_units_local(
                Trim(prev_text) + Trim(candidate_text), 6);
            if get_candidate_text_unit_count(combined_text) >= 2 then
            begin
                raw_bonus := get_sentence_text_prefix_bonus_local(combined_text);
                if raw_bonus > best_bonus then
                begin
                    best_bonus := raw_bonus;
                end;
            end;

            if Trim(prev_prev_text) <> '' then
            begin
                combined_text := take_trailing_text_units_local(
                    Trim(prev_prev_text) + Trim(prev_text) + Trim(candidate_text), 6);
                if get_candidate_text_unit_count(combined_text) >= 2 then
                begin
                    raw_bonus := get_sentence_text_prefix_bonus_local(combined_text);
                    if raw_bonus > best_bonus then
                    begin
                        best_bonus := raw_bonus;
                    end;
                end;
            end;

            if best_bonus > 0 then
            begin
                Result := Min(c_prefix_bonus_cap, (best_bonus * 3) div 4);
            end;
        end;

        function get_exact_structural_transition_bonus_local(
            const prev_text: string; const candidate_text: string): Integer;
        var
            prev_last_unit: string;
            candidate_first_unit: string;
            candidate_is_predicate: Boolean;
            candidate_is_location: Boolean;
            candidate_is_nominal: Boolean;
        begin
            Result := 0;
            prev_last_unit := exact_last_text_unit_local(prev_text);
            candidate_first_unit := exact_first_text_unit_local(candidate_text);
            if (prev_last_unit = '') or (candidate_first_unit = '') then
            begin
                Exit;
            end;

            candidate_is_predicate := is_exact_predicate_head_unit_local(
                candidate_first_unit);
            candidate_is_location := is_exact_location_head_unit_local(
                candidate_first_unit);
            candidate_is_nominal := candidate_is_location or
                is_exact_nominal_head_unit_local(candidate_first_unit);

            if exact_unit_code_local(prev_last_unit, $4E8E) then
            begin
                if candidate_is_location or candidate_is_nominal then
                begin
                    Inc(Result, 5200);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $4E0E) then
            begin
                if candidate_is_location then
                begin
                    Dec(Result, 2600);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $5728) then
            begin
                if candidate_is_location or candidate_is_nominal then
                begin
                    Inc(Result, 2800);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $518D) then
            begin
                if candidate_is_location then
                begin
                    Dec(Result, 2400);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $5730) then
            begin
                if candidate_is_predicate then
                begin
                    Inc(Result, 4200);
                end
                else if candidate_is_nominal then
                begin
                    Dec(Result, 3600);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $7684) then
            begin
                if candidate_is_predicate then
                begin
                    Dec(Result, 1800);
                end
                else if candidate_is_nominal then
                begin
                    Inc(Result, 2600);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $5230) then
            begin
                if candidate_is_location or candidate_is_predicate then
                begin
                    Inc(Result, 2400);
                end;
            end
            else if exact_unit_code_local(prev_last_unit, $9053) then
            begin
                if candidate_is_location then
                begin
                    Dec(Result, 1800);
                end;
            end;
        end;

        function get_path_transition_bonus(const prev_prev_text: string;
            const prev_text: string; const candidate_text: string): Integer;
        var
            pair_bonus: Integer;
            trigram_bonus: Integer;
            persistent_trigram_bonus: Integer;
            compound_prev_trigram_bonus: Integer;
            prefix_bonus: Integer;
            structural_bonus: Integer;
            secondary_bonus: Integer;
        begin
            Result := 0;
            if (prev_text = '') or (candidate_text = '') then
            begin
                Exit;
            end;

            pair_bonus := get_exact_context_pair_bonus(prev_text, candidate_text);
            trigram_bonus := get_phrase_trigram_transition_bonus(prev_prev_text, prev_text,
                candidate_text);
            persistent_trigram_bonus := 0;
            if (prev_prev_text <> '') and (m_dictionary <> nil) then
            begin
                persistent_trigram_bonus := m_dictionary.get_context_trigram_bonus(
                    prev_prev_text, prev_text, candidate_text);
            end;
            compound_prev_trigram_bonus := 0;
            if prev_prev_text = '' then
            begin
                compound_prev_trigram_bonus := get_compound_prev_trigram_bonus(
                    prev_text, candidate_text);
            end;

            if trigram_bonus >= persistent_trigram_bonus then
            begin
                Result := trigram_bonus;
                secondary_bonus := persistent_trigram_bonus;
            end
            else
            begin
                Result := persistent_trigram_bonus;
                secondary_bonus := trigram_bonus;
            end;

            if secondary_bonus > 0 then
            begin
                Inc(Result, secondary_bonus div 2);
            end;
            if compound_prev_trigram_bonus > Result then
            begin
                Result := compound_prev_trigram_bonus;
            end;

            if Result > 0 then
            begin
                Inc(Result, pair_bonus div 2);
            end
            else
            begin
                Result := pair_bonus;
            end;

            prefix_bonus := get_exact_base_prefix_transition_bonus_local(
                prev_prev_text, prev_text, candidate_text);
            if prefix_bonus > 0 then
            begin
                if Result > 0 then
                begin
                    Inc(Result, prefix_bonus div 2);
                end
                else
                begin
                    Result := prefix_bonus;
                end;
            end;

            structural_bonus := get_exact_structural_transition_bonus_local(
                prev_text, candidate_text);
            if structural_bonus <> 0 then
            begin
                Inc(Result, structural_bonus);
            end;
        end;

        function compare_state(const left: TncSegmentPathState; const right: TncSegmentPathState): Integer;
        const
            c_near_tie_score_margin = 640;
        var
            left_segment_count: Integer;
            right_segment_count: Integer;
            text_compare: Integer;
        begin
            if Abs(left.score - right.score) <= c_near_tie_score_margin then
            begin
                if left.path_confidence_score <> right.path_confidence_score then
                begin
                    Result := right.path_confidence_score - left.path_confidence_score;
                    Exit;
                end;
            end;

            if Abs(left.score - right.score) > c_near_tie_score_margin then
            begin
                Result := right.score - left.score;
                Exit;
            end;

            if left.path_confidence_score <> right.path_confidence_score then
            begin
                Result := right.path_confidence_score - left.path_confidence_score;
                Exit;
            end;

            left_segment_count := get_encoded_path_segment_count_local(left.path_text);
            right_segment_count := get_encoded_path_segment_count_local(right.path_text);
            if left_segment_count <> right_segment_count then
            begin
                Result := left_segment_count - right_segment_count;
                Exit;
            end;

            if left.source <> right.source then
            begin
                if left.source = cs_user then
                begin
                    Exit(-1);
                end;
                if right.source = cs_user then
                begin
                    Exit(1);
                end;
            end;

            text_compare := CompareText(left.text, right.text);
            if text_compare <> 0 then
            begin
                Result := text_compare;
                Exit;
            end;

            Result := CompareText(left.path_text, right.path_text);
        end;

        procedure sort_state_array(var values: TArray<TncSegmentPathState>);
        var
            left_idx: Integer;
            right_idx: Integer;
            temp_state: TncSegmentPathState;
        begin
            if Length(values) <= 1 then
            begin
                Exit;
            end;

            for left_idx := 0 to High(values) - 1 do
            begin
                for right_idx := left_idx + 1 to High(values) do
                begin
                    if compare_state(values[left_idx], values[right_idx]) > 0 then
                    begin
                        temp_state := values[left_idx];
                        values[left_idx] := values[right_idx];
                        values[right_idx] := temp_state;
                    end;
                end;
            end;
        end;

        procedure append_exact_state(const position: Integer; const value: TncSegmentPathState);
        begin
            exact_key := build_state_key(value);
            if exact_dedup[position].TryGetValue(exact_key, exact_existing_state_index) then
            begin
                if (exact_existing_state_index >= 0) and
                    (exact_existing_state_index < exact_states[position].Count) then
                begin
                    exact_existing_state := exact_states[position][exact_existing_state_index];
                    if compare_state(value, exact_existing_state) < 0 then
                    begin
                        exact_existing_state := value;
                    end;
                    exact_existing_state.source := merge_source_rank(
                        exact_existing_state.source, value.source);
                    exact_states[position][exact_existing_state_index] := exact_existing_state;
                end;
                Exit;
            end;

            exact_states[position].Add(value);
            exact_dedup[position].Add(exact_key, exact_states[position].Count - 1);
        end;

        procedure trim_exact_state(const position: Integer);
        var
            idx: Integer;
        begin
            if exact_states[position].Count <= exact_state_limit_local then
            begin
                Exit;
            end;

            SetLength(exact_sorted_states, exact_states[position].Count);
            for idx := 0 to exact_states[position].Count - 1 do
            begin
                exact_sorted_states[idx] := exact_states[position][idx];
            end;
            sort_state_array(exact_sorted_states);
            exact_keep_count := exact_state_limit_local;

            exact_states[position].Clear;
            exact_dedup[position].Clear;
            for idx := 0 to exact_keep_count - 1 do
            begin
                exact_states[position].Add(exact_sorted_states[idx]);
                exact_dedup[position].Add(build_state_key(exact_sorted_states[idx]), idx);
            end;
        end;

    begin
        query_allows_incomplete_tail :=
            has_extendable_trailing_prefix_query_text(pinyin_key);
        query_extends_full_tail := query_allows_incomplete_tail and
            is_full_pinyin_key(pinyin_key);
        if (m_dictionary = nil) or (pinyin_key = '') or
            (not c_suppress_nonlexicon_complete_long_candidates) or
            ((not is_full_pinyin_key(pinyin_key)) and (not query_allows_incomplete_tail)) or
            all_initial_compact_query or has_internal_dangling_initial then
        begin
            Exit;
        end;

        exact_syllables := get_effective_compact_pinyin_syllables(pinyin_key,
            allow_relaxed_missing_apostrophe);
        if Length(exact_syllables) < c_long_sentence_exact_min_syllables then
        begin
            Exit;
        end;

        exact_lightweight_incomplete_tail := query_allows_incomplete_tail and
            (Length(exact_syllables) >= 10);
        exact_state_limit_local := c_long_sentence_state_limit;
        exact_complete_non_user_limit_local := c_long_sentence_complete_non_user_limit;
        exact_partial_non_user_limit_local := c_long_sentence_partial_non_user_limit;
        exact_partial_remaining_limit_local := c_long_sentence_partial_remaining_limit;
        exact_prefix_single_candidate_limit_local := 96;
        exact_prefix_multi_candidate_limit_local := Max(2, c_long_sentence_multi_top_n);
        if exact_lightweight_incomplete_tail then
        begin
            exact_state_limit_local := 24;
            exact_complete_non_user_limit_local := 3;
            exact_partial_non_user_limit_local := 2;
            exact_partial_remaining_limit_local := 3;
            exact_prefix_single_candidate_limit_local := 16;
            exact_prefix_multi_candidate_limit_local := 2;
        end;

        exact_bridge_bonus_cache := TDictionary<string, Integer>.Create;
        exact_suffix_first_unit_cache := TDictionary<Integer, string>.Create;
        exact_protected_span_text_cache := TDictionary<string, string>.Create;
        exact_protected_span_weight_cache := TDictionary<string, Integer>.Create;
        exact_protected_span_rank_cache := TDictionary<string, Integer>.Create;
        SetLength(exact_states, Length(exact_syllables) + 1);
        SetLength(exact_dedup, Length(exact_syllables) + 1);
        try
            for exact_state_pos := 0 to High(exact_states) do
            begin
                exact_states[exact_state_pos] := TList<TncSegmentPathState>.Create;
                exact_dedup[exact_state_pos] := TDictionary<string, Integer>.Create;
            end;

            exact_state.text := '';
            exact_state.score := 0;
            exact_state.path_preference_score := 0;
            exact_state.path_confidence_score := 0;
            exact_state.source := cs_rule;
            exact_state.has_multi_segment := False;
            exact_state.uses_prefix_completion := False;
            get_recent_path_context_seed(seed_prev_prev_text, seed_prev_text);
            exact_state.prev_prev_text := seed_prev_prev_text;
            exact_state.prev_text := seed_prev_text;
            exact_state.prev_pinyin_text := '';
            exact_state.path_text := '';
            exact_state.fuzzy_cost := 0;
            exact_state.fuzzy_rules := [];
            exact_states[0].Add(exact_state);
            exact_dedup[0].Add(build_state_key(exact_state), 0);

            for exact_state_pos := 0 to High(exact_syllables) do
            begin
                if exact_states[exact_state_pos].Count = 0 then
                begin
                    Continue;
                end;

                for exact_segment_len := 1 to c_long_sentence_max_segment_len do
                begin
                    if (exact_state_pos = 0) and (exact_segment_len = 1) then
                    begin
                        Continue;
                    end;

                    exact_next_pos := exact_state_pos + exact_segment_len;
                    if exact_next_pos > Length(exact_syllables) then
                    begin
                        Break;
                    end;

                    exact_segment_text := '';
                    for exact_idx := exact_state_pos to exact_next_pos - 1 do
                    begin
                        exact_segment_text := exact_segment_text + exact_syllables[exact_idx].text;
                    end;
                    if exact_segment_text = '' then
                    begin
                        Continue;
                    end;

                    exact_segment_uses_prefix_lookup := query_allows_incomplete_tail and
                        (exact_next_pos = Length(exact_syllables)) and
                        is_extendable_trailing_prefix_segment_local(exact_segment_text);

                    if exact_segment_uses_prefix_lookup then
                    begin
                        if not dictionary_prefix_lookup_cached(exact_segment_text,
                            exact_lookup_results) then
                        begin
                            Continue;
                        end;
                    end
                    else if exact_segment_len = 1 then
                    begin
                        if not dictionary_exact_lookup_cached(exact_segment_text,
                            exact_lookup_results) then
                        begin
                            Continue;
                        end;
                    end
                    else if exact_segment_len = 2 then
                    begin
                        if not dictionary_exact_lookup_cached(exact_segment_text,
                            exact_lookup_results) then
                        begin
                            Continue;
                        end;
                    end
                    else if not dictionary_exact_lookup_cached(exact_segment_text,
                        exact_lookup_results) then
                    begin
                        Continue;
                    end;

                    exact_resolved_inserted := False;
                    exact_resolved_text := '';
                    exact_resolved_weight := 0;
                    exact_resolved_rank_bonus := 0;
                    if (not exact_segment_uses_prefix_lookup) and
                        try_get_best_resolved_exact_segment_candidate_local(
                        exact_state_pos, exact_segment_len, exact_resolved_text,
                        exact_resolved_weight, exact_resolved_rank_bonus) then
                    begin
                        FillChar(exact_resolved_candidate,
                            SizeOf(exact_resolved_candidate), 0);
                        exact_resolved_candidate.text := exact_resolved_text;
                        exact_resolved_candidate.comment := '';
                        exact_resolved_candidate.score := exact_resolved_weight;
                        exact_resolved_candidate.source := cs_rule;
                        exact_resolved_candidate.has_dict_weight := True;
                        exact_resolved_candidate.dict_weight := exact_resolved_weight;
                        exact_resolved_inserted := True;
                        for exact_candidate_index := 0 to High(exact_lookup_results) do
                        begin
                            if SameText(Trim(exact_lookup_results[exact_candidate_index].text),
                                exact_resolved_candidate.text) then
                            begin
                                exact_resolved_inserted := False;
                                Break;
                            end;
                        end;
                        if exact_resolved_inserted then
                        begin
                            SetLength(exact_lookup_results, Length(exact_lookup_results) + 1);
                            for exact_candidate_index := High(exact_lookup_results) downto 1 do
                            begin
                                exact_lookup_results[exact_candidate_index] :=
                                    exact_lookup_results[exact_candidate_index - 1];
                            end;
                            exact_lookup_results[0] := exact_resolved_candidate;
                        end;
                    end;

                    if exact_segment_uses_prefix_lookup and (exact_segment_len = 1) then
                    begin
                        exact_candidate_limit := exact_prefix_single_candidate_limit_local;
                    end
                    else if exact_segment_uses_prefix_lookup then
                    begin
                        exact_candidate_limit := exact_prefix_multi_candidate_limit_local;
                    end
                    else if exact_segment_len = 1 then
                    begin
                        exact_candidate_limit := c_long_sentence_single_top_n;
                        if is_long_sentence_ambiguous_function_syllable_local(
                            exact_syllables[exact_state_pos].text) then
                        begin
                            exact_candidate_limit := 4;
                        end;
                    end
                    else if exact_segment_len >= 3 then
                    begin
                        exact_candidate_limit := Max(2, c_long_sentence_multi_top_n - 1);
                    end
                    else
                    begin
                        exact_candidate_limit := c_long_sentence_multi_top_n;
                    end;

                    for exact_state_index := 0 to exact_states[exact_state_pos].Count - 1 do
                    begin
                        exact_state := exact_states[exact_state_pos][exact_state_index];
                        exact_top_effective_weight := 0;
                        exact_accepted_count := 0;
                        for exact_candidate_index := 0 to High(exact_lookup_results) do
                        begin
                            if exact_candidate_index >= exact_candidate_limit then
                            begin
                                Break;
                            end;

                            exact_candidate := exact_lookup_results[exact_candidate_index];
                            exact_candidate_text := Trim(exact_candidate.text);
                            exact_effective_weight := 0;
                            if (exact_candidate.comment <> '') or (exact_candidate_text = '') then
                            begin
                                Continue;
                            end;

                            exact_units := get_candidate_text_unit_count(exact_candidate_text);
                            if exact_units <= 0 then
                            begin
                                Continue;
                            end;

                            if exact_segment_uses_prefix_lookup then
                            begin
                                if exact_segment_len = 1 then
                                begin
                                    if (exact_units <= 0) or (exact_units > 2) then
                                    begin
                                        Continue;
                                    end;
                                    if (exact_units = 1) and
                                        (not is_predictive_tail_single_char_text_codepoint_local(
                                        exact_candidate_text)) then
                                    begin
                                        Continue;
                                    end;
                                end
                                else if (exact_units < exact_segment_len) or
                                    (exact_units > exact_segment_len + 1) then
                                begin
                                    Continue;
                                end;
                            end
                            else if exact_segment_len = 1 then
                            begin
                                exact_effective_weight := get_candidate_effective_weight_local(exact_candidate);
                                if (exact_units <> 1) or
                                    (has_strong_two_syllable_exact_segment_local(exact_state_pos) and
                                    (not is_strong_sentence_boundary_single_local(
                                    exact_syllables[exact_state_pos].text)) and
                                    (not is_long_sentence_ambiguous_function_syllable_local(
                                    exact_syllables[exact_state_pos].text))) or
                                    (not is_extended_long_sentence_allowed_single_char_candidate_local(
                                    exact_syllables[exact_state_pos].text,
                                    exact_candidate_text, exact_effective_weight)) then
                                begin
                                    Continue;
                                end;
                            end
                            else
                            begin
                                if exact_units <> exact_segment_len then
                                begin
                                    Continue;
                                end;
                                if (exact_segment_len = 2) and
                                    (not exact_segment_uses_prefix_lookup) then
                                begin
                                    exact_left_fixed_text :=
                                        get_fixed_long_sentence_single_char_local(
                                        exact_syllables[exact_state_pos].text);
                                    exact_right_fixed_text :=
                                        get_fixed_long_sentence_single_char_local(
                                        exact_syllables[exact_state_pos + 1].text);
                                    if (exact_left_fixed_text <> '') and
                                        (exact_right_fixed_text <> '') and
                                        SameText(exact_candidate_text,
                                        exact_left_fixed_text +
                                        exact_right_fixed_text) and
                                        try_get_best_two_syllable_exact_phrase_local(
                                        exact_state_pos,
                                        exact_best_two_syllable_text,
                                        exact_best_two_syllable_weight) and
                                        (not SameText(exact_best_two_syllable_text,
                                        exact_candidate_text)) then
                                    begin
                                        Continue;
                                    end;
                                end;
                                if (exact_segment_len = 3) and
                                    (not exact_segment_uses_prefix_lookup) then
                                begin
                                    exact_left_fixed_text :=
                                        get_fixed_long_sentence_single_char_local(
                                        exact_syllables[exact_state_pos].text);
                                    exact_right_fixed_text :=
                                        get_fixed_long_sentence_single_char_local(
                                        exact_syllables[exact_state_pos + 1].text);
                                    exact_third_fixed_text :=
                                        get_fixed_long_sentence_single_char_local(
                                        exact_syllables[exact_state_pos + 2].text);
                                    if (exact_left_fixed_text <> '') and
                                        (exact_right_fixed_text <> '') and
                                        (exact_third_fixed_text <> '') and
                                        SameText(exact_candidate_text,
                                        exact_left_fixed_text +
                                        exact_right_fixed_text +
                                        exact_third_fixed_text) and
                                        try_get_best_three_syllable_exact_phrase_local(
                                        exact_state_pos,
                                        exact_best_three_syllable_text,
                                        exact_best_three_syllable_weight) and
                                        (not SameText(exact_best_three_syllable_text,
                                        exact_candidate_text)) then
                                    begin
                                        Continue;
                                    end;
                                end;
                            end;

                            exact_new_state.text := exact_state.text + exact_candidate_text;
                            exact_new_state.score := exact_state.score;
                            if (exact_segment_len <> 1) or exact_segment_uses_prefix_lookup then
                            begin
                                exact_effective_weight := get_candidate_effective_weight_local(exact_candidate);
                            end;
                            if exact_effective_weight > exact_top_effective_weight then
                            begin
                                exact_top_effective_weight := exact_effective_weight;
                            end;
                            Inc(exact_new_state.score, exact_effective_weight);

                            if exact_segment_uses_prefix_lookup and
                                (exact_units > exact_segment_len) then
                            begin
                                Inc(exact_new_state.score,
                                    Min(c_long_sentence_completion_bonus,
                                    (exact_units - exact_segment_len) *
                                    c_long_sentence_multi_bonus));
                            end;

                            exact_rank_bonus := 0;
                            if not exact_segment_uses_prefix_lookup then
                            begin
                                exact_rank_bonus := c_long_sentence_top_exact_bonus -
                                    (exact_candidate_index * c_long_sentence_exact_rank_step);
                                if exact_rank_bonus > 0 then
                                begin
                                    Inc(exact_new_state.score, exact_rank_bonus);
                                end;
                            end;

                            exact_path_bonus := get_exact_query_choice_bonus_local(
                                exact_segment_text, exact_candidate_text);
                            if exact_path_bonus <> 0 then
                            begin
                                Inc(exact_new_state.score, exact_path_bonus);
                            end;

                            exact_phrase_bonus := get_preferred_exact_phrase_bonus_local(
                                exact_segment_text, exact_candidate_text);
                            if exact_phrase_bonus <> 0 then
                            begin
                                Inc(exact_new_state.score, exact_phrase_bonus);
                            end;

                            exact_span_adjustment :=
                                get_protected_exact_span_adjustment_local(
                                exact_state_pos, exact_segment_len,
                                exact_candidate_text);
                            if exact_span_adjustment <> 0 then
                            begin
                                Inc(exact_new_state.score, exact_span_adjustment);
                            end;

                            exact_yu_context_adjustment :=
                                get_exact_yu_context_adjustment_local(
                                exact_syllables[exact_next_pos - 1].text,
                                exact_candidate_text, exact_next_pos);
                            if exact_yu_context_adjustment <> 0 then
                            begin
                                Inc(exact_new_state.score,
                                    exact_yu_context_adjustment);
                            end;

                            if is_exact_latest_query_choice_local(exact_segment_text,
                                exact_candidate_text) then
                            begin
                                if exact_segment_len = 1 then
                                begin
                                    Inc(exact_new_state.score,
                                        c_long_sentence_single_query_latest_bonus);
                                end
                                else
                                begin
                                    Inc(exact_new_state.score,
                                        c_long_sentence_phrase_query_latest_bonus);
                                end;
                            end;

                            exact_pair_bonus := 0;
                            exact_bridge_bonus := 0;

                            exact_transition_bonus := get_path_transition_bonus(
                                exact_state.prev_prev_text, exact_state.prev_text,
                                exact_candidate_text);
                            if exact_transition_bonus <> 0 then
                            begin
                                Inc(exact_new_state.score, exact_transition_bonus);
                            end;

                            if exact_state.prev_pinyin_text <> '' then
                            begin
                                if not (exact_lightweight_incomplete_tail and
                                    exact_segment_uses_prefix_lookup) then
                                begin
                                    exact_bridge_bonus := get_exact_phrase_bridge_bonus_local(
                                        exact_state.prev_pinyin_text, exact_state.prev_text,
                                        exact_segment_text, exact_candidate_text);
                                    if exact_bridge_bonus <> 0 then
                                    begin
                                        Inc(exact_new_state.score, exact_bridge_bonus);
                                    end;
                                end;
                            end;

                            if exact_segment_len = 1 then
                            begin
                                Dec(exact_new_state.score, c_long_sentence_single_penalty);
                            end
                            else
                            begin
                                Inc(exact_new_state.score,
                                    c_long_sentence_multi_bonus + (exact_segment_len * 24));

                                exact_path_bonus := get_longer_exact_prefix_penalty_local(
                                    exact_state_pos, exact_segment_len,
                                    exact_candidate_text, exact_effective_weight);
                                if exact_path_bonus > 0 then
                                begin
                                    Dec(exact_new_state.score, exact_path_bonus);
                                end;

                                exact_path_bonus := get_single_plus_following_phrase_penalty_local(
                                    exact_state_pos, exact_segment_len,
                                    exact_candidate_text, exact_effective_weight);
                                if exact_path_bonus > 0 then
                                begin
                                    Dec(exact_new_state.score, exact_path_bonus);
                                end;

                                exact_path_bonus := get_preferred_phrase_split_penalty_local(
                                    exact_state_pos, exact_segment_len,
                                    exact_candidate_text, exact_effective_weight);
                                if exact_path_bonus > 0 then
                                begin
                                    Dec(exact_new_state.score, exact_path_bonus);
                                end;

                                exact_path_bonus :=
                                    get_preferred_phrase_plus_boundary_penalty_local(
                                    exact_state_pos, exact_segment_len,
                                    exact_candidate_text, exact_effective_weight);
                                if exact_path_bonus > 0 then
                                begin
                                    Dec(exact_new_state.score, exact_path_bonus);
                                end;

                                exact_path_bonus :=
                                    get_prev_phrase_plus_boundary_single_penalty_local(
                                    exact_state.prev_pinyin_text, exact_state.prev_text,
                                    exact_state_pos, exact_segment_len,
                                    exact_candidate_text, exact_effective_weight);
                                if exact_path_bonus > 0 then
                                begin
                                    Dec(exact_new_state.score, exact_path_bonus);
                                end;
                            end;

                            if exact_next_pos = Length(exact_syllables) then
                            begin
                                Inc(exact_new_state.score, c_long_sentence_completion_bonus);
                            end
                            else
                            begin
                                Inc(exact_new_state.score, c_long_sentence_continuation_bonus);
                            end;
                            if exact_segment_uses_prefix_lookup then
                            begin
                                Dec(exact_new_state.score, c_long_sentence_partial_tail_penalty);
                            end;

                            if (exact_units = 1) and (exact_next_pos < Length(exact_syllables)) and
                                (get_candidate_text_unit_count(Trim(exact_state.prev_text)) >= 2) and
                                (not is_predictive_bridge_single_char_text_codepoint_local(
                                exact_candidate_text)) and
                                (exact_bridge_bonus <= 0) then
                            begin
                                Dec(exact_new_state.score, 900);
                            end;

                            exact_new_state.source := merge_source_rank(exact_state.source,
                                exact_candidate.source);
                            exact_new_state.fuzzy_cost := exact_state.fuzzy_cost +
                                exact_candidate.fuzzy_cost;
                            exact_new_state.fuzzy_rules := exact_state.fuzzy_rules +
                                exact_candidate.fuzzy_rules;
                            exact_new_state.prev_prev_text := exact_state.prev_text;
                            exact_new_state.prev_text := exact_candidate_text;
                            exact_new_state.prev_pinyin_text := exact_segment_text;
                            exact_new_state.path_text := exact_state.path_text;
                            if exact_new_state.path_text <> '' then
                            begin
                                exact_new_state.path_text := exact_new_state.path_text +
                                    c_segment_path_separator;
                            end;
                            exact_new_state.path_text := exact_new_state.path_text +
                                exact_candidate_text;
                            exact_new_state.has_multi_segment :=
                                get_encoded_path_segment_count_local(exact_new_state.path_text) > 1;
                            exact_new_state.uses_prefix_completion :=
                                exact_state.uses_prefix_completion or
                                (exact_segment_uses_prefix_lookup and
                                (exact_units > exact_segment_len));

                            exact_path_bonus := exact_transition_bonus + exact_pair_bonus +
                                exact_bridge_bonus + exact_rank_bonus +
                                exact_yu_context_adjustment +
                                exact_span_adjustment + (exact_phrase_bonus div 2);

                            exact_new_state.path_preference_score :=
                                exact_state.path_preference_score + exact_path_bonus;
                            exact_path_confidence := exact_new_state.path_preference_score;
                            if exact_path_confidence < 0 then
                            begin
                                exact_path_confidence := 0;
                            end;
                            exact_new_state.path_confidence_score := exact_path_confidence;
                            append_exact_state(exact_next_pos, exact_new_state);
                            Inc(exact_accepted_count);
                        end;

                        if (exact_segment_len = 2) and (not exact_segment_uses_prefix_lookup) and
                            try_build_two_single_rescue_segment_local(exact_state_pos,
                            exact_rescue_text, exact_rescue_weight,
                            exact_rescue_rank_bonus) and
                            (exact_accepted_count <= 0) then
                        begin
                            exact_same_as_rescue := False;
                            for exact_candidate_index := 0 to Min(exact_candidate_limit - 1,
                                High(exact_lookup_results)) do
                            begin
                                if SameText(Trim(exact_lookup_results[exact_candidate_index].text),
                                    exact_rescue_text) then
                                begin
                                    exact_same_as_rescue := True;
                                    Break;
                                end;
                            end;

                            if not exact_same_as_rescue then
                            begin
                                exact_new_state.text := exact_state.text + exact_rescue_text;
                                exact_new_state.score := exact_state.score + exact_rescue_weight;
                                Inc(exact_new_state.score, exact_rescue_rank_bonus);

                                exact_transition_bonus := get_path_transition_bonus(
                                    exact_state.prev_prev_text, exact_state.prev_text,
                                    exact_rescue_text);
                                if exact_transition_bonus <> 0 then
                                begin
                                    Inc(exact_new_state.score, exact_transition_bonus);
                                end;
                                exact_pair_bonus := get_exact_context_pair_bonus(
                                    exact_state.prev_text, exact_rescue_text);
                                if exact_pair_bonus <> 0 then
                                begin
                                    Inc(exact_new_state.score, exact_pair_bonus);
                                end;

                                Inc(exact_new_state.score,
                                    c_long_sentence_multi_bonus + (exact_segment_len * 24));
                                if exact_next_pos = Length(exact_syllables) then
                                begin
                                    Inc(exact_new_state.score, c_long_sentence_completion_bonus);
                                end
                                else
                                begin
                                    Inc(exact_new_state.score,
                                        c_long_sentence_continuation_bonus);
                                end;

                                exact_new_state.source := merge_source_rank(exact_state.source,
                                    cs_rule);
                                exact_new_state.fuzzy_cost := exact_state.fuzzy_cost;
                                exact_new_state.fuzzy_rules := exact_state.fuzzy_rules;
                                exact_new_state.prev_prev_text := exact_state.prev_text;
                                exact_new_state.prev_text := exact_rescue_text;
                                exact_new_state.prev_pinyin_text := exact_segment_text;
                                exact_new_state.path_text := exact_state.path_text;
                                if exact_new_state.path_text <> '' then
                                begin
                                    exact_new_state.path_text := exact_new_state.path_text +
                                        c_segment_path_separator;
                                end;
                                exact_new_state.path_text := exact_new_state.path_text +
                                    exact_rescue_text;
                                exact_new_state.has_multi_segment :=
                                    get_encoded_path_segment_count_local(
                                    exact_new_state.path_text) > 1;
                                exact_new_state.uses_prefix_completion :=
                                    exact_state.uses_prefix_completion;
                                exact_new_state.path_preference_score :=
                                    exact_state.path_preference_score +
                                    exact_transition_bonus + exact_pair_bonus +
                                    exact_rescue_rank_bonus;
                                exact_path_confidence :=
                                    exact_new_state.path_preference_score;
                                if exact_path_confidence < 0 then
                                begin
                                    exact_path_confidence := 0;
                                end;
                                exact_new_state.path_confidence_score :=
                                    exact_path_confidence;
                                append_exact_state(exact_next_pos, exact_new_state);
                            end;
                        end;

                        if (exact_segment_len >= 3) and (not exact_segment_uses_prefix_lookup) and
                            try_build_preferred_split_exact_segment_local(
                            exact_state_pos, exact_segment_len,
                            exact_rescue_text, exact_rescue_weight,
                            exact_rescue_rank_bonus) then
                        begin
                            exact_same_as_rescue := False;
                            for exact_candidate_index := 0 to Min(exact_candidate_limit - 1,
                                High(exact_lookup_results)) do
                            begin
                                if SameText(Trim(exact_lookup_results[exact_candidate_index].text),
                                    exact_rescue_text) then
                                begin
                                    exact_same_as_rescue := True;
                                    Break;
                                end;
                            end;

                            if not exact_same_as_rescue then
                            begin
                                exact_new_state.text := exact_state.text + exact_rescue_text;
                                exact_new_state.score := exact_state.score + exact_rescue_weight;
                                Inc(exact_new_state.score, exact_rescue_rank_bonus);

                                exact_transition_bonus := get_path_transition_bonus(
                                    exact_state.prev_prev_text, exact_state.prev_text,
                                    exact_rescue_text);
                                if exact_transition_bonus <> 0 then
                                begin
                                    Inc(exact_new_state.score, exact_transition_bonus);
                                end;
                                exact_pair_bonus := get_exact_context_pair_bonus(
                                    exact_state.prev_text, exact_rescue_text);
                                if exact_pair_bonus <> 0 then
                                begin
                                    Inc(exact_new_state.score, exact_pair_bonus);
                                end;

                                Inc(exact_new_state.score,
                                    c_long_sentence_multi_bonus + (exact_segment_len * 24));
                                if exact_next_pos = Length(exact_syllables) then
                                begin
                                    Inc(exact_new_state.score, c_long_sentence_completion_bonus);
                                end
                                else
                                begin
                                    Inc(exact_new_state.score,
                                        c_long_sentence_continuation_bonus);
                                end;

                                exact_new_state.source := merge_source_rank(exact_state.source,
                                    cs_rule);
                                exact_new_state.fuzzy_cost := exact_state.fuzzy_cost;
                                exact_new_state.fuzzy_rules := exact_state.fuzzy_rules;
                                exact_new_state.prev_prev_text := exact_state.prev_text;
                                exact_new_state.prev_text := exact_rescue_text;
                                exact_new_state.prev_pinyin_text := exact_segment_text;
                                exact_new_state.path_text := exact_state.path_text;
                                if exact_new_state.path_text <> '' then
                                begin
                                    exact_new_state.path_text := exact_new_state.path_text +
                                        c_segment_path_separator;
                                end;
                                exact_new_state.path_text := exact_new_state.path_text +
                                    exact_rescue_text;
                                exact_new_state.has_multi_segment :=
                                    get_encoded_path_segment_count_local(
                                    exact_new_state.path_text) > 1;
                                exact_new_state.uses_prefix_completion :=
                                    exact_state.uses_prefix_completion;
                                exact_new_state.path_preference_score :=
                                    exact_state.path_preference_score +
                                    exact_transition_bonus + exact_pair_bonus +
                                    exact_rescue_rank_bonus;
                                exact_path_confidence :=
                                    exact_new_state.path_preference_score;
                                if exact_path_confidence < 0 then
                                begin
                                    exact_path_confidence := 0;
                                end;
                                exact_new_state.path_confidence_score :=
                                    exact_path_confidence;
                                append_exact_state(exact_next_pos, exact_new_state);
                            end;
                        end;
                    end;

                    trim_exact_state(exact_next_pos);
                end;

            end;
            if exact_states[Length(exact_syllables)].Count <= 0 then
            begin
                Exit;
            end;

            SetLength(exact_sorted_states, exact_states[Length(exact_syllables)].Count);
            for exact_state_pos := 0 to exact_states[Length(exact_syllables)].Count - 1 do
            begin
                exact_sorted_states[exact_state_pos] :=
                    exact_states[Length(exact_syllables)][exact_state_pos];
                exact_path_bonus := get_session_query_path_bonus(pinyin_key,
                    exact_sorted_states[exact_state_pos].path_text);
                if m_dictionary <> nil then
                begin
                    Inc(exact_path_bonus, get_cached_query_segment_path_bonus(pinyin_key,
                        exact_sorted_states[exact_state_pos].path_text));
                    Dec(exact_path_bonus, get_cached_query_segment_path_penalty(
                        pinyin_key, exact_sorted_states[exact_state_pos].path_text));
                end;
                Inc(exact_path_bonus, get_persistent_query_path_prefix_support(
                    exact_sorted_states[exact_state_pos].path_text));
                if exact_path_bonus <> 0 then
                begin
                    Inc(exact_sorted_states[exact_state_pos].score, exact_path_bonus);
                    Inc(exact_sorted_states[exact_state_pos].path_preference_score,
                        exact_path_bonus);
                    exact_path_confidence := exact_sorted_states[exact_state_pos].path_confidence_score +
                        exact_path_bonus;
                    if exact_path_confidence < 0 then
                    begin
                        exact_path_confidence := 0;
                    end;
                    exact_sorted_states[exact_state_pos].path_confidence_score :=
                        exact_path_confidence;
                end;
            end;
            sort_state_array(exact_sorted_states);

            SetLength(exact_matches, 0);
            exact_non_user_added := 0;
            for exact_state_pos := 0 to High(exact_sorted_states) do
            begin
                exact_state := exact_sorted_states[exact_state_pos];
                if query_extends_full_tail and exact_state.uses_prefix_completion then
                begin
                    Continue;
                end;
                exact_segment_count := get_encoded_path_segment_count_local(exact_state.path_text);
                exact_multi_char_segment_count := get_multi_char_segment_count(exact_state.path_text);
                exact_units := get_candidate_text_unit_count(exact_state.text);
                if (exact_segment_count <= 1) or
                    (exact_units < Length(exact_syllables)) then
                begin
                    Continue;
                end;
                if (Length(exact_syllables) >= 8) and (exact_segment_count < 4) then
                begin
                    Continue;
                end;
                exact_required_multi_char_segment_count := 2;
                if Length(exact_syllables) < c_long_sentence_full_path_min_syllables then
                begin
                    exact_required_multi_char_segment_count := 1;
                end;
                if Length(exact_syllables) >= 8 then
                begin
                    exact_required_multi_char_segment_count := 3;
                end;
                if exact_multi_char_segment_count < exact_required_multi_char_segment_count then
                begin
                    Continue;
                end;
                if (exact_multi_char_segment_count * 2) < exact_segment_count then
                begin
                    Continue;
                end;
                if (exact_state.source <> cs_user) and
                    (exact_non_user_added >= exact_complete_non_user_limit_local) then
                begin
                    Continue;
                end;
                if not is_natural_predictive_segment_path_local(exact_state.path_text) then
                begin
                    Continue;
                end;

                SetLength(exact_matches, Length(exact_matches) + 1);
                exact_matches[High(exact_matches)].text := exact_state.text;
                exact_matches[High(exact_matches)].comment := '';
                exact_matches[High(exact_matches)].score :=
                    exact_state.score + c_long_sentence_candidate_visible_bonus;
                Inc(exact_matches[High(exact_matches)].score,
                    get_preferred_query_phrase_bonus_local(lookup_text,
                    exact_state.text));
                exact_matches[High(exact_matches)].source := exact_state.source;
                exact_matches[High(exact_matches)].has_dict_weight := False;
                exact_matches[High(exact_matches)].dict_weight := 0;
                exact_matches[High(exact_matches)].fuzzy_cost := exact_state.fuzzy_cost;
                exact_matches[High(exact_matches)].fuzzy_rules := exact_state.fuzzy_rules;
                remember_segment_path_for_candidate(exact_state.text, '',
                    exact_state.path_text, exact_matches[High(exact_matches)].score);
                if exact_state.source <> cs_user then
                begin
                    Inc(exact_non_user_added);
                end;
            end;

            if try_build_preferred_sentence_rescue_candidate_local(
                exact_matches_candidate) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' texact=[rescue text=%s score=%d]',
                        [exact_matches_candidate.text, exact_matches_candidate.score]);
                end;
                exact_same_as_rescue := False;
                for exact_idx := 0 to High(exact_matches) do
                begin
                    if SameText(Trim(exact_matches[exact_idx].text),
                        Trim(exact_matches_candidate.text)) and
                        (Trim(exact_matches[exact_idx].comment) = '') then
                    begin
                        exact_same_as_rescue := True;
                        Break;
                    end;
                end;

                if not exact_same_as_rescue then
                begin
                    SetLength(exact_matches, Length(exact_matches) + 1);
                    exact_matches[High(exact_matches)] := exact_matches_candidate;
                    Inc(exact_matches[High(exact_matches)].score,
                        c_long_sentence_candidate_visible_bonus);
                    remember_segment_path_for_candidate(
                        exact_matches[High(exact_matches)].text, '',
                        exact_matches[High(exact_matches)].text,
                        exact_matches[High(exact_matches)].score);
                end;
            end;

            for exact_state_pos := Length(exact_syllables) - 1 downto 2 do
            begin
                exact_remaining_syllables := Length(exact_syllables) - exact_state_pos;
                if (exact_remaining_syllables <= 0) or
                    (exact_remaining_syllables > exact_partial_remaining_limit_local) or
                    (exact_states[exact_state_pos].Count <= 0) then
                begin
                    Continue;
                end;

                exact_remaining_pinyin := build_exact_syllable_text(exact_state_pos,
                    exact_remaining_syllables);
                if exact_remaining_pinyin = '' then
                begin
                    Continue;
                end;

                SetLength(exact_sorted_states, exact_states[exact_state_pos].Count);
                for exact_idx := 0 to exact_states[exact_state_pos].Count - 1 do
                begin
                    exact_sorted_states[exact_idx] := exact_states[exact_state_pos][exact_idx];
                end;
                sort_state_array(exact_sorted_states);

                exact_non_user_added := 0;
                for exact_idx := 0 to High(exact_sorted_states) do
                begin
                    exact_state := exact_sorted_states[exact_idx];
                    exact_segment_count := get_encoded_path_segment_count_local(
                        exact_state.path_text);
                    if exact_segment_count <= 1 then
                    begin
                        Continue;
                    end;

                    exact_units := get_candidate_text_unit_count(exact_state.text);
                    if exact_units < 3 then
                    begin
                        Continue;
                    end;

                    exact_multi_char_segment_count :=
                        get_multi_char_segment_count(exact_state.path_text);
                    if exact_multi_char_segment_count <= 0 then
                    begin
                        Continue;
                    end;

                    if ((exact_multi_char_segment_count * 2) + 1) < exact_segment_count then
                    begin
                        Continue;
                    end;

                    if (exact_state.source <> cs_user) and
                        (exact_non_user_added >= exact_partial_non_user_limit_local) then
                    begin
                        Continue;
                    end;
                    if not is_natural_predictive_segment_path_local(exact_state.path_text) then
                    begin
                        Continue;
                    end;

                    exact_partial_score := exact_state.score +
                        c_long_sentence_partial_visible_bonus;
                    if exact_state.path_confidence_score > 0 then
                    begin
                        Inc(exact_partial_score,
                            Min(220, exact_state.path_confidence_score div 3));
                    end;
                    Dec(exact_partial_score,
                        c_long_sentence_partial_remaining_penalty * exact_remaining_syllables);
                    Dec(exact_partial_score,
                        c_long_sentence_partial_quadratic_penalty * exact_remaining_syllables *
                        (exact_remaining_syllables - 1));

                    SetLength(exact_matches, Length(exact_matches) + 1);
                    exact_matches[High(exact_matches)].text := exact_state.text;
                    exact_matches[High(exact_matches)].comment := exact_remaining_pinyin;
                    exact_matches[High(exact_matches)].score := exact_partial_score;
                    exact_matches[High(exact_matches)].source := exact_state.source;
                    exact_matches[High(exact_matches)].has_dict_weight := False;
                    exact_matches[High(exact_matches)].dict_weight := 0;
                    exact_matches[High(exact_matches)].fuzzy_cost := exact_state.fuzzy_cost;
                    exact_matches[High(exact_matches)].fuzzy_rules := exact_state.fuzzy_rules;
                    remember_segment_path_for_candidate(exact_state.text,
                        exact_remaining_pinyin, exact_state.path_text, exact_partial_score);

                    if exact_state.source <> cs_user then
                    begin
                        Inc(exact_non_user_added);
                    end;
                end;
            end;

            if Length(exact_matches) > 0 then
            begin
                candidates := merge_candidate_lists(candidates, exact_matches, 0);
                if (Length(candidates) > 1) and
                    (Trim(exact_matches[0].comment) = '') and
                    (get_candidate_text_unit_count(Trim(exact_matches[0].text)) =
                    Length(exact_syllables)) and
                    ((Trim(candidates[0].comment) <> '') or
                    (get_candidate_text_unit_count(Trim(candidates[0].text)) <>
                    Length(exact_syllables)) or
                    is_problematic_single_char_chain_candidate_for_query(
                    pinyin_key, candidates[0])) then
                begin
                    for exact_idx := 0 to High(candidates) do
                    begin
                        if (Trim(candidates[exact_idx].comment) = '') and
                            SameText(Trim(candidates[exact_idx].text),
                            Trim(exact_matches[0].text)) then
                        begin
                            if exact_idx > 0 then
                            begin
                                exact_matches_candidate := candidates[exact_idx];
                                for exact_state_pos := exact_idx downto 1 do
                                begin
                                    candidates[exact_state_pos] :=
                                        candidates[exact_state_pos - 1];
                                end;
                                candidates[0] := exact_matches_candidate;
                                if m_config.debug_mode then
                                begin
                                    m_last_full_path_debug_info :=
                                        m_last_full_path_debug_info + Format(
                                        ' longmergepromote=[idx=%d text=%s]',
                                        [exact_idx, Trim(candidates[0].text)]);
                                end;
                            end;
                            Break;
                        end;
                    end;
                end;
                if m_config.debug_mode then
                begin
                    exact_debug_path := get_segment_path_for_candidate(exact_matches[0]);
                    m_last_full_path_debug_info := Format(
                        ' longmerge=[n=%d top=%s path=%s]',
                        [Length(exact_matches), exact_matches[0].text,
                        Copy(exact_debug_path, 1, 120)]);
                    for exact_idx := 0 to High(candidates) do
                    begin
                        if SameText(Trim(candidates[exact_idx].text),
                            Trim(exact_matches[0].text)) then
                        begin
                            m_last_full_path_debug_info := m_last_full_path_debug_info +
                                Format(' longmergekeep=[idx=%d comment=%s seg=%d path=%s]',
                                [exact_idx, Trim(candidates[exact_idx].comment),
                                get_encoded_path_segment_count_local(
                                get_segment_path_for_candidate(candidates[exact_idx])),
                                Copy(get_segment_path_for_candidate(
                                candidates[exact_idx]), 1, 120)]);
                            Break;
                        end;
                    end;
                end;
            end;
        finally
            exact_protected_span_rank_cache.Free;
            exact_protected_span_weight_cache.Free;
            exact_protected_span_text_cache.Free;
            exact_suffix_first_unit_cache.Free;
            exact_bridge_bonus_cache.Free;
            for exact_state_pos := 0 to High(exact_states) do
            begin
                if exact_states[exact_state_pos] <> nil then
                begin
                    exact_states[exact_state_pos].Free;
                end;
                if exact_dedup[exact_state_pos] <> nil then
                begin
                    exact_dedup[exact_state_pos].Free;
                end;
            end;
        end;
    end;

    function merge_incomplete_trailing_prefix_full_lookup_candidates(
        var candidates: TncCandidateList; const pinyin_key: string): Boolean;
    const
        c_incomplete_trailing_prefix_visible_bonus = 780;
        c_incomplete_trailing_prefix_limit = 6;
    var
        effective_syllables: TncPinyinParseResult;
        lookup_results: TncCandidateList;
        exact_same_key_results: TncCandidateList;
        exact_matches: TncCandidateList;
        probe_key: string;
        shortest_tail_probe_key: string;
        input_syllables: Integer;
        probe_syllables: Integer;
        text_units: Integer;
        candidate_text: string;
        last_syllable_text: string;
        tail_trim_chars: Integer;

        function has_exact_long_complete_candidate: Boolean;
        var
            candidate_idx: Integer;
        begin
            Result := False;
            for candidate_idx := 0 to High(candidates) do
            begin
                if candidates[candidate_idx].comment <> '' then
                begin
                    Continue;
                end;
                if get_candidate_text_unit_count(Trim(candidates[candidate_idx].text)) <>
                    input_syllables then
                begin
                    Continue;
                end;
                Exit(True);
            end;
        end;

        function is_extendable_trailing_prefix_local: Boolean;
        var
            suffix_ch: Char;
            extended_key: string;
        begin
            Result := False;
            for suffix_ch := 'a' to 'z' do
            begin
                extended_key := pinyin_key + suffix_ch;
                if get_effective_compact_pinyin_unit_count(extended_key) = input_syllables then
                begin
                    Exit(True);
                end;
            end;
        end;

        function try_merge_probe_key(const value: string): Boolean;
        var
            candidate_idx: Integer;
        begin
            Result := False;
            if value = '' then
            begin
                Exit;
            end;

            if not dictionary_exact_lookup_cached(value, lookup_results) then
            begin
                Exit;
            end;

            SetLength(exact_matches, 0);
            for candidate_idx := 0 to High(lookup_results) do
            begin
                candidate_text := Trim(lookup_results[candidate_idx].text);
                if (candidate_text = '') or (lookup_results[candidate_idx].comment <> '') then
                begin
                    Continue;
                end;

                text_units := get_text_unit_count(candidate_text);
                if (text_units > input_syllables) or (text_units < 2) then
                begin
                    Continue;
                end;

                if (lookup_results[candidate_idx].source <> cs_user) and
                    (not lookup_results[candidate_idx].has_dict_weight) then
                begin
                    lookup_results[candidate_idx].has_dict_weight := True;
                    lookup_results[candidate_idx].dict_weight := lookup_results[candidate_idx].score;
                end;
                Inc(lookup_results[candidate_idx].score,
                    c_incomplete_trailing_prefix_visible_bonus);
                SetLength(exact_matches, Length(exact_matches) + 1);
                exact_matches[High(exact_matches)] := lookup_results[candidate_idx];
            end;

            if Length(exact_matches) = 0 then
            begin
                Exit;
            end;

            clear_candidate_comments(exact_matches);
            sort_candidates_lightweight(exact_matches);
            if Length(exact_matches) > c_incomplete_trailing_prefix_limit then
            begin
                SetLength(exact_matches, c_incomplete_trailing_prefix_limit);
            end;
            candidates := merge_candidate_lists(candidates, exact_matches, 0);
            Result := True;
        end;

        function try_merge_prefix_probe_key(const value: string): Boolean;
        const
            c_exact_same_key_visible_bonus = 520;
        var
            candidate_idx: Integer;
            exact_idx: Integer;
            exact_same_key_found: Boolean;
        begin
            Result := False;
            if value = '' then
            begin
                Exit;
            end;

            exact_same_key_found :=
                dictionary_exact_lookup_cached(value, exact_same_key_results);
            SetLength(exact_matches, 0);
            if exact_same_key_found and (not is_full_pinyin_key(value)) then
            begin
                for exact_idx := 0 to High(exact_same_key_results) do
                begin
                    candidate_text := Trim(exact_same_key_results[exact_idx].text);
                    if (candidate_text = '') or
                        (Trim(exact_same_key_results[exact_idx].comment) <> '') then
                    begin
                        Continue;
                    end;

                    text_units := get_text_unit_count(candidate_text);
                    if text_units <> input_syllables then
                    begin
                        Continue;
                    end;

                    if (exact_same_key_results[exact_idx].source <> cs_user) and
                        (not exact_same_key_results[exact_idx].has_dict_weight) then
                    begin
                        exact_same_key_results[exact_idx].has_dict_weight := True;
                        exact_same_key_results[exact_idx].dict_weight :=
                            exact_same_key_results[exact_idx].score;
                    end;
                    Inc(exact_same_key_results[exact_idx].score,
                        c_incomplete_trailing_prefix_visible_bonus +
                        c_exact_same_key_visible_bonus);
                    SetLength(exact_matches, Length(exact_matches) + 1);
                    exact_matches[High(exact_matches)] :=
                        exact_same_key_results[exact_idx];
                end;
            end;

            if dictionary_prefix_lookup_cached(value, lookup_results) then
            begin
                for candidate_idx := 0 to High(lookup_results) do
                begin
                    candidate_text := Trim(lookup_results[candidate_idx].text);
                    if (candidate_text = '') or (lookup_results[candidate_idx].comment <> '') then
                    begin
                        Continue;
                    end;

                    if exact_same_key_found then
                    begin
                        for exact_idx := 0 to High(exact_same_key_results) do
                        begin
                            if (Trim(exact_same_key_results[exact_idx].comment) = '') and
                                SameText(Trim(exact_same_key_results[exact_idx].text),
                                candidate_text) then
                            begin
                                candidate_text := '';
                                Break;
                            end;
                        end;
                        if candidate_text = '' then
                        begin
                            Continue;
                        end;
                    end;

                    text_units := get_text_unit_count(candidate_text);
                    if (text_units > input_syllables + 1) or (text_units < 2) then
                    begin
                        Continue;
                    end;

                    if (lookup_results[candidate_idx].source <> cs_user) and
                        (not lookup_results[candidate_idx].has_dict_weight) then
                    begin
                        lookup_results[candidate_idx].has_dict_weight := True;
                        lookup_results[candidate_idx].dict_weight := lookup_results[candidate_idx].score;
                    end;
                    Inc(lookup_results[candidate_idx].score,
                        c_incomplete_trailing_prefix_visible_bonus);
                    SetLength(exact_matches, Length(exact_matches) + 1);
                    exact_matches[High(exact_matches)] := lookup_results[candidate_idx];
                end;
            end;

            if Length(exact_matches) = 0 then
            begin
                Exit;
            end;

            clear_candidate_comments(exact_matches);
            sort_candidates_lightweight(exact_matches);
            if Length(exact_matches) > c_incomplete_trailing_prefix_limit then
            begin
                SetLength(exact_matches, c_incomplete_trailing_prefix_limit);
            end;
            candidates := merge_candidate_lists(candidates, exact_matches, 0);
            Result := True;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (pinyin_key = '') or
            (not c_suppress_nonlexicon_complete_long_candidates) then
        begin
            Exit;
        end;

        effective_syllables := get_effective_compact_pinyin_syllables(pinyin_key);
        input_syllables := Length(effective_syllables);
        if input_syllables < 3 then
        begin
            Exit;
        end;
        if Length(effective_syllables) = 0 then
        begin
            Exit;
        end;

        last_syllable_text := Trim(effective_syllables[High(effective_syllables)].text);
        if (last_syllable_text = '') or
            ((input_syllables >= 4) and
            (not is_extendable_trailing_prefix_local)) then
        begin
            Exit;
        end;

        if has_exact_long_complete_candidate then
        begin
            Exit;
        end;

        if try_merge_prefix_probe_key(pinyin_key) then
        begin
            Exit(True);
        end;

        if input_syllables < 5 then
        begin
            Exit(False);
        end;

        if try_merge_probe_key(pinyin_key) then
        begin
            Exit(True);
        end;

        probe_key := pinyin_key;
        shortest_tail_probe_key := '';
        if Length(probe_key) > 1 then
        begin
            SetLength(probe_key, Length(probe_key) - 1);
            probe_syllables := get_effective_compact_pinyin_unit_count(probe_key);
            if probe_syllables = input_syllables then
            begin
                if try_merge_probe_key(probe_key) then
                begin
                    Exit(True);
                end;
            end;
        end;

        tail_trim_chars := Length(last_syllable_text) - 1;
        if tail_trim_chars <= 0 then
        begin
            Exit;
        end;

        if Length(pinyin_key) <= tail_trim_chars then
        begin
            Exit;
        end;

        shortest_tail_probe_key := Copy(pinyin_key, 1, Length(pinyin_key) - tail_trim_chars);
        if shortest_tail_probe_key = probe_key then
        begin
            Exit;
        end;

        probe_syllables := get_effective_compact_pinyin_unit_count(shortest_tail_probe_key);
        if probe_syllables <> input_syllables then
        begin
            Exit;
        end;

        Result := try_merge_probe_key(shortest_tail_probe_key);
    end;

    function try_build_best_single_char_chain(out out_candidate: TncCandidate): Boolean;
    begin
        Result := False;
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
    end;

    function try_build_runtime_chain_candidate(out out_candidate: TncCandidate): Boolean;
    const
        c_runtime_phrase_bonus = 220;
        c_runtime_phrase_per_syllable = 24;
        c_runtime_phrase_friendly_bonus = 150;
        c_runtime_phrase_long_bonus = 80;
    begin
        Result := False;
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        Exit;

        Result := try_build_best_single_char_chain(out_candidate);
        if not Result then
        begin
            Exit;
        end;

        if get_text_unit_count(out_candidate.text) <> input_syllable_count then
        begin
            Result := False;
            Exit;
        end;

        Inc(out_candidate.score, c_runtime_phrase_bonus + (input_syllable_count * c_runtime_phrase_per_syllable));
        if input_syllable_count >= 3 then
        begin
            Inc(out_candidate.score, c_runtime_phrase_long_bonus);
        end;
        if is_runtime_constructed_phrase_friendly(out_candidate.text) then
        begin
            Inc(out_candidate.score, c_runtime_phrase_friendly_bonus);
        end;
        out_candidate.comment := '';
        out_candidate.source := cs_rule;
    end;

    function try_build_runtime_redup_candidate(out out_candidate: TncCandidate): Boolean;
    const
        c_runtime_redup_bonus = 420;
    var
        parser: TncPinyinParser;
        syllables: TncPinyinParseResult;
        local_lookup: TncCandidateList;
        idx: Integer;
        best_index: Integer;
        best_rank: Integer;
        rank_score: Integer;
        chosen: TncCandidate;
    begin
        Result := False;
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        Exit;

        if (not repeated_two_syllable_query) or (m_dictionary = nil) then
        begin
            Exit;
        end;

        parser := TncPinyinParser.create;
        try
            syllables := parser.parse(lookup_text);
        finally
            parser.Free;
        end;

        if Length(syllables) <> 2 then
        begin
            Exit;
        end;

        if not dictionary_lookup_cached(syllables[0].text, local_lookup) then
        begin
            Exit;
        end;

        best_index := -1;
        best_rank := Low(Integer);
        for idx := 0 to High(local_lookup) do
        begin
            chosen := local_lookup[idx];
            if not is_single_text_unit(Trim(chosen.text)) then
            begin
                Continue;
            end;

            rank_score := chosen.score;
            if chosen.source = cs_user then
            begin
                Inc(rank_score, c_user_score_bonus);
            end;
            if is_preferred_partial_single_char_candidate(chosen) then
            begin
                Inc(rank_score, 80);
            end;
            if rank_score > best_rank then
            begin
                best_rank := rank_score;
                best_index := idx;
            end;
        end;

        if best_index < 0 then
        begin
            Exit;
        end;

    end;

