        c_probe_limit = 8;
    var
        idx: Integer;
        unit_idx: Integer;
        existing_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
        candidate_units_local: TArray<string>;
        replacement_candidate_local: TncCandidate;
        replacement_text_local: string;
        best_replacement_text_local: string;
        best_replacement_candidate_local: TncCandidate;

