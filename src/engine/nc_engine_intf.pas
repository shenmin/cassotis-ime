            function get_compact_suffix_context_adjustment_local(
                const chunk_last_syllable_local: string;
                const chunk_text_local: string;
                const suffix_text_local: string): Integer;
            begin
                Result := 0;
            end;

            function try_get_compact_protected_span_text_local(
                const local_start_idx: Integer; const local_span_len: Integer;
                out out_text: string; out out_weight: Integer;
                out out_rank: Integer): Boolean;
            const
                c_protected_probe_limit_local = 8;
                c_protected_min_weight_local = 260;
            var
                cache_key_local: string;
                cached_weight_local: Integer;
                local_key: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                local_text: string;
                local_weight: Integer;
            begin
                Result := False;
                out_text := '';
                out_weight := 0;
                out_rank := 0;
                if (local_span_len < 2) or (local_span_len > 4) or
                    (local_start_idx < 0) or
                    (local_start_idx + local_span_len >
                    Length(syllables_local)) then
                begin
                    Exit;
                end;

                cache_key_local := IntToStr(local_start_idx) + ':' +
                    IntToStr(local_span_len);
                if (compact_protected_span_weight_cache_local <> nil) and
                    compact_protected_span_weight_cache_local.TryGetValue(
                    cache_key_local, cached_weight_local) then
                begin
                    if cached_weight_local <= 0 then
                    begin
                        Exit(False);
                    end;
                    out_weight := cached_weight_local;
                    if compact_protected_span_text_cache_local <> nil then
                    begin
                        compact_protected_span_text_cache_local.TryGetValue(
                            cache_key_local, out_text);
                    end;
                    if compact_protected_span_rank_cache_local <> nil then
                    begin
                        compact_protected_span_rank_cache_local.TryGetValue(
                            cache_key_local, out_rank);
                    end;
                    Exit(out_text <> '');
                end;

                local_key := build_query_key_local(local_start_idx,
                    local_span_len);
                if (local_key = '') or
                    (not lookup_exact_full_pinyin_cached_local(local_key,
                    local_results)) then
                begin
                    if compact_protected_span_weight_cache_local <> nil then
                    begin
                        compact_protected_span_weight_cache_local.AddOrSetValue(
                            cache_key_local, -1);
                    end;
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_protected_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results[local_idx].dict_weight,
                        local_results[local_idx].has_dict_weight) then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(local_results[local_idx]) or
                        is_runtime_common_pattern_candidate(local_results[local_idx]) or
                        is_runtime_redup_candidate(local_results[local_idx]) then
                    begin
                        Continue;
                    end;

                    local_text := Trim(local_results[local_idx].text);
                    if (local_text = '') or
                        (get_candidate_text_unit_count(local_text) <>
                        local_span_len) then
                    begin
                        Continue;
                    end;

                    local_weight := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight > local_weight) then
                    begin
                        local_weight := local_results[local_idx].dict_weight;
                    end;
                    if local_weight < c_protected_min_weight_local then
                    begin
                        Continue;
                    end;
                    if not (((local_idx = 0) and
                        (((local_span_len = 2) and (local_weight >= 650)) or
                        ((local_span_len = 3) and (local_weight >= 420)) or
                        ((local_span_len >= 4) and (local_weight >= 360)))) or
                        ((local_idx = 1) and (local_span_len >= 3) and
                        (local_weight >= 900))) then
                    begin
                        Continue;
                    end;

                    out_text := local_text;
                    out_weight := local_weight;
                    out_rank := local_idx + 1;
                    if compact_protected_span_weight_cache_local <> nil then
                    begin
                        compact_protected_span_weight_cache_local.AddOrSetValue(
                            cache_key_local, out_weight);
                    end;
                    if compact_protected_span_text_cache_local <> nil then
                    begin
                        compact_protected_span_text_cache_local.AddOrSetValue(
                            cache_key_local, out_text);
                    end;
                    if compact_protected_span_rank_cache_local <> nil then
                    begin
                        compact_protected_span_rank_cache_local.AddOrSetValue(
                            cache_key_local, out_rank);
                    end;
                    Exit(True);
                end;

                if compact_protected_span_weight_cache_local <> nil then
                begin
                    compact_protected_span_weight_cache_local.AddOrSetValue(
                        cache_key_local, -1);
                end;
            end;

            function get_compact_protected_span_adjustment_local(
                const local_start_idx: Integer; const local_span_len: Integer;
                const local_text: string): Integer;
            var
                span_start: Integer;
                span_len: Integer;
                protected_text: string;
                protected_weight: Integer;
                protected_rank: Integer;
                local_units: TArray<string>;
                protected_units: TArray<string>;
                overlap_start: Integer;
                overlap_end: Integer;
                unit_pos: Integer;
                mismatch: Boolean;
                penalty: Integer;
                bonus: Integer;
            begin
                Result := 0;
                if (local_text = '') or (local_span_len <= 0) then
                begin
                    Exit;
                end;

                if (local_span_len >= 2) and
                    try_get_compact_protected_span_text_local(local_start_idx,
                    local_span_len, protected_text, protected_weight,
                    protected_rank) and SameText(protected_text, local_text) then
                begin
                    bonus := 220 + (local_span_len * 80) +
                        Min(360, protected_weight div 4);
                    if (local_span_len >= 3) and (protected_rank = 1) and
                        (protected_weight >= 900) then
                    begin
                        Inc(bonus, Min(9000, protected_weight * 6) +
                            Max(0, local_span_len - 2) * 1800);
                    end;
                    if protected_rank > 1 then
                    begin
                        Dec(bonus, (protected_rank - 1) * 50);
                    end;
                    if bonus > 0 then
                    begin
                        Inc(Result, bonus);
                    end;
                end;

                local_units := split_text_units(Trim(local_text));
                if Length(local_units) <> local_span_len then
                begin
                    Exit;
                end;

                for span_start := Max(0, local_start_idx - 3) to
                    Min(local_start_idx + local_span_len - 1,
                    Length(syllables_local) - 1) do
                begin
                    for span_len := 2 to 4 do
                    begin
                        if span_start + span_len > Length(syllables_local) then
                        begin
                            Break;
                        end;
                        if (span_start = local_start_idx) and
                            (span_len = local_span_len) then
                        begin
                            Continue;
                        end;
                        if (span_start >= local_start_idx + local_span_len) or
                            (local_start_idx >= span_start + span_len) then
                        begin
                            Continue;
                        end;
                        if not try_get_compact_protected_span_text_local(
                            span_start, span_len, protected_text,
                            protected_weight, protected_rank) then
                        begin
                            Continue;
                        end;

                        protected_units := split_text_units(Trim(protected_text));
                        if Length(protected_units) <> span_len then
                        begin
                            Continue;
                        end;

                        overlap_start := Max(local_start_idx, span_start);
                        overlap_end := Min(local_start_idx + local_span_len,
                            span_start + span_len);
                        if (overlap_end - overlap_start) < 2 then
                        begin
                            Continue;
                        end;
                        mismatch := False;
                        for unit_pos := overlap_start to overlap_end - 1 do
                        begin
                            if not SameText(local_units[unit_pos - local_start_idx],
                                protected_units[unit_pos - span_start]) then
                            begin
                                mismatch := True;
                                Break;
                            end;
                        end;
                        if not mismatch then
                        begin
                            Continue;
                        end;

                        penalty := 360 + (span_len * 160) +
                            ((overlap_end - overlap_start) * 220) +
                            Min(1800, protected_weight);
                        if (span_len >= 3) and (protected_rank = 1) and
                            (protected_weight >= 900) then
                        begin
                            Inc(penalty, Min(9000, protected_weight * 6) +
                                Max(0, span_len - 2) * 1800);
                        end;
                        if protected_rank > 1 then
                        begin
                            Dec(penalty, (protected_rank - 1) * 100);
                        end;
                        if penalty > 0 then
                        begin
                            Dec(Result, penalty);
                        end;
                    end;
                end;
            end;

            function compact_direct_exact_lookup_has_text_local(
                const local_query_key: string; const local_text: string;
                const local_expected_units: Integer): Boolean;
            var
                local_results: TncCandidateList;
                local_idx: Integer;
                candidate_text_local: string;
            begin
                Result := False;
                if (local_query_key = '') or (local_text = '') or
                    (local_expected_units <= 0) then
                begin
                    Exit;
                end;
                if not lookup_exact_full_pinyin_cached_local(local_query_key,
                    local_results) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_span_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results[local_idx].dict_weight,
                        local_results[local_idx].has_dict_weight) then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(local_results[local_idx]) or
                        is_runtime_common_pattern_candidate(
                        local_results[local_idx]) or
                        is_runtime_redup_candidate(local_results[local_idx]) then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(local_results[local_idx].text);
                    if SameText(candidate_text_local, local_text) and
                        (get_candidate_text_unit_count(candidate_text_local) =
                        local_expected_units) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function compact_nonbase_two_plus_single_exact_chunk_local(
                const local_query_key: string; const local_chunk_len: Integer;
                const local_text: string): Boolean;
            var
                local_syllables: TncPinyinParseResult;
                local_units: TArray<string>;
                head_key_local: string;
                tail_key_local: string;
                tail_syllable_local: string;
                head_text_local: string;
                tail_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (local_chunk_len <> 3) then
                begin
                    Exit;
                end;
                if m_dictionary.is_base_entry(local_query_key, local_text) or
                    m_dictionary.is_user_entry(local_query_key, local_text) then
                begin
                    Exit;
                end;

                local_syllables := get_effective_compact_pinyin_syllables(
                    local_query_key);
                local_units := split_text_units(Trim(local_text));
                if (Length(local_syllables) <> 3) or
                    (Length(local_units) <> 3) then
                begin
                    Exit;
                end;

                tail_syllable_local := normalize_pinyin_text(
                    local_syllables[2].text);
                if (tail_syllable_local = 'de') or
                    (tail_syllable_local = 'le') or
                    (tail_syllable_local = 'la') or
                    (tail_syllable_local = 'ba') or
                    (tail_syllable_local = 'ma') then
                begin
                    Exit;
                end;

                head_key_local := normalize_pinyin_text(local_syllables[0].text) +
                    normalize_pinyin_text(local_syllables[1].text);
                tail_key_local := tail_syllable_local;
                head_text_local := local_units[0] + local_units[1];
                tail_text_local := local_units[2];

                Result := compact_direct_exact_lookup_has_text_local(
                    head_key_local, head_text_local, 2) and
                    (compact_direct_exact_lookup_has_text_local(tail_key_local,
                    tail_text_local, 1) or
                    m_dictionary.single_char_matches_pinyin(tail_key_local,
                    tail_text_local));
            end;

            function compact_allows_fixed_single_before_phrase_local(
                const local_fixed_text: string): Boolean;
            begin
                Result := is_pronoun_fixed_single_text_local(local_fixed_text) or
                    is_bridge_fixed_single_text_local(local_fixed_text) or
                    (local_fixed_text = string(Char($6CA1))) or
                    (local_fixed_text = string(Char($4E00))) or

                    (local_fixed_text = string(Char($4E5F))) or
                    (local_fixed_text = string(Char($90FD))) or
                    (local_fixed_text = string(Char($5728))) or
                    (local_fixed_text = string(Char($53BB))) or
                    (local_fixed_text = string(Char($548C)));
            end;

            function try_get_best_exact_phrase_span_local(
                const local_start_idx: Integer; const local_span_len: Integer;
                out out_span_text: string; out out_span_score: Integer): Boolean;
            var
                span_key_local: string;
                span_results_local: TncCandidateList;
                span_idx_local: Integer;
                candidate_text_local: string;
                candidate_units_local: Integer;
                candidate_score_local: Integer;
                subphrase_text_local: string;
                subphrase_score_local: Integer;
                fixed_single_text_local: string;
                combined_text_local: string;
                combined_score_local: Integer;
                has_full_exact_span_local: Boolean;

                function try_get_exact_subphrase_local(
                    const local_sub_start_idx: Integer;
                    const local_sub_len: Integer; out out_sub_text: string;
                    out out_sub_score: Integer): Boolean;
                var
                    sub_key_local: string;
                    sub_results_local: TncCandidateList;
                    sub_idx_local: Integer;
                    sub_text_local: string;
                    sub_units_local: Integer;
                    sub_score_local: Integer;
                begin
                    Result := False;
                    out_sub_text := '';
                    out_sub_score := 0;
                    if (local_sub_len < 2) or (local_sub_len > 4) or
                        (local_sub_start_idx < 0) or
                        (local_sub_start_idx + local_sub_len >
                        Length(syllables_local)) then
                    begin
                        Exit;
                    end;

                    sub_key_local := build_query_key_local(local_sub_start_idx,
                        local_sub_len);
                    if (sub_key_local = '') or
                        (not lookup_exact_full_pinyin_cached_local(sub_key_local,
                        sub_results_local)) then
                    begin
                        Exit;
                    end;

                    for sub_idx_local := 0 to High(sub_results_local) do
                    begin
                        if sub_idx_local >= c_span_probe_limit_local then
                        begin
                            Break;
                        end;
                        if Trim(sub_results_local[sub_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if not long_exact_chunk_weight_is_eligible(
                            sub_results_local[sub_idx_local].dict_weight,
                            sub_results_local[sub_idx_local].has_dict_weight) then
                        begin
                            Continue;
                        end;
                        if is_runtime_chain_candidate(sub_results_local[sub_idx_local]) or
                            is_runtime_common_pattern_candidate(
                            sub_results_local[sub_idx_local]) or
                            is_runtime_redup_candidate(sub_results_local[sub_idx_local]) then
                        begin
                            Continue;
                        end;

                        sub_text_local := Trim(sub_results_local[sub_idx_local].text);
                        sub_units_local := get_candidate_text_unit_count(
                            sub_text_local);
                        if (sub_text_local = '') or
                            (sub_units_local <> local_sub_len) then
                        begin
                            Continue;
                        end;
                        if compact_nonbase_two_plus_single_exact_chunk_local(
                            sub_key_local, local_sub_len, sub_text_local) then
                        begin
                            Continue;
                        end;

                        sub_score_local := sub_results_local[sub_idx_local].score;
                        if sub_results_local[sub_idx_local].has_dict_weight and
                            (sub_results_local[sub_idx_local].dict_weight >
                            sub_score_local) then
                        begin
                            sub_score_local :=
                                sub_results_local[sub_idx_local].dict_weight;
                        end;
                        if sub_score_local < 0 then
                        begin
                            sub_score_local := 0;
                        end;
                        sub_score_local := sub_score_local * c_weight_scale_local +
                            local_sub_len * 2600 - sub_idx_local * 48;
                        Inc(sub_score_local,
                            get_temporal_process_context_bonus_local(
                            sub_text_local, local_sub_start_idx));
                        if local_sub_len >= 3 then
                        begin
                            Inc(sub_score_local, 900);
                        end;

                        if (not Result) or (sub_score_local > out_sub_score) then
                        begin
                            Result := True;
                            out_sub_text := sub_text_local;
                            out_sub_score := sub_score_local;
                        end;
                    end;
                end;

                procedure consider_span_result_local(const local_text: string;
                    const local_score: Integer);
                begin
                    if (local_text = '') or
                        (get_candidate_text_unit_count(local_text) <>
                        local_span_len) then
                    begin
                        Exit;
                    end;
                    if (not Result) or (local_score > out_span_score) then
                    begin
                        Result := True;
                        out_span_text := local_text;
                        out_span_score := local_score;
                    end;
                end;
            begin
                Result := False;
                out_span_text := '';
                out_span_score := 0;
                has_full_exact_span_local := False;
                if (local_span_len < 2) or (local_span_len > 4) or
                    (local_start_idx < 0) or
                    (local_start_idx + local_span_len > Length(syllables_local)) then
                begin
                    Exit;
                end;

                span_key_local := build_query_key_local(local_start_idx,
                    local_span_len);
                if span_key_local = '' then
                begin
                    Exit;
                end;

                SetLength(span_results_local, 0);
                if lookup_exact_full_pinyin_cached_local(span_key_local,
                    span_results_local) then
                begin
                    for span_idx_local := 0 to High(span_results_local) do
                    begin
                        if span_idx_local >= c_span_probe_limit_local then
                        begin
                            Break;
                        end;
                        if Trim(span_results_local[span_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if not long_exact_chunk_weight_is_eligible(
                            span_results_local[span_idx_local].dict_weight,
                            span_results_local[span_idx_local].has_dict_weight) then
                        begin
                            Continue;
                        end;
                        if is_runtime_chain_candidate(span_results_local[span_idx_local]) or
                            is_runtime_common_pattern_candidate(
                            span_results_local[span_idx_local]) or
                            is_runtime_redup_candidate(span_results_local[span_idx_local]) then
                        begin
                            Continue;
                        end;

                        candidate_text_local := Trim(
                            span_results_local[span_idx_local].text);
                        candidate_units_local :=
                            get_candidate_text_unit_count(candidate_text_local);
                        if (candidate_text_local = '') or
                            (candidate_units_local <> local_span_len) then
                        begin
                            Continue;
                        end;
                        if compact_nonbase_two_plus_single_exact_chunk_local(
                            span_key_local, local_span_len,
                            candidate_text_local) then
                        begin
                            Continue;
                        end;

                        candidate_score_local := span_results_local[span_idx_local].score;
                        if span_results_local[span_idx_local].has_dict_weight and
                            (span_results_local[span_idx_local].dict_weight >
                            candidate_score_local) then
                        begin
                            candidate_score_local :=
                                span_results_local[span_idx_local].dict_weight;
                        end;
                        if candidate_score_local < 0 then
                        begin
                            candidate_score_local := 0;
                        end;
                        fixed_single_text_local := get_fixed_single_text_local(
                            syllables_local[local_start_idx].text);
                        if (local_span_len = 2) and
                            (fixed_single_text_local <> '') and
                            (candidate_score_local <
                            c_weak_fixed_head_phrase_weight) and
                            (not SameText(
                            get_compact_first_text_unit_local(candidate_text_local),
                            fixed_single_text_local)) then
                        begin
                            Continue;
                        end;
                        candidate_score_local := candidate_score_local *
                            c_weight_scale_local + local_span_len * 2600 -
                            span_idx_local * 48;
                        Inc(candidate_score_local,
                            get_directional_locative_span_bonus_local(
                            candidate_text_local));
                        Inc(candidate_score_local,
                            get_directional_locative_context_bonus_local(
                            candidate_text_local, local_start_idx, local_span_len));
                        Inc(candidate_score_local,
                            get_temporal_process_context_bonus_local(
                            candidate_text_local, local_start_idx));
                        if local_span_len >= 3 then
                        begin
                            Inc(candidate_score_local, 900);
                        end;
                        Inc(candidate_score_local,
                            get_compact_protected_span_adjustment_local(
                            local_start_idx, local_span_len, candidate_text_local));

                        consider_span_result_local(candidate_text_local,
                            candidate_score_local);
                        if Result then
                        begin
                            has_full_exact_span_local := True;
                        end;
                    end;
                end;

                if (local_span_len >= 3) and (not has_full_exact_span_local) then
                begin
                    fixed_single_text_local := get_fixed_single_text_local(
                        syllables_local[local_start_idx].text);
                    if (fixed_single_text_local <> '') and
                        (not should_skip_fixed_single_chain_step_local(
                        local_start_idx, fixed_single_text_local)) and
                        try_get_exact_subphrase_local(local_start_idx + 1,
                        local_span_len - 1, subphrase_text_local,
                        subphrase_score_local) then
                    begin
                        combined_text_local := fixed_single_text_local +
                            subphrase_text_local;
                        combined_score_local := subphrase_score_local +
                            52000 + local_span_len * 2200;
                        if (local_span_len <> 3) or
                            compact_allows_fixed_single_before_phrase_local(
                            fixed_single_text_local) or
                            m_dictionary.is_base_entry(span_key_local,
                            combined_text_local) or
                            m_dictionary.is_user_entry(span_key_local,
                            combined_text_local) then
                        begin
                            if is_bridge_fixed_single_text_local(
                                fixed_single_text_local) then
                            begin
                                Inc(combined_score_local,
                                    c_bridge_single_before_phrase_bonus);
                            end;
                            if is_pronoun_fixed_single_text_local(
                                fixed_single_text_local) then
                            begin
                                Inc(combined_score_local,
                                    c_pronoun_before_phrase_bonus);
                            end;
                            Inc(combined_score_local,
                                get_compact_protected_span_adjustment_local(
                                local_start_idx, local_span_len,
                                combined_text_local));
                            consider_span_result_local(combined_text_local,
                                combined_score_local);
                        end;
                    end;

                    fixed_single_text_local := get_fixed_single_text_local(
                        syllables_local[local_start_idx + local_span_len - 1].text);
                    if (fixed_single_text_local <> '') and
                        try_get_exact_subphrase_local(local_start_idx,
                        local_span_len - 1, subphrase_text_local,
                        subphrase_score_local) then
                    begin
                        combined_text_local := subphrase_text_local +
                            fixed_single_text_local;
                        combined_score_local := subphrase_score_local +
                            36000 + local_span_len * 1800;
                        if not compact_nonbase_two_plus_single_exact_chunk_local(
                            span_key_local, local_span_len,
                            combined_text_local) then
                        begin
                            if is_bridge_fixed_single_text_local(
                                fixed_single_text_local) then
                            begin
                                Inc(combined_score_local,
                                    c_bridge_single_before_phrase_bonus div 2);
                            end;
                            if is_pronoun_fixed_single_text_local(
                                fixed_single_text_local) then
                            begin
                                Inc(combined_score_local,
                                    c_pronoun_before_phrase_bonus div 2);
                            end;
                            Inc(combined_score_local,
                                get_compact_protected_span_adjustment_local(
                                local_start_idx, local_span_len,
                                combined_text_local));
                            consider_span_result_local(combined_text_local,
                                combined_score_local);
                        end;
                    end;
                end;
            end;

            function try_get_fixed_single_span_local(
                const local_start_idx: Integer;
                out out_span_text: string; out out_span_score: Integer): Boolean;
            begin
                Result := False;
                out_span_text := '';
                out_span_score := 0;
                if (local_start_idx < 0) or
                    (local_start_idx >= Length(syllables_local)) then
                begin
                    Exit;
                end;

                out_span_text := get_fixed_single_text_local(
                    syllables_local[local_start_idx].text);
                if out_span_text = '' then
                begin
                    Exit;
                end;
                if should_skip_fixed_single_chain_step_local(local_start_idx,
                    out_span_text) then
                begin
                    Exit;
                end;

                out_span_score := 3600;
                if is_bridge_fixed_single_text_local(out_span_text) then
                begin
                    Inc(out_span_score, c_bridge_single_before_phrase_bonus);
                end;
                if is_pronoun_fixed_single_text_local(out_span_text) then
                begin
                    Inc(out_span_score, c_pronoun_before_phrase_bonus);
                end;
                Result := True;
            end;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := 0;
            out_phrase_count := 0;

            if (input_syllable_count < 5) or (input_syllable_count > 8) then
            begin
                Exit;
            end;

            compact_protected_span_text_cache_local :=
                TDictionary<string, string>.Create;
            compact_protected_span_weight_cache_local :=
                TDictionary<string, Integer>.Create;
            compact_protected_span_rank_cache_local :=
                TDictionary<string, Integer>.Create;
            try
                SetLength(best_scores_local, Length(syllables_local) + 1);
                SetLength(best_texts_local, Length(syllables_local) + 1);
                SetLength(best_paths_local, Length(syllables_local) + 1);
                SetLength(best_phrase_counts_local, Length(syllables_local) + 1);
                SetLength(best_single_counts_local, Length(syllables_local) + 1);
                for pos_local := 0 to High(best_scores_local) do
                begin
                    best_scores_local[pos_local] := c_low_score_local;
                    best_texts_local[pos_local] := '';
                    best_paths_local[pos_local] := '';
                    best_phrase_counts_local[pos_local] := 0;
                    best_single_counts_local[pos_local] := 0;
                end;
                best_scores_local[Length(syllables_local)] := 0;

                for pos_local := Length(syllables_local) - 1 downto 0 do
                begin
                    for span_len_local := Min(4, Length(syllables_local) -
                        pos_local) downto 1 do
                    begin
                        next_pos_local := pos_local + span_len_local;
                        if best_scores_local[next_pos_local] <=
                            c_low_score_local div 2 then
                        begin
                            Continue;
                        end;
                        if span_len_local >= 2 then
                        begin
                            if not try_get_best_exact_phrase_span_local(pos_local,
                                span_len_local, span_text_local,
                                span_score_local) then
                            begin
                                Continue;
                            end;
                        end
                        else if not try_get_fixed_single_span_local(pos_local,
                            span_text_local, span_score_local) then
                        begin
                            Continue;
                        end;

                        combined_score_local := span_score_local +
                            best_scores_local[next_pos_local] -
                            c_segment_penalty_local;
                        if best_texts_local[next_pos_local] <> '' then
                        begin
                            suffix_adjustment_local :=
                                get_compact_suffix_context_adjustment_local(
                                syllables_local[next_pos_local - 1].text,
                                span_text_local, best_texts_local[next_pos_local]);
                            Inc(combined_score_local, suffix_adjustment_local);
                        end;
                        if combined_score_local <= best_scores_local[pos_local] then
                        begin
                            Continue;
                        end;

                        best_scores_local[pos_local] := combined_score_local;
                        best_texts_local[pos_local] := span_text_local +
                            best_texts_local[next_pos_local];
                        combined_path_local := span_text_local;
                        if best_paths_local[next_pos_local] <> '' then
                        begin
                            combined_path_local := combined_path_local +
                                c_segment_path_separator +
                                best_paths_local[next_pos_local];
                        end;
                        best_paths_local[pos_local] := combined_path_local;
                        best_phrase_counts_local[pos_local] :=
                            best_phrase_counts_local[next_pos_local];
                        best_single_counts_local[pos_local] :=
                            best_single_counts_local[next_pos_local];
                        if span_len_local >= 2 then
                        begin
                            Inc(best_phrase_counts_local[pos_local]);
                        end
                        else
                        begin
                            Inc(best_single_counts_local[pos_local]);
                        end;
                    end;
                end;

                if (best_scores_local[0] <= c_low_score_local div 2) or
                    (best_texts_local[0] = '') or
                    (get_candidate_text_unit_count(best_texts_local[0]) <>
                    input_syllable_count) or
                    (best_phrase_counts_local[0] < c_min_phrase_count_local) or
                    (best_single_counts_local[0] > best_phrase_counts_local[0] + 1) then
                begin
                    Exit;
                end;

                out_text := best_texts_local[0];
                out_path := best_paths_local[0];
                out_score := best_scores_local[0] + 18000;
                out_phrase_count := best_phrase_counts_local[0];
                Result := True;
            finally
                compact_protected_span_rank_cache_local.Free;
                compact_protected_span_weight_cache_local.Free;
                compact_protected_span_text_cache_local.Free;
            end;
        end;
    begin
        Result := False;
        out_encoded_path := '';
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := True;
        out_candidate.dict_weight := 0;

        if (m_dictionary = nil) or (lookup_text = '') or
            (input_syllable_count < c_min_syllables) or
            (not is_full_pinyin_key(lookup_text)) or
            all_initial_compact_query or has_internal_dangling_initial or
            has_explicit_apostrophe_input then
        begin
            Exit;
        end;
        if has_strong_full_query_exact_complete_candidate_local then
        begin
            // Exact span chains are fallback composition. Do not build a
            // competing full-length chain when the full query already has a
            // strong exact dictionary/user hit.
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;
        if has_precise_extendable_tail_syllable_local(lookup_text) and
            (get_fixed_single_text_local(
            syllables_local[High(syllables_local)].text) = '') and
            (not has_complete_exact_tail_phrase_local(4)) and
            (not has_complete_exact_tail_phrase_local(3)) and
            (not has_resolved_final_tail_three_syllable_span_local) and
            (not (((input_syllable_count >= 6) or
            ((Length(syllables_local) >= 3) and
            (get_fixed_single_text_local(
            syllables_local[High(syllables_local) - 2].text) <> ''))) and
            has_complete_exact_tail_phrase_local(2))) then
        begin
            Exit;
        end;

        if try_build_compact_exact_phrase_chain_fast_local(text_local,
            encoded_path_local, chain_score_local, phrase_count_local) then
        begin
            out_candidate.score := c_base_score + chain_score_local;
            out_candidate.text := text_local;
            out_candidate.comment := '';
            out_candidate.dict_weight := out_candidate.score;
            out_encoded_path := encoded_path_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' dchain=[%s/%s phr=%d score=%d path=%s]',
                    [out_candidate.text, out_candidate.comment, phrase_count_local,
                    out_candidate.score, out_encoded_path]);
            end;
            Result := True;
            Exit;
        end;

        if try_build_generic_exact_chain_fast_local(text_local,
            encoded_path_local, chain_score_local, phrase_count_local) then
        begin
            out_candidate.score := c_base_score + chain_score_local;
            out_candidate.text := text_local;
            out_candidate.comment := '';
            out_candidate.dict_weight := out_candidate.score;
            out_encoded_path := encoded_path_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' dchain=[%s/%s phr=%d score=%d path=%s]',
                    [out_candidate.text, out_candidate.comment, phrase_count_local,
                    out_candidate.score, out_encoded_path]);
            end;
            Result := True;
            Exit;
        end;

        SetLength(memo_known_local, Length(syllables_local) + 1);
        SetLength(memo_success_local, Length(syllables_local) + 1);
        SetLength(memo_text_local, Length(syllables_local) + 1);
        SetLength(memo_path_local, Length(syllables_local) + 1);
        SetLength(memo_score_local, Length(syllables_local) + 1);
        SetLength(memo_phrase_count_local, Length(syllables_local) + 1);

        if not try_build_from_pos_local(0, text_local, encoded_path_local,
            chain_score_local, phrase_count_local) then
        begin
            Exit;
        end;
        out_candidate.score := c_base_score + chain_score_local;

        if get_candidate_text_unit_count(text_local) <> input_syllable_count then
        begin
            Exit;
        end;

        if (phrase_count_local < 2) and
            (not ((input_syllable_count = 3) and (phrase_count_local >= 1) and
            (Pos(c_segment_path_separator, encoded_path_local) > 0) and
            (is_pronoun_fixed_single_text_local(
            get_first_path_segment_local(encoded_path_local)) or
            is_stable_fixed_single_text_local(
            get_last_path_segment_local(encoded_path_local))))) and
            (not ((phrase_count_local >= 1) and
            stable_fixed_single_chain_with_phrase_local(encoded_path_local))) then
        begin
            Exit;
        end;

        out_candidate.text := text_local;
        out_candidate.comment := '';
        out_candidate.dict_weight := out_candidate.score;
        out_encoded_path := encoded_path_local;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' dchain=[%s/%s phr=%d score=%d path=%s]',
                [out_candidate.text, out_candidate.comment, phrase_count_local,
                out_candidate.score, out_encoded_path]);
        end;
        Result := True;
    end;

    function try_build_stable_leading_prefix_partial_candidate_local(
        out out_candidate: TncCandidate): Boolean;
    const
        c_probe_window = 4;
        c_probe_limit = 16;
        c_prefix_bonus = 3600;
    var
        syllables_local: TncPinyinParseResult;
        prefix_count_local: Integer;
        idx_local: Integer;
        result_idx_local: Integer;
        prefix_key_local: string;
        tail_comment_local: string;
        prefix_results_local: TncCandidateList;
        candidate_text_local: string;
        candidate_units_local: Integer;
        candidate_score_local: Integer;
        best_prefix_idx_local: Integer;
        best_prefix_score_local: Integer;
        ranked_path_local: string;
        path_parts_local: TArray<string>;
        path_text_local: string;
        path_units_local: Integer;
        path_prefix_key_local: string;
        path_tail_comment_local: string;
        best_candidate_local: TncCandidate;
        best_candidate_score_local: Integer;
        best_candidate_units_local: Integer;

        function build_syllable_key_local(const local_start_idx: Integer;
            const local_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := local_start_idx to local_start_idx + local_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function get_stable_single_text_local(const syllable_text: string): string;
        var
            normalized_syllable_local: string;
            fixed_text_local: string;
        begin
            Result := '';
            normalized_syllable_local := normalize_pinyin_text(syllable_text);
            if normalized_syllable_local = '' then
            begin
                Exit;
            end;

            fixed_text_local := get_fixed_resolved_boundary_char_local(
                normalized_syllable_local);
            if fixed_text_local <> '' then
            begin
                Exit(fixed_text_local);
            end;

            Exit;
        end;

        function has_strong_phrase_for_span_local(const local_start_idx: Integer;
            const local_len: Integer): Boolean;
        var
            local_key: string;
            local_text: string;
            local_bonus: Integer;
            local_results: TncCandidateList;
            local_idx: Integer;
            local_candidate_text: string;
        begin
            Result := False;
            if local_len < 2 then
            begin
                Exit;
            end;

            local_key := build_syllable_key_local(local_start_idx, local_len);
            if local_key = '' then
            begin
                Exit;
            end;

            if try_get_preferred_query_phrase_text_local(local_key, local_text,
                local_bonus) and
                (get_candidate_text_unit_count(Trim(local_text)) = local_len) then
            begin
                Exit(True);
            end;

            // Broad lookup only adds prefix/prediction candidates here. For
            // longer path spans an exact miss cannot produce a usable phrase.
            if dictionary_exact_lookup_cached(local_key, local_results) or
                ((local_len <= 2) and
                dictionary_lookup_cached(local_key, local_results)) then
            begin
                for local_idx := 0 to High(local_results) do
                begin
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    local_candidate_text := Trim(local_results[local_idx].text);
                    if get_candidate_text_unit_count(local_candidate_text) =
                        local_len then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function candidate_breaks_preferred_anchor_local(
            const local_text: string; const local_start_idx: Integer;
            const local_len: Integer): Boolean;
        var
            candidate_units_local: TArray<string>;
            anchor_len_local: Integer;
            span_start_local: Integer;
            anchor_key_local: string;
            anchor_text_local: string;
            anchor_bonus_local: Integer;
            anchor_units_local: TArray<string>;
            unit_idx_local: Integer;
            mismatch_local: Boolean;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
            exact_score_local: Integer;
            best_exact_score_local: Integer;
            second_exact_score_local: Integer;
        begin
            Result := False;
            candidate_units_local := split_text_units(Trim(local_text));
            if Length(candidate_units_local) <> local_len then
            begin
                Exit;
            end;

            for anchor_len_local := Min(4, local_len) downto 2 do
            begin
                for span_start_local := 0 to local_len - anchor_len_local do
                begin
                    anchor_key_local := build_syllable_key_local(
                        local_start_idx + span_start_local, anchor_len_local);
                    if anchor_key_local = '' then
                    begin
                        Continue;
                    end;

                    anchor_text_local := '';
                    anchor_bonus_local := 0;
                    if not try_get_preferred_query_phrase_text_local(
                        anchor_key_local, anchor_text_local,
                        anchor_bonus_local) then
                    begin
                        best_exact_score_local := Low(Integer);
                        second_exact_score_local := Low(Integer);
                        if dictionary_exact_lookup_cached(anchor_key_local,
                            exact_results_local) then
                        begin
                            for exact_idx_local := 0 to
                                High(exact_results_local) do
                            begin
                                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                exact_text_local := Trim(
                                    exact_results_local[exact_idx_local].text);
                                if (exact_text_local = '') or
                                    (get_candidate_text_unit_count(
                                    exact_text_local) <> anchor_len_local) then
                                begin
                                    Continue;
                                end;

                                exact_score_local :=
                                    exact_results_local[exact_idx_local].score;
                                if exact_results_local[exact_idx_local].has_dict_weight and
                                    (exact_results_local[exact_idx_local].dict_weight >
                                    exact_score_local) then
                                begin
                                    exact_score_local :=
                                        exact_results_local[exact_idx_local].dict_weight;
                                end;

                                if exact_score_local > best_exact_score_local then
                                begin
                                    second_exact_score_local :=
                                        best_exact_score_local;
                                    best_exact_score_local := exact_score_local;
                                    anchor_text_local := exact_text_local;
                                end
                                else if exact_score_local >
                                    second_exact_score_local then
                                begin
                                    second_exact_score_local :=
                                        exact_score_local;
                                end;
                            end;
                        end;

                        if (anchor_text_local <> '') and
                            ((anchor_len_local >= 3) or
                            (best_exact_score_local >= 4096)) then
                        begin
                            if not (
                                (second_exact_score_local = Low(Integer)) or
                                (best_exact_score_local >=
                                second_exact_score_local + 6000) or
                                ((best_exact_score_local * 100) >=
                                (second_exact_score_local * 165))) then
                            begin
                                anchor_text_local := '';
                            end;
                        end
                        else
                        begin
                            anchor_text_local := '';
                        end;
                    end;

                    if anchor_text_local = '' then
                    begin
                        Continue;
                    end;

                    anchor_units_local := split_text_units(Trim(anchor_text_local));
                    if Length(anchor_units_local) <> anchor_len_local then
                    begin
                        Continue;
                    end;

                    mismatch_local := False;
                    for unit_idx_local := 0 to anchor_len_local - 1 do
                    begin
                        if not SameText(candidate_units_local[span_start_local +
                            unit_idx_local], anchor_units_local[unit_idx_local]) then
                        begin
                            mismatch_local := True;
                            Break;
                        end;
                    end;
                    if mismatch_local then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function candidate_breaks_stable_boundary_local(
            const local_text: string; const local_start_idx: Integer;
            const local_len: Integer): Boolean;
        var
            candidate_units_local: TArray<string>;
            split_idx_local: Integer;
            stable_text_local: string;
        begin
            Result := False;
            if local_len < 3 then
            begin
                Exit;
            end;

            candidate_units_local := split_text_units(Trim(local_text));
            if Length(candidate_units_local) <> local_len then
            begin
                Exit;
            end;

            for split_idx_local := 1 to local_len - 1 do
            begin
                stable_text_local := get_stable_single_text_local(
                    syllables_local[local_start_idx + split_idx_local].text);
                if stable_text_local = '' then
                begin
                    Continue;
                end;
                if not has_strong_phrase_for_span_local(local_start_idx,
                    split_idx_local) then
                begin
                    Continue;
                end;
                if not SameText(candidate_units_local[split_idx_local],
                    stable_text_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function try_build_single_text_local(const local_pos: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
            local_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (m_dictionary = nil) or
                (not m_dictionary.lookup(normalize_pinyin_text(
                syllables_local[local_pos].text), local_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                local_text := Trim(local_results[local_idx].text);
                if get_candidate_text_unit_count(local_text) <> 1 then
                begin
                    Continue;
                end;

                local_score := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > local_score) then
                begin
                    local_score := local_results[local_idx].dict_weight;
                end;
                if (not Result) or (local_score > out_score) then
                begin
                    Result := True;
                    out_text := local_text;
                    out_score := local_score;
                end;
            end;
        end;

        function try_build_preferred_prefix_text_local(
            const local_prefix_count: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        const
            c_max_span = 4;
            c_span_probe_limit = 12;
        var
            local_pos: Integer;
            local_span_len: Integer;
            local_query_key: string;
            local_text: string;
            local_bonus: Integer;
            local_units: TArray<string>;
            local_single_score: Integer;
            phrase_count_local: Integer;
            matched_local: Boolean;

            function try_get_dictionary_span_text_local(
                const local_query_key: string; const local_unit_count: Integer;
                out out_span_text: string; out out_span_score: Integer): Boolean;
            var
                local_results: TncCandidateList;
                local_idx: Integer;
                current_text: string;
                current_score: Integer;
            begin
                Result := False;
                out_span_text := '';
                out_span_score := 0;
                // Keep the broad fallback for one/two-syllable spans only;
                // longer full-pinyin spans must be backed by an exact entry.
                if (local_query_key = '') or
                    ((not dictionary_exact_lookup_cached(local_query_key,
                    local_results)) and
                    ((local_unit_count >= 3) or
                    (not dictionary_lookup_cached(local_query_key,
                    local_results)))) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_span_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    current_text := Trim(local_results[local_idx].text);
                    if (current_text = '') or
                        (get_candidate_text_unit_count(current_text) <>
                        local_unit_count) then
                    begin
                        Continue;
                    end;
                    if candidate_breaks_preferred_anchor_local(current_text,
                        local_pos, local_unit_count) or
                        candidate_breaks_stable_boundary_local(current_text,
                        local_pos, local_unit_count) then
                    begin
                        Continue;
                    end;

                    current_score := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight > current_score) then
                    begin
                        current_score := local_results[local_idx].dict_weight;
                    end;

                    if (not Result) or (current_score > out_span_score) then
                    begin
                        Result := True;
                        out_span_text := current_text;
                        out_span_score := current_score;
                    end;
                end;
            end;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            local_pos := 0;
            phrase_count_local := 0;
            while local_pos < local_prefix_count do
            begin
                matched_local := False;
                local_span_len := Min(c_max_span,
                    local_prefix_count - local_pos);
                while local_span_len >= 2 do
                begin
                    local_query_key := build_syllable_key_local(local_pos,
                        local_span_len);
                    if try_get_preferred_query_phrase_text_local(
                        local_query_key, local_text, local_bonus) then
                    begin
                        local_units := split_text_units(local_text);
                        if Length(local_units) = local_span_len then
                        begin
                            out_text := out_text + local_text;
                            Inc(out_score, local_bonus +
                                local_span_len * 260);
                            Inc(local_pos, local_span_len);
                            Inc(phrase_count_local);
                            matched_local := True;
                            Break;
                        end;
                    end;
                    if (local_span_len <= 3) and
                        try_get_dictionary_span_text_local(local_query_key,
                        local_span_len, local_text, local_bonus) then
                    begin
                        out_text := out_text + local_text;
                        Inc(out_score, 1200 + local_bonus +
                            local_span_len * 220);
                        Inc(local_pos, local_span_len);
                        Inc(phrase_count_local);
                        matched_local := True;
                        Break;
                    end;
                    Dec(local_span_len);
                end;

                if matched_local then
                begin
                    Continue;
                end;

                if (phrase_count_local <= 0) or
                    (not try_build_single_text_local(local_pos, local_text,
                    local_single_score)) then
                begin
                    Exit;
                end;
                out_text := out_text + local_text;
                Inc(out_score, 500 + local_single_score);
                Inc(local_pos);
            end;

            Result := (phrase_count_local > 0) and
                (get_candidate_text_unit_count(out_text) = local_prefix_count);
        end;

        function try_build_lightweight_prefix_text_local(
            const local_prefix_key: string; const local_prefix_count: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
            local_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (local_prefix_key = '') or
                (not build_lightweight_sentence_candidates(local_prefix_key,
                local_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                local_text := Trim(local_results[local_idx].text);
                if (local_text = '') or
                    (get_candidate_text_unit_count(local_text) <>
                    local_prefix_count) then
                begin
                    Continue;
                end;
                if candidate_breaks_preferred_anchor_local(local_text, 0,
                    local_prefix_count) or
                    candidate_breaks_stable_boundary_local(local_text, 0,
                    local_prefix_count) then
                begin
                    Continue;
                end;

                local_score := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > local_score) then
                begin
                    local_score := local_results[local_idx].dict_weight;
                end;

                if (not Result) or (local_score > out_score) then
                begin
                    Result := True;
                    out_text := local_text;
                    out_score := local_score;
                end;
            end;
        end;

        procedure normalize_candidate_to_prefix_partial_local(
            var io_candidate: TncCandidate; const local_prefix_count: Integer;
            const local_tail_comment: string);
        var
            local_units: TArray<string>;
            local_idx: Integer;
            local_text: string;
        begin
            local_units := split_text_units(Trim(io_candidate.text));
            if (local_prefix_count <= 0) or
                (Length(local_units) < local_prefix_count) then
            begin
                Exit;
            end;

            local_text := '';
            for local_idx := 0 to local_prefix_count - 1 do
            begin
                local_text := local_text + local_units[local_idx];
            end;
            io_candidate.text := local_text;
            io_candidate.comment := local_tail_comment;
        end;

        function try_build_from_last_ranked_path_local(
            out local_candidate: TncCandidate): Boolean;
        var
            local_path_part_count: Integer;
            local_path_part_idx: Integer;
        begin
            Result := False;
            ranked_path_local := Trim(m_last_ranked_top_path);
            if get_encoded_path_segment_count_local(ranked_path_local) <= 1 then
            begin
                Exit;
            end;

            path_parts_local := ranked_path_local.Split(
                [c_segment_path_separator]);
            for local_path_part_count := Length(path_parts_local) downto 1 do
            begin
                path_text_local := '';
                for local_path_part_idx := 0 to local_path_part_count - 1 do
                begin
                    path_text_local := path_text_local +
                        Trim(path_parts_local[local_path_part_idx]);
                end;

                path_units_local := get_candidate_text_unit_count(
                    path_text_local);
                if (path_text_local = '') or (path_units_local <= 0) or
                    (path_units_local >= input_syllable_count) then
                begin
                    Continue;
                end;
                if (input_syllable_count >= 10) and
                    (path_units_local < input_syllable_count - 4) then
                begin
                    Continue;
                end;

                path_prefix_key_local := build_syllable_key_local(0,
                    path_units_local);
                if (path_prefix_key_local = '') or
                    (Copy(normalize_pinyin_text(lookup_text), 1,
                    Length(path_prefix_key_local)) <> path_prefix_key_local) or
                    (not cached_path_prefix_matches_syllables_local(path_parts_local,
                    local_path_part_count - 1, syllables_local, path_units_local)) then
                begin
                    Continue;
                end;

                path_tail_comment_local := build_syllable_key_local(
                    path_units_local,
                    input_syllable_count - path_units_local);
                if path_tail_comment_local = '' then
                begin
                    Continue;
                end;

                FillChar(local_candidate, SizeOf(local_candidate), 0);
                local_candidate.text := path_text_local;
                local_candidate.comment := path_tail_comment_local;
                local_candidate.score := 68000 + path_units_local * 256;
                local_candidate.source := cs_rule;
                local_candidate.has_dict_weight := True;
                local_candidate.dict_weight := local_candidate.score;
                Exit(True);
            end;
        end;

        procedure consider_prefix_candidate_local(
            const local_candidate: TncCandidate; const local_method_bonus: Integer);
        var
            local_adjusted_score: Integer;
            local_units: Integer;
            local_text: string;
            local_prefix_key: string;
            local_support_score: Integer;
            local_support_segments: Integer;
            local_support_path: string;
        begin
            local_text := Trim(local_candidate.text);
            if (local_text = '') or (Trim(local_candidate.comment) = '') then
            begin
                Exit;
            end;

            local_units := get_candidate_text_unit_count(local_text);
            if (local_units < 2) or (local_units >= input_syllable_count) then
            begin
                Exit;
            end;

            local_adjusted_score := local_candidate.score + local_method_bonus;
            local_prefix_key := build_syllable_key_local(0, local_units);
            if local_prefix_key <> '' then
            begin
                local_support_path := infer_segment_path_for_query_text_with_score(
                    local_prefix_key, local_text, local_support_score,
                    local_support_segments);
                if local_support_path <> '' then
                begin
                    Inc(local_adjusted_score, Min(2400, Max(0,
                        local_support_score div 8)));
                    if local_support_segments > 1 then
                    begin
                        Inc(local_adjusted_score,
                            900 + (local_support_segments * 120));
                    end;
                end;
            end;
            if (best_candidate_score_local <> Low(Integer)) and
                (local_adjusted_score < best_candidate_score_local - 1024) then
            begin
                Exit;
            end;

            if (best_candidate_score_local = Low(Integer)) or
                (local_adjusted_score > best_candidate_score_local) or
                ((local_adjusted_score = best_candidate_score_local) and
                (local_units > best_candidate_units_local)) then
            begin
                best_candidate_local := local_candidate;
                best_candidate_score_local := local_adjusted_score;
                best_candidate_units_local := local_units;
            end;
        end;
    begin
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        Result := False;
        FillChar(best_candidate_local, SizeOf(best_candidate_local), 0);
        best_candidate_score_local := Low(Integer);
        best_candidate_units_local := 0;
        if (m_dictionary = nil) or (not is_full_pinyin_key(lookup_text)) or
            (input_syllable_count < 3) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        if try_build_from_last_ranked_path_local(out_candidate) and
            ((input_syllable_count < 10) or
            (Length(split_text_units(Trim(out_candidate.text))) >=
            input_syllable_count - 4)) then
        begin
            candidate_units_local := get_candidate_text_unit_count(
                Trim(out_candidate.text));
            if (candidate_units_local >= 2) and
                (not candidate_breaks_preferred_anchor_local(
                out_candidate.text, 0, candidate_units_local)) and
                (not candidate_breaks_stable_boundary_local(
                out_candidate.text, 0, candidate_units_local)) then
            begin
                consider_prefix_candidate_local(out_candidate, 2400);
            end;
        end;
        for prefix_count_local := input_syllable_count - 1 downto
            Max(2, input_syllable_count - c_probe_window) do
        begin
            prefix_key_local := '';
            for idx_local := 0 to prefix_count_local - 1 do
            begin
                prefix_key_local := prefix_key_local +
                    normalize_pinyin_text(syllables_local[idx_local].text);
            end;

            tail_comment_local := '';
            for idx_local := prefix_count_local to High(syllables_local) do
            begin
                tail_comment_local := tail_comment_local +
                    normalize_pinyin_text(syllables_local[idx_local].text);
            end;

            if (prefix_key_local = '') or (tail_comment_local = '') or
                (tail_comment_local = '') then
            begin
                Continue;
            end;

            if try_build_preferred_prefix_text_local(prefix_count_local,
                candidate_text_local, candidate_score_local) then
            begin
                out_candidate.text := candidate_text_local;
                out_candidate.comment := tail_comment_local;
                out_candidate.score := candidate_score_local + c_prefix_bonus +
                    (prefix_count_local * 220) -
                    ((input_syllable_count - prefix_count_local) * 30);
                out_candidate.source := cs_rule;
                out_candidate.dict_weight := out_candidate.score;
                out_candidate.has_dict_weight := True;
                normalize_candidate_to_prefix_partial_local(out_candidate,
                    prefix_count_local, tail_comment_local);
                consider_prefix_candidate_local(out_candidate, 2200);
            end;

            if (input_syllable_count <= 8) and
                (prefix_count_local <= 5) and
                (not delayed_long_decode_mode) and
                (prefix_count_local >= 3) and
                try_build_lightweight_prefix_text_local(prefix_key_local,
                prefix_count_local, candidate_text_local,
                candidate_score_local) then
            begin
                out_candidate.text := candidate_text_local;
                out_candidate.comment := tail_comment_local;
                out_candidate.score := candidate_score_local + c_prefix_bonus +
                    1200 + (prefix_count_local * 220) -
                    ((input_syllable_count - prefix_count_local) * 30);
                out_candidate.source := cs_rule;
                out_candidate.dict_weight := out_candidate.score;
                out_candidate.has_dict_weight := True;
                normalize_candidate_to_prefix_partial_local(out_candidate,
                    prefix_count_local, tail_comment_local);
                consider_prefix_candidate_local(out_candidate, 1600);
            end;

            // Long prefix phrases are exact-only. Running the generic lookup
            // after an exact miss repeats expensive prediction work.
            if ((prefix_count_local >= 3) and
                (not dictionary_exact_lookup_cached(prefix_key_local,
                prefix_results_local))) or
                ((prefix_count_local <= 2) and
                (not dictionary_lookup_cached(prefix_key_local,
                prefix_results_local))) then
            begin
                Continue;
            end;

            best_prefix_idx_local := -1;
            best_prefix_score_local := Low(Integer);
            for result_idx_local := 0 to High(prefix_results_local) do
            begin
                if result_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(prefix_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(prefix_results_local[result_idx_local].text);
                candidate_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                if (candidate_text_local = '') or
                    (candidate_units_local <> prefix_count_local) then
                begin
                    Continue;
                end;
                if candidate_breaks_preferred_anchor_local(
                    candidate_text_local, 0, prefix_count_local) or
                    candidate_breaks_stable_boundary_local(
                    candidate_text_local, 0, prefix_count_local) then
                begin
                    Continue;
                end;

                candidate_score_local := prefix_results_local[result_idx_local].score;
                if prefix_results_local[result_idx_local].has_dict_weight and
                    (prefix_results_local[result_idx_local].dict_weight >
                    candidate_score_local) then
                begin
                    candidate_score_local :=
                        prefix_results_local[result_idx_local].dict_weight;
                end;

                if candidate_score_local > best_prefix_score_local then
                begin
                    best_prefix_score_local := candidate_score_local;
                    best_prefix_idx_local := result_idx_local;
                end;
            end;

            if best_prefix_idx_local >= 0 then
            begin
                out_candidate := prefix_results_local[best_prefix_idx_local];
                out_candidate.comment := tail_comment_local;
                out_candidate.score := best_prefix_score_local + c_prefix_bonus +
                    (prefix_count_local * 160) -
                    ((input_syllable_count - prefix_count_local) * 30);
                out_candidate.dict_weight := out_candidate.score;
                out_candidate.has_dict_weight := True;
                normalize_candidate_to_prefix_partial_local(out_candidate,
                    prefix_count_local, tail_comment_local);
                consider_prefix_candidate_local(out_candidate, 0);
            end;
        end;

        if best_candidate_score_local = Low(Integer) then
        begin
            Exit(False);
        end;

        out_candidate := best_candidate_local;
        Result := True;
    end;

    function try_build_internal_dangling_prefix_partial_candidate_local(
        out out_candidate: TncCandidate): Boolean;
    var
        parser_local: TncPinyinParser;
        raw_parts_local: TncPinyinParseResult;
        part_idx_local: Integer;
        dangling_idx_local: Integer;
        prefix_key_local: string;
        tail_comment_local: string;
        prefix_candidates_local: TncCandidateList;
        candidate_text_local: string;
        candidate_units_local: Integer;
        best_idx_local: Integer;
        best_score_local: Integer;
        rank_score_local: Integer;
        dp_scores_local: TArray<Integer>;
        dp_texts_local: TArray<string>;
        dp_segments_local: TArray<Integer>;

        function pick_best_prefix_candidate_local: Boolean;
        var
            candidate_idx_local: Integer;
        begin
            best_idx_local := -1;
            best_score_local := Low(Integer);
            for candidate_idx_local := 0 to High(prefix_candidates_local) do
            begin
                if Trim(prefix_candidates_local[candidate_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(prefix_candidates_local[candidate_idx_local].text);
                candidate_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                if (candidate_text_local = '') or
                    (candidate_units_local <> dangling_idx_local) then
                begin
                    Continue;
                end;

                rank_score_local := prefix_candidates_local[candidate_idx_local].score;
                if prefix_candidates_local[candidate_idx_local].has_dict_weight and
                    (prefix_candidates_local[candidate_idx_local].dict_weight >
                    rank_score_local) then
                begin
                    rank_score_local :=
                        prefix_candidates_local[candidate_idx_local].dict_weight;
                end;
                if (best_idx_local < 0) or (rank_score_local > best_score_local) then
                begin
                    best_idx_local := candidate_idx_local;
                    best_score_local := rank_score_local;
                end;
            end;

            Result := best_idx_local >= 0;
        end;

        function build_part_span_key_local(const local_start_idx: Integer;
            const local_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_len <= 0) or
                (local_start_idx + local_len > dangling_idx_local) then
            begin
                Exit;
            end;
            for local_idx := local_start_idx to local_start_idx + local_len - 1 do
            begin
                Result := Result +
                    normalize_pinyin_text(raw_parts_local[local_idx].text);
            end;
        end;

        function try_pick_span_candidate_local(const local_start_idx: Integer;
            const local_len: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        const
            c_lookup_top_span_bonus = 3200;
        var
            local_key: string;
            local_results: TncCandidateList;
            local_lookup_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
            local_lookup_top_text: string;
            local_units: Integer;
            local_score: Integer;
            local_best_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            local_key := build_part_span_key_local(local_start_idx, local_len);
            if local_key = '' then
            begin
                Exit;
            end;

            SetLength(local_results, 0);
            local_lookup_top_text := '';
            if dictionary_exact_lookup_cached(local_key,
                local_lookup_results) then
            begin
                local_results := merge_candidate_lists(local_results,
                    local_lookup_results, 0);
            end;
            // A broad lookup remains useful for short spans, but not for a
            // three-or-more-syllable exact miss in a dictionary-only path.
            if (Length(local_results) = 0) and (local_len >= 3) then
            begin
                Exit;
            end;
            if dictionary_lookup_cached(local_key, local_lookup_results) then
            begin
                if Length(local_lookup_results) > 0 then
                begin
                    local_lookup_top_text := Trim(local_lookup_results[0].text);
                end;
                local_results := merge_candidate_lists(local_results,
                    local_lookup_results, 0);
            end;
            if Length(local_results) = 0 then
            begin
                Exit;
            end;

            local_best_score := Low(Integer);
            for local_idx := 0 to High(local_results) do
            begin
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                local_text := Trim(local_results[local_idx].text);
                local_units := get_candidate_text_unit_count(local_text);
                if (local_text = '') or (local_units <> local_len) then
                begin
                    Continue;
                end;

                local_score := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > local_score) then
                begin
                    local_score := local_results[local_idx].dict_weight;
                end;
                if local_results[local_idx].source = cs_user then
                begin
                    Inc(local_score, c_user_score_bonus);
                end;
                if (local_lookup_top_text <> '') and
                    SameText(local_text, local_lookup_top_text) then
                begin
                    Inc(local_score, c_lookup_top_span_bonus);
                end;
                if (not Result) or (local_score > local_best_score) then
                begin
                    Result := True;
                    local_best_score := local_score;
                    out_text := local_text;
                    out_score := local_score;
                end;
            end;
        end;

        function try_build_natural_prefix_candidate_local(
            out local_candidate: TncCandidate): Boolean;
        const
            c_max_span_syllables = 4;
        var
            local_idx: Integer;
            local_len: Integer;
            local_text: string;
            local_score: Integer;
            local_total_score: Integer;
            local_next_idx: Integer;
            local_segment_bonus: Integer;
            local_has_multi_span: Boolean;

            procedure consider_span_local(const span_len: Integer;
                const span_text: string; const span_score: Integer);
            begin
                if span_len >= 2 then
                begin
                    local_segment_bonus := 760 + (span_len * 90);
                end
                else
                begin
                    local_segment_bonus := -80;
                end;

                local_next_idx := local_idx + span_len;
                local_total_score := dp_scores_local[local_idx] +
                    span_score + local_segment_bonus;
                if (local_total_score > dp_scores_local[local_next_idx]) or
                    ((local_total_score = dp_scores_local[local_next_idx]) and
                    (dp_segments_local[local_idx] + 1 <
                    dp_segments_local[local_next_idx])) then
                begin
                    dp_scores_local[local_next_idx] := local_total_score;
                    dp_texts_local[local_next_idx] :=
                        dp_texts_local[local_idx] + span_text;
                    dp_segments_local[local_next_idx] :=
                        dp_segments_local[local_idx] + 1;
                end;
            end;
        begin
            FillChar(local_candidate, SizeOf(local_candidate), 0);
            Result := False;
            if dangling_idx_local < 2 then
            begin
                Exit;
            end;

            SetLength(dp_scores_local, dangling_idx_local + 1);
            SetLength(dp_texts_local, dangling_idx_local + 1);
            SetLength(dp_segments_local, dangling_idx_local + 1);
            for local_idx := 0 to dangling_idx_local do
            begin
                dp_scores_local[local_idx] := Low(Integer);
                dp_texts_local[local_idx] := '';
                dp_segments_local[local_idx] := MaxInt;
            end;
            dp_scores_local[0] := 0;
            dp_segments_local[0] := 0;

            for local_idx := 0 to dangling_idx_local - 1 do
            begin
                if dp_scores_local[local_idx] = Low(Integer) then
                begin
                    Continue;
                end;
                local_has_multi_span := False;
                for local_len := Min(c_max_span_syllables,
                    dangling_idx_local - local_idx) downto 2 do
                begin
                    if not try_pick_span_candidate_local(local_idx, local_len,
                        local_text, local_score) then
                    begin
                        Continue;
                    end;
                    local_has_multi_span := True;
                    consider_span_local(local_len, local_text, local_score);
                end;

                // If a real multi-syllable word starts here, do not build the
                // same span from single characters.
                if (not local_has_multi_span) and
                    try_pick_span_candidate_local(local_idx, 1, local_text,
                    local_score) then
                begin
                    consider_span_local(1, local_text, local_score);
                end;
            end;

            if (dp_scores_local[dangling_idx_local] = Low(Integer)) or
                (dp_texts_local[dangling_idx_local] = '') then
            begin
                Exit;
            end;

            local_candidate := Default(TncCandidate);
            local_candidate.text := dp_texts_local[dangling_idx_local];
            local_candidate.comment := tail_comment_local;
            local_candidate.source := cs_rule;
            local_candidate.score := dp_scores_local[dangling_idx_local] +
                7200 + (dangling_idx_local * 160) -
                ((Length(raw_parts_local) - dangling_idx_local) * 45);
            local_candidate.dict_weight := dp_scores_local[dangling_idx_local];
            local_candidate.has_dict_weight := True;
            Result := True;
        end;

        function split_compact_syllables_for_dangling_local(
            const local_text: string; out out_parts: TncPinyinParseResult): Boolean;
        const
            c_max_syllable_len = 6;
            c_initials_local: array[0..22] of string = (
                'zh', 'ch', 'sh',
                'b', 'p', 'm', 'f', 'd', 't', 'n', 'l', 'g', 'k', 'h',
                'j', 'q', 'x', 'r', 'z', 'c', 's', 'y', 'w'
            );
            c_finals_local: array[0..35] of string = (
                'iang', 'iong', 'uang',
                'uai', 'uan', 'iao', 'ian', 'ing', 'ang', 'eng', 'ong',
                'ai', 'an', 'ao', 'ei', 'en', 'er', 'ou',
                'ia', 'ie', 'in', 'iu', 'ua', 'ui', 'un', 'uo',
                've', 'van', 'vn', 'ue',
                'a', 'e', 'i', 'o', 'u', 'v'
            );
            c_finals_no_initial_local: array[0..11] of string = (
                'ang', 'eng',
                'ai', 'an', 'ao', 'ei', 'en', 'er', 'ou',
                'a', 'e', 'o'
            );
        var
            normalized_local: string;
            pos_local: Integer;
            probe_len_local: Integer;
            token_local: string;
            best_token_local: string;
            out_idx_local: Integer;

            function is_initial_final_compatible_local(
                const initial_value: string; const final_value: string): Boolean;
            begin
                if not nc_is_pinyin_spelling_helper_compatible(initial_value,
                    final_value) then
                begin
                    Exit(False);
                end;

                if (initial_value = 'zh') or (initial_value = 'ch') or
                    (initial_value = 'sh') or (initial_value = 'r') or
                    (initial_value = 'z') or (initial_value = 'c') or
                    (initial_value = 's') then
                begin
                    if (final_value = 'ia') or (final_value = 'in') or
                        (final_value = 'ing') or (final_value = 'iu') or
                        (final_value = 'ie') or (final_value = 'ian') or
                        (final_value = 'iang') or (final_value = 'iao') or
                        (final_value = 'iong') or (final_value = 'ue') or
                        (final_value = 've') or (final_value = 'van') or
                        (final_value = 'vn') then
                    begin
                        Exit(False);
                    end
                end;
                Result := True;
            end;

            function is_valid_single_syllable_local(
                const value: string): Boolean;
            var
                initial_idx_local: Integer;
                final_idx_local: Integer;
                final_value_local: string;
            begin
                Result := False;
                if value = '' then
                begin
                    Exit;
                end;

                for final_idx_local := Low(c_finals_no_initial_local) to
                    High(c_finals_no_initial_local) do
                begin
                    if value = c_finals_no_initial_local[final_idx_local] then
                    begin
                        Exit(True);
                    end;
                end;

                for initial_idx_local := Low(c_initials_local) to
                    High(c_initials_local) do
                begin
                    if Copy(value, 1, Length(c_initials_local[initial_idx_local])) <>
                        c_initials_local[initial_idx_local] then
                    begin
                        Continue;
                    end;
                    final_value_local := Copy(value,
                        Length(c_initials_local[initial_idx_local]) + 1,
                        MaxInt);
                    if final_value_local = '' then
                    begin
                        Continue;
                    end;
                    for final_idx_local := Low(c_finals_local) to
                        High(c_finals_local) do
                    begin
                        if (final_value_local = c_finals_local[final_idx_local]) and
                            is_initial_final_compatible_local(
                            c_initials_local[initial_idx_local],
                            final_value_local) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            end;

            procedure append_token_local(const append_text: string;
                const append_pos: Integer);
            begin
                SetLength(out_parts, out_idx_local + 1);
                out_parts[out_idx_local].text := append_text;
                out_parts[out_idx_local].start_index := append_pos;
                out_parts[out_idx_local].length := Length(append_text);
                Inc(out_idx_local);
            end;
        begin
            SetLength(out_parts, 0);
            Result := False;
            normalized_local := normalize_pinyin_text(local_text);
            if normalized_local = '' then
            begin
                Exit;
            end;

            pos_local := 1;
            out_idx_local := 0;
            while pos_local <= Length(normalized_local) do
            begin
                best_token_local := '';
                for probe_len_local := Min(c_max_syllable_len,
                    Length(normalized_local) - pos_local + 1) downto 1 do
                begin
                    token_local := Copy(normalized_local, pos_local,
                        probe_len_local);
                    if is_valid_single_syllable_local(token_local) then
                    begin
                        best_token_local := token_local;
                        Break;
                    end;
                end;

                if best_token_local = '' then
                begin
                    token_local := Copy(normalized_local, pos_local, 1);
                    if not is_single_initial_token_local(token_local) then
                    begin
                        SetLength(out_parts, 0);
                        Exit;
                    end;
                    best_token_local := token_local;
                end;

                append_token_local(best_token_local, pos_local);
                Inc(pos_local, Length(best_token_local));
            end;

            Result := Length(out_parts) > 0;
        end;
    begin
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        Result := False;
        if (m_dictionary = nil) or (Trim(m_composition_text) = '') then
        begin
            Exit;
        end;

        if (not split_compact_syllables_for_dangling_local(m_composition_text,
            raw_parts_local)) or (Length(raw_parts_local) < 3) then
        begin
            parser_local := TncPinyinParser.Create;
            try
                raw_parts_local := parser_local.parse(m_composition_text);
            finally
                parser_local.Free;
            end;
        end;
        if Length(raw_parts_local) < 3 then
        begin
            Exit;
        end;

        dangling_idx_local := -1;
        for part_idx_local := 0 to High(raw_parts_local) - 1 do
        begin
            if is_single_initial_token_local(raw_parts_local[part_idx_local].text) then
            begin
                dangling_idx_local := part_idx_local;
                Break;
            end;
        end;
        if dangling_idx_local < 1 then
        begin
            Exit;
        end;

        prefix_key_local := '';
        for part_idx_local := 0 to dangling_idx_local - 1 do
        begin
            prefix_key_local := prefix_key_local +
                normalize_pinyin_text(raw_parts_local[part_idx_local].text);
        end;
        tail_comment_local := '';
        for part_idx_local := dangling_idx_local to High(raw_parts_local) do
        begin
            tail_comment_local := tail_comment_local +
                normalize_pinyin_text(raw_parts_local[part_idx_local].text);
        end;
        if (prefix_key_local = '') or (tail_comment_local = '') then
        begin
            Exit;
        end;

        if try_build_natural_prefix_candidate_local(out_candidate) then
        begin
            Exit(True);
        end;

        if not (dictionary_exact_lookup_cached(prefix_key_local,
            prefix_candidates_local) or
            dictionary_lookup_cached(prefix_key_local,
            prefix_candidates_local)) then
        begin
            Exit;
        end;
        if not pick_best_prefix_candidate_local then
        begin
            Exit;
        end;

        out_candidate := prefix_candidates_local[best_idx_local];
        out_candidate.comment := tail_comment_local;
        out_candidate.score := best_score_local + 7200 +
            (dangling_idx_local * 160) -
            ((Length(raw_parts_local) - dangling_idx_local) * 45);
        out_candidate.dict_weight := best_score_local;
        out_candidate.has_dict_weight := True;
        Result := Trim(out_candidate.text) <> '';
    end;

    function has_incremental_composition_local: Boolean;
    begin
        Result := m_composition_built_incrementally;
    end;

    function get_cached_stable_prefix_candidate_local(
        out out_candidate: TncCandidate): Boolean;
    begin
        if not stable_prefix_candidate_evaluated then
        begin
            stable_prefix_candidate_evaluated := True;
            has_stable_prefix_candidate := False;
            FillChar(stable_prefix_candidate, SizeOf(stable_prefix_candidate), 0);

            if (m_dictionary <> nil) and has_multi_syllable_input and
                is_full_pinyin_key(lookup_text) and
                (input_syllable_count >= 4) and
                (not all_initial_compact_query) and
                ((not has_internal_dangling_initial) or
                normalized_typo_long_query_fast_path) then
            begin
                has_stable_prefix_candidate :=
                    try_build_stable_leading_prefix_partial_candidate_local(
                    stable_prefix_candidate) and
                    (Trim(stable_prefix_candidate.text) <> '') and
                    (Trim(stable_prefix_candidate.comment) <> '');
            end;
        end;

        if has_stable_prefix_candidate then
        begin
            out_candidate := stable_prefix_candidate;
        end
        else
        begin
            FillChar(out_candidate, SizeOf(out_candidate), 0);
        end;
        Result := has_stable_prefix_candidate;
    end;

    function should_skip_expensive_sentence_generation_local: Boolean;
    var
        local_candidate: TncCandidate;
        tail_units_local: Integer;
    begin
        Result := False;
        if (not has_incremental_composition_local) or
            (not delayed_long_decode_mode) or
            (not is_full_pinyin_key(lookup_text)) or
            (input_syllable_count < 7) or
            all_initial_compact_query or has_internal_dangling_initial then
        begin
            Exit;
        end;

        if not (has_short_extendable_tail_prefix_local or
            has_extendable_same_syllable_tail_local(lookup_text,
            input_syllable_count)) then
        begin
            Exit;
        end;

        if has_preferred_tail_phrase_local(2) or
            has_complete_exact_tail_phrase_local(2) or
            has_preferred_tail_phrase_local(3) or
            has_complete_exact_tail_phrase_local(3) then
        begin
            Exit;
        end;

        if not get_cached_stable_prefix_candidate_local(local_candidate) then
        begin
            Exit;
        end;

        tail_units_local := get_effective_compact_pinyin_unit_count(
            normalize_pinyin_text(Trim(local_candidate.comment)));
        if (tail_units_local <= 0) or (tail_units_local > 2) then
        begin
            Exit;
        end;

        Result := candidate_has_preferred_prefix_coverage_for_fast_exit_local(
            local_candidate);
    end;

    function try_build_typo_normalized_prefix_candidate_local(
        out out_candidate: TncCandidate;
        const require_typo_normalized_query: Boolean = True;
        const allow_stable_single_units: Boolean = False): Boolean;
    const
        c_max_span = 4;
        c_probe_limit = 8;
        c_base_score = 64000;
    var
        syllables_local: TncPinyinParseResult;
        pos_local: Integer;
        prefix_limit_local: Integer;
        span_len_local: Integer;
        text_local: string;
        tail_comment_local: string;
        score_local: Integer;
        phrase_count_local: Integer;

        function build_syllable_key_local(const local_start_idx: Integer;
            const local_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := local_start_idx to
                local_start_idx + local_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function build_tail_comment_local(const local_start_idx: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := local_start_idx to High(syllables_local) do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function has_strong_phrase_for_span_local(const local_start_idx: Integer;
            const local_len: Integer): Boolean;
        var
            local_key: string;
            local_text: string;
            local_bonus: Integer;
            local_results: TncCandidateList;
            local_idx: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            if local_len < 2 then
            begin
                Exit;
            end;

            local_key := build_syllable_key_local(local_start_idx, local_len);
            if local_key = '' then
            begin
                Exit;
            end;

            if try_get_preferred_query_phrase_text_local(local_key, local_text,
                local_bonus) and
                (get_candidate_text_unit_count(Trim(local_text)) = local_len) then
            begin
                Exit(True);
            end;

            if dictionary_exact_lookup_cached(local_key, local_results) or
                dictionary_lookup_cached(local_key, local_results) then
            begin
                for local_idx := 0 to High(local_results) do
                begin
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(local_results[local_idx].text);
                    if get_candidate_text_unit_count(candidate_text_local) =
                        local_len then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function candidate_breaks_preferred_anchor_local(
            const local_text: string; const local_start_idx: Integer;
            const local_len: Integer): Boolean;
        var
            candidate_units_local: TArray<string>;
            anchor_len_local: Integer;
            anchor_key_local: string;
            anchor_text_local: string;
            anchor_bonus_local: Integer;
            anchor_units_local: TArray<string>;
            unit_idx_local: Integer;
            mismatch_local: Boolean;
        begin
            Result := False;
            candidate_units_local := split_text_units(Trim(local_text));
            if Length(candidate_units_local) <> local_len then
            begin
                Exit;
            end;

            for anchor_len_local := Min(4, local_len) downto 2 do
            begin
                anchor_key_local := build_syllable_key_local(local_start_idx,
                    anchor_len_local);
                if anchor_key_local = '' then
                begin
                    Continue;
                end;
                if not try_get_preferred_query_phrase_text_local(anchor_key_local,
                    anchor_text_local, anchor_bonus_local) then
                begin
                    Continue;
                end;
                anchor_units_local := split_text_units(Trim(anchor_text_local));
                if Length(anchor_units_local) <> anchor_len_local then
                begin
                    Continue;
                end;

                mismatch_local := False;
                for unit_idx_local := 0 to anchor_len_local - 1 do
                begin
                    if not SameText(candidate_units_local[unit_idx_local],
                        anchor_units_local[unit_idx_local]) then
                    begin
                        mismatch_local := True;
                        Break;
                    end;
                end;
                Exit(mismatch_local);
            end;
        end;

        function candidate_breaks_stable_boundary_local(
            const local_text: string; const local_start_idx: Integer;
            const local_len: Integer;
            const local_candidate_weight: Integer): Boolean; forward;

        function try_get_span_text_local(const local_start_idx: Integer;
            const local_span_len: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        var
            local_key: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                local_text: string;
                local_score: Integer;
                local_candidate_weight: Integer;
                preferred_bonus_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            local_key := build_syllable_key_local(local_start_idx,
                local_span_len);
            if local_key = '' then
            begin
                Exit;
            end;

            if try_get_preferred_query_phrase_text_local(local_key, local_text,
                preferred_bonus_local) and
                (get_candidate_text_unit_count(local_text) = local_span_len) then
            begin
                out_text := local_text;
                out_score := preferred_bonus_local + local_span_len * 360;
                Exit(True);
            end;

            if not dictionary_exact_lookup_cached(local_key, local_results) then
            begin
                Exit;
            end;
            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                local_text := Trim(local_results[local_idx].text);
                if (local_text = '') or
                    (get_candidate_text_unit_count(local_text) <> local_span_len) then
                begin
                    Continue;
                end;
                local_score := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > local_score) then
                begin
                    local_score := local_results[local_idx].dict_weight;
                end;
                local_candidate_weight := local_score;
                if candidate_breaks_preferred_anchor_local(local_text,
                    local_start_idx, local_span_len) or
                    candidate_breaks_stable_boundary_local(local_text,
                    local_start_idx, local_span_len,
                    local_candidate_weight) then
                begin
                    Continue;
                end;
                out_text := local_text;
                out_score := local_score + local_span_len * 240;
                Exit(True);
            end;
        end;

        function try_get_stable_single_text_local(const local_start_idx: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            local_syllable: string;
            fixed_text_local: string;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (local_start_idx < 0) or
                (local_start_idx >= Length(syllables_local)) then
            begin
                Exit;
            end;
            local_syllable := normalize_pinyin_text(
                syllables_local[local_start_idx].text);
            if local_syllable = '' then
            begin
                Exit;
            end;

            fixed_text_local := get_fixed_resolved_boundary_char_local(
                local_syllable);
            if fixed_text_local = '' then
            begin
                Exit;
            end;

            out_text := fixed_text_local;
            out_score := 900;
            Result := True;
        end;

        function candidate_breaks_stable_boundary_local(
            const local_text: string; const local_start_idx: Integer;
            const local_len: Integer;
            const local_candidate_weight: Integer): Boolean;
        var
            candidate_units_local: TArray<string>;
            split_idx_local: Integer;
            stable_single_text_local: string;
            stable_single_score_local: Integer;
            protected_span_len_local: Integer;
            protected_text_local: string;
            protected_weight_local: Integer;
            protected_rank_local: Integer;
            protected_units_local: TArray<string>;
            overlap_len_local: Integer;
            overlap_idx_local: Integer;
            mismatch_local: Boolean;

            function is_confident_following_span_local(
                const local_span_len: Integer;
                const local_rank: Integer;
                const local_weight: Integer): Boolean;
            begin
                Result := False;
                if local_rank <> 0 then
                begin
                    Exit;
                end;
                if ((local_span_len = 2) and (local_weight >= 900)) or
                    ((local_span_len = 3) and (local_weight >= 520)) or
                    ((local_span_len >= 4) and (local_weight >= 420)) then
                begin
                    Result := True;
                end;
            end;

            function try_get_confident_following_span_local(
                const local_start: Integer;
                const local_span_len: Integer;
                out out_text: string;
                out out_weight: Integer;
                out out_rank: Integer): Boolean;
            var
                local_key: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                local_result_text: string;
                local_result_weight: Integer;
            begin
                Result := False;
                out_text := '';
                out_weight := 0;
                out_rank := -1;
                if (local_start < 0) or (local_span_len < 2) or
                    (local_start + local_span_len > Length(syllables_local)) then
                begin
                    Exit;
                end;

                local_key := build_syllable_key_local(local_start,
                    local_span_len);
                if (local_key = '') or
                    (not dictionary_exact_lookup_cached(local_key,
                    local_results)) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= 4 then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(local_results[local_idx]) or
                        is_runtime_common_pattern_candidate(
                        local_results[local_idx]) or
                        is_runtime_redup_candidate(local_results[local_idx]) then
                    begin
                        Continue;
                    end;
                    local_result_text := Trim(local_results[local_idx].text);
                    if (local_result_text = '') or
                        (get_candidate_text_unit_count(local_result_text) <>
                        local_span_len) then
                    begin
                        Continue;
                    end;
                    local_result_weight := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight >
                        local_result_weight) then
                    begin
                        local_result_weight :=
                            local_results[local_idx].dict_weight;
                    end;
                    if not is_confident_following_span_local(local_span_len,
                        local_idx, local_result_weight) then
                    begin
                        Continue;
                    end;
                    out_text := local_result_text;
                    out_weight := local_result_weight;
                    out_rank := local_idx;
                    Exit(True);
                end;
            end;
        begin
            Result := False;
            candidate_units_local := split_text_units(Trim(local_text));
            if Length(candidate_units_local) <> local_len then
            begin
                Exit;
            end;

            for split_idx_local := 1 to local_len - 1 do
            begin
                for protected_span_len_local := Min(4,
                    Length(syllables_local) - local_start_idx -
                    split_idx_local) downto 2 do
                begin
                    if not try_get_confident_following_span_local(
                        local_start_idx + split_idx_local,
                        protected_span_len_local, protected_text_local,
                        protected_weight_local, protected_rank_local) then
                    begin
                        Continue;
                    end;
                    protected_units_local := split_text_units(
                        protected_text_local);
                    if Length(protected_units_local) <>
                        protected_span_len_local then
                    begin
                        Continue;
                    end;

                    overlap_len_local := Min(local_len - split_idx_local,
                        protected_span_len_local);
                    mismatch_local := False;
                    for overlap_idx_local := 0 to overlap_len_local - 1 do
                    begin
                        if not SameText(candidate_units_local[split_idx_local +
                            overlap_idx_local],
                            protected_units_local[overlap_idx_local]) then
                        begin
                            mismatch_local := True;
                            Break;
                        end;
                    end;
                    if mismatch_local and
                        (local_candidate_weight <= protected_weight_local +
                        220) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            if local_len < 3 then
            begin
                Exit;
            end;

            for split_idx_local := 1 to local_len - 1 do
            begin
                if not try_get_stable_single_text_local(
                    local_start_idx + split_idx_local, stable_single_text_local,
                    stable_single_score_local) then
                begin
                    Continue;
                end;
                if not has_strong_phrase_for_span_local(local_start_idx,
                    split_idx_local) then
                begin
                    Continue;
                end;
                if not SameText(candidate_units_local[split_idx_local],
                    stable_single_text_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function should_leave_stable_single_boundary_open_local(
            const local_start_idx: Integer): Boolean;
        var
            stable_single_text_local: string;
            stable_single_score_local: Integer;
            next_span_len_local: Integer;
            next_text_local: string;
            next_score_local: Integer;
            current_syllable_local: string;
            next_syllable_local: string;
            next_next_syllable_local: string;
        begin
            Result := False;
            if (not allow_stable_single_units) or
                (local_start_idx >= prefix_limit_local - 1) then
            begin
                Exit;
            end;
            if not try_get_stable_single_text_local(local_start_idx,
                stable_single_text_local, stable_single_score_local) then
            begin
                Exit;
            end;

            current_syllable_local := normalize_pinyin_text(
                syllables_local[local_start_idx].text);
            if local_start_idx + 2 < Length(syllables_local) then
            begin
                next_syllable_local := normalize_pinyin_text(
                    syllables_local[local_start_idx + 1].text);
                next_next_syllable_local := normalize_pinyin_text(
                    syllables_local[local_start_idx + 2].text);
                if (current_syllable_local = 'qian') and
                    (next_syllable_local = 'liang') and
                    (next_next_syllable_local = 'nian') then
                begin
                    Exit(True);
                end;
            end;

            next_span_len_local := Min(c_max_span,
                prefix_limit_local - local_start_idx - 1);
            while next_span_len_local >= 2 do
            begin
                if try_get_span_text_local(local_start_idx + 1,
                    next_span_len_local, next_text_local,
                    next_score_local) then
                begin
                    Exit(True);
                end;
                Dec(next_span_len_local);
            end;
        end;
    var
        span_text_local: string;
        span_score_local: Integer;
    begin
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;
        if require_typo_normalized_query and
            (m_last_lookup_normalized_from = '') then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;

        prefix_limit_local := Length(syllables_local) - 1;
        pos_local := 0;
        text_local := '';
        score_local := c_base_score;
        phrase_count_local := 0;
        while pos_local < prefix_limit_local do
        begin
            span_len_local := Min(c_max_span, prefix_limit_local - pos_local);
            while span_len_local >= 2 do
            begin
                if try_get_span_text_local(pos_local, span_len_local,
                    span_text_local, span_score_local) then
                begin
                    if should_leave_stable_single_boundary_open_local(
                        pos_local) then
                    begin
                        Dec(span_len_local);
                        Continue;
                    end;
                    text_local := text_local + span_text_local;
                    Inc(score_local, span_score_local);
                    Inc(pos_local, span_len_local);
                    Inc(phrase_count_local);
                    Break;
                end;
                Dec(span_len_local);
            end;

            if span_len_local < 2 then
            begin
                if allow_stable_single_units and
                    try_get_stable_single_text_local(pos_local,
                    span_text_local, span_score_local) then
                begin
                    text_local := text_local + span_text_local;
                    Inc(score_local, span_score_local);
                    Inc(pos_local);
                    Continue;
                end;
                Break;
            end;
        end;

        tail_comment_local := build_tail_comment_local(pos_local);
        if (phrase_count_local <= 0) or (text_local = '') or
            (tail_comment_local = '') or
            (get_candidate_text_unit_count(text_local) < 2) then
        begin
            Exit;
        end;

        out_candidate.text := text_local;
        out_candidate.comment := tail_comment_local;
        out_candidate.score := score_local + get_candidate_text_unit_count(
            text_local) * 220;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := True;
        out_candidate.dict_weight := out_candidate.score;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' typoprefix=[%s/%s pos=%d len=%d]',
                [text_local, tail_comment_local, pos_local,
                Length(syllables_local)]);
        end;
        Result := True;
    end;

    function try_build_relaxed_no_initial_tail_phrase_prefix_candidate_local(
        const query_text_local: string; out out_candidate: TncCandidate): Boolean;
    const
        c_probe_limit = 6;
        c_base_score = 58000;
    var
        normalized_local: string;
        split_idx_local: Integer;
        head_key_local: string;
        tail_key_local: string;
        parser_local: TncPinyinParser;
        head_parts_local: TncPinyinParseResult;
        tail_parts_local: TncPinyinParseResult;
        head_units_local: Integer;
        head_results_local: TncCandidateList;
        result_idx_local: Integer;
        candidate_text_local: string;
        candidate_score_local: Integer;
        best_text_local: string;
        best_score_local: Integer;
        preferred_text_local: string;
        preferred_bonus_local: Integer;

        function build_parts_key_local(
            const parts_local: TncPinyinParseResult): string;
        var
            part_idx_local: Integer;
        begin
            Result := '';
            for part_idx_local := 0 to High(parts_local) do
            begin
                Result := Result + normalize_pinyin_text(
                    parts_local[part_idx_local].text);
            end;
        end;

        function load_head_results_local: Boolean;
        begin
            Result := lookup_exact_full_pinyin_cached_local(head_key_local,
                head_results_local);
            if not Result then
            begin
                Result := dictionary_exact_lookup_cached(head_key_local,
                    head_results_local);
            end;
            if not Result then
            begin
                Result := dictionary_lookup_cached(head_key_local,
                    head_results_local);
            end;
        end;
    begin
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        Result := False;
        if (m_dictionary = nil) or (Trim(query_text_local) = '') then
        begin
            Exit;
        end;

        normalized_local := normalize_pinyin_text(query_text_local);
        if Length(normalized_local) < 4 then
        begin
            Exit;
        end;

        parser_local := TncPinyinParser.Create;
        try
            for split_idx_local := Length(normalized_local) - 1 downto 2 do
            begin
                head_key_local := Copy(normalized_local, 1, split_idx_local);
                tail_key_local := Copy(normalized_local, split_idx_local + 1,
                    MaxInt);
                if not is_relaxed_no_initial_syllable_text(tail_key_local) then
                begin
                    Continue;
                end;

                head_parts_local := parser_local.parse(head_key_local);
                if Length(head_parts_local) < 2 then
                begin
                    Continue;
                end;
                if not SameText(build_parts_key_local(head_parts_local),
                    head_key_local) then
                begin
                    Continue;
                end;

                tail_parts_local := parser_local.parse(tail_key_local);
                if (Length(tail_parts_local) <> 1) or
                    (not SameText(normalize_pinyin_text(
                    tail_parts_local[0].text), tail_key_local)) then
                begin
                    Continue;
                end;

                head_units_local := Length(head_parts_local);
                best_text_local := '';
                best_score_local := Low(Integer);
                if try_get_preferred_query_phrase_text_local(head_key_local,
                    preferred_text_local, preferred_bonus_local) and
                    (get_candidate_text_unit_count(Trim(preferred_text_local)) =
                    head_units_local) then
                begin
                    best_text_local := Trim(preferred_text_local);
                    best_score_local := preferred_bonus_local +
                        head_units_local * 360;
                end;

                if load_head_results_local then
                begin
                    for result_idx_local := 0 to High(head_results_local) do
                    begin
                        if result_idx_local >= c_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(head_results_local[result_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;

                        candidate_text_local :=
                            Trim(head_results_local[result_idx_local].text);
                        if (candidate_text_local = '') or
                            (get_candidate_text_unit_count(candidate_text_local) <>
                            head_units_local) then
                        begin
                            Continue;
                        end;

                        candidate_score_local :=
                            head_results_local[result_idx_local].score;
                        if head_results_local[result_idx_local].has_dict_weight and
                            (head_results_local[result_idx_local].dict_weight >
                            candidate_score_local) then
                        begin
                            candidate_score_local :=
                                head_results_local[result_idx_local].dict_weight;
                        end;
                        candidate_score_local := candidate_score_local +
                            head_units_local * 280;
                        if candidate_score_local > best_score_local then
                        begin
                            best_text_local := candidate_text_local;
                            best_score_local := candidate_score_local;
                        end;
                    end;
                end;

                if best_text_local = '' then
                begin
                    Continue;
                end;

                out_candidate.text := best_text_local;
                out_candidate.comment := tail_key_local;
                out_candidate.score := c_base_score + best_score_local +
                    head_units_local * 260;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := True;
                out_candidate.dict_weight := out_candidate.score;
                Result := True;
                Exit;
            end;
        finally
            parser_local.Free;
        end;
    end;

    function try_build_ranked_path_prefix_continuation_candidate_local(
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    var
        previous_query_local: string;
        normalized_query_local: string;
        path_prefix_query_local: string;
        suffix_key_local: string;
        suffix_text_local: string;
        suffix_path_local: string;
        suffix_score_local: Integer;
        ranked_path_local: string;
        path_parts_local: TArray<string>;
        syllables_local: TncPinyinParseResult;
        part_idx_local: Integer;
        combined_text_local: string;
        last_path_segment_local: string;
        prefix_syllable_count_local: Integer;
        suffix_syllable_count_local: Integer;
        rollback_units_local: Integer;
        rollback_candidate_prefix_count_local: Integer;
        rollback_suffix_count_local: Integer;
        rollback_suffix_key_local: string;
        rollback_prefix_text_local: string;
        rollback_prefix_path_local: string;
        rollback_part_idx_local: Integer;
        rollback_part_text_local: string;
        rollback_part_units_local: Integer;
        active_path_part_high_local: Integer;
        same_syllable_tail_completion_local: Boolean;

        function build_query_key_from_syllables_local(
            const local_start_idx: Integer; const local_count: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_count <= 0) or
                (local_start_idx + local_count > Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function is_stable_sentence_tail_suffix_key_local(
            const local_suffix_key: string): Boolean;
        var
            normalized_suffix_key_local: string;
        begin
            normalized_suffix_key_local := normalize_pinyin_text(local_suffix_key);
            Result := (normalized_suffix_key_local = 'le') or
                (normalized_suffix_key_local = 'ba') or
                (normalized_suffix_key_local = 'ma') or
                (normalized_suffix_key_local = 'a') or
                (normalized_suffix_key_local = 'la') or
                (normalized_suffix_key_local = 'ne') or
                (normalized_suffix_key_local = 'ya') or
                (normalized_suffix_key_local = 'wa');
        end;

        function try_get_best_suffix_text_local(const local_suffix_key: string;
            const local_expected_units: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        const
            c_suffix_probe_limit = 10;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
            local_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (local_suffix_key = '') or (local_expected_units <= 0) or
                (not dictionary_exact_lookup_cached(local_suffix_key,
                local_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= c_suffix_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                local_text := Trim(local_results[local_idx].text);
                if (local_text = '') or
                    (get_candidate_text_unit_count(local_text) <>
                    local_expected_units) then
                begin
                    Continue;
                end;

                local_score := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > local_score) then
                begin
                    local_score := local_results[local_idx].dict_weight;
                end;

                if (not Result) or (local_score > out_score) then
                begin
                    Result := True;
                    out_text := local_text;
                    out_score := local_score;
                end;
            end;
        end;

        function try_get_best_suffix_chain_text_local(
            const local_start_idx: Integer; const local_expected_units: Integer;
            out out_text: string; out out_path: string;
            out out_score: Integer): Boolean;
        const
            c_span_probe_limit = 10;
            c_low_score = Low(Integer) div 4;
        var
            best_scores_local: TArray<Integer>;
            best_texts_local: TArray<string>;
            best_paths_local: TArray<string>;
            pos_local: Integer;
            span_units_local: Integer;
            next_pos_local: Integer;
            span_text_local: string;
            span_score_local: Integer;
            total_score_local: Integer;
            path_value_local: string;

            function try_get_best_exact_span_text_local(
                const span_start_idx: Integer; const span_units: Integer;
                out span_text: string; out span_score: Integer): Boolean;
            var
                span_key_local: string;
                span_results_local: TncCandidateList;
                span_idx_local: Integer;
                candidate_text_local: string;
                candidate_score_local: Integer;
            begin
                Result := False;
                span_text := '';
                span_score := 0;
                if (span_start_idx < 0) or (span_units <= 0) or
                    (span_units > 4) or
                    (span_start_idx + span_units >
                    Length(syllables_local)) then
                begin
                    Exit;
                end;

                span_key_local := build_query_key_from_syllables_local(
                    span_start_idx, span_units);
                if (span_key_local = '') or
                    (not dictionary_exact_lookup_cached(span_key_local,
                    span_results_local)) then
                begin
                    Exit;
                end;

                for span_idx_local := 0 to High(span_results_local) do
                begin
                    if span_idx_local >= c_span_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(span_results_local[span_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(span_results_local[span_idx_local]) or
                        is_runtime_common_pattern_candidate(
                        span_results_local[span_idx_local]) or
                        is_runtime_redup_candidate(span_results_local[span_idx_local]) then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(
                        span_results_local[span_idx_local].text);
                    if (candidate_text_local = '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        span_units) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := span_results_local[span_idx_local].score;
                    if span_results_local[span_idx_local].has_dict_weight and
                        (span_results_local[span_idx_local].dict_weight >
                        candidate_score_local) then
                    begin
                        candidate_score_local :=
                            span_results_local[span_idx_local].dict_weight;
                    end;

                    if span_units > 1 then
                    begin
                        Inc(candidate_score_local, 3200 + span_units * 720);
                    end
                    else
                    begin
                        Dec(candidate_score_local, 240);
                    end;

                    Inc(candidate_score_local,
                        (c_span_probe_limit - span_idx_local) * 24);
                    if (not Result) or
                        (candidate_score_local > span_score) then
                    begin
                        Result := True;
                        span_text := candidate_text_local;
                        span_score := candidate_score_local;
                    end;
                end;
            end;

        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := 0;
            if (local_start_idx < 0) or (local_expected_units <= 0) or
                (local_expected_units > 4) or
                (local_start_idx + local_expected_units >
                Length(syllables_local)) then
            begin
                Exit;
            end;

            SetLength(best_scores_local, local_expected_units + 1);
            SetLength(best_texts_local, local_expected_units + 1);
            SetLength(best_paths_local, local_expected_units + 1);
            for pos_local := 0 to local_expected_units do
            begin
                best_scores_local[pos_local] := c_low_score;
                best_texts_local[pos_local] := '';
                best_paths_local[pos_local] := '';
            end;
            best_scores_local[local_expected_units] := 0;

            for pos_local := local_expected_units - 1 downto 0 do
            begin
                for span_units_local := Min(4, local_expected_units - pos_local)
                    downto 1 do
                begin
                    next_pos_local := pos_local + span_units_local;
                    if best_scores_local[next_pos_local] <= c_low_score div 2 then
                    begin
                        Continue;
                    end;
                    if not try_get_best_exact_span_text_local(
                        local_start_idx + pos_local, span_units_local,
                        span_text_local, span_score_local) then
                    begin
                        Continue;
                    end;

                    total_score_local := span_score_local +
                        best_scores_local[next_pos_local];
                    if span_units_local > 1 then
                    begin
                        Inc(total_score_local, span_units_local * 320);
                    end;

                    if total_score_local > best_scores_local[pos_local] then
                    begin
                        best_scores_local[pos_local] := total_score_local;
                        best_texts_local[pos_local] := span_text_local +
                            best_texts_local[next_pos_local];
                        path_value_local := span_text_local;
                        if best_paths_local[next_pos_local] <> '' then
                        begin
                            path_value_local := path_value_local +
                                c_segment_path_separator +
                                best_paths_local[next_pos_local];
                        end;
                        best_paths_local[pos_local] := path_value_local;
                    end;
                end;
            end;

            if (best_scores_local[0] <= c_low_score div 2) or
                (best_texts_local[0] = '') or
                (get_candidate_text_unit_count(best_texts_local[0]) <>
                local_expected_units) then
            begin
                Exit;
            end;

            out_text := best_texts_local[0];
            out_path := best_paths_local[0];
            out_score := best_scores_local[0];
            Result := True;
        end;

        function suffix_is_precisely_extendable_local(
            const local_suffix_key: string): Boolean;
        var
            suffix_ch_local: Char;
            extended_suffix_key_local: string;
        begin
            Result := False;
            if (local_suffix_key = '') or
                (not is_full_pinyin_key(local_suffix_key)) then
            begin
                Exit;
            end;

            for suffix_ch_local := 'a' to 'z' do
            begin
                extended_suffix_key_local := local_suffix_key +
                    suffix_ch_local;
                if is_full_pinyin_key(extended_suffix_key_local) and
                    (get_effective_compact_pinyin_unit_count(
                    extended_suffix_key_local) = 1) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_complete_full_query_candidate_local: Boolean;
        const
            c_full_probe_limit = 16;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
        begin
            Result := False;
            if (not is_full_pinyin_key(normalized_query_local)) or
                (not dictionary_exact_lookup_cached(normalized_query_local,
                local_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= c_full_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                local_text := Trim(local_results[local_idx].text);
                if (local_text <> '') and
                    (get_candidate_text_unit_count(local_text) =
                    input_syllable_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        Result := False;

        previous_query_local := normalize_pinyin_text(m_last_ranked_query_key);
        normalized_query_local := normalize_pinyin_text(lookup_text);
        ranked_path_local := Trim(m_last_ranked_top_path);
        same_syllable_tail_completion_local := False;
        if (previous_query_local = '') or (normalized_query_local = '') or
            (ranked_path_local = '') or
            (Length(normalized_query_local) <= Length(previous_query_local)) or
            (Copy(normalized_query_local, 1, Length(previous_query_local)) <>
            previous_query_local) then
        begin
            Exit;
        end;

        if has_complete_full_query_candidate_local then
        begin
            Exit;
        end;

        if get_encoded_path_segment_count_local(ranked_path_local) <= 1 then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        path_parts_local := ranked_path_local.Split([c_segment_path_separator]);
        active_path_part_high_local := High(path_parts_local);
        combined_text_local := '';
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            combined_text_local := combined_text_local + Trim(path_parts_local[part_idx_local]);
        end;
        prefix_syllable_count_local := get_candidate_text_unit_count(
            combined_text_local);
        if (combined_text_local = '') or (prefix_syllable_count_local <= 0) or
            (get_candidate_text_unit_count(combined_text_local) <>
            prefix_syllable_count_local) then
        begin
            Exit;
        end;

        if prefix_syllable_count_local >= Length(syllables_local) then
        begin
            if (prefix_syllable_count_local <> Length(syllables_local)) or
                (prefix_syllable_count_local <= 1) or
                (Length(path_parts_local) <= 1) then
            begin
                Exit;
            end;

            last_path_segment_local := Trim(path_parts_local[High(path_parts_local)]);
            if (get_candidate_text_unit_count(last_path_segment_local) < 1) or
                (get_candidate_text_unit_count(last_path_segment_local) > 2) then
            begin
                Exit;
            end;
            same_syllable_tail_completion_local := True;

            Dec(prefix_syllable_count_local,
                get_candidate_text_unit_count(last_path_segment_local));
            combined_text_local := '';
            ranked_path_local := '';
            active_path_part_high_local := High(path_parts_local) - 1;
            for part_idx_local := 0 to active_path_part_high_local do
            begin
                combined_text_local := combined_text_local +
                    Trim(path_parts_local[part_idx_local]);
                if ranked_path_local <> '' then
                begin
                    ranked_path_local := ranked_path_local +
                        c_segment_path_separator;
                end;
                ranked_path_local := ranked_path_local +
                    Trim(path_parts_local[part_idx_local]);
            end;

            if (combined_text_local = '') or
                (get_encoded_path_segment_count_local(ranked_path_local) <= 1) then
            begin
                Exit;
            end;
        end;

        path_prefix_query_local := build_query_key_from_syllables_local(0,
            prefix_syllable_count_local);
        if (path_prefix_query_local = '') or
            (Copy(normalized_query_local, 1, Length(path_prefix_query_local)) <>
            path_prefix_query_local) or
            (not cached_path_prefix_matches_syllables_local(path_parts_local,
            active_path_part_high_local, syllables_local,
            prefix_syllable_count_local)) then
        begin
            Exit;
        end;
        if (input_syllable_count <= 4) and (m_dictionary <> nil) and
            (not m_dictionary.is_base_entry(path_prefix_query_local,
            combined_text_local)) then
        begin
            Exit;
        end;

        suffix_syllable_count_local := Length(syllables_local) -
            prefix_syllable_count_local;
        if (suffix_syllable_count_local < 1) or
            (suffix_syllable_count_local > 4) then
        begin
            Exit;
        end;

        if is_full_pinyin_key(normalized_query_local) and
            (active_path_part_high_local > 0) then
        begin
            for rollback_units_local := Min(2, active_path_part_high_local + 1) downto 1 do
            begin
                rollback_candidate_prefix_count_local :=
                    prefix_syllable_count_local;
                for rollback_part_idx_local := active_path_part_high_local -
                    rollback_units_local + 1 to active_path_part_high_local do
                begin
                    rollback_part_text_local := Trim(
                        path_parts_local[rollback_part_idx_local]);
                    rollback_part_units_local := get_candidate_text_unit_count(
                        rollback_part_text_local);
                    if rollback_part_units_local <> 1 then
                    begin
                        rollback_candidate_prefix_count_local := -1;
                        Break;
                    end;
                    Dec(rollback_candidate_prefix_count_local,
                        rollback_part_units_local);
                end;

                if rollback_candidate_prefix_count_local <= 0 then
                begin
                    Continue;
                end;

                rollback_suffix_count_local := Length(syllables_local) -
                    rollback_candidate_prefix_count_local;
                if ((rollback_suffix_count_local < 2) and
                    (not same_syllable_tail_completion_local)) or
                    (rollback_suffix_count_local < 1) or
                    (rollback_suffix_count_local > 4) then
                begin
                    Continue;
                end;

                rollback_suffix_key_local := build_query_key_from_syllables_local(
                    rollback_candidate_prefix_count_local,
                    rollback_suffix_count_local);
                if (rollback_suffix_key_local = '') or
                    (Length(rollback_suffix_key_local) > 24) then
                begin
                    Continue;
                end;

                suffix_path_local := '';
                if not try_get_best_suffix_chain_text_local(
                    rollback_candidate_prefix_count_local,
                    rollback_suffix_count_local, suffix_text_local,
                    suffix_path_local, suffix_score_local) then
                begin
                    if not try_get_best_suffix_text_local(rollback_suffix_key_local,
                        rollback_suffix_count_local, suffix_text_local,
                        suffix_score_local) then
                    begin
                        Continue;
                    end;
                    suffix_path_local := suffix_text_local;
                end;

                rollback_prefix_text_local := '';
                rollback_prefix_path_local := '';
                for rollback_part_idx_local := 0 to
                    active_path_part_high_local - rollback_units_local do
                begin
                    rollback_part_text_local := Trim(
                        path_parts_local[rollback_part_idx_local]);
                    rollback_prefix_text_local := rollback_prefix_text_local +
                        rollback_part_text_local;
                    if rollback_prefix_path_local <> '' then
                    begin
                        rollback_prefix_path_local := rollback_prefix_path_local +
                            c_segment_path_separator;
                    end;
                    rollback_prefix_path_local := rollback_prefix_path_local +
                        rollback_part_text_local;
                end;

                if (rollback_prefix_text_local = '') or
                    (get_candidate_text_unit_count(rollback_prefix_text_local) <>
                    rollback_candidate_prefix_count_local) then
                begin
                    Continue;
                end;

                out_candidate.text := rollback_prefix_text_local +
                    suffix_text_local;
                out_candidate.comment := '';
                out_candidate.score := 66000 +
                    rollback_candidate_prefix_count_local * 256 +
                    Max(0, suffix_score_local) + rollback_suffix_count_local * 512;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := True;
                out_candidate.dict_weight := out_candidate.score;
                out_encoded_path := rollback_prefix_path_local +
                    c_segment_path_separator + suffix_path_local;
                Exit(True);
            end;
        end;

        suffix_key_local := build_query_key_from_syllables_local(
            prefix_syllable_count_local, suffix_syllable_count_local);
        if (suffix_key_local = '') or (Length(suffix_key_local) > 24) then
        begin
            Exit;
        end;

        out_candidate.text := combined_text_local;
        out_candidate.comment := suffix_key_local;
        out_candidate.score := 64000 + prefix_syllable_count_local * 256;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := True;
        out_candidate.dict_weight := out_candidate.score;
        out_encoded_path := ranked_path_local;

        if is_full_pinyin_key(suffix_key_local) and
            ((not suffix_is_precisely_extendable_local(suffix_key_local)) or
            is_stable_sentence_tail_suffix_key_local(suffix_key_local)) then
        begin
            if not try_get_best_suffix_chain_text_local(
                prefix_syllable_count_local, suffix_syllable_count_local,
                suffix_text_local, suffix_path_local, suffix_score_local) then
            begin
                if not try_get_best_suffix_text_local(suffix_key_local,
                    suffix_syllable_count_local, suffix_text_local,
                    suffix_score_local) then
                begin
                    Exit;
                end;
                suffix_path_local := suffix_text_local;
            end;

            out_candidate.text := combined_text_local + suffix_text_local;
            out_candidate.comment := '';
            Inc(out_candidate.score, Max(0, suffix_score_local) + 512);
            out_candidate.dict_weight := out_candidate.score;
            out_encoded_path := ranked_path_local +
                c_segment_path_separator + suffix_path_local;
        end;

        Result := True;
    end;

    function try_build_incremental_fixed_single_tail_completion_local(
        out out_candidate: TncCandidate;
        out out_encoded_path: string): Boolean;
    const
        c_previous_probe_limit = 8;
    var
        syllables_local: TncPinyinParseResult;
        tail_syllable_local: string;
        fixed_tail_text_local: string;
        previous_idx_local: Integer;
        previous_text_local: string;
        previous_comment_local: string;
        previous_units_local: TArray<string>;
        previous_score_local: Integer;
        full_score_local: Integer;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (Length(previous_candidates) <= 0) or
            (previous_lookup_key = '') or
            (Length(lookup_text) <> Length(previous_lookup_key) + 1) or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 2 then
        begin
            Exit;
        end;
        tail_syllable_local := normalize_pinyin_text(
            syllables_local[High(syllables_local)].text);
        if tail_syllable_local <> 'yi' then
        begin
            Exit;
        end;
        fixed_tail_text_local := get_fixed_resolved_boundary_char_local(
            tail_syllable_local);
        if (tail_syllable_local = '') or (fixed_tail_text_local = '') then
        begin
            Exit;
        end;

        for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
            High(previous_candidates)) do
        begin
            previous_text_local := Trim(
                previous_candidates[previous_idx_local].text);
            previous_comment_local := normalize_pinyin_text(Trim(
                previous_candidates[previous_idx_local].comment));
            previous_units_local := split_text_units(previous_text_local);
            if (previous_text_local = '') or (previous_comment_local = '') or
                (Length(previous_units_local) <> Length(syllables_local) - 1) or
                (Copy(tail_syllable_local, 1,
                Length(previous_comment_local)) <> previous_comment_local) then
            begin
                Continue;
            end;
            previous_score_local := previous_candidates[previous_idx_local].score;
            if previous_candidates[previous_idx_local].has_dict_weight and
                (previous_candidates[previous_idx_local].dict_weight >
                previous_score_local) then
            begin
                previous_score_local :=
                    previous_candidates[previous_idx_local].dict_weight;
            end;
            full_score_local := Max(0, previous_score_local) + 1400;
            if (not Result) or (full_score_local > out_candidate.score) then
            begin
                out_candidate.text := previous_text_local + fixed_tail_text_local;
                out_candidate.comment := '';
                out_candidate.score := full_score_local;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := False;
                out_candidate.dict_weight := 0;
                out_encoded_path := previous_text_local +
                    c_segment_path_separator + fixed_tail_text_local;
                Result := True;
            end;
        end;
    end;

    function try_build_incremental_exact_tail_completion_local(
        const tail_syllable_count: Integer; out out_candidate: TncCandidate;
        out out_encoded_path: string): Boolean;
    const
        c_tail_probe_limit = 8;
        c_min_tail_weight = 560;
    var
        syllables_local: TncPinyinParseResult;
        tail_query_local: string;
        last_syllable_local: string;
        tail_results_local: TncCandidateList;
        previous_idx_local: Integer;
        previous_text_local: string;
        previous_comment_local: string;
        previous_units_local: TArray<string>;
        previous_score_local: Integer;
        tail_idx_local: Integer;
        tail_text_local: string;
        tail_units_local: TArray<string>;
        tail_weight_local: Integer;
        overlap_idx_local: Integer;
        prefix_unit_count_local: Integer;
        prefix_text_local: string;
        full_score_local: Integer;
        syllable_idx_local: Integer;
        unit_idx_local: Integer;
        overlap_matches_local: Boolean;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (tail_syllable_count < 2) or
            (Length(previous_candidates) <= 0) or
            (previous_lookup_key = '') or
            (Length(lookup_text) <> Length(previous_lookup_key) + 1) or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <= tail_syllable_count then
        begin
            Exit;
        end;
        tail_query_local := '';
        for syllable_idx_local := Length(syllables_local) -
            tail_syllable_count to High(syllables_local) do
        begin
            tail_query_local := tail_query_local + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
        end;
        last_syllable_local := normalize_pinyin_text(
            syllables_local[High(syllables_local)].text);
        if (tail_query_local = '') or (last_syllable_local = '') or
            (not lookup_exact_full_pinyin_cached_local(tail_query_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        for previous_idx_local := 0 to High(previous_candidates) do
        begin
            previous_text_local := Trim(
                previous_candidates[previous_idx_local].text);
            previous_comment_local := normalize_pinyin_text(Trim(
                previous_candidates[previous_idx_local].comment));
            previous_units_local := split_text_units(previous_text_local);
            if (previous_text_local = '') or (previous_comment_local = '') or
                (Length(previous_units_local) <> Length(syllables_local) - 1) or
                (Copy(last_syllable_local, 1,
                Length(previous_comment_local)) <> previous_comment_local) then
            begin
                Continue;
            end;
            previous_score_local := previous_candidates[previous_idx_local].score;
            if previous_candidates[previous_idx_local].has_dict_weight and
                (previous_candidates[previous_idx_local].dict_weight >
                previous_score_local) then
            begin
                previous_score_local :=
                    previous_candidates[previous_idx_local].dict_weight;
            end;

            for tail_idx_local := 0 to Min(c_tail_probe_limit - 1,
                High(tail_results_local)) do
            begin
                if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                tail_units_local := split_text_units(tail_text_local);
                if Length(tail_units_local) <> tail_syllable_count then
                begin
                    Continue;
                end;
                tail_weight_local := tail_results_local[tail_idx_local].score;
                if tail_results_local[tail_idx_local].has_dict_weight and
                    (tail_results_local[tail_idx_local].dict_weight >
                    tail_weight_local) then
                begin
                    tail_weight_local :=
                        tail_results_local[tail_idx_local].dict_weight;
                end;
                if tail_weight_local < c_min_tail_weight then
                begin
                    Continue;
                end;

                prefix_unit_count_local := Length(previous_units_local) -
                    (tail_syllable_count - 1);
                if prefix_unit_count_local <= 0 then
                begin
                    Continue;
                end;
                overlap_matches_local := True;
                for overlap_idx_local := 0 to tail_syllable_count - 2 do
                begin
                    if not SameText(previous_units_local[
                        prefix_unit_count_local + overlap_idx_local],
                        tail_units_local[overlap_idx_local]) then
                    begin
                        overlap_matches_local := False;
                        Break;
                    end;
                end;
                if not overlap_matches_local then
                begin
                    Continue;
                end;

                prefix_text_local := '';
                for unit_idx_local := 0 to prefix_unit_count_local - 1 do
                begin
                    prefix_text_local := prefix_text_local +
                        previous_units_local[unit_idx_local];
                end;
                full_score_local := Max(0, previous_score_local) +
                    tail_weight_local + tail_syllable_count * 512;
                if (not Result) or (full_score_local > out_candidate.score) then
                begin
                    out_candidate.text := prefix_text_local + tail_text_local;
                    out_candidate.comment := '';
                    out_candidate.score := full_score_local;
                    out_candidate.source := cs_rule;
                    out_candidate.has_dict_weight := True;
                    out_candidate.dict_weight := full_score_local;
                    out_encoded_path := prefix_text_local +
                        c_segment_path_separator + tail_text_local;
                    Result := True;
                end;
            end;
        end;
    end;

    function candidate_list_has_complete_current_query_local(
        const candidates_local: TncCandidateList): Boolean;
    var
        candidate_idx_local: Integer;
    begin
        Result := False;
        for candidate_idx_local := 0 to High(candidates_local) do
        begin
            if (Trim(candidates_local[candidate_idx_local].comment) = '') and
                (get_candidate_text_unit_count(Trim(
                candidates_local[candidate_idx_local].text)) =
                input_syllable_count) then
            begin
                Exit(True);
            end;
        end;
    end;

    procedure append_current_leading_single_fallbacks_local(
        var candidates_local: TncCandidateList);
    var
        syllables_local: TncPinyinParseResult;
        single_results_local: TncCandidateList;
        first_key_local: string;
        remainder_key_local: string;
        single_idx_local: Integer;
        syllable_idx_local: Integer;
        duplicate_idx_local: Integer;
        single_candidate_local: TncCandidate;
        duplicate_found_local: Boolean;
    begin
        if (m_dictionary = nil) or (input_syllable_count < 2) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;
        first_key_local := normalize_pinyin_text(syllables_local[0].text);
        remainder_key_local := '';
        for syllable_idx_local := 1 to High(syllables_local) do
        begin
            remainder_key_local := remainder_key_local + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
        end;
        if (first_key_local = '') or (remainder_key_local = '') or
            (not lookup_exact_full_pinyin_cached_local(first_key_local,
            single_results_local)) then
        begin
            Exit;
        end;

        for single_idx_local := 0 to High(single_results_local) do
        begin
            if (Trim(single_results_local[single_idx_local].comment) <> '') or
                (get_candidate_text_unit_count(Trim(
                single_results_local[single_idx_local].text)) <> 1) then
            begin
                Continue;
            end;
            duplicate_found_local := False;
            for duplicate_idx_local := 0 to High(candidates_local) do
            begin
                if SameText(Trim(candidates_local[duplicate_idx_local].text),
                    Trim(single_results_local[single_idx_local].text)) and
                    SameText(normalize_pinyin_text(Trim(
                    candidates_local[duplicate_idx_local].comment)),
                    remainder_key_local) then
                begin
                    duplicate_found_local := True;
                    Break;
                end;
            end;
            if duplicate_found_local then
            begin
                Continue;
            end;

            single_candidate_local := single_results_local[single_idx_local];
            single_candidate_local.comment := remainder_key_local;
            SetLength(candidates_local, Length(candidates_local) + 1);
            candidates_local[High(candidates_local)] := single_candidate_local;
        end;
    end;

    function try_reuse_incremental_partial_tail_candidates_local(
        out out_candidates: TncCandidateList;
        const allow_complete_exact_tail: Boolean;
        const min_text_unit_count: Integer = 2): Boolean;
    const
        c_previous_probe_limit = 64;
    var
        current_syllables_local: TncPinyinParseResult;
        previous_syllables_local: TncPinyinParseResult;
        previous_idx_local: Integer;
        duplicate_idx_local: Integer;
        text_unit_count_local: Integer;
        previous_comment_unit_count_local: Integer;
        syllable_idx_local: Integer;
        previous_text_local: string;
        previous_comment_local: string;
        current_comment_local: string;
        candidate_local: TncCandidate;
        duplicate_found_local: Boolean;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (m_dictionary = nil) or (Length(previous_candidates) <= 0) or
            (previous_lookup_key = '') or
            (Length(lookup_text) <> Length(previous_lookup_key) + 1) or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or (input_syllable_count < 3) or
            has_explicit_apostrophe_input or all_initial_compact_query or
            has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') or
            ((not allow_complete_exact_tail) and
            (has_complete_exact_tail_phrase_local(2) or
            has_complete_exact_tail_phrase_local(3))) then
        begin
            Exit;
        end;

        current_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        previous_syllables_local := get_effective_compact_pinyin_syllables(
            previous_lookup_key);
        if (Length(current_syllables_local) < 3) or
            (Length(previous_syllables_local) < 2) or
            ((Length(current_syllables_local) <>
            Length(previous_syllables_local) + 1) and
            (Length(current_syllables_local) <>
            Length(previous_syllables_local))) then
        begin
            Exit;
        end;

        for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
            High(previous_candidates)) do
        begin
            previous_text_local := Trim(previous_candidates[previous_idx_local].text);
            previous_comment_local := normalize_pinyin_text(Trim(
                previous_candidates[previous_idx_local].comment));
            text_unit_count_local := get_candidate_text_unit_count(
                previous_text_local);
            if (previous_text_local = '') or
                (text_unit_count_local < min_text_unit_count) or
                (text_unit_count_local >= Length(current_syllables_local)) then
            begin
                Continue;
            end;

            if previous_comment_local <> '' then
            begin
                previous_comment_unit_count_local :=
                    get_effective_compact_pinyin_unit_count(
                    previous_comment_local);
                if (previous_comment_unit_count_local <= 0) or
                    (text_unit_count_local + previous_comment_unit_count_local <>
                    Length(previous_syllables_local)) then
                begin
                    Continue;
                end;
            end
            else if text_unit_count_local <> Length(previous_syllables_local) then
            begin
                Continue;
            end;

            current_comment_local := '';
            for syllable_idx_local := text_unit_count_local to
                High(current_syllables_local) do
            begin
                current_comment_local := current_comment_local +
                    normalize_pinyin_text(
                    current_syllables_local[syllable_idx_local].text);
            end;
            if (current_comment_local = '') or
                ((previous_comment_local <> '') and
                (not SameText(Copy(current_comment_local, 1,
                Length(previous_comment_local)), previous_comment_local))) then
            begin
                Continue;
            end;

            duplicate_found_local := False;
            for duplicate_idx_local := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[duplicate_idx_local].text),
                    previous_text_local) and
                    SameText(Trim(out_candidates[duplicate_idx_local].comment),
                    current_comment_local) then
                begin
                    duplicate_found_local := True;
                    Break;
                end;
            end;
            if duplicate_found_local then
            begin
                Continue;
            end;

            candidate_local := previous_candidates[previous_idx_local];
            candidate_local.text := previous_text_local;
            candidate_local.comment := current_comment_local;
            if not candidate_local.has_dict_weight then
            begin
                candidate_local.has_dict_weight := True;
                candidate_local.dict_weight := Max(300, candidate_local.score);
            end;
            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate_local;
        end;

        Result := Length(out_candidates) > 0;
    end;

    function try_preserve_short_lm_prefix_from_previous_local(
        out out_candidate: TncCandidate): Boolean;
    const
        c_previous_probe_limit = 12;
        c_preserved_generated_score = 16000;
    var
        current_syllables_local: TncPinyinParseResult;
        previous_syllables_local: TncPinyinParseResult;
        current_tail_local: string;
        previous_tail_local: string;
        current_four_tail_local: string;
        previous_four_tail_local: string;
        four_prefix_key_local: string;
        normalized_previous_key_local: string;
        previous_idx_local: Integer;
        syllable_idx_local: Integer;
        appending_local: Boolean;
        deleting_local: Boolean;

        function try_take_four_unit_candidate_local(
            const candidate_local: TncCandidate;
            const expected_tail_local: string;
            const allow_complete_local: Boolean): Boolean;
        var
            normalized_comment_local: string;
        begin
            Result := False;
            normalized_comment_local := normalize_pinyin_text(Trim(
                candidate_local.comment));
            if (candidate_local.display_kind <> cdk_lm_compound) or
                (get_candidate_text_unit_count(Trim(candidate_local.text)) <> 4)
            then
            begin
                Exit;
            end;
            if allow_complete_local then
            begin
                if normalized_comment_local <> '' then
                begin
                    Exit;
                end;
            end
            else if (normalized_comment_local = '') or
                (not SameText(normalized_comment_local, expected_tail_local)) then
            begin
                Exit;
            end;

            out_candidate := candidate_local;
            out_candidate.comment := current_four_tail_local;
            Result := True;
        end;

        function try_take_candidate_local(const candidate_local: TncCandidate;
            const expected_tail_local: string;
            const allow_complete_local: Boolean): Boolean;
        var
            normalized_comment_local: string;
        begin
            Result := False;
            normalized_comment_local := normalize_pinyin_text(Trim(
                candidate_local.comment));
            if (candidate_local.display_kind <> cdk_lm_compound) or
                (get_candidate_text_unit_count(Trim(candidate_local.text)) <> 3)
            then
            begin
                Exit;
            end;
            if allow_complete_local then
            begin
                if normalized_comment_local <> '' then
                begin
                    Exit;
                end;
            end
            else if (normalized_comment_local = '') or
                (not SameText(normalized_comment_local, expected_tail_local)) then
            begin
                Exit;
            end;

            out_candidate := candidate_local;
            out_candidate.comment := current_tail_local;
            Result := True;
        end;

        function previous_forced_candidate_matches_local(
            const expected_tail_local: string): Boolean;
        begin
            Result := m_has_forced_visible_top_candidate and
                SameText(m_forced_visible_top_lookup_key,
                previous_lookup_key) and
                try_take_candidate_local(m_forced_visible_top_candidate,
                expected_tail_local, False);
        end;

        function try_take_previous_supported_pair_local: Boolean;
        var
            accepted_text_local: string;
            candidate_idx_local: Integer;
            pair_idx_local: Integer;
        begin
            Result := False;
            if not SameText(previous_short_three_exact_pair_query,
                previous_lookup_key) then
            begin
                Exit;
            end;

            for pair_idx_local := 0 to
                High(previous_short_three_exact_pair_texts) do
            begin
                accepted_text_local := Trim(
                    previous_short_three_exact_pair_texts[pair_idx_local]);
                if get_candidate_text_unit_count(accepted_text_local) <> 3 then
                begin
                    Continue;
                end;

                for candidate_idx_local := 0 to High(previous_candidates) do
                begin
                    if (Trim(previous_candidates[candidate_idx_local].comment) = '') and
                        SameText(Trim(previous_candidates[candidate_idx_local].text),
                        accepted_text_local) then
                    begin
                        out_candidate := previous_candidates[candidate_idx_local];
                        out_candidate.comment := current_tail_local;
                        out_candidate.source := cs_rule;
                        out_candidate.display_kind := cdk_lm_compound;
                        Exit(True);
                    end;
                end;

                FillChar(out_candidate, SizeOf(out_candidate), 0);
                out_candidate.text := accepted_text_local;
                out_candidate.comment := current_tail_local;
                out_candidate.score := c_preserved_generated_score;
                out_candidate.source := cs_rule;
                out_candidate.display_kind := cdk_lm_compound;
                Exit(True);
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        appending_local := (Length(lookup_text) =
            Length(previous_lookup_key) + 1) and
            SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key);
        deleting_local := (Length(previous_lookup_key) =
            Length(lookup_text) + 1) and
            SameText(Copy(previous_lookup_key, 1, Length(lookup_text)),
            lookup_text);
        if (input_syllable_count < 4) or (input_syllable_count > 8) or
            ((Length(previous_candidates) = 0) and
            (Length(previous_visible_candidates) = 0) and
            (Length(previous_short_three_exact_pair_texts) = 0)) or
            (previous_lookup_key = '') or
            (not (appending_local or deleting_local)) or
            has_explicit_apostrophe_input or
            all_initial_compact_query or has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') then
        begin
            Exit;
        end;

        current_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        previous_syllables_local := get_effective_compact_pinyin_syllables(
            previous_lookup_key);
        if (Length(current_syllables_local) <> input_syllable_count) or
            (Length(previous_syllables_local) < 3) or
            (Length(previous_syllables_local) > 8) or
            ((Length(current_syllables_local) <>
            Length(previous_syllables_local) + 1) and
            (Length(current_syllables_local) <>
            Length(previous_syllables_local)) and
            (Length(previous_syllables_local) <>
            Length(current_syllables_local) + 1)) then
        begin
            Exit;
        end;

        // Preserve a validated 2+2 LM prefix while the user continues typing
        // its tail. The original three-unit preservation path cannot carry a
        // four-unit candidate such as 可以|取代 across d -> de.
        current_four_tail_local := '';
        if Length(current_syllables_local) > 4 then
        begin
            for syllable_idx_local := 4 to High(current_syllables_local) do
            begin
                current_four_tail_local := current_four_tail_local +
                    normalize_pinyin_text(
                    current_syllables_local[syllable_idx_local].text);
            end;
        end;
        if (current_four_tail_local <> '') and
            (Length(previous_syllables_local) >= 4) then
        begin
            four_prefix_key_local := '';
            for syllable_idx_local := 0 to 3 do
            begin
                four_prefix_key_local := four_prefix_key_local +
                    normalize_pinyin_text(
                    current_syllables_local[syllable_idx_local].text);
            end;
            previous_four_tail_local := '';
            if Length(previous_syllables_local) > 4 then
            begin
                for syllable_idx_local := 4 to High(previous_syllables_local) do
                begin
                    previous_four_tail_local := previous_four_tail_local +
                        normalize_pinyin_text(
                        previous_syllables_local[syllable_idx_local].text);
                end;
            end;
            normalized_previous_key_local := normalize_pinyin_text(
                previous_lookup_key);
            if (previous_four_tail_local = '') and
                (four_prefix_key_local <> '') and
                (Length(normalized_previous_key_local) >
                Length(four_prefix_key_local)) and
                SameText(Copy(normalized_previous_key_local, 1,
                Length(four_prefix_key_local)), four_prefix_key_local) then
            begin
                // A trailing initial such as the d in keyiqudaid is not a
                // parsed syllable yet, but it is already the visible comment.
                previous_four_tail_local := Copy(normalized_previous_key_local,
                    Length(four_prefix_key_local) + 1, MaxInt);
            end;

            if (Length(previous_syllables_local) = 4) and
                (previous_four_tail_local = '') and appending_local then
            begin
                for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                    High(previous_visible_candidates)) do
                begin
                    if try_take_four_unit_candidate_local(
                        previous_visible_candidates[previous_idx_local], '',
                        True) then
                    begin
                        Exit(True);
                    end;
                end;
                for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                    High(previous_candidates)) do
                begin
                    if try_take_four_unit_candidate_local(
                        previous_candidates[previous_idx_local], '', True) then
                    begin
                        Exit(True);
                    end;
                end;
            end
            else if (previous_four_tail_local <> '') and
                (not SameText(current_four_tail_local,
                previous_four_tail_local)) and
                ((appending_local and SameText(Copy(current_four_tail_local, 1,
                Length(previous_four_tail_local)),
                previous_four_tail_local)) or
                (deleting_local and SameText(Copy(previous_four_tail_local, 1,
                Length(current_four_tail_local)), current_four_tail_local))) then
            begin
                for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                    High(previous_visible_candidates)) do
                begin
                    if try_take_four_unit_candidate_local(
                        previous_visible_candidates[previous_idx_local],
                        previous_four_tail_local, False) then
                    begin
                        Exit(True);
                    end;
                end;
                for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                    High(previous_candidates)) do
                begin
                    if try_take_four_unit_candidate_local(
                        previous_candidates[previous_idx_local],
                        previous_four_tail_local, False) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        current_tail_local := '';
        for syllable_idx_local := 3 to High(current_syllables_local) do
        begin
            current_tail_local := current_tail_local + normalize_pinyin_text(
                current_syllables_local[syllable_idx_local].text);
        end;
        if current_tail_local = '' then
        begin
            Exit;
        end;

        if Length(previous_syllables_local) = 3 then
        begin
            if not appending_local then
            begin
                Exit;
            end;
            for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                High(previous_visible_candidates)) do
            begin
                if try_take_candidate_local(
                    previous_visible_candidates[previous_idx_local], '', True)
                then
                begin
                    Exit(True);
                end;
            end;
            for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
                High(previous_candidates)) do
            begin
                if try_take_candidate_local(
                    previous_candidates[previous_idx_local], '', True) then
                begin
                    Exit(True);
                end;
            end;
            Exit(try_take_previous_supported_pair_local);
        end;

        previous_tail_local := '';
        for syllable_idx_local := 3 to High(previous_syllables_local) do
        begin
            previous_tail_local := previous_tail_local + normalize_pinyin_text(
                previous_syllables_local[syllable_idx_local].text);
        end;
        if (previous_tail_local = '') or
            SameText(current_tail_local, previous_tail_local) or
            (appending_local and
            (not SameText(Copy(current_tail_local, 1,
            Length(previous_tail_local)), previous_tail_local))) or
            (deleting_local and
            (not SameText(Copy(previous_tail_local, 1,
            Length(current_tail_local)), current_tail_local))) then
        begin
            Exit;
        end;

        for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
            High(previous_visible_candidates)) do
        begin
            if try_take_candidate_local(
                previous_visible_candidates[previous_idx_local],
                previous_tail_local, False) then
            begin
                Exit(True);
            end;
        end;
        for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
            High(previous_candidates)) do
        begin
            if try_take_candidate_local(previous_candidates[previous_idx_local],
                previous_tail_local, False) then
            begin
                Exit(True);
            end;
        end;
        Result := previous_forced_candidate_matches_local(previous_tail_local);
    end;

    function try_reuse_long_incomplete_tail_candidates_local(
        out out_candidates: TncCandidateList): Boolean;
    const
        c_tail_exact_probe_max_syllables = 5;
    var
        current_syllables_local: TncPinyinParseResult;
        previous_syllables_local: TncPinyinParseResult;
        last_syllable_local: string;

        function has_any_complete_exact_tail_edge_local: Boolean;
        var
            span_len_local: Integer;
            start_idx_local: Integer;
            syllable_idx_local: Integer;
            result_idx_local: Integer;
            span_key_local: string;
            exact_results_local: TncCandidateList;
        begin
            Result := False;
            for span_len_local := 1 to Min(
                c_tail_exact_probe_max_syllables,
                Length(current_syllables_local)) do
            begin
                start_idx_local := Length(current_syllables_local) -
                    span_len_local;
                span_key_local := '';
                for syllable_idx_local := start_idx_local to
                    High(current_syllables_local) do
                begin
                    span_key_local := span_key_local + normalize_pinyin_text(
                        current_syllables_local[syllable_idx_local].text);
                end;
                if (span_key_local = '') or
                    (not dictionary_exact_lookup_cached(span_key_local,
                    exact_results_local)) then
                begin
                    Continue;
                end;

                for result_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[result_idx_local].comment) = '') and
                        (get_candidate_text_unit_count(Trim(
                        exact_results_local[result_idx_local].text)) =
                        span_len_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            if Length(current_syllables_local) <=
                c_tail_exact_probe_max_syllables then
            begin
                Exit;
            end;
            if not dictionary_exact_lookup_cached(lookup_text,
                exact_results_local) then
            begin
                Exit;
            end;
            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[result_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(Trim(
                    exact_results_local[result_idx_local].text)) =
                    Length(current_syllables_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (input_syllable_count < c_long_sentence_full_path_min_syllables) or
            (input_syllable_count > 40) or
            (not has_incremental_composition_local) or
            has_explicit_apostrophe_input or all_initial_compact_query or
            has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') then
        begin
            Exit;
        end;

        current_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        previous_syllables_local := get_effective_compact_pinyin_syllables(
            previous_lookup_key);
        if (Length(current_syllables_local) <> input_syllable_count) or
            (Length(current_syllables_local) <>
            Length(previous_syllables_local)) then
        begin
            Exit;
        end;
        last_syllable_local := normalize_pinyin_text(
            current_syllables_local[High(current_syllables_local)].text);
        if Length(last_syllable_local) <= 1 then
        begin
            Exit;
        end;
        // Some parser-accepted forms have no exact lexical edge. Only those
        // are safe to carry forward; any exact tail edge must run full ranking.
        if is_full_pinyin_key(last_syllable_local) and
            ((not (m_dictionary is TncSqliteDictionary)) or
            has_any_complete_exact_tail_edge_local) then
        begin
            Exit;
        end;

        Result := try_reuse_incremental_partial_tail_candidates_local(
            out_candidates, True, 1);
    end;

    function try_reuse_incremental_raw_comment_candidates_local(
        out out_candidates: TncCandidateList;
        const min_text_unit_count: Integer): Boolean;
    const
        c_previous_probe_limit = 64;
    var
        previous_idx_local: Integer;
        duplicate_idx_local: Integer;
        previous_text_local: string;
        previous_comment_local: string;
        current_comment_local: string;
        candidate_local: TncCandidate;
        duplicate_found_local: Boolean;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (Length(previous_candidates) = 0) or
            (previous_lookup_key = '') or
            (Length(lookup_text) <> Length(previous_lookup_key) + 1) or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or has_explicit_apostrophe_input or
            all_initial_compact_query or has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') then
        begin
            Exit;
        end;

        for previous_idx_local := 0 to Min(c_previous_probe_limit - 1,
            High(previous_candidates)) do
        begin
            previous_text_local := Trim(
                previous_candidates[previous_idx_local].text);
            previous_comment_local := normalize_pinyin_text(Trim(
                previous_candidates[previous_idx_local].comment));
            if (previous_text_local = '') or
                (previous_comment_local = '') or
                (get_candidate_text_unit_count(previous_text_local) <
                min_text_unit_count) or
                (Length(previous_comment_local) > Length(previous_lookup_key)) or
                (not SameText(Copy(previous_lookup_key,
                Length(previous_lookup_key) - Length(previous_comment_local) + 1,
                Length(previous_comment_local)), previous_comment_local)) then
            begin
                Continue;
            end;

            current_comment_local := Copy(lookup_text,
                Length(lookup_text) - Length(previous_comment_local),
                Length(previous_comment_local) + 1);
            if current_comment_local = '' then
            begin
                Continue;
            end;

            duplicate_found_local := False;
            for duplicate_idx_local := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[duplicate_idx_local].text),
                    previous_text_local) and
                    SameText(normalize_pinyin_text(Trim(
                    out_candidates[duplicate_idx_local].comment)),
                    normalize_pinyin_text(current_comment_local)) then
                begin
                    duplicate_found_local := True;
                    Break;
                end;
            end;
            if duplicate_found_local then
            begin
                Continue;
            end;

            candidate_local := previous_candidates[previous_idx_local];
            candidate_local.text := previous_text_local;
            candidate_local.comment := current_comment_local;
            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate_local;
        end;

        Result := Length(out_candidates) > 0;
    end;

    function try_reuse_stable_multi_prefix_before_lookup_local(
        out out_candidates: TncCandidateList): Boolean;
    var
        current_syllables_local: TncPinyinParseResult;
        last_syllable_local: string;
        first_syllable_local: string;
        second_syllable_local: string;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (input_syllable_count < 5) or (input_syllable_count > 8) or
            (Length(previous_candidates) <= 0) or
            (get_candidate_text_unit_count(Trim(
            previous_candidates[0].text)) < 3) or
            (not has_extendable_trailing_prefix_query_text(lookup_text)) then
        begin
            Exit;
        end;

        current_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(current_syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;
        first_syllable_local := normalize_pinyin_text(
            current_syllables_local[0].text);
        second_syllable_local := normalize_pinyin_text(
            current_syllables_local[1].text);
        if (not ((first_syllable_local = 'wo') or
            (first_syllable_local = 'ni') or
            (first_syllable_local = 'nin') or
            (first_syllable_local = 'ta') or
            (first_syllable_local = 'zan') or
            (first_syllable_local = 'an'))) or
            (not ((second_syllable_local = 'gen') or
            (second_syllable_local = 'he') or
            (second_syllable_local = 'yu') or
            (second_syllable_local = 'tong'))) then
        begin
            Exit;
        end;
        last_syllable_local := normalize_pinyin_text(
            current_syllables_local[High(current_syllables_local)].text);
        if Length(last_syllable_local) <> 1 then
        begin
            Exit;
        end;

        Result := try_reuse_incremental_partial_tail_candidates_local(
            out_candidates, False) and (Length(out_candidates) > 0) and
            (get_candidate_text_unit_count(Trim(out_candidates[0].text)) >= 3);
    end;

    function try_build_pronoun_connector_tail_incremental_fast_local(
        out out_candidates: TncCandidateList): Boolean;
    const
        c_stable_partial_margin = 2048;
    var
        candidate_idx_local: Integer;
        complete_idx_local: Integer;
        best_partial_idx_local: Integer;
        complete_score_local: Integer;
        best_partial_score_local: Integer;
        picked_local: TncCandidate;
        reused_previous_local: Boolean;
        syllables_local: TncPinyinParseResult;
        first_syllable_local: string;
        second_syllable_local: string;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (input_syllable_count < 4) or (input_syllable_count > 6) or
            (Length(previous_candidates) = 0) or
            (not is_full_pinyin_key(lookup_text)) or
            has_explicit_apostrophe_input or all_initial_compact_query or
            has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;
        first_syllable_local := normalize_pinyin_text(
            syllables_local[0].text);
        second_syllable_local := normalize_pinyin_text(
            syllables_local[1].text);
        if (not ((first_syllable_local = 'wo') or
            (first_syllable_local = 'ni') or
            (first_syllable_local = 'nin') or
            (first_syllable_local = 'ta') or
            (first_syllable_local = 'zan') or
            (first_syllable_local = 'an'))) or
            (not ((second_syllable_local = 'gen') or
            (second_syllable_local = 'he') or
            (second_syllable_local = 'yu') or
            (second_syllable_local = 'tong'))) then
        begin
            Exit;
        end;

        reused_previous_local :=
            try_reuse_incremental_partial_tail_candidates_local(
            out_candidates, True);
        if (not reused_previous_local) and
            (Length(previous_lookup_key) + 1 = Length(lookup_text)) and
            SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key) and
            (Trim(previous_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(
            previous_candidates[0].text)) = input_syllable_count) then
        begin
            SetLength(out_candidates, 1);
            out_candidates[0] := previous_candidates[0];
        end;
        if Length(out_candidates) = 0 then
        begin
            Exit;
        end;

        ensure_best_short_exact_prefix_tail_candidate_visible(out_candidates);
        complete_idx_local := -1;
        best_partial_idx_local := -1;
        complete_score_local := Low(Integer);
        best_partial_score_local := Low(Integer);
        for candidate_idx_local := 0 to High(out_candidates) do
        begin
            if (Trim(out_candidates[candidate_idx_local].comment) = '') and
                (get_candidate_text_unit_count(Trim(
                out_candidates[candidate_idx_local].text)) =
                input_syllable_count) then
            begin
                if (complete_idx_local < 0) or
                    (out_candidates[candidate_idx_local].score >
                    complete_score_local) then
                begin
                    complete_idx_local := candidate_idx_local;
                    complete_score_local :=
                        out_candidates[candidate_idx_local].score;
                end;
            end
            else if (Trim(out_candidates[candidate_idx_local].comment) <> '') and
                ((best_partial_idx_local < 0) or
                (out_candidates[candidate_idx_local].score >
                best_partial_score_local)) then
            begin
                best_partial_idx_local := candidate_idx_local;
                best_partial_score_local :=
                    out_candidates[candidate_idx_local].score;
            end;
        end;
        Result := complete_idx_local >= 0;
        if Result and (best_partial_idx_local > 0) and
            (best_partial_score_local >= complete_score_local +
            c_stable_partial_margin) then
        begin
            picked_local := out_candidates[best_partial_idx_local];
            for candidate_idx_local := best_partial_idx_local downto 1 do
            begin
                out_candidates[candidate_idx_local] :=
                    out_candidates[candidate_idx_local - 1];
            end;
            out_candidates[0] := picked_local;
        end;
        if Result then
        begin
            append_current_leading_single_fallbacks_local(out_candidates);
        end;
    end;

    function try_build_pronoun_connector_predictive_tail_fast_local(
        out out_candidates: TncCandidateList): Boolean;
    const
        c_role_probe_limit = 32;
        c_tail_probe_limit = 24;
        c_min_tail_weight = 300;
        c_predictive_complete_bonus = 24576;
    var
        syllables_local: TncPinyinParseResult;
        pronoun_results_local: TncCandidateList;
        connector_results_local: TncCandidateList;
        tail_results_local: TncCandidateList;
        pronoun_text_local: string;
        connector_text_local: string;
        tail_text_local: string;
        tail_key_local: string;
        candidate_text_local: string;
        candidate_path_local: string;
        pronoun_score_local: Integer;
        connector_score_local: Integer;
        tail_score_local: Integer;
        candidate_score_local: Integer;
        result_idx_local: Integer;
        picked_local: TncCandidate;

        function is_pronoun_local(const value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(value) <> 1 then
            begin
                Exit;
            end;
            case Ord(value[1]) of
                $6211, $4F60, $60A8, $4ED6, $5979, $5B83, $54B1, $4FFA:
                    Result := True;
            end;
        end;

        function is_connector_local(const value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(value) <> 1 then
            begin
                Exit;
            end;
            case Ord(value[1]) of
                $8DDF, $548C, $4E0E, $540C:
                    Result := True;
            end;
        end;

        function pick_role_local(const results_local: TncCandidateList;
            const require_pronoun_local: Boolean; out out_text_local: string;
            out out_score_local: Integer): Boolean;
        var
            role_idx_local: Integer;
            role_text_local: string;
            role_score_local: Integer;
        begin
            Result := False;
            out_text_local := '';
            out_score_local := Low(Integer);
            for role_idx_local := 0 to Min(c_role_probe_limit - 1,
                High(results_local)) do
            begin
                if Trim(results_local[role_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                role_text_local := Trim(results_local[role_idx_local].text);
                if (require_pronoun_local and
                    (not is_pronoun_local(role_text_local))) or
                    ((not require_pronoun_local) and
                    (not is_connector_local(role_text_local))) then
                begin
                    Continue;
                end;
                role_score_local := results_local[role_idx_local].score;
                if results_local[role_idx_local].has_dict_weight and
                    (results_local[role_idx_local].dict_weight >
                    role_score_local) then
                begin
                    role_score_local :=
                        results_local[role_idx_local].dict_weight;
                end;
                if (not Result) or (role_score_local > out_score_local) then
                begin
                    Result := True;
                    out_text_local := role_text_local;
                    out_score_local := role_score_local;
                end;
            end;
        end;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (m_dictionary = nil) or (input_syllable_count < 4) or
            (input_syllable_count > 6) or
            (Length(previous_candidates) = 0) or
            (Length(previous_lookup_key) + 1 <> Length(lookup_text)) or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or is_full_pinyin_key(lookup_text) or
            (not has_extendable_trailing_prefix_query_text(lookup_text)) or
            has_explicit_apostrophe_input or all_initial_compact_query or
            has_internal_dangling_initial or
            (m_last_lookup_normalized_from <> '') then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;
        if (not lookup_exact_full_pinyin_cached_local(normalize_pinyin_text(
            syllables_local[0].text), pronoun_results_local)) or
            (not pick_role_local(pronoun_results_local, True,
            pronoun_text_local, pronoun_score_local)) or
            (not lookup_exact_full_pinyin_cached_local(normalize_pinyin_text(
            syllables_local[1].text), connector_results_local)) or
            (not pick_role_local(connector_results_local, False,
            connector_text_local, connector_score_local)) then
        begin
            Exit;
        end;

        tail_key_local := '';
        for result_idx_local := 2 to High(syllables_local) do
        begin
            tail_key_local := tail_key_local + normalize_pinyin_text(
                syllables_local[result_idx_local].text);
        end;
        if (tail_key_local = '') or
            (not dictionary_lookup_cached(tail_key_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        tail_text_local := '';
        tail_score_local := Low(Integer);
        for result_idx_local := 0 to Min(c_tail_probe_limit - 1,
            High(tail_results_local)) do
        begin
            candidate_text_local := Trim(
                tail_results_local[result_idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count - 2) then
            begin
                Continue;
            end;
            candidate_score_local := tail_results_local[result_idx_local].score;
            if tail_results_local[result_idx_local].has_dict_weight and
                (tail_results_local[result_idx_local].dict_weight >
                candidate_score_local) then
            begin
                candidate_score_local :=
                    tail_results_local[result_idx_local].dict_weight;
            end;
            if candidate_score_local < c_min_tail_weight then
            begin
                Continue;
            end;
            if (tail_text_local = '') or
                (candidate_score_local > tail_score_local) then
            begin
                tail_text_local := candidate_text_local;
                tail_score_local := candidate_score_local;
            end;
        end;
        if tail_text_local = '' then
        begin
            Exit;
        end;

        picked_local.text := pronoun_text_local + connector_text_local +
            tail_text_local;
        picked_local.comment := '';
        picked_local.score := c_predictive_complete_bonus +
            pronoun_score_local + connector_score_local + tail_score_local;
        picked_local.source := cs_rule;
        picked_local.has_dict_weight := False;
        picked_local.dict_weight := 0;
        candidate_path_local := pronoun_text_local +
            c_segment_path_separator + connector_text_local +
            c_segment_path_separator + tail_text_local;
        remember_segment_path_for_candidate(picked_local.text, '',
            candidate_path_local, picked_local.score);

        SetLength(out_candidates, 1);
        out_candidates[0] := picked_local;
        append_current_leading_single_fallbacks_local(out_candidates);
        Result := True;
    end;

    function try_build_stable_prefix_exact_tail_completion_local(
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_tail_probe_limit = 8;
        c_max_tail_units = 4;
        c_max_rollback_units = 3;
        c_min_tail_weight = 560;
        c_place_direction_bonus = 12000;
    var
        prefix_candidate_local: TncCandidate;
        syllables_local: TncPinyinParseResult;
        unresolved_syllables_local: TncPinyinParseResult;
        prefix_units_local: TArray<string>;
        prefix_unit_count_local: Integer;
        unresolved_unit_count_local: Integer;
        rollback_units_local: Integer;
        suffix_unit_count_local: Integer;
        suffix_start_local: Integer;
        suffix_key_local: string;
        suffix_results_local: TncCandidateList;
        suffix_idx_local: Integer;
        suffix_text_local: string;
        suffix_weight_local: Integer;
        remaining_prefix_text_local: string;
        remaining_prefix_path_local: string;
        full_path_local: string;
        full_text_local: string;
        full_score_local: Integer;
        prefix_query_local: string;
        cached_prefix_path_local: string;
        inferred_prefix_path_local: string;
        inferred_prefix_score_local: Integer;
        inferred_prefix_segments_local: Integer;
        previous_unit_local: string;

        function build_query_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(syllables_local)) then
            begin
                Exit;
            end;
            for syllable_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[syllable_idx_local].text);
            end;
        end;

        function join_prefix_units_local(const count_local: Integer): string;
        var
            unit_idx_local: Integer;
        begin
            Result := '';
            for unit_idx_local := 0 to Min(count_local - 1,
                High(prefix_units_local)) do
            begin
                Result := Result + prefix_units_local[unit_idx_local];
            end;
        end;

        function trim_path_tail_units_local(const path_value_local: string;
            const remove_units_local: Integer;
            const fallback_text_local: string): string;
        var
            parts_local: TArray<string>;
            part_units_local: Integer;
            remaining_remove_local: Integer;
            last_idx_local: Integer;
            part_idx_local: Integer;
            part_text_local: string;
        begin
            Result := '';
            if remove_units_local <= 0 then
            begin
                Exit(path_value_local);
            end;
            parts_local := path_value_local.Split([c_segment_path_separator]);
            remaining_remove_local := remove_units_local;
            last_idx_local := High(parts_local);
            while (last_idx_local >= 0) and (remaining_remove_local > 0) do
            begin
                part_text_local := Trim(parts_local[last_idx_local]);
                part_units_local := get_candidate_text_unit_count(part_text_local);
                if (part_units_local <= 0) or
                    (part_units_local > remaining_remove_local) then
                begin
                    Exit(fallback_text_local);
                end;
                Dec(remaining_remove_local, part_units_local);
                Dec(last_idx_local);
            end;
            if remaining_remove_local <> 0 then
            begin
                Exit(fallback_text_local);
            end;
            for part_idx_local := 0 to last_idx_local do
            begin
                part_text_local := Trim(parts_local[part_idx_local]);
                if part_text_local = '' then
                begin
                    Continue;
                end;
                if Result <> '' then
                begin
                    Result := Result + c_segment_path_separator;
                end;
                Result := Result + part_text_local;
            end;
            if Result = '' then
            begin
                Result := fallback_text_local;
            end;
        end;

        function get_path_adjustment_local(const path_value_local: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (Trim(path_value_local) = '') then
            begin
                Exit;
            end;
            Inc(Result, get_cached_query_segment_path_bonus(lookup_text,
                path_value_local));
            Dec(Result, get_cached_query_segment_path_penalty(lookup_text,
                path_value_local));
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        cached_prefix_path_local := '';
        if (not try_build_ranked_path_prefix_continuation_candidate_local(
            prefix_candidate_local, cached_prefix_path_local)) or
            (Trim(prefix_candidate_local.comment) = '') then
        begin
            cached_prefix_path_local := '';
            if not get_cached_stable_prefix_candidate_local(
                prefix_candidate_local) then
            begin
                Exit;
            end;
        end;

        unresolved_syllables_local := get_effective_compact_pinyin_syllables(
            normalize_pinyin_text(Trim(prefix_candidate_local.comment)));
        unresolved_unit_count_local := Length(unresolved_syllables_local);
        if (unresolved_unit_count_local <= 0) or
            (unresolved_unit_count_local > c_max_tail_units) or
            (not is_full_pinyin_key(normalize_pinyin_text(
            Trim(prefix_candidate_local.comment)))) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        prefix_units_local := split_text_units(Trim(prefix_candidate_local.text));
        prefix_unit_count_local := Length(prefix_units_local);
        if (prefix_unit_count_local <= 0) or
            (prefix_unit_count_local + unresolved_unit_count_local <>
            Length(syllables_local)) then
        begin
            Exit;
        end;

        prefix_query_local := build_query_key_local(0,
            prefix_unit_count_local);
        if (Trim(cached_prefix_path_local) = '') or
            (get_encoded_path_segment_count_local(cached_prefix_path_local) <= 1) then
        begin
            if (m_session_ranked_query_paths <> nil) and
                m_session_ranked_query_paths.TryGetValue(prefix_query_local,
                inferred_prefix_path_local) and
                (get_encoded_path_segment_count_local(
                inferred_prefix_path_local) > 1) then
            begin
                cached_prefix_path_local := inferred_prefix_path_local;
            end;
        end;
        if (Trim(cached_prefix_path_local) = '') or
            (get_encoded_path_segment_count_local(cached_prefix_path_local) <= 1) then
        begin
            inferred_prefix_score_local := 0;
            inferred_prefix_segments_local := 0;
            inferred_prefix_path_local :=
                infer_segment_path_for_query_text_with_score(
                prefix_query_local, Trim(prefix_candidate_local.text),
                inferred_prefix_score_local,
                inferred_prefix_segments_local);
            if (Trim(inferred_prefix_path_local) <> '') and
                (inferred_prefix_segments_local > 1) then
            begin
                cached_prefix_path_local := inferred_prefix_path_local;
            end;
        end;
        if Trim(cached_prefix_path_local) = '' then
        begin
            cached_prefix_path_local := get_segment_path_for_candidate(
                prefix_candidate_local);
        end;
        if Trim(cached_prefix_path_local) = '' then
        begin
            cached_prefix_path_local := Trim(prefix_candidate_local.text);
        end;

        for rollback_units_local := 0 to Min(c_max_rollback_units,
            prefix_unit_count_local - 1) do
        begin
            suffix_unit_count_local := unresolved_unit_count_local +
                rollback_units_local;
            if suffix_unit_count_local > c_max_tail_units then
            begin
                Break;
            end;
            suffix_start_local := Length(syllables_local) -
                suffix_unit_count_local;
            suffix_key_local := build_query_key_local(suffix_start_local,
                suffix_unit_count_local);
            if (suffix_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(suffix_key_local,
                suffix_results_local)) then
            begin
                Continue;
            end;

            remaining_prefix_text_local := join_prefix_units_local(
                prefix_unit_count_local - rollback_units_local);
            remaining_prefix_path_local := trim_path_tail_units_local(
                cached_prefix_path_local, rollback_units_local,
                remaining_prefix_text_local);
            previous_unit_local := '';
            if prefix_unit_count_local - rollback_units_local > 0 then
            begin
                previous_unit_local := prefix_units_local[
                    prefix_unit_count_local - rollback_units_local - 1];
            end;

            for suffix_idx_local := 0 to Min(c_tail_probe_limit - 1,
                High(suffix_results_local)) do
            begin
                if Trim(suffix_results_local[suffix_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                suffix_text_local := Trim(
                    suffix_results_local[suffix_idx_local].text);
                if (suffix_text_local = '') or
                    (get_candidate_text_unit_count(suffix_text_local) <>
                    suffix_unit_count_local) then
                begin
                    Continue;
                end;
                suffix_weight_local := suffix_results_local[suffix_idx_local].score;
                if suffix_results_local[suffix_idx_local].has_dict_weight and
                    (suffix_results_local[suffix_idx_local].dict_weight >
                    suffix_weight_local) then
                begin
                    suffix_weight_local :=
                        suffix_results_local[suffix_idx_local].dict_weight;
                end;
                if suffix_weight_local < c_min_tail_weight then
                begin
                    Continue;
                end;

                full_text_local := remaining_prefix_text_local + suffix_text_local;
                if get_candidate_text_unit_count(full_text_local) <>
                    Length(syllables_local) then
                begin
                    Continue;
                end;
                full_path_local := remaining_prefix_path_local;
                if full_path_local <> '' then
                begin
                    full_path_local := full_path_local +
                        c_segment_path_separator;
                end;
                full_path_local := full_path_local + suffix_text_local;
                full_score_local := 64000 +
                    (prefix_unit_count_local - rollback_units_local) * 256 +
                    suffix_weight_local + suffix_unit_count_local * 512 +
                    get_path_adjustment_local(full_path_local);
                if is_place_context_tail_unit_local(previous_unit_local) and
                    (get_directional_locative_span_bonus_local(
                    suffix_text_local) > 0) then
                begin
                    Inc(full_score_local, c_place_direction_bonus);
                end;

                if (not Result) or (full_score_local > out_candidate.score) then
                begin
                    out_candidate.text := full_text_local;
                    out_candidate.comment := '';
                    out_candidate.score := full_score_local;
                    out_candidate.source := cs_rule;
                    out_candidate.has_dict_weight := True;
                    out_candidate.dict_weight := full_score_local;
                    out_encoded_path := full_path_local;
                    Result := True;
                end;
            end;
        end;
    end;

    function try_build_contextual_directional_tail_from_ranked_prefix_local(
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_tail_probe_limit = 8;
        c_context_bonus = 12000;
    var
        syllables_local: TncPinyinParseResult;
        prefix_query_local: string;
        tail_query_local: string;
        prefix_path_local: string;
        path_parts_local: TArray<string>;
        prefix_text_local: string;
        prefix_units_local: TArray<string>;
        tail_results_local: TncCandidateList;
        tail_idx_local: Integer;
        tail_text_local: string;
        tail_weight_local: Integer;
        full_score_local: Integer;
        idx_local: Integer;
        prefix_candidates_local: TncCandidateList;
        raw_prefix_candidates_local: TncCandidateList;
        prefix_idx_local: Integer;
        prefix_score_local: Integer;
        best_prefix_score_local: Integer;

        function build_query_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            for syllable_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
            end;
        end;

    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (m_session_ranked_query_paths = nil) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;

        prefix_query_local := build_query_key_local(0,
            Length(syllables_local) - 2);
        tail_query_local := build_query_key_local(
            Length(syllables_local) - 2, 2);
        if (prefix_query_local = '') or (tail_query_local = '') or
            (not lookup_exact_full_pinyin_cached_local(tail_query_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        prefix_text_local := '';
        prefix_path_local := '';
        if m_session_ranked_query_paths.TryGetValue(prefix_query_local,
            prefix_path_local) and (Trim(prefix_path_local) <> '') then
        begin
            path_parts_local := prefix_path_local.Split(
                [c_segment_path_separator]);
            for idx_local := 0 to High(path_parts_local) do
            begin
                prefix_text_local := prefix_text_local +
                    Trim(path_parts_local[idx_local]);
            end;
        end
        else
        begin
            best_prefix_score_local := Low(Integer);
            SetLength(prefix_candidates_local, 0);
            if build_exact_leading_prefix_partial_candidates(lookup_text,
                raw_prefix_candidates_local) then
            begin
                prefix_candidates_local := raw_prefix_candidates_local;
            end;
            if build_raw_leading_prefix_partial_candidates(lookup_text,
                raw_prefix_candidates_local) then
            begin
                prefix_candidates_local := merge_candidate_lists(
                    prefix_candidates_local, raw_prefix_candidates_local, 0);
            end;
            if Length(prefix_candidates_local) <= 0 then
            begin
                Exit;
            end;
            for prefix_idx_local := 0 to High(prefix_candidates_local) do
            begin
                if not SameText(normalize_pinyin_text(
                    Trim(prefix_candidates_local[prefix_idx_local].comment)),
                    tail_query_local) then
                begin
                    Continue;
                end;
                if get_candidate_text_unit_count(Trim(
                    prefix_candidates_local[prefix_idx_local].text)) <>
                    Length(syllables_local) - 2 then
                begin
                    Continue;
                end;
                prefix_score_local :=
                    prefix_candidates_local[prefix_idx_local].score;
                if prefix_candidates_local[prefix_idx_local].has_dict_weight and
                    (prefix_candidates_local[prefix_idx_local].dict_weight >
                    prefix_score_local) then
                begin
                    prefix_score_local :=
                        prefix_candidates_local[prefix_idx_local].dict_weight;
                end;
                if prefix_score_local > best_prefix_score_local then
                begin
                    best_prefix_score_local := prefix_score_local;
                    prefix_text_local := Trim(
                        prefix_candidates_local[prefix_idx_local].text);
                    prefix_path_local := get_segment_path_for_candidate(
                        prefix_candidates_local[prefix_idx_local]);
                end;
            end;
            if prefix_text_local = '' then
            begin
                Exit;
            end;
            if Trim(prefix_path_local) = '' then
            begin
                prefix_path_local := prefix_text_local;
            end;
        end;
        prefix_units_local := split_text_units(prefix_text_local);
        if (Length(prefix_units_local) <> Length(syllables_local) - 2) or
            (not is_place_context_tail_unit_local(
            prefix_units_local[High(prefix_units_local)])) then
        begin
            Exit;
        end;

        for tail_idx_local := 0 to Min(c_tail_probe_limit - 1,
            High(tail_results_local)) do
        begin
            if Trim(tail_results_local[tail_idx_local].comment) <> '' then
            begin
                Continue;
            end;
            tail_text_local := Trim(tail_results_local[tail_idx_local].text);
            if (get_candidate_text_unit_count(tail_text_local) <> 2) or
                (get_directional_locative_span_bonus_local(tail_text_local) <= 0) then
            begin
                Continue;
            end;
            tail_weight_local := tail_results_local[tail_idx_local].score;
            if tail_results_local[tail_idx_local].has_dict_weight and
                (tail_results_local[tail_idx_local].dict_weight >
                tail_weight_local) then
            begin
                tail_weight_local := tail_results_local[tail_idx_local].dict_weight;
            end;
            full_score_local := 64000 + Length(prefix_units_local) * 256 +
                tail_weight_local + c_context_bonus;
            if (not Result) or (full_score_local > out_candidate.score) then
            begin
                out_candidate.text := prefix_text_local + tail_text_local;
                out_candidate.comment := '';
                out_candidate.score := full_score_local;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := True;
                out_candidate.dict_weight := full_score_local;
                out_encoded_path := prefix_path_local +
                    c_segment_path_separator + tail_text_local;
                Result := True;
            end;
        end;
    end;

    function try_build_contextual_directional_tail_from_previous_local(
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_prefix_probe_limit = 32;
        c_tail_probe_limit = 8;
        c_context_bonus = 12000;
    var
        syllables_local: TncPinyinParseResult;
        tail_query_local: string;
        prefix_idx_local: Integer;
        prefix_text_local: string;
        prefix_units_local: TArray<string>;
        prefix_comment_local: string;
        prefix_score_local: Integer;
        resolved_prefix_text_local: string;
        consumed_directional_head_local: string;
        best_prefix_text_local: string;
        best_directional_head_local: string;
        best_prefix_score_local: Integer;
        tail_results_local: TncCandidateList;
        tail_idx_local: Integer;
        tail_text_local: string;
        tail_units_local: TArray<string>;
        tail_weight_local: Integer;
        full_score_local: Integer;
        syllable_idx_local: Integer;

        function directional_tail_starts_with_unit_local(
            const unit_value_local: string): Boolean;
        var
            result_idx_local: Integer;
            result_text_local: string;
            result_units_local: TArray<string>;
        begin
            Result := False;
            if unit_value_local = '' then
            begin
                Exit;
            end;
            for result_idx_local := 0 to Min(c_tail_probe_limit - 1,
                High(tail_results_local)) do
            begin
                if Trim(tail_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                result_text_local := Trim(
                    tail_results_local[result_idx_local].text);
                result_units_local := split_text_units(result_text_local);
                if (Length(result_units_local) = 2) and
                    SameText(result_units_local[0], unit_value_local) and
                    (get_directional_locative_span_bonus_local(
                    result_text_local) > 0) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function take_prefix_units_local(const units_local: TArray<string>;
            const unit_count_local: Integer): string;
        var
            unit_idx_local: Integer;
        begin
            Result := '';
            for unit_idx_local := 0 to Min(unit_count_local,
                Length(units_local)) - 1 do
            begin
                Result := Result + units_local[unit_idx_local];
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (Length(previous_candidates) <= 0) or
            (previous_lookup_key = '') or
            (not SameText(Copy(lookup_text, 1, Length(previous_lookup_key)),
            previous_lookup_key)) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;
        tail_query_local := '';
        for syllable_idx_local := Length(syllables_local) - 2 to
            High(syllables_local) do
        begin
            tail_query_local := tail_query_local + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
        end;
        if (tail_query_local = '') or
            (not lookup_exact_full_pinyin_cached_local(tail_query_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        best_prefix_text_local := '';
        best_directional_head_local := '';
        best_prefix_score_local := Low(Integer);
        for prefix_idx_local := 0 to Min(c_prefix_probe_limit - 1,
            High(previous_candidates)) do
        begin
            prefix_text_local := Trim(previous_candidates[prefix_idx_local].text);
            prefix_comment_local := normalize_pinyin_text(
                Trim(previous_candidates[prefix_idx_local].comment));
            prefix_units_local := split_text_units(prefix_text_local);
            if (prefix_text_local = '') or (prefix_comment_local = '') then
            begin
                Continue;
            end;
            resolved_prefix_text_local := '';
            consumed_directional_head_local := '';
            if (Length(prefix_units_local) = Length(syllables_local) - 2) and
                is_place_context_tail_unit_local(
                prefix_units_local[High(prefix_units_local)]) and
                (Copy(tail_query_local, 1, Length(prefix_comment_local)) =
                prefix_comment_local) then
            begin
                resolved_prefix_text_local := prefix_text_local;
            end
            else if (Length(prefix_units_local) = Length(syllables_local) - 1) and
                (Length(prefix_units_local) >= 2) and
                is_place_context_tail_unit_local(
                prefix_units_local[High(prefix_units_local) - 1]) and
                directional_tail_starts_with_unit_local(
                prefix_units_local[High(prefix_units_local)]) and
                (Copy(normalize_pinyin_text(
                syllables_local[High(syllables_local)].text), 1,
                Length(prefix_comment_local)) = prefix_comment_local) then
            begin
                consumed_directional_head_local :=
                    prefix_units_local[High(prefix_units_local)];
                resolved_prefix_text_local := take_prefix_units_local(
                    prefix_units_local, Length(prefix_units_local) - 1);
            end;
            if resolved_prefix_text_local = '' then
            begin
                Continue;
            end;
            prefix_score_local := previous_candidates[prefix_idx_local].score;
            if previous_candidates[prefix_idx_local].has_dict_weight and
                (previous_candidates[prefix_idx_local].dict_weight >
                prefix_score_local) then
            begin
                prefix_score_local :=
                    previous_candidates[prefix_idx_local].dict_weight;
            end;
            if prefix_score_local > best_prefix_score_local then
            begin
                best_prefix_score_local := prefix_score_local;
                best_prefix_text_local := resolved_prefix_text_local;
                best_directional_head_local :=
                    consumed_directional_head_local;
            end;
        end;
        if best_prefix_text_local = '' then
        begin
            Exit;
        end;

        for tail_idx_local := 0 to Min(c_tail_probe_limit - 1,
            High(tail_results_local)) do
        begin
            if Trim(tail_results_local[tail_idx_local].comment) <> '' then
            begin
                Continue;
            end;
            tail_text_local := Trim(tail_results_local[tail_idx_local].text);
            tail_units_local := split_text_units(tail_text_local);
            if (Length(tail_units_local) <> 2) or
                (get_directional_locative_span_bonus_local(tail_text_local) <= 0) then
            begin
                Continue;
            end;
            if (best_directional_head_local <> '') and
                (not SameText(tail_units_local[0],
                best_directional_head_local)) then
            begin
                Continue;
            end;
            tail_weight_local := tail_results_local[tail_idx_local].score;
            if tail_results_local[tail_idx_local].has_dict_weight and
                (tail_results_local[tail_idx_local].dict_weight >
                tail_weight_local) then
            begin
                tail_weight_local := tail_results_local[tail_idx_local].dict_weight;
            end;
            full_score_local := Max(0, best_prefix_score_local) +
                tail_weight_local + c_context_bonus;
            if (not Result) or (full_score_local > out_candidate.score) then
            begin
                out_candidate.text := best_prefix_text_local + tail_text_local;
                out_candidate.comment := '';
                out_candidate.score := full_score_local;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := True;
                out_candidate.dict_weight := full_score_local;
                out_encoded_path := best_prefix_text_local +
                    c_segment_path_separator + tail_text_local;
                Result := True;
            end;
        end;
    end;

    function try_complete_contextual_directional_partial_local(
        const partial_candidate: TncCandidate; const partial_encoded_path: string;
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_tail_probe_limit = 8;
        c_context_bonus = 12000;
    var
        syllables_local: TncPinyinParseResult;
        tail_query_local: string;
        partial_text_local: string;
        partial_comment_local: string;
        partial_units_local: TArray<string>;
        tail_results_local: TncCandidateList;
        tail_idx_local: Integer;
        tail_text_local: string;
        tail_weight_local: Integer;
        prefix_score_local: Integer;
        syllable_idx_local: Integer;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        partial_text_local := Trim(partial_candidate.text);
        partial_comment_local := normalize_pinyin_text(
            Trim(partial_candidate.comment));
        if (partial_text_local = '') or (partial_comment_local = '') then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;
        tail_query_local := '';
        for syllable_idx_local := Length(syllables_local) - 2 to
            High(syllables_local) do
        begin
            tail_query_local := tail_query_local + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
        end;
        partial_units_local := split_text_units(partial_text_local);
        if (tail_query_local = '') or
            (not SameText(partial_comment_local, tail_query_local)) or
            (Length(partial_units_local) <> Length(syllables_local) - 2) or
            (not is_place_context_tail_unit_local(
            partial_units_local[High(partial_units_local)])) or
            (not lookup_exact_full_pinyin_cached_local(tail_query_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        prefix_score_local := partial_candidate.score;
        if partial_candidate.has_dict_weight and
            (partial_candidate.dict_weight > prefix_score_local) then
        begin
            prefix_score_local := partial_candidate.dict_weight;
        end;
        for tail_idx_local := 0 to Min(c_tail_probe_limit - 1,
            High(tail_results_local)) do
        begin
            if Trim(tail_results_local[tail_idx_local].comment) <> '' then
            begin
                Continue;
            end;
            tail_text_local := Trim(tail_results_local[tail_idx_local].text);
            if (get_candidate_text_unit_count(tail_text_local) <> 2) or
                (get_directional_locative_span_bonus_local(tail_text_local) <= 0) then
            begin
                Continue;
            end;
            tail_weight_local := tail_results_local[tail_idx_local].score;
            if tail_results_local[tail_idx_local].has_dict_weight and
                (tail_results_local[tail_idx_local].dict_weight >
                tail_weight_local) then
            begin
                tail_weight_local :=
                    tail_results_local[tail_idx_local].dict_weight;
            end;
            if (not Result) or
                (tail_weight_local > out_candidate.dict_weight) then
            begin
                out_candidate.text := partial_text_local + tail_text_local;
                out_candidate.comment := '';
                out_candidate.score := Max(0, prefix_score_local) +
                    tail_weight_local + c_context_bonus;
                out_candidate.source := cs_rule;
                out_candidate.has_dict_weight := True;
                out_candidate.dict_weight := tail_weight_local;
                out_encoded_path := Trim(partial_encoded_path);
                if out_encoded_path = '' then
                begin
                    out_encoded_path := partial_text_local;
                end;
                out_encoded_path := out_encoded_path +
                    c_segment_path_separator + tail_text_local;
                Result := True;
            end;
        end;
    end;

    function ranked_path_requires_exact_competition_validation_local(
        const stable_text: string; const encoded_path: string): Boolean;
    const
        c_exact_probe_limit = 8;
        c_crossing_exact_min_weight = 560;
        c_max_crossing_span_units = 4;
        c_close_exact_min_weight = 700;
        c_close_exact_raw_gap = 96;
    var
        syllables_local: TncPinyinParseResult;
        path_parts_local: TArray<string>;
        path_starts_local: TArray<Integer>;
        path_lengths_local: TArray<Integer>;
        stable_units_local: TArray<string>;
        total_units_local: Integer;
        part_idx_local: Integer;
        part_text_local: string;
        part_units_local: TArray<string>;
        part_key_local: string;
        exact_results_local: TncCandidateList;
        exact_idx_local: Integer;
        exact_text_local: string;
        alternative_path_local: string;
        stable_path_adjustment_local: Integer;
        alternative_path_adjustment_local: Integer;
        previous_unit_local: string;
        span_start_local: Integer;
        span_len_local: Integer;
        span_text_local: string;
        unit_idx_local: Integer;
        refine_part_idx_local: Integer;
        boundary_mask_local: Integer;
        max_boundary_mask_local: Integer;
        stable_part_weight_local: Integer;
        alternative_weight_local: Integer;
        crossing_breaks_strong_pair_local: Boolean;

        function build_query_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(syllables_local)) then
            begin
                Exit;
            end;
            for idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[idx_local].text);
            end;
        end;

        function get_path_adjustment_local(const path_value_local: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (Trim(path_value_local) = '') then
            begin
                Exit;
            end;
            Inc(Result, get_cached_query_segment_path_bonus(lookup_text,
                path_value_local));
            Dec(Result, get_cached_query_segment_path_penalty(lookup_text,
                path_value_local));
        end;

        function build_replaced_path_local(const replace_idx_local: Integer;
            const replacement_text_local: string): string;
        var
            idx_local: Integer;
            segment_local: string;
        begin
            Result := '';
            for idx_local := 0 to High(path_parts_local) do
            begin
                if idx_local = replace_idx_local then
                begin
                    segment_local := replacement_text_local;
                end
                else
                begin
                    segment_local := Trim(path_parts_local[idx_local]);
                end;
                if segment_local = '' then
                begin
                    Continue;
                end;
                if Result <> '' then
                begin
                    Result := Result + c_segment_path_separator;
                end;
                Result := Result + segment_local;
            end;
        end;

        function build_replaced_path_with_refined_part_local(
            const replace_idx_local: Integer;
            const replacement_text_local: string;
            const refine_idx_local: Integer;
            const boundary_mask_value_local: Integer): string;
        var
            idx_local: Integer;
            segment_local: string;
            refined_units_local: TArray<string>;
            unit_idx_value_local: Integer;

            procedure append_segment_local(const value_local: string);
            var
                normalized_value_local: string;
            begin
                normalized_value_local := Trim(value_local);
                if normalized_value_local = '' then
                begin
                    Exit;
                end;
                if Result <> '' then
                begin
                    Result := Result + c_segment_path_separator;
                end;
                Result := Result + normalized_value_local;
            end;
        begin
            Result := '';
            if (replace_idx_local < 0) or
                (replace_idx_local > High(path_parts_local)) or
                (refine_idx_local < 0) or
                (refine_idx_local >= replace_idx_local) then
            begin
                Exit;
            end;
            refined_units_local := split_text_units(
                Trim(path_parts_local[refine_idx_local]));
            if (Length(refined_units_local) < 2) or
                (Length(refined_units_local) > 6) or
                (boundary_mask_value_local <= 0) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(path_parts_local) do
            begin
                if idx_local = refine_idx_local then
                begin
                    segment_local := '';
                    for unit_idx_value_local := 0 to
                        High(refined_units_local) do
                    begin
                        segment_local := segment_local +
                            refined_units_local[unit_idx_value_local];
                        if (unit_idx_value_local <
                            High(refined_units_local)) and
                            ((boundary_mask_value_local and
                            (1 shl unit_idx_value_local)) <> 0) then
                        begin
                            append_segment_local(segment_local);
                            segment_local := '';
                        end;
                    end;
                    append_segment_local(segment_local);
                end
                else if idx_local = replace_idx_local then
                begin
                    append_segment_local(replacement_text_local);
                end
                else
                begin
                    append_segment_local(path_parts_local[idx_local]);
                end;
            end;
        end;

        function span_crosses_path_boundary_local(const start_idx_local: Integer;
            const count_local: Integer): Boolean;
        var
            idx_local: Integer;
            boundary_local: Integer;
            end_idx_local: Integer;
        begin
            Result := False;
            end_idx_local := start_idx_local + count_local;
            for idx_local := 1 to High(path_starts_local) do
            begin
                boundary_local := path_starts_local[idx_local];
                if (boundary_local > start_idx_local) and
                    (boundary_local < end_idx_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function exact_candidate_is_reliable_local(
            const query_key_local: string; const candidate_local: TncCandidate;
            const expected_units_local: Integer): Boolean;
        var
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            if Trim(candidate_local.comment) <> '' then
            begin
                Exit;
            end;
            candidate_text_local := Trim(candidate_local.text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units_local) then
            begin
                Exit;
            end;
            candidate_weight_local := candidate_local.score;
            if candidate_local.has_dict_weight and
                (candidate_local.dict_weight > candidate_weight_local) then
            begin
                candidate_weight_local := candidate_local.dict_weight;
            end;
            Inc(candidate_weight_local, get_preferred_query_phrase_bonus_local(
                query_key_local, candidate_text_local));
            Result := candidate_weight_local >= c_crossing_exact_min_weight;
        end;

        function get_path_part_exact_weight_local(
            const part_idx_value_local: Integer): Integer;
        var
            query_key_local: string;
            results_local: TncCandidateList;
            result_idx_value_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := 0;
            if (part_idx_value_local < 0) or
                (part_idx_value_local > High(path_parts_local)) then
            begin
                Exit;
            end;
            query_key_local := build_query_key_local(
                path_starts_local[part_idx_value_local],
                path_lengths_local[part_idx_value_local]);
            if (query_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key_local,
                results_local)) then
            begin
                Exit;
            end;
            for result_idx_value_local := 0 to Min(c_exact_probe_limit - 1,
                High(results_local)) do
            begin
                if Trim(results_local[result_idx_value_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    results_local[result_idx_value_local].text);
                if not SameText(candidate_text_local,
                    Trim(path_parts_local[part_idx_value_local])) then
                begin
                    Continue;
                end;
                candidate_weight_local :=
                    results_local[result_idx_value_local].score;
                if results_local[result_idx_value_local].has_dict_weight and
                    (results_local[result_idx_value_local].dict_weight >
                    candidate_weight_local) then
                begin
                    candidate_weight_local :=
                        results_local[result_idx_value_local].dict_weight;
                end;
                Exit(candidate_weight_local);
            end;
        end;

        function get_path_part_exact_raw_weight_local(
            const part_idx_value_local: Integer): Integer;
        var
            query_key_local: string;
            results_local: TncCandidateList;
            result_idx_value_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := 0;
            if (part_idx_value_local < 0) or
                (part_idx_value_local > High(path_parts_local)) then
            begin
                Exit;
            end;
            query_key_local := build_query_key_local(
                path_starts_local[part_idx_value_local],
                path_lengths_local[part_idx_value_local]);
            if (query_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key_local,
                results_local)) then
            begin
                Exit;
            end;
            for result_idx_value_local := 0 to Min(c_exact_probe_limit - 1,
                High(results_local)) do
            begin
                if Trim(results_local[result_idx_value_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    results_local[result_idx_value_local].text);
                if not SameText(candidate_text_local,
                    Trim(path_parts_local[part_idx_value_local])) then
                begin
                    Continue;
                end;
                candidate_weight_local :=
                    results_local[result_idx_value_local].score;
                if results_local[result_idx_value_local].has_dict_weight and
                    (results_local[result_idx_value_local].dict_weight > 0) then
                begin
                    candidate_weight_local :=
                        results_local[result_idx_value_local].dict_weight;
                end;
                Exit(candidate_weight_local);
            end;
        end;

        function crossing_span_breaks_strong_word_pair_local(
            const start_idx_local: Integer; const count_local: Integer): Boolean;
        const
            c_strong_part_weight = 700;
        var
            part_idx_value_local: Integer;
            boundary_local: Integer;
            end_idx_local: Integer;
        begin
            Result := False;
            end_idx_local := start_idx_local + count_local;
            for part_idx_value_local := 1 to High(path_parts_local) do
            begin
                boundary_local := path_starts_local[part_idx_value_local];
                if (boundary_local <= start_idx_local) or
                    (boundary_local >= end_idx_local) then
                begin
                    Continue;
                end;
                if (path_lengths_local[part_idx_value_local - 1] >= 2) and
                    (path_lengths_local[part_idx_value_local] >= 2) and
                    (get_path_part_exact_weight_local(
                    part_idx_value_local - 1) >= c_strong_part_weight) and
                    (get_path_part_exact_weight_local(
                    part_idx_value_local) >= c_strong_part_weight) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (Trim(stable_text) = '') or
            (Trim(encoded_path) = '') or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        stable_units_local := split_text_units(Trim(stable_text));
        if (Length(syllables_local) < 2) or
            (Length(stable_units_local) <> Length(syllables_local)) then
        begin
            Exit;
        end;

        path_parts_local := encoded_path.Split([c_segment_path_separator]);
        SetLength(path_starts_local, Length(path_parts_local));
        SetLength(path_lengths_local, Length(path_parts_local));
        total_units_local := 0;
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            part_text_local := Trim(path_parts_local[part_idx_local]);
            part_units_local := split_text_units(part_text_local);
            if (part_text_local = '') or (Length(part_units_local) <= 0) then
            begin
                Exit;
            end;
            path_starts_local[part_idx_local] := total_units_local;
            path_lengths_local[part_idx_local] := Length(part_units_local);
            Inc(total_units_local, Length(part_units_local));
        end;
        if total_units_local <> Length(syllables_local) then
        begin
            Exit;
        end;

        stable_path_adjustment_local := get_path_adjustment_local(encoded_path);
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            part_text_local := Trim(path_parts_local[part_idx_local]);
            part_key_local := build_query_key_local(
                path_starts_local[part_idx_local],
                path_lengths_local[part_idx_local]);
            if (part_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(part_key_local,
                exact_results_local)) then
            begin
                Continue;
            end;
            previous_unit_local := '';
            if path_starts_local[part_idx_local] > 0 then
            begin
                previous_unit_local := stable_units_local[
                    path_starts_local[part_idx_local] - 1];
            end;
            for exact_idx_local := 0 to Min(c_exact_probe_limit - 1,
                High(exact_results_local)) do
            begin
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    (exact_text_local = '') or
                    SameText(exact_text_local, part_text_local) or
                    (get_candidate_text_unit_count(exact_text_local) <>
                    path_lengths_local[part_idx_local]) then
                begin
                    Continue;
                end;

                stable_part_weight_local :=
                    get_path_part_exact_raw_weight_local(part_idx_local);
                alternative_weight_local :=
                    exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight > 0) then
                begin
                    alternative_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end;
                if (path_lengths_local[part_idx_local] <= 3) and
                    (stable_part_weight_local >= c_close_exact_min_weight) and
                    (alternative_weight_local >= c_close_exact_min_weight) and
                    (Abs(stable_part_weight_local - alternative_weight_local) <=
                    c_close_exact_raw_gap) then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info + Format(
                            ' rvclose=[part=%d from=%s to=%s gap=%d]',
                            [part_idx_local, part_text_local, exact_text_local,
                            Abs(stable_part_weight_local -
                            alternative_weight_local)]);
                    end;
                    Exit(True);
                end;

                alternative_path_local := build_replaced_path_local(
                    part_idx_local, exact_text_local);
                alternative_path_adjustment_local := get_path_adjustment_local(
                    alternative_path_local);
                if alternative_path_adjustment_local >
                    stable_path_adjustment_local then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info + Format(
                            ' rvpath=[part=%d from=%s to=%s delta=%d]',
                            [part_idx_local, part_text_local, exact_text_local,
                            alternative_path_adjustment_local -
                            stable_path_adjustment_local]);
                    end;
                    Exit(True);
                end;

                if part_idx_local > 0 then
                begin
                    for refine_part_idx_local := 0 to
                        part_idx_local - 1 do
                    begin
                        if (path_lengths_local[refine_part_idx_local] < 2) or
                            (path_lengths_local[refine_part_idx_local] > 6) then
                        begin
                            Continue;
                        end;
                        max_boundary_mask_local :=
                            (1 shl (path_lengths_local[
                            refine_part_idx_local] - 1)) - 1;
                        for boundary_mask_local := 1 to
                            max_boundary_mask_local do
                        begin
                            alternative_path_local :=
                                build_replaced_path_with_refined_part_local(
                                part_idx_local, exact_text_local,
                                refine_part_idx_local,
                                boundary_mask_local);
                            alternative_path_adjustment_local :=
                                get_path_adjustment_local(
                                alternative_path_local);
                            if alternative_path_adjustment_local >
                                stable_path_adjustment_local then
                            begin
                                if m_config.debug_mode then
                                begin
                                    m_last_full_path_debug_info :=
                                        m_last_full_path_debug_info + Format(
                                        ' rvpathrefine=[part=%d refine=%d mask=%d from=%s to=%s delta=%d]',
                                        [part_idx_local,
                                        refine_part_idx_local,
                                        boundary_mask_local,
                                        part_text_local, exact_text_local,
                                        alternative_path_adjustment_local -
                                        stable_path_adjustment_local]);
                                end;
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                if (path_lengths_local[part_idx_local] = 2) and
                    is_place_context_tail_unit_local(previous_unit_local) and
                    (get_directional_locative_span_bonus_local(
                    exact_text_local) > 0) and
                    (get_directional_locative_span_bonus_local(
                    part_text_local) <= 0) then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info + Format(
                            ' rvdir=[part=%d from=%s to=%s]',
                            [part_idx_local, part_text_local, exact_text_local]);
                    end;
                    Exit(True);
                end;
            end;
        end;

        if Length(syllables_local) > 8 then
        begin
            Exit;
        end;
        for span_start_local := 0 to Length(syllables_local) - 2 do
        begin
            for span_len_local := 2 to Min(c_max_crossing_span_units,
                Length(syllables_local) - span_start_local) do
            begin
                if span_start_local + span_len_local >
                    Length(syllables_local) - 2 then
                begin
                    Continue;
                end;
                if not span_crosses_path_boundary_local(span_start_local,
                    span_len_local) then
                begin
                    Continue;
                end;
                crossing_breaks_strong_pair_local :=
                    crossing_span_breaks_strong_word_pair_local(
                    span_start_local, span_len_local);
                if crossing_breaks_strong_pair_local and
                    ((span_start_local <> 0) or (span_len_local < 3)) then
                begin
                    Continue;
                end;

                part_key_local := build_query_key_local(span_start_local,
                    span_len_local);
                if (part_key_local = '') or
                    (not lookup_exact_full_pinyin_cached_local(part_key_local,
                    exact_results_local)) then
                begin
                    Continue;
                end;
                span_text_local := '';
                for unit_idx_local := span_start_local to
                    span_start_local + span_len_local - 1 do
                begin
                    span_text_local := span_text_local +
                        stable_units_local[unit_idx_local];
                end;
                for exact_idx_local := 0 to Min(c_exact_probe_limit - 1,
                    High(exact_results_local)) do
                begin
                    exact_text_local := Trim(
                        exact_results_local[exact_idx_local].text);
                    if (not SameText(exact_text_local, span_text_local)) and
                        exact_candidate_is_reliable_local(part_key_local,
                        exact_results_local[exact_idx_local], span_len_local) and
                        ((not crossing_breaks_strong_pair_local) or
                        (exact_results_local[exact_idx_local].score >= 900) or
                        (exact_results_local[exact_idx_local].has_dict_weight and
                        (exact_results_local[exact_idx_local].dict_weight >=
                        900))) then
                    begin
                        if m_config.debug_mode then
                        begin
                            m_last_full_path_debug_info :=
                                m_last_full_path_debug_info + Format(
                                ' rvcross=[start=%d len=%d key=%s from=%s to=%s]',
                                [span_start_local, span_len_local,
                                part_key_local, span_text_local,
                                exact_text_local]);
                        end;
                        Exit(True);
                    end;
                end;
            end;
        end;
    end;

    function try_repair_ranked_directional_context_local(
        const stable_candidate: TncCandidate; const encoded_path: string;
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_exact_probe_limit = 8;
        c_directional_context_bonus = 12000;
    var
        syllables_local: TncPinyinParseResult;
        stable_units_local: TArray<string>;
        path_parts_local: TArray<string>;
        path_starts_local: TArray<Integer>;
        path_lengths_local: TArray<Integer>;
        total_units_local: Integer;
        part_idx_local: Integer;
        part_units_local: TArray<string>;
        part_text_local: string;
        query_key_local: string;
        exact_results_local: TncCandidateList;
        exact_idx_local: Integer;
        exact_text_local: string;
        exact_units_local: TArray<string>;
        exact_weight_local: Integer;
        best_weight_local: Integer;
        best_part_idx_local: Integer;
        best_text_local: string;
        unit_idx_local: Integer;

        function build_query_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            for syllable_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[syllable_idx_local].text);
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (Trim(stable_candidate.comment) <> '') or
            (Trim(stable_candidate.text) = '') or (Trim(encoded_path) = '') or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        stable_units_local := split_text_units(Trim(stable_candidate.text));
        if Length(stable_units_local) <> Length(syllables_local) then
        begin
            Exit;
        end;

        path_parts_local := encoded_path.Split([c_segment_path_separator]);
        SetLength(path_starts_local, Length(path_parts_local));
        SetLength(path_lengths_local, Length(path_parts_local));
        total_units_local := 0;
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            part_text_local := Trim(path_parts_local[part_idx_local]);
            part_units_local := split_text_units(part_text_local);
            if (part_text_local = '') or (Length(part_units_local) <= 0) then
            begin
                Exit;
            end;
            path_starts_local[part_idx_local] := total_units_local;
            path_lengths_local[part_idx_local] := Length(part_units_local);
            Inc(total_units_local, Length(part_units_local));
        end;
        if total_units_local <> Length(syllables_local) then
        begin
            Exit;
        end;

        best_weight_local := Low(Integer);
        best_part_idx_local := -1;
        best_text_local := '';
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            if (path_lengths_local[part_idx_local] <> 2) or
                (path_starts_local[part_idx_local] <= 0) or
                (not is_place_context_tail_unit_local(stable_units_local[
                path_starts_local[part_idx_local] - 1])) or
                (get_directional_locative_span_bonus_local(
                Trim(path_parts_local[part_idx_local])) > 0) then
            begin
                Continue;
            end;
            query_key_local := build_query_key_local(
                path_starts_local[part_idx_local], 2);
            if (query_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key_local,
                exact_results_local)) then
            begin
                Continue;
            end;
            for exact_idx_local := 0 to Min(c_exact_probe_limit - 1,
                High(exact_results_local)) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (get_candidate_text_unit_count(exact_text_local) <> 2) or
                    (get_directional_locative_span_bonus_local(
                    exact_text_local) <= 0) then
                begin
                    Continue;
                end;
                exact_weight_local := exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight >
                    exact_weight_local) then
                begin
                    exact_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end;
                if exact_weight_local > best_weight_local then
                begin
                    best_weight_local := exact_weight_local;
                    best_part_idx_local := part_idx_local;
                    best_text_local := exact_text_local;
                end;
            end;
        end;
        if best_part_idx_local < 0 then
        begin
            Exit;
        end;

        out_candidate := stable_candidate;
        exact_units_local := split_text_units(best_text_local);
        stable_units_local[path_starts_local[best_part_idx_local]] :=
            exact_units_local[0];
        stable_units_local[path_starts_local[best_part_idx_local] + 1] :=
            exact_units_local[1];
        out_candidate.text := '';
        for unit_idx_local := 0 to High(stable_units_local) do
        begin
            out_candidate.text := out_candidate.text + stable_units_local[unit_idx_local];
        end;
        Inc(out_candidate.score, c_directional_context_bonus +
            Max(0, best_weight_local));
        out_candidate.has_dict_weight := True;
        out_candidate.dict_weight := out_candidate.score;

        path_parts_local[best_part_idx_local] := best_text_local;
        out_encoded_path := '';
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            if out_encoded_path <> '' then
            begin
                out_encoded_path := out_encoded_path + c_segment_path_separator;
            end;
            out_encoded_path := out_encoded_path + Trim(path_parts_local[part_idx_local]);
        end;
        Result := True;
    end;

    function try_build_light_stable_phrase_chain_candidate_local(
        out out_candidate: TncCandidate; out out_encoded_path: string): Boolean;
    const
        c_max_span = 5;
        c_probe_limit = 6;
    var
        syllables_local: TncPinyinParseResult;
        pos_local: Integer;
        text_local: string;
        path_local: string;
        score_local: Integer;
        phrase_count_local: Integer;

        function build_syllable_key_local(const local_start_idx: Integer;
            const local_count: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_count <= 0) or
                (local_start_idx + local_count > Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function build_tail_comment_local(const local_start_idx: Integer): string;
        begin
            Result := build_syllable_key_local(local_start_idx,
                Length(syllables_local) - local_start_idx);
        end;

        function is_user_exact_full_text_local(
            const text_value_local: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
        begin
            Result := False;
            if (Trim(text_value_local) = '') or
                (not dictionary_exact_lookup_cached(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (exact_results_local[exact_idx_local].source = cs_user) and
                    (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_idx_local].text),
                    Trim(text_value_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_exact_full_query_text_support_local(
            const text_value_local: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if (Trim(text_value_local) = '') or
                (not dictionary_exact_lookup_cached(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(exact_text_local, Trim(text_value_local)) and
                    (get_candidate_text_unit_count(exact_text_local) =
                    input_syllable_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function stable_single_text_local(const syllable_text: string): string;
        var
            normalized_local: string;
            fixed_text_local: string;
        begin
            Result := '';
            normalized_local := normalize_pinyin_text(syllable_text);
            if (normalized_local = '') or
                (not is_full_pinyin_key(normalized_local)) then
            begin
                Exit;
            end;

            fixed_text_local := get_fixed_resolved_boundary_char_local(
                normalized_local);
            if fixed_text_local <> '' then
            begin
                Exit(fixed_text_local);
            end;

            Exit;
        end;

        procedure append_segment_local(const segment_text: string;
            const segment_score: Integer; const is_phrase: Boolean);
        begin
            text_local := text_local + segment_text;
            if path_local <> '' then
            begin
                path_local := path_local + c_segment_path_separator;
            end;
            path_local := path_local + segment_text;
            Inc(score_local, segment_score);
            if is_phrase then
            begin
                Inc(phrase_count_local);
            end;
        end;

        function try_append_two_plus_one_split_local(
            const split_pos_local: Integer;
            const current_segment_score_local: Integer): Boolean;
        var
            prefix_key_local: string;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_text_local: string;
            prefix_weight_local: Integer;
            best_prefix_text_local: string;
            best_prefix_weight_local: Integer;
            suffix_text_local: string;
            split_score_local: Integer;
        begin
            Result := False;
            if (split_pos_local < 0) or
                (split_pos_local + 2 >= Length(syllables_local)) then
            begin
                Exit;
            end;

            prefix_key_local := build_syllable_key_local(split_pos_local, 2);
            if (prefix_key_local = '') or
                (not dictionary_exact_lookup_cached(prefix_key_local,
                prefix_results_local)) then
            begin
                Exit;
            end;

            best_prefix_text_local := '';
            best_prefix_weight_local := Low(Integer);
            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                if prefix_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(prefix_results_local[prefix_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                prefix_text_local := Trim(
                    prefix_results_local[prefix_idx_local].text);
                if (prefix_text_local = '') or
                    (get_candidate_text_unit_count(prefix_text_local) <> 2) then
                begin
                    Continue;
                end;
                if prefix_results_local[prefix_idx_local].has_dict_weight then
                begin
                    prefix_weight_local :=
                        prefix_results_local[prefix_idx_local].dict_weight;
                end
                else
                begin
                    prefix_weight_local :=
                        prefix_results_local[prefix_idx_local].score;
                end;
                if prefix_weight_local > best_prefix_weight_local then
                begin
                    best_prefix_weight_local := prefix_weight_local;
                    best_prefix_text_local := prefix_text_local;
                end;
            end;

            if (best_prefix_text_local = '') or
                (best_prefix_weight_local < 700) then
            begin
                Exit;
            end;

            suffix_text_local := stable_single_text_local(
                syllables_local[split_pos_local + 2].text);
            if suffix_text_local = '' then
            begin
                Exit;
            end;

            split_score_local := best_prefix_weight_local + 2800;
            if split_score_local <= current_segment_score_local + 260 then
            begin
                Exit;
            end;

            append_segment_local(best_prefix_text_local,
                best_prefix_weight_local + 1200, True);
            append_segment_local(suffix_text_local, 900, False);
            Result := True;
        end;

        function tail_key_is_precisely_extendable_local(
            const local_tail_key: string): Boolean;
        var
            suffix_ch_local: Char;
            extended_tail_key_local: string;
        begin
            Result := False;
            if (local_tail_key = '') or (not is_full_pinyin_key(local_tail_key)) then
            begin
                Exit;
            end;

            for suffix_ch_local := 'a' to 'z' do
            begin
                extended_tail_key_local := local_tail_key + suffix_ch_local;
                if is_full_pinyin_key(extended_tail_key_local) and
                    (get_effective_compact_pinyin_unit_count(
                    extended_tail_key_local) = 1) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function should_keep_tail_syllable_partial_local(
            const local_pos: Integer): Boolean;
        var
            tail_key_local: string;
        begin
            Result := False;
            if (local_pos < 0) or (local_pos <> High(syllables_local)) then
            begin
                Exit;
            end;

            tail_key_local := normalize_pinyin_text(
                syllables_local[local_pos].text);
            Result := (tail_key_local = '') or
                (not is_full_pinyin_key(tail_key_local)) or
                tail_key_is_precisely_extendable_local(tail_key_local);
        end;

        function equals_cjk2_chars_local(const value: string;
            const first_code: Word; const second_code: Word): Boolean;
        begin
            Result := (Length(value) = 2) and
                (value[1] = WideChar(first_code)) and
                (value[2] = WideChar(second_code));
        end;

        function ends_with_cjk1_char_local(const value: string;
            const code: Word): Boolean;
        begin
            Result := (Length(value) >= 1) and
                (value[Length(value)] = WideChar(code));
        end;

        function ends_with_cjk2_chars_local(const value: string;
            const first_code: Word; const second_code: Word): Boolean;
        begin
            Result := (Length(value) >= 2) and
                (value[Length(value) - 1] = WideChar(first_code)) and
                (value[Length(value)] = WideChar(second_code));
        end;

        function is_location_direction_phrase_local(
            const phrase_text: string): Boolean;
        begin
            Result := equals_cjk2_chars_local(phrase_text, $5317, $9762) or
                equals_cjk2_chars_local(phrase_text, $5357, $9762) or
                equals_cjk2_chars_local(phrase_text, $4E1C, $9762) or
                equals_cjk2_chars_local(phrase_text, $897F, $9762) or
                equals_cjk2_chars_local(phrase_text, $524D, $9762) or
                equals_cjk2_chars_local(phrase_text, $540E, $9762) or
                equals_cjk2_chars_local(phrase_text, $4E0A, $9762) or
                equals_cjk2_chars_local(phrase_text, $4E0B, $9762) or
                equals_cjk2_chars_local(phrase_text, $91CC, $9762) or
                equals_cjk2_chars_local(phrase_text, $5916, $9762) or
                equals_cjk2_chars_local(phrase_text, $9644, $8FD1) or
                equals_cjk2_chars_local(phrase_text, $65C1, $8FB9);
        end;

        function looks_like_location_context_local(
            const context_text: string): Boolean;
        var
            trimmed_context_local: string;
        begin
            trimmed_context_local := Trim(context_text);
            Result := (trimmed_context_local <> '') and
                (ends_with_cjk2_chars_local(trimmed_context_local, $5B66,
                $6821) or ends_with_cjk2_chars_local(trimmed_context_local,
                $5927, $5B66) or ends_with_cjk2_chars_local(
                trimmed_context_local, $5B66, $9662) or
                ends_with_cjk2_chars_local(trimmed_context_local, $5C0F,
                $533A) or ends_with_cjk1_char_local(trimmed_context_local,
                $6821) or ends_with_cjk1_char_local(trimmed_context_local,
                $9662) or ends_with_cjk1_char_local(trimmed_context_local,
                $56ED) or ends_with_cjk1_char_local(trimmed_context_local,
                $8DEF) or ends_with_cjk1_char_local(trimmed_context_local,
                $8857) or ends_with_cjk1_char_local(trimmed_context_local,
                $533A) or ends_with_cjk1_char_local(trimmed_context_local,
                $53BF) or ends_with_cjk1_char_local(trimmed_context_local,
                $5E02) or ends_with_cjk1_char_local(trimmed_context_local,
                $7701) or ends_with_cjk1_char_local(trimmed_context_local,
                $9547) or ends_with_cjk1_char_local(trimmed_context_local,
                $4E61) or ends_with_cjk1_char_local(trimmed_context_local,
                $6751) or ends_with_cjk1_char_local(trimmed_context_local,
                $5E97) or ends_with_cjk1_char_local(trimmed_context_local,
                $697C) or ends_with_cjk1_char_local(trimmed_context_local,
                $7AD9) or ends_with_cjk1_char_local(trimmed_context_local,
                $95E8) or ends_with_cjk1_char_local(trimmed_context_local,
                $9986) or ends_with_cjk1_char_local(trimmed_context_local,
                $573A) or ends_with_cjk1_char_local(trimmed_context_local,
                $57CE) or ends_with_cjk2_chars_local(trimmed_context_local,
                $516C, $53F8) or ends_with_cjk2_chars_local(
                trimmed_context_local, $5546, $5708));
        end;

        function get_previous_context_bonus_local(
            const current_text_local: string): Integer;
        begin
            Result := 0;
            if is_location_direction_phrase_local(Trim(current_text_local)) and
                looks_like_location_context_local(text_local) then
            begin
                Result := 1200;
            end;
        end;

        function try_get_best_exact_phrase_local(const local_pos: Integer;
            out out_text: string; out out_score: Integer;
            out out_units: Integer): Boolean;
        var
            span_len_local: Integer;
            key_local: string;
            results_local: TncCandidateList;
            lookup_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_score_local: Integer;
            candidate_base_score_local: Integer;
            best_span_base_score_local: Integer;
            same_span_quality_gap_local: Integer;
            split_check_score_local: Integer;
            internal_alignment_bonus_local: Integer;
            internal_matched_score_local: Integer;
            primary_match_bonus_local: Integer;

            function has_better_prefix_single_split_local(
                const split_span_len_local: Integer;
                const current_score_local: Integer): Boolean;
            const
                c_split_margin = 480;
            var
                prefix_len_local: Integer;
                prefix_key_local: string;
                suffix_key_local: string;
                prefix_results_local: TncCandidateList;
                suffix_results_local: TncCandidateList;
                prefix_idx_local: Integer;
                suffix_idx_local: Integer;
                current_base_score_local: Integer;
                prefix_base_score_local: Integer;
                prefix_score_local: Integer;
                suffix_score_local: Integer;
                split_score_local: Integer;
                prefix_text_local: string;
                suffix_text_local: string;
                stable_suffix_text_local: string;
            begin
                Result := False;
                if split_span_len_local < 3 then
                begin
                    Exit;
                end;

                prefix_len_local := split_span_len_local - 1;
                prefix_key_local := build_syllable_key_local(local_pos,
                    prefix_len_local);
                suffix_key_local := build_syllable_key_local(local_pos +
                    prefix_len_local, 1);
                if (prefix_key_local = '') or (suffix_key_local = '') then
                begin
                    Exit;
                end;

                if not dictionary_exact_lookup_cached(prefix_key_local,
                    prefix_results_local) then
                begin
                    Exit;
                end;
                if not dictionary_lookup_cached(suffix_key_local,
                    suffix_results_local) then
                begin
                    Exit;
                end;

                current_base_score_local := current_score_local -
                    (split_span_len_local * 600);
                if current_base_score_local < 50 then
                begin
                    Exit;
                end;
                if (split_span_len_local = 3) and
                    (current_base_score_local >= 1200) then
                begin
                    Exit;
                end;
                prefix_score_local := Low(Integer);
                prefix_base_score_local := Low(Integer);
                for prefix_idx_local := 0 to High(prefix_results_local) do
                begin
                    if prefix_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(prefix_results_local[prefix_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    prefix_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                    if (prefix_text_local = '') or
                        (get_candidate_text_unit_count(prefix_text_local) <>
                        prefix_len_local) then
                    begin
                        Continue;
                    end;
                    if prefix_results_local[prefix_idx_local].has_dict_weight then
                    begin
                        prefix_base_score_local :=
                            prefix_results_local[prefix_idx_local].dict_weight;
                    end
                    else
                    begin
                        prefix_base_score_local :=
                            prefix_results_local[prefix_idx_local].score;
                    end;
                    prefix_score_local := prefix_base_score_local;
                    Inc(prefix_score_local, prefix_len_local * 600);
                    Break;
                end;
                if prefix_score_local = Low(Integer) then
                begin
                    Exit;
                end;
                if prefix_base_score_local < Max(360,
                    current_base_score_local + 80) then
                begin
                    Exit;
                end;

                suffix_score_local := Low(Integer);
                for suffix_idx_local := 0 to High(suffix_results_local) do
                begin
                    if suffix_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(suffix_results_local[suffix_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    suffix_text_local := Trim(suffix_results_local[suffix_idx_local].text);
                    if (suffix_text_local = '') or
                        (get_candidate_text_unit_count(suffix_text_local) <> 1) or
                        (not is_bmp_cjk_single_char_candidate(
                        suffix_results_local[suffix_idx_local])) then
                    begin
                        Continue;
                    end;
                    if suffix_results_local[suffix_idx_local].has_dict_weight then
                    begin
                        suffix_score_local :=
                            suffix_results_local[suffix_idx_local].dict_weight;
                    end
                    else
                    begin
                        suffix_score_local := suffix_results_local[suffix_idx_local].score;
                    end;
                    Inc(suffix_score_local, 900);
                    Break;
                end;
                if suffix_score_local = Low(Integer) then
                begin
                    stable_suffix_text_local := stable_single_text_local(
                        syllables_local[local_pos + prefix_len_local].text);
                    if stable_suffix_text_local = '' then
                    begin
                        Exit;
                    end;
                    suffix_score_local := 1600;
                end;

                split_score_local := prefix_score_local + suffix_score_local;
                Result := split_score_local > current_score_local + c_split_margin;
            end;

            function has_better_two_single_split_local(
                const split_span_len_local: Integer;
                const current_base_score_local: Integer;
                const current_score_local: Integer): Boolean;
            const
                c_split_margin = 360;
                c_weak_two_char_phrase_limit = 520;
                c_keep_phrase_with_following_min_weight = 400;
                c_reliable_following_phrase_min_weight = 700;
            var
                left_text_local: string;
                right_text_local: string;
                split_score_local: Integer;

                function has_reliable_following_phrase_local: Boolean;
                var
                    next_pos_local: Integer;
                    next_len_local: Integer;
                    next_key_local: string;
                    next_results_local: TncCandidateList;
                    next_idx_local: Integer;
                    next_text_local: string;
                    next_weight_local: Integer;
                begin
                    Result := False;
                    next_pos_local := local_pos + split_span_len_local;
                    if next_pos_local >= Length(syllables_local) then
                    begin
                        Exit;
                    end;

                    for next_len_local := Min(c_max_span,
                        Length(syllables_local) - next_pos_local) downto 2 do
                    begin
                        next_key_local := build_syllable_key_local(
                            next_pos_local, next_len_local);
                        if (next_key_local = '') or
                            (not dictionary_exact_lookup_cached(next_key_local,
                            next_results_local)) then
                        begin
                            Continue;
                        end;

                        for next_idx_local := 0 to High(next_results_local) do
                        begin
                            if next_idx_local >= c_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(next_results_local[next_idx_local].comment) <> '' then
                            begin
                                Continue;
                            end;
                            next_text_local :=
                                Trim(next_results_local[next_idx_local].text);
                            if (next_text_local = '') or
                                (get_candidate_text_unit_count(
                                next_text_local) <> next_len_local) then
                            begin
                                Continue;
                            end;
                            next_weight_local :=
                                next_results_local[next_idx_local].score;
                            if next_results_local[next_idx_local].has_dict_weight and
                                (next_results_local[next_idx_local].dict_weight >
                                next_weight_local) then
                            begin
                                next_weight_local :=
                                    next_results_local[next_idx_local].dict_weight;
                            end;
                            if next_weight_local >=
                                c_reliable_following_phrase_min_weight then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;
            begin
                Result := False;
                if (split_span_len_local <> 2) or
                    (current_base_score_local >= c_weak_two_char_phrase_limit) or
                    (local_pos + 1 >= Length(syllables_local)) then
                begin
                    Exit;
                end;

                if (current_base_score_local >=
                    c_keep_phrase_with_following_min_weight) and
                    has_reliable_following_phrase_local then
                begin
                    Exit;
                end;

                left_text_local := stable_single_text_local(
                    syllables_local[local_pos].text);
                right_text_local := stable_single_text_local(
                    syllables_local[local_pos + 1].text);
                if (left_text_local = '') or (right_text_local = '') then
                begin
                    Exit;
                end;

                split_score_local := 3000;
                if m_dictionary <> nil then
                begin
                    Inc(split_score_local,
                        m_dictionary.get_context_bonus(left_text_local,
                        right_text_local) * 4);
                end;
                Result := split_score_local > current_score_local + c_split_margin;
            end;

            function get_lookup_rank_score_for_text_local(
                const lookup_text_local: string;
                const fallback_score_local: Integer): Integer;
            const
                c_lookup_rank_bonus = 384;
            var
                lookup_idx_local: Integer;
                lookup_candidate_text_local: string;
            begin
                Result := fallback_score_local;
                for lookup_idx_local := 0 to High(lookup_results_local) do
                begin
                    if lookup_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results_local[lookup_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    lookup_candidate_text_local := Trim(
                        lookup_results_local[lookup_idx_local].text);
                    if (lookup_candidate_text_local <> '') and
                        SameText(lookup_candidate_text_local,
                        lookup_text_local) then
                    begin
                        Result := lookup_results_local[lookup_idx_local].score;
                        if lookup_results_local[lookup_idx_local].has_dict_weight and
                            (lookup_results_local[lookup_idx_local].dict_weight >
                            Result) then
                        begin
                            Result :=
                                lookup_results_local[lookup_idx_local].dict_weight;
                        end;
                        Inc(Result, (c_probe_limit - lookup_idx_local) *
                            c_lookup_rank_bonus);
                        Exit;
                    end;
                end;
            end;

            function get_lookup_primary_match_bonus_for_text_local(
                const lookup_text_local: string;
                const lookup_units_local: Integer): Integer;
            const
                c_primary_lookup_bonus = 720;
            var
                lookup_idx_local: Integer;
                lookup_candidate_text_local: string;
            begin
                Result := 0;
                for lookup_idx_local := 0 to High(lookup_results_local) do
                begin
                    if lookup_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results_local[lookup_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    lookup_candidate_text_local := Trim(
                        lookup_results_local[lookup_idx_local].text);
                    if (lookup_candidate_text_local = '') or
                        (get_candidate_text_unit_count(
                        lookup_candidate_text_local) <> lookup_units_local) then
                    begin
                        Continue;
                    end;
                    if SameText(lookup_candidate_text_local,
                        lookup_text_local) then
                    begin
                        Result := c_primary_lookup_bonus;
                    end;
                    Exit;
                end;
            end;

            function try_get_best_calibrated_exact_span_score_local(
                const score_pos_local: Integer; const score_units_local: Integer;
                out out_score_local: Integer; out out_text_local: string): Boolean;
            var
                score_key_local: string;
                exact_local: TncCandidateList;
                lookup_local: TncCandidateList;
                exact_idx_local: Integer;
                lookup_idx_local: Integer;
                exact_text_local: string;
                lookup_text_local: string;
                base_score_local: Integer;
                calibrated_score_local: Integer;
            begin
                Result := False;
                out_score_local := Low(Integer);
                out_text_local := '';
                score_key_local := build_syllable_key_local(score_pos_local,
                    score_units_local);
                if (score_key_local = '') or
                    (not dictionary_exact_lookup_cached(score_key_local,
                    exact_local)) then
                begin
                    Exit;
                end;
                if not dictionary_lookup_cached(score_key_local, lookup_local) then
                begin
                    lookup_local := nil;
                end;

                for exact_idx_local := 0 to High(exact_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(exact_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    exact_text_local := Trim(exact_local[exact_idx_local].text);
                    if (exact_text_local = '') or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        score_units_local) then
                    begin
                        Continue;
                    end;

                    if exact_local[exact_idx_local].has_dict_weight then
                    begin
                        base_score_local := exact_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        base_score_local := exact_local[exact_idx_local].score;
                    end;
                    calibrated_score_local := base_score_local;
                    for lookup_idx_local := 0 to High(lookup_local) do
                    begin
                        if lookup_idx_local >= c_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(lookup_local[lookup_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        lookup_text_local := Trim(
                            lookup_local[lookup_idx_local].text);
                        if SameText(lookup_text_local, exact_text_local) then
                        begin
                            calibrated_score_local :=
                                lookup_local[lookup_idx_local].score;
                            if lookup_local[lookup_idx_local].has_dict_weight and
                                (lookup_local[lookup_idx_local].dict_weight >
                                calibrated_score_local) then
                            begin
                                calibrated_score_local :=
                                    lookup_local[lookup_idx_local].dict_weight;
                            end;
                            Break;
                        end;
                    end;
                    Inc(calibrated_score_local, score_units_local * 600);
                    if (not Result) or (calibrated_score_local >
                        out_score_local) then
                    begin
                        Result := True;
                        out_score_local := calibrated_score_local;
                        out_text_local := exact_text_local;
                    end;
                end;
            end;

            function has_better_single_prefix_phrase_split_local(
                const split_span_len_local: Integer;
                const current_base_score_local: Integer;
                const current_score_local: Integer): Boolean;
