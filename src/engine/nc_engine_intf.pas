            end;
            if m_last_full_path_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_full_path_debug_info;
            end;
            if filtered_prefix_misaligned_count_local > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' filter_prefix_misaligned=%d',
                    [filtered_prefix_misaligned_count_local]);
            end;
            if deduped_prefix_candidate_count_local > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' dedupe=%d',
                    [deduped_prefix_candidate_count_local]);
            end;
        end;
        phase_start_tick_local := GetTickCount64;
        refresh_candidate_segment_paths;
        note_prefix_phase_elapsed_local('pfrefresh2', phase_start_tick_local);
        note_ranked_top_candidate;
        m_page_index := 0;
        m_selected_index := 0;
    end;

    procedure ensure_complete_long_top_tail_partial_second_local;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
        top_units_local: TArray<string>;
        syllables_local: TncPinyinParseResult;
        prefix_text_local: string;
        tail_key_local: string;
        idx_local: Integer;
        move_idx_local: Integer;
        existing_idx_local: Integer;
        target_idx_local: Integer;
        partial_candidate_local: TncCandidate;
        function is_full_complete_candidate_local(
            const candidate: TncCandidate): Boolean;
        begin
            Result := (Trim(candidate.comment) = '') and
                (get_candidate_text_unit_count(Trim(candidate.text)) =
                input_syllable_count);
        end;
        function prefix_partial_insert_index_local(
            const skip_index: Integer): Integer;
        var
            scan_idx_local: Integer;
            complete_count_local: Integer;
        begin
            Result := 0;
            complete_count_local := 0;
            for scan_idx_local := 0 to High(m_candidates) do
            begin
                if scan_idx_local = skip_index then
                begin
                    Continue;
                end;

                if is_full_complete_candidate_local(m_candidates[scan_idx_local]) then
                begin
                    Inc(complete_count_local);
                    Result := scan_idx_local + 1;
                    if complete_count_local >= 2 then
                    begin
                        Break;
                    end;
                end;
            end;
            if (skip_index >= 0) and (skip_index < Result) then
            begin
                Dec(Result);
            end;
            if Result < 1 then
            begin
                Result := 1;
            end;
        end;
        procedure move_candidate_to_target_local(const from_index: Integer;
            const to_index: Integer);
        var
            local_move_idx: Integer;
            moved_candidate_local: TncCandidate;
            moved_path_local: string;
        begin
            if (from_index < 0) or (from_index >= Length(m_candidates)) or
                (to_index < 0) or (to_index >= Length(m_candidates)) or
                (from_index = to_index) then
            begin
                Exit;
            end;

            moved_candidate_local := m_candidates[from_index];
            moved_path_local := '';
            if from_index < Length(m_candidate_segment_paths) then
            begin
                moved_path_local := m_candidate_segment_paths[from_index];
            end;

            if from_index > to_index then
            begin
                for local_move_idx := from_index downto to_index + 1 do
                begin
                    m_candidates[local_move_idx] :=
                        m_candidates[local_move_idx - 1];
                    if local_move_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[local_move_idx] :=
                            m_candidate_segment_paths[local_move_idx - 1];
                    end;
                end;
            end
            else
            begin
                for local_move_idx := from_index to to_index - 1 do
                begin
                    m_candidates[local_move_idx] :=
                        m_candidates[local_move_idx + 1];
                    if local_move_idx < Length(m_candidate_segment_paths) - 1 then
                    begin
                        m_candidate_segment_paths[local_move_idx] :=
                            m_candidate_segment_paths[local_move_idx + 1];
                    end;
                end;
            end;

            m_candidates[to_index] := moved_candidate_local;
            if to_index < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[to_index] := moved_path_local;
            end;
        end;
    begin
        if (input_syllable_count < 6) or (Length(m_candidates) = 0) then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        top_text_local := Trim(top_candidate_local.text);
        if (top_text_local = '') or (Trim(top_candidate_local.comment) <> '') or
            (get_candidate_text_unit_count(top_text_local) <>
            input_syllable_count) then
        begin
            Exit;
        end;

        top_units_local := split_text_units(top_text_local);
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if (Length(top_units_local) <> input_syllable_count) or
            (Length(syllables_local) <> input_syllable_count) then
        begin
            Exit;
        end;

        prefix_text_local := '';
        for idx_local := 0 to High(top_units_local) - 1 do
        begin
            prefix_text_local := prefix_text_local + top_units_local[idx_local];
        end;
        tail_key_local := normalize_pinyin_text(
            Trim(syllables_local[High(syllables_local)].text));
        if (prefix_text_local = '') or (tail_key_local = '') then
        begin
            Exit;
        end;

        existing_idx_local := -1;
        for idx_local := 0 to High(m_candidates) do
        begin
            if SameText(Trim(m_candidates[idx_local].text), prefix_text_local) and
                SameText(normalize_pinyin_text(Trim(m_candidates[idx_local].comment)),
                tail_key_local) then
            begin
                existing_idx_local := idx_local;
                Break;
            end;
        end;

        target_idx_local := prefix_partial_insert_index_local(
            existing_idx_local);
        if target_idx_local > High(m_candidates) then
        begin
            target_idx_local := High(m_candidates);
        end;

        if existing_idx_local = target_idx_local then
        begin
            Exit;
        end;
        if existing_idx_local >= 0 then
        begin
            move_candidate_to_target_local(existing_idx_local,
                target_idx_local);
            Exit;
        end;

        partial_candidate_local := top_candidate_local;
        partial_candidate_local.text := prefix_text_local;
        partial_candidate_local.comment := tail_key_local;
        partial_candidate_local.score := Max(0, top_candidate_local.score - 80);
        partial_candidate_local.has_dict_weight := False;
        partial_candidate_local.dict_weight := 0;

        SetLength(m_candidates, Length(m_candidates) + 1);
        if Length(m_candidate_segment_paths) < Length(m_candidates) then
        begin
            SetLength(m_candidate_segment_paths, Length(m_candidates));
        end;
        if target_idx_local > High(m_candidates) then
        begin
            target_idx_local := High(m_candidates);
        end;
        for move_idx_local := High(m_candidates) downto target_idx_local + 1 do
        begin
            m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
            if move_idx_local < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[move_idx_local] :=
                    m_candidate_segment_paths[move_idx_local - 1];
            end;
        end;
        m_candidates[target_idx_local] := partial_candidate_local;
        if target_idx_local < Length(m_candidate_segment_paths) then
        begin
            m_candidate_segment_paths[target_idx_local] := '';
        end;
    end;

    procedure finalize_direct_preferred_candidates_and_prepare_exit(
        const debug_extra: string);
    var
        deduped_direct_candidate_count_local: Integer;
        direct_top_candidate_local: TncCandidate;
        direct_top_text_local: string;
        direct_top_valid_local: Boolean;
        direct_top_syllables_local: TncPinyinParseResult;

        procedure finalize_lookup_timing_info_lightweight_local;
        var
            total_elapsed_ms_local: Int64;
        begin
            total_elapsed_ms_local := Int64(GetTickCount64 - total_start_tick);
            m_last_lookup_timing_info := Format(
                'perf=[lk=%d seg=%d path=%d rt=%d post=%d sort=%d cache=%d/%d total=%d]',
                [lookup_elapsed_ms, segment_elapsed_ms,
                path_search_elapsed_ms, runtime_elapsed_ms, post_elapsed_ms,
                sort_elapsed_ms, lookup_cache_hits, lookup_cache_misses,
                total_elapsed_ms_local]);
        end;

        function build_direct_top_query_key_local(const start_idx: Integer;
            const span_len: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            if (span_len <= 0) or (start_idx < 0) or
                (start_idx + span_len > Length(direct_top_syllables_local)) then
            begin
                Exit;
            end;

            for syllable_idx_local := start_idx to start_idx + span_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    direct_top_syllables_local[syllable_idx_local].text);
            end;
        end;

        function get_direct_top_exact_span_weight_local(const start_idx: Integer;
            const span_len: Integer; const span_text: string): Integer;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            weight_local: Integer;
        begin
            Result := 0;
            if (span_text = '') or (span_len < 2) or (m_dictionary = nil) then
            begin
                Exit;
            end;

            query_key_local := build_direct_top_query_key_local(start_idx,
                span_len);
            if (query_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                if not SameText(Trim(exact_results_local[exact_idx_local].text),
                    span_text) then
                begin
                    Continue;
                end;

                weight_local := exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight >
                    weight_local) then
                begin
                    weight_local := exact_results_local[exact_idx_local].dict_weight;
                end;
                if weight_local > Result then
                begin
                    Result := weight_local;
                end;
            end;
        end;

        function candidate_rewrites_direct_top_exact_span_local(
            const candidate_text: string): Boolean;
        const
            c_min_protected_exact_span_weight = 700;
            c_max_protected_exact_span_units = 6;
        var
            direct_units_local: TArray<string>;
            candidate_units_local: TArray<string>;
            start_idx_local: Integer;
            span_len_local: Integer;
            unit_idx_local: Integer;
            direct_span_text_local: string;
            candidate_span_text_local: string;
        begin
            Result := False;
            if (not direct_top_valid_local) or (candidate_text = '') or
                SameText(candidate_text, direct_top_text_local) then
            begin
                Exit;
            end;

            direct_units_local := split_text_units(direct_top_text_local);
            candidate_units_local := split_text_units(candidate_text);
            if (Length(direct_units_local) <> input_syllable_count) or
                (Length(candidate_units_local) <> input_syllable_count) then
            begin
                Exit;
            end;

            for start_idx_local := 0 to input_syllable_count - 1 do
            begin
                for span_len_local := 2 to Min(c_max_protected_exact_span_units,
                    input_syllable_count - start_idx_local) do
                begin
                    direct_span_text_local := '';
                    candidate_span_text_local := '';
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        direct_span_text_local := direct_span_text_local +
                            direct_units_local[unit_idx_local];
                        candidate_span_text_local := candidate_span_text_local +
                            candidate_units_local[unit_idx_local];
                    end;

                    if SameText(direct_span_text_local,
                        candidate_span_text_local) then
                    begin
                        Continue;
                    end;

                    if get_direct_top_exact_span_weight_local(start_idx_local,
                        span_len_local, direct_span_text_local) >=
                        c_min_protected_exact_span_weight then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        procedure restore_direct_top_candidate_local;
        var
            idx_local: Integer;
            existing_idx_local: Integer;
        begin
            if not direct_top_valid_local then
            begin
                Exit;
            end;

            existing_idx_local := -1;
            for idx_local := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[idx_local].comment) =
                    Trim(direct_top_candidate_local.comment)) and
                    SameText(Trim(m_candidates[idx_local].text),
                    direct_top_text_local) then
                begin
                    existing_idx_local := idx_local;
                    Break;
                end;
            end;

            if existing_idx_local = 0 then
            begin
                Exit;
            end;

            if existing_idx_local > 0 then
            begin
                direct_top_candidate_local := m_candidates[existing_idx_local];
                for idx_local := existing_idx_local downto 1 do
                begin
                    m_candidates[idx_local] := m_candidates[idx_local - 1];
                end;
                m_candidates[0] := direct_top_candidate_local;
            end
            else
            begin
                SetLength(m_candidates, Length(m_candidates) + 1);
                for idx_local := High(m_candidates) downto 1 do
                begin
                    m_candidates[idx_local] := m_candidates[idx_local - 1];
                end;
                m_candidates[0] := direct_top_candidate_local;
            end;
        end;

        function can_use_lightweight_long_direct_finalize_local: Boolean;
        var
            direct_path_local: string;
        begin
            Result := False;
            if (not direct_top_valid_local) or (input_syllable_count < 9) or
                all_initial_compact_query or has_internal_dangling_initial then
            begin
                Exit;
            end;

            direct_path_local := get_segment_path_for_candidate(
                direct_top_candidate_local);
            Result := get_encoded_path_segment_count_local(direct_path_local) > 1;
        end;

    begin
        if (Length(m_candidates) > 0) and
            (Trim(m_candidates[0].comment) <> '') then
        begin
            finalize_prefix_partial_candidates_and_prepare_exit(debug_extra,
                False);
            Exit;
        end;

        deduped_direct_candidate_count_local := 0;
        direct_top_valid_local := False;
        if (Length(m_candidates) > 0) and
            (Trim(m_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
            input_syllable_count) then
        begin
            direct_top_candidate_local := m_candidates[0];
            direct_top_text_local := Trim(m_candidates[0].text);
            direct_top_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            direct_top_valid_local :=
                Length(direct_top_syllables_local) = input_syllable_count;
        end;
        finalize_lookup_timing_info_lightweight_local;
        if can_use_lightweight_long_direct_finalize_local then
        begin
            dedupe_visible_candidates_local(m_candidates,
                deduped_direct_candidate_count_local);
            restore_direct_top_candidate_local;
            ensure_long_sentence_prefix_partial_visible(m_candidates,
                get_candidate_limit);
            ensure_complete_long_top_tail_partial_second_local;
            if Length(m_candidates) > get_total_candidate_limit then
            begin
                SetLength(m_candidates, get_total_candidate_limit);
            end;
            if m_config.debug_mode then
            begin
                m_last_lookup_debug_extra := debug_extra;
                if Length(m_candidates) > 0 then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                        get_candidate_debug_summary(m_candidates[0]);
                end;
                if m_last_full_path_debug_info <> '' then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                        m_last_full_path_debug_info;
                end;
                if deduped_direct_candidate_count_local > 0 then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                        Format(' dedupe=%d', [deduped_direct_candidate_count_local]);
                end;
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    ' directlite=1';
            end;
            refresh_candidate_segment_paths;
            m_visible_candidates_cache_valid := False;
            SetLength(m_visible_candidates_cache, 0);
            SetLength(m_visible_candidate_source_indices_cache, 0);
            note_ranked_top_candidate;
            m_page_index := 0;
            m_selected_index := 0;
            Exit;
        end;
        ensure_bounded_single_char_partial_pool(m_candidates);
        dedupe_visible_candidates_local(m_candidates,
            deduped_direct_candidate_count_local);
        ensure_top_complete_candidate_prefix_partials_visible(m_candidates);
        ensure_long_sentence_prefix_partial_visible(m_candidates,
            get_candidate_limit);
        promote_full_query_exact_complete_phrase_local(m_candidates);
        promote_short_unsupported_complete_prefix_partial(m_candidates);
        ensure_best_first_syllable_single_partial_visible(m_candidates, 2);
        filter_self_composed_complete_candidates_when_normal_complete_exists;
        promote_preferred_three_syllable_one_plus_two_partial_local(m_candidates);
        filter_explicit_apostrophe_output_complete_local(m_candidates);
        if (Length(m_candidates) > 0) and
            candidate_rewrites_direct_top_exact_span_local(
            Trim(m_candidates[0].text)) then
        begin
            restore_direct_top_candidate_local;
        end;
        finalize_modal_tail_sentence_candidate(m_candidates);
        dedupe_visible_candidates_local(m_candidates,
            deduped_direct_candidate_count_local);
        ensure_long_sentence_prefix_partial_visible(m_candidates,
            get_candidate_limit);
        ensure_complete_long_top_tail_partial_second_local;
        if m_config.debug_mode then
        begin
            m_last_lookup_debug_extra := debug_extra;
            if Length(m_candidates) > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                    get_candidate_debug_summary(m_candidates[0]);
            end;
            if m_last_full_path_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_full_path_debug_info;
            end;
            if deduped_direct_candidate_count_local > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' dedupe=%d', [deduped_direct_candidate_count_local]);
            end;
        end;
        refresh_candidate_segment_paths;
        m_visible_candidates_cache_valid := False;
        SetLength(m_visible_candidates_cache, 0);
        SetLength(m_visible_candidate_source_indices_cache, 0);
        note_ranked_top_candidate;
        m_page_index := 0;
        m_selected_index := 0;
    end;

    procedure finalize_fast_prefix_candidates_and_prepare_exit(
        const debug_extra: string);
    var
        candidate_idx_local: Integer;
        has_prefix_partial_candidate_local: Boolean;
    begin
        has_prefix_partial_candidate_local := False;
        for candidate_idx_local := 0 to High(m_candidates) do
        begin
            if Trim(m_candidates[candidate_idx_local].comment) <> '' then
            begin
                has_prefix_partial_candidate_local := True;
                Break;
            end;
        end;

        if has_prefix_partial_candidate_local then
        begin
            finalize_prefix_partial_candidates_and_prepare_exit(debug_extra,
                True);
            Exit;
        end;

        finalize_lookup_timing_info;
        filter_self_composed_complete_candidates_when_normal_complete_exists;
        promote_preferred_three_syllable_one_plus_two_partial_local(m_candidates);
        filter_explicit_apostrophe_output_complete_local(m_candidates);
        if m_config.debug_mode then
        begin
            m_last_lookup_debug_extra := debug_extra;
            if m_last_three_syllable_partial_preference_kind > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' b3pref=%d',
                    [m_last_three_syllable_partial_preference_kind]);
            end;
            if m_last_three_syllable_partial_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_three_syllable_partial_debug_info;
            end;
            if Length(m_candidates) > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                    get_candidate_debug_summary(m_candidates[0]);
            end;
            if m_last_full_path_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_full_path_debug_info;
            end;
        end;
        refresh_candidate_segment_paths;
        note_ranked_top_candidate;
        m_page_index := 0;
        m_selected_index := 0;
    end;

    procedure finalize_all_initial_compact_candidates_and_prepare_exit(
        const debug_extra: string);
    const
        c_max_all_initial_visible_candidates = 36;
    var
        deduped_count_local: Integer;
        total_elapsed_ms_local: Int64;
    begin
        m_last_lookup_all_initial_fast := True;
        total_elapsed_ms_local := Int64(GetTickCount64 - total_start_tick);
        m_last_lookup_timing_info := Format(
            'perf=[lk=%d seg=%d path=%d rt=%d post=%d sort=%d cache=%d/%d total=%d]',
            [lookup_elapsed_ms, segment_elapsed_ms, path_search_elapsed_ms,
            runtime_elapsed_ms, post_elapsed_ms, sort_elapsed_ms,
            lookup_cache_hits, lookup_cache_misses, total_elapsed_ms_local]);
        dedupe_visible_candidates_local(m_candidates, deduped_count_local);
        if Length(m_candidates) > c_max_all_initial_visible_candidates then
        begin
            SetLength(m_candidates, c_max_all_initial_visible_candidates);
        end;
        if Length(m_candidate_segment_paths) > Length(m_candidates) then
        begin
            SetLength(m_candidate_segment_paths, Length(m_candidates));
        end;

        if m_config.debug_mode then
        begin
            m_last_lookup_debug_extra := debug_extra;
            if Length(m_candidates) > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                    get_candidate_debug_summary(m_candidates[0]);
            end;
            if deduped_count_local > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' dedupe=%d', [deduped_count_local]);
            end;
        end;
        refresh_candidate_segment_paths;
        note_ranked_top_candidate;
        m_page_index := 0;
        m_selected_index := 0;
    end;

    function try_finalize_fast_prefix_candidates_and_prepare_exit_local(
        const debug_extra: string): Boolean;
    begin
        if (Length(m_candidates) > 0) and
            (Trim(m_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
            input_syllable_count) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' fpfast=[defer-complete]';
            end;
            Exit(False);
        end;

        if (Length(m_candidates) > 0) and
            (Trim(m_candidates[0].comment) <> '') and
            (not is_full_pinyin_key(lookup_text)) and
            has_safe_trailing_initial_typing_state then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' fpfast=[preserve-partial]';
            end;
            finalize_preserved_candidates_and_prepare_exit(debug_extra,
                m_candidates[0], False);
            Exit(True);
        end;

        finalize_fast_prefix_candidates_and_prepare_exit(debug_extra);
        Exit(True);
    end;

    procedure finalize_preserved_candidates_and_prepare_exit(
        const debug_extra: string; const preserved_top: TncCandidate;
        const allow_exact_span_repair: Boolean = True);
    var
        top_to_preserve: TncCandidate;
        total_elapsed_ms: Int64;
        preserved_phase_start_tick: UInt64;
        deduped_preserved_candidate_count: Integer;
        preserved_lite_skip_debug_local: string;

        procedure note_preserved_phase_elapsed_local(const phase_name: string;
            const started_at: UInt64);
        var
            elapsed_local: UInt64;
        begin
            if not m_config.debug_mode then
            begin
                Exit;
            end;
            elapsed_local := GetTickCount64 - started_at;
            if elapsed_local > 0 then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' %s=%d', [phase_name, elapsed_local]);
            end;
        end;

        function can_use_trailing_prefix_preserved_fast_finalize_local: Boolean;
        var
            trailing_syllables_local: TncPinyinParseResult;
            last_trailing_text_local: string;
        begin
            Result := False;
            if (input_syllable_count < 9) or all_initial_compact_query or
                has_internal_dangling_initial then
            begin
                Exit;
            end;

            if input_syllable_count = 9 then
            begin
                trailing_syllables_local :=
                    get_effective_compact_pinyin_syllables(lookup_text);
                if Length(trailing_syllables_local) <= 0 then
                begin
                    Exit;
                end;
                last_trailing_text_local := Trim(
                    trailing_syllables_local[High(trailing_syllables_local)].text);
                if SameText(last_trailing_text_local, 'q') then
                begin
                    Exit;
                end;
            end;

            Result := has_extendable_trailing_prefix_query_text(lookup_text);
        end;

        function top_complete_path_has_only_multi_segments_local: Boolean;
        var
            top_text_local: string;
            encoded_path_local: string;
            segment_parts_local: TArray<string>;
            part_idx_local: Integer;
        begin
            Result := False;
            if Length(m_candidates) = 0 then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (Trim(m_candidates[0].comment) <> '') or
                (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            encoded_path_local := get_segment_path_for_candidate(
                m_candidates[0], 0);
            if get_encoded_path_segment_count_local(encoded_path_local) <= 1 then
            begin
                Exit;
            end;

            segment_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            for part_idx_local := 0 to High(segment_parts_local) do
            begin
                if get_candidate_text_unit_count(
                    Trim(segment_parts_local[part_idx_local])) < 2 then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function top_complete_path_is_backed_local: Boolean;
        var
            top_text_local: string;
            encoded_path_local: string;
        begin
            Result := False;
            if Length(m_candidates) = 0 then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (Trim(m_candidates[0].comment) <> '') or
                (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            encoded_path_local := get_segment_path_for_candidate(
                m_candidates[0], 0);
            Result := get_encoded_path_segment_count_local(encoded_path_local) > 1;
        end;

        function top_complete_is_exact_query_local: Boolean;
        var
            top_text_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
        begin
            Result := False;
            if (m_dictionary = nil) or (lookup_text = '') or
                (Length(m_candidates) = 0) then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (Trim(m_candidates[0].comment) <> '') or
                (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if m_dictionary.is_base_entry(lookup_text, top_text_local) then
            begin
                Exit(True);
            end;

            if not m_dictionary.lookup_exact_full_pinyin(lookup_text,
                exact_results_local) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_idx_local].text),
                    top_text_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_close_complete_alternative_for_quality_repair_local: Boolean;
        const
            c_close_complete_score_gap = 5200;
        var
            top_text_local: string;
            alt_text_local: string;
            top_score_local: Integer;
            alt_score_local: Integer;
            alt_idx_local: Integer;
        begin
            Result := False;
            if (Length(m_candidates) < 2) or (input_syllable_count < 7) then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (Trim(m_candidates[0].comment) <> '') or
                (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            top_score_local := m_candidates[0].score;
            if m_candidates[0].has_dict_weight and
                (m_candidates[0].dict_weight > top_score_local) then
            begin
                top_score_local := m_candidates[0].dict_weight;
            end;

            for alt_idx_local := 1 to Min(4, High(m_candidates)) do
            begin
                alt_text_local := Trim(m_candidates[alt_idx_local].text);
                if (Trim(m_candidates[alt_idx_local].comment) <> '') or
                    (alt_text_local = '') or SameText(alt_text_local,
                    top_text_local) or
                    (get_candidate_text_unit_count(alt_text_local) <>
                    input_syllable_count) then
                begin
                    Continue;
                end;

                alt_score_local := m_candidates[alt_idx_local].score;
                if m_candidates[alt_idx_local].has_dict_weight and
                    (m_candidates[alt_idx_local].dict_weight > alt_score_local) then
                begin
                    alt_score_local := m_candidates[alt_idx_local].dict_weight;
                end;

                if top_score_local - alt_score_local <= c_close_complete_score_gap then
                begin
                    Exit(True);
                end;
            end;
        end;

        function can_skip_preserved_quality_repair_local: Boolean;
        var
            preserved_text_local: string;
        begin
            Result := False;
            if allow_exact_span_repair or all_initial_compact_query or
                has_internal_dangling_initial then
            begin
                Exit;
            end;

            if input_syllable_count >= 7 then
            begin
                Exit(not has_close_complete_alternative_for_quality_repair_local);
            end;

            if (input_syllable_count <= 6) and
                (top_complete_path_is_backed_local or
                top_complete_path_has_only_multi_segments_local or
                top_complete_is_exact_query_local) then
            begin
                Exit(True);
            end;

            preserved_text_local := Trim(top_to_preserve.text);
            Result := (input_syllable_count >= 5) and
                (top_complete_path_is_backed_local or
                (not is_full_pinyin_key(lookup_text)) or
                has_extendable_trailing_prefix_query_text(lookup_text) or
                has_raw_safe_trailing_initial_typing_state or
                ((preserved_text_local <> '') and
                (get_candidate_text_unit_count(preserved_text_local) <
                input_syllable_count)));
        end;

        function can_skip_preserved_exact_cluster_repair_local: Boolean;
        var
            preserved_text_local: string;
        begin
            preserved_text_local := Trim(top_to_preserve.text);
            Result := (not allow_exact_span_repair) and
                (input_syllable_count <= 3) and
                (Pos('short312head=1', debug_extra) > 0);
            if Result then
            begin
                Exit;
            end;

            Result := (not allow_exact_span_repair) and
                (input_syllable_count >= 7) and
                (not all_initial_compact_query) and
                (not has_internal_dangling_initial);
            if Result then
            begin
                Exit;
            end;

            Result := (not allow_exact_span_repair) and
                (input_syllable_count >= 4) and
                (not all_initial_compact_query) and
                (not has_internal_dangling_initial) and
                (top_complete_path_is_backed_local or
                ((preserved_text_local <> '') and
                (get_candidate_text_unit_count(preserved_text_local) <
                input_syllable_count)));
            if Result then
            begin
                Exit;
            end;

            Result := (not allow_exact_span_repair) and
                (input_syllable_count >= 5) and
                (not all_initial_compact_query) and
                (not has_internal_dangling_initial) and
                (top_complete_path_is_backed_local or
                (not is_full_pinyin_key(lookup_text)) or
                has_extendable_trailing_prefix_query_text(lookup_text) or
                has_raw_safe_trailing_initial_typing_state or
                ((preserved_text_local <> '') and
                (get_candidate_text_unit_count(preserved_text_local) <
                input_syllable_count)));
        end;

        function try_complete_preserved_single_syllable_tail(
            const seed_candidate: TncCandidate; out out_candidate: TncCandidate): Boolean;
        const
            c_tail_probe_limit = 18;
        var
            tail_key: string;
            tail_results: TncCandidateList;
            tail_idx: Integer;
            tail_text: string;
            tail_score: Integer;
            best_text: string;
            best_score: Integer;
            is_preferred: Boolean;
            candidate_path: string;
            seed_units: Integer;
            seed_base_score: Integer;

            function can_complete_tail_key_local(const value: string): Boolean;
            begin
                Result := SameText(value, 'wo') or SameText(value, 'he') or
                    SameText(value, 'yi') or SameText(value, 'yu') or
                    SameText(value, 'you') or SameText(value, 'yao') or
                    SameText(value, 'shi') or SameText(value, 'zai') or
                    SameText(value, 'bu') or SameText(value, 'le') or
                    SameText(value, 'hai') or SameText(value, 'hen') or
                    SameText(value, 'hui') or SameText(value, 'neng') or
                    SameText(value, 'qu') or SameText(value, 'lai') or
                    SameText(value, 'gei') or SameText(value, 'de') or
                    SameText(value, 'ba') or SameText(value, 'ma') or
                    SameText(value, 'ne') or SameText(value, 'a') or
                    SameText(value, 'ya') or SameText(value, 'la');
            end;

            function is_short_particle_tail_key_local(const value: string): Boolean;
            begin
                Result := SameText(value, 'de') or SameText(value, 'le') or
                    SameText(value, 'ba') or SameText(value, 'ma') or
                    SameText(value, 'la') or SameText(value, 'a');
            end;

            function derived_particle_tail_score_local(const base_score: Integer): Integer;
            const
                c_particle_tail_min_head_score = 80;
                c_particle_tail_visible_bonus = 160;
                c_particle_tail_unit_bonus = 24;
                c_particle_tail_weak_bonus = 8;
            begin
                Result := base_score;
                if Result < 0 then
                begin
                    Result := 0;
                end;
                if Result < c_particle_tail_min_head_score then
                begin
                    Inc(Result, c_particle_tail_weak_bonus);
                    Exit;
                end;

                Inc(Result, c_particle_tail_visible_bonus +
                    (seed_units * c_particle_tail_unit_bonus));
            end;
        begin
            Result := False;
            out_candidate := seed_candidate;
            tail_key := normalize_pinyin_text(Trim(seed_candidate.comment));
            seed_units := get_candidate_text_unit_count(Trim(seed_candidate.text));
            if (Trim(seed_candidate.text) = '') or (tail_key = '') or
                (not is_full_pinyin_key(tail_key)) or
                (get_effective_compact_pinyin_unit_count(tail_key) <> 1) or
                (not can_complete_tail_key_local(tail_key)) or
                (seed_units <> input_syllable_count - 1) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            if not m_dictionary.lookup_exact_full_pinyin(tail_key, tail_results) then
            begin
                Exit;
            end;

            best_text := '';
            best_score := Low(Integer);
            for tail_idx := 0 to High(tail_results) do
            begin
                if tail_idx >= c_tail_probe_limit then
                begin
                    Break;
                end;
                tail_text := Trim(tail_results[tail_idx].text);
                if (get_candidate_text_unit_count(tail_text) <> 1) or
                    (not match_single_char_candidate_for_syllable(
                    tail_key, tail_text, is_preferred)) then
                begin
                    Continue;
                end;

                tail_score := tail_results[tail_idx].score;
                if tail_results[tail_idx].has_dict_weight and
                    (tail_results[tail_idx].dict_weight > tail_score) then
                begin
                    tail_score := tail_results[tail_idx].dict_weight;
                end;
                if is_preferred then
                begin
                    Inc(tail_score, 90);
                end;
                if tail_score > best_score then
                begin
                    best_score := tail_score;
                    best_text := tail_text;
                end;
            end;

            if best_text = '' then
            begin
                Exit;
            end;

            out_candidate.text := Trim(seed_candidate.text) + best_text;
            out_candidate.comment := '';
            seed_base_score := seed_candidate.score;
            if seed_candidate.has_dict_weight and
                (seed_candidate.dict_weight > 0) then
            begin
                seed_base_score := seed_candidate.dict_weight;
            end;
            if is_short_particle_tail_key_local(tail_key) then
            begin
                out_candidate.score :=
                    derived_particle_tail_score_local(seed_base_score);
                out_candidate.has_dict_weight := seed_candidate.has_dict_weight;
                out_candidate.dict_weight := seed_base_score;
            end
            else
            begin
                out_candidate.score := seed_candidate.score + 880;
                out_candidate.has_dict_weight := seed_candidate.has_dict_weight;
                out_candidate.dict_weight := seed_base_score;
            end;

            candidate_path := get_segment_path_for_candidate(seed_candidate);
            if candidate_path <> '' then
            begin
                candidate_path := candidate_path + c_segment_path_separator +
                    best_text;
            end
            else
            begin
                candidate_path := Trim(seed_candidate.text) +
                    c_segment_path_separator + best_text;
            end;
            remember_segment_path_for_candidate(out_candidate.text, '',
                candidate_path, out_candidate.score);
            Result := True;
    end;

        procedure ensure_preserved_dangling_initial_variants_visible(
            var candidates: TncCandidateList; const seed_candidate: TncCandidate);
        var
            tail_key: string;
            prefix_candidate: TncCandidate;
            partial_candidate: TncCandidate;
            predicted_candidate: TncCandidate;
            predicted_text: string;
            seed_text: string;
            candidate_path: string;
            seed_units: Integer;
            prefix_index: Integer;

            function is_single_initial_fragment_local(const value: string): Boolean;
            begin
                Result := (Length(value) = 1) and
                    CharInSet(value[1], ['b', 'p', 'm', 'f', 'd', 't', 'n',
                    'l', 'g', 'k', 'h', 'j', 'q', 'x', 'z', 'c', 's', 'r',
                    'y', 'w']);
            end;

            function get_common_initial_prediction_local(
                const value: string): string;
            begin
                Result := '';
                if SameText(value, 'w') then
                begin
                    Result := string(Char($6211));
                end
                else if SameText(value, 'h') then
                begin
                    Result := string(Char($548C));
                end
                else if SameText(value, 'q') then
                begin
                    Result := string(Char($53BB));
                end
                else if SameText(value, 'y') then
                begin
                    Result := string(Char($4E00));
                end;
            end;

            function has_candidate_local(const candidate_text: string;
                const candidate_comment: string): Boolean;
            var
                local_idx: Integer;
            begin
                Result := False;
                for local_idx := 0 to High(candidates) do
                begin
                    if SameText(Trim(candidates[local_idx].text), candidate_text) and
                        SameText(Trim(candidates[local_idx].comment),
                        candidate_comment) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function find_candidate_index_local(const candidate_text: string;
                const candidate_comment: string): Integer;
            var
                local_idx: Integer;
            begin
                Result := -1;
                for local_idx := 0 to High(candidates) do
                begin
                    if SameText(Trim(candidates[local_idx].text), candidate_text) and
                        SameText(Trim(candidates[local_idx].comment),
                        candidate_comment) then
                    begin
                        Exit(local_idx);
                    end;
                end;
            end;

            procedure insert_candidate_local(const candidate: TncCandidate;
                const target_index: Integer);
            var
                local_target: Integer;
                move_idx: Integer;
            begin
                local_target := target_index;
                if local_target < 0 then
                begin
                    local_target := 0;
                end;
                if local_target > Length(candidates) then
                begin
                    local_target := Length(candidates);
                end;

                SetLength(candidates, Length(candidates) + 1);
                for move_idx := High(candidates) downto local_target + 1 do
                begin
                    candidates[move_idx] := candidates[move_idx - 1];
                end;
                candidates[local_target] := candidate;
            end;

            procedure move_candidate_local(const candidate_index: Integer;
                const target_index: Integer);
            var
                local_target: Integer;
                move_idx: Integer;
                picked_candidate: TncCandidate;
            begin
                if (candidate_index < 0) or
                    (candidate_index > High(candidates)) then
                begin
                    Exit;
                end;
                local_target := target_index;
                if local_target < 0 then
                begin
                    local_target := 0;
                end;
                if local_target > High(candidates) then
                begin
                    local_target := High(candidates);
                end;
                if candidate_index = local_target then
                begin
                    Exit;
                end;

                picked_candidate := candidates[candidate_index];
                if candidate_index > local_target then
                begin
                    for move_idx := candidate_index downto local_target + 1 do
                    begin
                        candidates[move_idx] := candidates[move_idx - 1];
                    end;
                end
                else
                begin
                    for move_idx := candidate_index to local_target - 1 do
                    begin
                        candidates[move_idx] := candidates[move_idx + 1];
                    end;
                end;
                candidates[local_target] := picked_candidate;
            end;

        begin
            tail_key := normalize_pinyin_text(Trim(seed_candidate.comment));
            seed_text := Trim(seed_candidate.text);
            seed_units := get_candidate_text_unit_count(seed_text);
            if (Length(candidates) = 0) or (seed_text = '') or
                (not is_single_initial_fragment_local(tail_key)) or
                (seed_units <= 0) or (seed_units > input_syllable_count) then
            begin
                Exit;
            end;

            prefix_index := find_candidate_index_local(seed_text, '');
            if prefix_index >= 0 then
            begin
                if seed_units >= 3 then
                begin
                    move_candidate_local(prefix_index, 0);
                end;
            end
            else
            begin
                prefix_candidate := seed_candidate;
                prefix_candidate.comment := '';
                prefix_candidate.score := seed_candidate.score - 1;
                if seed_units >= 3 then
                begin
                    prefix_candidate.score := seed_candidate.score + 1;
                    insert_candidate_local(prefix_candidate, 0);
                end
                else
                begin
                    insert_candidate_local(prefix_candidate, 1);
                end;
            end;

            prefix_index := find_candidate_index_local(seed_text, tail_key);
            if prefix_index >= 0 then
            begin
                if seed_units >= 6 then
                begin
                    move_candidate_local(prefix_index, 0);
                end
                else
                begin
                    move_candidate_local(prefix_index, Min(1, High(candidates)));
                end;
            end
            else
            begin
                partial_candidate := seed_candidate;
                if seed_units >= 6 then
                begin
                    insert_candidate_local(partial_candidate, 0);
                end
                else
                begin
                    insert_candidate_local(partial_candidate,
                        Min(1, Length(candidates)));
                end;
            end;

            predicted_text := get_common_initial_prediction_local(tail_key);
            if (predicted_text = '') or
                (seed_units + 1 <> input_syllable_count) or
                has_candidate_local(seed_text + predicted_text, '') then
            begin
                Exit;
            end;

            predicted_candidate := seed_candidate;
            predicted_candidate.text := seed_text + predicted_text;
            predicted_candidate.comment := '';
            predicted_candidate.score := seed_candidate.score - 2;
            predicted_candidate.has_dict_weight := True;
            predicted_candidate.dict_weight := predicted_candidate.score;
            candidate_path := get_segment_path_for_candidate(seed_candidate);
            if candidate_path <> '' then
            begin
                candidate_path := candidate_path + c_segment_path_separator +
                    predicted_text;
            end
            else
            begin
                candidate_path := seed_text + c_segment_path_separator +
                    predicted_text;
            end;
            remember_segment_path_for_candidate(predicted_candidate.text, '',
                candidate_path, predicted_candidate.score);
            insert_candidate_local(predicted_candidate, Min(2, Length(candidates)));
        end;

        function can_use_lightweight_preserved_sort_local: Boolean;
        begin
            Result := False;
            preserved_lite_skip_debug_local := '';
            if input_syllable_count < 7 then
            begin
                if (input_syllable_count >= 3) and
                    (not allow_exact_span_repair) then
                begin
                    Exit(True);
                end;
                if (input_syllable_count >= 3) and
                    (top_complete_path_is_backed_local or
                    top_complete_is_exact_query_local) then
                begin
                    Exit(True);
                end;
                preserved_lite_skip_debug_local := Format(' pslite_skip=short%d',
                    [input_syllable_count]);
                Exit;
            end;

            Result := Length(m_candidates) > 0;
            if not Result then
            begin
                preserved_lite_skip_debug_local := ' pslite_skip=empty';
            end;
        end;

        function preserved_candidate_effective_score_local(
            const candidate_local: TncCandidate): Integer;
        begin
            Result := candidate_local.score;
            if candidate_local.has_dict_weight and
                (candidate_local.dict_weight > Result) then
            begin
                Result := candidate_local.dict_weight;
            end;
            if candidate_local.source = cs_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
        end;

        function can_skip_high_confidence_preserved_sort_local: Boolean;
        begin
            Result := (not allow_exact_span_repair) and
                (input_syllable_count >= 5) and
                (Length(m_candidates) > 0) and
                top_complete_path_is_backed_local and
                (preserved_candidate_effective_score_local(top_to_preserve) >=
                50000);
        end;

        procedure restore_strong_pathful_preserved_top_local;
        const
            c_preserved_top_min_gap = -8000;
        var
            preserved_text_local: string;
            preserved_comment_local: string;
            preserved_path_local: string;
            preserved_score_local: Integer;
            current_score_local: Integer;
            candidate_idx_local: Integer;
            move_idx_local: Integer;
            moved_candidate_local: TncCandidate;
            moved_path_local: string;

            function preserved_path_has_visible_better_segment_local(
                const current_top_text_local: string): Boolean;
            const
                c_probe_limit = 6;
            var
                parser_local: TncPinyinParser;
                syllables_local: TncPinyinParseResult;
                path_segments_local: TArray<string>;
                segment_idx_local: Integer;
                segment_text_local: string;
                segment_units_local: Integer;
                syllable_pos_local: Integer;
                key_idx_local: Integer;
                segment_key_local: string;
                ranked_results_local: TncCandidateList;
                ranked_idx_local: Integer;
                ranked_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (lookup_text = '') or
                    (current_top_text_local = '') or
                    (SameText(current_top_text_local, preserved_text_local)) or
                    (top_to_preserve.source = cs_user) or
                    is_latest_session_query_choice(preserved_text_local) or
                    m_dictionary.is_base_entry(lookup_text,
                    preserved_text_local) or
                    (m_dictionary.get_query_choice_bonus(lookup_text,
                    preserved_text_local) > 0) then
                begin
                    Exit;
                end;

                path_segments_local := preserved_path_local.Split(
                    [c_segment_path_separator]);
                if Length(path_segments_local) <= 1 then
                begin
                    Exit;
                end;

                parser_local := TncPinyinParser.Create;
                try
                    syllables_local := parser_local.parse(lookup_text);
                finally
                    parser_local.Free;
                end;
                if Length(syllables_local) <> input_syllable_count then
                begin
                    Exit;
                end;

                syllable_pos_local := 0;
                for segment_idx_local := 0 to High(path_segments_local) do
                begin
                    segment_text_local := Trim(path_segments_local[segment_idx_local]);
                    segment_units_local := get_candidate_text_unit_count(
                        segment_text_local);
                    if (segment_text_local = '') or (segment_units_local <= 0) or
                        (syllable_pos_local + segment_units_local >
                        Length(syllables_local)) then
                    begin
                        Exit;
                    end;

                    if segment_units_local >= 2 then
                    begin
                        segment_key_local := '';
                        for key_idx_local := syllable_pos_local to
                            syllable_pos_local + segment_units_local - 1 do
                        begin
                            segment_key_local := segment_key_local +
                                normalize_pinyin_text(
                                syllables_local[key_idx_local].text);
                        end;

                        if (segment_key_local <> '') and
                            m_dictionary.lookup(segment_key_local,
                            ranked_results_local) then
                        begin
                            for ranked_idx_local := 0 to
                                Min(High(ranked_results_local),
                                c_probe_limit - 1) do
                            begin
                                ranked_text_local := Trim(
                                    ranked_results_local[ranked_idx_local].text);
                                if (Trim(ranked_results_local[ranked_idx_local].comment) <> '') or
                                    (ranked_text_local = '') or
                                    (get_candidate_text_unit_count(
                                    ranked_text_local) <> segment_units_local) then
                                begin
                                    Continue;
                                end;

                                if not SameText(ranked_text_local,
                                    segment_text_local) then
                                begin
                                    Exit(True);
                                end;
                                Break;
                            end;
                        end;
                    end;

                    Inc(syllable_pos_local, segment_units_local);
                end;
            end;
        begin
            preserved_text_local := Trim(top_to_preserve.text);
            preserved_comment_local := Trim(top_to_preserve.comment);
            if (preserved_text_local = '') or
                (preserved_comment_local <> '') or
                (get_candidate_text_unit_count(preserved_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            preserved_path_local := get_segment_path_for_candidate(
                top_to_preserve);
            if get_encoded_path_segment_count_local(preserved_path_local) <= 1 then
            begin
                Exit;
            end;

            preserved_score_local := preserved_candidate_effective_score_local(
                top_to_preserve);
            if Length(m_candidates) > 0 then
            begin
                current_score_local := preserved_candidate_effective_score_local(
                    m_candidates[0]);
                if SameText(Trim(m_candidates[0].text), preserved_text_local) and
                    SameText(Trim(m_candidates[0].comment),
                    preserved_comment_local) then
                begin
                    Exit;
                end;
                if preserved_score_local < current_score_local +
                    c_preserved_top_min_gap then
                begin
                    Exit;
                end;
                if (Trim(m_candidates[0].comment) = '') and
                    (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
                    input_syllable_count) and
                    preserved_path_has_visible_better_segment_local(
                    Trim(m_candidates[0].text)) then
                begin
                    Exit;
                end;
            end;

            candidate_idx_local := -1;
            for move_idx_local := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[move_idx_local].text),
                    preserved_text_local) and
                    SameText(Trim(m_candidates[move_idx_local].comment),
                    preserved_comment_local) then
                begin
                    candidate_idx_local := move_idx_local;
                    Break;
                end;
            end;

            if candidate_idx_local < 0 then
            begin
                SetLength(m_candidates, Length(m_candidates) + 1);
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths, Length(m_candidates));
                end;
                for move_idx_local := High(m_candidates) downto 1 do
                begin
                    m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
                    if move_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[move_idx_local] :=
                            m_candidate_segment_paths[move_idx_local - 1];
                    end;
                end;
                m_candidates[0] := top_to_preserve;
                if Length(m_candidate_segment_paths) > 0 then
                begin
                    m_candidate_segment_paths[0] := preserved_path_local;
                end;
                Exit;
            end;

            if candidate_idx_local = 0 then
            begin
                Exit;
            end;

            moved_candidate_local := m_candidates[candidate_idx_local];
            moved_path_local := '';
            if candidate_idx_local < Length(m_candidate_segment_paths) then
            begin
                moved_path_local := m_candidate_segment_paths[candidate_idx_local];
            end;
            if moved_path_local = '' then
            begin
                moved_path_local := preserved_path_local;
            end;

            for move_idx_local := candidate_idx_local downto 1 do
            begin
                m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
                if move_idx_local < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx_local] :=
                        m_candidate_segment_paths[move_idx_local - 1];
                end;
            end;
            m_candidates[0] := moved_candidate_local;
            if Length(m_candidate_segment_paths) > 0 then
            begin
                m_candidate_segment_paths[0] := moved_path_local;
            end;
        end;

        procedure promote_higher_scored_complete_after_preserved_local;
        const
            c_probe_limit = 6;
            c_min_score_gain = 12000;
        var
            best_idx_local: Integer;
            best_score_local: Integer;
            candidate_idx_local: Integer;
            candidate_score_local: Integer;
            move_idx_local: Integer;
            moved_candidate_local: TncCandidate;
            moved_path_local: string;

            function is_complete_candidate_local(
                const candidate_local: TncCandidate): Boolean;
            begin
                Result := (Trim(candidate_local.comment) = '') and
                    (get_candidate_text_unit_count(Trim(candidate_local.text)) =
                    input_syllable_count);
            end;
        begin
            if (not allow_exact_span_repair) or (input_syllable_count < 6) or
                (Length(m_candidates) < 2) or (top_to_preserve.source = cs_user) or
                (not is_complete_candidate_local(m_candidates[0])) then
            begin
                Exit;
            end;

            best_idx_local := 0;
            best_score_local := preserved_candidate_effective_score_local(
                m_candidates[0]);
            for candidate_idx_local := 1 to Min(c_probe_limit - 1,
                High(m_candidates)) do
            begin
                if not is_complete_candidate_local(
                    m_candidates[candidate_idx_local]) then
                begin
                    Continue;
                end;

                candidate_score_local := preserved_candidate_effective_score_local(
                    m_candidates[candidate_idx_local]);
                if candidate_score_local > best_score_local then
                begin
                    best_score_local := candidate_score_local;
                    best_idx_local := candidate_idx_local;
                end;
            end;

            if (best_idx_local <= 0) or
                (best_score_local < preserved_candidate_effective_score_local(
                m_candidates[0]) + c_min_score_gain) then
            begin
                Exit;
            end;

            if Length(m_candidate_segment_paths) < Length(m_candidates) then
            begin
                SetLength(m_candidate_segment_paths, Length(m_candidates));
            end;

            moved_candidate_local := m_candidates[best_idx_local];
            moved_path_local := '';
            if best_idx_local < Length(m_candidate_segment_paths) then
            begin
                moved_path_local := m_candidate_segment_paths[best_idx_local];
            end;

            for move_idx_local := best_idx_local downto 1 do
            begin
                m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
                if move_idx_local < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx_local] :=
                        m_candidate_segment_paths[move_idx_local - 1];
                end;
            end;

            m_candidates[0] := moved_candidate_local;
            if Length(m_candidate_segment_paths) > 0 then
            begin
                m_candidate_segment_paths[0] := moved_path_local;
            end;
        end;

    begin
        top_to_preserve := preserved_top;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' [ps-tail]';
        end;
        preserved_phase_start_tick := GetTickCount64;
        try_complete_preserved_single_syllable_tail(preserved_top, top_to_preserve);
        note_preserved_phase_elapsed_local('pstail1',
            preserved_phase_start_tick);
        if Length(m_candidates) = 0 then
        begin
            SetLength(m_candidates, 1);
        end;
        m_candidates[0] := top_to_preserve;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' [ps-dangling]';
        end;
        ensure_preserved_dangling_initial_variants_visible(m_candidates,
            top_to_preserve);
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' [ps-chain]';
        end;
        ensure_simple_fixed_boundary_chain_candidate_visible(m_candidates);
        ensure_supported_short_four_two_prefix_partial_visible_local(
            get_effective_compact_pinyin_syllables(lookup_text),
            m_candidates);
        if can_use_trailing_prefix_preserved_fast_finalize_local then
        begin
            dedupe_visible_candidates_local(m_candidates,
                deduped_preserved_candidate_count);
            ensure_bounded_single_char_partial_pool(m_candidates);
            ensure_top_complete_candidate_prefix_partials_visible(m_candidates);
            total_elapsed_ms := Int64(GetTickCount64 - total_start_tick);
            m_last_lookup_timing_info := Format(
                'perf=[lk=%d seg=%d path=%d rt=%d post=%d sort=%d cache=%d/%d total=%d]',
                [lookup_elapsed_ms, segment_elapsed_ms, path_search_elapsed_ms,
                runtime_elapsed_ms, post_elapsed_ms, sort_elapsed_ms,
                lookup_cache_hits, lookup_cache_misses, total_elapsed_ms]);
            if m_config.debug_mode then
            begin
                m_last_lookup_debug_extra := debug_extra + ' preservedtailfast=1';
                if Length(m_candidates) > 0 then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                        get_candidate_debug_summary(m_candidates[0]);
                end;
                if m_last_full_path_debug_info <> '' then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                        m_last_full_path_debug_info;
                end;
            end;
            refresh_candidate_segment_paths;
            m_visible_candidates_cache_valid := False;
            SetLength(m_visible_candidates_cache, 0);
            SetLength(m_visible_candidate_source_indices_cache, 0);
            note_ranked_top_candidate;
            m_page_index := 0;
            m_selected_index := 0;
            Exit;
        end;
        preserved_phase_start_tick := GetTickCount64;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' [ps123]';
        end;
        ensure_three_syllable_prefix_one_plus_two_complete_candidates_visible(
            m_candidates);
        note_preserved_phase_elapsed_local('ps123', preserved_phase_start_tick);
        preserved_phase_start_tick := GetTickCount64;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' [ps-fqfast]';
        end;
        ensure_reliable_full_query_exact_complete_candidate_fast_visible(
            m_candidates);
        note_preserved_phase_elapsed_local('psfqfast',
            preserved_phase_start_tick);
        preserved_phase_start_tick := GetTickCount64;
        filter_self_composed_complete_candidates_when_normal_complete_exists;
        note_preserved_phase_elapsed_local('psself',
            preserved_phase_start_tick);
        if allow_exact_span_repair then
        begin
            preserved_phase_start_tick := GetTickCount64;
            ensure_exact_span_rank_repair_candidate_visible(m_candidates);
            note_preserved_phase_elapsed_local('psexactspan',
                preserved_phase_start_tick);
        end;
        preserved_phase_start_tick := GetTickCount64;
        if not can_skip_preserved_exact_cluster_repair_local then
        begin
            ensure_short_full_query_exact_cluster_visible(m_candidates);
        end;
        note_preserved_phase_elapsed_local('psfqexact',
            preserved_phase_start_tick);
        dedupe_visible_candidates_local(m_candidates,
            deduped_preserved_candidate_count);
        preserved_phase_start_tick := GetTickCount64;
        if can_skip_high_confidence_preserved_sort_local then
        begin
            note_preserved_phase_elapsed_local('pssortskip',
                preserved_phase_start_tick);
        end
        else if can_use_lightweight_preserved_sort_local then
        begin
            sort_candidates_lightweight(m_candidates);
            if should_trim_strong_long_sentence_candidates_local(m_candidates) then
            begin
                trim_sorted_candidates_for_strong_long_sentence(m_candidates);
            end;
            note_preserved_phase_elapsed_local('pssortlite',
                preserved_phase_start_tick);
        end
        else
        begin
            sort_candidates(m_candidates);
            note_preserved_phase_elapsed_local('pssort',
                preserved_phase_start_tick);
        end;
        preserved_phase_start_tick := GetTickCount64;
        if not can_skip_preserved_exact_cluster_repair_local then
        begin
            ensure_short_full_query_exact_cluster_visible(m_candidates);
            ensure_multi_char_partial_precedes_single_char_partial(m_candidates);
        end;
        note_preserved_phase_elapsed_local('psfqexact2',
            preserved_phase_start_tick);
        preserved_phase_start_tick := GetTickCount64;
        refresh_candidate_segment_paths;
        note_preserved_phase_elapsed_local('psrefresh1',
            preserved_phase_start_tick);
        preserved_phase_start_tick := GetTickCount64;
        if ((input_syllable_count <= 3) and (not allow_exact_span_repair)) or
            can_skip_preserved_quality_repair_local then
        begin
            ensure_bounded_single_char_partial_pool(m_candidates);
            ensure_top_complete_candidate_prefix_partials_visible(m_candidates);
            ensure_best_first_syllable_single_partial_visible(m_candidates, 2);
            restore_strong_pathful_preserved_top_local;
            ensure_long_sentence_prefix_partial_visible(m_candidates,
                get_candidate_limit);
            note_preserved_phase_elapsed_local('psqualityskip',
                preserved_phase_start_tick);
        end
        else
        begin
            ensure_high_quality_complete_candidate_in_top2(m_candidates);
            ensure_short_full_query_exact_cluster_visible(m_candidates);
            ensure_bounded_single_char_partial_pool(m_candidates);
            ensure_top_complete_candidate_prefix_partials_visible(m_candidates);
            demote_low_evidence_admin_place_alias_top_local(m_candidates);
            promote_full_query_exact_complete_phrase_local(m_candidates);
            promote_short_unsupported_complete_prefix_partial(m_candidates);
            ensure_preserved_dangling_initial_variants_visible(m_candidates,
                top_to_preserve);
            ensure_best_first_syllable_single_partial_visible(m_candidates, 2);
            promote_preferred_three_syllable_one_plus_two_partial_local(m_candidates);
            restore_strong_pathful_preserved_top_local;
            ensure_long_sentence_prefix_partial_visible(m_candidates,
                get_candidate_limit);
            filter_self_composed_complete_candidates_when_normal_complete_exists;
            note_preserved_phase_elapsed_local('psquality',
                preserved_phase_start_tick);
        end;
        if build_fixed_wo_tail_dictionary_candidates(lookup_text,
            fixed_wo_tail_candidates) then
        begin
            m_candidates := merge_candidate_lists(fixed_wo_tail_candidates,
                m_candidates, 0);
            sort_candidates_lightweight(m_candidates);
            m_candidates[0] := top_to_preserve;
        end;
        if build_short_particle_tail_dictionary_candidates(lookup_text,
            short_particle_tail_candidates) then
        begin
            m_candidates := merge_candidate_lists(short_particle_tail_candidates,
                m_candidates, 0);
            sort_candidates_lightweight(m_candidates);
            m_candidates[0] := top_to_preserve;
        end;
        promote_higher_scored_complete_after_preserved_local;
        total_elapsed_ms := Int64(GetTickCount64 - total_start_tick);
        m_last_lookup_timing_info := Format(
            'perf=[lk=%d seg=%d path=%d rt=%d post=%d sort=%d cache=%d/%d total=%d]',
            [lookup_elapsed_ms, segment_elapsed_ms, path_search_elapsed_ms,
            runtime_elapsed_ms, post_elapsed_ms, sort_elapsed_ms,
            lookup_cache_hits, lookup_cache_misses, total_elapsed_ms]);
        if m_config.debug_mode then
        begin
            m_last_lookup_debug_extra := debug_extra;
            if preserved_lite_skip_debug_local <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    preserved_lite_skip_debug_local;
            end;
            if m_last_three_syllable_partial_preference_kind > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' b3pref=%d',
                    [m_last_three_syllable_partial_preference_kind]);
            end;
            if m_last_three_syllable_partial_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_three_syllable_partial_debug_info;
            end;
            if Length(m_candidates) > 0 then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ' +
                    get_candidate_debug_summary(m_candidates[0]);
            end;
            if m_last_full_path_debug_info <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    m_last_full_path_debug_info;
            end;
        end;
        refresh_candidate_segment_paths;
        m_visible_candidates_cache_valid := False;
        SetLength(m_visible_candidates_cache, 0);
        SetLength(m_visible_candidate_source_indices_cache, 0);
        note_ranked_top_candidate;
        m_page_index := 0;
        m_selected_index := 0;
    end;

    function is_short_mixed_head_only_fast_anchor_query: Boolean;
    begin
        Result := head_only_multi_syllable and
            (input_syllable_count >= 2) and
            (input_syllable_count <= 2) and
            (not is_full_pinyin_key(lookup_text)) and
            (not has_internal_dangling_initial) and
            (not all_initial_compact_query);
    end;

    function has_multi_char_dictionary_anchor(const candidates: TncCandidateList): Boolean;
    var
        idx: Integer;
    begin
        Result := False;
        for idx := 0 to High(candidates) do
        begin
            if Length(candidates[idx].text) > 1 then
            begin
                Exit(True);
            end;
        end;
    end;

    function try_resolve_best_exact_subspan_local(const start_idx: Integer;
        const span_syllables: Integer; out out_text: string; out out_score: Integer;
        out out_segments: Integer; out out_path: string; out out_has_anchor: Boolean;
        out out_anchor_units: Integer): Boolean; forward;

    function get_preferred_query_phrase_bonus_local(const query_key: string;
        const candidate_text: string): Integer; forward;

    function try_get_preferred_query_phrase_text_local(const query_key: string;
        out out_text: string; out out_bonus: Integer): Boolean; forward;

    function has_short_exact_complete_anchor(
        const candidates: TncCandidateList): Boolean;
    var
        idx: Integer;
    begin
        Result := False;
        if (input_syllable_count < 2) or (input_syllable_count > 8) or
            ((not is_full_pinyin_key(lookup_text)) and
            (not is_short_mixed_head_only_fast_anchor_query)) then
        begin
            Exit;
        end;

        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) <> '') or
                (not candidates[idx].has_dict_weight) then
            begin
                Continue;
            end;
            if get_candidate_text_unit_count(Trim(candidates[idx].text)) <>
                input_syllable_count then
            begin
                Continue;
            end;
            Exit(True);
        end;
    end;

    procedure promote_short_exact_raw_weight_leader_local(
        var candidates: TncCandidateList);
    var
        idx_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        rank_local: Integer;
        picked_local: TncCandidate;

        function is_complete_exact_local(const candidate: TncCandidate): Boolean;
        var
            text_local: string;
        begin
            Result := False;
            if Trim(candidate.comment) <> '' then
            begin
                Exit;
            end;
            if not (candidate.has_dict_weight or (candidate.source = cs_user)) then
            begin
                Exit;
            end;

            text_local := Trim(candidate.text);
            Result := (text_local <> '') and
                (get_candidate_text_unit_count(text_local) = input_syllable_count);
        end;

        function get_exact_rank_local(const candidate: TncCandidate): Integer;
        begin
            if candidate.has_dict_weight then
            begin
                Result := candidate.dict_weight;
            end
            else
            begin
                Result := candidate.score;
            end;

            if candidate.source = cs_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
        end;
    begin
        if Length(candidates) <= 1 then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx_local := 0 to High(candidates) do
        begin
            if not is_complete_exact_local(candidates[idx_local]) then
            begin
                Continue;
            end;

            rank_local := get_exact_rank_local(candidates[idx_local]);
            if (best_idx_local < 0) or (rank_local > best_rank_local) or
                ((rank_local = best_rank_local) and
                (candidates[idx_local].score > candidates[best_idx_local].score)) then
            begin
                best_idx_local := idx_local;
                best_rank_local := rank_local;
            end;
        end;

        if best_idx_local <= 0 then
        begin
            Exit;
        end;

        picked_local := candidates[best_idx_local];
        for idx_local := best_idx_local downto 1 do
        begin
            candidates[idx_local] := candidates[idx_local - 1];
        end;
        candidates[0] := picked_local;
    end;

    function seed_short_full_exact_resolved_candidate_local(
        var io_candidates: TncCandidateList): Boolean;
    var
        resolved_text_local: string;
        resolved_path_local: string;
        resolved_score_local: Integer;
        resolved_segments_local: Integer;
        resolved_anchor_units_local: Integer;
        resolved_has_anchor_local: Boolean;
        support_score_local: Integer;
        support_segments_local: Integer;
        support_path_local: string;
        preferred_text_local: string;
        preferred_bonus_local: Integer;
        existing_index_local: Integer;
        idx_local: Integer;
        seeded_candidate_local: TncCandidate;

        function has_precise_extendable_tail_local: Boolean;
        var
            syllables_local: TncPinyinParseResult;
            tail_text_local: string;
            suffix_ch_local: Char;
            extended_tail_local: string;
        begin
            Result := False;
            if not is_full_pinyin_key(lookup_text) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
            if Length(syllables_local) = 0 then
            begin
                Exit;
            end;

            tail_text_local := normalize_pinyin_text(
                syllables_local[High(syllables_local)].text);
            if tail_text_local = '' then
            begin
                Exit;
            end;

            for suffix_ch_local := 'a' to 'z' do
            begin
                extended_tail_local := tail_text_local + suffix_ch_local;
                if is_full_pinyin_key(extended_tail_local) and
                    (get_effective_compact_pinyin_unit_count(
                    extended_tail_local) = 1) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_covering_partial_anchor_local: Boolean;
        var
            local_idx: Integer;
            partial_units_local: Integer;
            comment_units_local: Integer;
        begin
            Result := False;
            for local_idx := 0 to High(io_candidates) do
            begin
                if Trim(io_candidates[local_idx].comment) = '' then
                begin
                    Continue;
                end;

                partial_units_local := get_candidate_text_unit_count(
                    Trim(io_candidates[local_idx].text));
                if partial_units_local <= 0 then
                begin
                    Continue;
                end;

                comment_units_local := get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(Trim(io_candidates[local_idx].comment)));
                if (comment_units_local > 0) and
                    (partial_units_local + comment_units_local =
                    input_syllable_count) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        Result := False;
        if (not short_full_exact_query) or (m_dictionary = nil) or
            (not is_full_pinyin_key(lookup_text)) or
            (input_syllable_count < 2) or (input_syllable_count > 2) then
        begin
            Exit;
        end;

        if not try_resolve_best_exact_subspan_local(0, input_syllable_count,
            resolved_text_local, resolved_score_local, resolved_segments_local,
            resolved_path_local, resolved_has_anchor_local,
            resolved_anchor_units_local) then
        begin
            Exit;
        end;

        if (Trim(resolved_text_local) = '') or
            (get_candidate_text_unit_count(Trim(resolved_text_local)) <>
            input_syllable_count) then
        begin
            Exit;
        end;

        if has_precise_extendable_tail_local and
            has_covering_partial_anchor_local and
            (resolved_score_local < 4096) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' sfx=[skip weak_prefix text=%s]',
                    [Trim(resolved_text_local)]);
            end;
            Exit;
        end;

        if try_get_preferred_query_phrase_text_local(lookup_text,
            preferred_text_local, preferred_bonus_local) and
            (Trim(preferred_text_local) <> '') and
            (not SameText(Trim(preferred_text_local), Trim(resolved_text_local))) and
            (get_candidate_text_unit_count(Trim(preferred_text_local)) =
            input_syllable_count) then
        begin
            resolved_text_local := Trim(preferred_text_local);
            Inc(resolved_score_local, preferred_bonus_local);
            resolved_path_local := '';
        end;

        support_path_local := '';
        support_score_local := 0;
        support_segments_local := 0;
        if Trim(resolved_path_local) = '' then
        begin
            support_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, Trim(resolved_text_local), support_score_local,
                support_segments_local);
            if Trim(support_path_local) <> '' then
            begin
                resolved_path_local := support_path_local;
            end;
        end;
        if Trim(resolved_path_local) = '' then
        begin
            Exit;
        end;
        if (m_dictionary <> nil) and
            is_low_evidence_admin_place_alias_cached(
            lookup_text, Trim(resolved_text_local)) then
        begin
            Exit;
        end;

        existing_index_local := -1;
        for idx_local := 0 to High(io_candidates) do
        begin
            if (Trim(io_candidates[idx_local].comment) = '') and
                SameText(Trim(io_candidates[idx_local].text),
                Trim(resolved_text_local)) then
            begin
                existing_index_local := idx_local;
                Break;
            end;
        end;

        if existing_index_local = 0 then
        begin
            if not io_candidates[0].has_dict_weight then
            begin
                io_candidates[0].has_dict_weight := True;
                io_candidates[0].dict_weight := Max(io_candidates[0].score,
                    resolved_score_local);
            end;
            remember_segment_path_for_candidate(Trim(io_candidates[0].text), '',
                resolved_path_local, io_candidates[0].dict_weight);
            Exit(True);
        end;

        if existing_index_local > 0 then
        begin
            seeded_candidate_local := io_candidates[existing_index_local];
            if not seeded_candidate_local.has_dict_weight then
            begin
                seeded_candidate_local.has_dict_weight := True;
                seeded_candidate_local.dict_weight := Max(
                    seeded_candidate_local.score, resolved_score_local);
            end;
            for idx_local := existing_index_local downto 1 do
            begin
                io_candidates[idx_local] := io_candidates[idx_local - 1];
            end;
            io_candidates[0] := seeded_candidate_local;
            remember_segment_path_for_candidate(Trim(io_candidates[0].text), '',
                resolved_path_local, io_candidates[0].dict_weight);
            Exit(True);
        end;

        FillChar(seeded_candidate_local, SizeOf(seeded_candidate_local), 0);
        seeded_candidate_local.text := Trim(resolved_text_local);
        seeded_candidate_local.comment := '';
        seeded_candidate_local.score := Max(resolved_score_local, 2048);
        seeded_candidate_local.source := cs_rule;
        seeded_candidate_local.has_dict_weight := True;
        seeded_candidate_local.dict_weight := seeded_candidate_local.score;

        SetLength(io_candidates, Length(io_candidates) + 1);
        for idx_local := High(io_candidates) downto 1 do
        begin
            io_candidates[idx_local] := io_candidates[idx_local - 1];
        end;
        io_candidates[0] := seeded_candidate_local;
        remember_segment_path_for_candidate(Trim(io_candidates[0].text), '',
            resolved_path_local, io_candidates[0].dict_weight);
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' sfx=[seed text=%s seg=%d]',
                [Trim(resolved_text_local), resolved_segments_local]);
        end;
        Result := True;
    end;

    function get_fixed_resolved_boundary_char_local(
        const syllable_text: string): string;
    var
        normalized_syllable: string;
    begin
        Result := '';
        normalized_syllable := normalize_pinyin_text(syllable_text);
        if (normalized_syllable = 'ta') or
            (normalized_syllable = 'qing') or
            (normalized_syllable = 'bei') then
        begin
            Exit;
        end;
        if normalized_syllable = 'dan' then
        begin
            Result := string(Char($4F46));
        end
        else if normalized_syllable = 'sui' then
        begin
            Result := string(Char($867D));
        end
        else if normalized_syllable = 'wo' then
        begin
            Result := string(Char($6211));
        end
        else if normalized_syllable = 'ni' then
        begin
            Result := string(Char($4F60));
        end
        else if normalized_syllable = 'ta' then
        begin
            Result := string(Char($4ED6));
        end
        else if normalized_syllable = 'he' then
        begin
            Result := string(Char($548C));
        end
        else if normalized_syllable = 'qu' then
        begin
            Result := string(Char($53BB));
        end
        else if normalized_syllable = 'shi' then
        begin
            Result := string(Char($662F));
        end
        else if normalized_syllable = 'yi' then
        begin
            Result := string(Char($4E00));
        end
        else if normalized_syllable = 'ye' then
        begin
            Result := string(Char($4E5F));
        end
        else if normalized_syllable = 'hui' then
        begin
            Result := string(Char($4F1A));
        end
        else if normalized_syllable = 'ba' then
        begin
            Result := string(Char($628A));
        end
        else if normalized_syllable = 'de' then
        begin
            Result := string(Char($7684));
        end
        else if normalized_syllable = 'zai' then
        begin
            Result := string(Char($5728));
        end
        else if normalized_syllable = 'zhe' then
        begin
            Result := string(Char($8FD9));
        end
        else if normalized_syllable = 'que' then
        begin
            Result := string(Char($5374));
        end
        else if normalized_syllable = 'bing' then
        begin
            Result := string(Char($5E76));
        end
        else if normalized_syllable = 'qie' then
        begin
            Result := string(Char($4E14));
        end;
    end;

    function build_resolved_sentence_candidate_local(
        out out_candidate: TncCandidate; out out_path: string): Boolean;
    const
        c_min_syllables = 6;
        c_max_chunk_syllables = 5;
        c_probe_limit = 4;
        c_single_probe_limit = 6;
        c_single_weight_floor = 120;
        c_fixed_single_score = 1200;
        c_single_penalty = 1600;
        c_chunk_length_bonus = 1400;
        c_chunk_anchor_bonus = 3600;
        c_join_penalty = 220;
        c_context_scale = 4;
        c_prefix_scale = 2;
    type
        TResolvedSentenceState = record
            valid: Boolean;
            score: Integer;
            segments: Integer;
            text: string;
            path: string;
            first_chunk: string;
        end;
    var
        syllables_local: TncPinyinParseResult;
        states_local: array of TResolvedSentenceState;
        pos_local: Integer;
        seg_len_local: Integer;
        next_pos_local: Integer;
        fixed_text_local: string;
        query_key_local: string;
        exact_results_local: TncCandidateList;
        candidate_idx_local: Integer;
        candidate_text_local: string;
        candidate_score_local: Integer;
        candidate_has_anchor_local: Boolean;
        candidate_anchor_units_local: Integer;
        candidate_local: TncCandidate;
        reach_pos_local: Integer;
        preferred_text_local: string;
        preferred_bonus_local: Integer;

        function lookup_exact_resolved_cached_local(const pinyin_key: string;
            out out_results: TncCandidateList): Boolean;
        begin
            Result := lookup_exact_full_pinyin_cached_local(pinyin_key,
                out_results);
        end;

        function build_query_key_local(const start_idx: Integer;
            const syllable_count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := start_idx to
                start_idx + syllable_count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function candidate_respects_fixed_boundaries_local(
            const start_idx: Integer; const syllable_count_local: Integer;
            const text_value: string): Boolean;
        var
            units_local: TArray<string>;
            local_idx: Integer;
            fixed_char_local: string;
        begin
            Result := False;
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;

            if syllable_count_local > 1 then
            begin
                Exit(True);
            end;

            units_local := split_text_units(Trim(text_value));
            if Length(units_local) <> syllable_count_local then
            begin
                Exit(False);
            end;

            for local_idx := 0 to syllable_count_local - 1 do
            begin
                fixed_char_local := get_fixed_resolved_boundary_char_local(
                    syllables_local[start_idx + local_idx].text);
                if (fixed_char_local <> '') and
                    (not SameText(units_local[local_idx], fixed_char_local)) then
                begin
                    Exit(False);
                end;
            end;

            Result := True;
        end;

        function get_effective_weight_local(const candidate: TncCandidate): Integer;
        begin
            Result := candidate.score;
            if candidate.has_dict_weight and
                (candidate.dict_weight > Result) then
            begin
                Result := candidate.dict_weight;
            end;
        end;

        function is_better_state_local(const left_state: TResolvedSentenceState;
            const right_state: TResolvedSentenceState): Boolean;
        begin
            Result := False;
            if not left_state.valid then
            begin
                Exit(False);
            end;
            if not right_state.valid then
            begin
                Exit(True);
            end;
            if left_state.score > right_state.score then
            begin
                Exit(True);
            end;
            if left_state.score < right_state.score then
            begin
                Exit(False);
            end;
            if get_candidate_text_unit_count(left_state.first_chunk) >
                get_candidate_text_unit_count(right_state.first_chunk) then
            begin
                Exit(True);
            end;
            if get_candidate_text_unit_count(left_state.first_chunk) <
                get_candidate_text_unit_count(right_state.first_chunk) then
            begin
                Exit(False);
            end;
            if left_state.segments < right_state.segments then
            begin
                Exit(True);
            end;
            if left_state.segments > right_state.segments then
            begin
                Exit(False);
            end;
            if (left_state.text <> '') and
                ((right_state.text = '') or
                (CompareText(left_state.text, right_state.text) < 0)) then
            begin
                Exit(True);
            end;
        end;

        function path_has_multi_char_chunk_local(const encoded_path: string): Boolean;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
        begin
            Result := False;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                if get_candidate_text_unit_count(
                    Trim(path_parts_local[part_idx_local])) >= 2 then
                begin
                    Exit(True);
                end;
            end;
        end;

        function is_modifier_prefix_single_local(const candidate_text: string): Boolean;
        begin
            Result := False;
            if Length(candidate_text) <> 1 then
            begin
                Exit;
            end;

            case Ord(candidate_text[1]) of
                $4E0D, $518D, $9AD8, $5F88, $592A, $6700, $66F4, $6CA1,
                $8981, $4F1A, $80FD, $53EF, $88AB, $628A, $8BA9, $7ED9,
                $5BF9, $5728, $4EE5, $6709, $65E0, $5982, $8001, $5C0F,
                $5927, $5168, $8D85, $771F, $597D, $800C, $5E76:
                    Result := True;
            end;
        end;

        procedure try_update_state_local(const start_idx: Integer;
            const syllable_count_local: Integer; const chunk_text: string;
            const chunk_path: string; const base_score: Integer;
            const has_anchor_local: Boolean; const anchor_units_local: Integer);
        var
            local_state: TResolvedSentenceState;
            next_state_local: TResolvedSentenceState;
            total_score_local: Integer;
            total_path_local: string;
            local_pair_units: Integer;
            local_pair_key: string;
            local_pair_text: string;
        begin
            if (chunk_text = '') or
                (get_candidate_text_unit_count(Trim(chunk_text)) <>
                syllable_count_local) then
            begin
                Exit;
            end;

            next_pos_local := start_idx + syllable_count_local;
            if (next_pos_local < input_syllable_count) and
                (not states_local[next_pos_local].valid) then
            begin
                Exit;
            end;

            total_score_local := base_score +
                (syllable_count_local * c_chunk_length_bonus);
            if has_anchor_local then
            begin
                Inc(total_score_local, c_chunk_anchor_bonus +
                    (anchor_units_local * 192));
            end;
            if syllable_count_local = 1 then
            begin
                Dec(total_score_local, c_single_penalty);
            end;

            local_state.valid := True;
            local_state.segments := 1;
            local_state.first_chunk := Trim(chunk_text);
            local_state.text := Trim(chunk_text);
            if Trim(chunk_path) <> '' then
            begin
                total_path_local := Trim(chunk_path);
            end
            else
            begin
                total_path_local := Trim(chunk_text);
            end;
            local_state.path := total_path_local;

            if next_pos_local < input_syllable_count then
            begin
                next_state_local := states_local[next_pos_local];
                Inc(total_score_local, next_state_local.score);
                Dec(total_score_local, c_join_penalty);
                local_state.segments := local_state.segments +
                    next_state_local.segments;
                local_state.text := local_state.text + next_state_local.text;
                if next_state_local.path <> '' then
                begin
                    local_state.path := local_state.path + c_segment_path_separator +
                        next_state_local.path;
                end;
                if get_candidate_text_unit_count(next_state_local.first_chunk) >= 2 then
                begin
                    if syllable_count_local = 1 then
                    begin
                        if is_modifier_prefix_single_local(Trim(chunk_text)) then
                        begin
                            Inc(total_score_local, 900);
                        end
                        else
                        begin
                            Dec(total_score_local, 1400);
                        end;
                    end;
                end
                else if (syllable_count_local >= 2) and
                    (get_candidate_text_unit_count(next_state_local.first_chunk) = 1) then
                begin
                    Inc(total_score_local, 900);
                end;
                if (m_dictionary <> nil) and
                    (next_state_local.first_chunk <> '') then
                begin
                    Inc(total_score_local,
                        m_dictionary.get_context_bonus(
                        Trim(chunk_text), next_state_local.first_chunk) *
                        c_context_scale);
                    Inc(total_score_local,
                        get_sentence_text_prefix_bonus_local(
                        Trim(chunk_text) + next_state_local.first_chunk) *
                        c_prefix_scale);

                    local_pair_units := syllable_count_local +
                        get_candidate_text_unit_count(next_state_local.first_chunk);
                    if (local_pair_units > syllable_count_local) and
                        (local_pair_units <= 6) then
                    begin
                        local_pair_key := build_query_key_local(start_idx,
                            local_pair_units);
                        local_pair_text := Trim(chunk_text) +
                            next_state_local.first_chunk;
                        Inc(total_score_local,
                            get_preferred_query_phrase_bonus_local(
                            local_pair_key, local_pair_text));
                    end;
                end;
            end;

            if start_idx = 0 then
            begin
                Inc(total_score_local,
                    get_preferred_query_phrase_bonus_local(lookup_text,
                    local_state.text));
            end;

            local_state.score := total_score_local;
            if is_better_state_local(local_state, states_local[start_idx]) then
            begin
                states_local[start_idx] := local_state;
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_path := '';
        if (m_dictionary = nil) or (input_syllable_count < c_min_syllables) or
            (not is_full_pinyin_key(lookup_text)) or
            (m_disable_subspan_standalone_oracle > 0) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text,
            m_last_lookup_normalized_from <> '');
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        SetLength(states_local, input_syllable_count + 1);
        states_local[0].valid := True;
        states_local[input_syllable_count].score := 0;
        states_local[input_syllable_count].segments := 0;
        states_local[input_syllable_count].text := '';
        states_local[input_syllable_count].path := '';
        states_local[input_syllable_count].first_chunk := '';

        for pos_local := input_syllable_count - 1 downto 0 do
        begin
            fixed_text_local := get_fixed_resolved_boundary_char_local(
                syllables_local[pos_local].text);
            if fixed_text_local <> '' then
            begin
                candidate_score_local := c_fixed_single_score;
                query_key_local := build_query_key_local(pos_local, 1);
                if lookup_exact_resolved_cached_local(query_key_local,
                    exact_results_local) then
                begin
                    for candidate_idx_local := 0 to High(exact_results_local) do
                    begin
                        if candidate_idx_local >= c_probe_limit then
                        begin
                            Break;
                        end;
                        if (Trim(exact_results_local[candidate_idx_local].comment) = '') and
                            SameText(Trim(exact_results_local[candidate_idx_local].text),
                            fixed_text_local) then
                        begin
                            candidate_score_local := Max(candidate_score_local,
                                get_effective_weight_local(
                                exact_results_local[candidate_idx_local]));
                        end;
                    end;
                end;
                try_update_state_local(pos_local, 1, fixed_text_local,
                    fixed_text_local, candidate_score_local, False, 0);
            end
            else
            begin
                query_key_local := build_query_key_local(pos_local, 1);
                if (query_key_local <> '') and
                    lookup_exact_resolved_cached_local(query_key_local,
                    exact_results_local) then
                begin
                    for candidate_idx_local := 0 to High(exact_results_local) do
                    begin
                        if candidate_idx_local >= c_single_probe_limit then
                        begin
                            Break;
                        end;
                        candidate_local := exact_results_local[candidate_idx_local];
                        if Trim(candidate_local.comment) <> '' then
                        begin
                            Continue;
                        end;

                        candidate_text_local := Trim(candidate_local.text);
                        if get_candidate_text_unit_count(candidate_text_local) <> 1 then
                        begin
                            Continue;
                        end;

                        candidate_score_local := get_effective_weight_local(
                            candidate_local);
                        if candidate_score_local < c_single_weight_floor then
                        begin
                            Continue;
                        end;

                        Dec(candidate_score_local, candidate_idx_local * 24);
                        try_update_state_local(pos_local, 1,
                            candidate_text_local, candidate_text_local,
                            candidate_score_local, False, 0);
                    end;
                end;
            end;

            for seg_len_local := 2 to Min(c_max_chunk_syllables,
                input_syllable_count - pos_local) do
            begin
                query_key_local := build_query_key_local(pos_local,
                    seg_len_local);

                if query_key_local = '' then
                begin
                    Continue;
                end;

                preferred_text_local := '';
                preferred_bonus_local := 0;
                if try_get_preferred_query_phrase_text_local(query_key_local,
                    preferred_text_local, preferred_bonus_local) and
                    (get_candidate_text_unit_count(preferred_text_local) =
                    seg_len_local) and
                    candidate_respects_fixed_boundaries_local(pos_local,
                    seg_len_local, preferred_text_local) then
                begin
                    candidate_score_local := preferred_bonus_local +
                        (seg_len_local * c_chunk_length_bonus) + 2048;
                    candidate_has_anchor_local := seg_len_local >= 3;
                    if candidate_has_anchor_local then
                    begin
                        candidate_anchor_units_local := seg_len_local;
                    end
                    else
                    begin
                        candidate_anchor_units_local := 0;
                    end;
                    try_update_state_local(pos_local, seg_len_local,
                        preferred_text_local, preferred_text_local,
                        candidate_score_local, candidate_has_anchor_local,
                        candidate_anchor_units_local);
                end;

                if not lookup_exact_resolved_cached_local(query_key_local,
                    exact_results_local) then
                begin
                    Continue;
                end;

                for candidate_idx_local := 0 to High(exact_results_local) do
                begin
                    if candidate_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    candidate_local := exact_results_local[candidate_idx_local];
                    if Trim(candidate_local.comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(candidate_local) or
                        is_runtime_common_pattern_candidate(candidate_local) or
                        is_runtime_redup_candidate(candidate_local) then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(candidate_local.text);
                    if (get_candidate_text_unit_count(candidate_text_local) <>
                        seg_len_local) or
                        (not candidate_respects_fixed_boundaries_local(pos_local,
                        seg_len_local, candidate_text_local)) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := get_effective_weight_local(
                        candidate_local);
                    Inc(candidate_score_local,
                        get_preferred_query_phrase_bonus_local(query_key_local,
                        candidate_text_local));
                    if seg_len_local >= 4 then
                    begin
                        Inc(candidate_score_local, 2048);
                    end;
                    if seg_len_local >= 5 then
                    begin
                        Inc(candidate_score_local, 2048);
                    end;
                    if seg_len_local >= 3 then
                    begin
                        Inc(candidate_score_local,
                            get_sentence_text_prefix_bonus_local(
                            candidate_text_local) * c_prefix_scale);
                    end;

                    candidate_has_anchor_local := seg_len_local >= 3;
                    if candidate_has_anchor_local then
                    begin
                        candidate_anchor_units_local := seg_len_local;
                    end
                    else
                    begin
                        candidate_anchor_units_local := 0;
                    end;

                    try_update_state_local(pos_local, seg_len_local,
                        candidate_text_local, candidate_text_local,
                        candidate_score_local, candidate_has_anchor_local,
                        candidate_anchor_units_local);
                end;
            end;
        end;

        if (not states_local[0].valid) or
            (get_candidate_text_unit_count(Trim(states_local[0].text)) <>
            input_syllable_count) then
        begin
            if m_config.debug_mode then
            begin
                reach_pos_local := 0;
                for pos_local := input_syllable_count downto 0 do
                begin
                    if states_local[pos_local].valid then
                    begin
                        reach_pos_local := pos_local;
                        Break;
                    end;
                end;
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' vrsmiss=[reach=%d/%d text=%s]',
                    [reach_pos_local, input_syllable_count,
                    Trim(states_local[reach_pos_local].text)]);
            end;
            Exit;
        end;
        if not path_has_multi_char_chunk_local(states_local[0].path) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' vrs=[skip all_single]';
            end;
            Exit;
        end;

        out_candidate.text := Trim(states_local[0].text);
        out_candidate.comment := '';
        out_candidate.score := states_local[0].score;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        out_path := Trim(states_local[0].path);
        Result := out_candidate.text <> '';
    end;

    function try_get_resolved_sentence_candidate_cached_local(
        out out_candidate: TncCandidate; out out_path: string): Boolean;
    var
        resolved_segments_local: Integer;
        resolved_anchor_units_local: Integer;
        resolved_has_anchor_local: Boolean;
    begin
        if resolved_sentence_candidate_built then
        begin
            out_candidate := resolved_sentence_candidate_cached;
            out_path := resolved_sentence_path_cached;
            Exit(resolved_sentence_candidate_ok);
        end;

        resolved_sentence_candidate_built := True;
        resolved_sentence_candidate_ok := False;
        FillChar(resolved_sentence_candidate_cached,
            SizeOf(resolved_sentence_candidate_cached), 0);
        resolved_sentence_path_cached := '';
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_path := '';

        if try_resolve_best_exact_subspan_local(0, input_syllable_count,
            out_candidate.text, out_candidate.score,
            resolved_segments_local, out_path,
            resolved_has_anchor_local, resolved_anchor_units_local) then
        begin
            out_candidate.comment := '';
            out_candidate.source := cs_rule;
            out_candidate.has_dict_weight := False;
            out_candidate.dict_weight := 0;
            resolved_sentence_candidate_ok := True;
        end
        else if build_resolved_sentence_candidate_local(out_candidate,
            out_path) then
        begin
            resolved_sentence_candidate_ok := True;
        end;

        if resolved_sentence_candidate_ok then
        begin
            resolved_sentence_candidate_cached := out_candidate;
            resolved_sentence_path_cached := out_path;
        end;
        Result := resolved_sentence_candidate_ok;
    end;

    function ensure_best_resolved_sentence_candidate_visible(
        var candidates: TncCandidateList): Boolean;
    const
        c_promote_margin = 2048;
    var
        resolved_candidate_local: TncCandidate;
        resolved_path_local: string;
        idx_local: Integer;
        existing_index_local: Integer;
        top_score_local: Integer;
        resolved_score_local: Integer;
        support_score_local: Integer;
        support_segments_local: Integer;
        support_path_local: string;
        top_text_local: string;
        top_is_base_entry_local: Boolean;
        resolved_multi_chunks_local: Integer;
        quality_syllables_local: TncPinyinParseResult;
        top_path_local: string;
        top_quality_local: Integer;
        resolved_quality_local: Integer;

        function count_multi_char_path_chunks_local(const encoded_path: string): Integer;
        var
            parts_local: TArray<string>;
            part_idx_local: Integer;
        begin
            Result := 0;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;
            parts_local := encoded_path.Split([c_segment_path_separator]);
            for part_idx_local := 0 to High(parts_local) do
            begin
                if get_candidate_text_unit_count(Trim(parts_local[part_idx_local])) >= 2 then
                begin
                    Inc(Result);
                end;
            end;
        end;

        function is_modifier_single_text_for_resolved_quality_local(
            const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $6211, $4F60, $4ED6, $5979,
                $662F, $7684, $4E86, $5728, $4E8E, $4E5F, $548C, $4E0D,
                $518D, $9AD8, $5F88, $592A, $6700, $66F4, $6CA1, $8981,
                $4F1A, $80FD, $628A, $88AB, $8BA9, $7ED9, $5BF9, $4ECE,
                $5411, $4E0E, $90FD, $8FD8, $624D, $5C31, $53EA, $522B,
                $5DF2, $5C06, $53EF, $60F3, $65E0, $975E, $672A, $4ECD,
                $591A, $5C11, $65B0, $8001, $5927, $5168, $8D85, $771F,
                $597D, $5982, $633A, $8F83, $6781, $800C, $5E76:
                    Result := True;
            end;
        end;

        function build_resolved_quality_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            key_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(quality_syllables_local)) then
            begin
                Exit;
            end;
            for key_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    quality_syllables_local[key_idx_local].text);
            end;
        end;

        function get_resolved_quality_exact_weight_local(
            const start_idx_local: Integer; const count_local: Integer;
            const expected_text_local: string): Integer;
        var
            key_local: string;
            results_local: TncCandidateList;
            idx_local: Integer;
            text_local: string;
            weight_local: Integer;
        begin
            Result := Low(Integer);
            key_local := build_resolved_quality_key_local(start_idx_local,
                count_local);
            if (key_local = '') or
                (m_dictionary = nil) or
                (not m_dictionary.lookup_exact_full_pinyin(key_local,
                results_local)) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(results_local) do
            begin
                if idx_local >= 12 then
                begin
                    Break;
                end;
                if Trim(results_local[idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                text_local := Trim(results_local[idx_local].text);
                if (text_local = '') or
                    (get_candidate_text_unit_count(text_local) <> count_local) or
                    ((expected_text_local <> '') and
                    (not SameText(text_local, expected_text_local))) then
                begin
                    Continue;
                end;

                weight_local := results_local[idx_local].score;
                if results_local[idx_local].has_dict_weight and
                    (results_local[idx_local].dict_weight > weight_local) then
                begin
                    weight_local := results_local[idx_local].dict_weight;
                end;
                if weight_local > Result then
                begin
                    Result := weight_local;
                end;
            end;
        end;

        function get_resolved_path_quality_local(const encoded_path: string): Integer;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            pos_local: Integer;
            segment_text_local: string;
            unit_count_local: Integer;
            exact_weight_local: Integer;
        begin
            Result := 0;
            if (Trim(encoded_path) = '') or (Length(quality_syllables_local) = 0) then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            pos_local := 0;
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                unit_count_local := get_candidate_text_unit_count(segment_text_local);
                if (unit_count_local <= 0) or
                    (pos_local + unit_count_local > Length(quality_syllables_local)) then
                begin
                    Exit;
                end;

                exact_weight_local := get_resolved_quality_exact_weight_local(
                    pos_local, unit_count_local, segment_text_local);
                if exact_weight_local > Low(Integer) div 4 then
                begin
                    Inc(Result, Min(20000, exact_weight_local * 4));
                    if (unit_count_local >= 2) and
                        (exact_weight_local >= 700) then
                    begin
                        Inc(Result, unit_count_local * 2200);
                    end;
                    if (unit_count_local >= 2) and
                        (exact_weight_local < 520) then
                    begin
                        Dec(Result, 3000 + unit_count_local * 1000);
                    end;
                    if (unit_count_local >= 4) and
                        (exact_weight_local >= 700) then
                    begin
                        Inc(Result, 8000 + (unit_count_local - 4) * 2200);
                    end;
                end
                else if unit_count_local >= 2 then
                begin
                    Dec(Result, 12000 + unit_count_local * 2500);
                end
                else if is_modifier_single_text_for_resolved_quality_local(
                    segment_text_local) then
                begin
                    Inc(Result, 900);
                end
                else
                begin
                    Dec(Result, 500);
                end;

                Inc(pos_local, unit_count_local);
            end;
        end;
    begin
        Result := False;
        FillChar(resolved_candidate_local, SizeOf(resolved_candidate_local), 0);
        resolved_path_local := '';
        if not try_get_resolved_sentence_candidate_cached_local(
            resolved_candidate_local, resolved_path_local) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' vrs=[miss]';
            end;
            Exit;
        end;

        support_score_local := 0;
        support_segments_local := 0;
        support_path_local := '';
        if Trim(resolved_path_local) = '' then
        begin
            support_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, Trim(resolved_candidate_local.text),
                support_score_local, support_segments_local);
            if Trim(support_path_local) <> '' then
            begin
                resolved_path_local := Trim(support_path_local);
            end;
        end;
        if Trim(resolved_path_local) <> '' then
        begin
            remember_segment_path_for_candidate(Trim(resolved_candidate_local.text),
                '', Trim(resolved_path_local),
                resolved_candidate_local.score + support_score_local);
        end;

        existing_index_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                SameText(Trim(candidates[idx_local].text),
                Trim(resolved_candidate_local.text)) then
            begin
                existing_index_local := idx_local;
                Break;
            end;
        end;

        resolved_score_local := resolved_candidate_local.score +
            support_score_local;
        resolved_multi_chunks_local :=
            count_multi_char_path_chunks_local(resolved_path_local);
        quality_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        resolved_quality_local := get_resolved_path_quality_local(
            resolved_path_local) + resolved_score_local div 32;
        if (Length(candidates) > 0) and
            (Trim(candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(candidates[0].text)) =
            input_syllable_count) then
        begin
            top_text_local := Trim(candidates[0].text);
            top_is_base_entry_local := (m_dictionary <> nil) and
                m_dictionary.is_base_entry(lookup_text, top_text_local);
            if (not is_problematic_single_char_chain_candidate_for_query(
                lookup_text, candidates[0])) and
                (top_is_base_entry_local or
                (resolved_multi_chunks_local < 3)) and
                (existing_index_local <> 0) then
            begin
                top_score_local := get_rank_score(candidates[0]);
                support_score_local := 0;
                support_segments_local := 0;
                if infer_segment_path_for_query_text_with_score(lookup_text,
                    top_text_local, support_score_local,
                    support_segments_local) <> '' then
                begin
                    Inc(top_score_local, support_score_local);
                end;
                top_path_local := get_segment_path_for_candidate(candidates[0], 0);
                if Trim(top_path_local) = '' then
                begin
                    top_path_local := infer_segment_path_for_query_text_with_score(
                        lookup_text, top_text_local, support_score_local,
                        support_segments_local);
                end;
                top_quality_local := get_resolved_path_quality_local(
                    top_path_local) + top_score_local div 32;
                if (resolved_score_local <= top_score_local + c_promote_margin) and
                    (resolved_quality_local <= top_quality_local + 3600) then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info := m_last_full_path_debug_info +
                            Format(' vrs=[keep resolved=%s toptext=%s score=%d top=%d rq=%d tq=%d]',
                            [Trim(resolved_candidate_local.text),
                            Trim(candidates[0].text), resolved_score_local,
                            top_score_local, resolved_quality_local,
                            top_quality_local]);
                    end;
                    Exit(False);
                end;
            end;
        end;

        if existing_index_local = 0 then
        begin
            Exit(True);
        end;

        if (Length(candidates) > 0) and
            (resolved_candidate_local.score <= candidates[0].score) then
        begin
            resolved_candidate_local.score := candidates[0].score + 1024;
            resolved_candidate_local.has_dict_weight := True;
            resolved_candidate_local.dict_weight := resolved_candidate_local.score;
        end;

        if existing_index_local > 0 then
        begin
            resolved_candidate_local := candidates[existing_index_local];
            if (Length(candidates) > 0) and
                (resolved_candidate_local.score <= candidates[0].score) then
            begin
                resolved_candidate_local.score := candidates[0].score + 1024;
                resolved_candidate_local.has_dict_weight := True;
                resolved_candidate_local.dict_weight := resolved_candidate_local.score;
            end;
            for idx_local := existing_index_local downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := resolved_candidate_local;
        end
        else
        begin
            SetLength(candidates, Length(candidates) + 1);
            for idx_local := High(candidates) downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := resolved_candidate_local;
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' vrs=[promote text=%s score=%d]',
                [Trim(candidates[0].text), resolved_score_local]);
        end;
        Result := True;
    end;

    function ensure_best_resolved_sentence_candidate_visible_aggressive(
        var candidates: TncCandidateList): Boolean;
    var
        resolved_candidate_local: TncCandidate;
        resolved_path_local: string;
        idx_local: Integer;
        existing_index_local: Integer;
        support_score_local: Integer;
        support_segments_local: Integer;
        support_path_local: string;
    begin
        Result := False;
        if (input_syllable_count < 8) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        if not build_resolved_sentence_candidate_local(
            resolved_candidate_local, resolved_path_local) then
        begin
            Exit;
        end;

        support_path_local := infer_segment_path_for_query_text_with_score(
            lookup_text, Trim(resolved_candidate_local.text),
            support_score_local, support_segments_local);
        if (Trim(resolved_path_local) = '') and
            (Trim(support_path_local) <> '') then
        begin
            resolved_path_local := Trim(support_path_local);
        end;
        if Trim(resolved_path_local) <> '' then
        begin
            remember_segment_path_for_candidate(Trim(resolved_candidate_local.text),
                '', Trim(resolved_path_local),
                resolved_candidate_local.score + support_score_local);
        end;

        existing_index_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                SameText(Trim(candidates[idx_local].text),
                Trim(resolved_candidate_local.text)) then
            begin
                existing_index_local := idx_local;
                Break;
            end;
        end;

        if existing_index_local = 0 then
        begin
            Exit(True);
        end;

        if existing_index_local > 0 then
        begin
            resolved_candidate_local := candidates[existing_index_local];
            for idx_local := existing_index_local downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := resolved_candidate_local;
        end
        else
        begin
            SetLength(candidates, Length(candidates) + 1);
            for idx_local := High(candidates) downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := resolved_candidate_local;
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' vra=[promote text=%s]', [Trim(candidates[0].text)]);
        end;
        Result := True;
    end;

    procedure ensure_best_late_exact_chunk_consensus_complete_candidate_visible(
        var candidates: TncCandidateList);
    const
        c_min_syllables = 8;
        c_min_window_syllables = 3;
        c_max_window_syllables = 6;
        c_probe_limit = 4;
        c_candidate_limit = 3;
        c_complete_rank_scale = 64;
        c_match_unit_weight = 640;
        c_mismatch_unit_weight = 896;
        c_fixed_match_bonus = 2048;
        c_fixed_mismatch_penalty = 4096;
        c_promote_margin = 512;
    var
        syllables_local: TncPinyinParseResult;
        cached_chunk_texts_local: TDictionary<string, string>;
        cached_chunk_scores_local: TDictionary<string, Integer>;
        cached_chunk_states_local: TDictionary<string, Byte>;
        candidate_units_local: array of TArray<string>;
        complete_indexes_local: TArray<Integer>;
        idx_local: Integer;
        candidate_idx_local: Integer;
        top_eval_score_local: Integer;
        best_eval_score_local: Integer;
        best_index_local: Integer;
        top_index_local: Integer;
        eval_score_local: Integer;

        function build_query_key_local(const start_idx: Integer;
            const syllable_count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;
            for local_idx := start_idx to
                start_idx + syllable_count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function window_has_fixed_boundary_local(const start_idx: Integer;
            const syllable_count_local: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;
            for local_idx := 0 to syllable_count_local - 1 do
            begin
                if get_fixed_resolved_boundary_char_local(
                    syllables_local[start_idx + local_idx].text) <> '' then
                begin
                    Exit(True);
                end;
            end;
        end;

        function candidate_respects_fixed_boundaries_local(
            const start_idx: Integer; const syllable_count_local: Integer;
            const text_value: string): Boolean;
        var
            units_local: TArray<string>;
            local_idx: Integer;
            fixed_char_local: string;
        begin
            if syllable_count_local > 1 then
            begin
                Exit(True);
            end;

            units_local := split_text_units(Trim(text_value));
            if Length(units_local) <> syllable_count_local then
            begin
                Exit(False);
            end;
            for local_idx := 0 to syllable_count_local - 1 do
            begin
                fixed_char_local := get_fixed_resolved_boundary_char_local(
                    syllables_local[start_idx + local_idx].text);
                if (fixed_char_local <> '') and
                    (not SameText(units_local[local_idx], fixed_char_local)) then
                begin
                    Exit(False);
                end;
            end;
            Result := True;
        end;

        function get_effective_weight_local(const candidate: TncCandidate): Integer;
        begin
            Result := candidate.score;
            if candidate.has_dict_weight and
                (candidate.dict_weight > Result) then
            begin
                Result := candidate.dict_weight;
            end;
        end;

        function try_get_best_exact_chunk_local(const start_idx: Integer;
            const syllable_count_local: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        var
            query_key_local: string;
            cached_state_local: Byte;
            exact_results_local: TncCandidateList;
            local_idx: Integer;
            candidate_text_local: string;
            candidate_score_local: Integer;
            best_text_local: string;
            best_score_local: Integer;
            resolved_text_local: string;
            resolved_path_local: string;
            resolved_score_local: Integer;
            resolved_segments_local: Integer;
            resolved_anchor_units_local: Integer;
            resolved_has_anchor_local: Boolean;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            query_key_local := build_query_key_local(start_idx,
                syllable_count_local);
            if (query_key_local = '') or (m_dictionary = nil) then
            begin
                Exit;
            end;

            if cached_chunk_states_local.TryGetValue(query_key_local,
                cached_state_local) then
            begin
                if cached_state_local = 1 then
                begin
                    cached_chunk_texts_local.TryGetValue(query_key_local, out_text);
                    cached_chunk_scores_local.TryGetValue(query_key_local, out_score);
                    Exit(out_text <> '');
                end;
                Exit(False);
            end;

            best_text_local := '';
            best_score_local := Low(Integer);
            if (syllable_count_local >= 3) and
                try_resolve_best_exact_subspan_local(start_idx,
                syllable_count_local, resolved_text_local,
                resolved_score_local, resolved_segments_local,
                resolved_path_local, resolved_has_anchor_local,
                resolved_anchor_units_local) and
                (resolved_text_local <> '') and
                candidate_respects_fixed_boundaries_local(start_idx,
                syllable_count_local, resolved_text_local) then
            begin
                best_text_local := resolved_text_local;
                best_score_local := resolved_score_local;
                if resolved_segments_local <= 1 then
                begin
                    Inc(best_score_local, 2048);
                end;
                if resolved_has_anchor_local then
                begin
                    Inc(best_score_local, 1024 + (resolved_anchor_units_local * 96));
                end;
            end;

            if m_dictionary.lookup_exact_full_pinyin(query_key_local,
                exact_results_local) then
            begin
                for local_idx := 0 to High(exact_results_local) do
                begin
                    if local_idx >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(exact_results_local[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(exact_results_local[local_idx].text);
                    if (get_candidate_text_unit_count(candidate_text_local) <>
                        syllable_count_local) or
                        (not candidate_respects_fixed_boundaries_local(start_idx,
                        syllable_count_local, candidate_text_local)) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := get_effective_weight_local(
                        exact_results_local[local_idx]);
                    Inc(candidate_score_local,
                        get_preferred_query_phrase_bonus_local(query_key_local,
                        candidate_text_local));
                    if syllable_count_local >= 4 then
                    begin
                        Inc(candidate_score_local, 1024);
                    end;
                    if syllable_count_local >= 5 then
                    begin
                        Inc(candidate_score_local, 1024);
                    end;

                    if candidate_score_local > best_score_local then
                    begin
                        best_score_local := candidate_score_local;
                        best_text_local := candidate_text_local;
                    end;
                end;
            end;

            if best_text_local <> '' then
            begin
                cached_chunk_states_local.AddOrSetValue(query_key_local, 1);
                cached_chunk_texts_local.AddOrSetValue(query_key_local,
                    best_text_local);
                cached_chunk_scores_local.AddOrSetValue(query_key_local,
                    best_score_local);
                out_text := best_text_local;
                out_score := best_score_local;
                Exit(True);
            end;

            cached_chunk_states_local.AddOrSetValue(query_key_local, 2);
        end;

        function extract_candidate_window_local(const units_local: TArray<string>;
            const start_idx: Integer; const syllable_count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (Length(units_local) <> input_syllable_count) or
                (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local > Length(units_local)) then
            begin
                Exit;
            end;
            for local_idx := start_idx to
                start_idx + syllable_count_local - 1 do
            begin
                Result := Result + units_local[local_idx];
            end;
        end;

        function evaluate_complete_candidate_local(
            const candidate_index_local: Integer): Integer;
        var
            start_idx_local: Integer;
            syllable_count_part_local: Integer;
            chunk_text_local: string;
            chunk_score_local: Integer;
            candidate_chunk_local: string;
            fixed_boundary_local: Boolean;
        begin
            Result := get_rank_score(candidates[candidate_index_local]) div
                c_complete_rank_scale;
            for start_idx_local := 0 to input_syllable_count - 1 do
            begin
                for syllable_count_part_local := c_min_window_syllables to
                    Min(c_max_window_syllables,
                    input_syllable_count - start_idx_local) do
                begin
                    if not try_get_best_exact_chunk_local(start_idx_local,
                        syllable_count_part_local, chunk_text_local,
                        chunk_score_local) then
                    begin
                        Continue;
                    end;
                    candidate_chunk_local := extract_candidate_window_local(
                        candidate_units_local[candidate_index_local],
                        start_idx_local, syllable_count_part_local);
                    if candidate_chunk_local = '' then
                    begin
                        Continue;
                    end;
                    fixed_boundary_local := window_has_fixed_boundary_local(
                        start_idx_local, syllable_count_part_local);
                    if SameText(candidate_chunk_local, chunk_text_local) then
                    begin
                        Inc(Result, syllable_count_part_local *
                            c_match_unit_weight);
                        if fixed_boundary_local then
                        begin
                            Inc(Result, c_fixed_match_bonus);
                        end;
                    end
                    else
                    begin
                        Dec(Result, syllable_count_part_local *
                            c_mismatch_unit_weight);
                        if fixed_boundary_local then
                        begin
                            Dec(Result, c_fixed_mismatch_penalty);
                        end;
                    end;
                end;
            end;
        end;

        procedure promote_existing_candidate_local(const existing_index_local: Integer);
        var
            picked_local: TncCandidate;
            local_idx: Integer;
        begin
            if existing_index_local <= 0 then
            begin
                Exit;
            end;
            picked_local := candidates[existing_index_local];
            for local_idx := existing_index_local downto 1 do
            begin
                candidates[local_idx] := candidates[local_idx - 1];
            end;
            candidates[0] := picked_local;
        end;
    begin
        if (Length(candidates) <= 1) or (m_dictionary = nil) or
            (input_syllable_count < c_min_syllables) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        cached_chunk_texts_local := TDictionary<string, string>.Create;
        cached_chunk_scores_local := TDictionary<string, Integer>.Create;
        cached_chunk_states_local := TDictionary<string, Byte>.Create;
        try
            SetLength(candidate_units_local, Length(candidates));
            SetLength(complete_indexes_local, 0);
            for idx_local := 0 to High(candidates) do
            begin
                candidate_units_local[idx_local] := split_text_units(
                    Trim(candidates[idx_local].text));
                if (Trim(candidates[idx_local].comment) = '') and
                    (Length(candidate_units_local[idx_local]) =
                    input_syllable_count) then
                begin
                    SetLength(complete_indexes_local,
                        Length(complete_indexes_local) + 1);
                    complete_indexes_local[High(complete_indexes_local)] := idx_local;
                    if Length(complete_indexes_local) >= c_candidate_limit then
                    begin
                        Break;
                    end;
                end;
            end;

            if Length(complete_indexes_local) <= 1 then
            begin
                Exit;
            end;

            best_index_local := complete_indexes_local[0];
            top_index_local := complete_indexes_local[0];
            best_eval_score_local := evaluate_complete_candidate_local(
                best_index_local);
            top_eval_score_local := best_eval_score_local;
            for idx_local := 1 to High(complete_indexes_local) do
            begin
                candidate_idx_local := complete_indexes_local[idx_local];
                eval_score_local := evaluate_complete_candidate_local(
                    candidate_idx_local);
                if eval_score_local > best_eval_score_local then
                begin
                    best_eval_score_local := eval_score_local;
                    best_index_local := candidate_idx_local;
                end;
            end;

            if (best_index_local > 0) and
                (best_eval_score_local >= top_eval_score_local +
                c_promote_margin) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' vlc=[promote text=%s score=%d top=%d]',
                        [Trim(candidates[best_index_local].text),
                        best_eval_score_local, top_eval_score_local]);
                end;
                promote_existing_candidate_local(best_index_local);
            end
            else if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' vlc=[keep text=%s score=%d top=%d]',
                    [Trim(candidates[top_index_local].text),
                    best_eval_score_local, top_eval_score_local]);
            end;
        finally
            cached_chunk_states_local.Free;
            cached_chunk_scores_local.Free;
            cached_chunk_texts_local.Free;
        end;
    end;

    function try_lookup_preferred_exact_phrase_candidate_local(
        const query_key: string; out out_candidate: TncCandidate;
        out out_syllable_count: Integer): Boolean;
    const
        c_min_preferred_phrase_syllables = 2;
        c_max_preferred_phrase_syllables = 5;
        c_min_preferred_phrase_weight = 80;
        c_regular_lookup_preferred_source_bonus = 0;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        exact_results_local: TncCandidateList;
        lookup_results_local: TncCandidateList;
        candidate_pool_local: TncCandidateList;
        candidate_pool_source_bonuses_local: TArray<Integer>;
        cache_key_local: string;
        phase_start_tick_local: UInt64;
        idx_local: Integer;
        candidate_text_local: string;
        candidate_units_local: Integer;
        candidate_weight_local: Integer;
        best_idx_local: Integer;
        best_weight_local: Integer;
        best_raw_weight_local: Integer;
        cached_state_local: Byte;
        has_valid_exact_candidate_local: Boolean;

        function get_candidate_effective_weight_local(const local_candidate: TncCandidate;
            const local_source_bonus: Integer): Integer;
        begin
            if is_fuzzy_pinyin_active and
                (local_candidate.fuzzy_cost > 0) then
            begin
                Result := local_candidate.score;
            end
            else if local_candidate.has_dict_weight then
            begin
                Result := local_candidate.dict_weight;
            end
            else
            begin
                Result := local_candidate.score;
            end;
            Inc(Result, local_source_bonus);
        end;

        procedure append_candidate_pool_local(const source_candidates: TncCandidateList;
            const source_bonus: Integer);
        var
            source_idx_local: Integer;
            existing_idx_local: Integer;
            source_text_local: string;
            duplicate_found_local: Boolean;
            source_weight_local: Integer;
            existing_weight_local: Integer;
        begin
            for source_idx_local := 0 to High(source_candidates) do
            begin
                source_text_local := Trim(source_candidates[source_idx_local].text);
                if source_text_local = '' then
                begin
                    Continue;
                end;

                duplicate_found_local := False;
                source_weight_local := get_candidate_effective_weight_local(
                    source_candidates[source_idx_local], source_bonus);
                for existing_idx_local := 0 to High(candidate_pool_local) do
                begin
                    if SameText(Trim(candidate_pool_local[existing_idx_local].text),
                        source_text_local) then
                    begin
                        duplicate_found_local := True;
                        existing_weight_local := get_candidate_effective_weight_local(
                            candidate_pool_local[existing_idx_local],
                            candidate_pool_source_bonuses_local[existing_idx_local]);
                        if source_weight_local > existing_weight_local then
                        begin
                            candidate_pool_local[existing_idx_local] :=
                                source_candidates[source_idx_local];
                            candidate_pool_source_bonuses_local[existing_idx_local] :=
                                source_bonus;
                        end;
                        Break;
                    end;
                end;
                if duplicate_found_local then
                begin
                    Continue;
                end;

                SetLength(candidate_pool_local,
                    Length(candidate_pool_local) + 1);
                SetLength(candidate_pool_source_bonuses_local,
                    Length(candidate_pool_source_bonuses_local) + 1);
                candidate_pool_local[High(candidate_pool_local)] :=
                    source_candidates[source_idx_local];
                candidate_pool_source_bonuses_local[
                    High(candidate_pool_source_bonuses_local)] := source_bonus;
            end;
        end;

        function build_sub_query_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            key_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;
            for key_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[key_idx_local].text);
            end;
        end;

        function get_best_exact_weight_for_split_local(
            const split_query_key: string; const split_syllable_count: Integer;
            out out_weight: Integer): Boolean;
        var
            split_results_local: TncCandidateList;
            split_cache_key_local: string;
            split_phase_start_tick_local: UInt64;
            split_idx_local: Integer;
            split_text_local: string;
            split_weight_local: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (split_query_key = '') or (split_syllable_count <= 0) then
            begin
                Exit;
            end;

            split_cache_key_local := '#preferred_split#' + split_query_key;
            if (lookup_cache <> nil) and
                lookup_cache.TryGetValue(split_cache_key_local,
                split_results_local) then
            begin
                Inc(lookup_cache_hits);
            end
            else
            begin
                Inc(lookup_cache_misses);
                split_phase_start_tick_local := GetTickCount64;
                if not m_dictionary.lookup_exact_full_pinyin(split_query_key,
                    split_results_local) then
                begin
                    SetLength(split_results_local, 0);
                end;
                Inc(lookup_elapsed_ms, Int64(GetTickCount64 -
                    split_phase_start_tick_local));
                if lookup_cache <> nil then
                begin
                    lookup_cache.AddOrSetValue(split_cache_key_local,
                        split_results_local);
                end;
            end;

            for split_idx_local := 0 to High(split_results_local) do
            begin
                if Trim(split_results_local[split_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                split_text_local := Trim(split_results_local[split_idx_local].text);
                if (split_text_local = '') or
                    (get_candidate_text_unit_count(split_text_local) <>
                    split_syllable_count) then
                begin
                    Continue;
                end;
                if split_results_local[split_idx_local].has_dict_weight then
                begin
                    split_weight_local :=
                        split_results_local[split_idx_local].dict_weight;
                end
                else
                begin
                    split_weight_local := split_results_local[split_idx_local].score;
                end;
                if split_weight_local > out_weight then
                begin
                    out_weight := split_weight_local;
                    Result := True;
                end;
            end;
        end;

        function has_much_stronger_split_local(
            const exact_weight_local: Integer): Boolean;
        const
            c_exact_phrase_protection_weight = 260;
            c_split_override_margin = 700;
            c_split_strong_chunk_weight = 360;
        var
            split_pos_local: Integer;
            left_key_local: string;
            right_key_local: string;
            left_weight_local: Integer;
            right_weight_local: Integer;
            split_weight_local: Integer;
        begin
            Result := False;
            if out_syllable_count < 3 then
            begin
                Exit;
            end;
            if exact_weight_local >= c_exact_phrase_protection_weight then
            begin
                Exit;
            end;

            for split_pos_local := 1 to out_syllable_count - 1 do
            begin
                left_key_local := build_sub_query_key_local(0,
                    split_pos_local);
                right_key_local := build_sub_query_key_local(split_pos_local,
                    out_syllable_count - split_pos_local);
                if (not get_best_exact_weight_for_split_local(left_key_local,
                    split_pos_local, left_weight_local)) or
                    (not get_best_exact_weight_for_split_local(right_key_local,
                    out_syllable_count - split_pos_local,
                    right_weight_local)) then
                begin
                    Continue;
                end;

                split_weight_local := left_weight_local + right_weight_local;
                if (Max(left_weight_local, right_weight_local) >=
                    c_split_strong_chunk_weight) and
                    (split_weight_local >= exact_weight_local +
                    c_split_override_margin) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        Result := False;
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        out_syllable_count := 0;

        normalized_query := normalize_pinyin_text(query_key);
        if (normalized_query = '') or (m_dictionary = nil) or
            (not is_full_pinyin_key(normalized_query)) then
        begin
            Exit;
        end;

        if (preferred_exact_state_cache <> nil) and
            preferred_exact_state_cache.TryGetValue(normalized_query,
            cached_state_local) then
        begin
            if (preferred_exact_syllable_count_cache <> nil) and
                (not preferred_exact_syllable_count_cache.TryGetValue(
                normalized_query, out_syllable_count)) then
            begin
                out_syllable_count := 0;
            end;
            if cached_state_local <> 0 then
            begin
                if (preferred_exact_candidate_cache <> nil) and
                    preferred_exact_candidate_cache.TryGetValue(
                    normalized_query, out_candidate) then
                begin
                    Exit(True);
                end;
            end;
            Exit(False);
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            normalized_query);
        out_syllable_count := Length(syllables_local);
        if (out_syllable_count < c_min_preferred_phrase_syllables) or
            (out_syllable_count > c_max_preferred_phrase_syllables) then
        begin
            Exit;
        end;

        cache_key_local := '#preferred_exact#' + normalized_query;
        if (lookup_cache <> nil) and
            lookup_cache.TryGetValue(cache_key_local, exact_results_local) then
        begin
            Inc(lookup_cache_hits);
        end
        else
        begin
            Inc(lookup_cache_misses);
            phase_start_tick_local := GetTickCount64;
            if not m_dictionary.lookup_exact_full_pinyin(normalized_query,
                exact_results_local) then
            begin
                SetLength(exact_results_local, 0);
            end;
            Inc(lookup_elapsed_ms, Int64(GetTickCount64 -
                phase_start_tick_local));
            if lookup_cache <> nil then
            begin
                lookup_cache.AddOrSetValue(cache_key_local,
                    exact_results_local);
            end;
        end;

        cache_key_local := '#preferred_lookup#' + normalized_query;
        if (lookup_cache <> nil) and
            lookup_cache.TryGetValue(cache_key_local, lookup_results_local) then
        begin
            Inc(lookup_cache_hits);
        end
        else
        begin
            Inc(lookup_cache_misses);
            phase_start_tick_local := GetTickCount64;
            if not m_dictionary.lookup(normalized_query, lookup_results_local) then
            begin
                SetLength(lookup_results_local, 0);
            end;
            Inc(lookup_elapsed_ms, Int64(GetTickCount64 -
                phase_start_tick_local));
            if lookup_cache <> nil then
            begin
                lookup_cache.AddOrSetValue(cache_key_local,
                    lookup_results_local);
            end;
        end;

        has_valid_exact_candidate_local := False;
        for idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(exact_results_local[idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                out_syllable_count) then
            begin
                Continue;
            end;
            if exact_results_local[idx_local].has_dict_weight then
            begin
                candidate_weight_local := exact_results_local[idx_local].dict_weight;
            end
            else
            begin
                candidate_weight_local := exact_results_local[idx_local].score;
            end;
            if candidate_weight_local >= c_min_preferred_phrase_weight then
            begin
                has_valid_exact_candidate_local := True;
                Break;
            end;
        end;

        SetLength(candidate_pool_local, 0);
        SetLength(candidate_pool_source_bonuses_local, 0);
        if has_valid_exact_candidate_local then
        begin
            append_candidate_pool_local(exact_results_local, 0);
        end
        else if out_syllable_count <= 2 then
        begin
            append_candidate_pool_local(lookup_results_local,
                c_regular_lookup_preferred_source_bonus);
        end
        else
        begin
            append_candidate_pool_local(lookup_results_local, 0);
        end;

        best_idx_local := -1;
        best_weight_local := Low(Integer);
        best_raw_weight_local := 0;
        for idx_local := 0 to High(candidate_pool_local) do
        begin
            if Trim(candidate_pool_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(candidate_pool_local[idx_local].text);
            if candidate_text_local = '' then
            begin
                Continue;
            end;
            candidate_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            if candidate_units_local <> out_syllable_count then
            begin
                Continue;
            end;

            if candidate_pool_local[idx_local].has_dict_weight then
            begin
                candidate_weight_local := candidate_pool_local[idx_local].dict_weight;
            end
            else
            begin
                candidate_weight_local := candidate_pool_local[idx_local].score;
            end;
            Inc(candidate_weight_local,
                candidate_pool_source_bonuses_local[idx_local]);
            if candidate_weight_local < c_min_preferred_phrase_weight then
            begin
                Continue;
            end;

            if candidate_weight_local > best_weight_local then
            begin
                best_weight_local := candidate_weight_local;
                best_raw_weight_local := candidate_weight_local -
                    candidate_pool_source_bonuses_local[idx_local];
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local >= 0 then
        begin
            if not has_much_stronger_split_local(best_raw_weight_local) then
            begin
                out_candidate := candidate_pool_local[best_idx_local];
                Result := True;
            end;
        end;

        if (preferred_exact_state_cache <> nil) then
        begin
            preferred_exact_state_cache.AddOrSetValue(normalized_query,
                Byte(Ord(Result)));
            if preferred_exact_syllable_count_cache <> nil then
            begin
                preferred_exact_syllable_count_cache.AddOrSetValue(
                    normalized_query, out_syllable_count);
            end;
            if Result and (preferred_exact_candidate_cache <> nil) then
            begin
                preferred_exact_candidate_cache.AddOrSetValue(normalized_query,
                    out_candidate);
            end;
        end;
    end;

    function has_learned_query_choice_override_local(const query_key: string;
        const candidate_text: string): Boolean;
    var
        normalized_query_local: string;
        text_key_local: string;
        latest_text_local: string;
        cache_key_local: string;
        cached_state_local: Byte;

        function get_exact_weight_for_text_local(
            const target_text: string): Integer;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            candidate_weight_local: Integer;
        begin
            Result := -1;
            if (m_dictionary = nil) or (Trim(target_text) = '') or
                (not m_dictionary.lookup_exact_full_pinyin(normalized_query_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    (not SameText(Trim(exact_results_local[exact_idx_local].text),
                    Trim(target_text))) then
                begin
                    Continue;
                end;

                if exact_results_local[exact_idx_local].has_dict_weight then
                begin
                    candidate_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end
                else
                begin
                    candidate_weight_local :=
                        exact_results_local[exact_idx_local].score;
                end;
                if candidate_weight_local > Result then
                begin
                    Result := candidate_weight_local;
                end;
            end;
        end;

        function learned_choice_should_override_local(
            const local_latest_text: string): Boolean;
        const
            c_strong_exact_protection_min = 260;
            c_strong_exact_protection_gap = 700;
            c_weak_latest_exact_max = 80;
        var
            candidate_weight_local: Integer;
            latest_weight_local: Integer;
        begin
            Result := (Trim(local_latest_text) <> '') and
                (not SameText(text_key_local, Trim(local_latest_text)));
            if not Result then
            begin
                Exit;
            end;

            candidate_weight_local := get_exact_weight_for_text_local(text_key_local);
            latest_weight_local := get_exact_weight_for_text_local(local_latest_text);
            if (candidate_weight_local >= c_strong_exact_protection_min) and
                (latest_weight_local >= 0) and
                (latest_weight_local <= c_weak_latest_exact_max) and
                (candidate_weight_local >= latest_weight_local +
                c_strong_exact_protection_gap) then
            begin
                Result := False;
            end;
        end;
    begin
        Result := False;
        normalized_query_local := normalize_pinyin_text(query_key);
        text_key_local := Trim(candidate_text);
        if (normalized_query_local = '') or (text_key_local = '') then
        begin
            Exit;
        end;

        cache_key_local := normalized_query_local + #1 + text_key_local;
        if (learned_query_choice_override_cache <> nil) and
            learned_query_choice_override_cache.TryGetValue(cache_key_local,
            cached_state_local) then
        begin
            Exit(cached_state_local <> 0);
        end;

        if (m_session_query_latest_text <> nil) and
            m_session_query_latest_text.TryGetValue(normalized_query_local,
            latest_text_local) and (Trim(latest_text_local) <> '') then
        begin
            Result := learned_choice_should_override_local(latest_text_local);
            if learned_query_choice_override_cache <> nil then
            begin
                learned_query_choice_override_cache.AddOrSetValue(
                    cache_key_local, Byte(Ord(Result)));
            end;
            Exit;
        end;

        if m_dictionary = nil then
        begin
            Exit;
        end;

        latest_text_local := '';
        if (m_lookup_query_latest_text_cache <> nil) and
            m_lookup_query_latest_text_cache.TryGetValue(normalized_query_local,
            latest_text_local) then
        begin
        end
        else
        begin
            latest_text_local := get_cached_query_latest_choice_text(
                normalized_query_local);
            if m_lookup_query_latest_text_cache <> nil then
            begin
                m_lookup_query_latest_text_cache.AddOrSetValue(
                    normalized_query_local, latest_text_local);
            end;
        end;

        Result := learned_choice_should_override_local(latest_text_local);
        if learned_query_choice_override_cache <> nil then
        begin
            learned_query_choice_override_cache.AddOrSetValue(cache_key_local,
                Byte(Ord(Result)));
        end;
    end;

    function has_stronger_query_choice_bonus_competitor_local(
        const query_key: string; const candidate_text: string): Boolean;
    var
        normalized_query_local: string;
        text_key_local: string;
        exact_results_local: TncCandidateList;
        cache_key_local: string;
        phase_start_tick_local: UInt64;
        idx_local: Integer;
        competitor_text_local: string;
        candidate_bonus_local: Integer;
        competitor_bonus_local: Integer;
        candidate_units_local: Integer;
        cached_state_local: Byte;
    begin
        Result := False;
        normalized_query_local := normalize_pinyin_text(query_key);
        text_key_local := Trim(candidate_text);
        if (normalized_query_local = '') or (text_key_local = '') or
            (m_dictionary = nil) then
        begin
            Exit;
        end;

        cache_key_local := normalized_query_local + #1 + text_key_local;
        if (stronger_query_choice_competitor_cache <> nil) and
            stronger_query_choice_competitor_cache.TryGetValue(cache_key_local,
            cached_state_local) then
        begin
            Exit(cached_state_local <> 0);
        end;

        candidate_bonus_local := m_dictionary.get_query_choice_bonus(
            normalized_query_local, text_key_local);
        candidate_units_local := get_candidate_text_unit_count(text_key_local);

        cache_key_local := '#choice_override#' + normalized_query_local;
        if (lookup_cache <> nil) and
            lookup_cache.TryGetValue(cache_key_local, exact_results_local) then
        begin
            Inc(lookup_cache_hits);
        end
        else
        begin
            Inc(lookup_cache_misses);
            phase_start_tick_local := GetTickCount64;
            if not m_dictionary.lookup_exact_full_pinyin(normalized_query_local,
                exact_results_local) then
            begin
                SetLength(exact_results_local, 0);
            end;
            Inc(lookup_elapsed_ms, Int64(GetTickCount64 -
                phase_start_tick_local));
            if lookup_cache <> nil then
            begin
                lookup_cache.AddOrSetValue(cache_key_local,
                    exact_results_local);
            end;
        end;

        for idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            competitor_text_local := Trim(exact_results_local[idx_local].text);
            if (competitor_text_local = '') or
                SameText(competitor_text_local, text_key_local) or
                (get_candidate_text_unit_count(competitor_text_local) <>
                candidate_units_local) then
            begin
                Continue;
            end;

            competitor_bonus_local := m_dictionary.get_query_choice_bonus(
                normalized_query_local, competitor_text_local);
            if competitor_bonus_local > candidate_bonus_local then
            begin
                Result := True;
                Break;
            end;
        end;
        if stronger_query_choice_competitor_cache <> nil then
        begin
            stronger_query_choice_competitor_cache.AddOrSetValue(
                normalized_query_local + #1 + text_key_local, Byte(Ord(Result)));
        end;
    end;

    function should_allow_preferred_query_phrase_local(
        const normalized_query_local: string): Boolean;
    begin
        Result := False;
        if (normalized_query_local = '') or (m_dictionary = nil) or
            (input_syllable_count < 2) or (input_syllable_count > 4) or
            (not is_full_pinyin_key(normalized_query_local)) then
        begin
            Exit;
        end;

        Result := SameText(normalized_query_local,
            normalize_pinyin_text(lookup_text));
    end;

    function get_preferred_query_phrase_bonus_local(const query_key: string;
        const candidate_text: string): Integer;
    var
        normalized_query_local: string;
        text_key_local: string;
        cache_key_local: string;
        cached_bonus_local: Integer;
        preferred_text_local: string;
        preferred_bonus_local: Integer;
    begin
        Result := 0;
        normalized_query_local := normalize_pinyin_text(query_key);
        text_key_local := Trim(candidate_text);
        if (normalized_query_local = '') or (text_key_local = '') or
            (not should_allow_preferred_query_phrase_local(
            normalized_query_local)) then
        begin
            Exit;
        end;

        cache_key_local := normalized_query_local + #1 + text_key_local;
        if (preferred_query_phrase_bonus_cache <> nil) and
            preferred_query_phrase_bonus_cache.TryGetValue(cache_key_local,
            cached_bonus_local) then
        begin
            Exit(cached_bonus_local);
        end;

        if try_get_preferred_query_phrase_text_local(normalized_query_local,
            preferred_text_local, preferred_bonus_local) and
            SameText(text_key_local, preferred_text_local) then
        begin
            Result := preferred_bonus_local;
        end;

        preferred_query_phrase_bonus_cache.AddOrSetValue(cache_key_local, Result);
    end;
    procedure apply_preferred_query_phrase_bonus_for_query(const query_key: string;
        var candidates: TncCandidateList);
    var
        idx: Integer;
        bonus: Integer;
    begin
        if normalize_pinyin_text(query_key) = '' then
        begin
            Exit;
        end;

        for idx := 0 to High(candidates) do
        begin
            if Trim(candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            bonus := get_preferred_query_phrase_bonus_local(query_key,
                Trim(candidates[idx].text));
            if bonus <> 0 then
            begin
                Inc(candidates[idx].score, bonus);
            end;
        end;
    end;

    function try_get_preferred_query_phrase_text_local(const query_key: string;
        out out_text: string; out out_bonus: Integer): Boolean;
    const
        c_no_preferred_phrase_text = #0;
    var
        normalized_query_local: string;
        cached_text_local: string;
        latest_text_local: string;
        latest_from_session_local: Boolean;
    begin
        out_text := '';
        out_bonus := 0;
        latest_from_session_local := False;
        normalized_query_local := normalize_pinyin_text(query_key);
        if (normalized_query_local = '') or
            (not should_allow_preferred_query_phrase_local(
            normalized_query_local)) then
        begin
            Result := False;
            Exit;
        end;

        if (preferred_query_phrase_text_cache <> nil) and
            preferred_query_phrase_text_cache.TryGetValue(normalized_query_local,
            cached_text_local) then
        begin
            if SameText(cached_text_local, c_no_preferred_phrase_text) then
            begin
                Result := False;
                Exit;
            end;
            out_text := cached_text_local;
            out_bonus := 0;
            if preferred_query_phrase_text_bonus_cache <> nil then
            begin
                preferred_query_phrase_text_bonus_cache.TryGetValue(
                    normalized_query_local, out_bonus);
            end;
            Result := True;
            Exit;
        end;

        latest_text_local := '';
        if (m_session_query_latest_text <> nil) and
            m_session_query_latest_text.TryGetValue(normalized_query_local,
            latest_text_local) then
        begin
            latest_from_session_local := True;
        end
        else if (m_lookup_query_latest_text_cache <> nil) and
            m_lookup_query_latest_text_cache.TryGetValue(normalized_query_local,
            latest_text_local) then
        begin
        end
        else
        begin
            latest_text_local := get_cached_query_latest_choice_text(
                normalized_query_local);
            if m_lookup_query_latest_text_cache <> nil then
            begin
                m_lookup_query_latest_text_cache.AddOrSetValue(
                    normalized_query_local, latest_text_local);
            end;
        end;

        out_text := Trim(latest_text_local);
        out_bonus := 0;
        Result := (out_text <> '') and
            (get_candidate_text_unit_count(out_text) = input_syllable_count) and
            (get_candidate_text_unit_count(out_text) <= 4);
        if Result and (not latest_from_session_local) and (m_dictionary <> nil) and
            is_low_evidence_admin_place_alias_cached(
            normalized_query_local, out_text) then
        begin
            Result := False;
        end;
        if Result then
        begin
            out_bonus := m_dictionary.get_query_choice_bonus(
                normalized_query_local, out_text);
            Result := out_bonus > 0;
        end;
        if Result then
        begin
            Result := not has_stronger_query_choice_bonus_competitor_local(
                normalized_query_local, out_text);
        end;

        if not Result then
        begin
            preferred_query_phrase_text_cache.AddOrSetValue(
                normalized_query_local, c_no_preferred_phrase_text);
            preferred_query_phrase_text_bonus_cache.AddOrSetValue(
                normalized_query_local, 0);
            Exit;
        end;

        preferred_query_phrase_text_cache.AddOrSetValue(normalized_query_local,
            out_text);
        preferred_query_phrase_text_bonus_cache.AddOrSetValue(
            normalized_query_local, out_bonus);
    end;
