procedure TncEngine.note_output_phrase_context(const committed_text: string);
var
    text_key: string;
    current_serial: Int64;
begin
    text_key := Trim(committed_text);
    if text_key = '' then
    begin
        Exit;
    end;

    current_serial := m_session_commit_serial;
    if current_serial <= 0 then
    begin
        current_serial := 1;
    end;

    if m_last_output_commit_text <> '' then
    begin
        track_phrase_context_key(m_last_output_commit_text + #1 + text_key, current_serial);
    end;

    if (m_prev_output_commit_text <> '') and (m_last_output_commit_text <> '') then
    begin
        track_phrase_context_key(
            m_prev_output_commit_text + #2 + m_last_output_commit_text + #1 + text_key,
            current_serial);
    end;

    m_prev_output_commit_text := m_last_output_commit_text;
    m_last_output_commit_text := text_key;
end;

procedure TncEngine.note_segment_path_context(const encoded_path: string);
var
    segments: TArray<string>;
    segment_text: string;
    current_serial: Int64;
    idx: Integer;
    segment_start: Integer;
    segment_idx: Integer;
begin
    if (encoded_path = '') or (m_phrase_context_pairs = nil) or (m_phrase_context_order = nil) then
    begin
        Exit;
    end;

    current_serial := m_session_commit_serial;
    if current_serial <= 0 then
    begin
        current_serial := 1;
    end;

    SetLength(segments, 0);
    segment_start := 1;
    for idx := 1 to Length(encoded_path) + 1 do
    begin
        if (idx <= Length(encoded_path)) and (encoded_path[idx] <> c_segment_path_separator) then
        begin
            Continue;
        end;

        segment_text := Copy(encoded_path, segment_start, idx - segment_start);
        segment_text := Trim(segment_text);
        if segment_text <> '' then
        begin
            segment_idx := Length(segments);
            SetLength(segments, segment_idx + 1);
            segments[segment_idx] := segment_text;
        end;
        segment_start := idx + 1;
    end;

    if Length(segments) <= 1 then
    begin
        Exit;
    end;

    for idx := 1 to High(segments) do
    begin
        track_phrase_context_key(segments[idx - 1] + #1 + segments[idx], current_serial);
        if idx >= 2 then
        begin
            track_phrase_context_key(
                segments[idx - 2] + #2 + segments[idx - 1] + #1 + segments[idx],
                current_serial);
        end;
    end;
end;

procedure TncEngine.record_context_pair(const left_text: string; const committed_text: string);
var
    context_variants: TArray<string>;
    evict_key: string;
    count: Integer;
    key: string;
    variant_idx: Integer;
begin
    if (left_text = '') or (committed_text = '') then
    begin
        Exit;
    end;

    context_variants := get_context_variants(left_text);
    if Length(context_variants) = 0 then
    begin
        Exit;
    end;

    if m_context_db_bonus_cache <> nil then
    begin
        m_context_db_bonus_cache.Clear;
        m_context_db_bonus_cache_key := '';
    end;

    if m_context_pairs = nil then
    begin
        Exit;
    end;

    if m_context_order = nil then
    begin
        Exit;
    end;

    for variant_idx := 0 to High(context_variants) do
    begin
        key := context_variants[variant_idx] + #1 + committed_text;
        if m_context_pairs.TryGetValue(key, count) then
        begin
            Inc(count);
            m_context_pairs.AddOrSetValue(key, count);
        end
        else
        begin
            m_context_pairs.Add(key, 1);
        end;

        m_context_order.Enqueue(key);
        while m_context_order.Count > c_context_history_limit do
        begin
            evict_key := m_context_order.Dequeue;
            if m_context_pairs.TryGetValue(evict_key, count) then
            begin
                Dec(count);
                if count <= 0 then
                begin
                    m_context_pairs.Remove(evict_key);
                end
                else
                begin
                    m_context_pairs.AddOrSetValue(evict_key, count);
                end;
            end;
        end;
    end;
end;

procedure TncEngine.toggle_input_mode;
begin
    if m_config.input_mode = im_chinese then
    begin
        m_config.input_mode := im_english;
    end
    else
    begin
        m_config.input_mode := im_chinese;
    end;

    reset;
end;

function TncEngine.process_key(const key_code: Word; const key_state: TncKeyState): Boolean;
var
    key_char: Char;
    display_key_char: Char;
    index: Integer;
    commit_text: string;
    page_size: Integer;
    page_offset: Integer;
    punct_char: Char;
    punct_text: string;
    candidate: TncCandidate;
    remaining_pinyin: string;
    selected_segment_path: string;

    procedure demote_weak_user_single_chain_before_selection;
    const
        c_low_evidence_user_weight = 8;
    var
        query_units: TncPinyinParseResult;
        query_key: string;
        expected_units: Integer;
        top_candidate_local: TncCandidate;
        best_idx_local: Integer;
        best_score_local: Integer;
        idx: Integer;
        picked_candidate_local: TncCandidate;
        candidate_units_local: Integer;
        comment_units_local: Integer;

        function is_low_evidence_user_single_chain_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            unit_key_local: string;
        begin
            Result := False;
            if (expected_units < 3) or (m_dictionary = nil) or
                (candidate_value.source <> cs_user) or
                (Trim(candidate_value.comment) <> '') or
                (Trim(candidate_value.text) = '') then
            begin
                Exit;
            end;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > c_low_evidence_user_weight) then
            begin
                Exit;
            end;
            if (m_dictionary <> nil) and
                m_dictionary.is_user_entry(query_key,
                Trim(candidate_value.text)) then
            begin
                Exit;
            end;

            text_units_local := split_text_units(Trim(candidate_value.text));
            if Length(text_units_local) <> expected_units then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(text_units_local) do
            begin
                if get_candidate_text_unit_count(text_units_local[unit_idx_local]) <> 1 then
                begin
                    Exit;
                end;
                unit_key_local := normalize_pinyin_text(query_units[unit_idx_local].text);
                if (unit_key_local = '') or
                    (not m_dictionary.single_char_matches_pinyin(unit_key_local,
                    Trim(text_units_local[unit_idx_local]))) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function is_strong_prefix_partial_local(
            const candidate_value: TncCandidate): Boolean;
        begin
            Result := False;
            if (Trim(candidate_value.comment) = '') or
                (not candidate_value.has_dict_weight) then
            begin
                Exit;
            end;
            candidate_units_local := get_candidate_text_unit_count(
                Trim(candidate_value.text));
            if candidate_units_local < 2 then
            begin
                Exit;
            end;
            comment_units_local := get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(Trim(candidate_value.comment)));
            Result := (comment_units_local > 0) and
                (candidate_units_local + comment_units_local = expected_units);
        end;
    begin
        if Length(m_candidates) <= 1 then
        begin
            Exit;
        end;

        query_key := normalize_pinyin_text(m_composition_text);
        query_units := get_effective_compact_pinyin_syllables(query_key, True);
        expected_units := Length(query_units);
        top_candidate_local := m_candidates[0];
        if not is_low_evidence_user_single_chain_local(top_candidate_local) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_score_local := top_candidate_local.score;
        for idx := 1 to High(m_candidates) do
        begin
            if is_strong_prefix_partial_local(m_candidates[idx]) and
                (m_candidates[idx].score > best_score_local) then
            begin
                best_idx_local := idx;
                best_score_local := m_candidates[idx].score;
            end;
        end;

        if best_idx_local <= 0 then
        begin
            Exit;
        end;

        picked_candidate_local := m_candidates[best_idx_local];
        for idx := best_idx_local downto 1 do
        begin
            m_candidates[idx] := m_candidates[idx - 1];
        end;
        m_candidates[0] := picked_candidate_local;
    end;

    function get_selected_candidate(out out_candidate: TncCandidate;
        const use_visible_selection: Boolean = False): Boolean;
    var
        visible_candidate: TncCandidate;
        visible_candidates: TncCandidateList;
        visible_index: Integer;
        mapped_index: Integer;

        function try_use_visible_prefix_partial_for_default_selection(
            const raw_candidate: TncCandidate; out out_visible_candidate: TncCandidate): Boolean;
        var
            visible_candidates: TncCandidateList;
            visible_candidate: TncCandidate;
            query_key: string;
            query_units: TncPinyinParseResult;
            prefix_units: Integer;
            tail_units: Integer;
            prefix_key: string;
            unit_idx: Integer;
            exact_results: TncCandidateList;

            function exact_text_exists_local(const key_value: string;
                const text_value: string; const expected_units: Integer): Boolean;
            var
                exact_text: string;
                exact_idx: Integer;
            begin
                Result := False;
                if (m_dictionary = nil) or (key_value = '') or
                    (text_value = '') then
                begin
                    Exit;
                end;

                if m_dictionary.is_base_entry(key_value, text_value) or
                    m_dictionary.is_user_entry(key_value, text_value) then
                begin
                    Exit(True);
                end;

                if not m_dictionary.lookup_exact_full_pinyin(key_value,
                    exact_results) then
                begin
                    Exit;
                end;

                for exact_idx := 0 to High(exact_results) do
                begin
                    exact_text := Trim(exact_results[exact_idx].text);
                    if (Trim(exact_results[exact_idx].comment) = '') and
                        SameText(exact_text, text_value) and
                        (get_candidate_text_unit_count(exact_text) =
                        expected_units) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            FillChar(out_visible_candidate, SizeOf(out_visible_candidate), 0);
            if (m_dictionary = nil) or (m_page_index <> 0) or
                (m_selected_index <> 0) or (Trim(raw_candidate.comment) <> '') or
                (Trim(raw_candidate.text) = '') or
                (Pos('''', m_composition_text) > 0) then
            begin
                Exit;
            end;

            query_key := normalize_pinyin_text(m_composition_text);
            if (query_key = '') or (not is_full_pinyin_key(query_key)) then
            begin
                Exit;
            end;

            query_units := get_effective_compact_pinyin_syllables(query_key);
            if (Length(query_units) < 3) or (Length(query_units) > 5) or
                (get_candidate_text_unit_count(Trim(raw_candidate.text)) <>
                Length(query_units)) or
                exact_text_exists_local(query_key, Trim(raw_candidate.text),
                Length(query_units)) then
            begin
                Exit;
            end;

            visible_candidates := get_candidates;
            if Length(visible_candidates) = 0 then
            begin
                Exit;
            end;

            visible_candidate := visible_candidates[0];
            if Trim(visible_candidate.comment) = '' then
            begin
                Exit;
            end;

            prefix_units := get_candidate_text_unit_count(
                Trim(visible_candidate.text));
            tail_units := get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(Trim(visible_candidate.comment)));
            if (prefix_units < 2) or (tail_units <= 0) or
                (prefix_units + tail_units <> Length(query_units)) then
            begin
                Exit;
            end;

            prefix_key := '';
            for unit_idx := 0 to prefix_units - 1 do
            begin
                prefix_key := prefix_key + normalize_pinyin_text(
                    query_units[unit_idx].text);
            end;
            if not exact_text_exists_local(prefix_key,
                Trim(visible_candidate.text), prefix_units) then
            begin
                Exit;
            end;

            out_visible_candidate := visible_candidate;
            Result := True;
        end;

        function visible_selection_cache_is_current: Boolean;
        begin
            Result := visible_candidates_cache_is_current(page_size);
        end;

        function get_visible_candidate_source_index(
            const visible_candidate_index: Integer): Integer;
        begin
            Result := -1;
            if (visible_candidate_index < 0) or
                (not visible_selection_cache_is_current) or
                (visible_candidate_index >=
                Length(m_visible_candidate_source_indices_cache)) then
            begin
                Exit;
            end;

            Result :=
                m_visible_candidate_source_indices_cache[visible_candidate_index];
            if (Result < 0) or (Result >= Length(m_candidates)) then
            begin
                Result := -1;
            end;
        end;

    begin
        normalize_page_and_selection;
        page_size := get_candidate_page_size;
        if use_visible_selection and visible_selection_cache_is_current then
        begin
            visible_index := m_selected_index;
            if (visible_index >= 0) and
                (visible_index < Length(m_visible_candidates_cache)) then
            begin
                out_candidate := m_visible_candidates_cache[visible_index];
                mapped_index := get_visible_candidate_source_index(visible_index);
                if mapped_index >= 0 then
                begin
                    index := mapped_index;
                end
                else
                begin
                    index := -1;
                end;
                Result := True;
                Exit;
            end;

            index := -1;
            Result := False;
            Exit;
        end;

        demote_weak_user_single_chain_before_selection;
        page_offset := m_page_index * page_size;
        index := page_offset + m_selected_index;
        if (index >= 0) and (index < Length(m_candidates)) then
        begin
            out_candidate := m_candidates[index];
            visible_index := m_selected_index;
            if use_visible_selection then
            begin
                visible_candidates := get_candidates;
            end
            else
            begin
                SetLength(visible_candidates, 0);
            end;
            if use_visible_selection and (visible_index >= 0) and
                (visible_index < Length(visible_candidates)) then
            begin
                visible_candidate := visible_candidates[visible_index];
                mapped_index := get_visible_candidate_source_index(visible_index);
                if mapped_index >= 0 then
                begin
                    index := mapped_index;
                end;
                if (not SameText(Trim(visible_candidate.text),
                    Trim(out_candidate.text))) or
                    (not SameText(Trim(visible_candidate.comment),
                    Trim(out_candidate.comment))) then
                begin
                    out_candidate := visible_candidate;
                    if mapped_index < 0 then
                    begin
                        index := -1;
                    end;
                    Result := True;
                    Exit;
                end;
            end;
            if try_use_visible_prefix_partial_for_default_selection(
                out_candidate, visible_candidate) then
            begin
                out_candidate := visible_candidate;
                mapped_index := get_visible_candidate_source_index(0);
                if mapped_index >= 0 then
                begin
                    index := mapped_index;
                end
                else
                begin
                    index := -1;
                end;
            end;
            Result := True;
            Exit;
        end;

        index := -1;
        if m_composition_display_text <> '' then
        begin
            out_candidate.text := m_composition_display_text;
        end
        else
        begin
            out_candidate.text := m_composition_text;
        end;
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        Result := True;
    end;

    procedure prefer_longer_default_partial_for_punctuation(
        var io_candidate: TncCandidate; var io_segment_path: string);
    var
        selected_text: string;
        selected_tail: string;
        selected_text_units: Integer;
        selected_tail_units: Integer;
        expected_total_units: Integer;
        idx: Integer;
        probe_limit: Integer;
        candidate_text: string;
        candidate_tail: string;
        candidate_text_units: Integer;
        candidate_tail_units: Integer;
        best_idx: Integer;
        best_score: Integer;
        lookup_results: TncCandidateList;
        lookup_idx: Integer;
        query_key: string;
    begin
        if (m_page_index <> 0) or (m_selected_index <> 0) or
            (Trim(io_candidate.comment) = '') then
        begin
            Exit;
        end;

        selected_text := Trim(io_candidate.text);
        selected_tail := normalize_pinyin_text(Trim(io_candidate.comment));
        selected_text_units := get_candidate_text_unit_count(selected_text);
        selected_tail_units :=
            get_effective_compact_pinyin_unit_count(selected_tail);
        if (selected_text = '') or (selected_text_units <= 0) or
            (selected_tail_units <= 0) then
        begin
            Exit;
        end;
        expected_total_units := selected_text_units + selected_tail_units;

        best_idx := -1;
        best_score := Low(Integer);
        probe_limit := Min(12, Length(m_candidates));
        for idx := 0 to probe_limit - 1 do
        begin
            candidate_tail :=
                normalize_pinyin_text(Trim(m_candidates[idx].comment));
            if candidate_tail = '' then
            begin
                Continue;
            end;

            candidate_text := Trim(m_candidates[idx].text);
            candidate_text_units := get_candidate_text_unit_count(candidate_text);
            candidate_tail_units :=
                get_effective_compact_pinyin_unit_count(candidate_tail);
            if (candidate_text_units <= selected_text_units) or
                (candidate_tail_units <= 0) or
                (candidate_text_units + candidate_tail_units <>
                expected_total_units) or
                (Copy(candidate_text, 1, Length(selected_text)) <>
                selected_text) then
            begin
                Continue;
            end;

            if (best_idx < 0) or
                (candidate_text_units > get_candidate_text_unit_count(
                Trim(m_candidates[best_idx].text))) or
                ((candidate_text_units = get_candidate_text_unit_count(
                Trim(m_candidates[best_idx].text))) and
                (m_candidates[idx].score > best_score)) then
            begin
                best_idx := idx;
                best_score := m_candidates[idx].score;
            end;
        end;

        if best_idx >= 0 then
        begin
            io_candidate := m_candidates[best_idx];
            io_segment_path := get_segment_path_for_candidate(io_candidate,
                best_idx);
            Exit;
        end;

        query_key := normalize_pinyin_text(m_composition_text);
        if (m_dictionary = nil) or (query_key = '') or
            (not m_dictionary.lookup(query_key, lookup_results)) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_score := Low(Integer);
        for lookup_idx := 0 to High(lookup_results) do
        begin
            candidate_tail :=
                normalize_pinyin_text(Trim(lookup_results[lookup_idx].comment));
            if candidate_tail = '' then
            begin
                Continue;
            end;

            candidate_text := Trim(lookup_results[lookup_idx].text);
            candidate_text_units := get_candidate_text_unit_count(candidate_text);
            candidate_tail_units :=
                get_effective_compact_pinyin_unit_count(candidate_tail);
            if (candidate_text_units <= selected_text_units) or
                (candidate_tail_units <= 0) or
                (candidate_text_units + candidate_tail_units <>
                expected_total_units) or
                (Copy(candidate_text, 1, Length(selected_text)) <>
                selected_text) then
            begin
                Continue;
            end;

            if (best_idx < 0) or
                (candidate_text_units > get_candidate_text_unit_count(
                Trim(lookup_results[best_idx].text))) or
                ((candidate_text_units = get_candidate_text_unit_count(
                Trim(lookup_results[best_idx].text))) and
                (lookup_results[lookup_idx].score > best_score)) then
            begin
                best_idx := lookup_idx;
                best_score := lookup_results[lookup_idx].score;
            end;
        end;

        if best_idx >= 0 then
        begin
            io_candidate := lookup_results[best_idx];
            io_segment_path := '';
        end;
    end;

    function is_generic_runtime_chain_selection(const selected: TncCandidate): Boolean;
    begin
        Result := False;
        if (m_runtime_chain_text = '') or selected.has_dict_weight or
            (selected.source <> cs_rule) or (selected.comment <> '') then
        begin
            Exit;
        end;
        Result := SameText(m_runtime_chain_text, selected.text);
    end;

    function is_generated_long_local_rerank_selection(
        const selected: TncCandidate): Boolean;
    begin
        Result := (m_long_local_rerank_generated_text <> '') and
            SameText(m_long_local_rerank_composition_text,
            m_composition_text) and
            SameText(m_long_local_rerank_lookup_key, m_last_lookup_key) and
            SameText(m_long_local_rerank_generated_text,
            Trim(selected.text)) and (Trim(selected.comment) = '');
    end;

    function is_nonlearnable_generated_selection(const selected: TncCandidate): Boolean;
    var
        text_units: Integer;
        idx: Integer;
        full_text: string;
        segment_path: string;
        unit_text: string;
        units: TArray<string>;

        function is_generated_short_exact_pair_selection_local: Boolean;
        var
            query_key_local: string;
            query_syllables_local: TncPinyinParseResult;
            path_local: string;
            parts_local: TArray<string>;
            first_units_local: Integer;
            second_units_local: Integer;
            first_key_local: string;
            second_key_local: string;
            syllable_idx_local: Integer;

            function segment_has_exact_entry_local(const key_value: string;
                const text_value: string;
                const expected_units_value: Integer): Boolean;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (key_value = '') or
                    (text_value = '') or
                    (get_candidate_text_unit_count(text_value) <>
                    expected_units_value) then
                begin
                    Exit;
                end;
                if m_dictionary.is_base_entry(key_value, text_value) or
                    m_dictionary.is_user_entry(key_value, text_value) then
                begin
                    Exit(True);
                end;
                if not m_dictionary.lookup_exact_full_pinyin(key_value,
                    exact_results_local) then
                begin
                    Exit;
                end;
                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    exact_text_local := Trim(
                        exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(exact_text_local, Trim(text_value)) and
                        (get_candidate_text_unit_count(exact_text_local) =
                        expected_units_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (selected.source <> cs_rule) or
                (Trim(selected.comment) <> '') or
                (get_candidate_text_unit_count(Trim(selected.text)) <> 3) then
            begin
                Exit;
            end;

            query_key_local := normalize_pinyin_text(m_last_lookup_key);
            query_syllables_local := get_effective_compact_pinyin_syllables(
                query_key_local);
            if (query_key_local = '') or (Length(query_syllables_local) <> 3) or
                segment_has_exact_entry_local(query_key_local,
                Trim(selected.text), 3) then
            begin
                Exit;
            end;

            path_local := get_segment_path_for_candidate(selected);
            if get_encoded_path_segment_count_local(path_local) <> 2 then
            begin
                Exit;
            end;
            parts_local := path_local.Split([c_segment_path_separator]);
            if Length(parts_local) <> 2 then
            begin
                Exit;
            end;
            first_units_local := get_candidate_text_unit_count(
                Trim(parts_local[0]));
            second_units_local := get_candidate_text_unit_count(
                Trim(parts_local[1]));
            if (first_units_local < 1) or (first_units_local > 2) or
                (second_units_local < 1) or (second_units_local > 2) or
                (first_units_local + second_units_local <> 3) or
                (not SameText(Trim(parts_local[0]) + Trim(parts_local[1]),
                Trim(selected.text))) then
            begin
                Exit;
            end;

            first_key_local := '';
            for syllable_idx_local := 0 to first_units_local - 1 do
            begin
                first_key_local := first_key_local + normalize_pinyin_text(
                    query_syllables_local[syllable_idx_local].text);
            end;
            second_key_local := '';
            for syllable_idx_local := first_units_local to 2 do
            begin
                second_key_local := second_key_local + normalize_pinyin_text(
                    query_syllables_local[syllable_idx_local].text);
            end;
            Result := segment_has_exact_entry_local(first_key_local,
                Trim(parts_local[0]), first_units_local) and
                segment_has_exact_entry_local(second_key_local,
                Trim(parts_local[1]), second_units_local);
        end;
    begin
        Result := False;
        if (selected.display_kind = cdk_lm_compound) and
            (Trim(selected.comment) = '') then
        begin
            Exit(True);
        end;
        if is_generated_short_exact_pair_selection_local then
        begin
            Exit(True);
        end;
        if not is_generic_runtime_chain_selection(selected) then
        begin
            Exit;
        end;

        segment_path := get_segment_path_for_candidate(selected);
        if segment_path <> '' then
        begin
            Exit(False);
        end;

        full_text := selected.text;
        if m_confirmed_text <> '' then
        begin
            full_text := m_confirmed_text + full_text;
        end;

        text_units := get_candidate_text_unit_count(full_text);
        if text_units >= 4 then
        begin
            units := split_text_units(full_text);
            Result := Length(units) = text_units;
            if Result then
            begin
                for idx := 0 to High(units) do
                begin
                    unit_text := Trim(units[idx]);
                    if (unit_text = '') or (Length(unit_text) <> 1) or (Ord(unit_text[1]) <= $7F) then
                    begin
                        Result := False;
                        Break;
                    end;
                end;
            end;
            if Result then
            begin
                Exit(False);
            end;
        end;

        Result := True;
    end;

    function is_compact_ascii_pinyin(const value: string): Boolean;
    var
        idx: Integer;
        ch: Char;
    begin
        Result := value <> '';
        if not Result then
        begin
            Exit;
        end;

        for idx := 1 to Length(value) do
        begin
            ch := value[idx];
            if not (((ch >= 'a') and (ch <= 'z')) or ((ch >= 'A') and (ch <= 'Z'))) then
            begin
                Result := False;
                Exit;
            end;
        end;
    end;

    function get_display_remaining_pinyin_for_partial(const selected_text: string;
        const remaining_pinyin_value: string): string;
    var
        display_text: string;
        normalized_remaining: string;
        suffix_text: string;
        parser: TncPinyinParser;
        display_syllables: TncPinyinParseResult;
        consumed_units: Integer;
        suffix_start: Integer;
        composition_key: string;
        candidate_tail: string;
        candidate_prefix: string;
        aligned_tail: string;
        total_units: Integer;
        prefix_units: Integer;
        tail_units: Integer;
        candidate_idx: Integer;
    begin
        Result := remaining_pinyin_value;
        normalized_remaining := normalize_pinyin_text(remaining_pinyin_value);
        if normalized_remaining = '' then
        begin
            Exit;
        end;

        consumed_units := get_candidate_text_unit_count(Trim(selected_text));
        composition_key := normalize_pinyin_text(m_composition_text);
        if (not is_shuangpin_input) and
            (Pos('''', m_composition_display_text) <= 0) and
            (composition_key <> '') and (consumed_units > 0) then
        begin
            total_units := get_effective_compact_pinyin_unit_count(
                composition_key);
            aligned_tail := '';
            for candidate_idx := 0 to High(m_candidates) do
            begin
                if not SameText(Trim(m_candidates[candidate_idx].text),
                    Trim(selected_text)) then
                begin
                    Continue;
                end;
                candidate_tail := normalize_pinyin_text(
                    Trim(m_candidates[candidate_idx].comment));
                if (candidate_tail = '') or
                    (Length(candidate_tail) >= Length(composition_key)) or
                    (not SameText(Copy(composition_key,
                    Length(composition_key) - Length(candidate_tail) + 1,
                    Length(candidate_tail)), candidate_tail)) then
                begin
                    Continue;
                end;
                candidate_prefix := Copy(composition_key, 1,
                    Length(composition_key) - Length(candidate_tail));
                prefix_units := get_effective_compact_pinyin_unit_count(
                    candidate_prefix);
                tail_units := get_effective_compact_pinyin_unit_count(
                    candidate_tail);
                if (prefix_units = consumed_units) and
                    (tail_units = total_units - consumed_units) and
                    (Length(candidate_tail) > Length(aligned_tail)) then
                begin
                    aligned_tail := candidate_tail;
                end;
            end;
            if aligned_tail <> '' then
            begin
                Result := aligned_tail;
                normalized_remaining := aligned_tail;
            end;
        end;

        display_text := m_composition_display_text;
        if display_text = '' then
        begin
            display_text := m_composition_text;
        end;
        if display_text = '' then
        begin
            Exit;
        end;

        if Pos('''', display_text) <= 0 then
        begin
            // Lookup uses canonical spelling; partial selection must retain
            // the user's equal-length alias in the unconsumed input.
            if (not is_shuangpin_input) and
                (Length(normalized_remaining) < Length(display_text)) then
            begin
                suffix_text := Copy(display_text,
                    Length(display_text) - Length(normalized_remaining) + 1,
                    Length(normalized_remaining));
                if SameText(normalize_pinyin_text(suffix_text), normalized_remaining) then
                    Result := suffix_text;
            end;
            Exit;
        end;

        if consumed_units <= 0 then
        begin
            Exit;
        end;

        parser := TncPinyinParser.Create;
        try
            display_syllables := parser.parse(display_text);
        finally
            parser.Free;
        end;

        if consumed_units >= Length(display_syllables) then
        begin
            Exit;
        end;

        suffix_start := display_syllables[consumed_units].start_index + 1;
        if (suffix_start < 1) or (suffix_start > Length(display_text)) then
        begin
            Exit;
        end;

        suffix_text := Copy(display_text, suffix_start,
            Length(display_text) - suffix_start + 1);
        if SameText(normalize_pinyin_text(suffix_text), normalized_remaining) then
        begin
            Result := suffix_text;
        end;
    end;

    function try_apply_trailing_pinyin_candidate(const candidate_text: string): Boolean;
    var
        head_text: string;
        tail_pinyin: string;
        normalized_pinyin: string;
        idx: Integer;
        tail_len: Integer;
        ch: Char;
        head_has_non_ascii: Boolean;
        function is_ascii_letter(const value: Char): Boolean;
        begin
            Result := (value >= 'a') and (value <= 'z') or (value >= 'A') and (value <= 'Z');
        end;
    begin
        Result := False;
        head_text := '';
        tail_pinyin := '';
        if candidate_text = '' then
        begin
            Exit;
        end;

        idx := Length(candidate_text);
        while idx > 0 do
        begin
            ch := candidate_text[idx];
            if not is_ascii_letter(ch) then
            begin
                Break;
            end;
            Dec(idx);
        end;

        if idx = Length(candidate_text) then
        begin
            Exit;
        end;

        head_text := Copy(candidate_text, 1, idx);
        tail_pinyin := Copy(candidate_text, idx + 1, Length(candidate_text) - idx);
        if (head_text = '') or (tail_pinyin = '') then
        begin
            Exit;
        end;

        head_has_non_ascii := False;
        for idx := 1 to Length(head_text) do
        begin
            if Ord(head_text[idx]) > $7F then
            begin
                head_has_non_ascii := True;
                Break;
            end;
        end;
        if not head_has_non_ascii then
        begin
            Exit;
        end;

        normalized_pinyin := normalize_pinyin_text(m_composition_text);
        tail_len := Length(tail_pinyin);
        if (tail_len > 0) and (tail_len <= Length(normalized_pinyin)) then
        begin
            if SameText(Copy(normalized_pinyin, Length(normalized_pinyin) - tail_len + 1, tail_len), tail_pinyin) then
            begin
                tail_pinyin := get_display_remaining_pinyin_for_partial(
                    head_text, tail_pinyin);
                apply_partial_commit(head_text, tail_pinyin, '', False,
                    get_shuangpin_remaining_input_code_for_partial(head_text));
                Result := True;
            end;
        end;
    end;

    function apply_candidate_selection(const selected: TncCandidate;
        const selected_candidate_index: Integer = -1;
        const explicit_selection: Boolean = False;
        const manual_selection: Boolean = False): Boolean;
    var
        allow_learning: Boolean;
        segment_path: string;
        top_candidate: TncCandidate;
        top_score: Integer;
        selected_score: Integer;
        top_confidence_rank: Integer;
        selected_confidence_rank: Integer;
        top_segment_path: string;
        partial_remaining_pinyin: string;
        generated_long_local_rerank_selection: Boolean;
        nonlearnable_generated_selection: Boolean;
        short_exact_lexicon_completion_selection: Boolean;

        function split_encoded_path(const encoded_path: string): TArray<string>;
        var
            idx: Integer;
            start_idx: Integer;
            segment_text: string;
            count: Integer;
        begin
            SetLength(Result, 0);
            start_idx := 1;
            for idx := 1 to Length(encoded_path) + 1 do
            begin
                if (idx <= Length(encoded_path)) and (encoded_path[idx] <> c_segment_path_separator) then
                begin
                    Continue;
                end;

                segment_text := Trim(Copy(encoded_path, start_idx, idx - start_idx));
                if segment_text <> '' then
                begin
                    count := Length(Result);
                    SetLength(Result, count + 1);
                    Result[count] := segment_text;
                end;
                start_idx := idx + 1;
            end;
        end;

        procedure record_divergent_query_path_prefix_penalties(const selected_path: string;
            const wrong_path: string);
        var
            selected_segments: TArray<string>;
            wrong_segments: TArray<string>;
            shared_count: Integer;
            prefix_idx: Integer;
            prefix_path: string;
            prefix_query: string;
        begin
            if (m_dictionary = nil) or (selected_path = '') or (wrong_path = '') then
            begin
                Exit;
            end;
            if (get_encoded_path_segment_count_local(selected_path) <= 1) or
                (get_encoded_path_segment_count_local(wrong_path) <= 1) then
            begin
                Exit;
            end;

            selected_segments := split_encoded_path(selected_path);
            wrong_segments := split_encoded_path(wrong_path);
            if (Length(selected_segments) = 0) or (Length(wrong_segments) <= 2) then
            begin
                Exit;
            end;

            shared_count := 0;
            while (shared_count < Length(selected_segments)) and (shared_count < Length(wrong_segments)) and
                SameText(Trim(selected_segments[shared_count]), Trim(wrong_segments[shared_count])) do
            begin
                Inc(shared_count);
            end;

            prefix_path := '';
            for prefix_idx := 0 to High(wrong_segments) - 1 do
            begin
                if prefix_path <> '' then
                begin
                    prefix_path := prefix_path + c_segment_path_separator;
                end;
                prefix_path := prefix_path + wrong_segments[prefix_idx];
                if (prefix_idx + 1 < 2) or (prefix_idx + 1 <= shared_count) then
                begin
                    Continue;
                end;

                prefix_query := get_query_prefix_for_segment_path(prefix_path);
                if prefix_query <> '' then
                begin
                    note_session_query_path_penalty(prefix_query, prefix_path);
                    m_dictionary.record_query_segment_path_penalty(prefix_query, prefix_path);
                end;
            end;
        end;

        function is_generated_short_particle_tail_selection(
            const selected_value: TncCandidate): Boolean;
        var
            query_key_local: string;
            text_key_local: string;
            tail_key_local: string;
            tail_text_local: string;
            head_key_local: string;
            head_text_local: string;
            text_units_local: TArray<string>;
            head_unit_count_local: Integer;
            unit_idx_local: Integer;

            function try_get_tail_local: Boolean;
            begin
                Result := try_get_short_particle_tail_query_parts(
                    query_key_local, tail_key_local, tail_text_local,
                    head_key_local);
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (selected_value.source <> cs_rule) or
                (Trim(selected_value.comment) <> '') then
            begin
                Exit;
            end;

            query_key_local := normalize_pinyin_text(m_last_lookup_key);
            text_key_local := Trim(selected_value.text);
            if (query_key_local = '') or (text_key_local = '') or
                (not is_full_pinyin_key(query_key_local)) or
                m_dictionary.is_base_entry(query_key_local, text_key_local) or
                m_dictionary.is_user_entry(query_key_local, text_key_local) or
                (not try_get_tail_local) then
            begin
                Exit;
            end;

            head_unit_count_local :=
                get_effective_compact_pinyin_unit_count(head_key_local);
            if (head_key_local = '') or (head_unit_count_local < 2) or
                (head_unit_count_local > 3) then
            begin
                Exit;
            end;

            text_units_local := split_text_units(text_key_local);
            if (Length(text_units_local) <> head_unit_count_local + 1) or
                (not SameText(Trim(text_units_local[High(text_units_local)]),
                tail_text_local)) then
            begin
                Exit;
            end;

            head_text_local := '';
            for unit_idx_local := 0 to High(text_units_local) - 1 do
            begin
                head_text_local := head_text_local + text_units_local[unit_idx_local];
            end;

            Result := (head_text_local <> '') and
                (m_dictionary.is_base_entry(head_key_local, head_text_local) or
                m_dictionary.is_user_entry(head_key_local, head_text_local));
        end;
    begin
        segment_path := get_segment_path_for_candidate(selected, selected_candidate_index);
        if (selected.comment <> '') and is_compact_ascii_pinyin(selected.comment) then
        begin
            if segment_path = '' then
            begin
                segment_path := infer_segment_path_for_selected_text(selected.text);
            end;
            partial_remaining_pinyin := get_display_remaining_pinyin_for_partial(
                selected.text, selected.comment);
            apply_partial_commit(selected.text, partial_remaining_pinyin, segment_path,
                explicit_selection,
                get_shuangpin_remaining_input_code_for_partial(selected.text),
                manual_selection and ((not is_fuzzy_pinyin_active) or
                (selected.fuzzy_cost <= 0)),
                is_fuzzy_pinyin_active and (selected.fuzzy_cost > 0));
            Result := True;
            Exit;
        end;

        if try_apply_trailing_pinyin_candidate(selected.text) then
        begin
            Result := True;
            Exit;
        end;

        generated_long_local_rerank_selection :=
            is_generated_long_local_rerank_selection(selected);
        nonlearnable_generated_selection :=
            is_nonlearnable_generated_selection(selected);
        short_exact_lexicon_completion_selection :=
            is_current_short_exact_lexicon_completion(m_last_lookup_key,
            selected.text) and
            (Trim(selected.comment) = '');
        if (segment_path = '') and (selected.comment = '') and
            (not generated_long_local_rerank_selection) then
        begin
            segment_path := infer_segment_path_for_selected_text(selected.text);
        end;

        allow_learning := ((not is_fuzzy_pinyin_active) or
            (selected.fuzzy_cost <= 0)) and
            (not generated_long_local_rerank_selection) and
            (not nonlearnable_generated_selection) and
            (not short_exact_lexicon_completion_selection);
        if allow_learning and is_generated_short_particle_tail_selection(selected) then
        begin
            allow_learning := False;
        end;
        if allow_learning and has_competing_exact_phrase_candidate(selected.text) and
            is_problematic_single_char_chain_candidate_for_query(m_last_lookup_key, selected) then
        begin
            allow_learning := False;
        end;
        if ((not is_fuzzy_pinyin_active) or
            (selected.fuzzy_cost <= 0)) and (not allow_learning) and
            explicit_selection and (m_dictionary <> nil) and
            (Trim(selected.comment) = '') and (get_candidate_text_unit_count(selected.text) = 1) and
            (m_last_lookup_key <> '') and m_dictionary.single_char_matches_pinyin(
            m_last_lookup_key, selected.text) then
        begin
            // A user explicitly picking a matching single character for an
            // exact pinyin query is intentional and must survive host restarts.
            allow_learning := True;
        end;

        if ((not is_fuzzy_pinyin_active) or
            (selected.fuzzy_cost <= 0)) and (m_last_lookup_key <> '') and
            (selected_candidate_index > 0) and
            (Length(m_candidates) > 0) and
            (not short_exact_lexicon_completion_selection) then
        begin
            top_candidate := m_candidates[0];
            if (top_candidate.comment = '') and (selected.comment = '') and
                    (top_candidate.text <> '') and (selected.text <> '') and
                    (top_candidate.text <> selected.text) and
                    (not generated_long_local_rerank_selection) and
                    (not nonlearnable_generated_selection) then
            begin
                top_score := get_rank_score(top_candidate);
                selected_score := get_rank_score(selected);
                top_confidence_rank := get_candidate_confidence_rank(top_candidate);
                selected_confidence_rank := get_candidate_confidence_rank(selected);
                if (selected_confidence_rank < top_confidence_rank) or
                    ((top_score - selected_score) <= 160) or
                    is_runtime_chain_candidate(top_candidate) or
                    ((top_candidate.source = cs_rule) and (not top_candidate.has_dict_weight) and
                    (not is_runtime_common_pattern_candidate(top_candidate)) and
                    (not is_runtime_redup_candidate(top_candidate))) then
                begin
                    if m_dictionary <> nil then
                    begin
                        m_dictionary.record_candidate_penalty(m_last_lookup_key, top_candidate.text);
                        top_segment_path := get_segment_path_for_candidate(top_candidate, 0);
                        if (top_segment_path = '') and (top_candidate.comment = '') then
                        begin
                            top_segment_path := infer_segment_path_for_selected_text(top_candidate.text);
                        end;
                        if (segment_path <> '') and (top_segment_path <> '') and
                            (segment_path <> top_segment_path) and
                            (get_encoded_path_segment_count_local(segment_path) > 1) and
                            (get_encoded_path_segment_count_local(top_segment_path) > 1) then
                        begin
                            record_divergent_query_path_prefix_penalties(segment_path, top_segment_path);
                            note_session_query_path_penalty(m_last_lookup_key, top_segment_path);
                            m_dictionary.record_query_segment_path_penalty(m_last_lookup_key, top_segment_path);
                        end;
                    end;
                end;
            end;
        end;

        set_pending_commit(selected.text, '', allow_learning,
            segment_path, explicit_selection, '',
            manual_selection and ((not is_fuzzy_pinyin_active) or
            (selected.fuzzy_cost <= 0)),
            is_fuzzy_pinyin_active and (selected.fuzzy_cost > 0), '',
            nonlearnable_generated_selection or
            short_exact_lexicon_completion_selection);
        Result := True;
    end;
begin
    Result := False;
    m_composition_built_incrementally := True;
    if nc_shortcut_matches(m_config.shortcuts.input_mode_toggle, key_code, key_state) then
    begin
        toggle_input_mode;
        Result := True;
        Exit;
    end;

    if nc_shortcut_matches(m_config.shortcuts.full_width_toggle, key_code, key_state) then
    begin
        m_config.full_width_mode := not m_config.full_width_mode;
        Result := True;
        Exit;
    end;

    if nc_shortcut_matches(m_config.shortcuts.punctuation_toggle, key_code, key_state) then
    begin
        m_config.punctuation_full_width := not m_config.punctuation_full_width;
        Result := True;
        Exit;
    end;

    if key_state.ctrl_down or key_state.alt_down then
    begin
        Exit(False);
    end;

    if m_config.input_mode = im_english then
    begin
        if get_direct_ascii_commit_text(key_code, key_state, commit_text) then
        begin
            set_pending_commit(commit_text);
            Exit(True);
        end;
        Exit(False);
    end;

    if m_composition_text <> '' then
    begin
        normalize_page_and_selection;
    end;

    if is_alpha_key(key_code, key_state, key_char, display_key_char) then
    begin
        clear_pending_commit;
        if is_shuangpin_input then
        begin
            m_composition_display_text := m_composition_display_text + display_key_char;
            rebuild_shuangpin_composition_from_input_code;
        end
        else
        begin
            m_composition_text := m_composition_text + key_char;
            m_composition_display_text := m_composition_display_text + display_key_char;
        end;
        build_candidates;
        Result := True;
        Exit;
    end;

    if (key_code = VK_OEM_1) and (not key_state.shift_down) and
        (not key_state.ctrl_down) and (not key_state.alt_down) and
        nc_shuangpin_accepts_semicolon(m_config.pinyin_input_scheme,
        m_composition_display_text) then
    begin
        clear_pending_commit;
        m_composition_display_text := m_composition_display_text + ';';
        rebuild_shuangpin_composition_from_input_code;
        build_candidates;
        Result := True;
        Exit;
    end;

    if (m_one_key_completion.text <> '') and
        nc_one_key_completion_matches(m_config.one_key_completion_key,
        key_code, key_state) then
    begin
        Result := accept_one_key_completion;
        Exit;
    end;

    if (m_config.one_key_completion_key = ock_backtick) and
        (m_composition_text <> '') and
        nc_one_key_completion_matches(m_config.one_key_completion_key,
        key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if (key_code = VK_OEM_3) and (m_composition_text <> '') and (not key_state.shift_down) and
        (not key_state.ctrl_down) and (not key_state.alt_down) then
    begin
        reset;
        Result := True;
        Exit;
    end;

    if ((m_composition_text <> '') or (m_confirmed_text <> '') or
        (Length(m_candidates) > 0)) and (not key_state.ctrl_down) and
        (not key_state.alt_down) then
    begin
        if nc_candidate_page_key_matches_next(
            m_config.candidate_page_key_scheme, key_code, key_state) then
        begin
            next_page;
            Result := True;
            Exit;
        end;

        if nc_candidate_page_key_matches_previous(
            m_config.candidate_page_key_scheme, key_code, key_state) then
        begin
            prev_page;
            Result := True;
            Exit;
        end;
    end;

    if get_punctuation_char(key_code, key_state, punct_char) then
    begin
        if (key_code <> VK_OEM_7) or (m_composition_text = '') then
        begin
            if (key_code = VK_ADD) or (key_code = VK_SUBTRACT) or
                (key_code = VK_MULTIPLY) then
            begin
                punct_text := punct_char;
            end
            else
            begin
                punct_text := map_punctuation_char(punct_char);
            end;
            if (m_composition_text <> '') or (m_confirmed_text <> '') then
            begin
                commit_text := punct_text;
                if m_composition_text <> '' then
                begin
                    get_selected_candidate(candidate);
                    selected_segment_path := get_segment_path_for_candidate(candidate,
                        index);
                    prefer_longer_default_partial_for_punctuation(candidate,
                        selected_segment_path);
                    if candidate.comment <> '' then
                    begin
                        remaining_pinyin := get_display_remaining_pinyin_for_partial(
                            candidate.text, candidate.comment);
                        apply_partial_commit(candidate.text, remaining_pinyin,
                            selected_segment_path, False,
                            get_shuangpin_remaining_input_code_for_partial(
                            candidate.text), False,
                            is_fuzzy_pinyin_active and
                            (candidate.fuzzy_cost > 0));
                        set_pending_commit(punct_text, remaining_pinyin, False);
                    end
                    else
                    begin
                        commit_text := candidate.text + punct_text;
                        set_pending_commit(commit_text, '',
                            ((not is_fuzzy_pinyin_active) or
                            (candidate.fuzzy_cost <= 0)) and
                            (not is_nonlearnable_generated_selection(candidate)),
                            selected_segment_path, False, '', False,
                            is_fuzzy_pinyin_active and
                            (candidate.fuzzy_cost > 0), candidate.text,
                            is_nonlearnable_generated_selection(candidate));
                    end;
                    Result := True;
                    Exit;
                end;

                set_pending_commit(commit_text);
                Result := True;
                Exit;
            end;

            if get_effective_punctuation_full_width or m_config.full_width_mode then
            begin
                set_pending_commit(punct_text);
                Result := True;
                Exit;
            end;

            Exit(False);
        end;
    end;

    case key_code of
        VK_BACK:
            begin
                // When there is confirmed segmented prefix, Backspace should first
                // rollback that prefix to pinyin so users can reselect without
                // deleting the entire remaining tail.
                if (m_confirmed_segments <> nil) and (m_confirmed_segments.Count > 0) then
                begin
                    Result := rollback_last_segment;
                end;
                if (not Result) and (m_composition_text <> '') then
                begin
                    clear_pending_commit;
                    if is_shuangpin_input then
                    begin
                        if m_composition_display_text <> '' then
                        begin
                            Delete(m_composition_display_text,
                                Length(m_composition_display_text), 1);
                        end;
                        rebuild_shuangpin_composition_from_input_code;
                    end
                    else
                    begin
                        Delete(m_composition_text, Length(m_composition_text), 1);
                        if m_composition_display_text <> '' then
                        begin
                            Delete(m_composition_display_text,
                                Length(m_composition_display_text), 1);
                        end;
                    end;
                    build_candidates;
                    Result := True;
                end;
            end;
        VK_OEM_7:
            begin
                if m_composition_text <> '' then
                begin
                    clear_pending_commit;
                    if is_shuangpin_input then
                    begin
                        if (m_composition_display_text <> '') and
                            (m_composition_display_text[Length(m_composition_display_text)] <> '''') then
                        begin
                            m_composition_display_text := m_composition_display_text + '''';
                            rebuild_shuangpin_composition_from_input_code;
                            build_candidates;
                        end;
                    end
                    else if m_composition_text[Length(m_composition_text)] <> '''' then
                    begin
                        m_composition_text := m_composition_text + '''';
                        m_composition_display_text := m_composition_display_text + '''';
                        build_candidates;
                    end;

                    Result := True;
                end;
            end;
        VK_ESCAPE:
            begin
                if (m_composition_text <> '') or (m_confirmed_text <> '') or (Length(m_candidates) > 0) or
                    m_has_pending_commit then
                begin
                    reset;
                    Result := True;
                end;
            end;
        VK_SPACE:
            begin
                if m_composition_text <> '' then
                begin
                    if get_selected_candidate(candidate, True) then
                    begin
                        // Space confirms the selected candidate with the same
                        // learning semantics as its numeric selection key.
                        Result := apply_candidate_selection(candidate, index,
                            True, True);
                    end;
                end
                else if m_confirmed_text <> '' then
                begin
                    set_pending_commit('');
                    Result := True;
                end;
            end;
        VK_RETURN:
            begin
                if m_composition_text <> '' then
                begin
                    // Enter should commit raw input text instead of selecting candidate.
                    set_pending_commit(get_raw_composition_commit_text);
                    Result := True;
                end
                else if m_confirmed_text <> '' then
                begin
                    set_pending_commit('');
                    Result := True;
                end;
            end;
        VK_PRIOR:
            begin
                if (m_composition_text <> '') or (m_confirmed_text <> '') or
                    (Length(m_candidates) > 0) then
                begin
                    if (m_composition_text <> '') or (Length(m_candidates) > 0) then
                    begin
                        prev_page;
                    end;
                    Result := True;
                end;
            end;
        VK_NEXT:
            begin
                if (m_composition_text <> '') or (m_confirmed_text <> '') or
                    (Length(m_candidates) > 0) then
                begin
                    if (m_composition_text <> '') or (Length(m_candidates) > 0) then
                    begin
                        next_page;
                    end;
                    Result := True;
                end;
            end;
        VK_LEFT, VK_UP:
            begin
                if (m_composition_text <> '') and (not key_state.shift_down) and (not key_state.ctrl_down) and
                    (not key_state.alt_down) then
                begin
                    if (key_code = VK_UP) and m_config.candidate_expand_on_paging then
                    begin
                        set_candidate_paging_expanded(True);
                        prev_page;
                        Exit(True);
                    end;
                    page_size := get_candidate_page_size;
                    if page_size <= 0 then
                    begin
                        page_size := c_default_page_size;
                    end;

                    normalize_page_and_selection;
                    if m_selected_index > 0 then
                    begin
                        m_candidate_navigation_started := True;
                        Dec(m_selected_index);
                    end
                    else if m_page_index > 0 then
                    begin
                        m_candidate_navigation_started := True;
                        Dec(m_page_index);
                        index := get_current_page_candidate_count(page_size);
                        if index > 0 then
                        begin
                            m_selected_index := index - 1;
                        end
                        else
                        begin
                            m_selected_index := 0;
                        end;
                    end;
                    normalize_page_and_selection;
                    Result := True;
                end;
            end;
        VK_RIGHT, VK_DOWN:
            begin
                if (m_composition_text <> '') and (not key_state.shift_down) and (not key_state.ctrl_down) and
                    (not key_state.alt_down) then
                begin
                    if (key_code = VK_DOWN) and m_config.candidate_expand_on_paging then
                    begin
                        set_candidate_paging_expanded(True);
                        next_page;
                        Exit(True);
                    end;
                    page_size := get_candidate_page_size;
                    if page_size <= 0 then
                    begin
                        page_size := c_default_page_size;
                    end;

                    normalize_page_and_selection;
                    index := get_current_page_candidate_count(page_size);

                    if (index > 0) and (m_selected_index < index - 1) then
                    begin
                        m_candidate_navigation_started := True;
                        Inc(m_selected_index);
                    end
                    else if m_page_index < get_page_count_internal(page_size) - 1 then
                    begin
                        m_candidate_navigation_started := True;
                        Inc(m_page_index);
                        m_selected_index := 0;
                        normalize_page_and_selection;
                    end;
                    Result := True;
                end;
            end;
        Ord('1')..Ord('9'):
            begin
                if m_composition_text <> '' then
                begin
                    page_size := get_candidate_page_size;
                    index := key_code - Ord('1');
                    if (index < page_size) and
                        (index < get_current_page_candidate_count(page_size)) then
                    begin
                        m_selected_index := index;
                        if get_selected_candidate(candidate, True) then
                        begin
                            Result := apply_candidate_selection(candidate, index,
                                True, True);
                        end;
                    end
                    else
                    begin
                        set_pending_commit(get_raw_composition_commit_text);
                        Result := True;
                    end;
                end
                else if m_confirmed_text <> '' then
                begin
                    set_pending_commit(Char(key_code));
                    Result := True;
                end;
            end;
    end;
end;

function TncEngine.get_candidates: TncCandidateList;
var
    page_size: Integer;
    visible_page_size: Integer;
    page_count: Integer;
    start_index: Integer;
    end_index: Integer;
    normalized_pinyin: string;
    candidate: TncCandidate;
    head_text: string;
    tail_pinyin: string;
    user_entry_query: string;
    syllables: TncPinyinParseResult;
    relaxed_single_syllables: TncPinyinParseResult;
    expected_units: Integer;
    entry_top_candidate: TncCandidate;
    entry_top_path: string;
    has_entry_pathful_complete_top: Boolean;
    display_phase_tick: UInt64;
    long_display_fast_path: Boolean;
    short_exact_query_mode: Boolean;
    short_exact_predictive_prefix_only_mode: Boolean;
    short_nocontext_promoted_exact_text: string;
    short_nocontext_promoted_exact_lead: Integer;
    short_context_promoted_exact_text: string;
    short_context_promoted_exact_lead: Integer;
    short_context_swapped: Boolean;
    char_lm_context: string;
    promoted_repeated_initial_count: Integer;
    repeated_initial_display_source_candidates: TncCandidateList;
    explicit_apostrophe_entry_top_partial_candidate: TncCandidate;
    has_explicit_apostrophe_entry_top_partial_candidate: Boolean;
    visible_ranked_top_path: string;
    visible_ranked_source_index: Integer;
    relaxed_boundary_cache_ready: Boolean;
    relaxed_boundary_cache_found: Boolean;
    relaxed_boundary_cache_head_key: string;
    relaxed_boundary_cache_tail_key: string;
    relaxed_boundary_cache_head_units: Integer;
    relaxed_boundary_cache_tail_units: Integer;
    display_query_key_cache: TArray<string>;
    display_normalized_syllable_cache: TArray<string>;
    candidate_idx: Integer;
    cached_page_sources: TArray<Integer>;
    umlaut_raw_prefixes_ready: Boolean;
    umlaut_raw_prefixes: TncCandidateList;

    function is_short_repeated_initial_display_query_local: Boolean;
    var
        normalized_query_local: string;
        idx_local: Integer;
    begin
        Result := False;
        normalized_query_local := normalize_pinyin_text(normalized_pinyin);
        if (Length(normalized_query_local) < 2) or
            (Length(normalized_query_local) > 3) then
        begin
            Exit;
        end;

        for idx_local := 1 to Length(normalized_query_local) do
        begin
            if (not CharInSet(normalized_query_local[idx_local], ['b', 'p',
                'm', 'f', 'd', 't', 'n', 'l', 'g', 'k', 'h', 'j', 'q',
                'x', 'z', 'c', 's', 'r', 'y', 'w'])) or
                ((idx_local > 1) and
                (normalized_query_local[idx_local] <> normalized_query_local[1])) then
            begin
                Exit;
            end;
        end;

        Result := True;
    end;

    procedure capture_repeated_initial_display_source_candidates;
    begin
        SetLength(repeated_initial_display_source_candidates, 0);
        if (Length(m_candidates) <= 0) or
            (not is_short_repeated_initial_display_query_local) then
        begin
            Exit;
        end;

        repeated_initial_display_source_candidates :=
            Copy(m_candidates, 0, Length(m_candidates));
    end;

    function get_display_raw_query_text_local: string;
    begin
        if m_composition_display_text <> '' then
        begin
            Result := m_composition_display_text;
        end
        else
        begin
            Result := m_composition_text;
        end;
    end;

    procedure capture_explicit_apostrophe_entry_top_partial_candidate;
    begin
        has_explicit_apostrophe_entry_top_partial_candidate := False;
        FillChar(explicit_apostrophe_entry_top_partial_candidate,
            SizeOf(explicit_apostrophe_entry_top_partial_candidate), 0);
        if (Pos('''', get_display_raw_query_text_local) <= 0) or
            (Length(m_candidates) <= 0) or
            (Trim(m_candidates[0].comment) = '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) < 2) then
        begin
            Exit;
        end;

        explicit_apostrophe_entry_top_partial_candidate := m_candidates[0];
        has_explicit_apostrophe_entry_top_partial_candidate := True;
    end;

    function get_display_query_syllables_local(
        const raw_query_text: string): TncPinyinParseResult;
    var
        parser_local: TncPinyinParser;
        tokens_local: TArray<string>;
        token_idx_local: Integer;
        part_idx_local: Integer;
        out_idx_local: Integer;
        compact_offset_local: Integer;
        token_text_local: string;
        token_parts_local: TncPinyinParseResult;
    begin
        if Pos('''', raw_query_text) <= 0 then
        begin
            Exit(get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(raw_query_text)));
        end;

        SetLength(Result, 0);
        parser_local := TncPinyinParser.Create;
        try
            tokens_local := raw_query_text.Split(['''']);
            compact_offset_local := 0;
            for token_idx_local := 0 to High(tokens_local) do
            begin
                token_text_local := normalize_pinyin_text(tokens_local[token_idx_local]);
                if token_text_local = '' then
                begin
                    SetLength(Result, 0);
                    Exit;
                end;

                token_parts_local := parser_local.parse(token_text_local);
                if Length(token_parts_local) = 0 then
                begin
                    SetLength(Result, 0);
                    Exit;
                end;

                out_idx_local := Length(Result);
                SetLength(Result, out_idx_local + Length(token_parts_local));
                for part_idx_local := 0 to High(token_parts_local) do
                begin
                    Result[out_idx_local + part_idx_local] :=
                        token_parts_local[part_idx_local];
                    Result[out_idx_local + part_idx_local].text :=
                        normalize_pinyin_text(token_parts_local[part_idx_local].text);
                    Result[out_idx_local + part_idx_local].start_index :=
                        compact_offset_local +
                        token_parts_local[part_idx_local].start_index;
                end;
                Inc(compact_offset_local, Length(token_text_local));
            end;
        finally
            parser_local.Free;
        end;
    end;

    procedure initialize_display_query_context;
    var
        raw_query_text_local: string;
        decoded_query_local: TncShuangpinDecodeResult;
        decoded_unit_idx_local: Integer;
        canonical_offset_local: Integer;
    begin
        normalized_pinyin := normalize_pinyin_text(m_composition_text);
        if is_shuangpin_input then
        begin
            decoded_query_local := nc_decode_shuangpin(
                m_config.pinyin_input_scheme, m_composition_display_text);
            normalized_pinyin := normalize_pinyin_text(
                decoded_query_local.compact_pinyin);
            if (normalized_pinyin = '') and (m_last_lookup_key <> '') then
            begin
                normalized_pinyin := normalize_pinyin_text(m_last_lookup_key);
            end;
        end
        else if (m_last_lookup_key <> '') and
            is_full_pinyin_key(normalize_pinyin_text(m_last_lookup_key)) and
            (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            normalized_pinyin := normalize_pinyin_text(m_last_lookup_key);
        end;

        user_entry_query := normalize_pinyin_text(m_last_lookup_key);
        if user_entry_query = '' then
        begin
            user_entry_query := normalized_pinyin;
        end;

        raw_query_text_local := get_display_raw_query_text_local;
        if is_shuangpin_input then
        begin
            SetLength(syllables, Length(decoded_query_local.units));
            canonical_offset_local := 1;
            for decoded_unit_idx_local := 0 to
                High(decoded_query_local.units) do
            begin
                syllables[decoded_unit_idx_local].text :=
                    decoded_query_local.units[decoded_unit_idx_local].pinyin;
                syllables[decoded_unit_idx_local].start_index :=
                    canonical_offset_local;
                syllables[decoded_unit_idx_local].length := Length(
                    decoded_query_local.units[decoded_unit_idx_local].pinyin);
                Inc(canonical_offset_local,
                    syllables[decoded_unit_idx_local].length);
            end;
        end
        else if Pos('''', raw_query_text_local) > 0 then
        begin
            syllables := get_display_query_syllables_local(raw_query_text_local);
        end
        else
        begin
            syllables := get_effective_compact_pinyin_syllables(normalized_pinyin);
        end;
        if Length(syllables) = 0 then
        begin
            syllables := get_effective_compact_pinyin_syllables(normalized_pinyin);
        end;
        expected_units := Length(syllables);
    end;

    function can_use_display_trailing_prefix_fast_path: Boolean;
    var
        trailing_syllables_local: TncPinyinParseResult;
        last_trailing_text_local: string;

        function top_candidate_is_covering_prefix_partial_local: Boolean;
        var
            top_candidate_local: TncCandidate;
            top_text_local: string;
            top_tail_local: string;
            top_text_units_local: Integer;
            head_key_local: string;
            expected_tail_key_local: string;
            unit_idx_local: Integer;

            function is_closed_modal_tail_pinyin_local(
                const value: string): Boolean;
            begin
                Result := SameText(value, 'de') or SameText(value, 'le') or
                    SameText(value, 'la') or SameText(value, 'ma') or
                    SameText(value, 'ba') or SameText(value, 'ne');
            end;

            function has_internal_initial_fragment_local: Boolean;
            var
                local_idx: Integer;
                local_text: string;
            begin
                Result := False;
                if Length(syllables) <= 2 then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(syllables) - 1 do
                begin
                    local_text := normalize_pinyin_text(syllables[local_idx].text);
                    if (Length(local_text) = 1) and
                        (not is_full_pinyin_key(local_text)) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            if (Length(m_candidates) = 0) or (m_dictionary = nil) then
            begin
                Exit;
            end;
            if has_internal_initial_fragment_local then
            begin
                Exit;
            end;

            top_candidate_local := m_candidates[0];
            top_text_local := Trim(top_candidate_local.text);
            top_tail_local := normalize_pinyin_text(Trim(top_candidate_local.comment));
            if (top_text_local = '') or (top_tail_local = '') or
                (top_tail_local <> Trim(top_candidate_local.comment)) then
            begin
                Exit;
            end;

            top_text_units_local := get_candidate_text_unit_count(top_text_local);
            if (top_text_units_local <= 0) or
                (top_text_units_local >= expected_units) then
            begin
                Exit;
            end;
            if (top_text_units_local < 2) and
                (not m_last_lookup_incremental_partial_reuse) then
            begin
                Exit;
            end;

            expected_tail_key_local := '';
            if top_text_units_local < Length(syllables) then
            begin
                for unit_idx_local := top_text_units_local to High(syllables) do
                begin
                    expected_tail_key_local := expected_tail_key_local +
                        normalize_pinyin_text(syllables[unit_idx_local].text);
                end;
            end;
            if (expected_tail_key_local = '') or
                (not SameText(top_tail_local, expected_tail_key_local)) then
            begin
                Exit;
            end;

            trailing_syllables_local :=
                get_effective_compact_pinyin_syllables(expected_tail_key_local);
            if (Length(trailing_syllables_local) <= 0) or
                is_closed_modal_tail_pinyin_local(normalize_pinyin_text(
                trailing_syllables_local[High(trailing_syllables_local)].text)) then
            begin
                Exit;
            end;

            head_key_local := '';
            if top_text_units_local <= Length(syllables) then
            begin
                for unit_idx_local := 0 to top_text_units_local - 1 do
                begin
                    head_key_local := head_key_local +
                        normalize_pinyin_text(syllables[unit_idx_local].text);
                end;
            end;
            if head_key_local = '' then
            begin
                Exit;
            end;

            if top_text_units_local = 1 then
            begin
                Result := m_dictionary.single_char_matches_pinyin(
                    head_key_local, top_text_local);
            end
            else
            begin
                Result := m_dictionary.is_base_entry(head_key_local,
                    top_text_local) or
                    m_dictionary.is_user_entry(head_key_local, top_text_local) or
                    ((top_candidate_local.has_dict_weight or
                    (top_candidate_local.dict_weight > 0)) and
                    (top_candidate_local.dict_weight >= 300));
            end;
        end;
    begin
        Result := False;
        if short_exact_query_mode then
        begin
            Exit;
        end;

        if expected_units < 9 then
        begin
            if (expected_units < 4) or
                (not top_candidate_is_covering_prefix_partial_local) then
            begin
                Exit;
            end;

            Exit(True);
        end;

        if (Pos('trailingprefixfast=1', m_last_lookup_debug_extra) <= 0) and
            (Pos('extendabletailprefixfast=1', m_last_lookup_debug_extra) <= 0) and
            is_full_pinyin_key(normalized_pinyin) then
        begin
            Exit;
        end;

        if expected_units = 9 then
        begin
            trailing_syllables_local :=
                get_effective_compact_pinyin_syllables(normalized_pinyin);
            if Length(trailing_syllables_local) <= 0 then
            begin
                Exit;
            end;
            last_trailing_text_local := Trim(
                trailing_syllables_local[High(trailing_syllables_local)].text);
            if SameText(last_trailing_text_local, 'q') then
            begin
                Exit;
            end;
        end;

        Result := True;
    end;

    procedure filter_explicit_apostrophe_display_candidates;
    var
        explicit_syllables: TncPinyinParseResult;
        explicit_exact_candidates: TncCandidateList;
        idx: Integer;
        out_idx: Integer;
        text_units: TArray<string>;
        expected_tail: string;

        function contains_non_ascii_text(const value: string): Boolean;
        var
            ch: Char;
        begin
            Result := False;
            for ch in value do
            begin
                if Ord(ch) > $7F then
                begin
                    Exit(True);
                end;
            end;
        end;

        function complete_candidate_matches_boundary(const text_value: string): Boolean;
        var
            unit_idx: Integer;
            exact_idx: Integer;
        begin
            Result := False;
            for exact_idx := 0 to High(explicit_exact_candidates) do
            begin
                if (Trim(explicit_exact_candidates[exact_idx].comment) = '') and
                    SameText(Trim(explicit_exact_candidates[exact_idx].text),
                    Trim(text_value)) then
                begin
                    Exit(True);
                end;
            end;

            text_units := split_text_units(Trim(text_value));
            if Length(text_units) <> Length(explicit_syllables) then
            begin
                Exit;
            end;

            for unit_idx := 0 to High(text_units) do
            begin
                if not m_dictionary.single_char_matches_pinyin(
                    normalize_pinyin_text(explicit_syllables[unit_idx].text),
                    text_units[unit_idx]) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function partial_candidate_matches_boundary(
            const candidate: TncCandidate): Boolean;
        var
            unit_idx: Integer;
            span_idx: Integer;
            span_key: string;
            span_lookup: TncCandidateList;
            span_text: string;

            function lookup_has_complete_text(const lookup_key: string;
                const expected_text: string): Boolean;
            var
                lookup_idx: Integer;
            begin
                Result := False;
                if (lookup_key = '') or (expected_text = '') then
                begin
                    Exit;
                end;
                if (not m_dictionary.lookup_exact_full_pinyin(lookup_key,
                    span_lookup)) and
                    (not m_dictionary.lookup(lookup_key, span_lookup)) then
                begin
                    Exit;
                end;
                for lookup_idx := 0 to High(span_lookup) do
                begin
                    if (Trim(span_lookup[lookup_idx].comment) = '') and
                        SameText(Trim(span_lookup[lookup_idx].text),
                        expected_text) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            text_units := split_text_units(Trim(candidate.text));
            if (Length(text_units) <= 0) or
                (Length(text_units) >= Length(explicit_syllables)) then
            begin
                Exit;
            end;

            span_text := Trim(candidate.text);
            if Length(text_units) = 1 then
            begin
                if not m_dictionary.single_char_matches_pinyin(
                    normalize_pinyin_text(explicit_syllables[0].text),
                    text_units[0]) then
                begin
                    Exit;
                end;
            end
            else
            begin
                span_key := '';
                for span_idx := 0 to High(text_units) do
                begin
                    span_key := span_key +
                        normalize_pinyin_text(explicit_syllables[span_idx].text);
                end;
                if not lookup_has_complete_text(span_key, span_text) then
                begin
                    Exit;
                end;
            end;

            expected_tail := '';
            for unit_idx := Length(text_units) to High(explicit_syllables) do
            begin
                expected_tail := expected_tail +
                    normalize_pinyin_text(explicit_syllables[unit_idx].text);
            end;

            Result := (expected_tail <> '') and
                SameText(normalize_pinyin_text(Trim(candidate.comment)),
                expected_tail);
        end;
    begin
        if (m_dictionary = nil) or
            (Pos('''', get_display_raw_query_text_local) <= 0) then
        begin
            Exit;
        end;

        explicit_syllables := get_display_query_syllables_local(
            get_display_raw_query_text_local);

        if Length(explicit_syllables) <= 1 then
        begin
            Exit;
        end;

        { Keep strict explicit-boundary exact words even when a character's
          contextual pronunciation is absent from the single-character table. }
        if not m_dictionary.lookup(get_display_raw_query_text_local,
            explicit_exact_candidates) then
        begin
            SetLength(explicit_exact_candidates, 0);
        end;

        out_idx := 0;
        for idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) =
                Length(explicit_syllables)) and
                (not complete_candidate_matches_boundary(m_candidates[idx].text)) then
            begin
                Continue;
            end;

            if (Trim(m_candidates[idx].comment) <> '') and
                contains_non_ascii_text(Trim(m_candidates[idx].text)) and
                (not partial_candidate_matches_boundary(m_candidates[idx])) then
            begin
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
            end;
            Inc(out_idx);
        end;
        SetLength(m_candidates, out_idx);
    end;

    function build_display_query_key(const start_idx: Integer;
        const syllable_count: Integer): string;
    var
        idx: Integer;
        cache_idx: Integer;
        syllable_total: Integer;
    begin
        Result := '';
        syllable_total := Length(syllables);
        if (start_idx < 0) or (syllable_count <= 0) or
            (start_idx + syllable_count > syllable_total) then
        begin
            Exit;
        end;

        if Length(display_query_key_cache) <> syllable_total * syllable_total then
        begin
            SetLength(display_query_key_cache, syllable_total * syllable_total);
            SetLength(display_normalized_syllable_cache, syllable_total);
        end;
        cache_idx := start_idx * syllable_total + syllable_count - 1;
        if display_query_key_cache[cache_idx] <> '' then
        begin
            Exit(display_query_key_cache[cache_idx]);
        end;

        for idx := start_idx to start_idx + syllable_count - 1 do
        begin
            if display_normalized_syllable_cache[idx] = '' then
            begin
                display_normalized_syllable_cache[idx] :=
                    normalize_pinyin_text(syllables[idx].text);
            end;
            Result := Result + display_normalized_syllable_cache[idx];
        end;
        display_query_key_cache[cache_idx] := Result;
    end;

