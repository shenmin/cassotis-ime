        function get_encoded_path_segment_count_local(const encoded_path: string): Integer;
        var
            local_idx: Integer;
        begin
            Result := 0;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            Result := 1;
            for local_idx := 1 to Length(encoded_path) do
            begin
                if encoded_path[local_idx] = c_segment_path_separator then
                begin
                    Inc(Result);
                end;
            end;
        end;

        function get_multi_char_segment_count(const encoded_path: string): Integer;
        var
            segment_parts: TArray<string>;
            part: string;
        begin
            Result := 0;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            segment_parts := encoded_path.Split([c_segment_path_separator]);
            for part in segment_parts do
            begin
                if get_candidate_text_unit_count(Trim(part)) >= 2 then
                begin
                    Inc(Result);
                end;
            end;
        end;

        function build_exact_syllable_text(const start_index: Integer;
            const syllable_count: Integer): string;
        var
            local_idx: Integer;
            local_last_index: Integer;
        begin
            Result := '';
            if (start_index < 0) or (syllable_count <= 0) then
            begin
                Exit;
            end;

            local_last_index := start_index + syllable_count - 1;
            if local_last_index > High(exact_syllables) then
            begin
                Exit;
            end;

            for local_idx := start_index to local_last_index do
            begin
                Result := Result + exact_syllables[local_idx].text;
            end;
        end;

