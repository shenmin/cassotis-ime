                        (text_value_local = string(Char($8BA9))) or
                        (text_value_local = string(Char($7ED9)));
                end;
            begin
                Result := False;
                if (split_span_len_local < 2) or
                    (local_pos + split_span_len_local > Length(syllables_local)) then
                begin
                    Exit;
                end;
                if split_span_len_local >= 3 then
                begin
                    Exit;
                end;

                prefix_text_local := stable_single_text_local(
                    syllables_local[local_pos].text);
                if (prefix_text_local = '') or
                    ((not is_function_prefix_text_local(prefix_text_local)) and
                    (not is_extended_function_prefix_text_local(prefix_text_local))) then
                begin
                    prefix_text_local := '';
                    single_key_local := normalize_pinyin_text(
                        syllables_local[local_pos].text);
                    if (single_key_local <> '') and
                        dictionary_exact_lookup_cached(single_key_local,
                        single_results_local) then
                    begin
                        for single_idx_local := 0 to High(single_results_local) do
                        begin
                            if single_idx_local >= 12 then
                            begin
                                Break;
                            end;
                            single_text_local := Trim(
                                single_results_local[single_idx_local].text);
                            if (single_text_local <> '') and
                                (get_candidate_text_unit_count(single_text_local) = 1) and
                                (is_function_prefix_text_local(single_text_local) or
                                is_extended_function_prefix_text_local(single_text_local)) then
                            begin
                                prefix_text_local := single_text_local;
                                Break;
                            end;
                        end;
                    end;
                end;
                if prefix_text_local = '' then
                begin
                    Exit;
                end;

                remaining_units_local := Length(syllables_local) - local_pos - 1;
                for tail_units_local := Min(c_max_span,
                    remaining_units_local) downto 2 do
                begin
                    if (1 + tail_units_local < split_span_len_local) then
                    begin
                        Continue;
                    end;
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos + 1, tail_units_local, tail_score_local,
                        tail_text_local) then
                    begin
                        Continue;
                    end;
                    if tail_score_local < c_min_tail_phrase_score then
                    begin
                        Continue;
                    end;

                    split_score_local := c_fixed_prefix_score +
                        tail_score_local + c_function_split_bonus;
                    if m_dictionary <> nil then
                    begin
                        Inc(split_score_local,
                            m_dictionary.get_context_bonus(prefix_text_local,
                            tail_text_local) * 4);
                    end;
                    if split_score_local > current_score_local + c_split_margin then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function has_better_internal_phrase_split_local(
                const split_span_len_local: Integer;
                const current_score_local: Integer): Boolean;
            const
                c_internal_split_margin = 480;
            var
                left_units_local: Integer;
                left_score_local: Integer;
                right_score_local: Integer;
                left_text_local: string;
                right_text_local: string;
            begin
                Result := False;
                if split_span_len_local < 4 then
                begin
                    Exit;
                end;

                for left_units_local := 2 to split_span_len_local - 2 do
                begin
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos, left_units_local, left_score_local,
                        left_text_local) then
                    begin
                        Continue;
                    end;
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos + left_units_local,
                        split_span_len_local - left_units_local,
                        right_score_local, right_text_local) then
                    begin
                        Continue;
                    end;
                    if left_score_local + right_score_local >
                        current_score_local + c_internal_split_margin then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function has_better_prefix_following_phrase_split_local(
                const split_span_len_local: Integer;
                const current_score_local: Integer): Boolean;
            const
                c_split_margin = 420;
                c_min_following_phrase_score = 1500;
            var
                left_units_local: Integer;
                right_start_local: Integer;
                right_units_local: Integer;
                remaining_units_local: Integer;
                left_score_local: Integer;
                right_score_local: Integer;
                combined_score_local: Integer;
                left_text_local: string;
                right_text_local: string;
            begin
                Result := False;
                if (split_span_len_local < 3) or
                    (local_pos + split_span_len_local >= Length(syllables_local)) then
                begin
                    Exit;
                end;

                for left_units_local := 2 to split_span_len_local - 1 do
                begin
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos, left_units_local, left_score_local,
                        left_text_local) then
                    begin
                        Continue;
                    end;

                    right_start_local := local_pos + left_units_local;
                    remaining_units_local := Length(syllables_local) -
                        right_start_local;
                    for right_units_local := Min(c_max_span,
                        remaining_units_local) downto 2 do
                    begin
                        if left_units_local + right_units_local <=
                            split_span_len_local then
                        begin
                            Continue;
                        end;
                        if not try_get_best_calibrated_exact_span_score_local(
                            right_start_local, right_units_local,
                            right_score_local, right_text_local) then
                        begin
                            Continue;
                        end;
                        if right_score_local < c_min_following_phrase_score then
                        begin
                            Continue;
                        end;

                        combined_score_local := left_score_local +
                            right_score_local;
                        if m_dictionary <> nil then
                        begin
                            Inc(combined_score_local,
                                m_dictionary.get_context_bonus(left_text_local,
                                right_text_local) * 4);
                        end;
                        if combined_score_local > current_score_local +
                            c_split_margin then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            end;

            function build_units_slice_text_local(const units_local: TArray<string>;
                const start_idx_local: Integer; const count_local: Integer): string;
            var
                unit_idx_local: Integer;
            begin
                Result := '';
                if (count_local <= 0) or (start_idx_local < 0) or
                    (start_idx_local + count_local > Length(units_local)) then
                begin
                    Exit;
                end;
                for unit_idx_local := start_idx_local to
                    start_idx_local + count_local - 1 do
                begin
                    Result := Result + units_local[unit_idx_local];
                end;
            end;

            function is_confident_chain_exact_span_local(
                const protected_span_len_local: Integer;
                const protected_rank_local: Integer;
                const protected_weight_local: Integer): Boolean;
            begin
                Result := False;
                if protected_rank_local = 0 then
                begin
                    if ((protected_span_len_local = 2) and
                        (protected_weight_local >= 650)) or
                        ((protected_span_len_local = 3) and
                        (protected_weight_local >= 420)) or
                        ((protected_span_len_local >= 4) and
                        (protected_weight_local >= 360)) then
                    begin
                        Result := True;
                    end;
                end
                else if (protected_rank_local = 1) and
                    (protected_span_len_local >= 3) and
                    (protected_weight_local >= 900) then
                begin
                    Result := True;
                end;
            end;

            function try_get_confident_chain_exact_span_local(
                const protected_start_local: Integer;
                const protected_span_len_local: Integer;
                out out_protected_text_local: string;
                out out_protected_weight_local: Integer;
                out out_protected_rank_local: Integer): Boolean;
            var
                protected_key_local: string;
                protected_results_local: TncCandidateList;
                protected_idx_local: Integer;
                protected_text_local: string;
                protected_weight_local: Integer;
            begin
                Result := False;
                out_protected_text_local := '';
                out_protected_weight_local := 0;
                out_protected_rank_local := -1;
                if (protected_start_local < 0) or
                    (protected_span_len_local < 2) or
                    (protected_start_local + protected_span_len_local >
                    Length(syllables_local)) then
                begin
                    Exit;
                end;

                protected_key_local := build_syllable_key_local(
                    protected_start_local, protected_span_len_local);
                if (protected_key_local = '') or
                    (not dictionary_exact_lookup_cached(protected_key_local,
                    protected_results_local)) then
                begin
                    Exit;
                end;

                for protected_idx_local := 0 to High(protected_results_local) do
                begin
                    if protected_idx_local >= 4 then
                    begin
                        Break;
                    end;
                    if Trim(protected_results_local[protected_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(
                        protected_results_local[protected_idx_local]) or
                        is_runtime_common_pattern_candidate(
                        protected_results_local[protected_idx_local]) or
                        is_runtime_redup_candidate(
                        protected_results_local[protected_idx_local]) then
                    begin
                        Continue;
                    end;
                    protected_text_local := Trim(
                        protected_results_local[protected_idx_local].text);
                    if (protected_text_local = '') or
                        (get_candidate_text_unit_count(protected_text_local) <>
                        protected_span_len_local) then
                    begin
                        Continue;
                    end;
                    if protected_results_local[protected_idx_local].has_dict_weight then
                    begin
                        protected_weight_local :=
                            protected_results_local[protected_idx_local].dict_weight;
                    end
                    else
                    begin
                        protected_weight_local :=
                            protected_results_local[protected_idx_local].score;
                    end;
                    if not is_confident_chain_exact_span_local(
                        protected_span_len_local, protected_idx_local,
                        protected_weight_local) then
                    begin
                        Continue;
                    end;

                    out_protected_text_local := protected_text_local;
                    out_protected_weight_local := protected_weight_local;
                    out_protected_rank_local := protected_idx_local;
                    Exit(True);
                end;
            end;

            function candidate_cuts_confident_chain_span_local(
                const candidate_text_value_local: string;
                const candidate_start_local: Integer;
                const candidate_span_len_local: Integer;
                const candidate_base_weight_local: Integer): Boolean;
            const
                c_overlap_mismatch_margin = 220;
                c_boundary_cut_margin = 520;
            var
                candidate_units_local: TArray<string>;
                protected_units_local: TArray<string>;
                protected_start_local: Integer;
                protected_span_len_local: Integer;
                protected_text_local: string;
                protected_weight_local: Integer;
                protected_rank_local: Integer;
                scan_start_local: Integer;
                scan_end_local: Integer;
                overlap_start_local: Integer;
                overlap_end_local: Integer;
                overlap_len_local: Integer;
                candidate_overlap_local: string;
                protected_overlap_local: string;
            begin
                Result := False;
                if candidate_span_len_local < 2 then
                begin
                    Exit;
                end;
                candidate_units_local := split_text_units(Trim(
                    candidate_text_value_local));
                if Length(candidate_units_local) <> candidate_span_len_local then
                begin
                    Exit;
                end;

                scan_start_local := Max(0, candidate_start_local - 3);
                scan_end_local := Min(Length(syllables_local) - 2,
                    candidate_start_local + candidate_span_len_local - 1);
                for protected_start_local := scan_start_local to scan_end_local do
                begin
                    for protected_span_len_local := Min(4,
                        Length(syllables_local) - protected_start_local) downto 2 do
                    begin
                        if (protected_start_local = candidate_start_local) and
                            (protected_span_len_local = candidate_span_len_local) then
                        begin
                            Continue;
                        end;
                        if not try_get_confident_chain_exact_span_local(
                            protected_start_local, protected_span_len_local,
                            protected_text_local, protected_weight_local,
                            protected_rank_local) then
                        begin
                            Continue;
                        end;
                        protected_units_local := split_text_units(
                            protected_text_local);
                        if Length(protected_units_local) <>
                            protected_span_len_local then
                        begin
                            Continue;
                        end;

                        overlap_start_local := Max(candidate_start_local,
                            protected_start_local);
                        overlap_end_local := Min(candidate_start_local +
                            candidate_span_len_local, protected_start_local +
                            protected_span_len_local);
                        overlap_len_local := overlap_end_local -
                            overlap_start_local;
                        if overlap_len_local <= 0 then
                        begin
                            Continue;
                        end;

                        candidate_overlap_local := build_units_slice_text_local(
                            candidate_units_local,
                            overlap_start_local - candidate_start_local,
                            overlap_len_local);
                        protected_overlap_local := build_units_slice_text_local(
                            protected_units_local,
                            overlap_start_local - protected_start_local,
                            overlap_len_local);
                        if (candidate_overlap_local = '') or
                            (protected_overlap_local = '') then
                        begin
                            Continue;
                        end;

                        if not SameText(candidate_overlap_local,
                            protected_overlap_local) then
                        begin
                            if ((overlap_len_local >= 2) and
                                (candidate_base_weight_local <=
                                protected_weight_local +
                                c_overlap_mismatch_margin)) or
                                ((overlap_len_local = 1) and
                                (protected_rank_local = 0) and
                                (protected_weight_local >= 900) and
                                (candidate_base_weight_local <=
                                protected_weight_local +
                                c_overlap_mismatch_margin)) then
                            begin
                                Exit(True);
                            end;
                            Continue;
                        end;

                        if (protected_start_local > candidate_start_local) and
                            (protected_start_local < candidate_start_local +
                            candidate_span_len_local) and
                            (protected_start_local >= candidate_start_local + 2) and
                            (overlap_start_local = protected_start_local) and
                            (overlap_len_local < protected_span_len_local) and
                            (protected_span_len_local >= 3) and
                            (protected_weight_local >= 900) and
                            (candidate_base_weight_local <=
                            protected_weight_local + c_boundary_cut_margin) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            end;

            function try_get_calibrated_exact_text_score_local(
                const score_pos_local: Integer; const score_units_local: Integer;
                const expected_text_local: string;
                out out_score_local: Integer): Boolean;
            var
                score_key_local: string;
                exact_local: TncCandidateList;
                lookup_local: TncCandidateList;
                exact_idx_local: Integer;
                lookup_idx_local: Integer;
                exact_text_local: string;
                lookup_text_local: string;
                base_score_local: Integer;
            begin
                Result := False;
                out_score_local := Low(Integer);
                if Trim(expected_text_local) = '' then
                begin
                    Exit;
                end;
                score_key_local := build_syllable_key_local(score_pos_local,
                    score_units_local);
                if (score_key_local = '') or
                    (not dictionary_exact_lookup_cached(score_key_local,
                    exact_local)) then
                begin
                    Exit;
                end;
                if not dictionary_lookup_cached(score_key_local, lookup_local) then
                begin
                    lookup_local := nil;
                end;

                for exact_idx_local := 0 to High(exact_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(exact_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    exact_text_local := Trim(exact_local[exact_idx_local].text);
                    if (not SameText(exact_text_local, expected_text_local)) or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        score_units_local) then
                    begin
                        Continue;
                    end;
                    if exact_local[exact_idx_local].has_dict_weight then
                    begin
                        base_score_local := exact_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        base_score_local := exact_local[exact_idx_local].score;
                    end;
                    out_score_local := base_score_local;
                    for lookup_idx_local := 0 to High(lookup_local) do
                    begin
                        if lookup_idx_local >= c_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(lookup_local[lookup_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        lookup_text_local := Trim(
                            lookup_local[lookup_idx_local].text);
                        if SameText(lookup_text_local, exact_text_local) then
                        begin
                            out_score_local := lookup_local[lookup_idx_local].score;
                            if lookup_local[lookup_idx_local].has_dict_weight and
                                (lookup_local[lookup_idx_local].dict_weight >
                                out_score_local) then
                            begin
                                out_score_local :=
                                    lookup_local[lookup_idx_local].dict_weight;
                            end;
                            Break;
                        end;
                    end;
                    Inc(out_score_local, score_units_local * 600);
                    Exit(True);
                end;
            end;

            function try_get_internal_phrase_split_matched_score_local(
                const split_text_local: string;
                const split_span_len_local: Integer;
                out out_score_local: Integer): Boolean;
            var
                units_local: TArray<string>;
                left_units_local: Integer;
                left_score_local: Integer;
                right_score_local: Integer;
                left_slice_local: string;
                right_slice_local: string;
                combined_score_local: Integer;
            begin
                Result := False;
                out_score_local := Low(Integer);
                if split_span_len_local < 4 then
                begin
                    Exit;
                end;
                units_local := split_text_units(Trim(split_text_local));
                if Length(units_local) <> split_span_len_local then
                begin
                    Exit;
                end;

                for left_units_local := 2 to split_span_len_local - 2 do
                begin
                    left_slice_local := build_units_slice_text_local(units_local,
                        0, left_units_local);
                    right_slice_local := build_units_slice_text_local(units_local,
                        left_units_local,
                        split_span_len_local - left_units_local);
                    if (left_slice_local = '') or (right_slice_local = '') then
                    begin
                        Continue;
                    end;
                    if not try_get_calibrated_exact_text_score_local(local_pos,
                        left_units_local, left_slice_local,
                        left_score_local) then
                    begin
                        Continue;
                    end;
                    if not try_get_calibrated_exact_text_score_local(
                        local_pos + left_units_local,
                        split_span_len_local - left_units_local,
                        right_slice_local, right_score_local) then
                    begin
                        Continue;
                    end;
                    combined_score_local := left_score_local + right_score_local;
                    if (not Result) or (combined_score_local > out_score_local) then
                    begin
                        Result := True;
                        out_score_local := combined_score_local;
                    end;
                end;
            end;

            function get_internal_phrase_split_alignment_bonus_local(
                const split_text_local: string;
                const split_span_len_local: Integer): Integer;
            const
                c_alignment_bonus = 3600;
            var
                units_local: TArray<string>;
                left_units_local: Integer;
                left_score_local: Integer;
                right_score_local: Integer;
                left_text_local: string;
                right_text_local: string;
                left_slice_local: string;
                right_slice_local: string;
            begin
                Result := 0;
                if split_span_len_local < 4 then
                begin
                    Exit;
                end;
                units_local := split_text_units(Trim(split_text_local));
                if Length(units_local) <> split_span_len_local then
                begin
                    Exit;
                end;

                for left_units_local := 2 to split_span_len_local - 2 do
                begin
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos, left_units_local, left_score_local,
                        left_text_local) then
                    begin
                        Continue;
                    end;
                    if not try_get_best_calibrated_exact_span_score_local(
                        local_pos + left_units_local,
                        split_span_len_local - left_units_local,
                        right_score_local, right_text_local) then
                    begin
                        Continue;
                    end;
                    left_slice_local := build_units_slice_text_local(units_local,
                        0, left_units_local);
                    right_slice_local := build_units_slice_text_local(units_local,
                        left_units_local,
                        split_span_len_local - left_units_local);
                    if SameText(left_slice_local, left_text_local) and
                        SameText(right_slice_local, right_text_local) then
                    begin
                        Exit(c_alignment_bonus);
                    end;
                end;
            end;

            function get_following_context_bonus_local(
                const current_text_local: string;
                const next_pos_local: Integer;
                const span_gap_for_context_local: Integer): Integer;
            const
                c_max_following_context_bonus = 2400;
            var
                next_span_len_local: Integer;
                next_key_local: string;
                next_results_local: TncCandidateList;
                next_idx_local: Integer;
                next_text_local: string;
                raw_context_bonus_local: Integer;
                prefix_bonus_local: Integer;
            begin
                Result := 0;
                if (m_dictionary = nil) or (Trim(current_text_local) = '') or
                    (next_pos_local >= Length(syllables_local)) then
                begin
                    Exit;
                end;

                for next_span_len_local := Min(c_max_span,
                    Length(syllables_local) - next_pos_local) downto 1 do
                begin
                    next_key_local := build_syllable_key_local(next_pos_local,
                        next_span_len_local);
                    if next_key_local = '' then
                    begin
                        Continue;
                    end;
                    if not dictionary_lookup_cached(next_key_local,
                        next_results_local) then
                    begin
                        Continue;
                    end;

                    for next_idx_local := 0 to High(next_results_local) do
                    begin
                        if next_idx_local >= c_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(next_results_local[next_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        next_text_local := Trim(next_results_local[next_idx_local].text);
                        if (next_text_local = '') or
                            (get_candidate_text_unit_count(next_text_local) <>
                            next_span_len_local) then
                        begin
                            Continue;
                        end;

                        raw_context_bonus_local :=
                            m_dictionary.get_context_bonus(
                            Trim(current_text_local), next_text_local);
                        if span_gap_for_context_local >= 240 then
                        begin
                            raw_context_bonus_local :=
                                Min(raw_context_bonus_local, 240);
                        end;
                        prefix_bonus_local :=
                            get_sentence_text_prefix_bonus_local(
                            Trim(current_text_local) + next_text_local);

                        Result := Min(c_max_following_context_bonus,
                            raw_context_bonus_local * 4 +
                            prefix_bonus_local * 2);
                        Exit;
                    end;
                end;
            end;
        begin
            Result := False;
            out_text := '';
            out_score := Low(Integer);
            out_units := 0;

            for span_len_local := Min(c_max_span,
                Length(syllables_local) - local_pos) downto 2 do
            begin
                key_local := build_syllable_key_local(local_pos,
                    span_len_local);
                if key_local = '' then
                begin
                    Continue;
                end;

                if not dictionary_exact_lookup_cached(key_local, results_local) then
                begin
                    Continue;
                end;
                if not dictionary_lookup_cached(key_local,
                    lookup_results_local) then
                begin
                    lookup_results_local := nil;
                end;

                best_span_base_score_local := Low(Integer);
                for result_idx_local := 0 to High(results_local) do
                begin
                    if result_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(results_local[result_idx_local]) or
                        is_runtime_common_pattern_candidate(
                        results_local[result_idx_local]) or
                        is_runtime_redup_candidate(
                        results_local[result_idx_local]) then
                    begin
                        Continue;
                    end;

                    candidate_text_local :=
                        Trim(results_local[result_idx_local].text);
                    if (candidate_text_local = '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        span_len_local) then
                    begin
                        Continue;
                    end;

                    if results_local[result_idx_local].has_dict_weight then
                    begin
                        candidate_base_score_local :=
                            results_local[result_idx_local].dict_weight;
                    end
                    else
                    begin
                        candidate_base_score_local :=
                            results_local[result_idx_local].score;
                    end;
                    if (results_local[result_idx_local].source = cs_rule) and
                        (candidate_base_score_local >= 50000) then
                    begin
                        Continue;
                    end;
                    if candidate_base_score_local > best_span_base_score_local then
                    begin
                        best_span_base_score_local := candidate_base_score_local;
                    end;
                end;

                for result_idx_local := 0 to High(results_local) do
                begin
                    if result_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(results_local[result_idx_local]) or
                        is_runtime_common_pattern_candidate(
                        results_local[result_idx_local]) or
                        is_runtime_redup_candidate(
                        results_local[result_idx_local]) then
                    begin
                        Continue;
                    end;

                    candidate_text_local :=
                        Trim(results_local[result_idx_local].text);
                    if (candidate_text_local = '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        span_len_local) then
                    begin
                        Continue;
                    end;

                    if results_local[result_idx_local].has_dict_weight then
                    begin
                        candidate_base_score_local :=
                            results_local[result_idx_local].dict_weight;
                    end
                    else
                    begin
                        candidate_base_score_local :=
                            results_local[result_idx_local].score;
                    end;
                    if (results_local[result_idx_local].source = cs_rule) and
                        (candidate_base_score_local >= 50000) then
                    begin
                        Continue;
                    end;
                    candidate_score_local := get_lookup_rank_score_for_text_local(
                        candidate_text_local, candidate_base_score_local);
                    primary_match_bonus_local :=
                        get_lookup_primary_match_bonus_for_text_local(
                        candidate_text_local, span_len_local);
                    Inc(candidate_score_local, primary_match_bonus_local);
                    Inc(candidate_score_local, span_len_local * 600);

                    internal_alignment_bonus_local :=
                        get_internal_phrase_split_alignment_bonus_local(
                        candidate_text_local, span_len_local);
                    Inc(candidate_score_local, internal_alignment_bonus_local);
                    if try_get_internal_phrase_split_matched_score_local(
                        candidate_text_local, span_len_local,
                        internal_matched_score_local) and
                        (internal_matched_score_local > candidate_score_local) then
                    begin
                        candidate_score_local := internal_matched_score_local;
                    end;
                    same_span_quality_gap_local := Max(0,
                        best_span_base_score_local - candidate_base_score_local);
                    if primary_match_bonus_local > 0 then
                    begin
                        same_span_quality_gap_local := 0;
                    end;
                    if same_span_quality_gap_local >= 240 then
                    begin
                        Dec(candidate_score_local, Min(80000, 12000 +
                            same_span_quality_gap_local * 80));
                    end;
                    if candidate_cuts_confident_chain_span_local(
                        candidate_text_local, local_pos, span_len_local,
                        candidate_base_score_local) then
                    begin
                        Continue;
                    end;
                    if (candidate_base_score_local <= 80) and
                        (internal_alignment_bonus_local <= 0) and
                        has_better_internal_phrase_split_local(span_len_local,
                        candidate_score_local) then
                    begin
                        Continue;
                    end;

                    if not ((span_len_local >= 4) and
                        (candidate_base_score_local >= 600)) then
                    begin
                        split_check_score_local := candidate_base_score_local +
                            span_len_local * 600;
                        if has_better_prefix_single_split_local(span_len_local,
                            split_check_score_local) then
                        begin
                            Continue;
                        end;
                        if has_better_two_single_split_local(span_len_local,
                            candidate_base_score_local, candidate_score_local) then
                        begin
                            Continue;
                        end;
                        if has_better_single_prefix_phrase_split_local(
                            span_len_local, candidate_base_score_local,
                            split_check_score_local) then
                        begin
                            Continue;
                        end;
                        if not ((span_len_local = 3) and
                            (candidate_base_score_local >= 520)) and
                            has_better_prefix_following_phrase_split_local(
                            span_len_local, split_check_score_local) then
                        begin
                            Continue;
                        end;
                    end;
                    Inc(candidate_score_local, get_previous_context_bonus_local(
                        candidate_text_local));
                    Inc(candidate_score_local, get_following_context_bonus_local(
                        candidate_text_local, local_pos + span_len_local,
                        same_span_quality_gap_local));
                    if (not Result) or (candidate_score_local > out_score) then
                    begin
                        Result := True;
                        out_text := candidate_text_local;
                        out_score := candidate_score_local;
                        out_units := span_len_local;
                    end;
                end;

                if Result then
                begin
                    Exit;
                end;
            end;
        end;

        procedure prefer_exact_three_syllable_head_local;
        const
            c_min_head_weight = 1500;
        var
            head_key_local: string;
            head_results_local: TncCandidateList;
            head_idx_local: Integer;
            head_text_local: string;
            current_head_local: string;
            suffix_text_local: string;
            units_local: TArray<string>;
            unit_idx_local: Integer;
            head_weight_local: Integer;
        begin
            if (Length(syllables_local) < 4) or (Trim(text_local) = '') then
            begin
                Exit;
            end;

            units_local := split_text_units(text_local);
            if Length(units_local) <> Length(syllables_local) then
            begin
                Exit;
            end;
            current_head_local := units_local[0] + units_local[1] + units_local[2];

            head_key_local := build_syllable_key_local(0, 3);
            if (head_key_local = '') or
                (not dictionary_exact_lookup_cached(head_key_local,
                head_results_local)) then
            begin
                Exit;
            end;

            for head_idx_local := 0 to High(head_results_local) do
            begin
                if head_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(head_results_local[head_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                head_text_local := Trim(head_results_local[head_idx_local].text);
                if (head_text_local = '') or
                    (get_candidate_text_unit_count(head_text_local) <> 3) then
                begin
                    Continue;
                end;
                if head_results_local[head_idx_local].has_dict_weight then
                begin
                    head_weight_local := head_results_local[head_idx_local].dict_weight;
                end
                else
                begin
                    head_weight_local := head_results_local[head_idx_local].score;
                end;
                if SameText(head_text_local, current_head_local) and
                    (head_weight_local >= c_min_head_weight) then
                begin
                    Exit;
                end;
            end;

            for head_idx_local := 0 to High(head_results_local) do
            begin
                if head_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(head_results_local[head_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                head_text_local := Trim(head_results_local[head_idx_local].text);
                if (head_text_local = '') or
                    SameText(head_text_local, current_head_local) or
                    (get_candidate_text_unit_count(head_text_local) <> 3) then
                begin
                    Continue;
                end;
                if head_results_local[head_idx_local].has_dict_weight then
                begin
                    head_weight_local := head_results_local[head_idx_local].dict_weight;
                end
                else
                begin
                    head_weight_local := head_results_local[head_idx_local].score;
                end;
                if head_weight_local < c_min_head_weight then
                begin
                    Continue;
                end;

                suffix_text_local := '';
                for unit_idx_local := 3 to High(units_local) do
                begin
                    suffix_text_local := suffix_text_local + units_local[unit_idx_local];
                end;
                text_local := head_text_local + suffix_text_local;
                path_local := head_text_local + c_segment_path_separator +
                    suffix_text_local;
                Inc(score_local, 2400 + head_weight_local);
                Inc(phrase_count_local);
                Exit;
            end;
        end;

        function try_reduce_short_composed_complete_to_prefix_partial_local(
            out out_tail_comment: string): Boolean;
        var
            path_parts_local: TArray<string>;
            units_local: TArray<string>;
            last_segment_units_local: Integer;
            prefix_units_local: Integer;
            unit_idx_local: Integer;
            path_idx_local: Integer;
            prefix_text_local: string;
            prefix_path_local: string;
            prefix_key_local: string;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_supported_local: Boolean;
        begin
            Result := False;
            out_tail_comment := '';
            if (input_syllable_count > 5) or (text_local = '') or
                (path_local = '') or
                (Pos(c_segment_path_separator, path_local) <= 0) or
                has_exact_full_query_text_support_local(text_local) then
            begin
                Exit;
            end;

            path_parts_local := path_local.Split([c_segment_path_separator]);
            if Length(path_parts_local) < 2 then
            begin
                Exit;
            end;

            last_segment_units_local := get_candidate_text_unit_count(
                Trim(path_parts_local[High(path_parts_local)]));
            if last_segment_units_local < 2 then
            begin
                Exit;
            end;

            prefix_units_local := input_syllable_count - last_segment_units_local;
            if prefix_units_local < 2 then
            begin
                Exit;
            end;

            units_local := split_text_units(text_local);
            if Length(units_local) <> input_syllable_count then
            begin
                Exit;
            end;

            prefix_text_local := '';
            for unit_idx_local := 0 to prefix_units_local - 1 do
            begin
                prefix_text_local := prefix_text_local + units_local[unit_idx_local];
            end;
            if get_candidate_text_unit_count(prefix_text_local) <> prefix_units_local then
            begin
                Exit;
            end;

            prefix_key_local := build_syllable_key_local(0, prefix_units_local);
            if (prefix_key_local = '') or
                (not dictionary_exact_lookup_cached(prefix_key_local,
                prefix_results_local)) then
            begin
                Exit;
            end;

            prefix_supported_local := False;
            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                if (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                    SameText(Trim(prefix_results_local[prefix_idx_local].text),
                    prefix_text_local) and
                    (get_candidate_text_unit_count(
                    Trim(prefix_results_local[prefix_idx_local].text)) =
                    prefix_units_local) then
                begin
                    prefix_supported_local := True;
                    Break;
                end;
            end;
            if not prefix_supported_local then
            begin
                Exit;
            end;

            prefix_path_local := '';
            for path_idx_local := 0 to High(path_parts_local) - 1 do
            begin
                if prefix_path_local <> '' then
                begin
                    prefix_path_local := prefix_path_local +
                        c_segment_path_separator;
                end;
                prefix_path_local := prefix_path_local +
                    Trim(path_parts_local[path_idx_local]);
            end;

            out_tail_comment := build_tail_comment_local(prefix_units_local);
            if out_tail_comment = '' then
            begin
                Exit;
            end;

            text_local := prefix_text_local;
            path_local := prefix_path_local;
            Dec(score_local, last_segment_units_local * 520);
            Result := True;
        end;
    var
        segment_text_local: string;
        segment_score_local: Integer;
        segment_units_local: Integer;
        single_text_local: string;
        tail_comment_local: string;
    begin
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        Result := False;
        if (m_dictionary = nil) or (lookup_text = '') or
            ((not is_full_pinyin_key(lookup_text)) and
            (not has_extendable_trailing_prefix_query_text(lookup_text))) or
            (not has_multi_syllable_input) or (input_syllable_count < 3) or
            (input_syllable_count > 40) or all_initial_compact_query or
            has_internal_dangling_initial or has_explicit_apostrophe_input then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        pos_local := 0;
        text_local := '';
        path_local := '';
        score_local := 76000;
        phrase_count_local := 0;
        while pos_local < Length(syllables_local) do
        begin
            if try_get_best_exact_phrase_local(pos_local, segment_text_local,
                segment_score_local, segment_units_local) then
            begin
                if (segment_units_local = 3) and
                    try_append_two_plus_one_split_local(pos_local,
                    segment_score_local) then
                begin
                    Inc(pos_local, segment_units_local);
                    Continue;
                end;
                append_segment_local(segment_text_local, segment_score_local,
                    True);
                Inc(pos_local, segment_units_local);
                Continue;
            end;

            if should_keep_tail_syllable_partial_local(pos_local) then
            begin
                Break;
            end;

            single_text_local := stable_single_text_local(
                syllables_local[pos_local].text);
            if single_text_local = '' then
            begin
                Break;
            end;

            append_segment_local(single_text_local, 900, False);
            Inc(pos_local);
        end;

        prefer_exact_three_syllable_head_local;

        if (text_local = '') or (phrase_count_local <= 0) or
            (get_candidate_text_unit_count(text_local) < 2) then
        begin
            Exit;
        end;

        tail_comment_local := build_tail_comment_local(pos_local);
        if (tail_comment_local = '') and
            try_reduce_short_composed_complete_to_prefix_partial_local(
            tail_comment_local) then
        begin
        end;
        out_candidate.text := text_local;
        out_candidate.comment := tail_comment_local;
        out_candidate.score := score_local + get_candidate_text_unit_count(
            text_local) * 256 - get_effective_compact_pinyin_unit_count(
            tail_comment_local) * 90;
        if (tail_comment_local = '') and is_user_exact_full_text_local(text_local) then
        begin
            out_candidate.source := cs_user;
            out_candidate.has_dict_weight := False;
            out_candidate.dict_weight := 0;
        end
        else
        begin
            out_candidate.source := cs_rule;
            out_candidate.has_dict_weight := True;
            out_candidate.dict_weight := out_candidate.score;
        end;
        out_encoded_path := path_local;
        Result := True;
    end;

    function try_build_top_complete_phrase_chain_candidates_local(
        out out_candidates: TncCandidateList;
        out out_encoded_paths: TArray<string>): Boolean;
    const
        c_max_input_syllables = 8;
        c_max_span = 5;
        c_min_segment_units = 2;
        c_min_segment_weight = 300;
        c_segment_probe_limit = 6;
        c_max_states_per_pos = 10;
        c_output_limit = 2;
        c_path_bonus_cap = 640;
        c_path_penalty_cap = 240;
    type
        TLocalSegmentOption = record
            text: string;
            units: Integer;
            weight: Integer;
            quality_gap: Integer;
        end;
        TLocalSegmentOptionArray = TArray<TLocalSegmentOption>;
        TLocalChainState = record
            text: string;
            path: string;
            last_segment_text: string;
            last_segment_quality_gap: Integer;
            score: Integer;
            segment_count: Integer;
        end;
        TLocalChainStateArray = TArray<TLocalChainState>;
    var
        syllables_local: TncPinyinParseResult;
        state_map_local: TArray<TLocalChainStateArray>;
        pos_local: Integer;
        state_idx_local: Integer;
        span_len_local: Integer;
        option_idx_local: Integer;
        current_state_local: TLocalChainState;
        next_state_local: TLocalChainState;
        options_local: TLocalSegmentOptionArray;
        final_states_local: TLocalChainStateArray;
        output_idx_local: Integer;
        context_bonus_local: Integer;
        context_quality_gap_local: Integer;
        same_span_penalty_local: Integer;

        function build_syllable_key_local(const local_start_idx: Integer;
            const local_count: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_count <= 0) or
                (local_start_idx + local_count > Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function get_candidate_effective_weight_local(
            const candidate_local: TncCandidate): Integer;
        begin
            Result := candidate_local.score;
            if ((not is_fuzzy_pinyin_active) or
                (candidate_local.fuzzy_cost <= 0)) and
                candidate_local.has_dict_weight and
                (candidate_local.dict_weight > Result) then
            begin
                Result := candidate_local.dict_weight;
            end;
        end;

        procedure append_segment_option_local(var io_options:
            TLocalSegmentOptionArray; const option_local: TLocalSegmentOption);
        var
            existing_idx_local: Integer;
        begin
            if option_local.text = '' then
            begin
                Exit;
            end;

            for existing_idx_local := 0 to High(io_options) do
            begin
                if SameText(io_options[existing_idx_local].text,
                    option_local.text) then
                begin
                    if option_local.weight >
                        io_options[existing_idx_local].weight then
                    begin
                        io_options[existing_idx_local] := option_local;
                    end;
                    Exit;
                end;
            end;

            SetLength(io_options, Length(io_options) + 1);
            io_options[High(io_options)] := option_local;
        end;

        function collect_segment_options_local(const local_pos: Integer;
            const local_units: Integer;
            out out_options: TLocalSegmentOptionArray): Boolean;
        var
            key_local: string;
            results_local: TncCandidateList;
            result_idx_local: Integer;
            option_local: TLocalSegmentOption;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            best_weight_local: Integer;
        begin
            Result := False;
            SetLength(out_options, 0);
            if local_units < c_min_segment_units then
            begin
                Exit;
            end;

            key_local := build_syllable_key_local(local_pos, local_units);
            if (key_local = '') or
                (not dictionary_exact_lookup_cached(key_local, results_local)) then
            begin
                Exit;
            end;

            best_weight_local := Low(Integer);
            for result_idx_local := 0 to High(results_local) do
            begin
                if result_idx_local >= c_segment_probe_limit then
                begin
                    Break;
                end;
                if Trim(results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(results_local[result_idx_local].text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    local_units) then
                begin
                    Continue;
                end;

                candidate_weight_local := get_candidate_effective_weight_local(
                    results_local[result_idx_local]);
                if candidate_weight_local > best_weight_local then
                begin
                    best_weight_local := candidate_weight_local;
                end;
            end;

            if best_weight_local = Low(Integer) then
            begin
                Exit;
            end;

            for result_idx_local := 0 to High(results_local) do
            begin
                if result_idx_local >= c_segment_probe_limit then
                begin
                    Break;
                end;
                if Trim(results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(results_local[result_idx_local].text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    local_units) then
                begin
                    Continue;
                end;

                candidate_weight_local := get_candidate_effective_weight_local(
                    results_local[result_idx_local]);
                if candidate_weight_local < c_min_segment_weight then
                begin
                    Continue;
                end;

                option_local.text := candidate_text_local;
                option_local.units := local_units;
                option_local.weight := candidate_weight_local;
                option_local.quality_gap := Max(0,
                    best_weight_local - candidate_weight_local);
                append_segment_option_local(out_options, option_local);
            end;

            Result := Length(out_options) > 0;
        end;

        function get_path_adjustment_local(const encoded_path_local: string): Integer;
        var
            bonus_local: Integer;
            expanded_bonus_local: Integer;
            penalty_local: Integer;
            expanded_path_local: string;

            function is_splittable_function_tail_local(
                const text_value_local: string): Boolean;
            begin
                Result := (text_value_local = string(Char($53BB))) or
                    (text_value_local = string(Char($7684))) or
                    (text_value_local = string(Char($4E86))) or
                    (text_value_local = string(Char($5427))) or
                    (text_value_local = string(Char($5417)));
            end;

            function expand_function_tail_path_local(
                const path_value_local: string): string;
            var
                parts_local: TArray<string>;
                units_local: TArray<string>;
                part_idx_local: Integer;
                unit_idx_local: Integer;
                segment_text_local: string;
                head_text_local: string;
                tail_text_local: string;
            begin
                Result := '';
                if Trim(path_value_local) = '' then
                begin
                    Exit;
                end;

                parts_local := path_value_local.Split(
                    [c_segment_path_separator]);
                for part_idx_local := 0 to High(parts_local) do
                begin
                    segment_text_local := Trim(parts_local[part_idx_local]);
                    if segment_text_local = '' then
                    begin
                        Continue;
                    end;

                    units_local := split_text_units(segment_text_local);
                    if (Length(units_local) >= 3) and
                        is_splittable_function_tail_local(
                        units_local[High(units_local)]) then
                    begin
                        head_text_local := '';
                        for unit_idx_local := 0 to High(units_local) - 1 do
                        begin
                            head_text_local := head_text_local +
                                units_local[unit_idx_local];
                        end;
                        tail_text_local := units_local[High(units_local)];
                        if Result <> '' then
                        begin
                            Result := Result + c_segment_path_separator;
                        end;
                        Result := Result + head_text_local +
                            c_segment_path_separator + tail_text_local;
                    end
                    else
                    begin
                        if Result <> '' then
                        begin
                            Result := Result + c_segment_path_separator;
                        end;
                        Result := Result + segment_text_local;
                    end;
                end;
            end;
        begin
            Result := 0;
            if (m_dictionary = nil) or (lookup_text = '') or
                (encoded_path_local = '') then
            begin
                Exit;
            end;

            bonus_local := Max(0, get_cached_query_segment_path_bonus(
                lookup_text, encoded_path_local));
            Inc(bonus_local, Max(0, get_session_query_path_bonus(lookup_text,
                encoded_path_local)));
            Inc(bonus_local, Max(0, get_session_ranked_query_path_bonus(
                encoded_path_local)));
            expanded_path_local := expand_function_tail_path_local(
                encoded_path_local);
            if (expanded_path_local <> '') and
                (not SameText(expanded_path_local, encoded_path_local)) then
            begin
                expanded_bonus_local := Max(0,
                    get_cached_query_segment_path_bonus(lookup_text,
                    expanded_path_local));
                Inc(expanded_bonus_local, Max(0, get_session_query_path_bonus(
                    lookup_text, expanded_path_local)));
                Inc(expanded_bonus_local, Max(0,
                    get_session_ranked_query_path_bonus(
                    expanded_path_local)));
                if expanded_bonus_local > bonus_local then
                begin
                    bonus_local := expanded_bonus_local;
                end;
            end;
            penalty_local := Max(0, get_cached_query_segment_path_penalty(
                lookup_text, encoded_path_local));
            Inc(penalty_local, Max(0, get_session_query_path_penalty(lookup_text,
                encoded_path_local)));

            Result := Min(c_path_bonus_cap, bonus_local) -
                Min(c_path_penalty_cap, penalty_local);
        end;

        function is_user_exact_full_text_local(
            const text_value_local: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
        begin
            Result := False;
            if (Trim(text_value_local) = '') or
                (not dictionary_exact_lookup_cached(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (exact_results_local[exact_idx_local].source = cs_user) and
                    (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_idx_local].text),
                    Trim(text_value_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure prune_states_local(var io_states: TLocalChainStateArray);
        var
            left_idx_local: Integer;
            right_idx_local: Integer;
            tmp_state_local: TLocalChainState;
        begin
            for left_idx_local := 0 to High(io_states) - 1 do
            begin
                for right_idx_local := left_idx_local + 1 to High(io_states) do
                begin
                    if (io_states[right_idx_local].score >
                        io_states[left_idx_local].score) or
                        ((io_states[right_idx_local].score =
                        io_states[left_idx_local].score) and
                        (io_states[right_idx_local].segment_count <
                        io_states[left_idx_local].segment_count)) or
                        ((io_states[right_idx_local].score =
                        io_states[left_idx_local].score) and
                        (io_states[right_idx_local].segment_count =
                        io_states[left_idx_local].segment_count) and
                        (Length(io_states[right_idx_local].path) <
                        Length(io_states[left_idx_local].path))) then
                    begin
                        tmp_state_local := io_states[left_idx_local];
                        io_states[left_idx_local] := io_states[right_idx_local];
                        io_states[right_idx_local] := tmp_state_local;
                    end;
                end;
            end;

            if Length(io_states) > c_max_states_per_pos then
            begin
                SetLength(io_states, c_max_states_per_pos);
            end;
        end;

        procedure append_state_local(var io_states: TLocalChainStateArray;
            const state_local: TLocalChainState);
        var
            existing_idx_local: Integer;
        begin
            if (state_local.text = '') or (state_local.path = '') then
            begin
                Exit;
            end;

            for existing_idx_local := 0 to High(io_states) do
            begin
                if SameText(io_states[existing_idx_local].text,
                    state_local.text) then
                begin
                    if state_local.score > io_states[existing_idx_local].score then
                    begin
                        io_states[existing_idx_local] := state_local;
                    end;
                    prune_states_local(io_states);
                    Exit;
                end;
            end;

            SetLength(io_states, Length(io_states) + 1);
            io_states[High(io_states)] := state_local;
            prune_states_local(io_states);
        end;

        procedure append_candidate_output_local(
            const state_local: TLocalChainState);
        var
            candidate_local: TncCandidate;
            existing_idx_local: Integer;
            adjusted_score_local: Integer;
        begin
            if (state_local.text = '') or (state_local.path = '') or
                (state_local.segment_count < 2) or
                (get_candidate_text_unit_count(state_local.text) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            adjusted_score_local := state_local.score +
                get_path_adjustment_local(state_local.path);

            for existing_idx_local := 0 to High(out_candidates) do
            begin
                if SameText(out_candidates[existing_idx_local].text,
                    state_local.text) then
                begin
                    if adjusted_score_local >
                        out_candidates[existing_idx_local].score then
                    begin
                        out_candidates[existing_idx_local].score :=
                            adjusted_score_local;
                        out_candidates[existing_idx_local].dict_weight :=
                            adjusted_score_local;
                        out_encoded_paths[existing_idx_local] :=
                            state_local.path;
                    end;
                    Exit;
                end;
            end;

            if Length(out_candidates) >= c_output_limit then
            begin
                Exit;
            end;

            FillChar(candidate_local, SizeOf(candidate_local), 0);
            candidate_local.text := state_local.text;
            candidate_local.comment := '';
            candidate_local.score := adjusted_score_local;
            if is_user_exact_full_text_local(state_local.text) then
            begin
                candidate_local.source := cs_user;
                candidate_local.has_dict_weight := False;
                candidate_local.dict_weight := 0;
            end
            else
            begin
                candidate_local.source := cs_rule;
                candidate_local.has_dict_weight := True;
                candidate_local.dict_weight := adjusted_score_local;
            end;

            SetLength(out_candidates, Length(out_candidates) + 1);
            SetLength(out_encoded_paths, Length(out_encoded_paths) + 1);
            out_candidates[High(out_candidates)] := candidate_local;
            out_encoded_paths[High(out_encoded_paths)] := state_local.path;
        end;

        procedure sort_outputs_local;
        var
            left_idx_local: Integer;
            right_idx_local: Integer;
            tmp_candidate_local: TncCandidate;
            tmp_path_local: string;
        begin
            for left_idx_local := 0 to High(out_candidates) - 1 do
            begin
                for right_idx_local := left_idx_local + 1 to High(out_candidates) do
                begin
                    if (out_candidates[right_idx_local].score >
                        out_candidates[left_idx_local].score) or
                        ((out_candidates[right_idx_local].score =
                        out_candidates[left_idx_local].score) and
                        (Length(out_encoded_paths[right_idx_local]) <
                        Length(out_encoded_paths[left_idx_local]))) then
                    begin
                        tmp_candidate_local := out_candidates[left_idx_local];
                        out_candidates[left_idx_local] :=
                            out_candidates[right_idx_local];
                        out_candidates[right_idx_local] := tmp_candidate_local;

                        tmp_path_local := out_encoded_paths[left_idx_local];
                        out_encoded_paths[left_idx_local] :=
                            out_encoded_paths[right_idx_local];
                        out_encoded_paths[right_idx_local] := tmp_path_local;
                    end;
                end;
            end;
        end;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        SetLength(out_encoded_paths, 0);
        if (m_dictionary = nil) or (lookup_text = '') or
            (not is_full_pinyin_key(lookup_text)) or
            (not has_multi_syllable_input) or
            (input_syllable_count < 3) or
            (input_syllable_count > c_max_input_syllables) or
            all_initial_compact_query or has_internal_dangling_initial or
            has_explicit_apostrophe_input then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        SetLength(state_map_local, input_syllable_count + 1);
        SetLength(state_map_local[0], 1);
        state_map_local[0][0].text := '';
        state_map_local[0][0].path := '';
        state_map_local[0][0].last_segment_text := '';
        state_map_local[0][0].last_segment_quality_gap := 0;
        state_map_local[0][0].score := 120000;
        state_map_local[0][0].segment_count := 0;

        for pos_local := 0 to input_syllable_count - 1 do
        begin
            if Length(state_map_local[pos_local]) <= 0 then
            begin
                Continue;
            end;

            for state_idx_local := 0 to High(state_map_local[pos_local]) do
            begin
                current_state_local := state_map_local[pos_local][state_idx_local];
                for span_len_local := Min(c_max_span,
                    input_syllable_count - pos_local) downto c_min_segment_units do
                begin
                    if not collect_segment_options_local(pos_local,
                        span_len_local, options_local) then
                    begin
                        Continue;
                    end;

                    for option_idx_local := 0 to High(options_local) do
                    begin
                        next_state_local.text := current_state_local.text +
                            options_local[option_idx_local].text;
                        if current_state_local.path = '' then
                        begin
                            next_state_local.path :=
                                options_local[option_idx_local].text;
                        end
                        else
                        begin
                            next_state_local.path := current_state_local.path +
                                c_segment_path_separator +
                                options_local[option_idx_local].text;
                        end;
                        next_state_local.last_segment_text :=
                            options_local[option_idx_local].text;
                        next_state_local.last_segment_quality_gap :=
                            options_local[option_idx_local].quality_gap;
                        next_state_local.segment_count :=
                            current_state_local.segment_count + 1;
                        next_state_local.score := current_state_local.score +
                            options_local[option_idx_local].weight * 4 +
                            span_len_local * 600;
                        if options_local[option_idx_local].quality_gap >= 240 then
                        begin
                            same_span_penalty_local := Min(80000, 12000 +
                                options_local[option_idx_local].quality_gap * 80);
                            Dec(next_state_local.score, same_span_penalty_local);
                        end;
                        if (m_dictionary <> nil) and
                            (current_state_local.last_segment_text <> '') then
                        begin
                            context_bonus_local :=
                                m_dictionary.get_context_bonus(
                                current_state_local.last_segment_text,
                                options_local[option_idx_local].text);
                            context_quality_gap_local := Max(
                                current_state_local.last_segment_quality_gap,
                                options_local[option_idx_local].quality_gap);
                            if context_quality_gap_local >= 240 then
                            begin
                                context_bonus_local := Min(context_bonus_local, 240);
                            end;
                            Inc(next_state_local.score,
                                context_bonus_local * 4);
                        end;
                        append_state_local(
                            state_map_local[pos_local + span_len_local],
                            next_state_local);
                    end;
                end;
            end;
        end;

        final_states_local := state_map_local[input_syllable_count];
        if Length(final_states_local) <= 0 then
        begin
            Exit;
        end;
        prune_states_local(final_states_local);

        for output_idx_local := 0 to High(final_states_local) do
        begin
            append_candidate_output_local(final_states_local[output_idx_local]);
            if Length(out_candidates) >= c_output_limit then
            begin
                Break;
            end;
        end;
        sort_outputs_local;
        Result := Length(out_candidates) > 0;
    end;

    function try_build_exact_head_tail_complete_candidate_local(
        const head_candidates_local: TncCandidateList;
        const baseline_candidate_local: TncCandidate;
        out out_candidate_local: TncCandidate;
        out out_encoded_path_local: string): Boolean;
    const
        c_head_probe_limit = 32;
        c_tail_probe_limit = 3;
        c_min_head_units = 2;
        c_base_replacement_bonus = 8200;
        c_mismatched_head_bonus = 3600;
        c_long_head_bonus = 1800;
    var
        head_idx_local: Integer;
        tail_idx_local: Integer;
        head_text_local: string;
        tail_query_local: string;
        tail_text_local: string;
        baseline_text_local: string;
        combined_text_local: string;
        head_units_local: Integer;
        tail_units_local: Integer;
        combined_units_local: Integer;
        combined_score_local: Integer;
        tail_candidate_text_local: string;
        baseline_units_local: TArray<string>;
        baseline_unit_idx_local: Integer;
        complete_support_score_local: Integer;
        complete_support_segments_local: Integer;
        complete_support_path_local: string;
        head_weight_local: Integer;
        raw_head_weight_local: Integer;

        function get_candidate_effective_weight_local(
            const candidate_local: TncCandidate): Integer;
        begin
            Result := candidate_local.score;
            if ((not is_fuzzy_pinyin_active) or
                (candidate_local.fuzzy_cost <= 0)) and
                candidate_local.has_dict_weight and
                (candidate_local.dict_weight > Result) then
            begin
                Result := candidate_local.dict_weight;
            end;
        end;

        function get_raw_exact_head_weight_local(const head_text_value: string;
            const tail_query_value: string): Integer;
        var
            head_key_local: string;
            raw_results_local: TncCandidateList;
            raw_idx_local: Integer;
            raw_text_local: string;
        begin
            Result := Low(Integer);
            if (head_text_value = '') or (tail_query_value = '') or
                (Length(tail_query_value) >= Length(lookup_text)) or
                (Copy(lookup_text, Length(lookup_text) -
                Length(tail_query_value) + 1, Length(tail_query_value)) <>
                tail_query_value) then
            begin
                Exit;
            end;

            head_key_local := Copy(lookup_text, 1,
                Length(lookup_text) - Length(tail_query_value));
            if (head_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(head_key_local,
                raw_results_local)) then
            begin
                Exit;
            end;

            for raw_idx_local := 0 to High(raw_results_local) do
            begin
                if raw_idx_local >= c_head_probe_limit then
                begin
                    Break;
                end;
                if Trim(raw_results_local[raw_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                raw_text_local := Trim(raw_results_local[raw_idx_local].text);
                if SameText(raw_text_local, head_text_value) then
                begin
                    Result := raw_results_local[raw_idx_local].score;
                    if raw_results_local[raw_idx_local].has_dict_weight and
                        (raw_results_local[raw_idx_local].dict_weight > Result) then
                    begin
                        Result := raw_results_local[raw_idx_local].dict_weight;
                    end;
                    Exit;
                end;
            end;
        end;

        function build_tail_syllable_key_local(
            const tail_syllables_local: TncPinyinParseResult;
            const start_idx_local: Integer; const count_local: Integer): string;
        var
            key_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(tail_syllables_local)) then
            begin
                Exit;
            end;
            for key_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    tail_syllables_local[key_idx_local].text);
            end;
        end;

        function get_tail_single_text_local(const syllable_text_local: string): string;
        var
            single_key_local: string;
            single_results_local: TncCandidateList;
            single_idx_local: Integer;
            single_text_local: string;
        begin
            Result := '';
            single_key_local := normalize_pinyin_text(syllable_text_local);
            if single_key_local = '' then
            begin
                Exit;
            end;

            Result := get_fixed_resolved_boundary_char_local(single_key_local);
            if Result <> '' then
            begin
                Exit;
            end;

            if not dictionary_exact_lookup_cached(single_key_local,
                single_results_local) then
            begin
                if not dictionary_lookup_cached(single_key_local,
                    single_results_local) then
                begin
                    Exit;
                end;
            end;
            for single_idx_local := 0 to High(single_results_local) do
            begin
                if single_idx_local >= 12 then
                begin
                    Break;
                end;
                if Trim(single_results_local[single_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                single_text_local := Trim(single_results_local[single_idx_local].text);
                if (single_text_local <> '') and
                    (get_candidate_text_unit_count(single_text_local) = 1) and
                    is_bmp_cjk_single_char_candidate(
                    single_results_local[single_idx_local]) then
                begin
                    Exit(single_text_local);
                end;
            end;
        end;

        function try_get_tail_exact_phrase_local(
            const tail_syllables_local: TncPinyinParseResult;
            const start_idx_local: Integer;
            out out_text_local: string; out out_units_local: Integer): Boolean;
        const
            c_tail_max_span = 5;
        var
            span_len_local: Integer;
            exact_key_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            out_text_local := '';
            out_units_local := 0;
            for span_len_local := Min(c_tail_max_span,
                Length(tail_syllables_local) - start_idx_local) downto 2 do
            begin
                exact_key_local := build_tail_syllable_key_local(
                    tail_syllables_local, start_idx_local, span_len_local);
                if (exact_key_local = '') or
                    (not dictionary_exact_lookup_cached(exact_key_local,
                    exact_results_local)) then
                begin
                    Continue;
                end;
                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= 12 then
                    begin
                        Break;
                    end;
                    if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (exact_text_local <> '') and
                        (get_candidate_text_unit_count(exact_text_local) =
                        span_len_local) then
                    begin
                        out_text_local := exact_text_local;
                        out_units_local := span_len_local;
                        Exit(True);
                    end;
                end;
            end;
        end;

        function try_build_greedy_tail_text_local(
            const tail_query_value_local: string;
            out out_tail_text_local: string;
            out out_tail_units_local: Integer): Boolean;
        var
            tail_syllables_local: TncPinyinParseResult;
            tail_pos_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            single_text_local: string;
        begin
            Result := False;
            out_tail_text_local := '';
            out_tail_units_local := 0;
            tail_syllables_local :=
                get_effective_compact_pinyin_syllables(tail_query_value_local);
            if Length(tail_syllables_local) <= 0 then
            begin
                Exit;
            end;

            tail_pos_local := 0;
            while tail_pos_local < Length(tail_syllables_local) do
            begin
                if try_get_tail_exact_phrase_local(tail_syllables_local,
                    tail_pos_local, segment_text_local, segment_units_local) then
                begin
                    out_tail_text_local := out_tail_text_local + segment_text_local;
                    Inc(out_tail_units_local, segment_units_local);
                    Inc(tail_pos_local, segment_units_local);
                    Continue;
                end;

                single_text_local := get_tail_single_text_local(
                    tail_syllables_local[tail_pos_local].text);
                if single_text_local = '' then
                begin
                    Exit;
                end;
                out_tail_text_local := out_tail_text_local + single_text_local;
                Inc(out_tail_units_local);
                Inc(tail_pos_local);
            end;
            Result := out_tail_units_local = Length(tail_syllables_local);
        end;

        function try_build_supported_full_head_path_local(
            const full_text_local: string; out out_path_local: string;
            out out_score_local: Integer; out out_segments_local: Integer): Boolean;
        var
            full_units_local: TArray<string>;
            full_syllables_local: TncPinyinParseResult;
            prefix_len_local: Integer;
            prefix_key_local: string;
            prefix_text_local: string;
            suffix_text_local: string;
            tail_key_local: string;
            tail_text_local: string;
            tail_units_local: Integer;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            candidate_text_local: string;
            candidate_score_local: Integer;

            function join_full_units_local(const start_idx_local: Integer;
                const unit_count_local: Integer): string;
            var
                unit_idx_local: Integer;
            begin
                Result := '';
                if (unit_count_local <= 0) or (start_idx_local < 0) or
                    (start_idx_local + unit_count_local > Length(full_units_local)) then
                begin
                    Exit;
                end;

                for unit_idx_local := start_idx_local to
                    start_idx_local + unit_count_local - 1 do
                begin
                    Result := Result + full_units_local[unit_idx_local];
                end;
            end;
        begin
            Result := False;
            out_path_local := '';
            out_score_local := Low(Integer);
            out_segments_local := 0;
            full_units_local := split_text_units(Trim(full_text_local));
            full_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            if (Length(full_units_local) <> input_syllable_count) or
                (Length(full_syllables_local) <> input_syllable_count) or
                (input_syllable_count < 3) then
            begin
                Exit;
            end;

            for prefix_len_local := Min(3, input_syllable_count - 1) downto 2 do
            begin
                prefix_key_local := build_tail_syllable_key_local(
                    full_syllables_local, 0, prefix_len_local);
                if (prefix_key_local = '') or
                    (not dictionary_exact_lookup_cached(prefix_key_local,
                    prefix_results_local)) then
                begin
                    Continue;
                end;

                prefix_text_local := join_full_units_local(0,
                    prefix_len_local);
                suffix_text_local := join_full_units_local(prefix_len_local,
                    input_syllable_count - prefix_len_local);
                if (prefix_text_local = '') or (suffix_text_local = '') then
                begin
                    Continue;
                end;

                candidate_score_local := Low(Integer);
                for prefix_idx_local := 0 to High(prefix_results_local) do
                begin
                    if prefix_idx_local >= 12 then
                    begin
                        Break;
                    end;
                    if Trim(prefix_results_local[prefix_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(
                        prefix_results_local[prefix_idx_local].text);
                    if (get_candidate_text_unit_count(candidate_text_local) =
                        prefix_len_local) and
                        SameText(candidate_text_local, prefix_text_local) then
                    begin
                        candidate_score_local :=
                            prefix_results_local[prefix_idx_local].score;
                        if prefix_results_local[prefix_idx_local].has_dict_weight and
                            (prefix_results_local[prefix_idx_local].dict_weight >
                            candidate_score_local) then
                        begin
                            candidate_score_local :=
                                prefix_results_local[prefix_idx_local].dict_weight;
                        end;
                        Break;
                    end;
                end;
                if candidate_score_local = Low(Integer) then
                begin
                    Continue;
                end;

                tail_key_local := build_tail_syllable_key_local(
                    full_syllables_local, prefix_len_local,
                    input_syllable_count - prefix_len_local);
                if (tail_key_local = '') or
                    (not try_build_greedy_tail_text_local(tail_key_local,
                    tail_text_local, tail_units_local)) or
                    (tail_units_local <>
                    input_syllable_count - prefix_len_local) or
                    (not SameText(tail_text_local, suffix_text_local)) then
                begin
                    Continue;
                end;

                out_path_local := prefix_text_local +
                    c_segment_path_separator + tail_text_local;
                out_score_local := candidate_score_local +
                    prefix_len_local * 1200 + tail_units_local * 900;
                out_segments_local := 2;
                Exit(True);
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate_local, SizeOf(out_candidate_local), 0);
        out_encoded_path_local := '';
        baseline_text_local := Trim(baseline_candidate_local.text);
        baseline_units_local := split_text_units(baseline_text_local);
        if (Length(head_candidates_local) <= 0) or
            (baseline_text_local = '') or (input_syllable_count <= 3) then
        begin
            Exit;
        end;

        for head_idx_local := 0 to High(head_candidates_local) do
        begin
            if head_idx_local >= c_head_probe_limit then
            begin
                Break;
            end;

            head_text_local := Trim(head_candidates_local[head_idx_local].text);
            tail_query_local := Trim(head_candidates_local[head_idx_local].comment);
            head_units_local := get_candidate_text_unit_count(head_text_local);
            head_weight_local := get_candidate_effective_weight_local(
                head_candidates_local[head_idx_local]);
            raw_head_weight_local := get_raw_exact_head_weight_local(
                head_text_local, tail_query_local);
            if (head_units_local >= 3) and
                (((raw_head_weight_local <> Low(Integer)) and
                (raw_head_weight_local < 512)) or
                ((raw_head_weight_local = Low(Integer)) and
                (head_weight_local < 512))) then
            begin
                Continue;
            end;
            if (head_text_local <> '') and (tail_query_local = '') and
                (head_units_local = input_syllable_count) then
            begin
                if SameText(head_text_local, baseline_text_local) then
                begin
                    Continue;
                end;

                complete_support_score_local := Low(Integer);
                complete_support_segments_local := MaxInt;
                complete_support_path_local :=
                    infer_segment_path_for_query_text_with_score(lookup_text,
                    head_text_local, complete_support_score_local,
                    complete_support_segments_local);
                if (complete_support_path_local = '') or
                    (complete_support_segments_local <= 1) then
                begin
                    try_build_supported_full_head_path_local(head_text_local,
                        complete_support_path_local,
                        complete_support_score_local,
                        complete_support_segments_local);
                end;
                if (complete_support_path_local = '') or
                    (complete_support_segments_local <= 1) then
                begin
                    Continue;
                end;

                combined_score_local := baseline_candidate_local.score +
                    c_base_replacement_bonus + head_units_local * 420 +
                    Min(12000, Max(0, complete_support_score_local div 4)) -
                    head_idx_local * 120;
                if head_units_local >= 3 then
                begin
                    Inc(combined_score_local, c_long_head_bonus);
                end;

                if (not Result) or (combined_score_local >
                    out_candidate_local.score) then
                begin
                    FillChar(out_candidate_local, SizeOf(out_candidate_local), 0);
                    out_candidate_local.text := head_text_local;
                    out_candidate_local.comment := '';
                    out_candidate_local.score := combined_score_local;
                    out_candidate_local.source := cs_rule;
                    out_candidate_local.has_dict_weight := True;
                    out_candidate_local.dict_weight := combined_score_local;
                    out_encoded_path_local := complete_support_path_local;
                    Result := True;
                end;
                Continue;
            end;
            if (head_text_local = '') or (tail_query_local = '') or
                (head_units_local < c_min_head_units) or
                (not is_full_pinyin_key(tail_query_local)) then
            begin
                Continue;
            end;
            if not try_build_greedy_tail_text_local(tail_query_local,
                tail_candidate_text_local, tail_units_local) then
            begin
                if (Length(baseline_units_local) <> input_syllable_count) or
                    (head_units_local >= Length(baseline_units_local)) then
                begin
                    Continue;
                end;
                tail_candidate_text_local := '';
                for baseline_unit_idx_local := head_units_local to
                    High(baseline_units_local) do
                begin
                    tail_candidate_text_local := tail_candidate_text_local +
                        baseline_units_local[baseline_unit_idx_local];
                end;
                tail_units_local := Length(baseline_units_local) -
                    head_units_local;
            end;

            for tail_idx_local := 0 to 0 do
            begin
                tail_text_local := tail_candidate_text_local;
                combined_units_local := head_units_local + tail_units_local;
                if (tail_text_local = '') or
                    (combined_units_local <> input_syllable_count) then
                begin
                    Continue;
                end;

                combined_text_local := head_text_local + tail_text_local;
                if SameText(combined_text_local, baseline_text_local) then
                begin
                    Continue;
                end;

                combined_score_local := baseline_candidate_local.score +
                    c_base_replacement_bonus + head_units_local * 420 -
                    tail_idx_local * 180 - head_idx_local * 120;
                Inc(combined_score_local,
                    Min(7200, Max(0, (head_weight_local - 200) * 6)));
                if head_units_local >= 3 then
                begin
                    if head_weight_local >= 512 then
                    begin
                        Inc(combined_score_local, c_long_head_bonus);
                    end
                    else
                    begin
                        Dec(combined_score_local, 2600);
                    end;
                end;
                if not SameText(Copy(baseline_text_local, 1,
                    Length(head_text_local)), head_text_local) then
                begin
                    Inc(combined_score_local, c_mismatched_head_bonus);
                end;
                complete_support_score_local := 0;
                complete_support_segments_local := 0;
                complete_support_path_local :=
                    infer_segment_path_for_query_text_with_score(lookup_text,
                    combined_text_local, complete_support_score_local,
                    complete_support_segments_local);
                if (complete_support_path_local <> '') and
                    (complete_support_segments_local > 0) then
                begin
                    Inc(combined_score_local,
                        Min(36000, complete_support_score_local));
                    Inc(combined_score_local,
                        (input_syllable_count - complete_support_segments_local) * 240);
                end;

                if (not Result) or (combined_score_local >
                    out_candidate_local.score) then
                begin
                    FillChar(out_candidate_local, SizeOf(out_candidate_local), 0);
                    out_candidate_local.text := combined_text_local;
                    out_candidate_local.comment := '';
                    out_candidate_local.score := combined_score_local;
                    out_candidate_local.source := cs_rule;
                    out_candidate_local.has_dict_weight := True;
                    out_candidate_local.dict_weight := combined_score_local;
                    if complete_support_path_local <> '' then
                    begin
                        out_encoded_path_local := complete_support_path_local;
                    end
                    else
                    begin
                        out_encoded_path_local := head_text_local +
                            c_segment_path_separator + tail_text_local;
                    end;
                    Result := True;
                end;
            end;
        end;
    end;

    function try_pick_supported_complete_candidate_local(
        const candidates_local: TncCandidateList;
        const baseline_candidate_local: TncCandidate;
        const baseline_encoded_path_local: string;
        out out_candidate_local: TncCandidate;
        out out_encoded_path_local: string): Boolean;
    const
        c_probe_limit = 18;
        c_score_margin = 300;
        c_strong_segment_gap = 2;
    var
        idx_local: Integer;
        probe_limit_local: Integer;
        candidate_text_local: string;
        baseline_text_local: string;
        candidate_path_local: string;
        baseline_path_local: string;
        candidate_support_score_local: Integer;
        baseline_support_score_local: Integer;
        candidate_segment_count_local: Integer;
        baseline_segment_count_local: Integer;
        candidate_units_local: Integer;
        baseline_units_local: Integer;
        candidate_rank_local: Integer;
        baseline_rank_local: Integer;
        best_rank_local: Integer;
        candidate_local: TncCandidate;
        path_syllables_local: TncPinyinParseResult;
        candidate_identity_key_local: string;

        function is_function_or_modifier_text_local(
            const value_local: string): Boolean;
        begin
            Result := False;
            if Length(value_local) <> 1 then
            begin
                Exit;
            end;

            case Ord(value_local[1]) of
                $662F, $7684, $4E86, $5728, $4E8E, $4E5F, $548C, $4E0D,
                $518D, $9AD8, $5F88, $592A, $6700, $66F4, $6CA1, $8981,
                $4F1A, $80FD, $628A, $88AB, $8BA9, $7ED9, $5BF9, $4ECE,
                $5411, $4E0E, $90FD, $8FD8, $624D, $5C31, $53EA, $522B,
                $5DF2, $5C06, $53EF, $60F3, $65E0, $975E, $672A, $4ECD,
                $591A, $5C11, $65B0, $8001, $5C0F, $5927, $5168, $8D85,
                $771F, $597D, $5982, $633A, $8F83, $6781:
                    Result := True;
            end;
        end;

        function build_path_syllable_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            key_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(path_syllables_local)) then
            begin
                Exit;
            end;
            for key_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    path_syllables_local[key_idx_local].text);
            end;
        end;

        function get_exact_text_weight_local(const start_idx_local: Integer;
            const count_local: Integer; const expected_text_local: string;
            out out_weight_local: Integer): Boolean;
        var
            key_local: string;
            results_local: TncCandidateList;
            idx_local: Integer;
            text_local: string;
            weight_local: Integer;
        begin
            Result := False;
            out_weight_local := 0;
            key_local := build_path_syllable_key_local(start_idx_local,
                count_local);
            if (key_local = '') or
                (not dictionary_exact_lookup_cached(key_local, results_local)) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(results_local) do
            begin
                if idx_local >= 12 then
                begin
                    Break;
                end;
                if Trim(results_local[idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                text_local := Trim(results_local[idx_local].text);
                if (text_local = '') or
                    (get_candidate_text_unit_count(text_local) <> count_local) or
                    ((expected_text_local <> '') and
                    (not SameText(text_local, expected_text_local))) then
                begin
                    Continue;
                end;
                weight_local := results_local[idx_local].score;
                if results_local[idx_local].has_dict_weight and
                    (results_local[idx_local].dict_weight > weight_local) then
                begin
                    weight_local := results_local[idx_local].dict_weight;
                end;
                if (not Result) or (weight_local > out_weight_local) then
                begin
                    Result := True;
                    out_weight_local := weight_local;
                end;
            end;
        end;

        function get_structural_path_quality_local(
            const encoded_path_local: string): Integer;
        var
            parts_local: TArray<string>;
            part_idx_local: Integer;
            pos_local: Integer;
            units_local: TArray<string>;
            unit_count_local: Integer;
            segment_text_local: string;
            segment_weight_local: Integer;
            best_segment_weight_local: Integer;
            left_weight_local: Integer;
            right_weight_local: Integer;
        begin
            Result := 0;
            if (Trim(encoded_path_local) = '') or
                (Length(path_syllables_local) = 0) then
            begin
                Exit;
            end;

            parts_local := encoded_path_local.Split([c_segment_path_separator]);
            pos_local := 0;
            for part_idx_local := 0 to High(parts_local) do
            begin
                segment_text_local := Trim(parts_local[part_idx_local]);
                if segment_text_local = '' then
                begin
                    Continue;
                end;
                units_local := split_text_units(segment_text_local);
                unit_count_local := Length(units_local);
                if (unit_count_local <= 0) or
                    (pos_local + unit_count_local > Length(path_syllables_local)) then
                begin
                    Exit;
                end;

                if get_exact_text_weight_local(pos_local, unit_count_local,
                    segment_text_local, segment_weight_local) then
                begin
                    if get_exact_text_weight_local(pos_local, unit_count_local, '',
                        best_segment_weight_local) and
                        (best_segment_weight_local >=
                        segment_weight_local + 240) then
                    begin
                        Dec(Result, Min(80000, 12000 +
                            (best_segment_weight_local -
                            segment_weight_local) * 80));
                    end;

                    if unit_count_local >= 4 then
                    begin
                        Inc(Result, 20000 + (unit_count_local - 4) * 3000);
                    end
                    else if (unit_count_local = 3) and
                        (segment_weight_local >= 1000) then
                    begin
                        Inc(Result, 1200);
                    end;

                    if (unit_count_local = 3) and
                        (segment_weight_local < 1000) then
                    begin
                        if get_exact_text_weight_local(pos_local, 2, '',
                            left_weight_local) and
                            (left_weight_local >= Max(700,
                            segment_weight_local + 180)) then
                        begin
                            Dec(Result, 20000);
                        end
                        else if is_function_or_modifier_text_local(
                            units_local[0]) and
                            get_exact_text_weight_local(pos_local + 1, 2, '',
                            right_weight_local) and
                            (right_weight_local >= Max(700,
                            segment_weight_local + 120)) then
                        begin
                            Dec(Result, 20000);
                        end;
                    end;
                end;

                Inc(pos_local, unit_count_local);
            end;
        end;

        function support_rank_local(const support_score_local: Integer;
            const segment_count_local: Integer;
            const candidate_score_local: Integer;
            const encoded_path_local: string): Integer;
        begin
            Result := support_score_local + candidate_score_local div 24;
            if segment_count_local > 0 then
            begin
                Inc(Result, (input_syllable_count - segment_count_local) * 500);
            end;
            Inc(Result, get_structural_path_quality_local(encoded_path_local));
        end;

        function is_promotable_complete_local(
            const candidate_value_local: TncCandidate;
            const candidate_text_value_local: string): Boolean;
        begin
            Result := False;
            if (Trim(candidate_value_local.comment) <> '') or
                (candidate_text_value_local = '') or
                SameText(candidate_text_value_local, baseline_text_local) then
            begin
                Exit;
            end;
            if is_runtime_chain_candidate(candidate_value_local) or
                is_runtime_common_pattern_candidate(candidate_value_local) or
                is_runtime_redup_candidate(candidate_value_local) then
            begin
                Exit;
            end;
            Result := get_candidate_text_unit_count(candidate_text_value_local) =
                input_syllable_count;
        end;
    begin
        Result := False;
        FillChar(out_candidate_local, SizeOf(out_candidate_local), 0);
        out_encoded_path_local := '';

        if (Length(candidates_local) <= 0) or (input_syllable_count < 4) or
            (input_syllable_count > 24) then
        begin
            Exit;
        end;

        baseline_text_local := Trim(baseline_candidate_local.text);
        baseline_units_local := get_candidate_text_unit_count(baseline_text_local);
        if (baseline_text_local = '') or
            (baseline_units_local <> input_syllable_count) then
        begin
            Exit;
        end;
        path_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);

        baseline_path_local := infer_segment_path_for_query_text_with_score(
            lookup_text, baseline_text_local, baseline_support_score_local,
            baseline_segment_count_local);
        if (baseline_path_local = '') and
            (m_current_segment_path_map <> nil) then
        begin
            candidate_identity_key_local := build_candidate_identity_key(
                baseline_candidate_local.text, baseline_candidate_local.comment);
            if candidate_identity_key_local <> '' then
            begin
                m_current_segment_path_map.TryGetValue(
                    candidate_identity_key_local, baseline_path_local);
            end;
        end;
        if baseline_path_local = '' then
        begin
            baseline_path_local := baseline_encoded_path_local;
            baseline_segment_count_local :=
                get_encoded_path_segment_count_local(baseline_path_local);
            baseline_support_score_local := baseline_candidate_local.score;
        end;
        if baseline_segment_count_local <= 0 then
        begin
            Exit;
        end;
        baseline_rank_local := support_rank_local(baseline_support_score_local,
            baseline_segment_count_local, baseline_candidate_local.score,
            baseline_path_local);

        best_rank_local := Low(Integer);
        probe_limit_local := Min(High(candidates_local), c_probe_limit - 1);
        for idx_local := 0 to probe_limit_local do
        begin
            candidate_local := candidates_local[idx_local];
            candidate_text_local := Trim(candidate_local.text);
            if not is_promotable_complete_local(candidate_local,
                candidate_text_local) then
            begin
                Continue;
            end;

            candidate_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, candidate_text_local, candidate_support_score_local,
                candidate_segment_count_local);
            if (candidate_path_local = '') and
                (m_current_segment_path_map <> nil) then
            begin
                candidate_identity_key_local := build_candidate_identity_key(
                    candidate_local.text, candidate_local.comment);
                if candidate_identity_key_local <> '' then
                begin
                    m_current_segment_path_map.TryGetValue(
                        candidate_identity_key_local, candidate_path_local);
                    if candidate_path_local <> '' then
                    begin
                        candidate_segment_count_local :=
                            get_encoded_path_segment_count_local(
                            candidate_path_local);
                        candidate_support_score_local := candidate_local.score;
                    end;
                end;
            end;
            if (candidate_path_local = '') or
                (candidate_segment_count_local <= 0) then
            begin
                Continue;
            end;

            candidate_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            if candidate_units_local <> input_syllable_count then
            begin
                Continue;
            end;

            candidate_rank_local := support_rank_local(
                candidate_support_score_local, candidate_segment_count_local,
                candidate_local.score, candidate_path_local);
            if (candidate_segment_count_local <= baseline_segment_count_local -
                c_strong_segment_gap) then
            begin
                Inc(candidate_rank_local, 6000);
            end
            else if candidate_segment_count_local < baseline_segment_count_local then
            begin
                Inc(candidate_rank_local, 3200);
            end
            else if candidate_segment_count_local >
                baseline_segment_count_local + 1 then
            begin
                Dec(candidate_rank_local, 2800);
            end;

            if (candidate_rank_local <= baseline_rank_local + c_score_margin) and
                (candidate_segment_count_local >= baseline_segment_count_local) then
            begin
                Continue;
            end;

            if (not Result) or (candidate_rank_local > best_rank_local) then
            begin
                Result := True;
                best_rank_local := candidate_rank_local;
                out_candidate_local := candidate_local;
                out_candidate_local.comment := '';
                if out_candidate_local.score <= baseline_candidate_local.score then
                begin
                    out_candidate_local.score := baseline_candidate_local.score +
                        Min(12000, Max(1600, candidate_rank_local -
                        baseline_rank_local));
                end;
                out_candidate_local.has_dict_weight := True;
                out_candidate_local.dict_weight := out_candidate_local.score;
                out_encoded_path_local := candidate_path_local;
            end;
        end;
    end;

    procedure ensure_fast_tail_exact_completion_visible_local(
        var candidates: TncCandidateList);
    const
        c_candidate_probe_limit = 18;
        c_tail_probe_limit = 12;
        c_tail_max_syllables = 4;
    var
        idx_local: Integer;
        tail_idx_local: Integer;
        existing_idx_local: Integer;
        move_idx_local: Integer;
        prefix_text_local: string;
        tail_key_local: string;
        tail_units_local: Integer;
        prefix_units_local: Integer;
        tail_results_local: TncCandidateList;
        tail_text_local: string;
        tail_weight_local: Integer;
        best_text_local: string;
        best_path_local: string;
        best_score_local: Integer;
        candidate_score_local: Integer;
        candidate_path_local: string;
        completion_text_local: string;
        completion_candidate_local: TncCandidate;
        support_path_local: string;
        support_score_local: Integer;
        support_segments_local: Integer;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        best_text_local := '';
        best_path_local := '';
        best_score_local := Low(Integer);
        for idx_local := 0 to Min(High(candidates),
            c_candidate_probe_limit - 1) do
        begin
            prefix_text_local := Trim(candidates[idx_local].text);
            tail_key_local := normalize_pinyin_text(
                Trim(candidates[idx_local].comment));
            if (prefix_text_local = '') or (tail_key_local = '') or
                (not is_full_pinyin_key(tail_key_local)) then
            begin
                Continue;
            end;

            prefix_units_local := get_candidate_text_unit_count(
                prefix_text_local);
            tail_units_local := get_effective_compact_pinyin_unit_count(
                tail_key_local);
            if (prefix_units_local < 2) or (tail_units_local < 1) or
                (tail_units_local > c_tail_max_syllables) or
                (prefix_units_local + tail_units_local <> input_syllable_count) then
            begin
                Continue;
            end;

            if not lookup_exact_full_pinyin_cached_local(tail_key_local,
                tail_results_local) then
            begin
                Continue;
            end;

            for tail_idx_local := 0 to High(tail_results_local) do
            begin
                if tail_idx_local >= c_tail_probe_limit then
                begin
                    Break;
                end;
                if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                if (tail_text_local = '') or
                    (get_candidate_text_unit_count(tail_text_local) <>
                    tail_units_local) then
                begin
                    Continue;
                end;

                tail_weight_local := tail_results_local[tail_idx_local].score;
                if tail_results_local[tail_idx_local].has_dict_weight and
                    (tail_results_local[tail_idx_local].dict_weight >
                    tail_weight_local) then
                begin
                    tail_weight_local :=
                        tail_results_local[tail_idx_local].dict_weight;
                end;
                if tail_weight_local < 260 then
                begin
                    Continue;
                end;

                completion_text_local := prefix_text_local + tail_text_local;
                if (Trim(candidates[0].comment) = '') and
                    SameText(Trim(candidates[0].text), completion_text_local) then
                begin
                    Continue;
                end;

                candidate_score_local := prefix_units_local * 800 +
                    tail_units_local * 3000 + tail_weight_local * 4 +
                    Min(8000, Max(0, candidates[idx_local].score div 4));
                support_path_local := infer_segment_path_for_query_text_with_score(
                    lookup_text, completion_text_local, support_score_local,
                    support_segments_local);
                if (support_path_local <> '') and
                    (support_segments_local > 0) then
                begin
                    Inc(candidate_score_local, support_score_local);
                    Inc(candidate_score_local,
                        (input_syllable_count - support_segments_local) * 1200);
                end
                else
                begin
                    Dec(candidate_score_local, 2400);
                end;
                if candidate_score_local > best_score_local then
                begin
                    best_score_local := candidate_score_local;
                    best_text_local := completion_text_local;
                    if support_path_local <> '' then
                    begin
                        best_path_local := support_path_local;
                    end
                    else
                    begin
                        candidate_path_local := get_segment_path_for_candidate(
                            candidates[idx_local]);
                        if candidate_path_local = '' then
                        begin
                            candidate_path_local := prefix_text_local;
                        end;
                        best_path_local := candidate_path_local +
                            c_segment_path_separator + tail_text_local;
                    end;
                end;
            end;
        end;

        if best_text_local = '' then
        begin
            Exit;
        end;

        existing_idx_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                SameText(Trim(candidates[idx_local].text), best_text_local) then
            begin
                existing_idx_local := idx_local;
                Break;
            end;
        end;

        if existing_idx_local >= 0 then
        begin
            completion_candidate_local := candidates[existing_idx_local];
        end
        else
        begin
            FillChar(completion_candidate_local,
                SizeOf(completion_candidate_local), 0);
            completion_candidate_local.text := best_text_local;
            completion_candidate_local.comment := '';
            completion_candidate_local.source := cs_rule;
        end;

        completion_candidate_local.score := Max(candidates[0].score + 2048,
            best_score_local);
        completion_candidate_local.has_dict_weight := True;
        completion_candidate_local.dict_weight := completion_candidate_local.score;
        remember_segment_path_for_candidate(completion_candidate_local.text, '',
            best_path_local, completion_candidate_local.score);

        if existing_idx_local >= 0 then
        begin
            for move_idx_local := existing_idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := completion_candidate_local;
            Exit;
        end;

        SetLength(candidates, Length(candidates) + 1);
        for move_idx_local := High(candidates) downto 1 do
        begin
            candidates[move_idx_local] := candidates[move_idx_local - 1];
        end;
        candidates[0] := completion_candidate_local;
    end;

    procedure promote_best_supported_complete_candidate_visible_local(
        var candidates: TncCandidateList);
    const
        c_candidate_probe_limit = 12;
        c_promote_margin = 240;
    var
        idx_local: Integer;
        move_idx_local: Integer;
        best_idx_local: Integer;
        top_rank_local: Integer;
        top_segments_local: Integer;
        best_rank_local: Integer;
        support_score_local: Integer;
        support_segments_local: Integer;
        candidate_rank_local: Integer;
        candidate_text_local: string;
        support_path_local: string;
        path_hint_local: string;
        support_bonus_local: Integer;
        hint_bonus_local: Integer;
        best_candidate_local: TncCandidate;
        path_syllables_local: TncPinyinParseResult;

        function is_modifier_single_text_local(const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $662F, $7684, $4E86, $5728, $548C, $4E0D, $518D, $9AD8,
                $5F88, $592A, $6700, $66F4, $6CA1, $8981, $4F1A, $80FD,
                $628A, $88AB, $8BA9, $7ED9, $5982, $8001, $5C0F, $5927,
                $5168, $8D85, $771F, $597D, $53C8, $4E5F, $5DF2, $5C06,
                $53EF, $60F3, $65E0, $975E, $672A, $4ECD, $90FD, $8FD8,
                $624D, $5C31, $53EA, $522B, $591A, $5C11, $65B0, $633A,
                $8F83, $9887, $6781, $5411, $5BF9, $4ECE, $4E8E, $4E0E,
                $800C, $5E76:
                    Result := True;
            end;
        end;

        function get_modifier_head_tail_path_bonus_local(
            const encoded_path: string): Integer;
        var
            path_parts_local: TArray<string>;
            head_text_local: string;
            tail_text_local: string;
        begin
            Result := 0;
            if encoded_path = '' then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            if Length(path_parts_local) <> 2 then
            begin
                Exit;
            end;

            head_text_local := Trim(path_parts_local[0]);
            tail_text_local := Trim(path_parts_local[1]);
            if is_modifier_single_text_local(head_text_local) and
                (get_candidate_text_unit_count(tail_text_local) >= 2) then
            begin
                Result := 3500;
            end;
        end;

        function get_long_exact_segment_path_bonus_local(
            const encoded_path: string): Integer;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            unit_count_local: Integer;
        begin
            Result := 0;
            if encoded_path = '' then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                unit_count_local := get_candidate_text_unit_count(
                    Trim(path_parts_local[part_idx_local]));
                if unit_count_local >= 4 then
                begin
                    Inc(Result, 50000 + (unit_count_local - 4) * 8000);
                end;
            end;
        end;

        function build_path_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            key_idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(path_syllables_local)) then
            begin
                Exit;
            end;
            for key_idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    path_syllables_local[key_idx_local].text);
            end;
        end;

        function get_best_exact_weight_for_path_span_local(
            const start_idx_local: Integer; const count_local: Integer;
            const expected_text_local: string): Integer;
        var
            key_local: string;
            results_local: TncCandidateList;
            idx_local: Integer;
            text_local: string;
            weight_local: Integer;
        begin
            Result := Low(Integer);
            key_local := build_path_key_local(start_idx_local, count_local);
            if (key_local = '') or
                (not dictionary_exact_lookup_cached(key_local, results_local)) then
            begin
                Exit;
            end;
            for idx_local := 0 to High(results_local) do
            begin
                if idx_local >= 12 then
                begin
                    Break;
                end;
                if Trim(results_local[idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                text_local := Trim(results_local[idx_local].text);
                if (text_local = '') or
                    (get_candidate_text_unit_count(text_local) <> count_local) or
                    ((expected_text_local <> '') and
                    (not SameText(text_local, expected_text_local))) then
                begin
                    Continue;
                end;
                weight_local := results_local[idx_local].score;
                if results_local[idx_local].has_dict_weight and
                    (results_local[idx_local].dict_weight > weight_local) then
                begin
                    weight_local := results_local[idx_local].dict_weight;
                end;
                if weight_local > Result then
                begin
                    Result := weight_local;
                end;
            end;
        end;

        function get_suspicious_three_segment_path_penalty_local(
            const encoded_path: string): Integer;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            pos_local: Integer;
            segment_text_local: string;
            unit_count_local: Integer;
            segment_weight_local: Integer;
            split_weight_local: Integer;
        begin
            Result := 0;
            if (encoded_path = '') or (Length(path_syllables_local) = 0) then
            begin
                Exit;
            end;
            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            pos_local := 0;
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                unit_count_local := get_candidate_text_unit_count(segment_text_local);
                if (unit_count_local <= 0) or
                    (pos_local + unit_count_local > Length(path_syllables_local)) then
                begin
                    Exit;
                end;
                if unit_count_local = 3 then
                begin
                    segment_weight_local :=
                        get_best_exact_weight_for_path_span_local(pos_local, 3,
                        segment_text_local);
                    split_weight_local :=
                        get_best_exact_weight_for_path_span_local(pos_local, 2, '');
                    if (segment_weight_local < 700) and
                        (split_weight_local >= Max(700,
                        segment_weight_local + 180)) then
                    begin
                        Inc(Result, 50000);
                    end;
                end;
                Inc(pos_local, unit_count_local);
            end;
        end;

        function get_same_span_competitor_path_penalty_local(
            const encoded_path: string): Integer;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            pos_local: Integer;
            segment_text_local: string;
            unit_count_local: Integer;
            segment_weight_local: Integer;
            best_segment_weight_local: Integer;
            weight_gap_local: Integer;
        begin
            Result := 0;
            if (encoded_path = '') or (Length(path_syllables_local) = 0) then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            pos_local := 0;
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                unit_count_local := get_candidate_text_unit_count(segment_text_local);
                if (unit_count_local <= 0) or
                    (pos_local + unit_count_local > Length(path_syllables_local)) then
                begin
                    Exit;
                end;

                if get_best_exact_weight_for_path_span_local(pos_local,
                    unit_count_local, segment_text_local) <>
                    Low(Integer) then
                begin
                    segment_weight_local :=
                        get_best_exact_weight_for_path_span_local(pos_local,
                        unit_count_local, segment_text_local);
                    best_segment_weight_local :=
                        get_best_exact_weight_for_path_span_local(pos_local,
                        unit_count_local, '');
                    if best_segment_weight_local <> Low(Integer) then
                    begin
                        weight_gap_local := best_segment_weight_local -
                            segment_weight_local;
                        if weight_gap_local >= 240 then
                        begin
                            Inc(Result, Min(80000, 12000 +
                                weight_gap_local * 80));
                        end;
                    end;
                end;

                Inc(pos_local, unit_count_local);
            end;
        end;
    begin
        if (Length(candidates) <= 1) or (m_dictionary = nil) or
            (input_syllable_count < 3) or (input_syllable_count > 24) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        top_rank_local := Low(Integer);
        top_segments_local := 0;
        path_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        for idx_local := 0 to Min(High(candidates),
            c_candidate_probe_limit - 1) do
        begin
            candidate_text_local := Trim(candidates[idx_local].text);
            if (candidate_text_local = '') or
                (Trim(candidates[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;
            if (candidates[idx_local].source <> cs_user) and
                is_unsupported_short_four_ab_cd_text_local(
                candidate_text_local) then
            begin
                Continue;
            end;

            support_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, candidate_text_local, support_score_local,
                support_segments_local);
            path_hint_local := get_segment_path_for_candidate(
                candidates[idx_local], idx_local);
            if (support_path_local = '') or (support_segments_local <= 0) then
            begin
                support_path_local := path_hint_local;
                support_segments_local :=
                    get_encoded_path_segment_count_local(support_path_local);
                support_score_local := candidates[idx_local].score;
                if (support_path_local = '') or (support_segments_local <= 0) then
                begin
                    Continue;
                end;
            end;

            candidate_rank_local := support_score_local +
                candidates[idx_local].score div 32 - support_segments_local * 120;
            support_bonus_local :=
                get_modifier_head_tail_path_bonus_local(support_path_local);
            hint_bonus_local :=
                get_modifier_head_tail_path_bonus_local(path_hint_local);
            Inc(candidate_rank_local, Max(support_bonus_local, hint_bonus_local));
            Inc(candidate_rank_local, Max(
                get_long_exact_segment_path_bonus_local(support_path_local),
                get_long_exact_segment_path_bonus_local(path_hint_local)));
            Dec(candidate_rank_local, Max(
                get_suspicious_three_segment_path_penalty_local(support_path_local),
                get_suspicious_three_segment_path_penalty_local(path_hint_local)));
            Dec(candidate_rank_local, Max(
                get_same_span_competitor_path_penalty_local(support_path_local),
                get_same_span_competitor_path_penalty_local(path_hint_local)));
            if idx_local = 0 then
            begin
                top_rank_local := candidate_rank_local;
                top_segments_local := support_segments_local;
            end
            else if (top_segments_local > 0) and
                (support_segments_local < top_segments_local) then
            begin
                Inc(candidate_rank_local,
                    (top_segments_local - support_segments_local) * 1600);
            end;
            if (best_idx_local < 0) or
                (candidate_rank_local > best_rank_local) then
            begin
                best_idx_local := idx_local;
                best_rank_local := candidate_rank_local;
                remember_segment_path_for_candidate(candidates[idx_local].text,
                    candidates[idx_local].comment, support_path_local,
                    candidates[idx_local].score);
            end;
        end;

        if (best_idx_local <= 0) or
            (best_rank_local <= top_rank_local + c_promote_margin) then
        begin
            Exit;
        end;

        best_candidate_local := candidates[best_idx_local];
        if best_candidate_local.score <= candidates[0].score then
        begin
            best_candidate_local.score := candidates[0].score + 1024;
            best_candidate_local.has_dict_weight := True;
            best_candidate_local.dict_weight := best_candidate_local.score;
        end;
        for move_idx_local := best_idx_local downto 1 do
        begin
            candidates[move_idx_local] := candidates[move_idx_local - 1];
        end;
        candidates[0] := best_candidate_local;
    end;

    procedure demote_low_evidence_admin_place_alias_top_local(
        var candidates: TncCandidateList);
    var
        top_rank_local: Integer;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
        best_idx_local: Integer;
        idx_local: Integer;
        move_idx_local: Integer;
        moved_candidate_local: TncCandidate;
        moved_path_local: string;

        function is_low_evidence_admin_alias_candidate_local(
            const candidate: TncCandidate): Boolean;
        begin
            Result := (m_dictionary <> nil) and (lookup_text <> '') and
                (Trim(candidate.comment) = '') and
                is_low_evidence_admin_place_alias_cached(
                lookup_text, Trim(candidate.text));
        end;
    begin
        if (Length(candidates) <= 1) or
            (not is_low_evidence_admin_alias_candidate_local(candidates[0])) then
        begin
            Exit;
        end;

        top_rank_local := get_rank_score(candidates[0]);
        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx_local := 1 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) <> '') or
                is_low_evidence_admin_alias_candidate_local(candidates[idx_local]) then
            begin
                Continue;
            end;
            candidate_rank_local := get_rank_score(candidates[idx_local]);
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx_local;
            end;
        end;

        if (best_idx_local <= 0) or (best_rank_local <= top_rank_local) then
        begin
            Exit;
        end;

        moved_candidate_local := candidates[best_idx_local];
        moved_path_local := '';
        if best_idx_local < Length(m_candidate_segment_paths) then
        begin
            moved_path_local := m_candidate_segment_paths[best_idx_local];
        end;
        for move_idx_local := best_idx_local downto 1 do
        begin
            candidates[move_idx_local] := candidates[move_idx_local - 1];
            if move_idx_local < Length(m_candidate_segment_paths) then
            begin
                if (move_idx_local - 1) < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx_local] :=
                        m_candidate_segment_paths[move_idx_local - 1];
                end
                else
                begin
                    m_candidate_segment_paths[move_idx_local] := '';
                end;
            end;
        end;
        candidates[0] := moved_candidate_local;
        if Length(m_candidate_segment_paths) > 0 then
        begin
            m_candidate_segment_paths[0] := moved_path_local;
        end;
    end;

    procedure ensure_short_lexicon_prefix_completions_visible_local(
        var candidates: TncCandidateList);
    var
        evidence_local: TncOneKeyCompletionList;
        ranks_local: TArray<Int64>;
        distant_flags_local: TArray<Boolean>;
        exact_flags_local: TArray<Boolean>;
        item_local: TncOneKeyCompletion;
        candidate_local: TncCandidate;
        units_local: TArray<string>;
        prefix_local: string;
        anchored_local, distant_local, exact_local: Boolean;
        rank_local: Int64;
        idx_local, evidence_idx_local, unit_idx_local, insert_idx_local, move_idx_local: Integer;
        count_local, keep_local, distant_count_local, predicted_count_local: Integer;

        function has_visible_exact_prefix_local(const text_value: string): Boolean;
        var visible_idx: Integer;
        begin
            Result := False;
            for visible_idx := 0 to High(candidates) do
                if (Trim(candidates[visible_idx].comment) = '') and
                    (get_candidate_text_unit_count(candidates[visible_idx].text) =
                    input_syllable_count) and
                    SameText(Trim(candidates[visible_idx].text), text_value) then
                    Exit(True);
        end;

        function already_collected_local(const text_value: string): Boolean;
        var collected_idx: Integer;
        begin
            Result := False;
            for collected_idx := 0 to
                High(m_short_exact_lexicon_completion_candidates) do
                if SameText(m_short_exact_lexicon_completion_candidates[
                    collected_idx].text, text_value) then Exit(True);
        end;
    begin
        if (m_dictionary = nil) or (lookup_text = '') or
            (input_syllable_count < 2) then Exit;
        // An empty admitted pool is still authoritative. Later display passes
        // must not refill it from the old, unfiltered prefix probe.
        m_short_exact_lexicon_completion_query := normalize_pinyin_text(lookup_text);
        SetLength(m_short_exact_lexicon_completion_candidates, 0);
        SetLength(m_short_exact_lexicon_completion_texts, 0);
        if not m_dictionary.lookup_candidate_prefix_completions(lookup_text,
            evidence_local) then Exit;
        for evidence_idx_local := 0 to High(evidence_local) do
        begin
            item_local := evidence_local[evidence_idx_local];
            if item_local.source <> okcs_base_exact then Continue;
            item_local.text := Trim(item_local.text);
            exact_local := (item_local.full_pinyin <> '') and
                SameText(item_local.full_pinyin, lookup_text);
            units_local := split_text_units(item_local.text);
            if (Length(units_local) < input_syllable_count) and
                (not exact_local) then Continue;
            if (Length(units_local) = input_syllable_count) and
                has_visible_exact_prefix_local(item_local.text) then Continue;
            if already_collected_local(item_local.text) then Continue;
            prefix_local := '';
            for unit_idx_local := 0 to Min(input_syllable_count,
                Length(units_local)) - 1 do
                prefix_local := prefix_local + units_local[unit_idx_local];
            anchored_local := has_visible_exact_prefix_local(prefix_local);
            distant_local :=
                (not exact_local) and
                (input_syllable_count < c_long_sentence_full_path_min_syllables) and
                (Length(units_local) >= c_long_sentence_full_path_min_syllables);
            // A compact exact may use a different syllable split from the
            // primary parser. Restore it independently of prediction budgets.
            if exact_local then rank_local := Int64(High(Integer)) * 1000000 + item_local.weight
            else if not nc_prefix_completion_rank(item_local, input_syllable_count,
                Length(units_local), anchored_local, distant_local,
                rank_local) then Continue;

            insert_idx_local := 0;
            count_local := Length(m_short_exact_lexicon_completion_candidates);
            while insert_idx_local < count_local do
            begin
                if distant_flags_local[insert_idx_local] <> distant_local then
                begin
                    if not distant_local then Break;
                end
                else if rank_local > ranks_local[insert_idx_local] then Break;
                Inc(insert_idx_local);
            end;
            SetLength(m_short_exact_lexicon_completion_candidates, count_local + 1);
            SetLength(ranks_local, count_local + 1);
            SetLength(distant_flags_local, count_local + 1);
            SetLength(exact_flags_local, count_local + 1);
            for move_idx_local := count_local downto insert_idx_local + 1 do
            begin
                m_short_exact_lexicon_completion_candidates[move_idx_local] :=
                    m_short_exact_lexicon_completion_candidates[move_idx_local - 1];
                ranks_local[move_idx_local] := ranks_local[move_idx_local - 1];
                distant_flags_local[move_idx_local] := distant_flags_local[move_idx_local - 1];
                exact_flags_local[move_idx_local] := exact_flags_local[move_idx_local - 1];
            end;
            candidate_local := Default(TncCandidate);
            candidate_local.text := item_local.text;
            candidate_local.source := cs_rule;
            candidate_local.has_dict_weight := True;
            candidate_local.dict_weight := item_local.weight;
            candidate_local.score := item_local.weight;
            m_short_exact_lexicon_completion_candidates[insert_idx_local] := candidate_local;
            ranks_local[insert_idx_local] := rank_local;
            distant_flags_local[insert_idx_local] := distant_local;
            exact_flags_local[insert_idx_local] := exact_local;
        end;

        keep_local := 0;
        distant_count_local := 0;
        predicted_count_local := 0;
        for idx_local := 0 to High(m_short_exact_lexicon_completion_candidates) do
        begin
            if (not exact_flags_local[idx_local]) and
                (predicted_count_local >= c_short_prefix_completion_limit) then Continue;
            if distant_flags_local[idx_local] then
            begin
                if distant_count_local >= c_short_long_prefix_completion_limit then Continue;
                Inc(distant_count_local);
            end;
            m_short_exact_lexicon_completion_candidates[keep_local] :=
                m_short_exact_lexicon_completion_candidates[idx_local];
            if not exact_flags_local[idx_local] then Inc(predicted_count_local);
            Inc(keep_local);
        end;
        SetLength(m_short_exact_lexicon_completion_candidates, keep_local);
        SetLength(m_short_exact_lexicon_completion_texts, keep_local);
        for idx_local := 0 to keep_local - 1 do
            m_short_exact_lexicon_completion_texts[idx_local] :=
                m_short_exact_lexicon_completion_candidates[idx_local].text;
    end;

    procedure load_literal_user_candidates_local;
    var
        phase_tick_local: UInt64;
    begin
        SetLength(literal_user_candidates, 0);
        if (m_dictionary = nil) or (lookup_text = '') then
        begin
            Exit;
        end;

        phase_tick_local := GetTickCount64;
        m_dictionary.lookup_literal_user_words(lookup_text,
            literal_user_candidates);
        Inc(lookup_elapsed_ms, Int64(GetTickCount64 - phase_tick_local));
    end;

    procedure inject_literal_user_candidates_local;
    var
        total_limit_local: Integer;
    begin
        if Length(literal_user_candidates) = 0 then
        begin
            Exit;
        end;

        m_candidates := merge_candidate_lists(literal_user_candidates,
            m_candidates, 0);
        total_limit_local := get_total_candidate_limit;
        if (total_limit_local > 0) and
            (Length(m_candidates) > total_limit_local) then
        begin
            SetLength(m_candidates, total_limit_local);
        end;

        m_last_lookup_literal_user_fast := True;
        SetLength(m_candidate_segment_paths, 0);
        refresh_candidate_segment_paths;
        m_visible_candidates_cache_valid := False;
        SetLength(m_visible_candidates_cache, 0);
        SetLength(m_visible_candidate_source_indices_cache, 0);
        m_page_index := 0;
        m_selected_index := 0;
        m_last_candidates_incrementally_reusable := False;
        if m_config.debug_mode then
        begin
            m_last_lookup_debug_extra := Trim(m_last_lookup_debug_extra +
                ' literaluser=1');
        end;
    end;

    procedure reconcile_short_model_candidates_local;
    var
        syllables_local: TncPinyinParseResult;
        admitted_local, exact_local: TncCandidateList;
        evidence_local: TncPairPathEvidenceList;
        admitted_idx_local, candidate_idx_local, recovered_local: Integer;
        found_local, new_admission_local, release_partial_lock_local: Boolean;
    begin
        if (m_dictionary = nil) or (m_composition_text = '') or
            (input_syllable_count < 2) or (input_syllable_count > 4) or
            has_explicit_apostrophe_input or
            (not is_full_pinyin_key(lookup_text)) then Exit;

        new_admission_local := False;
        case input_syllable_count of
            2:
                begin
                    new_admission_local := not short_two_single_pair_prepared;
                    prepare_short_two_single_pair_candidates_local;
                    admitted_local := short_two_single_pair_candidates;
                end;
            3:
                begin
                    new_admission_local := not short_three_exact_pair_prepared;
                    prepare_short_three_exact_pair_candidates_local;
                    admitted_local := short_three_exact_pair_candidates;
                end;
            4:
                begin
                    // Only recorded model paths belong to this common exit.
                    // Existing grammatical fallbacks keep their own admission.
                    if (not m_dictionary.get_exact_pair_path_evidence(lookup_text,
                        evidence_local)) or (Length(evidence_local) = 0) then Exit;
                    if lookup_exact_full_pinyin_cached_local(lookup_text,
                        exact_local) and (Length(exact_local) > 0) then Exit;
                    syllables_local := get_effective_compact_pinyin_syllables(
                        lookup_text);
                    new_admission_local := not short_four_model_evidence_applied;
                    ensure_supported_short_four_two_exact_path_visible_local(
                        syllables_local, admitted_local);
                end;
        end;
        if Length(admitted_local) = 0 then Exit;

        recovered_local := 0;
        for admitted_idx_local := 0 to High(admitted_local) do
        begin
            found_local := False;
            for candidate_idx_local := 0 to High(m_candidates) do
                if (Trim(m_candidates[candidate_idx_local].comment) = '') and
                    SameText(Trim(m_candidates[candidate_idx_local].text),
                    Trim(admitted_local[admitted_idx_local].text)) then
                begin
                    found_local := True;
                    Break;
                end;
            if not found_local then Inc(recovered_local);
        end;

        // Apply newly admitted evidence once, but do not repeat a decision that
        // downstream context ranking has already seen. Missing paths are restored.
        if new_admission_local or (recovered_local > 0) then
            case input_syllable_count of
                2: ensure_short_two_single_pair_candidates_visible_local(m_candidates);
                3: ensure_short_three_exact_pair_candidates_visible_local(m_candidates);
                4: m_candidates := merge_candidate_lists(admitted_local, m_candidates, 0);
            end;

        // Fast-display flags describe the resulting pool, not the shortcut that
        // produced its seed. A validated complete path is no longer prefix-only.
        m_last_lookup_prefix_partial_fast := False;
        m_last_lookup_short312_head_fast := False;

        release_partial_lock_local := m_has_forced_visible_top_candidate and
            SameText(m_forced_visible_top_composition_text, m_composition_text) and
            SameText(m_forced_visible_top_lookup_key, m_last_lookup_key) and
            (Trim(m_forced_visible_top_candidate.comment) <> '') and
            (m_forced_visible_top_candidate.source <> cs_user);
        if release_partial_lock_local then
        begin
            m_has_forced_visible_top_candidate := False;
            m_forced_visible_top_from_incremental_lm_prefix := False;
        end;
        if new_admission_local or (recovered_local > 0) or release_partial_lock_local then
            m_visible_candidates_cache_valid := False;
        if m_config.debug_mode then
            m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                Format(' short-evidence-contract=[units=%d admitted=%d recovered=%d new=%d unlock=%d]',
                [input_syllable_count, Length(admitted_local), recovered_local,
                Ord(new_admission_local), Ord(release_partial_lock_local)]);
    end;

    procedure generate_candidates_local;
    var
        i, interactive_prefix_len: Integer;
    begin
        if m_lookup_context_query_bonus_cache <> nil then
        begin
            m_lookup_context_query_bonus_cache.Clear;
        end;
        if m_lookup_context_query_latest_bonus_cache <> nil then
        begin
            m_lookup_context_query_latest_bonus_cache.Clear;
        end;
        total_start_tick := GetTickCount64;
        lookup_cache_hits := 0;
        lookup_cache_misses := 0;
        lookup_elapsed_ms := 0;
        segment_elapsed_ms := 0;
        runtime_elapsed_ms := 0;
        post_elapsed_ms := 0;
        sort_elapsed_ms := 0;
        path_search_elapsed_ms := 0;
        extendable_same_tail_cache_valid := False;
        extendable_same_tail_cache_key := '';
        extendable_same_tail_cache_expected_count := -1;
        extendable_same_tail_cache_value := False;
        short_extendable_tail_cache_valid := False;
        short_extendable_tail_cache_value := False;
        skip_three_syllable_contextual_completion := False;
        short_two_single_pair_prepared := False;
        short_four_model_evidence_applied := False;
        SetLength(short_two_single_pair_candidates, 0);
        SetLength(short_two_single_pair_paths, 0);
        SetLength(short_two_single_pair_rank_scores, 0);
        m_short_two_single_pair_query := '';
        SetLength(m_short_two_single_pair_texts, 0);
        previous_short_three_exact_pair_query :=
            m_short_three_exact_pair_query;
        previous_short_three_exact_pair_texts :=
            m_short_three_exact_pair_texts;
        if m_visible_candidates_cache_valid then
        begin
            previous_visible_candidates := m_visible_candidates_cache;
        end
        else
        begin
            SetLength(previous_visible_candidates, 0);
        end;
        short_three_exact_pair_prepared := False;
        SetLength(short_three_exact_pair_candidates, 0);
        SetLength(short_three_exact_pair_paths, 0);
        SetLength(short_three_exact_pair_rank_scores, 0);
        m_short_three_exact_pair_query := '';
        SetLength(m_short_three_exact_pair_texts, 0);
        m_short_three_char_pair_path := '';
        m_short_three_char_pair_evidence := 0;
        m_short_exact_lexicon_completion_query := '';
        SetLength(m_short_exact_lexicon_completion_texts, 0);
        SetLength(m_short_exact_lexicon_completion_candidates, 0);
        long_path_exact_lookup_filter_depth := 0;
        SetLength(explicit_apostrophe_query_syllables, 0);
        explicit_apostrophe_query_parsed := False;
        SetLength(explicit_apostrophe_exact_candidates, 0);
        explicit_apostrophe_exact_candidates_loaded := False;
        previous_lookup_key := m_last_lookup_key;
        if m_last_candidates_incrementally_reusable then
        begin
            previous_candidates := m_candidates;
        end
        else
        begin
            previous_lookup_key := '';
            SetLength(previous_candidates, 0);
        end;
        m_last_candidates_incrementally_reusable := True;
        // A model handoff can rebuild the same pinyin. Preserve the snapshots
        // captured above, but never page new sources through an old display pool.
        m_visible_candidates_cache_valid := False;
        m_long_visible_candidate_pool_cache_valid := False;
        SetLength(m_candidates, 0);
        m_page_index := 0;
        m_selected_index := 0;
        m_candidate_navigation_started := False;
        m_candidate_paging_expanded := False;
        confirmed_prefix_boundary_partial_preferred := False;
        m_last_lookup_key := '';
        m_last_lookup_normalized_from := '';
        m_last_lookup_syllable_count := 0;
        m_last_three_syllable_partial_preference_kind := 0;
        m_last_three_syllable_head_exact_text := '';
        m_last_three_syllable_head_strength := 0;
        m_last_three_syllable_tail_strength := 0;
        m_last_three_syllable_first_single_strength := 0;
        m_last_three_syllable_last_single_strength := 0;
        m_last_three_syllable_head_path_bonus := 0;
        m_last_three_syllable_tail_path_bonus := 0;
        m_last_three_syllable_partial_debug_info := '';
        m_last_full_path_debug_info := '';
        m_last_lookup_debug_extra := '';
        m_last_lookup_timing_info := '';
        m_last_lookup_all_initial_fast := False;
        m_last_lookup_literal_user_fast := False;
        m_last_lookup_prefix_partial_fast := False;
        m_last_lookup_short312_head_fast := False;
        m_last_lookup_incremental_partial_reuse := False;
        m_runtime_chain_text := '';
        m_runtime_common_pattern_text := '';
        m_runtime_redup_text := '';
        SetLength(m_runtime_long_chain_candidates, 0);
        SetLength(m_runtime_long_complete_pool_candidates, 0);
        SetLength(m_runtime_long_retained_exact_edges, 0);
        m_long_complete_pool_pairwise_text := '';
        m_long_complete_pool_pairwise_insert_rank := -1;
        clear_segment_path_tracking;
        clear_lookup_bonus_caches;
        if m_composition_text = '' then
        begin
            Exit;
        end;

        has_raw_candidates := False;
        has_segment_candidates := False;
        raw_from_dictionary := False;
        lookup_text := normalize_pinyin_text(m_composition_text);
        m_last_lookup_key := lookup_text;
        load_literal_user_candidates_local;
        has_safe_trailing_initial_typing_state :=
            detect_safe_trailing_initial_typing_state(m_composition_text);
        // A mixed full/abbreviated input (e.g. "nhaoma") that spells a whole
        // dictionary word is not an adjacent-swap typo.
        if (not has_safe_trailing_initial_typing_state) and (not is_full_pinyin_key(lookup_text)) and
            not ((m_dictionary <> nil) and
            m_dictionary.lookup_mixed_abbreviation_words(lookup_text, mixed_abbreviation_words)) then
        begin
            normalized_lookup_text := normalize_adjacent_swap_typo(lookup_text);
            if (normalized_lookup_text <> '') and (not SameText(normalized_lookup_text, lookup_text)) then
            begin
                m_last_lookup_normalized_from := lookup_text;
                lookup_text := normalized_lookup_text;
            end;
