    Result := m_dictionary.get_query_segment_path_bonus(query_key,
        encoded_path);
    if m_lookup_query_path_bonus_cache <> nil then
    begin
        m_lookup_query_path_bonus_cache.AddOrSetValue(cache_key, Result);
    end;
end;

