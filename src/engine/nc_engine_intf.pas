                end;

                function should_defer_pair_to_modifier_tail_exact_inner(
                    const pair_text_inner: string;
                    const pair_raw_weight_inner: Integer): Boolean;
                var
                    prefix_text_inner_local: string;
                    tail_key_inner_local: string;
                    tail_text_inner_local: string;
                    pair_units_inner: TArray<string>;
                begin
                    Result := False;
                    if (chunk_len_inner <> 2) or
                        (start_idx_local + 2 >= syllable_count_local) or
                        (pair_text_inner = '') then
                    begin
                        Exit;
                    end;

                    if not try_get_modifier_prefix_single_text_local(
                        effective_syllables[start_idx_local].text,
                        prefix_text_inner_local) then
                    begin
                        prefix_text_inner_local :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[start_idx_local].text);
                        if (prefix_text_inner_local = '') or
                            (not is_function_or_modifier_single_quality_inner(
                            prefix_text_inner_local)) then
                        begin
                            Exit;
                        end;
                    end;

                    pair_units_inner := split_text_units(Trim(pair_text_inner));
                    if Length(pair_units_inner) <> 2 then
                    begin
                        Exit;
                    end;

                    tail_key_inner_local := build_query_key_local(start_idx_local + 1, 2);
                    if not try_get_strong_fast_exact_phrase_text_local(
                        tail_key_inner_local, 2, 700, tail_text_inner_local) then
                    begin
                        Exit;
                    end;

                    if SameText(pair_units_inner[0], prefix_text_inner_local) then
                    begin
                        Result := not SameText(pair_units_inner[1],
                            get_first_text_unit_fast_local(tail_text_inner_local));
                    end
                    else
                    begin
                        Result := pair_raw_weight_inner < 900;
                    end;
                end;

                function is_deferable_function_tail_single_inner(
                    const text_value_inner: string): Boolean;
                begin
                    Result := False;
                    if get_candidate_text_unit_count(text_value_inner) <> 1 then
                    begin
                        Exit;
                    end;

                    case Ord(text_value_inner[1]) of
                        $7684, $5730, $5F97, $4E86, $7740, $8FC7:
                            Result := True;
                    end;
                end;

                function should_defer_chunk_to_head_plus_function_tail_inner(
                    const chunk_text_inner: string;
                    const chunk_raw_weight_inner: Integer): Boolean;
                const
                    c_head_exact_min_raw = 700;
                    c_tail_chunk_strength_margin = 180;
                var
                    chunk_units_inner: TArray<string>;
                    tail_text_inner_local: string;
                    head_key_inner_local: string;
                    head_text_inner_local: string;
                    head_raw_weight_inner_local: Integer;
                begin
                    Result := False;
                    if (chunk_len_inner < 3) or (chunk_len_inner > 4) or
                        (chunk_text_inner = '') then
                    begin
                        Exit;
                    end;

                    chunk_units_inner := split_text_units(Trim(chunk_text_inner));
                    if Length(chunk_units_inner) <> chunk_len_inner then
                    begin
                        Exit;
                    end;

                    if not try_get_stable_bridge_single_text_inner(
                        effective_syllables[start_idx_local + chunk_len_inner - 1].text,
                        tail_text_inner_local) then
                    begin
                        Exit;
                    end;

                    if (not is_deferable_function_tail_single_inner(
                        tail_text_inner_local)) or
                        (not SameText(chunk_units_inner[High(chunk_units_inner)],
                        tail_text_inner_local)) then
                    begin
                        Exit;
                    end;

                    head_key_inner_local := build_query_key_local(start_idx_local,
                        chunk_len_inner - 1);
                    if not try_get_strong_fast_exact_phrase_text_local(
                        head_key_inner_local, chunk_len_inner - 1,
                        c_head_exact_min_raw, head_text_inner_local) then
                    begin
                        Exit;
                    end;
                    if text_starts_with_fast_local(chunk_text_inner,
                        head_text_inner_local) then
                    begin
                        Exit;
                    end;

                    { Prefer a strong head exact plus a function tail over a
                      competing exact chunk that only wins by absorbing the
                      tail, e.g. head+de/di/de/le/zhe/guo boundaries. }
                    head_raw_weight_inner_local :=
                        get_fast_exact_phrase_raw_weight_local(
                        head_key_inner_local, chunk_len_inner - 1,
                        head_text_inner_local);
                    Result := (head_raw_weight_inner_local > 0) and
                        ((chunk_raw_weight_inner <= 0) or
                        (chunk_raw_weight_inner <=
                        head_raw_weight_inner_local +
                        c_tail_chunk_strength_margin));
                end;

                procedure add_fixed_single_option_inner(
                    const single_text_value_inner: string;
                    const score_penalty_value_inner: Integer);
                var
                    scan_idx_inner_local: Integer;
                    single_score_inner: Integer;
                    single_rank_inner: Integer;
                    single_raw_weight_inner: Integer;
                    single_top_weight_inner: Integer;
                    scan_raw_weight_inner: Integer;
                    single_source_user_inner: Boolean;
                    single_option_inner: TExactChunkChainOption;
                begin
                    if single_text_value_inner = '' then
                    begin
                        Exit;
                    end;

                    single_score_inner := 1200;
                    single_rank_inner := 0;
                    single_raw_weight_inner := 0;
                    single_top_weight_inner := 0;
                    single_source_user_inner := False;
                    if lookup_exact_full_pinyin_cached_local(query_key_inner,
                        lookup_results_inner) then
                    begin
                        for scan_idx_inner_local := 0 to
                            High(lookup_results_inner) do
                        begin
                            if scan_idx_inner_local >= get_chain_probe_limit_local then
                            begin
                                Break;
                            end;
                            scan_raw_weight_inner := 0;
                            if use_exact_edge_ranker_expansion_local then
                            begin
                                if Trim(lookup_results_inner[
                                    scan_idx_inner_local].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                if get_candidate_text_unit_count(Trim(
                                    lookup_results_inner[
                                    scan_idx_inner_local].text)) <> 1 then
                                begin
                                    Continue;
                                end;
                                scan_raw_weight_inner :=
                                    get_exact_chunk_raw_weight_local(
                                    lookup_results_inner[scan_idx_inner_local]);
                                single_top_weight_inner := Max(
                                    single_top_weight_inner,
                                    scan_raw_weight_inner);
                            end;
                            if SameText(Trim(lookup_results_inner[
                                scan_idx_inner_local].text),
                                single_text_value_inner) then
                            begin
                                single_score_inner :=
                                    get_exact_chunk_effective_weight_local(
                                    lookup_results_inner[scan_idx_inner_local]);
                                if use_exact_edge_ranker_expansion_local then
                                begin
                                    single_rank_inner :=
                                        scan_idx_inner_local + 1;
                                    single_raw_weight_inner :=
                                        scan_raw_weight_inner;
                                    single_source_user_inner :=
                                        lookup_results_inner[
                                        scan_idx_inner_local].source = cs_user;
                                end
                                else
                                begin
                                    Break;
                                end;
                            end;
                        end;
                    end;
                    Inc(single_score_inner, get_preferred_query_phrase_bonus_local(
                        query_key_inner, single_text_value_inner));
                    if (start_idx_local + chunk_len_inner = syllable_count_local) then
                    begin
                        Inc(single_score_inner, 36000);
                    end;
                    Inc(single_score_inner, c_fast_fixed_single_bonus);
                    Dec(single_score_inner, score_penalty_value_inner);

                    single_option_inner := Default(TExactChunkChainOption);
                    single_option_inner.text := single_text_value_inner;
                    single_option_inner.path := single_text_value_inner;
                    single_option_inner.query_key := query_key_inner;
                    single_option_inner.score := single_score_inner;
                    single_option_inner.exact_rank := single_rank_inner;
                    single_option_inner.raw_weight := single_raw_weight_inner;
                    single_option_inner.top_weight := single_top_weight_inner;
                    single_option_inner.source_user :=
                        single_source_user_inner;
                    single_option_inner.direct_exact := single_rank_inner > 0;
                    single_option_inner.segments := 1;
                    single_option_inner.has_anchor := True;
                    single_option_inner.anchor_units := 1;
                    add_fast_option_local(out_options_local,
                        legacy_options_inner, single_option_inner);
                end;

                procedure add_single_exact_edge_candidates_inner(
                    const protected_text_inner: string);
                var
                    edge_idx_inner: Integer;
                    edge_text_inner: string;
                    edge_score_inner: Integer;
                    edge_raw_inner: Integer;
                    edge_top_inner: Integer;
                    edge_option_inner: TExactChunkChainOption;
                begin
                    if not lookup_exact_full_pinyin_cached_local(query_key_inner,
                        lookup_results_inner) then
                    begin
                        Exit;
                    end;
                    edge_top_inner := 0;
                    for edge_idx_inner := 0 to Min(
                        get_chain_probe_limit_local - 1,
                        High(lookup_results_inner)) do
                    begin
                        if Trim(lookup_results_inner[edge_idx_inner].comment) <> '' then
                        begin
                            Continue;
                        end;
                        edge_text_inner := Trim(
                            lookup_results_inner[edge_idx_inner].text);
                        if (get_candidate_text_unit_count(edge_text_inner) <> 1) or
                            (not is_valid_standalone_cjk_phrase_text_local(
                            edge_text_inner, 1)) then
                        begin
                            Continue;
                        end;
                        edge_raw_inner := get_exact_chunk_raw_weight_local(
                            lookup_results_inner[edge_idx_inner]);
                        edge_top_inner := Max(edge_top_inner, edge_raw_inner);
                    end;

                    for edge_idx_inner := 0 to Min(
                        get_chain_probe_limit_local - 1,
                        High(lookup_results_inner)) do
                    begin
                        if Trim(lookup_results_inner[edge_idx_inner].comment) <> '' then
                        begin
                            Continue;
                        end;
                        edge_text_inner := Trim(
                            lookup_results_inner[edge_idx_inner].text);
                        if SameText(edge_text_inner, protected_text_inner) or
                            (get_candidate_text_unit_count(edge_text_inner) <> 1) or
                            (not is_valid_standalone_cjk_phrase_text_local(
                            edge_text_inner, 1)) then
                        begin
                            Continue;
                        end;
                        edge_raw_inner := get_exact_chunk_raw_weight_local(
                            lookup_results_inner[edge_idx_inner]);
                        edge_score_inner := get_exact_chunk_effective_weight_local(
                            lookup_results_inner[edge_idx_inner]);
                        Inc(edge_score_inner,
                            get_preferred_query_phrase_bonus_local(
                            query_key_inner, edge_text_inner));
                        Dec(edge_score_inner,
                            get_context_free_single_char_penalty_local(
                            query_key_inner, edge_text_inner));
                        if start_idx_local + chunk_len_inner =
                            syllable_count_local then
                        begin
                            Dec(edge_score_inner, 24000);
                        end;

                        edge_option_inner := Default(TExactChunkChainOption);
                        edge_option_inner.text := edge_text_inner;
                        edge_option_inner.path := edge_text_inner;
                        edge_option_inner.query_key := query_key_inner;
                        edge_option_inner.score := edge_score_inner;
                        edge_option_inner.exact_rank := edge_idx_inner + 1;
                        edge_option_inner.raw_weight := edge_raw_inner;
                        edge_option_inner.top_weight := edge_top_inner;
                        edge_option_inner.source_user :=
                            lookup_results_inner[edge_idx_inner].source = cs_user;
                        edge_option_inner.direct_exact := True;
                        edge_option_inner.edge_expanded_only := True;
                        edge_option_inner.segments := 1;
                        edge_option_inner.has_anchor := False;
                        edge_option_inner.anchor_units := 0;
                        add_fast_option_local(out_options_local,
                            legacy_options_inner, edge_option_inner);
                    end;
                end;

            begin
                Result := False;
                SetLength(out_options_local, 0);
                SetLength(legacy_options_inner, 0);
                best_direct_raw_weight_inner := Low(Integer);
                query_key_inner := build_query_key_local(start_idx_local,
                    chunk_len_inner);
                if query_key_inner = '' then
                begin
                    Exit;
                end;

                if chunk_len_inner = 1 then
                begin
                    if (start_idx_local + chunk_len_inner =
                        syllable_count_local) and
                        try_get_sentence_final_modal_particle_text_fast_local(
                        effective_syllables[start_idx_local].text,
                        text_inner) then
                    begin
                        { See the short-tail path above: final particles need a
                          sentence-final single, not the generic boundary one. }
                    end
                    else if not try_get_modifier_prefix_single_text_local(
                        effective_syllables[start_idx_local].text, text_inner) then
                    begin
                        text_inner :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[start_idx_local].text);
                    end;
                    normalized_single_key_inner := normalize_pinyin_text(
                        query_key_inner);
                    if text_inner = '' then
                    begin
                        if not try_get_best_single_char_for_query_key_local(
                            query_key_inner, text_inner, score_inner) then
                        begin
                            Exit;
                        end;
                        if score_inner > 120 then
                        begin
                            score_inner := 120;
                        end;
                        Dec(score_inner, 900);

                        option_inner := Default(TExactChunkChainOption);
                        option_inner.text := text_inner;
                        option_inner.path := text_inner;
                        option_inner.query_key := query_key_inner;
                        option_inner.score := score_inner;
                        option_inner.segments := 1;
                        option_inner.has_anchor := False;
                        option_inner.anchor_units := 0;
                        add_fast_option_local(out_options_local,
                            legacy_options_inner, option_inner);
                        if normalized_single_key_inner = 'wei' then
                        begin
                            if not SameText(text_inner, string(Char($672A))) then
                            begin
                                add_fixed_single_option_inner(string(Char($672A)),
                                    1800);
                            end;
                            if not SameText(text_inner, string(Char($4E3A))) then
                            begin
                                add_fixed_single_option_inner(string(Char($4E3A)),
                                    2400);
                            end;
                        end
                        else if (normalized_single_key_inner = 'yu') and
                            (not SameText(text_inner, string(Char($4E0E)))) then
                        begin
                            add_fixed_single_option_inner(string(Char($4E0E)),
                                2200);
                        end;
                        if use_exact_edge_ranker_expansion_local then
                        begin
                            add_single_exact_edge_candidates_inner(text_inner);
                        end;
                        Exit(finish_options_inner);
                    end;

                    add_fixed_single_option_inner(text_inner, 0);
                    if normalized_single_key_inner = 'wei' then
                    begin
                        if not SameText(text_inner, string(Char($672A))) then
                        begin
                            add_fixed_single_option_inner(string(Char($672A)),
                                1800);
                        end;
                        if not SameText(text_inner, string(Char($4E3A))) then
                        begin
                            add_fixed_single_option_inner(string(Char($4E3A)),
                                2400);
                        end;
                    end
                    else if (normalized_single_key_inner = 'yu') and
                        (not SameText(text_inner, string(Char($4E0E)))) then
                    begin
                        add_fixed_single_option_inner(string(Char($4E0E)), 2200);
                    end;
                    if use_exact_edge_ranker_expansion_local then
                    begin
                        add_single_exact_edge_candidates_inner(text_inner);
                    end;
                    Exit(finish_options_inner);
                end;

                if (input_syllable_count <= 6) and (m_dictionary <> nil) and
                    (not m_dictionary.lookup(query_key_inner,
                    ranked_lookup_results_inner)) then
                begin
                    ranked_lookup_results_inner := nil;
                end;

                if chunk_len_inner = 3 then
                begin
                    prefix_text_inner := '';
                    prefix_is_modifier_inner := try_get_modifier_prefix_single_text_local(
                        effective_syllables[start_idx_local].text,
                        prefix_text_inner);
                    if not prefix_is_modifier_inner then
                    begin
                        prefix_text_inner :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[start_idx_local].text);
                        if (prefix_text_inner = '') or
                            (not is_function_or_modifier_single_quality_inner(
                            prefix_text_inner)) then
                        begin
                            prefix_text_inner := '';
                        end;
                    end;

                    if prefix_text_inner <> '' then
                    begin
                        head_has_strong_exact_inner := False;
                        head_key_inner := build_query_key_local(start_idx_local, 2);
                        if (head_key_inner <> '') and
                            lookup_exact_full_pinyin_cached_local(head_key_inner,
                            head_lookup_results_inner) then
                        begin
                            for head_idx_inner := 0 to High(head_lookup_results_inner) do
                            begin
                                if head_idx_inner >= get_chain_probe_limit_local then
                                begin
                                    Break;
                                end;
                                if Trim(head_lookup_results_inner[head_idx_inner].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                head_text_inner := Trim(
                                    head_lookup_results_inner[head_idx_inner].text);
                                if (get_candidate_text_unit_count(head_text_inner) = 2) and
                                    is_valid_standalone_cjk_phrase_text_local(
                                    head_text_inner, 2) and
                                    (((head_lookup_results_inner[head_idx_inner].has_dict_weight) and
                                    (head_lookup_results_inner[head_idx_inner].dict_weight >= 700)) or
                                    (head_lookup_results_inner[head_idx_inner].score >= 700)) then
                                begin
                                    head_has_strong_exact_inner := True;
                                    Break;
                                end;
                            end;
                        end;

                        tail_key_inner := build_query_key_local(start_idx_local + 1, 2);
                        if ((not head_has_strong_exact_inner) or
                            (not SameText(prefix_text_inner, string(Char($9AD8))))) and
                            (tail_key_inner <> '') and
                            lookup_exact_full_pinyin_cached_local(tail_key_inner,
                            tail_lookup_results_inner) then
                        begin
                            for tail_idx_inner := 0 to High(tail_lookup_results_inner) do
                            begin
                                if tail_idx_inner >= get_chain_probe_limit_local then
                                begin
                                    Break;
                                end;
                                if Trim(tail_lookup_results_inner[tail_idx_inner].comment) <> '' then
                                begin
                                    Continue;
                                end;

                                tail_text_inner := Trim(
                                    tail_lookup_results_inner[tail_idx_inner].text);
                                if (get_candidate_text_unit_count(tail_text_inner) <> 2) or
                                    (not is_valid_standalone_cjk_phrase_text_local(
                                    tail_text_inner, 2)) or
                                    (not is_reliable_fast_exact_chunk_local(
                                    tail_key_inner, 2, tail_text_inner,
                                    tail_lookup_results_inner[tail_idx_inner])) then
                                begin
                                    Continue;
                                end;

                                text_inner := prefix_text_inner + tail_text_inner;
                                score_inner := get_exact_chunk_effective_weight_local(
                                    tail_lookup_results_inner[tail_idx_inner]);
                                Inc(score_inner, get_preferred_exact_subspan_bonus_local(
                                    query_key_inner, text_inner));
                                Inc(score_inner, get_preferred_query_phrase_bonus_local(
                                    tail_key_inner, tail_text_inner));
                                Inc(score_inner, get_exact_query_text_bonus_local(
                                    tail_key_inner, tail_text_inner));
                                Inc(score_inner, get_exact_chunk_semantic_bonus_local(
                                    tail_text_inner));
                                Inc(score_inner, get_modifier_prefix_phrase_bonus_local(
                                    chunk_len_inner, text_inner));
                                Inc(score_inner, chunk_len_inner * chunk_len_inner *
                                    c_fast_length_bonus);
                                Inc(score_inner, c_fast_fixed_single_bonus);
                                Inc(score_inner, (get_chain_probe_limit_local - tail_idx_inner) * 128);
                                Inc(score_inner, c_chain_anchor_bonus);

                                option_inner := Default(TExactChunkChainOption);
                                option_inner.text := text_inner;
                                option_inner.path := prefix_text_inner +
                                    c_segment_path_separator + tail_text_inner;
                                option_inner.query_key := query_key_inner;
                                option_inner.score := score_inner;
                                option_inner.segments := 2;
                                option_inner.has_anchor := True;
                                option_inner.anchor_units := 2;
                                add_fast_option_local(out_options_local,
                                    legacy_options_inner, option_inner);
                            end;
                        end;
                    end;
                end;

                if (chunk_len_inner >= 4) and (chunk_len_inner <= 5) then
                begin
                    prefix_text_inner := '';
                    prefix_score_inner := 0;
                    prefix_is_modifier_inner := try_get_modifier_prefix_single_text_local(
                        effective_syllables[start_idx_local].text,
                        prefix_text_inner);
                    if not prefix_is_modifier_inner then
                    begin
                        prefix_text_inner :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[start_idx_local].text);
                        if prefix_text_inner <> '' then
                        begin
                            prefix_score_inner := 1200;
                        end
                        else
                        begin
                            prefix_text_inner := '';
                        end;
                    end
                    else
                    begin
                        prefix_score_inner := 1200;
                    end;

                    if (prefix_text_inner <> '') and
                        ((chunk_len_inner > 3) or (not prefix_is_modifier_inner)) then
                    begin
                        tail_units_inner := chunk_len_inner - 1;
                        tail_key_inner := build_query_key_local(start_idx_local + 1,
                            tail_units_inner);
                        if (tail_key_inner <> '') and
                            lookup_exact_full_pinyin_cached_local(tail_key_inner,
                            tail_lookup_results_inner) then
                        begin
                            for tail_idx_inner := 0 to High(tail_lookup_results_inner) do
                            begin
                                if tail_idx_inner >= get_chain_probe_limit_local then
                                begin
                                    Break;
                                end;
                                if Trim(tail_lookup_results_inner[tail_idx_inner].comment) <> '' then
                                begin
                                    Continue;
                                end;

                                tail_text_inner := Trim(
                                    tail_lookup_results_inner[tail_idx_inner].text);
                                if (get_candidate_text_unit_count(tail_text_inner) <>
                                    tail_units_inner) or
                                    (not is_valid_standalone_cjk_phrase_text_local(
                                    tail_text_inner, tail_units_inner)) or
                                    (not is_reliable_fast_exact_chunk_local(
                                    tail_key_inner, tail_units_inner,
                                    tail_text_inner,
                                    tail_lookup_results_inner[tail_idx_inner])) then
                                begin
                                    Continue;
                                end;

                                tail_raw_weight_inner := get_exact_chunk_raw_weight_local(
                                    tail_lookup_results_inner[tail_idx_inner]);
                                if tail_raw_weight_inner < 760 then
                                begin
                                    Continue;
                                end;

                                text_inner := prefix_text_inner + tail_text_inner;
                                score_inner := get_exact_chunk_effective_weight_local(
                                    tail_lookup_results_inner[tail_idx_inner]);
                                Inc(score_inner, Min(1600, Max(0,
                                    prefix_score_inner)));
                                Inc(score_inner, get_preferred_exact_subspan_bonus_local(
                                    query_key_inner, text_inner));
                                Inc(score_inner, get_preferred_query_phrase_bonus_local(
                                    tail_key_inner, tail_text_inner));
                                Inc(score_inner, get_exact_query_text_bonus_local(
                                    tail_key_inner, tail_text_inner));
                                Inc(score_inner, get_exact_chunk_semantic_bonus_local(
                                    tail_text_inner));
                                Inc(score_inner, get_modifier_prefix_phrase_bonus_local(
                                    chunk_len_inner, text_inner));
                                Inc(score_inner, chunk_len_inner * chunk_len_inner *
                                    c_fast_length_bonus);
                                Inc(score_inner, c_fast_fixed_single_bonus);
                                Inc(score_inner, (get_chain_probe_limit_local - tail_idx_inner) * 128);
                                Inc(score_inner, c_chain_anchor_bonus);

                                option_inner := Default(TExactChunkChainOption);
                                option_inner.text := text_inner;
                                option_inner.path := prefix_text_inner +
                                    c_segment_path_separator + tail_text_inner;
                                option_inner.query_key := query_key_inner;
                                option_inner.score := score_inner;
                                option_inner.segments := 2;
                                option_inner.has_anchor := True;
                                option_inner.anchor_units := chunk_len_inner;
                                add_fast_option_local(out_options_local,
                                    legacy_options_inner, option_inner);
                            end;
                        end;
                    end;
                end;

                // Keep proven exact-word pairs available to the long lattice.
                // For ultra-long input this is deliberately restricted to 2+2
                // pairs with strong offline LM evidence, so arbitrary exact
                // words do not become a general-purpose composition path.
                if (chunk_len_inner >= 4) and (chunk_len_inner <= 5) and
                    ((syllable_count_local <= 12) or
                    (chunk_len_inner = 4)) and (m_dictionary <> nil) then
                begin
                    for split_len_inner := 2 to chunk_len_inner - 2 do
                    begin
                        if (syllable_count_local > 12) and
                            (split_len_inner <> 2) then
                        begin
                            Continue;
                        end;
                        left_key_inner := build_query_key_local(start_idx_local,
                            split_len_inner);
                        right_key_inner := build_query_key_local(start_idx_local +
                            split_len_inner, chunk_len_inner - split_len_inner);
                        if (left_key_inner = '') or (right_key_inner = '') or
                            (not lookup_exact_full_pinyin_cached_local(left_key_inner,
                            left_lookup_results_inner)) or
                            (not lookup_exact_full_pinyin_cached_local(right_key_inner,
                            right_lookup_results_inner)) then
                        begin
                            Continue;
                        end;

                        for left_idx_inner := 0 to High(left_lookup_results_inner) do
                        begin
                            if left_idx_inner >= c_fast_split_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(left_lookup_results_inner[left_idx_inner].comment) <> '' then
                            begin
                                Continue;
                            end;

                            left_text_inner := Trim(
                                left_lookup_results_inner[left_idx_inner].text);
                            if (get_candidate_text_unit_count(left_text_inner) <>
                                split_len_inner) or
                                (not is_valid_standalone_cjk_phrase_text_local(
                                left_text_inner, split_len_inner)) or
                                (not is_reliable_fast_exact_chunk_local(
                                left_key_inner, split_len_inner, left_text_inner,
                                left_lookup_results_inner[left_idx_inner])) then
                            begin
                                Continue;
                            end;

                            for right_idx_inner := 0 to High(right_lookup_results_inner) do
                            begin
                                if right_idx_inner >= c_fast_split_probe_limit then
                                begin
                                    Break;
                                end;
                                if Trim(right_lookup_results_inner[right_idx_inner].comment) <> '' then
                                begin
                                    Continue;
                                end;

                                right_text_inner := Trim(
                                    right_lookup_results_inner[right_idx_inner].text);
                                if (get_candidate_text_unit_count(right_text_inner) <>
                                    chunk_len_inner - split_len_inner) or
                                    (not is_valid_standalone_cjk_phrase_text_local(
                                    right_text_inner,
                                    chunk_len_inner - split_len_inner)) or
                                    (not is_reliable_fast_exact_chunk_local(
                                    right_key_inner,
                                    chunk_len_inner - split_len_inner,
                                    right_text_inner,
                                    right_lookup_results_inner[right_idx_inner])) then
                                begin
                                    Continue;
                                end;

                                split_path_inner := left_text_inner +
                                    c_segment_path_separator + right_text_inner;
                                split_path_bonus_inner := Max(0,
                                    get_cached_query_segment_path_bonus(
                                    query_key_inner, split_path_inner));
                                split_path_penalty_inner := Max(0,
                                    get_cached_query_segment_path_penalty(
                                    query_key_inner, split_path_inner));
                                split_lm_bonus_inner := Max(0,
                                    m_dictionary.get_lm_transition_bonus(
                                    query_key_inner, split_path_inner));
                                if (split_path_bonus_inner <=
                                    split_path_penalty_inner) and
                                    (split_lm_bonus_inner <
                                    c_chain_lattice_lm_min_bonus) then
                                begin
                                    Continue;
                                end;

                                split_score_inner :=
                                    get_exact_chunk_effective_weight_local(
                                    left_lookup_results_inner[left_idx_inner]) +
                                    get_exact_chunk_effective_weight_local(
                                    right_lookup_results_inner[right_idx_inner]);
                                Inc(split_score_inner,
                                    Min(2600, split_path_bonus_inner * 4));
                                Inc(split_score_inner,
                                    Min(2400, split_lm_bonus_inner * 4));
                                Dec(split_score_inner,
                                    Min(1800, split_path_penalty_inner * 4));
                                Inc(split_score_inner,
                                    get_preferred_query_phrase_bonus_local(
                                    query_key_inner,
                                    left_text_inner + right_text_inner));
                                Inc(split_score_inner,
                                    get_exact_query_text_bonus_local(
                                    query_key_inner,
                                    left_text_inner + right_text_inner));
                                Inc(split_score_inner, get_exact_chunk_semantic_bonus_local(
                                    left_text_inner + right_text_inner));
                                Inc(split_score_inner, chunk_len_inner *
                                    chunk_len_inner * c_fast_length_bonus);
                                Inc(split_score_inner, c_chain_anchor_bonus);
                                Inc(split_score_inner,
                                    (get_chain_probe_limit_local - left_idx_inner) * 96);
                                Inc(split_score_inner,
                                    (get_chain_probe_limit_local - right_idx_inner) * 96);

                                option_inner := Default(TExactChunkChainOption);
                                option_inner.text := left_text_inner + right_text_inner;
                                option_inner.path := split_path_inner;
                                option_inner.query_key := query_key_inner;
                                option_inner.score := split_score_inner;
                                option_inner.segments := 2;
                                option_inner.has_anchor := True;
                                option_inner.anchor_units := chunk_len_inner;
                                add_fast_option_local(out_options_local,
                                    legacy_options_inner, option_inner);
                            end;
                        end;
                    end;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_inner,
                    lookup_results_inner) then
                begin
                    Exit(finish_options_inner);
                end;

                for lookup_idx_inner := 0 to High(lookup_results_inner) do
                begin
                    if lookup_idx_inner >= get_chain_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results_inner[lookup_idx_inner].comment) <> '' then
                    begin
                        Continue;
                    end;

                    text_inner := Trim(lookup_results_inner[lookup_idx_inner].text);
                    if (get_candidate_text_unit_count(text_inner) <> chunk_len_inner) or
                        (not is_valid_standalone_cjk_phrase_text_local(text_inner,
                        chunk_len_inner)) or
                        (not is_reliable_fast_exact_chunk_local(query_key_inner,
                        chunk_len_inner, text_inner,
                        lookup_results_inner[lookup_idx_inner])) then
                    begin
                        Continue;
                    end;
                    raw_weight_inner := get_exact_chunk_raw_weight_local(
                        lookup_results_inner[lookup_idx_inner]);
                    if should_defer_pair_to_modifier_tail_exact_inner(text_inner,
                        raw_weight_inner) then
                    begin
                        Continue;
                    end;
                    if should_defer_chunk_to_head_plus_function_tail_inner(
                        text_inner, raw_weight_inner) then
                    begin
                        Continue;
                    end;

                    score_inner := get_exact_chunk_effective_weight_local(
                        lookup_results_inner[lookup_idx_inner]);
                    ranked_score_inner :=
                        get_ranked_lookup_score_for_text_inner(text_inner);
                    if ranked_score_inner > score_inner then
                    begin
                        score_inner := ranked_score_inner;
                    end;
                    Inc(score_inner, get_preferred_exact_subspan_bonus_local(
                        query_key_inner, text_inner));
                    Inc(score_inner, get_preferred_query_phrase_bonus_local(
                        query_key_inner, text_inner));
                    Inc(score_inner, get_exact_query_text_bonus_local(query_key_inner,
                        text_inner));
                    Inc(score_inner, get_long_exact_phrase_cohesion_bonus_local(
                        chunk_len_inner));
                    Inc(score_inner, get_modifier_prefix_phrase_bonus_local(
                        chunk_len_inner, text_inner));
                    Inc(score_inner, get_exact_chunk_boundary_adjustment_local(
                        start_idx_local, chunk_len_inner, text_inner));
                    Inc(score_inner, get_exact_chunk_semantic_bonus_local(text_inner));
                    Inc(score_inner, get_directional_locative_fast_bonus_inner(
                        text_inner));
                    Inc(score_inner, get_final_compound_tail_support_bonus_inner(
                        text_inner, raw_weight_inner));
                    Dec(score_inner,
                        get_function_single_pair_exact_penalty_inner(text_inner));
                    if (lookup_idx_inner = 0) and (chunk_len_inner >= 3) then
                    begin
                        Inc(score_inner, 7200);
                    end;
                    Inc(score_inner, chunk_len_inner * chunk_len_inner *
                        c_fast_length_bonus);
                    Inc(score_inner, (get_chain_probe_limit_local - lookup_idx_inner) * 192);
                    if chunk_len_inner >= c_chain_min_anchor_syllables then
                    begin
                        Inc(score_inner, c_chain_anchor_bonus);
                    end;

                    option_inner := Default(TExactChunkChainOption);
                    option_inner.text := text_inner;
                    option_inner.path := text_inner;
                    option_inner.query_key := query_key_inner;
                    option_inner.score := score_inner;
                    if use_exact_edge_ranker_expansion_local then
                    begin
                        option_inner.exact_rank := lookup_idx_inner + 1;
                        option_inner.raw_weight := raw_weight_inner;
                        option_inner.top_weight :=
                            get_best_direct_raw_weight_inner;
                        option_inner.source_user :=
                            lookup_results_inner[lookup_idx_inner].source = cs_user;
                        option_inner.direct_exact := True;
                    end;
                    option_inner.segments := 1;
                    option_inner.has_anchor :=
                        chunk_len_inner >= c_chain_min_anchor_syllables;
                    option_inner.anchor_units := chunk_len_inner;
                    add_fast_option_local(out_options_local,
                        legacy_options_inner, option_inner);
                end;
                Result := finish_options_inner;
            end;

            procedure consider_generated_fast_state_local(
                const generated_state_inner: TExactChunkChainState);
            begin
                debug_note_long_exact_edge_stage(pos_local,
                    syllable_count_local,
                    generated_state_inner.first_chunk_query_key,
                    generated_state_inner.first_chunk_text,
                    get_candidate_text_unit_count(
                    generated_state_inner.first_chunk_text),
                    generated_state_inner.first_chunk_exact_rank,
                    generated_state_inner.first_chunk_raw_weight,
                    generated_state_inner.first_chunk_top_weight,
                    generated_state_inner.first_chunk_effective_score,
                    generated_state_inner.first_chunk_edge_score,
                    generated_state_inner.first_chunk_source_user,
                    generated_state_inner.first_chunk_baseline_option, 1);
                if (not m_debug_expand_long_beam_states) and
                    (exact_edge_reserved_slots_local > 0) and
                    ((not generated_state_inner.first_chunk_baseline_option) or
                    (generated_state_inner.retained_exact_edge_count > 0)) then
                begin
                    consider_exact_chunk_chain_state_local(
                        edge_probe_candidates_local,
                        generated_state_inner, pos_local,
                        get_chain_prebeam_width_local);
                    Exit;
                end;
                consider_exact_chunk_chain_state_local(
                    state_map_local[pos_local], generated_state_inner,
                    pos_local, get_chain_prebeam_width_local);
                if generated_state_inner.baseline_lineage then
                begin
                    consider_exact_chunk_chain_state_local(
                        baseline_candidates_local, generated_state_inner,
                        pos_local, get_chain_baseline_prebeam_width_local);
                end;
            end;

            procedure collect_runtime_exact_edge_probe_states_local(
                const start_pos_inner: Integer;
                const chunk_len_inner: Integer;
                const next_pos_inner: Integer;
                const probe_options_inner: TExactChunkChainOptionArray);
            var
                probe_idx_inner: Integer;
                probe_state_inner: TExactChunkChainState;
                probe_suffix_inner: TExactChunkChainState;
                context_adjust_inner: Integer;

                procedure retain_model_probe_inner(
                    const value_inner: TExactChunkChainState);
                var
                    existing_idx_inner: Integer;
                    insert_idx_inner: Integer;
                    swap_inner: TExactChunkChainState;
                begin
                    for existing_idx_inner := 0 to
                        High(exact_edge_model_candidates_local) do
                    begin
                        if SameText(exact_edge_model_candidates_local[
                            existing_idx_inner].first_chunk_query_key,
                            value_inner.first_chunk_query_key) and
                            SameText(Trim(exact_edge_model_candidates_local[
                            existing_idx_inner].first_chunk_text),
                            Trim(value_inner.first_chunk_text)) and
                            SameText(exact_edge_model_candidates_local[
                            existing_idx_inner].path, value_inner.path) then
                        begin
                            if value_inner.score >
                                exact_edge_model_candidates_local[
                                existing_idx_inner].score then
                            begin
                                exact_edge_model_candidates_local[
                                    existing_idx_inner] := value_inner;
                            end;
                            Exit;
                        end;
                    end;
                    SetLength(exact_edge_model_candidates_local,
                        Length(exact_edge_model_candidates_local) + 1);
                    exact_edge_model_candidates_local[
                        High(exact_edge_model_candidates_local)] :=
                        value_inner;
                    insert_idx_inner :=
                        High(exact_edge_model_candidates_local);
                    while insert_idx_inner > 0 do
                    begin
                        if exact_edge_model_candidates_local[
                            insert_idx_inner - 1].first_chunk_exact_edge_model_score >
                            exact_edge_model_candidates_local[
                            insert_idx_inner].first_chunk_exact_edge_model_score then
                        begin
                            Break;
                        end;
                        if (exact_edge_model_candidates_local[
                            insert_idx_inner - 1].first_chunk_exact_edge_model_score =
                            exact_edge_model_candidates_local[
                            insert_idx_inner].first_chunk_exact_edge_model_score) and
                            (exact_edge_model_candidates_local[
                            insert_idx_inner - 1].score >=
                            exact_edge_model_candidates_local[
                            insert_idx_inner].score) then
                        begin
                            Break;
                        end;
                        swap_inner := exact_edge_model_candidates_local[
                            insert_idx_inner - 1];
                        exact_edge_model_candidates_local[
                            insert_idx_inner - 1] :=
                            exact_edge_model_candidates_local[
                            insert_idx_inner];
                        exact_edge_model_candidates_local[
                            insert_idx_inner] := swap_inner;
                        Dec(insert_idx_inner);
                    end;
                    if Length(exact_edge_model_candidates_local) >
                        c_chain_lattice_exact_edge_probe_limit then
                    begin
                        SetLength(exact_edge_model_candidates_local,
                            c_chain_lattice_exact_edge_probe_limit);
                    end;
                end;
            begin
                if m_debug_expand_long_beam_states or
                    nc_long_ablated(la_exact_edge_lattice) or
                    (exact_edge_reserved_slots_local <= 0) or
                    (chunk_len_inner <
                    c_chain_lattice_exact_edge_min_units) or
                    (Length(state_map_local[next_pos_inner]) <= 0) then
                begin
                    Exit;
                end;
                probe_suffix_inner := state_map_local[next_pos_inner][0];
                for probe_idx_inner := 0 to High(probe_options_inner) do
                begin
                    if (not probe_options_inner[
                        probe_idx_inner].direct_exact) or
                        probe_options_inner[probe_idx_inner].source_user or
                        (probe_options_inner[
                        probe_idx_inner].exact_edge_model_score <
                        c_chain_lattice_exact_edge_min_model_score) then
                    begin
                        Continue;
                    end;
                    probe_state_inner := Default(TExactChunkChainState);
                    probe_state_inner.text := probe_options_inner[
                        probe_idx_inner].text + probe_suffix_inner.text;
                    probe_state_inner.path := probe_options_inner[
                        probe_idx_inner].path;
                    if probe_suffix_inner.path <> '' then
                    begin
                        probe_state_inner.path := probe_state_inner.path +
                            c_segment_path_separator +
                            probe_suffix_inner.path;
                    end;
                    probe_state_inner.first_chunk_text :=
                        probe_options_inner[probe_idx_inner].text;
                    probe_state_inner.first_chunk_query_key :=
                        probe_options_inner[probe_idx_inner].query_key;
                    probe_state_inner.first_chunk_exact_rank :=
                        probe_options_inner[probe_idx_inner].exact_rank;
                    probe_state_inner.first_chunk_raw_weight :=
                        probe_options_inner[probe_idx_inner].raw_weight;
                    probe_state_inner.first_chunk_top_weight :=
                        probe_options_inner[probe_idx_inner].top_weight;
                    probe_state_inner.first_chunk_effective_score :=
                        probe_options_inner[probe_idx_inner].score;
                    probe_state_inner.first_chunk_edge_score :=
                        probe_options_inner[
                        probe_idx_inner].edge_retention_score;
                    probe_state_inner.first_chunk_exact_edge_model_score :=
                        probe_options_inner[
                        probe_idx_inner].exact_edge_model_score;
                    probe_state_inner.first_chunk_source_user := False;
                    probe_state_inner.first_chunk_baseline_option :=
                        probe_options_inner[
                        probe_idx_inner].baseline_option;
                    probe_state_inner.score := probe_options_inner[
                        probe_idx_inner].score + probe_suffix_inner.score;
                    Dec(probe_state_inner.score,
                        get_competing_boundary_penalty_fast_local(
                        probe_state_inner.text, start_pos_inner,
                        chunk_len_inner,
                        probe_options_inner[probe_idx_inner],
                        probe_suffix_inner));
                    if probe_suffix_inner.first_chunk_text <> '' then
                    begin
                        Inc(probe_state_inner.score,
                            m_dictionary.get_context_bonus(
                            probe_options_inner[probe_idx_inner].text,
                            probe_suffix_inner.first_chunk_text));
                        Inc(probe_state_inner.score,
                            get_adjacent_exact_chunk_context_bonus_local(
                            probe_options_inner[probe_idx_inner].text,
                            probe_suffix_inner.first_chunk_text));
                        context_adjust_inner :=
                            get_function_particle_suffix_context_adjustment_local(
                            effective_syllables[start_pos_inner +
                            chunk_len_inner - 1].text,
                            probe_options_inner[probe_idx_inner].text,
                            probe_suffix_inner.first_chunk_text);
                        Inc(probe_state_inner.score,
                            context_adjust_inner);
                    end;
                    probe_state_inner.segments :=
                        probe_options_inner[probe_idx_inner].segments +
                        probe_suffix_inner.segments;
                    probe_state_inner.has_anchor :=
                        probe_options_inner[probe_idx_inner].has_anchor or
                        probe_suffix_inner.has_anchor;
                    probe_state_inner.anchor_units := Max(
                        probe_options_inner[probe_idx_inner].anchor_units,
                        probe_suffix_inner.anchor_units);
                    probe_state_inner.retained_exact_edge_count :=
                        probe_suffix_inner.retained_exact_edge_count;
                    probe_state_inner.retained_exact_edge_position :=
                        probe_suffix_inner.retained_exact_edge_position;
                    probe_state_inner.retained_exact_edge_units :=
                        probe_suffix_inner.retained_exact_edge_units;
                    probe_state_inner.retained_exact_edge_rank :=
                        probe_suffix_inner.retained_exact_edge_rank;
                    probe_state_inner.retained_exact_edge_top_weight :=
                        probe_suffix_inner.retained_exact_edge_top_weight;
                    probe_state_inner.retained_exact_edge_confidence :=
                        probe_suffix_inner.retained_exact_edge_confidence;
                    probe_state_inner.baseline_lineage := False;
                    debug_note_long_exact_edge_stage(start_pos_inner,
                        syllable_count_local,
                        probe_state_inner.first_chunk_query_key,
                        probe_state_inner.first_chunk_text,
                        chunk_len_inner,
                        probe_state_inner.first_chunk_exact_rank,
                        probe_state_inner.first_chunk_raw_weight,
                        probe_state_inner.first_chunk_top_weight,
                        probe_state_inner.first_chunk_effective_score,
                        probe_state_inner.first_chunk_edge_score,
                        False, False, 1);
                    retain_model_probe_inner(probe_state_inner);
                end;
            end;

            function try_get_retained_edge_for_position_local(
                const position_inner: Integer;
                out edge_inner: TncLongRetainedExactEdge): Boolean;
            var
                edge_idx_inner: Integer;
            begin
                Result := False;
                edge_inner := Default(TncLongRetainedExactEdge);
                for edge_idx_inner := 0 to
                    High(m_runtime_long_retained_exact_edges) do
                begin
                    if m_runtime_long_retained_exact_edges[
                        edge_idx_inner].position = position_inner then
                    begin
                        edge_inner := m_runtime_long_retained_exact_edges[
                            edge_idx_inner];
                        Exit(True);
                    end;
                end;
            end;

            procedure mark_state_with_retained_edge_local(
                var state_inner: TExactChunkChainState;
                const edge_inner: TncLongRetainedExactEdge);
            begin
                if (state_inner.retained_exact_edge_count <= 0) or
                    (edge_inner.confidence >
                    state_inner.retained_exact_edge_confidence) then
                begin
                    state_inner.retained_exact_edge_position :=
                        edge_inner.position;
                    state_inner.retained_exact_edge_units :=
                        edge_inner.chunk_units;
                    state_inner.retained_exact_edge_rank :=
                        edge_inner.exact_rank;
                    state_inner.retained_exact_edge_top_weight :=
                        edge_inner.top_weight;
                    state_inner.retained_exact_edge_confidence :=
                        edge_inner.confidence;
                end;
                Inc(state_inner.retained_exact_edge_count);
                state_inner.baseline_lineage := False;
            end;

            function retained_slot_state_is_better_local(
                const candidate_inner: TExactChunkChainState;
                const current_inner: TExactChunkChainState;
                const state_start_pos_inner: Integer): Boolean;
            var
                candidate_lm_inner: Integer;
                current_lm_inner: Integer;
                candidate_stats_inner: TLongWordLmBoundaryStats;
                current_stats_inner: TLongWordLmBoundaryStats;
                candidate_confidence_inner: Int64;
                current_confidence_inner: Int64;
                candidate_score_inner: Int64;
                current_score_inner: Int64;

                function bounded_confidence_inner(
                    const value_inner: Int64): Int64;
                begin
                    Result := value_inner div 8;
                    if Result < -48000 then
                    begin
                        Result := -48000;
                    end
                    else if Result > 96000 then
                    begin
                        Result := 96000;
                    end;
                end;
            begin
                candidate_lm_inner := get_exact_chunk_chain_state_lm_bonus_local(
                    candidate_inner, state_start_pos_inner,
                    candidate_stats_inner);
                current_lm_inner := get_exact_chunk_chain_state_lm_bonus_local(
                    current_inner, state_start_pos_inner, current_stats_inner);
                candidate_confidence_inner := bounded_confidence_inner(
                    candidate_inner.retained_exact_edge_confidence);
                current_confidence_inner := bounded_confidence_inner(
                    current_inner.retained_exact_edge_confidence);
                candidate_score_inner := Int64(candidate_inner.score) +
                    candidate_lm_inner + candidate_confidence_inner;
                current_score_inner := Int64(current_inner.score) +
                    current_lm_inner + current_confidence_inner;
                Result := candidate_score_inner > current_score_inner;
                if candidate_score_inner = current_score_inner then
                begin
                    Result := candidate_inner.retained_exact_edge_count >
                        current_inner.retained_exact_edge_count;
                end;
                if (candidate_score_inner = current_score_inner) and
                    (candidate_inner.retained_exact_edge_count =
                    current_inner.retained_exact_edge_count) then
                begin
                    Result := is_exact_chunk_chain_state_better_local(
                        candidate_inner, current_inner);
                end;
            end;

            procedure choose_retained_exact_edge_slots_local(
                const position_inner: Integer;
                const propagated_states_inner:
                    TExactChunkChainStateArray;
                const model_states_inner: TExactChunkChainStateArray;
                out states_inner: TExactChunkChainStateArray);
            var
                retained_edge_inner: TncLongRetainedExactEdge;
                source_idx_inner: Integer;
                candidate_inner: TExactChunkChainState;

                procedure consider_side_state_inner(
                    const value_inner: TExactChunkChainState);
                var
                    side_idx_inner: Integer;
                    insert_idx_inner: Integer;
                    swap_inner: TExactChunkChainState;
                begin
                    for side_idx_inner := 0 to High(states_inner) do
                    begin
                        if SameText(Trim(states_inner[side_idx_inner].text),
                            Trim(value_inner.text)) and
                            SameText(states_inner[side_idx_inner].path,
                            value_inner.path) then
                        begin
                            if retained_slot_state_is_better_local(
                                value_inner, states_inner[side_idx_inner],
                                position_inner) then
                            begin
                                states_inner[side_idx_inner] := value_inner;
                            end;
                            Exit;
                        end;
                    end;
                    SetLength(states_inner, Length(states_inner) + 1);
                    states_inner[High(states_inner)] := value_inner;
                    insert_idx_inner := High(states_inner);
                    while (insert_idx_inner > 0) and
                        retained_slot_state_is_better_local(
                        states_inner[insert_idx_inner],
                        states_inner[insert_idx_inner - 1],
                        position_inner) do
                    begin
                        swap_inner := states_inner[insert_idx_inner - 1];
                        states_inner[insert_idx_inner - 1] :=
                            states_inner[insert_idx_inner];
                        states_inner[insert_idx_inner] := swap_inner;
                        Dec(insert_idx_inner);
                    end;
                    if Length(states_inner) >
                        exact_edge_reserved_slots_local then
                    begin
                        SetLength(states_inner,
                            exact_edge_reserved_slots_local);
                    end;
                end;
            begin
                SetLength(states_inner, 0);
                for source_idx_inner := 0 to
                    High(propagated_states_inner) do
                begin
                    candidate_inner :=
                        propagated_states_inner[source_idx_inner];
                    if candidate_inner.retained_exact_edge_count > 0 then
                    begin
                        consider_side_state_inner(candidate_inner);
                    end;
                end;
                if Length(model_states_inner) <= 0 then
                begin
                    Exit;
                end;
                retained_edge_inner := Default(TncLongRetainedExactEdge);
                retained_edge_inner.position := position_inner;
                retained_edge_inner.chunk_units :=
                    get_candidate_text_unit_count(
                    model_states_inner[0].first_chunk_text);
                retained_edge_inner.exact_rank :=
                    model_states_inner[0].first_chunk_exact_rank;
                retained_edge_inner.raw_weight :=
                    model_states_inner[0].first_chunk_raw_weight;
                retained_edge_inner.top_weight :=
                    model_states_inner[0].first_chunk_top_weight;
                retained_edge_inner.confidence := Round(
                    model_states_inner[0].first_chunk_exact_edge_model_score *
                    100000.0) + Int64(retained_edge_inner.chunk_units) *
                    1000 - Int64(Max(0,
                    retained_edge_inner.exact_rank - 1)) * 100;
                retained_edge_inner.query_key :=
                    model_states_inner[0].first_chunk_query_key;
                retained_edge_inner.text :=
                    model_states_inner[0].first_chunk_text;
                if (retained_edge_inner.chunk_units <
                    c_chain_lattice_exact_edge_min_units) or
                    (model_states_inner[
                    0].first_chunk_exact_edge_model_score <
                    c_chain_lattice_exact_edge_min_model_score) then
                begin
                    Exit;
                end;
                for source_idx_inner := 0 to High(model_states_inner) do
                begin
                    candidate_inner := model_states_inner[source_idx_inner];
                    if (candidate_inner.first_chunk_exact_rank <= 0) or
                        candidate_inner.first_chunk_source_user or
                        (not SameText(candidate_inner.first_chunk_query_key,
                        retained_edge_inner.query_key)) or
                        (not SameText(Trim(candidate_inner.first_chunk_text),
                        Trim(retained_edge_inner.text))) then
                    begin
                        Continue;
                    end;
                    mark_state_with_retained_edge_local(candidate_inner,
                        retained_edge_inner);
                    consider_side_state_inner(candidate_inner);
                end;
                remember_retained_exact_edge_local(position_inner,
                    model_states_inner[0], retained_edge_inner.confidence);
            end;

            procedure append_retained_exact_edge_slots_local(
                var states_inner: TExactChunkChainStateArray;
                const side_states_inner: TExactChunkChainStateArray);
            var
                side_idx_inner: Integer;
                state_idx_inner: Integer;
                duplicate_inner: Boolean;
            begin
                for side_idx_inner := 0 to Min(
                    exact_edge_reserved_slots_local - 1,
                    High(side_states_inner)) do
                begin
                    duplicate_inner := False;
                    for state_idx_inner := 0 to High(states_inner) do
                    begin
                        if SameText(Trim(states_inner[state_idx_inner].text),
                            Trim(side_states_inner[side_idx_inner].text)) and
                            SameText(states_inner[state_idx_inner].path,
                            side_states_inner[side_idx_inner].path) then
                        begin
                            duplicate_inner := True;
                            Break;
                        end;
                    end;
                    if duplicate_inner then
                    begin
                        Continue;
                    end;
                    SetLength(states_inner, Length(states_inner) + 1);
                    states_inner[High(states_inner)] :=
                        side_states_inner[side_idx_inner];
                end;
            end;

            procedure sort_final_states_with_retained_slot_local(
                var states_inner: TExactChunkChainStateArray);
            var
                normal_states_inner: TExactChunkChainStateArray;
                side_states_inner: TExactChunkChainStateArray;
                state_idx_inner: Integer;
                normal_count_inner: Integer;
                side_count_inner: Integer;
            begin
                normal_count_inner := 0;
                side_count_inner := 0;
                SetLength(normal_states_inner, Length(states_inner));
                SetLength(side_states_inner, Length(states_inner));
                for state_idx_inner := 0 to High(states_inner) do
                begin
                    if states_inner[
                        state_idx_inner].retained_exact_edge_count > 0 then
                    begin
                        side_states_inner[side_count_inner] :=
                            states_inner[state_idx_inner];
                        Inc(side_count_inner);
                    end
                    else
                    begin
                        normal_states_inner[normal_count_inner] :=
                            states_inner[state_idx_inner];
                        Inc(normal_count_inner);
                    end;
                end;
                SetLength(normal_states_inner, normal_count_inner);
                SetLength(side_states_inner, side_count_inner);
                sort_fast_states_by_order_score_local(normal_states_inner);
                if side_count_inner > 0 then
                begin
                    sort_fast_states_by_order_score_local(side_states_inner);
                    side_count_inner := Min(side_count_inner,
                        exact_edge_reserved_slots_local);
                    SetLength(normal_states_inner, normal_count_inner +
                        side_count_inner);
                    for state_idx_inner := 0 to side_count_inner - 1 do
                    begin
                        normal_states_inner[normal_count_inner +
                            state_idx_inner] := side_states_inner[
                            state_idx_inner];
                    end;
                end;
                states_inner := normal_states_inner;
            end;

        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := 0;
            out_segments := 0;
            exact_edge_reserved_slots_local :=
                c_chain_lattice_exact_edge_reserved_slots;
            SetLength(out_states, 0);
            if (input_syllable_count < 6) or (input_syllable_count > 40) then
            begin
                Exit;
            end;
            if m_debug_target_recall_text <> '' then
            begin
                m_debug_target_chain_build_attempted := True;
            end;

            greedy_state_found_local := (input_syllable_count >= 6) and
                try_build_unambiguous_multi_exact_chain_local(greedy_state_local) and
                should_accept_greedy_exact_chain_state_local(greedy_state_local);
            if greedy_state_found_local then
            begin
                greedy_state_local.baseline_lineage := True;
            end;

            prefix_state_found_local := (input_syllable_count <= 9) and
                try_build_prefix_exact_plus_short_tail_local(prefix_state_local) and
                should_accept_greedy_exact_chain_state_local(prefix_state_local);
            if prefix_state_found_local then
            begin
                prefix_state_local.baseline_lineage := True;
            end;

            fast_seed_requires_dp_local :=
                (greedy_state_found_local and
                fast_seed_lacks_lm_support_local(greedy_state_local)) or
                (prefix_state_found_local and
                fast_seed_lacks_lm_support_local(prefix_state_local));
            if (not fast_seed_requires_dp_local) and
                (not (greedy_state_found_local and prefix_state_found_local and
                (not SameText(Trim(greedy_state_local.text),
                Trim(prefix_state_local.text))))) then
            begin
                if greedy_state_found_local then
                begin
                    out_text := greedy_state_local.text;
                    out_path := greedy_state_local.path;
                    out_score := greedy_state_local.score;
                    out_segments := greedy_state_local.segments;
                    SetLength(out_states, 1);
                    out_states[0] := greedy_state_local;
                    Exit(True);
                end;
                if prefix_state_found_local then
                begin
                    out_text := prefix_state_local.text;
                    out_path := prefix_state_local.path;
                    out_score := prefix_state_local.score;
                    out_segments := prefix_state_local.segments;
                    SetLength(out_states, 1);
                    out_states[0] := prefix_state_local;
                    Exit(True);
                end;
            end;

            SetLength(state_map_local, syllable_count_local + 1);
            SetLength(retained_state_map_local, syllable_count_local + 1);
            for pos_local := 0 to syllable_count_local do
            begin
                SetLength(state_map_local[pos_local], 0);
                SetLength(retained_state_map_local[pos_local], 0);
            end;
            base_state_local := Default(TExactChunkChainState);
            base_state_local.score := 0;
            base_state_local.segments := 0;
            base_state_local.anchor_units := -1;
            base_state_local.baseline_lineage := True;
            SetLength(state_map_local[syllable_count_local], 1);
            state_map_local[syllable_count_local][0] := base_state_local;

            for pos_local := syllable_count_local - 1 downto 0 do
            begin
                SetLength(baseline_candidates_local, 0);
                SetLength(edge_probe_candidates_local, 0);
                SetLength(exact_edge_model_candidates_local, 0);
                for chunk_len_local := 1 to Min(c_fast_max_chunk_syllables,
                    syllable_count_local - pos_local) do
                begin
                    next_pos_local := pos_local + chunk_len_local;
                    if Length(state_map_local[next_pos_local]) = 0 then
                    begin
                        Continue;
                    end;
                    if not try_collect_fast_options_local(pos_local,
                        chunk_len_local, options_local) then
                    begin
                        Continue;
                    end;

                    for option_idx_local := 0 to High(options_local) do
                    begin
                        suffix_count_local :=
                            Length(state_map_local[next_pos_local]);
                        if c_chain_lattice_exact_edge_side_lane_enabled then
                        begin
                            Inc(suffix_count_local,
                                Length(retained_state_map_local[
                                next_pos_local]));
                        end;
                        for suffix_idx_local := 0 to
                            suffix_count_local - 1 do
                        begin
                            if suffix_idx_local <
                                Length(state_map_local[next_pos_local]) then
                            begin
                                suffix_state_local :=
                                    state_map_local[next_pos_local][
                                    suffix_idx_local];
                            end
                            else
                            begin
                                suffix_state_local :=
                                    retained_state_map_local[next_pos_local][
                                    suffix_idx_local - Length(
                                    state_map_local[next_pos_local])];
                            end;
                            candidate_state_local := Default(TExactChunkChainState);
                            candidate_state_local.text :=
                                options_local[option_idx_local].text +
                                suffix_state_local.text;
                            candidate_state_local.path :=
                                options_local[option_idx_local].path;
                            if suffix_state_local.path <> '' then
                            begin
                                if candidate_state_local.path <> '' then
                                begin
                                    candidate_state_local.path :=
                                        candidate_state_local.path +
                                        c_segment_path_separator;
                                end;
                                candidate_state_local.path := candidate_state_local.path +
                                    suffix_state_local.path;
                            end;
                            candidate_state_local.first_chunk_text :=
                                options_local[option_idx_local].text;
                            candidate_state_local.first_chunk_query_key :=
                                options_local[option_idx_local].query_key;
                            candidate_state_local.first_chunk_exact_rank :=
                                options_local[option_idx_local].exact_rank;
                            candidate_state_local.first_chunk_raw_weight :=
                                options_local[option_idx_local].raw_weight;
                            candidate_state_local.first_chunk_top_weight :=
                                options_local[option_idx_local].top_weight;
                            candidate_state_local.first_chunk_effective_score :=
                                options_local[option_idx_local].score;
                            candidate_state_local.first_chunk_edge_score :=
                                options_local[option_idx_local].edge_retention_score;
                            candidate_state_local.first_chunk_exact_edge_model_score :=
                                options_local[
                                option_idx_local].exact_edge_model_score;
                            candidate_state_local.first_chunk_source_user :=
                                options_local[option_idx_local].source_user;
                            candidate_state_local.first_chunk_baseline_option :=
                                options_local[option_idx_local].baseline_option;
                            candidate_state_local.score :=
                                options_local[option_idx_local].score +
                                suffix_state_local.score;
                            Dec(candidate_state_local.score,
                                get_competing_boundary_penalty_fast_local(
                                candidate_state_local.text, pos_local,
                                chunk_len_local, options_local[option_idx_local],
                                suffix_state_local));
                            function_context_adjust_local := 0;
                            if suffix_state_local.first_chunk_text <> '' then
                            begin
                                Inc(candidate_state_local.score,
                                    m_dictionary.get_context_bonus(
                                    options_local[option_idx_local].text,
                                    suffix_state_local.first_chunk_text));
                                Inc(candidate_state_local.score,
                                    get_adjacent_exact_chunk_context_bonus_local(
                                    options_local[option_idx_local].text,
                                    suffix_state_local.first_chunk_text));
                                function_context_adjust_local :=
                                    get_function_particle_suffix_context_adjustment_local(
                                    effective_syllables[pos_local + chunk_len_local -
                                    1].text,
                                    options_local[option_idx_local].text,
                                    suffix_state_local.first_chunk_text);
                                Inc(candidate_state_local.score,
                                    function_context_adjust_local);
                                if starts_with_context_text_unit_local(
                                    suffix_state_local.text, $5730) or
                                    starts_with_context_text_unit_local(
                                    suffix_state_local.text, $5F97) or
                                    starts_with_context_text_unit_local(
                                    suffix_state_local.text, $4E3A) or
                                    starts_with_context_text_unit_local(
                                    suffix_state_local.text, $672A) then
                                begin
                                    prefix_context_adjust_local :=
                                        get_function_particle_prefix_context_adjustment_local(
                                        options_local[option_idx_local].text,
                                        suffix_state_local.text);
                                    if prefix_context_adjust_local <= -90000 then
                                    begin
                                        Continue;
                                    end;
                                    Inc(candidate_state_local.score,
                                        prefix_context_adjust_local);
                                end;
                            end;
                            if (chunk_len_local = 1) and
                                (suffix_state_local.first_chunk_text <> '') and
                                is_modifier_prefix_bridge_exempt_local(
                                options_local[option_idx_local].text) and
                                (get_candidate_text_unit_count(
                                suffix_state_local.first_chunk_text) >= 2) then
                            begin
                                Inc(candidate_state_local.score, 7600);
                            end;
                            if (chunk_len_local = 1) and
                                (next_pos_local < syllable_count_local) then
                            begin
                                suffix_first_units_local :=
                                    get_candidate_text_unit_count(
                                    suffix_state_local.first_chunk_text);
                                natural_modifier_phrase_boundary_local :=
                                    is_natural_modifier_phrase_boundary_fast_local(
                                    options_local[option_idx_local].text,
                                    next_pos_local, suffix_first_units_local,
                                    suffix_state_local.first_chunk_text, 400);
                                head_two_key_local := build_query_key_local(pos_local, 2);
                                if try_get_strong_fast_exact_phrase_text_local(
                                    head_two_key_local, 2, 700,
                                    head_two_text_local) then
                                begin
                                    current_pair_text_local :=
                                        options_local[option_idx_local].text +
                                        get_first_text_unit_fast_local(
                                        suffix_state_local.first_chunk_text);
                                    if (current_pair_text_local <> '') and
                                        (not SameText(current_pair_text_local,
                                        head_two_text_local)) then
                                    begin
                                        head_two_raw_local :=
                                            get_fast_exact_phrase_raw_weight_local(
                                            head_two_key_local, 2,
                                            head_two_text_local);
                                        suffix_first_raw_local := 0;
                                        if (suffix_first_units_local >= 2) and
                                            (suffix_state_local.first_chunk_query_key
                                            <> '') then
                                        begin
                                            suffix_first_raw_local :=
                                                get_fast_exact_phrase_raw_weight_local(
                                                suffix_state_local.first_chunk_query_key,
                                                suffix_first_units_local,
                                                suffix_state_local.first_chunk_text);
                                        end;
                                        if natural_modifier_phrase_boundary_local then
                                        begin
                                            { Natural function-single + phrase
                                              boundary, e.g. 鍏?鎻愪氦. }
                                        end
                                        else if suffix_first_raw_local >=
                                            head_two_raw_local + 700 then
                                        begin
                                            Dec(candidate_state_local.score, 12000);
                                        end
                                        else
                                        begin
                                            Dec(candidate_state_local.score, 72000);
                                        end;
                                    end;
                                end;
                                if (not natural_modifier_phrase_boundary_local) and
                                    has_high_quality_exact_phrase_with_prefix_for_key_local(
                                    head_two_key_local, 2, 240,
                                    options_local[option_idx_local].text) and
                                    (not is_strong_modifier_prefix_local(
                                    options_local[option_idx_local].text)) then
                                begin
                                    Dec(candidate_state_local.score, 36000);
                                end
                                else if (not natural_modifier_phrase_boundary_local) and
                                    has_high_quality_exact_phrase_for_key_local(
                                    head_two_key_local, 2, 240) and
                                    ((not is_modifier_prefix_bridge_exempt_local(
                                    options_local[option_idx_local].text)) or
                                    (not has_high_quality_exact_phrase_with_prefix_for_key_local(
                                    head_two_key_local, 2, 240,
                                    options_local[option_idx_local].text))) then
                                begin
                                    Dec(candidate_state_local.score, 30000);
                                end;
                            end;
                            candidate_state_local.segments :=
                                options_local[option_idx_local].segments +
                                suffix_state_local.segments;
                            candidate_state_local.has_anchor :=
                                options_local[option_idx_local].has_anchor or
                                suffix_state_local.has_anchor;
                            candidate_state_local.anchor_units :=
                                options_local[option_idx_local].anchor_units;
                            if suffix_state_local.anchor_units >
                                candidate_state_local.anchor_units then
                            begin
                                candidate_state_local.anchor_units :=
                                    suffix_state_local.anchor_units;
                            end;
                            candidate_state_local.retained_exact_edge_count :=
                                suffix_state_local.retained_exact_edge_count;
                            candidate_state_local.retained_exact_edge_position :=
                                suffix_state_local.retained_exact_edge_position;
                            candidate_state_local.retained_exact_edge_units :=
                                suffix_state_local.retained_exact_edge_units;
                            candidate_state_local.retained_exact_edge_rank :=
                                suffix_state_local.retained_exact_edge_rank;
                            candidate_state_local.retained_exact_edge_top_weight :=
                                suffix_state_local.retained_exact_edge_top_weight;
                            candidate_state_local.retained_exact_edge_confidence :=
                                suffix_state_local.retained_exact_edge_confidence;
                            candidate_state_local.baseline_lineage :=
                                suffix_state_local.baseline_lineage and
                                options_local[option_idx_local].baseline_option;
                            if pos_local = 0 then
                            begin
                                Inc(candidate_state_local.score,
                                    get_fast_full_path_adjustment_local(
                                    candidate_state_local.path));
                            end;
                            consider_generated_fast_state_local(
                                candidate_state_local);

                            if try_get_function_particle_suffix_head_alternative_local(
                                options_local[option_idx_local].text,
                                suffix_state_local.text,
                                suffix_state_local.path,
                                suffix_state_local.first_chunk_text,
                                suffix_state_local.first_chunk_query_key,
                                alternative_text_local,
                                alternative_suffix_path_local,
                                alternative_adjust_local) then
                            begin
                                alternative_state_local := candidate_state_local;
                                if pos_local = 0 then
                                begin
                                    Dec(alternative_state_local.score,
                                        get_fast_full_path_adjustment_local(
                                        alternative_state_local.path));
                                end;
                                alternative_state_local.text :=
                                    options_local[option_idx_local].text +
                                    alternative_text_local;
                                alternative_state_local.path :=
                                    options_local[option_idx_local].path;
                                if alternative_suffix_path_local <> '' then
                                begin
                                    if alternative_state_local.path <> '' then
                                    begin
                                        alternative_state_local.path :=
                                            alternative_state_local.path +
                                            c_segment_path_separator;
                                    end;
                                    alternative_state_local.path :=
                                        alternative_state_local.path +
                                        alternative_suffix_path_local;
                                end;
                                alternative_state_local.score :=
                                    alternative_state_local.score +
                                    alternative_adjust_local;
                                if pos_local = 0 then
                                begin
                                    Inc(alternative_state_local.score,
                                        get_fast_full_path_adjustment_local(
                                        alternative_state_local.path));
                                end;
                                consider_generated_fast_state_local(
                                    alternative_state_local);
                            end;

                            if (options_local[option_idx_local].segments = 1) and
                                (suffix_state_local.first_chunk_text <> '') and
                                try_get_function_particle_boundary_alternative_local(
                                effective_syllables[pos_local + chunk_len_local -
                                1].text,
                                options_local[option_idx_local].text,
                                suffix_state_local.first_chunk_text,
                                alternative_text_local, alternative_adjust_local) then
                            begin
                                alternative_state_local := candidate_state_local;
                                if pos_local = 0 then
                                begin
                                    Dec(alternative_state_local.score,
                                        get_fast_full_path_adjustment_local(
                                        alternative_state_local.path));
                                end;
                                alternative_score_local :=
                                    alternative_state_local.score -
                                    function_context_adjust_local +
                                    alternative_adjust_local;
                                alternative_state_local.text :=
                                    alternative_text_local +
                                    suffix_state_local.text;
                                alternative_state_local.path := alternative_text_local;
                                if suffix_state_local.path <> '' then
                                begin
                                    alternative_state_local.path :=
                                        alternative_state_local.path +
                                        c_segment_path_separator +
                                        suffix_state_local.path;
                                end;
                                alternative_state_local.first_chunk_text :=
                                    alternative_text_local;
                                alternative_state_local.score :=
                                    alternative_score_local;
                                if pos_local = 0 then
                                begin
                                    Inc(alternative_state_local.score,
                                        get_fast_full_path_adjustment_local(
                                        alternative_state_local.path));
                                end;
                                consider_generated_fast_state_local(
                                    alternative_state_local);
                            end;
                        end;
                    end;
                    if (not m_debug_expand_long_beam_states) and
                        (exact_edge_reserved_slots_local > 0) then
                    begin
                        runtime_exact_edge_probe_collection_local := True;
                        try
                            if try_collect_fast_options_local(pos_local,
                                chunk_len_local, probe_options_local) then
                            begin
                                collect_runtime_exact_edge_probe_states_local(
                                    pos_local, chunk_len_local,
                                    next_pos_local, probe_options_local);
                            end;
                        finally
                            runtime_exact_edge_probe_collection_local := False;
                        end;
                    end;
                end;
                legacy_candidates_local := Copy(baseline_candidates_local,
                    0, Length(baseline_candidates_local));
                prune_baseline_fast_states_by_char_lm_local(
                    baseline_candidates_local, pos_local);
                if m_debug_expand_long_beam_states then
                begin
                    prune_fast_states_by_char_lm_local(
                        state_map_local[pos_local], pos_local,
                        baseline_candidates_local, True);
                    merge_baseline_and_expanded_fast_states_local(
                        state_map_local[pos_local],
                        baseline_candidates_local);
                end
                else if (exact_edge_reserved_slots_local > 0) and
                    ((Length(edge_probe_candidates_local) > 0) or
                    (Length(exact_edge_model_candidates_local) > 0)) then
                begin
                    choose_retained_exact_edge_slots_local(pos_local,
                        edge_probe_candidates_local,
                        exact_edge_model_candidates_local,
                        retained_slot_states_local);
                    prune_fast_states_by_char_lm_local(
                        legacy_candidates_local, pos_local,
                        baseline_candidates_local, False);
                    state_map_local[pos_local] :=
                        legacy_candidates_local;
                    merge_baseline_and_expanded_fast_states_local(
                        state_map_local[pos_local],
                        baseline_candidates_local);
                    if c_chain_lattice_exact_edge_side_lane_enabled and
                        (Length(retained_slot_states_local) > 0) then
                    begin
                        retained_state_map_local[pos_local] :=
                            Copy(retained_slot_states_local, 0,
                            Length(retained_slot_states_local));
                    end;
                end
                else
                begin
                    prune_fast_states_by_char_lm_local(
                        state_map_local[pos_local], pos_local,
                        baseline_candidates_local, False);
                    merge_baseline_and_expanded_fast_states_local(
                        state_map_local[pos_local],
                        baseline_candidates_local);
                end;
            end;

            if greedy_state_found_local then
            begin
                greedy_state_present_local := False;
                for debug_state_idx_local := 0 to High(state_map_local[0]) do
                begin
                    if SameText(Trim(state_map_local[0][debug_state_idx_local].text),
                        Trim(greedy_state_local.text)) then
                    begin
                        greedy_state_present_local := True;
                        Break;
                    end;
                end;
                if not greedy_state_present_local then
                begin
                    SetLength(state_map_local[0], Length(state_map_local[0]) + 1);
                    state_map_local[0][High(state_map_local[0])] :=
                        greedy_state_local;
                end;
            end;
            if prefix_state_found_local then
            begin
                prefix_state_present_local := False;
                for debug_state_idx_local := 0 to High(state_map_local[0]) do
                begin
                    if SameText(Trim(state_map_local[0][debug_state_idx_local].text),
                        Trim(prefix_state_local.text)) then
                    begin
                        prefix_state_present_local := True;
                        Break;
                    end;
                end;
                if not prefix_state_present_local then
                begin
                    SetLength(state_map_local[0], Length(state_map_local[0]) + 1);
                    state_map_local[0][High(state_map_local[0])] :=
                        prefix_state_local;
                end;
            end;

            if c_chain_lattice_exact_edge_side_lane_enabled and
                (Length(retained_state_map_local[0]) > 0) then
            begin
                append_retained_exact_edge_slots_local(state_map_local[0],
                    retained_state_map_local[0]);
            end;
            sort_final_states_with_retained_slot_local(state_map_local[0]);
            capture_final_chain_candidates_local(state_map_local[0]);

            baseline_acceptance_score_local := Low(Integer);
            baseline_acceptance_found_local := False;
            for debug_state_idx_local := 0 to High(state_map_local[0]) do
            begin
                if state_map_local[0][debug_state_idx_local].baseline_lineage then
                begin
                    baseline_acceptance_score_local := Max(
                        baseline_acceptance_score_local,
                        state_map_local[0][debug_state_idx_local].score);
                    baseline_acceptance_found_local := True;
                end;
            end;

            if m_debug_target_recall_text <> '' then
            begin
                m_debug_target_final_state_count := Max(
                    m_debug_target_final_state_count,
                    Length(state_map_local[0]));
                for debug_state_idx_local := 0 to High(state_map_local[0]) do
                begin
                    if SameText(Trim(state_map_local[0][debug_state_idx_local].text),
                        m_debug_target_recall_text) then
                    begin
                        m_debug_target_final_state_source_mask :=
                            m_debug_target_final_state_source_mask or 1;
                        if (m_debug_target_chain_final_state_rank = 0) or
                            (debug_state_idx_local + 1 <
                            m_debug_target_chain_final_state_rank) then
                        begin
                            m_debug_target_chain_final_state_rank :=
                                debug_state_idx_local + 1;
                        end;
                        if (not m_debug_target_final_state_found) or
                            (debug_state_idx_local + 1 <
                            m_debug_target_final_state_rank) then
                        begin
                            m_debug_target_final_state_found := True;
                            m_debug_target_final_state_rank :=
                                debug_state_idx_local + 1;
                        end;
                    end;
                end;
            end;

            if (Length(state_map_local[0]) = 0) or
                (state_map_local[0][0].text = '') or
                (get_candidate_text_unit_count(state_map_local[0][0].text) <>
                input_syllable_count) then
            begin
                if m_config.debug_mode then
                begin
                    state_debug_text_local := '';
                    for pos_local := 0 to syllable_count_local do
                    begin
                        if pos_local >= 8 then
                        begin
                            state_debug_text_local := state_debug_text_local +
                                ' ...';
                            Break;
                        end;
                        if Length(state_map_local[pos_local]) > 0 then
                        begin
                            state_debug_text_local := state_debug_text_local +
                                Format(' %d:%s/%d', [pos_local,
                                state_map_local[pos_local][0].text,
                                state_map_local[pos_local][0].score]);
                        end;
                    end;
                    if Length(state_map_local[0]) > 0 then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' xfastdp_miss=[score=%d text=%s first=%s fixed=%s]',
                            [state_map_local[0][0].score,
                            state_map_local[0][0].text,
                            effective_syllables[0].text,
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[0].text)]) +
                            state_debug_text_local;
                    end
                    else
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' xfastdp_miss=[score=%d text=%s first=%s fixed=%s]',
                            [Low(Integer), '', effective_syllables[0].text,
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[0].text)]) +
                            state_debug_text_local;
                    end;
                end;
                Exit;
            end;

            out_states := Copy(state_map_local[0]);
            out_text := state_map_local[0][0].text;
            out_path := state_map_local[0][0].path;
            out_score := state_map_local[0][0].score;
            out_segments := state_map_local[0][0].segments;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' xfastdp_probe=[text=%s score=%d seg=%d]',
                    [out_text, out_score, out_segments]);
            end;
            if input_syllable_count >= 12 then
            begin
                minimum_score_local := input_syllable_count * 4600;
            end
            else if input_syllable_count >= 9 then
            begin
                minimum_score_local := input_syllable_count * 4900;
            end
            else
            begin
                minimum_score_local := input_syllable_count * 5200;
            end;
            { Expanded states may be promoted in the returned candidate list,
              but they must not suppress the legacy fallback search. Keep the
              old six-state beam as the acceptance authority. }
            Result := baseline_acceptance_found_local and
                (baseline_acceptance_score_local >= minimum_score_local);
            if m_debug_target_recall_text <> '' then
            begin
                m_debug_target_chain_build_accepted := Result;
                m_debug_target_chain_top_score := baseline_acceptance_score_local;
                m_debug_target_chain_min_score := minimum_score_local;
            end;
        end;

        function try_repair_state_with_covering_exact_pairs_local(
            const source_state: TExactChunkChainState;
            out repaired_state: TExactChunkChainState;
            const incremental_tail_only: Boolean = False): Boolean;
        const
            c_min_covering_pair_exact_weight = 240;
            c_min_single_chain_triple_exact_weight = 180;
            c_repair_bonus = 9000;
            c_same_span_exact_min_gap = 300;
            c_same_span_exact_min_target_weight = 700;
            c_same_span_exact_probe_limit = c_chain_probe_limit * 4;
        var
            path_segments_local: TArray<string>;
            segment_idx_local: Integer;
            query_offset_local: Integer;
            current_text_local: string;
            current_units_local: Integer;
            next_text_local: string;
            next_units_local: Integer;
            third_text_local: string;
            third_units_local: Integer;
            fourth_text_local: string;
            fourth_units_local: Integer;
            combined_key_local: string;
            combined_text_local: string;
            best_exact_text_local: string;
            best_exact_score_local: Integer;
            repair_count_local: Integer;
            repair_probe_budget_local: Integer;
            repaired_text_local: string;
            repaired_path_local: string;
            chained_repaired_text_local: string;
            chained_repaired_path_local: string;
            repair_used_prefix_tail_shift_local: Boolean;
            repair_used_boundary_shift_local: Boolean;

            procedure append_repaired_segment_local(const segment_text_local: string);
            begin
                if segment_text_local = '' then
                begin
                    Exit;
                end;
                repaired_text_local := repaired_text_local + segment_text_local;
                if repaired_path_local <> '' then
                begin
                    repaired_path_local := repaired_path_local +
                        c_segment_path_separator;
                end;
                repaired_path_local := repaired_path_local + segment_text_local;
            end;

            function try_get_same_span_better_exact_segment_local(
                const segment_query_offset_local: Integer;
                const segment_units_local: Integer;
                const current_segment_text_local: string;
                out out_segment_text_local: string;
                out out_segment_score_local: Integer): Boolean;
            const
                c_same_span_directional_context_bonus = 12000;
                c_same_span_directional_min_weight = 300;
                c_same_span_context_margin = 120;
                c_same_span_unsupported_min_target_weight = 520;
                c_same_span_reliable_source_min_weight = 240;
            var
                query_key_local: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                candidate_text_local: string;
                candidate_raw_weight_local: Integer;
                candidate_score_local: Integer;
                candidate_adjusted_weight_local: Integer;
                current_raw_weight_local: Integer;
                current_adjusted_weight_local: Integer;
                best_raw_weight_local: Integer;
                best_adjusted_weight_local: Integer;
                best_score_local: Integer;
                best_text_local: string;
                has_directional_context_local: Boolean;

                function is_place_noun_unit_for_direction_context_local(
                    const unit_value: string): Boolean;
                begin
                    Result := (unit_value = string(Char($5BB6))) or
                        (unit_value = string(Char($5E97))) or
                        (unit_value = string(Char($5C4B))) or
                        (unit_value = string(Char($697C))) or
                        (unit_value = string(Char($57CE))) or
                        (unit_value = string(Char($6751))) or
                        (unit_value = string(Char($53BF))) or
                        (unit_value = string(Char($5E02))) or
                        (unit_value = string(Char($6821))) or
                        (unit_value = string(Char($9662))) or
                        (unit_value = string(Char($5382))) or
                        (unit_value = string(Char($9986))) or
                        (unit_value = string(Char($7AD9))) or
                        (unit_value = string(Char($5C40))) or
                        (unit_value = string(Char($6240))) or
                        (unit_value = string(Char($56ED))) or
                        (unit_value = string(Char($533A))) or
                        (unit_value = string(Char($5708))) or
                        (unit_value = string(Char($8DEF))) or
                        (unit_value = string(Char($8857))) or
                        (unit_value = string(Char($95E8))) or
                        (unit_value = string(Char($5BA4))) or
                        (unit_value = string(Char($623F))) or
                        (unit_value = string(Char($5385))) or
                        (unit_value = string(Char($573A))) or
                        (unit_value = string(Char($53F8)));
                end;

                function has_place_context_before_same_span_local: Boolean;
                const
                    c_context_probe_limit = 8;
                var
                    back_len_local: Integer;
                    context_key_local: string;
                    context_results_local: TncCandidateList;
                    result_idx_local: Integer;
                    context_text_local: string;
                    context_units_local: TArray<string>;
                begin
                    Result := False;
                    if segment_query_offset_local <= 0 then
                    begin
                        Exit;
                    end;

                    for back_len_local := 1 to Min(4,
                        segment_query_offset_local) do
                    begin
                        context_key_local := build_query_key_local(
                            segment_query_offset_local - back_len_local,
                            back_len_local);
                        if (context_key_local = '') or
                            (not lookup_exact_full_pinyin_cached_local(
                            context_key_local, context_results_local)) then
                        begin
                            Continue;
                        end;

                        for result_idx_local := 0 to High(context_results_local) do
                        begin
                            if result_idx_local >= c_context_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(context_results_local[result_idx_local].comment) <>
                                '' then
                            begin
                                Continue;
                            end;

                            context_text_local := Trim(
                                context_results_local[result_idx_local].text);
                            context_units_local := split_text_units(
                                context_text_local);
                            if (Length(context_units_local) > 0) and
                                is_place_noun_unit_for_direction_context_local(
                                context_units_local[High(context_units_local)]) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                function has_directional_same_span_context_local: Boolean;
                var
                    next_key_local: string;
                begin
                    Result := False;
                    if (segment_units_local <> 2) or
                        (not has_place_context_before_same_span_local) then
                    begin
                        Exit;
                    end;

                    if segment_query_offset_local + segment_units_local >=
                        syllable_count_local then
                    begin
                        Exit(True);
                    end;

                    next_key_local := normalize_pinyin_text(
                        effective_syllables[segment_query_offset_local +
                        segment_units_local].text);
                    Result := SameText(next_key_local, 'de');
                end;

                function is_directional_locative_text_for_same_span_local(
                    const text_value_local: string): Boolean;
                begin
                    Result := get_directional_locative_span_bonus_local(
                        text_value_local) > 0;
                end;

                function has_function_particle_before_same_span_local: Boolean;
                var
                    source_units_local: TArray<string>;
                    previous_unit_local: string;
                begin
                    Result := False;
                    source_units_local := split_text_units(source_state.text);
                    if (segment_query_offset_local <= 0) or
                        (segment_query_offset_local > High(source_units_local)) then
                    begin
                        Exit;
                    end;

                    previous_unit_local :=
                        source_units_local[segment_query_offset_local - 1];
                    Result := SameText(previous_unit_local, string(Char($7684))) or
                        SameText(previous_unit_local, string(Char($5730))) or
                        SameText(previous_unit_local, string(Char($5F97))) or
                        SameText(previous_unit_local, string(Char($4E4B)));
                end;

                function is_temporal_process_same_span_text_local(
                    const text_value_local: string): Boolean;
                begin
                    Result :=
                        SameText(text_value_local, string(Char($65F6)) +
                        string(Char($95F4))) or
                        SameText(text_value_local, string(Char($65F6)) +
                        string(Char($5019))) or
                        SameText(text_value_local, string(Char($671F)) +
                        string(Char($95F4))) or
                        SameText(text_value_local, string(Char($8FC7)) +
                        string(Char($7A0B))) or
                        SameText(text_value_local, string(Char($9636)) +
                        string(Char($6BB5))) or
                        SameText(text_value_local, string(Char($65F6)) +
                        string(Char($523B))) or
                        SameText(text_value_local, string(Char($77AC)) +
                        string(Char($95F4))) or
                        SameText(text_value_local, string(Char($65E9)) +
                        string(Char($6668))) or
                        SameText(text_value_local, string(Char($591C)) +
                        string(Char($665A))) or
                        SameText(text_value_local, string(Char($4E0A)) +
                        string(Char($5348))) or
                        SameText(text_value_local, string(Char($4E0B)) +
                        string(Char($5348))) or
                        SameText(text_value_local, string(Char($4E2D)) +
                        string(Char($5348))) or
                        SameText(text_value_local, string(Char($5E74)) +
                        string(Char($4EE3))) or
                        SameText(text_value_local, string(Char($65F6)) +
                        string(Char($4EE3)));
                end;

                function get_same_span_adjusted_weight_local(
                    const text_value_local: string;
                    const raw_weight_value_local: Integer): Integer;
                begin
                    Result := raw_weight_value_local;
                    if has_directional_context_local and
                        is_directional_locative_text_for_same_span_local(
                        text_value_local) then
                    begin
                        Inc(Result, c_same_span_directional_context_bonus);
                    end;
                    if (segment_query_offset_local > 0) and
                        is_temporal_process_same_span_text_local(
                        text_value_local) and
                        has_function_particle_before_same_span_local then
                    begin
                        Inc(Result, 4200);
                    end;
                end;
            begin
                Result := False;
                out_segment_text_local := '';
                out_segment_score_local := 0;
                if (segment_query_offset_local < 0) or
                    (segment_units_local < 2) or (segment_units_local > 4) or
                    (current_segment_text_local = '') or
                    (segment_query_offset_local + segment_units_local >
                    syllable_count_local) then
                begin
                    Exit;
                end;

                query_key_local := build_query_key_local(
                    segment_query_offset_local, segment_units_local);
                if (query_key_local = '') or
                    (not lookup_exact_full_pinyin_cached_local(query_key_local,
                    local_results)) then
                begin
                    Exit;
                end;

                current_raw_weight_local := 0;
                current_adjusted_weight_local := 0;
                best_raw_weight_local := 0;
                best_adjusted_weight_local := 0;
                best_score_local := Low(Integer);
                best_text_local := '';
                has_directional_context_local :=
                    has_directional_same_span_context_local;
                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_same_span_exact_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(local_results[local_idx].text);
                    if (candidate_text_local = '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        segment_units_local) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        candidate_text_local, segment_units_local)) then
                    begin
                        Continue;
                    end;

                    candidate_raw_weight_local := get_exact_chunk_raw_weight_local(
                        local_results[local_idx]);
                    if SameText(candidate_text_local, current_segment_text_local) then
                    begin
                        if candidate_raw_weight_local > current_raw_weight_local then
                        begin
                            current_raw_weight_local := candidate_raw_weight_local;
                            current_adjusted_weight_local :=
                                get_same_span_adjusted_weight_local(
                                candidate_text_local, candidate_raw_weight_local);
                        end;
                        Continue;
                    end;

                    if has_particle_tail_mismatch_local(query_key_local,
                        candidate_text_local, candidate_raw_weight_local) or
                        (not is_reliable_fast_exact_chunk_local(query_key_local,
                        segment_units_local, candidate_text_local,
                        local_results[local_idx])) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := get_exact_chunk_effective_weight_local(
                        local_results[local_idx]);
                    candidate_adjusted_weight_local :=
                        get_same_span_adjusted_weight_local(candidate_text_local,
                        candidate_raw_weight_local);
                    if has_directional_context_local and
                        is_directional_locative_text_for_same_span_local(
                        candidate_text_local) then
                    begin
                        Inc(candidate_score_local,
                            c_same_span_directional_context_bonus);
                    end;
                    if (candidate_adjusted_weight_local >
                        best_adjusted_weight_local) or
                        ((candidate_adjusted_weight_local =
                        best_adjusted_weight_local) and
                        (candidate_raw_weight_local > best_raw_weight_local)) or
                        ((candidate_adjusted_weight_local =
                        best_adjusted_weight_local) and
                        (candidate_raw_weight_local = best_raw_weight_local) and
                        (candidate_score_local > best_score_local)) then
                    begin
                        best_raw_weight_local := candidate_raw_weight_local;
                        best_adjusted_weight_local :=
                            candidate_adjusted_weight_local;
                        best_score_local := candidate_score_local;
                        best_text_local := candidate_text_local;
                    end;
                end;

                if best_text_local = '' then
                begin
                    Exit;
                end;

                if current_raw_weight_local <= 0 then
                begin
                    if best_raw_weight_local <
                        c_same_span_unsupported_min_target_weight then
                    begin
                        Exit;
                    end;

                    out_segment_text_local := best_text_local;
                    out_segment_score_local := best_score_local;
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' xsamespan_unsupported=[%s>%s raw=%d]',
                            [current_segment_text_local, best_text_local,
                            best_raw_weight_local]);
                    end;
                    Exit(True);
                end;

                if (not has_directional_context_local) and
                    (best_adjusted_weight_local = best_raw_weight_local) and
                    (current_adjusted_weight_local = current_raw_weight_local) then
                begin
                    Exit;
                end;

                if has_directional_context_local then
                begin
                    if (best_raw_weight_local < c_same_span_directional_min_weight) or
                        (best_adjusted_weight_local <
                        current_adjusted_weight_local +
                        c_same_span_context_margin) then
                    begin
                        Exit;
                    end;
                end
                else if (best_adjusted_weight_local <> best_raw_weight_local) or
                    (current_adjusted_weight_local <> current_raw_weight_local) then
                begin
                    if (best_raw_weight_local < c_same_span_directional_min_weight) or
                        (best_adjusted_weight_local <
                        current_adjusted_weight_local +
                        c_same_span_context_margin) then
                    begin
                        Exit;
                    end;
                end
                else
                begin
                    Exit;
                end;

                out_segment_text_local := best_text_local;
                out_segment_score_local := best_score_local;
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xsamespan=[%s>%s raw=%d/%d]',
                        [current_segment_text_local, best_text_local,
                        current_raw_weight_local, best_raw_weight_local]);
                    if has_directional_context_local then
                    begin
                        m_last_full_path_debug_info := m_last_full_path_debug_info +
                            Format(' adj=%d/%d',
                            [current_adjusted_weight_local,
                            best_adjusted_weight_local]);
                    end;
                end;
                Result := True;
            end;

            function try_repair_same_span_exact_segments_local(
                const source_path_local: string;
                out out_text_local: string; out out_path_local: string;
                out out_score_bonus_local: Integer;
                out out_repair_count_local: Integer): Boolean;
            var
                segments_local: TArray<string>;
                segment_idx_local: Integer;
                segment_text_local: string;
                segment_units_local: Integer;
                query_offset_inner: Integer;
                replacement_text_local: string;
                replacement_score_local: Integer;
                local_text_accum: string;
                local_path_accum: string;

                procedure append_same_span_segment_local(
                    const segment_value_local: string);
                begin
                    if segment_value_local = '' then
                    begin
                        Exit;
                    end;
                    local_text_accum := local_text_accum + segment_value_local;
                    if local_path_accum <> '' then
                    begin
                        local_path_accum := local_path_accum +
                            c_segment_path_separator;
                    end;
                    local_path_accum := local_path_accum + segment_value_local;
                end;
            begin
                Result := False;
                out_text_local := '';
                out_path_local := '';
                out_score_bonus_local := 0;
                out_repair_count_local := 0;
                local_text_accum := '';
                local_path_accum := '';
                if source_path_local = '' then
                begin
                    Exit;
                end;

                segments_local := source_path_local.Split([c_segment_path_separator]);
                if Length(segments_local) = 0 then
                begin
                    Exit;
                end;

                query_offset_inner := 0;
                for segment_idx_local := 0 to High(segments_local) do
                begin
                    segment_text_local := Trim(segments_local[segment_idx_local]);
                    segment_units_local := get_candidate_text_unit_count(
                        segment_text_local);
                    if (segment_text_local = '') or (segment_units_local <= 0) or
                        (query_offset_inner + segment_units_local >
                        syllable_count_local) then
                    begin
                        Exit(False);
                    end;

                    if try_get_same_span_better_exact_segment_local(
                        query_offset_inner, segment_units_local, segment_text_local,
                        replacement_text_local, replacement_score_local) then
                    begin
                        append_same_span_segment_local(replacement_text_local);
                        Inc(out_score_bonus_local, Max(0, replacement_score_local));
                        Inc(out_repair_count_local);
                    end
                    else
                    begin
                        append_same_span_segment_local(segment_text_local);
                    end;

                    Inc(query_offset_inner, segment_units_local);
                end;

                if (query_offset_inner <> syllable_count_local) or
                    (out_repair_count_local <= 0) or
                    SameText(local_text_accum, source_state.text) then
                begin
                    Exit(False);
                end;

                out_text_local := local_text_accum;
                out_path_local := local_path_accum;
                Result := True;
            end;

            function repaired_text_rewrites_protected_source_exact_span_local: Boolean;
            const
                c_min_protected_exact_span_weight = 240;
                c_max_protected_exact_span_units = 6;
            var
                source_units_local: TArray<string>;
                repaired_units_local: TArray<string>;
                start_idx_local: Integer;
                span_len_local: Integer;
                unit_idx_local: Integer;
                query_key_local: string;
                source_span_text_local: string;
                repaired_span_text_local: string;
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_weight_local: Integer;

                function build_unit_span_text_local(const units_local: TArray<string>;
                    const start_local: Integer; const len_local: Integer): string;
                var
                    span_unit_idx_local: Integer;
                begin
                    Result := '';
                    if (start_local < 0) or (len_local <= 0) or
                        (start_local + len_local > Length(units_local)) then
                    begin
                        Exit;
                    end;

                    for span_unit_idx_local := start_local to start_local + len_local - 1 do
                    begin
                        Result := Result + units_local[span_unit_idx_local];
                    end;
                end;

                function get_exact_span_weight_for_text_local(
                    const span_start_local: Integer; const span_len_value_local: Integer;
                    const span_text_value_local: string): Integer;
                var
                    span_key_local: string;
                    span_results_local: TncCandidateList;
                    span_idx_local: Integer;
                    span_weight_local: Integer;
                begin
                    Result := 0;
                    if (span_text_value_local = '') or
                        (span_start_local < 0) or (span_len_value_local <= 0) or
                        (span_start_local + span_len_value_local >
                        syllable_count_local) then
                    begin
                        Exit;
                    end;

                    span_key_local := build_query_key_local(span_start_local,
                        span_len_value_local);
                    if (span_key_local = '') or
                        (not lookup_exact_full_pinyin_cached_local(span_key_local,
                        span_results_local)) then
                    begin
                        Exit;
                    end;

                    for span_idx_local := 0 to High(span_results_local) do
                    begin
                        if Trim(span_results_local[span_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if not SameText(Trim(span_results_local[span_idx_local].text),
                            span_text_value_local) then
                        begin
                            Continue;
                        end;

                        span_weight_local := get_exact_chunk_raw_weight_local(
                            span_results_local[span_idx_local]);
                        if span_weight_local > Result then
                        begin
                            Result := span_weight_local;
                        end;
                    end;
                end;

                function repaired_span_has_comparable_exact_support_local(
                    const protected_start_local: Integer;
                    const protected_len_local: Integer;
                    const protected_weight_local: Integer): Boolean;
                const
                    c_covering_exact_weight_slack = 120;
                    c_covering_longer_exact_weight_slack = 360;
                    c_covering_longer_exact_override_min_weight = 260;
                    c_shifted_tail_exact_weight_slack = 160;
                    c_shifted_tail_strong_weight = 900;
                    c_shifted_tail_reliable_weight = 520;
                var
                    repaired_same_span_text_local: string;
                    cover_start_local: Integer;
                    cover_len_local: Integer;
                    cover_end_local: Integer;
                    protected_end_local: Integer;
                    repaired_cover_text_local: string;
                    covering_weight_local: Integer;
                    shifted_tail_text_local: string;
                    shifted_tail_weight_local: Integer;
                    shifted_head_text_local: string;
                    shifted_head_weight_local: Integer;
                    shifted_head_tail_text_local: string;
                    shifted_head_tail_fixed_local: string;
                    expected_shift_prefix_text_local: string;
                    bridge_left_text_local: string;
                    bridge_left_weight_local: Integer;
                    covered_unit_idx_local: Integer;
                    covered_unit_weight_local: Integer;
                    covered_unit_total_weight_local: Integer;
                    covered_unit_min_weight_local: Integer;

                    function is_shift_prefix_unit_local(
                        const unit_value_local: string): Boolean;
                    begin
                        Result :=
                            SameText(unit_value_local, string(Char($7684))) or
                            SameText(unit_value_local, string(Char($5730))) or
                            SameText(unit_value_local, string(Char($5F97))) or
                            SameText(unit_value_local, string(Char($5BF9))) or
                            SameText(unit_value_local, string(Char($548C))) or
                            SameText(unit_value_local, string(Char($4E0E))) or
                            SameText(unit_value_local, string(Char($50CF)));
                    end;

                    function get_best_repaired_exact_covering_unit_weight_local(
                        const unit_idx_value_local: Integer): Integer;
                    var
                        local_cover_start: Integer;
                        local_cover_len: Integer;
                        local_cover_end: Integer;
                        local_cover_text: string;
                        local_cover_weight: Integer;
                    begin
                        Result := 0;
                        if (unit_idx_value_local < 0) or
                            (unit_idx_value_local >= syllable_count_local) then
                        begin
                            Exit;
                        end;

                        for local_cover_start := Max(0,
                            unit_idx_value_local -
                            c_max_protected_exact_span_units + 1) to
                            unit_idx_value_local do
                        begin
                            for local_cover_len := 2 to
                                Min(c_max_protected_exact_span_units,
                                syllable_count_local - local_cover_start) do
                            begin
                                local_cover_end := local_cover_start +
                                    local_cover_len;
                                if (local_cover_end <= unit_idx_value_local) or
                                    (local_cover_start > unit_idx_value_local) then
                                begin
                                    Continue;
                                end;

                                local_cover_text := build_unit_span_text_local(
                                    repaired_units_local, local_cover_start,
                                    local_cover_len);
                                local_cover_weight :=
                                    get_exact_span_weight_for_text_local(
                                    local_cover_start, local_cover_len,
                                    local_cover_text);
                                if local_cover_weight > Result then
                                begin
                                    Result := local_cover_weight;
                                end;
                            end;
                        end;
                    end;
                begin
                    Result := False;
                    repaired_same_span_text_local := build_unit_span_text_local(
                        repaired_units_local, protected_start_local,
                        protected_len_local);

                    protected_end_local := protected_start_local +
                        protected_len_local;
                    for cover_start_local := Max(0,
                        protected_start_local - c_max_protected_exact_span_units +
                        protected_len_local) to protected_start_local do
                    begin
                        for cover_len_local := protected_len_local + 1 to
                            Min(c_max_protected_exact_span_units,
                            syllable_count_local - cover_start_local) do
                        begin
                            cover_end_local := cover_start_local + cover_len_local;
                            if (cover_start_local > protected_start_local) or
                                (cover_end_local < protected_end_local) then
                            begin
                                Continue;
                            end;

                            repaired_cover_text_local := build_unit_span_text_local(
                                repaired_units_local, cover_start_local,
                                cover_len_local);
                            covering_weight_local :=
                                get_exact_span_weight_for_text_local(
                                cover_start_local, cover_len_local,
                                repaired_cover_text_local);
                            if (cover_len_local > protected_len_local) and
                                (covering_weight_local >=
                                c_covering_longer_exact_override_min_weight) then
                            begin
                                Exit(True);
                            end;
                            if (covering_weight_local > 0) and
                                (((cover_len_local > protected_len_local) and
                                (covering_weight_local +
                                c_covering_longer_exact_weight_slack >=
                                protected_weight_local)) or
                                ((cover_len_local <= protected_len_local) and
                                (covering_weight_local +
                                c_covering_exact_weight_slack >=
                                protected_weight_local))) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;

                    covered_unit_total_weight_local := 0;
                    covered_unit_min_weight_local := MaxInt;
                    for covered_unit_idx_local := protected_start_local to
                        protected_end_local - 1 do
                    begin
                        covered_unit_weight_local :=
                            get_best_repaired_exact_covering_unit_weight_local(
                            covered_unit_idx_local);
                        if covered_unit_weight_local <
                            c_covering_longer_exact_override_min_weight then
                        begin
                            covered_unit_total_weight_local := 0;
                            Break;
                        end;
                        Inc(covered_unit_total_weight_local,
                            covered_unit_weight_local);
                        covered_unit_min_weight_local := Min(
                            covered_unit_min_weight_local,
                            covered_unit_weight_local);
                    end;
                    if (covered_unit_total_weight_local > 0) and
                        (covered_unit_min_weight_local >=
                        c_covering_longer_exact_override_min_weight) and
                        ((covered_unit_total_weight_local div
                        Max(1, protected_len_local) +
                        c_covering_longer_exact_weight_slack >=
                        protected_weight_local) or
                        (covered_unit_total_weight_local >=
                        protected_weight_local)) then
                    begin
                        Exit(True);
                    end;

                    if (protected_len_local = 2) and
                        (protected_start_local > 0) and
                        (protected_start_local + 2 < syllable_count_local) then
                    begin
                        bridge_left_text_local := build_unit_span_text_local(
                            repaired_units_local, protected_start_local - 1, 2);
                        bridge_left_weight_local :=
                            get_exact_span_weight_for_text_local(
                            protected_start_local - 1, 2,
                            bridge_left_text_local);
                        shifted_tail_text_local := build_unit_span_text_local(
                            repaired_units_local, protected_start_local + 1, 2);
                        shifted_tail_weight_local :=
                            get_exact_span_weight_for_text_local(
                            protected_start_local + 1, 2,
                            shifted_tail_text_local);
                        if (bridge_left_weight_local >= 450) and
                            (shifted_tail_weight_local >=
                            c_shifted_tail_reliable_weight) and
                            ((shifted_tail_weight_local >=
                            c_shifted_tail_strong_weight) or
                            (bridge_left_weight_local + shifted_tail_weight_local +
                            c_covering_longer_exact_weight_slack >=
                            protected_weight_local)) then
                        begin
                            Exit(True);
                        end;
                    end;

                    if (protected_len_local >= 2) and
                        (protected_start_local + protected_len_local <
                        syllable_count_local) and
                        ((try_get_modifier_prefix_single_text_local(
                        effective_syllables[protected_start_local].text,
                        expected_shift_prefix_text_local) and
                        SameText(repaired_units_local[protected_start_local],
                        expected_shift_prefix_text_local)) or
                        is_shift_prefix_unit_local(
                        repaired_units_local[protected_start_local]) or
                        SameText(repaired_units_local[protected_start_local],
                        get_fixed_boundary_single_char_for_standalone_local(
                        effective_syllables[protected_start_local].text))) then
                    begin
                        shifted_tail_text_local := build_unit_span_text_local(
                            repaired_units_local, protected_start_local + 1,
                            protected_len_local);
                        shifted_tail_weight_local :=
                            get_exact_span_weight_for_text_local(
                            protected_start_local + 1, protected_len_local,
                            shifted_tail_text_local);
                        if (shifted_tail_weight_local > 0) and
                            ((shifted_tail_weight_local +
                            c_shifted_tail_exact_weight_slack >=
                            protected_weight_local) or
                            ((shifted_tail_weight_local >=
                            c_shifted_tail_strong_weight) and
                            (protected_weight_local <=
                            shifted_tail_weight_local +
                            c_covering_longer_exact_weight_slack)) or
                            (shifted_tail_weight_local >=
                            c_shifted_tail_reliable_weight)) then
                        begin
                            Exit(True);
                        end;
                    end;

                    if (protected_len_local >= 2) and
                        (protected_start_local > 0) and
                        (protected_start_local + protected_len_local <=
                        syllable_count_local) then
                    begin
                        shifted_head_text_local := build_unit_span_text_local(
                            repaired_units_local, protected_start_local - 1,
                            protected_len_local);
                        shifted_head_weight_local :=
                            get_exact_span_weight_for_text_local(
                            protected_start_local - 1, protected_len_local,
                            shifted_head_text_local);
                        shifted_head_tail_text_local :=
                            repaired_units_local[protected_start_local +
                            protected_len_local - 1];
                        shifted_head_tail_fixed_local :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[protected_start_local +
                            protected_len_local - 1].text);
                        if (shifted_head_weight_local > 0) and
                            (shifted_head_tail_fixed_local <> '') and
                            SameText(shifted_head_tail_text_local,
                            shifted_head_tail_fixed_local) and
                            ((shifted_head_weight_local +
                            c_shifted_tail_exact_weight_slack >=
                            protected_weight_local) or
                            (shifted_head_weight_local >=
                            c_shifted_tail_strong_weight) or
                            (shifted_head_weight_local >=
                            c_shifted_tail_reliable_weight)) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            begin
                Result := False;
                source_units_local := split_text_units(source_state.text);
                repaired_units_local := split_text_units(repaired_text_local);
                if (Length(source_units_local) <> syllable_count_local) or
                    (Length(repaired_units_local) <> syllable_count_local) then
                begin
                    Exit;
                end;

                for start_idx_local := 0 to syllable_count_local - 1 do
                begin
                    for span_len_local := 2 to Min(c_max_protected_exact_span_units,
                        syllable_count_local - start_idx_local) do
                    begin
                        source_span_text_local := '';
                        repaired_span_text_local := '';
                        for unit_idx_local := start_idx_local to
                            start_idx_local + span_len_local - 1 do
                        begin
                            source_span_text_local := source_span_text_local +
                                source_units_local[unit_idx_local];
                            repaired_span_text_local := repaired_span_text_local +
                                repaired_units_local[unit_idx_local];
                        end;

                        if SameText(source_span_text_local,
                            repaired_span_text_local) then
                        begin
                            Continue;
                        end;

                        query_key_local := build_query_key_local(start_idx_local,
                            span_len_local);
                        if (query_key_local = '') or
                            (not lookup_exact_full_pinyin_cached_local(
                            query_key_local, exact_results_local)) then
                        begin
                            Continue;
                        end;

                        for exact_idx_local := 0 to High(exact_results_local) do
                        begin
                            if Trim(exact_results_local[exact_idx_local].comment) <>
                                '' then
                            begin
                                Continue;
                            end;
                            if not SameText(Trim(exact_results_local[
                                exact_idx_local].text), source_span_text_local) then
                            begin
                                Continue;
                            end;

                            exact_weight_local := get_exact_chunk_raw_weight_local(
                                exact_results_local[exact_idx_local]);
                            if (exact_weight_local >=
                                c_min_protected_exact_span_weight) and
                                is_reliable_fast_exact_chunk_local(query_key_local,
                                span_len_local, source_span_text_local,
                                exact_results_local[exact_idx_local]) then
                            begin
                                if repaired_span_has_comparable_exact_support_local(
                                    start_idx_local, span_len_local,
                                    exact_weight_local) then
                                begin
                                    Continue;
                                end;
                                Exit(True);
                            end;
                        end;
                    end;
                end;
            end;

            function repaired_text_rewrites_directional_place_span_local: Boolean;
            var
                source_units_local: TArray<string>;
                repaired_units_local: TArray<string>;
                unit_idx_local: Integer;
                source_span_local: string;
                repaired_span_local: string;

                function is_place_context_unit_local(
                    const unit_value_local: string): Boolean;
                begin
                    Result := (unit_value_local = string(Char($5BB6))) or
                        (unit_value_local = string(Char($5E97))) or
                        (unit_value_local = string(Char($5C4B))) or
                        (unit_value_local = string(Char($697C))) or
                        (unit_value_local = string(Char($57CE))) or
                        (unit_value_local = string(Char($6751))) or
                        (unit_value_local = string(Char($53BF))) or
                        (unit_value_local = string(Char($5E02))) or
                        (unit_value_local = string(Char($6821))) or
                        (unit_value_local = string(Char($9662))) or
                        (unit_value_local = string(Char($5382))) or
                        (unit_value_local = string(Char($9986))) or
                        (unit_value_local = string(Char($7AD9))) or
                        (unit_value_local = string(Char($5C40))) or
                        (unit_value_local = string(Char($6240))) or
                        (unit_value_local = string(Char($56ED))) or
                        (unit_value_local = string(Char($533A))) or
                        (unit_value_local = string(Char($5708))) or
                        (unit_value_local = string(Char($8DEF))) or
                        (unit_value_local = string(Char($8857))) or
                        (unit_value_local = string(Char($95E8))) or
                        (unit_value_local = string(Char($5BA4))) or
                        (unit_value_local = string(Char($623F))) or
                        (unit_value_local = string(Char($5385))) or
                        (unit_value_local = string(Char($573A))) or
                        (unit_value_local = string(Char($53F8)));
                end;

                function has_directional_context_local(
                    const span_start_local: Integer): Boolean;
                var
                    next_key_local: string;
                begin
                    Result := False;
                    if (span_start_local <= 0) or
                        (span_start_local + 1 >= syllable_count_local) or
                        (not is_place_context_unit_local(
                        source_units_local[span_start_local - 1])) then
                    begin
                        Exit;
                    end;

                    if span_start_local + 2 >= syllable_count_local then
                    begin
                        Exit(True);
                    end;

                    next_key_local := normalize_pinyin_text(
                        effective_syllables[span_start_local + 2].text);
                    Result := SameText(next_key_local, 'de');
                end;

            begin
                Result := False;
                source_units_local := split_text_units(source_state.text);
                repaired_units_local := split_text_units(repaired_text_local);
                if (Length(source_units_local) <> syllable_count_local) or
                    (Length(repaired_units_local) <> syllable_count_local) then
                begin
                    Exit;
                end;

                for unit_idx_local := 1 to syllable_count_local - 3 do
                begin
                    if not has_directional_context_local(unit_idx_local) then
                    begin
                        Continue;
                    end;

                    source_span_local := source_units_local[unit_idx_local] +
                        source_units_local[unit_idx_local + 1];
                    repaired_span_local := repaired_units_local[unit_idx_local] +
                        repaired_units_local[unit_idx_local + 1];
                    if SameText(source_span_local, repaired_span_local) then
                    begin
                        Continue;
                    end;

                    if (get_directional_locative_span_bonus_local(
                        source_span_local) > 0) and
                        (get_directional_locative_span_bonus_local(
                        repaired_span_local) <= 0) then
                    begin
                        if m_config.debug_mode then
                        begin
                            m_last_full_path_debug_info :=
                                m_last_full_path_debug_info +
                                Format(' dirctxrepairreject=[%s>%s]',
                                [source_span_local, repaired_span_local]);
                        end;
                        Exit(True);
                    end;
                end;
            end;

            function try_get_better_exact_text_local(const query_key_local: string;
                const expected_units_local: Integer;
                const current_span_text_local: string; const min_weight_local: Integer;
                out out_text_local: string; out out_score_local: Integer): Boolean;
            var
                local_results: TncCandidateList;
                local_idx: Integer;
                candidate_text_local: string;
                candidate_score_local: Integer;
                candidate_weight_local: Integer;
                best_weight_local: Integer;
            begin
                Result := False;
                out_text_local := '';
                out_score_local := 0;
                best_weight_local := 0;
                if (query_key_local = '') or (expected_units_local < 2) or
                    (expected_units_local > 5) or
                    (current_span_text_local = '') then
                begin
                    Exit;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_local,
                    local_results) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_chain_lattice_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(local_results[local_idx].text);
                    if (candidate_text_local = '') or
                        SameText(candidate_text_local, current_span_text_local) or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        expected_units_local) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        candidate_text_local, expected_units_local)) then
                    begin
                        Continue;
                    end;

                    candidate_weight_local := get_exact_chunk_raw_weight_local(
                        local_results[local_idx]);
                    if candidate_weight_local < min_weight_local then
                    begin
                        Continue;
                    end;
                    if has_particle_tail_mismatch_local(query_key_local,
                        candidate_text_local, candidate_weight_local) then
                    begin
                        Continue;
                    end;
                    if (min_weight_local >= 260) and
                        (min_weight_local < 50000) and
                        (not is_reliable_fast_exact_chunk_local(query_key_local,
                        expected_units_local, candidate_text_local,
                        local_results[local_idx])) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := get_exact_chunk_effective_weight_local(
                        local_results[local_idx]);
                    Inc(candidate_score_local, get_preferred_query_phrase_bonus_local(
                        query_key_local, candidate_text_local));
                    Inc(candidate_score_local, get_exact_query_text_bonus_local(
                        query_key_local, candidate_text_local));
                    Inc(candidate_score_local, get_exact_chunk_semantic_bonus_local(
                        candidate_text_local));

                    if (not Result) or
                        (candidate_score_local > out_score_local) or
                        ((candidate_score_local = out_score_local) and
                        (candidate_weight_local > best_weight_local)) then
                    begin
                        Result := True;
                        out_text_local := candidate_text_local;
                        out_score_local := candidate_score_local;
                        best_weight_local := candidate_weight_local;
                    end;
                end;
            end;

            function try_get_best_exact_text_local(const query_key_local: string;
                const expected_units_local: Integer; const min_weight_local: Integer;
                out out_text_local: string; out out_score_local: Integer): Boolean;
            var
                local_results: TncCandidateList;
                local_idx: Integer;
                candidate_text_local: string;
                candidate_score_local: Integer;
                candidate_weight_local: Integer;
                best_weight_local: Integer;
            begin
                Result := False;
                out_text_local := '';
                out_score_local := 0;
                best_weight_local := 0;
                if (query_key_local = '') or (expected_units_local < 2) or
                    (expected_units_local > 3) then
                begin
                    Exit;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_local,
                    local_results) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_chain_lattice_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(local_results[local_idx].text);
                    if (candidate_text_local = '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        expected_units_local) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        candidate_text_local, expected_units_local)) then
                    begin
                        Continue;
                    end;

                    candidate_weight_local := get_exact_chunk_raw_weight_local(
                        local_results[local_idx]);
                    if candidate_weight_local < min_weight_local then
                    begin
                        Continue;
                    end;
                    if has_particle_tail_mismatch_local(query_key_local,
                        candidate_text_local, candidate_weight_local) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := get_exact_chunk_effective_weight_local(
                        local_results[local_idx]);
                    Inc(candidate_score_local, get_preferred_query_phrase_bonus_local(
                        query_key_local, candidate_text_local));
                    Inc(candidate_score_local, get_exact_query_text_bonus_local(
                        query_key_local, candidate_text_local));
                    Inc(candidate_score_local, get_exact_chunk_semantic_bonus_local(
                        candidate_text_local));

                    if (not Result) or
                        (candidate_score_local > out_score_local) or
                        ((candidate_score_local = out_score_local) and
                        (candidate_weight_local > best_weight_local)) then
                    begin
                        Result := True;
                        out_text_local := candidate_text_local;
                        out_score_local := candidate_score_local;
                        best_weight_local := candidate_weight_local;
                    end;
                end;
            end;

            function try_get_top_exact_text_local(const query_key_local: string;
                const expected_units_local: Integer; const min_weight_local: Integer;
                out out_text_local: string; out out_score_local: Integer): Boolean;
            var
