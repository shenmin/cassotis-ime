    function build_two_syllable_single_head_prefix_partial_candidates_local(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_single_limit = c_candidate_total_limit_max;
        c_prefix_remaining_penalty = 40;
    var
        parser_local: TncPinyinParser;
        parsed_local: TncPinyinParseResult;
        exact_query_results_local: TncCandidateList;
        head_key_local: string;
        tail_key_local: string;
        head_results_local: TncCandidateList;
        result_idx_local: Integer;
        accepted_count_local: Integer;
        candidate_local: TncCandidate;
        candidate_text_local: string;
        base_score_local: Integer;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        if (m_dictionary = nil) or (query_text = '') then
        begin
            Exit;
        end;
        if lookup_exact_full_pinyin_cached_local(query_text,
            exact_query_results_local) then
        begin
            for result_idx_local := 0 to High(exact_query_results_local) do
            begin
                if Trim(exact_query_results_local[result_idx_local].comment) = '' then
                begin
                    Exit;
                end;
            end;
        end;

        head_key_local := '';
        tail_key_local := '';
        parser_local := TncPinyinParser.Create;
        try
            parsed_local := parser_local.parse(query_text);
            if Length(parsed_local) = 2 then
            begin
                head_key_local := normalize_pinyin_text(parsed_local[0].text);
                tail_key_local := normalize_pinyin_text(parsed_local[1].text);
            end
            else if (Length(parsed_local) = 1) and
                try_split_relaxed_missing_apostrophe_token(parser_local,
                query_text, head_key_local, tail_key_local) then
            begin
                head_key_local := normalize_pinyin_text(head_key_local);
                tail_key_local := normalize_pinyin_text(tail_key_local);
            end;
        finally
            parser_local.Free;
        end;

        if (head_key_local = '') or (tail_key_local = '') or
            (not is_full_pinyin_key(head_key_local)) or
            ((not is_full_pinyin_key(tail_key_local)) and
            (not is_relaxed_no_initial_syllable_text(tail_key_local))) then
        begin
            Exit;
        end;

        if not lookup_exact_full_pinyin_cached_local(head_key_local,
            head_results_local) then
        begin
            Exit;
        end;

        accepted_count_local := 0;
        for result_idx_local := 0 to High(head_results_local) do
        begin
            if accepted_count_local >= c_prefix_single_limit then
            begin
                Break;
            end;
            if Trim(head_results_local[result_idx_local].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(head_results_local[result_idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <> 1) then
            begin
                Continue;
            end;

            candidate_local := head_results_local[result_idx_local];
            candidate_local.text := candidate_text_local;
            candidate_local.comment := tail_key_local;
            base_score_local := candidate_local.score;
            if candidate_local.has_dict_weight and
                (candidate_local.dict_weight > base_score_local) then
            begin
                base_score_local := candidate_local.dict_weight;
            end;
            candidate_local.score := base_score_local -
                c_prefix_remaining_penalty;
            candidate_local.dict_weight := base_score_local;
            candidate_local.has_dict_weight := True;

            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate_local;
            Inc(accepted_count_local);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

