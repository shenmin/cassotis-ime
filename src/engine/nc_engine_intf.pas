            function is_structural_prefix_tail_shift_text_local(
                const prefix_text_value_local: string): Boolean;
            begin
                Result :=
                    SameText(prefix_text_value_local, string(Char($7684))) or
                    SameText(prefix_text_value_local, string(Char($5730))) or
                    SameText(prefix_text_value_local, string(Char($5F97))) or
                    SameText(prefix_text_value_local, string(Char($5BF9))) or
                    SameText(prefix_text_value_local, string(Char($548C))) or
                    SameText(prefix_text_value_local, string(Char($4E0E))) or
                    SameText(prefix_text_value_local, string(Char($50CF)));
            end;

            function try_repair_prefix_tail_exact_shift_local(
                const segment_query_offset_local: Integer;
                const total_units_local: Integer; const current_text_local: string;
                out out_text_local: string; out out_path_local: string): Boolean;
            const
                c_min_tail_exact_weight = 500;
                c_min_fixed_prefix_tail_exact_weight = 800;
            var
                prefix_text_local: string;
                prefix_key_local: string;
                tail_key_local: string;
                tail_results_local: TncCandidateList;
                tail_idx_local: Integer;
                tail_text_local: string;
                tail_score_local: Integer;
                tail_weight_local: Integer;
                best_tail_text_local: string;
                best_tail_score_local: Integer;
                tail_units_local: TArray<string>;
                preferred_tail_head_local: string;
                fixed_tail_text_local: string;
                fixed_tail_path_local: string;
                prefix_is_de_particle_local: Boolean;
                prefix_is_connector_local: Boolean;
                prefix_is_fixed_boundary_local: Boolean;
                current_units_local: TArray<string>;
                current_tail_text_local: string;

                function current_tail_has_exact_support_local: Boolean;
                var
                    support_idx_local: Integer;
                    support_text_local: string;
                    support_weight_local: Integer;
                begin
                    Result := False;
                    if (current_tail_text_local = '') or
                        (Length(tail_results_local) = 0) then
                    begin
                        Exit;
                    end;

                    for support_idx_local := 0 to High(tail_results_local) do
                    begin
                        support_text_local := Trim(
                            tail_results_local[support_idx_local].text);
                        if not SameText(support_text_local,
                            current_tail_text_local) then
                        begin
                            Continue;
                        end;

                        support_weight_local := get_exact_chunk_raw_weight_local(
                            tail_results_local[support_idx_local]);
                        if support_weight_local > 0 then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            begin
                Result := False;
                out_text_local := '';
                out_path_local := '';
                if (segment_query_offset_local < 0) or
                    (total_units_local < 3) or (total_units_local > 4) or
                    (segment_query_offset_local + total_units_local >
                    syllable_count_local) or (current_text_local = '') then
                begin
                    Exit;
                end;

                prefix_is_fixed_boundary_local := False;
                prefix_key_local := normalize_pinyin_text(
                    effective_syllables[segment_query_offset_local].text);
                if try_get_modifier_prefix_single_text_local(
                    effective_syllables[segment_query_offset_local].text,
                    prefix_text_local) then
                begin
                    if not is_structural_prefix_tail_shift_text_local(
                        prefix_text_local) then
                    begin
                        Exit;
                    end;
                end
                else
                begin
                    prefix_text_local := get_covering_fixed_single_text_local(
                        prefix_key_local);
                    if prefix_text_local = '' then
                    begin
                        Exit;
                    end;
                    prefix_is_fixed_boundary_local := True;
                end;
                prefix_is_de_particle_local :=
                    SameText(prefix_text_local, string(Char($7684))) or
                    SameText(prefix_text_local, string(Char($5730))) or
                    SameText(prefix_text_local, string(Char($5F97)));
                prefix_is_connector_local :=
                    SameText(prefix_text_local, string(Char($548C))) or
                    SameText(prefix_text_local, string(Char($4E0E)));

                tail_key_local := build_query_key_local(
                    segment_query_offset_local + 1, 2);
                if (tail_key_local = '') or
                    (not lookup_exact_full_pinyin_cached_local(tail_key_local,
                    tail_results_local)) then
                begin
                    Exit;
                end;
                if prefix_is_fixed_boundary_local then
                begin
                    current_units_local := split_text_units(current_text_local);
                    if Length(current_units_local) >= 3 then
                    begin
                        current_tail_text_local := current_units_local[1] +
                            current_units_local[2];
                    end
                    else
                    begin
                        current_tail_text_local := '';
                    end;
                    if current_tail_has_exact_support_local then
                    begin
                        Exit;
                    end;
                end;

                best_tail_text_local := '';
                best_tail_score_local := Low(Integer);
                for tail_idx_local := 0 to High(tail_results_local) do
                begin
                    if tail_idx_local >= c_chain_lattice_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                    if (tail_text_local = '') or
                        (get_candidate_text_unit_count(tail_text_local) <> 2) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        tail_text_local, 2)) then
                    begin
                        Continue;
                    end;

                    tail_weight_local := get_exact_chunk_raw_weight_local(
                        tail_results_local[tail_idx_local]);
                    if (tail_weight_local < c_min_tail_exact_weight) or
                        has_particle_tail_mismatch_local(tail_key_local,
                        tail_text_local, tail_weight_local) then
                    begin
                        Continue;
                    end;
                    if prefix_is_fixed_boundary_local and
                        (tail_weight_local <
                        c_min_fixed_prefix_tail_exact_weight) then
                    begin
                        Continue;
                    end;

                    tail_score_local := get_exact_chunk_effective_weight_local(
                        tail_results_local[tail_idx_local]);
                    tail_units_local := split_text_units(tail_text_local);
                    preferred_tail_head_local :=
                        get_fixed_boundary_single_char_for_standalone_local(
                        effective_syllables[segment_query_offset_local + 1].text);
                    if prefix_is_de_particle_local and
                        ((preferred_tail_head_local = '') or
                        (not SameText(tail_units_local[0],
                        preferred_tail_head_local))) then
                    begin
                        Continue;
                    end;
                    if prefix_is_connector_local and
                        (SameText(tail_units_local[1], string(Char($7684))) or
                        SameText(tail_units_local[1], string(Char($5730))) or
                        SameText(tail_units_local[1], string(Char($5F97)))) then
                    begin
                        Continue;
                    end;
                    if (Length(tail_units_local) = 2) and
                        (preferred_tail_head_local <> '') and
                        prefix_is_de_particle_local and
                        SameText(tail_units_local[0], preferred_tail_head_local) then
                    begin
                        Inc(tail_score_local, 640);
                    end;

                    if (best_tail_text_local = '') or
                        (tail_score_local > best_tail_score_local) then
                    begin
                        best_tail_text_local := tail_text_local;
                        best_tail_score_local := tail_score_local;
                    end;
                end;

                if best_tail_text_local = '' then
                begin
                    Exit;
                end;

                out_text_local := prefix_text_local + best_tail_text_local;
                out_path_local := prefix_text_local + c_segment_path_separator +
                    best_tail_text_local;

                if total_units_local = 4 then
                begin
                    if (not try_get_fixed_single_text_at_local(
                        segment_query_offset_local + 3, fixed_tail_text_local)) and
                        (not try_get_particle_tail_text_at_local(
                        segment_query_offset_local + 3, fixed_tail_text_local)) then
                    begin
                        Exit(False);
                    end;
                    if fixed_tail_text_local = '' then
                    begin
                        Exit(False);
                    end;
                    out_text_local := out_text_local + fixed_tail_text_local;
                    fixed_tail_path_local := fixed_tail_text_local;
                    out_path_local := out_path_local + c_segment_path_separator +
                        fixed_tail_path_local;
                end;

                Result := (out_text_local <> '') and
                    (not SameText(out_text_local, current_text_local));
            end;

            function try_repair_text_prefix_tail_shifts_local(
                const source_text_local: string; out out_text_local: string;
                out out_path_local: string): Boolean;
            var
                source_units_local: TArray<string>;
                unit_idx_local: Integer;
                current_window_local: string;
                repaired_window_text_local: string;
                repaired_window_path_local: string;

                procedure append_segment_local(const segment_text_local: string;
                    const segment_path_local: string);
                begin
                    if segment_text_local = '' then
                    begin
                        Exit;
                    end;
                    out_text_local := out_text_local + segment_text_local;
                    if out_path_local <> '' then
                    begin
                        out_path_local := out_path_local +
                            c_segment_path_separator;
                    end;
                    if segment_path_local <> '' then
                    begin
                        out_path_local := out_path_local + segment_path_local;
                    end
                    else
                    begin
                        out_path_local := out_path_local + segment_text_local;
                    end;
                end;

            begin
                Result := False;
                out_text_local := '';
                out_path_local := '';
                source_units_local := split_text_units(source_text_local);
                if Length(source_units_local) <> syllable_count_local then
                begin
                    Exit;
                end;

                unit_idx_local := 0;
                while unit_idx_local < Length(source_units_local) do
                begin
                    if unit_idx_local + 4 <= Length(source_units_local) then
                    begin
                        current_window_local := source_units_local[unit_idx_local] +
                            source_units_local[unit_idx_local + 1] +
                            source_units_local[unit_idx_local + 2] +
                            source_units_local[unit_idx_local + 3];
                        if try_repair_prefix_tail_exact_shift_local(unit_idx_local,
                            4, current_window_local, repaired_window_text_local,
                            repaired_window_path_local) then
                        begin
                            append_segment_local(repaired_window_text_local,
                                repaired_window_path_local);
                            Inc(unit_idx_local, 4);
                            Result := True;
                            Continue;
                        end;
                    end;

                    if unit_idx_local + 3 <= Length(source_units_local) then
                    begin
                        current_window_local := source_units_local[unit_idx_local] +
                            source_units_local[unit_idx_local + 1] +
                            source_units_local[unit_idx_local + 2];
                        if try_repair_prefix_tail_exact_shift_local(unit_idx_local,
                            3, current_window_local, repaired_window_text_local,
                            repaired_window_path_local) then
                        begin
                            append_segment_local(repaired_window_text_local,
                                repaired_window_path_local);
                            Inc(unit_idx_local, 3);
                            Result := True;
                            Continue;
                        end;
                    end;

                    append_segment_local(source_units_local[unit_idx_local],
                        source_units_local[unit_idx_local]);
                    Inc(unit_idx_local);
                end;
            end;

            function try_repair_incremental_tail_prefix_shift_local(
                out out_text_local: string; out out_path_local: string): Boolean;
            const
                c_tail_units = 3;
            var
                source_units_local: TArray<string>;
                source_path_segments_local: TArray<string>;
                segment_idx_local: Integer;
                segment_text_local: string;
                segment_units_local: Integer;
                path_offset_local: Integer;
                tail_start_local: Integer;
                suffix_segment_count_local: Integer;
                prefix_text_local: string;
                prefix_path_local: string;
                current_tail_text_local: string;
                repaired_tail_text_local: string;
                repaired_tail_path_local: string;
                particle_text_local: string;
                tail_exact_key_local: string;
                tail_exact_score_local: Integer;
                unit_idx_local: Integer;
            begin
                Result := False;
                out_text_local := '';
                out_path_local := '';
                source_units_local := split_text_units(Trim(source_state.text));
                if (Length(source_units_local) <> syllable_count_local) or
                    (Length(source_units_local) < c_tail_units) or
                    (Trim(source_state.path) = '') then
                begin
                    Exit;
                end;

                tail_start_local := Length(source_units_local) - c_tail_units;
                source_path_segments_local := source_state.path.Split(
                    [c_segment_path_separator]);
                path_offset_local := 0;
                suffix_segment_count_local := 0;
                prefix_path_local := '';
                for segment_idx_local := 0 to High(source_path_segments_local) do
                begin
                    segment_text_local := Trim(
                        source_path_segments_local[segment_idx_local]);
                    segment_units_local := get_candidate_text_unit_count(
                        segment_text_local);
                    if (segment_text_local = '') or (segment_units_local <= 0) or
                        (path_offset_local + segment_units_local >
                        Length(source_units_local)) then
                    begin
                        Exit(False);
                    end;

                    if path_offset_local < tail_start_local then
                    begin
                        { Incremental repair must not cut through an existing
                          exact segment. It only reconsiders the final boundary. }
                        if path_offset_local + segment_units_local >
                            tail_start_local then
                        begin
                            Exit(False);
                        end;
                        if prefix_path_local <> '' then
                        begin
                            prefix_path_local := prefix_path_local +
                                c_segment_path_separator;
                        end;
                        prefix_path_local := prefix_path_local + segment_text_local;
                    end
                    else
                    begin
                        Inc(suffix_segment_count_local);
                    end;
                    Inc(path_offset_local, segment_units_local);
                end;

                if (path_offset_local <> Length(source_units_local)) or
                    (suffix_segment_count_local < 2) then
                begin
                    Exit;
                end;

                prefix_text_local := '';
                for unit_idx_local := 0 to tail_start_local - 1 do
                begin
                    prefix_text_local := prefix_text_local +
                        source_units_local[unit_idx_local];
                end;
                current_tail_text_local := '';
                for unit_idx_local := tail_start_local to
                    High(source_units_local) do
                begin
                    current_tail_text_local := current_tail_text_local +
                        source_units_local[unit_idx_local];
                end;

                if not try_get_particle_tail_text_at_local(tail_start_local,
                    particle_text_local) then
                begin
                    Exit;
                end;
                tail_exact_key_local := build_query_key_local(
                    tail_start_local + 1, 2);
                if (tail_exact_key_local = '') or
                    (not try_get_best_exact_text_local(tail_exact_key_local, 2,
                    500, repaired_tail_text_local,
                    tail_exact_score_local)) then
                begin
                    Exit;
                end;
                repaired_tail_path_local := particle_text_local +
                    c_segment_path_separator + repaired_tail_text_local;
                repaired_tail_text_local := particle_text_local +
                    repaired_tail_text_local;
                if SameText(repaired_tail_text_local,
                    current_tail_text_local) then
                begin
                    Exit;
                end;

                out_text_local := prefix_text_local + repaired_tail_text_local;
                out_path_local := prefix_path_local;
                if (out_path_local <> '') and (repaired_tail_path_local <> '') then
                begin
                    out_path_local := out_path_local + c_segment_path_separator;
                end;
                out_path_local := out_path_local + repaired_tail_path_local;
                Result := (out_text_local <> '') and
                    (not SameText(out_text_local, source_state.text)) and
                    (get_candidate_text_unit_count(out_text_local) =
                    syllable_count_local);
            end;

            function try_repair_text_exact_span_splits_local(
                const source_text_local: string; const source_path_local: string;
                out out_text_local: string; out out_path_local: string): Boolean;
            var
                source_units_local: TArray<string>;
                path_segments_for_repair_local: TArray<string>;
                unit_idx_local: Integer;
                span_len_local: Integer;
                current_span_text_local: string;
                exact_text_local: string;
                span_repaired_local: Boolean;

                procedure append_segment_local(const segment_text_local: string);
                begin
                    if segment_text_local = '' then
                    begin
                        Exit;
                    end;
                    out_text_local := out_text_local + segment_text_local;
                    if out_path_local <> '' then
                    begin
                        out_path_local := out_path_local +
                            c_segment_path_separator;
                    end;
                    out_path_local := out_path_local + segment_text_local;
                end;

                function is_stable_sentence_single_unit_local(
                    const syllable_key_local: string;
                    const unit_text_local: string): Boolean;
                var
                    fixed_text_local: string;
                    modifier_text_local: string;
                begin
                    Result := False;
                    if (syllable_key_local = '') or
                        (get_candidate_text_unit_count(unit_text_local) <> 1) then
                    begin
                        Exit;
                    end;

                    fixed_text_local := get_covering_fixed_single_text_local(
                        syllable_key_local);
                    if (fixed_text_local <> '') and
                        SameText(fixed_text_local, unit_text_local) then
                    begin
                        Exit(True);
                    end;

                    if try_get_modifier_prefix_single_text_local(
                        syllable_key_local, modifier_text_local) and
                        SameText(modifier_text_local, unit_text_local) then
                    begin
                        Exit(True);
                    end;
                end;

                function span_crosses_repairable_path_boundary_local(
                    const span_start_local: Integer;
                    const span_len_value_local: Integer): Boolean;
                var
                    span_end_local: Integer;
                    path_idx_local: Integer;
                    path_offset_local: Integer;
                    path_units_local: Integer;
                    path_end_local: Integer;
                    covered_count_local: Integer;
                    has_multichar_segment_local: Boolean;
                    all_stable_single_segments_local: Boolean;
                    segment_text_local: string;
                    segment_key_local: string;
                    segment_exact_text_local: string;
                    segment_exact_score_local: Integer;
                    segment_units_local: TArray<string>;
                    span_key_local: string;
                    span_text_local: string;
                    span_has_exact_override_local: Boolean;
                    span_exact_text_local: string;
                    span_exact_score_local: Integer;

                    function span_exact_override_allows_current_boundary_local:
                        Boolean;
                    begin
                        Result := span_has_exact_override_local and
                            ((covered_count_local > 0) or
                            (path_end_local < span_end_local));
                    end;
                begin
                    Result := False;
                    if Trim(source_path_local) = '' then
                    begin
                        Exit;
                    end;

                    span_end_local := span_start_local + span_len_value_local;
                    span_key_local := build_query_key_local(span_start_local,
                        span_len_value_local);
                    span_text_local := '';
                    for path_idx_local := span_start_local to
                        span_start_local + span_len_value_local - 1 do
                    begin
                        span_text_local := span_text_local +
                            source_units_local[path_idx_local];
                    end;
                    span_has_exact_override_local :=
                        (span_len_value_local >= 3) and
                        try_get_better_exact_text_local(span_key_local,
                        span_len_value_local, span_text_local, 260,
                        span_exact_text_local, span_exact_score_local);

                    path_offset_local := 0;
                    covered_count_local := 0;
                    has_multichar_segment_local := False;
                    all_stable_single_segments_local := True;
                    for path_idx_local := 0 to High(path_segments_for_repair_local) do
                    begin
                        segment_text_local := Trim(
                            path_segments_for_repair_local[path_idx_local]);
                        path_units_local := get_candidate_text_unit_count(
                            segment_text_local);
                        if path_units_local <= 0 then
                        begin
                            Exit(False);
                        end;

                        path_end_local := path_offset_local + path_units_local;
                        if (path_offset_local < span_end_local) and
                            (path_end_local > span_start_local) then
                        begin
                            if (path_units_local >= 2) and
                                ((span_start_local > path_offset_local) or
                                (span_end_local < path_end_local)) then
                            begin
                                if path_units_local <= 3 then
                                begin
                                    segment_key_local := build_query_key_local(
                                        path_offset_local, path_units_local);
                                    if try_get_best_exact_text_local(
                                        segment_key_local, path_units_local,
                                        c_min_covering_pair_exact_weight,
                                        segment_exact_text_local,
                                        segment_exact_score_local) and
                                        SameText(segment_exact_text_local,
                                        segment_text_local) then
                                    begin
                                        if not span_exact_override_allows_current_boundary_local then
                                        begin
                                            Exit(False);
                                        end;
                                    end;
                                end;

                                if not ((span_start_local = path_offset_local + 1) and
                                    (span_end_local >= path_end_local) and
                                    (Length(split_text_units(segment_text_local)) =
                                    path_units_local)) then
                                begin
                                    if not span_exact_override_allows_current_boundary_local then
                                    begin
                                        Exit(False);
                                    end;
                                end;

                                if not span_exact_override_allows_current_boundary_local then
                                begin
                                    segment_units_local := split_text_units(
                                        segment_text_local);
                                    segment_key_local := build_query_key_local(
                                        path_offset_local, 1);
                                    if (Length(segment_units_local) = 0) or
                                        (not is_stable_sentence_single_unit_local(
                                        segment_key_local,
                                        segment_units_local[0])) then
                                    begin
                                        Exit(False);
                                    end;
                                end;
                            end;

                            Inc(covered_count_local);
                            if path_units_local >= 2 then
                            begin
                                has_multichar_segment_local := True;
                                all_stable_single_segments_local := False;
                            end
                            else
                            begin
                                segment_key_local := build_query_key_local(
                                    path_offset_local, 1);
                                if not is_stable_sentence_single_unit_local(
                                    segment_key_local, segment_text_local) then
                                begin
                                    all_stable_single_segments_local := False;
                                end;
                            end;
                        end;

                        path_offset_local := path_end_local;
                        if path_offset_local >= span_end_local then
                        begin
                            Break;
                        end;
                    end;

                    if covered_count_local < 2 then
                    begin
                        Exit(False);
                    end;

                    if (not has_multichar_segment_local) and
                        all_stable_single_segments_local and
                        (span_len_value_local >= 3) then
                    begin
                        if span_has_exact_override_local then
                        begin
                            Exit(True);
                        end;
                    end;

                    Result := has_multichar_segment_local or
                        (not all_stable_single_segments_local);
                end;

                function current_span_is_backed_path_segment_local(
                    const start_unit_idx_local: Integer;
                    const span_len_value_local: Integer;
                    const span_text_local: string): Boolean;
                var
                    local_path_idx: Integer;
                    local_path_offset: Integer;
                    local_segment_text: string;
                    local_segment_units: Integer;
                begin
                    Result := False;
                    if span_len_value_local <= 1 then
                    begin
                        Exit;
                    end;

                    local_path_offset := 0;
                    for local_path_idx := 0 to
                        High(path_segments_for_repair_local) do
                    begin
                        local_segment_text := Trim(
                            path_segments_for_repair_local[local_path_idx]);
                        local_segment_units := get_candidate_text_unit_count(
                            local_segment_text);
                        if local_segment_units <= 0 then
                        begin
                            Exit(False);
                        end;

                        if local_path_offset = start_unit_idx_local then
                        begin
                            if (local_segment_units = span_len_value_local) and
                                SameText(local_segment_text, span_text_local) then
                            begin
                                Result := True;
                            end;
                            Exit;
                        end;

                        Inc(local_path_offset, local_segment_units);
                        if local_path_offset > start_unit_idx_local then
                        begin
                            Exit;
                        end;
                    end;
                end;

                function try_find_exact_span_repair_at_unit_local(
                    const start_unit_idx_local: Integer;
                    const emit_debug_local: Boolean;
                    out out_span_len_local: Integer;
                    out out_exact_text_local: string): Boolean;
                var
                    probe_span_len_local: Integer;
                    probe_unit_idx_local: Integer;
                    probe_current_span_text_local: string;
                    probe_exact_key_local: string;
                    probe_exact_score_local: Integer;
                begin
                    Result := False;
                    out_span_len_local := 0;
                    out_exact_text_local := '';

                    for probe_span_len_local := Min(5,
                        Length(source_units_local) - start_unit_idx_local)
                        downto 2 do
                    begin
                        probe_current_span_text_local := '';
                        for probe_unit_idx_local := start_unit_idx_local to
                            start_unit_idx_local + probe_span_len_local - 1 do
                        begin
                            probe_current_span_text_local :=
                                probe_current_span_text_local +
                                source_units_local[probe_unit_idx_local];
                        end;

                        probe_exact_key_local := build_query_key_local(
                            start_unit_idx_local, probe_span_len_local);
                        if current_span_is_backed_path_segment_local(
                            start_unit_idx_local, probe_span_len_local,
                            probe_current_span_text_local) then
                        begin
                            Continue;
                        end;
                        if not span_crosses_repairable_path_boundary_local(
                            start_unit_idx_local, probe_span_len_local) then
                        begin
                            Continue;
                        end;
                        if try_get_better_exact_text_local(probe_exact_key_local,
                            probe_span_len_local, probe_current_span_text_local,
                            IfThen(probe_span_len_local >= 4, 700,
                            c_min_covering_pair_exact_weight),
                            out_exact_text_local, probe_exact_score_local) then
                        begin
                            out_span_len_local := probe_span_len_local;
                            Exit(True);
                        end;
                    end;
                end;

                function get_path_segment_starting_at_unit_local(
                    const start_unit_idx_local: Integer;
                    out out_segment_text_local: string;
                    out out_segment_units_local: Integer): Boolean;
                var
                    local_path_idx: Integer;
                    local_path_offset: Integer;
                    local_segment_text: string;
                    local_segment_units: Integer;
                begin
                    Result := False;
                    out_segment_text_local := '';
                    out_segment_units_local := 0;
                    local_path_offset := 0;
                    for local_path_idx := 0 to
                        High(path_segments_for_repair_local) do
                    begin
                        local_segment_text := Trim(
                            path_segments_for_repair_local[local_path_idx]);
                        local_segment_units :=
                            get_candidate_text_unit_count(local_segment_text);
                        if local_segment_units <= 0 then
                        begin
                            Exit(False);
                        end;
                        if local_path_offset = start_unit_idx_local then
                        begin
                            out_segment_text_local := local_segment_text;
                            out_segment_units_local := local_segment_units;
                            Exit(True);
                        end;
                        Inc(local_path_offset, local_segment_units);
                        if local_path_offset > start_unit_idx_local then
                        begin
                            Exit(False);
                        end;
                    end;
                end;

                function has_repair_start_inside_segment_local(
                    const segment_start_unit_local: Integer;
                    const segment_units_local: Integer): Boolean;
                var
                    scan_unit_idx_local: Integer;
                    ignored_span_len_local: Integer;
                    ignored_exact_text_local: string;
                begin
                    Result := False;
                    if segment_units_local <= 1 then
                    begin
                        Exit;
                    end;
                    for scan_unit_idx_local := segment_start_unit_local + 1 to
                        segment_start_unit_local + segment_units_local - 1 do
                    begin
                        if try_find_exact_span_repair_at_unit_local(
                            scan_unit_idx_local, False, ignored_span_len_local,
                            ignored_exact_text_local) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

            begin
                Result := False;
                out_text_local := '';
                out_path_local := '';
                source_units_local := split_text_units(source_text_local);
                if Length(source_units_local) <> syllable_count_local then
                begin
                    Exit;
                end;
                path_segments_for_repair_local := source_path_local.Split(
                    [c_segment_path_separator]);

                unit_idx_local := 0;
                while unit_idx_local < Length(source_units_local) do
                begin
                    span_repaired_local := False;
                    if try_find_exact_span_repair_at_unit_local(unit_idx_local,
                        True, span_len_local, exact_text_local) then
                    begin
                        append_segment_local(exact_text_local);
                        Inc(unit_idx_local, span_len_local);
                        span_repaired_local := True;
                        Result := True;
                    end;

                    if span_repaired_local then
                    begin
                        Continue;
                    end;

                    if get_path_segment_starting_at_unit_local(unit_idx_local,
                        current_span_text_local, span_len_local) and
                        (span_len_local > 1) and
                        (not has_repair_start_inside_segment_local(
                        unit_idx_local, span_len_local)) then
                    begin
                        append_segment_local(current_span_text_local);
                        Inc(unit_idx_local, span_len_local);
                        Continue;
                    end;

                    append_segment_local(source_units_local[unit_idx_local]);
                    Inc(unit_idx_local);
                end;
            end;

        begin
            Result := False;
            repaired_state := source_state;
            if source_state.text = '' then
            begin
                Exit;
            end;

            if incremental_tail_only then
            begin
                if not try_repair_incremental_tail_prefix_shift_local(
                    repaired_text_local, repaired_path_local) then
                begin
                    Exit;
                end;
                if repaired_text_rewrites_directional_place_span_local or
                    repaired_text_rewrites_protected_source_exact_span_local then
                begin
                    Exit;
                end;

                repaired_state.text := repaired_text_local;
                repaired_state.path := repaired_path_local;
                repaired_state.score := source_state.score + c_repair_bonus;
                repaired_state.segments := Max(1,
                    get_encoded_path_segment_count_local(repaired_path_local));
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xfasttailrepair=[%s>%s]',
                        [source_state.text, repaired_state.text]);
                end;
                Exit(True);
            end;

            if (source_state.path <> '') and
                try_repair_text_exact_span_splits_local(source_state.text,
                source_state.path, repaired_text_local,
                repaired_path_local) and
                (not SameText(repaired_text_local, source_state.text)) then
            begin
                chained_repaired_text_local := '';
                chained_repaired_path_local := '';
                if try_repair_text_prefix_tail_shifts_local(repaired_text_local,
                    chained_repaired_text_local, chained_repaired_path_local) and
                    (not SameText(chained_repaired_text_local,
                    repaired_text_local)) then
                begin
                    repaired_text_local := chained_repaired_text_local;
                    repaired_path_local := chained_repaired_path_local;
                end;

                if (not repaired_text_rewrites_directional_place_span_local) and
                    (not repaired_text_rewrites_protected_source_exact_span_local) then
                begin
                    repaired_state := source_state;
                    repaired_state.text := repaired_text_local;
                    repaired_state.path := repaired_path_local;
                    repaired_state.score := source_state.score + c_repair_bonus;
                    repaired_state.segments := Max(1, source_state.segments - 1);
                    Result := True;
                    Exit;
                end;
            end;

            if try_repair_text_prefix_tail_shifts_local(source_state.text,
                repaired_text_local, repaired_path_local) and
                (not SameText(repaired_text_local, source_state.text)) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xprefshift=[%s>%s]',
                        [source_state.text, repaired_text_local]);
                end;
                chained_repaired_text_local := '';
                chained_repaired_path_local := '';
                if try_repair_text_exact_span_splits_local(repaired_text_local,
                    repaired_path_local, chained_repaired_text_local,
                    chained_repaired_path_local) and
                    (not SameText(chained_repaired_text_local,
                    repaired_text_local)) then
                begin
                    repaired_text_local := chained_repaired_text_local;
                    repaired_path_local := chained_repaired_path_local;
                end;

                if (not repaired_text_rewrites_directional_place_span_local) and
                    (not repaired_text_rewrites_protected_source_exact_span_local) then
                begin
                    repaired_state := source_state;
                    repaired_state.text := repaired_text_local;
                    repaired_state.path := repaired_path_local;
                    repaired_state.score := source_state.score + c_repair_bonus;
                    repaired_state.segments := Max(1, source_state.segments - 1);
                    Result := True;
                    Exit;
                end;
            end;

            if source_state.path = '' then
            begin
                Exit;
            end;

            path_segments_local := source_state.path.Split(
                [c_segment_path_separator]);
            if Length(path_segments_local) < 2 then
            begin
                Exit;
            end;

            query_offset_local := 0;
            repair_count_local := 0;
            repair_probe_budget_local := 8;
            repaired_text_local := '';
            repaired_path_local := '';
            repair_used_prefix_tail_shift_local := False;
            repair_used_boundary_shift_local := False;
            segment_idx_local := 0;
            while segment_idx_local <= High(path_segments_local) do
            begin
                current_text_local := Trim(path_segments_local[segment_idx_local]);
                current_units_local := get_candidate_text_unit_count(
                    current_text_local);
                if (current_text_local = '') or (current_units_local <= 0) or
                    (query_offset_local + current_units_local >
                    syllable_count_local) then
                begin
                    Exit(False);
                end;

                if try_repair_quantity_fixed_segment_local(query_offset_local,
                    current_units_local, current_text_local,
                    best_exact_text_local, combined_text_local) then
                begin
                    repaired_text_local := repaired_text_local +
                        best_exact_text_local;
                    if repaired_path_local <> '' then
                    begin
                        repaired_path_local := repaired_path_local +
                            c_segment_path_separator;
                    end;
                    repaired_path_local := repaired_path_local +
                        combined_text_local;
                    Inc(query_offset_local, current_units_local);
                    Inc(segment_idx_local);
                    Inc(repair_count_local);
                    Continue;
                end;

                if try_repair_particle_tail_segment_local(query_offset_local,
                    current_units_local, current_text_local,
                    best_exact_text_local, combined_text_local) then
                begin
                    repaired_text_local := repaired_text_local +
                        best_exact_text_local;
                    if repaired_path_local <> '' then
                    begin
                        repaired_path_local := repaired_path_local +
                            c_segment_path_separator;
                    end;
                    repaired_path_local := repaired_path_local +
                        combined_text_local;
                    Inc(query_offset_local, current_units_local);
                    Inc(segment_idx_local);
                    Inc(repair_count_local);
                    Continue;
                end;

                if segment_idx_local < High(path_segments_local) then
                begin
                    next_text_local := Trim(
                        path_segments_local[segment_idx_local + 1]);
                    next_units_local := get_candidate_text_unit_count(
                        next_text_local);
                    if (segment_idx_local + 2 <= High(path_segments_local)) and
                        (current_units_local = 1) and
                        (next_units_local = 2) then
                    begin
                        third_text_local := Trim(
                            path_segments_local[segment_idx_local + 2]);
                        third_units_local := get_candidate_text_unit_count(
                            third_text_local);
                        if (third_units_local = 1) and
                            try_repair_one_two_one_boundary_shift_local(
                            query_offset_local, current_text_local,
                            next_units_local, next_text_local, third_text_local,
                            best_exact_text_local, combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, current_units_local +
                                next_units_local + third_units_local);
                            Inc(segment_idx_local, 3);
                            Inc(repair_count_local);
                            repair_used_boundary_shift_local := True;
                            Continue;
                        end;
                        if (third_units_local = 2) and
                            (segment_idx_local + 3 <= High(path_segments_local)) then
                        begin
                            fourth_text_local := Trim(
                                path_segments_local[segment_idx_local + 3]);
                            fourth_units_local := get_candidate_text_unit_count(
                                fourth_text_local);
                            if (fourth_units_local = 1) and
                                try_repair_one_two_two_one_boundary_shift_local(
                                query_offset_local, current_text_local,
                                next_text_local, third_text_local,
                                fourth_text_local, best_exact_text_local,
                                combined_text_local) then
                            begin
                                repaired_text_local := repaired_text_local +
                                    best_exact_text_local;
                                if repaired_path_local <> '' then
                                begin
                                    repaired_path_local := repaired_path_local +
                                        c_segment_path_separator;
                                end;
                                repaired_path_local := repaired_path_local +
                                    combined_text_local;
                                Inc(query_offset_local, current_units_local +
                                    next_units_local + third_units_local +
                                    fourth_units_local);
                                Inc(segment_idx_local, 4);
                                Inc(repair_count_local);
                                repair_used_boundary_shift_local := True;
                                Continue;
                            end;
                        end;
                        if (third_units_local = 2) and
                            try_repair_one_two_two_boundary_shift_local(
                            query_offset_local, current_text_local,
                            next_units_local, next_text_local, third_units_local,
                            third_text_local, best_exact_text_local,
                            combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, current_units_local +
                                next_units_local + third_units_local);
                            Inc(segment_idx_local, 3);
                            Inc(repair_count_local);
                            repair_used_boundary_shift_local := True;
                            Continue;
                        end;
                    end;
                    if (segment_idx_local + 1 <= High(path_segments_local)) and
                        ((current_units_local + next_units_local = 3) or
                        (current_units_local + next_units_local = 4)) then
                    begin
                        if (segment_idx_local + 2 <= High(path_segments_local)) and
                            (current_units_local = 2) and
                            (next_units_local = 1) then
                        begin
                            third_text_local := Trim(
                                path_segments_local[segment_idx_local + 2]);
                            third_units_local := get_candidate_text_unit_count(
                                third_text_local);
                            if (third_units_local = 1) and
                                try_repair_two_one_one_boundary_shift_local(
                                query_offset_local, current_units_local,
                                current_text_local, next_text_local,
                                third_text_local, best_exact_text_local,
                                combined_text_local) then
                            begin
                                repaired_text_local := repaired_text_local +
                                    best_exact_text_local;
                                if repaired_path_local <> '' then
                                begin
                                    repaired_path_local := repaired_path_local +
                                        c_segment_path_separator;
                                end;
                                repaired_path_local := repaired_path_local +
                                    combined_text_local;
                                Inc(query_offset_local, current_units_local +
                                    next_units_local + third_units_local);
                                Inc(segment_idx_local, 3);
                                Inc(repair_count_local);
                                repair_used_boundary_shift_local := True;
                                Continue;
                            end;
                        end;

                        combined_text_local := current_text_local + next_text_local;
                        if try_repair_adjacent_split_phrase_local(
                            query_offset_local, current_units_local,
                            current_text_local, next_units_local, next_text_local,
                            best_exact_text_local, combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, current_units_local +
                                next_units_local);
                            Inc(segment_idx_local, 2);
                            Inc(repair_count_local);
                            Continue;
                        end;
                        if try_repair_prefix_tail_exact_shift_local(
                            query_offset_local,
                            current_units_local + next_units_local,
                            combined_text_local, best_exact_text_local,
                            combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, current_units_local +
                                next_units_local);
                            Inc(segment_idx_local, 2);
                            Inc(repair_count_local);
                            repair_used_prefix_tail_shift_local := True;
                            Continue;
                        end;
                    end;
                    if (segment_idx_local + 2 <= High(path_segments_local)) and
                        (current_units_local = 1) and (next_units_local = 1) then
                    begin
                        third_text_local := Trim(
                            path_segments_local[segment_idx_local + 2]);
                        third_units_local := get_candidate_text_unit_count(
                            third_text_local);
                        if third_units_local = 1 then
                        begin
                            combined_text_local := current_text_local +
                                next_text_local + third_text_local;
                            if try_repair_adjacent_split_phrase_local(
                                query_offset_local, 2,
                                current_text_local + next_text_local, 1,
                                third_text_local, best_exact_text_local,
                                combined_text_local) then
                            begin
                                repaired_text_local := repaired_text_local +
                                    best_exact_text_local;
                                if repaired_path_local <> '' then
                                begin
                                    repaired_path_local := repaired_path_local +
                                        c_segment_path_separator;
                                end;
                                repaired_path_local := repaired_path_local +
                                    combined_text_local;
                                Inc(query_offset_local, 3);
                                Inc(segment_idx_local, 3);
                                Inc(repair_count_local);
                                Continue;
                            end;
                            if try_repair_prefix_tail_exact_shift_local(
                                query_offset_local, 3, combined_text_local,
                                best_exact_text_local, combined_text_local) then
                            begin
                                repaired_text_local := repaired_text_local +
                                    best_exact_text_local;
                                if repaired_path_local <> '' then
                                begin
                                    repaired_path_local := repaired_path_local +
                                        c_segment_path_separator;
                                end;
                                repaired_path_local := repaired_path_local +
                                    combined_text_local;
                                Inc(query_offset_local, 3);
                                Inc(segment_idx_local, 3);
                                Inc(repair_count_local);
                                repair_used_prefix_tail_shift_local := True;
                                Continue;
                            end;
                        end;
                    end;
                    if (next_text_local <> '') and (next_units_local > 0) and
                        ((current_units_local = 1) or (next_units_local = 1)) and
                        (current_units_local + next_units_local <= 3) and
                        (query_offset_local + current_units_local +
                        next_units_local <= syllable_count_local) then
                    begin
                        if try_repair_adjacent_split_phrase_local(
                            query_offset_local, current_units_local,
                            current_text_local, next_units_local, next_text_local,
                            best_exact_text_local, combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, current_units_local +
                                next_units_local);
                            Inc(segment_idx_local, 2);
                            Inc(repair_count_local);
                            Continue;
                        end;

                        combined_key_local := build_query_key_local(
                            query_offset_local, current_units_local +
                            next_units_local);
                        combined_text_local := current_text_local + next_text_local;
                        if repair_probe_budget_local <= 0 then
                        begin
                            append_repaired_segment_local(current_text_local);
                            Inc(query_offset_local, current_units_local);
                            Inc(segment_idx_local);
                            Continue;
                        end;
                        Dec(repair_probe_budget_local);
                        if (current_units_local = 1) and (next_units_local = 1) and
                            (segment_idx_local + 2 <= High(path_segments_local)) then
                        begin
                            third_text_local := Trim(
                                path_segments_local[segment_idx_local + 2]);
                            third_units_local := get_candidate_text_unit_count(
                                third_text_local);
                            if (third_text_local <> '') and
                                (third_units_local = 1) and
                                (query_offset_local + 3 <= syllable_count_local) then
                            begin
                                combined_key_local := build_query_key_local(
                                    query_offset_local, 3);
                                combined_text_local := current_text_local +
                                    next_text_local + third_text_local;
                                if try_get_better_exact_text_local(
                                    combined_key_local, 3, combined_text_local,
                                    c_min_single_chain_triple_exact_weight,
                                    best_exact_text_local,
                                    best_exact_score_local) then
                                begin
                                    append_repaired_segment_local(
                                        best_exact_text_local);
                                    Inc(query_offset_local, 3);
                                    Inc(segment_idx_local, 3);
                                    Inc(repair_count_local);
                                    Continue;
                                end;
                            end;
                        end;
                        if try_get_better_exact_text_local(combined_key_local,
                            current_units_local + next_units_local,
                            combined_text_local, c_min_covering_pair_exact_weight,
                            best_exact_text_local, best_exact_score_local) then
                        begin
                            append_repaired_segment_local(best_exact_text_local);
                            Inc(query_offset_local, current_units_local +
                                next_units_local);
                            Inc(segment_idx_local, 2);
                            Inc(repair_count_local);
                            Continue;
                        end;
                    end;
                    if (next_text_local <> '') and (next_units_local > 0) and
                        (current_units_local = 2) and (next_units_local = 2) and
                        (query_offset_local + 4 <= syllable_count_local) then
                    begin
                        if repair_probe_budget_local <= 0 then
                        begin
                            append_repaired_segment_local(current_text_local);
                            Inc(query_offset_local, current_units_local);
                            Inc(segment_idx_local);
                            Continue;
                        end;
                        Dec(repair_probe_budget_local);
                        if try_repair_adjacent_split_phrase_local(
                            query_offset_local, current_units_local,
                            current_text_local, next_units_local, next_text_local,
                            best_exact_text_local, combined_text_local) then
                        begin
                            repaired_text_local := repaired_text_local +
                                best_exact_text_local;
                            if repaired_path_local <> '' then
                            begin
                                repaired_path_local := repaired_path_local +
                                    c_segment_path_separator;
                            end;
                            repaired_path_local := repaired_path_local +
                                combined_text_local;
                            Inc(query_offset_local, 4);
                            Inc(segment_idx_local, 2);
                            Inc(repair_count_local);
                            Continue;
                        end;
                    end;
                end;

                append_repaired_segment_local(current_text_local);
                Inc(query_offset_local, current_units_local);
                Inc(segment_idx_local);
            end;

            if (repair_count_local <= 0) or
                (query_offset_local <> syllable_count_local) or
                SameText(repaired_text_local, source_state.text) then
            begin
                chained_repaired_text_local := '';
                chained_repaired_path_local := '';
                if try_repair_text_exact_span_splits_local(source_state.text,
                    source_state.path, chained_repaired_text_local,
                    chained_repaired_path_local) and
                    (not SameText(chained_repaired_text_local,
                    source_state.text)) then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' xspansplit=[%s>%s]',
                            [source_state.text, chained_repaired_text_local]);
                    end;
                    repaired_text_local := chained_repaired_text_local;
                    repaired_path_local := chained_repaired_path_local;
                    repair_count_local := 1;
                end
                else
                begin
                    Exit(False);
                end;
            end
            else
            begin
                chained_repaired_text_local := '';
                chained_repaired_path_local := '';
                if try_repair_text_exact_span_splits_local(repaired_text_local,
                    repaired_path_local, chained_repaired_text_local,
                    chained_repaired_path_local) and
                    (not SameText(chained_repaired_text_local,
                    repaired_text_local)) then
                begin
                    repaired_text_local := chained_repaired_text_local;
                    repaired_path_local := chained_repaired_path_local;
                    Inc(repair_count_local);
                end;
            end;

            if repaired_text_rewrites_protected_source_exact_span_local then
            begin
                Exit(False);
            end;

            if (not repair_used_prefix_tail_shift_local) and
                (not repair_used_boundary_shift_local) and
                repaired_text_rewrites_directional_place_span_local then
            begin
                Exit(False);
            end;

            repaired_state := source_state;
            repaired_state.text := repaired_text_local;
            repaired_state.path := repaired_path_local;
            repaired_state.score := source_state.score +
                repair_count_local * c_repair_bonus;
            repaired_state.segments := Max(1,
                source_state.segments - repair_count_local);
            Result := True;
        end;

        function get_fast_state_path_exact_quality_local(
            const local_state: TExactChunkChainState): Integer;
        const
            c_path_exact_probe_limit = c_chain_probe_limit * 4;
            c_path_exact_weight_cap = 12000;
        var
            path_segments_local: TArray<string>;
            segment_idx_local: Integer;
            query_offset_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            query_key_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
            exact_weight_local: Integer;
            segment_is_exact_local: Boolean;
        begin
            Result := 0;
            if Trim(local_state.path) = '' then
            begin
                Exit(Low(Integer) div 4);
            end;

            path_segments_local := local_state.path.Split([c_segment_path_separator]);
            query_offset_local := 0;
            for segment_idx_local := 0 to High(path_segments_local) do
            begin
                segment_text_local := Trim(path_segments_local[segment_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) or
                    (query_offset_local + segment_units_local >
                    syllable_count_local) then
                begin
                    Exit(Low(Integer) div 4);
                end;

                query_key_local := build_query_key_local(query_offset_local,
                    segment_units_local);
                segment_is_exact_local := False;
                exact_weight_local := 0;
                if (query_key_local <> '') and
                    lookup_exact_full_pinyin_cached_local(query_key_local,
                    exact_results_local) then
                begin
                    for exact_idx_local := 0 to High(exact_results_local) do
                    begin
                        if exact_idx_local >= c_path_exact_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;

                        exact_text_local := Trim(
                            exact_results_local[exact_idx_local].text);
                        if SameText(exact_text_local, segment_text_local) and
                            (get_candidate_text_unit_count(exact_text_local) =
                            segment_units_local) then
                        begin
                            segment_is_exact_local := True;
                            exact_weight_local := Max(exact_weight_local,
                                get_exact_chunk_raw_weight_local(
                                exact_results_local[exact_idx_local]));
                            if is_reliable_fast_exact_chunk_local(query_key_local,
                                segment_units_local, segment_text_local,
                                exact_results_local[exact_idx_local]) then
                            begin
                                Inc(exact_weight_local, 180);
                            end;
                        end;
                    end;
                end;

                if segment_is_exact_local then
                begin
                    Inc(Result, segment_units_local * segment_units_local * 2200);
                    Inc(Result, Min(c_path_exact_weight_cap,
                        Max(0, exact_weight_local) * 6));
                    if segment_units_local >= 2 then
                    begin
                        Inc(Result, segment_units_local * 900);
                    end;
                end
                else if segment_units_local >= 2 then
                begin
                    Dec(Result, segment_units_local * segment_units_local * 2600 +
                        3600);
                end
                else
                begin
                    Dec(Result, 280);
                end;

                Inc(query_offset_local, segment_units_local);
            end;

            if query_offset_local <> syllable_count_local then
            begin
                Exit(Low(Integer) div 4);
            end;
            Dec(Result, Max(0, local_state.segments) * 120);
        end;

        function get_fast_reliable_exact_span_weight_local(
            const start_idx_local: Integer; const span_units_local: Integer;
            const span_text_local: string): Integer;
        const
            c_span_probe_limit = c_chain_probe_limit * 4;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := 0;
            if (span_text_local = '') or (span_units_local < 2) or
                (start_idx_local < 0) or
                (start_idx_local + span_units_local > syllable_count_local) then
            begin
                Exit;
            end;

            query_key_local := build_query_key_local(start_idx_local,
                span_units_local);
            if (query_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if exact_idx_local >= c_span_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if SameText(exact_text_local, span_text_local) and
                    (get_candidate_text_unit_count(exact_text_local) =
                    span_units_local) and
                    is_reliable_fast_exact_chunk_local(query_key_local,
                    span_units_local, span_text_local,
                    exact_results_local[exact_idx_local]) then
                begin
                    Result := Max(Result, get_exact_chunk_raw_weight_local(
                        exact_results_local[exact_idx_local]));
                end;
            end;
        end;

        function fast_repair_breaks_strong_source_exact_chain_local(
            const source_state_local: TExactChunkChainState;
            const repaired_state_local: TExactChunkChainState): Boolean;
        const
            c_strong_source_exact_weight = 700;
            c_same_span_slack = 160;
            c_source_pair_slack = 80;
        var
            source_units_local: TArray<string>;
            repaired_units_local: TArray<string>;
            path_segments_local: TArray<string>;
            segment_idx_local: Integer;
            query_offset_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            source_span_text_local: string;
            repaired_span_text_local: string;
            source_weight_local: Integer;
            repaired_weight_local: Integer;
            previous_lost_end_local: Integer;
            unit_idx_local: Integer;

            function build_units_range_text_local(const units_value: TArray<string>;
                const range_start: Integer; const range_len: Integer): string;
            var
                range_idx_local: Integer;
            begin
                Result := '';
                if (range_start < 0) or (range_len <= 0) or
                    (range_start + range_len > Length(units_value)) then
                begin
                    Exit;
                end;
                for range_idx_local := range_start to range_start + range_len - 1 do
                begin
                    Result := Result + units_value[range_idx_local];
                end;
            end;

            function get_fast_exact_span_weight_local(
                const start_idx_local: Integer; const span_units_local: Integer;
                const span_text_local: string): Integer;
            const
                c_span_probe_limit = c_chain_probe_limit * 4;
            var
                query_key_local: string;
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := 0;
                if (span_text_local = '') or (span_units_local < 2) or
                    (start_idx_local < 0) or
                    (start_idx_local + span_units_local > syllable_count_local) then
                begin
                    Exit;
                end;

                query_key_local := build_query_key_local(start_idx_local,
                    span_units_local);
                if (query_key_local = '') or
                    (not lookup_exact_full_pinyin_cached_local(query_key_local,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= c_span_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if SameText(exact_text_local, span_text_local) and
                        (get_candidate_text_unit_count(exact_text_local) =
                        span_units_local) then
                    begin
                        Result := Max(Result, get_exact_chunk_raw_weight_local(
                            exact_results_local[exact_idx_local]));
                    end;
                end;
            end;

        begin
            Result := False;
            source_units_local := split_text_units(Trim(source_state_local.text));
            repaired_units_local := split_text_units(Trim(repaired_state_local.text));
            if (Length(source_units_local) <> syllable_count_local) or
                (Length(repaired_units_local) <> syllable_count_local) or
                (Trim(source_state_local.path) = '') then
            begin
                Exit;
            end;

            path_segments_local := source_state_local.path.Split(
                [c_segment_path_separator]);
            query_offset_local := 0;
            previous_lost_end_local := -1;
            for segment_idx_local := 0 to High(path_segments_local) do
            begin
                segment_text_local := Trim(path_segments_local[segment_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) or
                    (query_offset_local + segment_units_local >
                    syllable_count_local) then
                begin
                    Exit(False);
                end;

                if segment_units_local >= 2 then
                begin
                    source_span_text_local := build_units_range_text_local(
                        source_units_local, query_offset_local,
                        segment_units_local);
                    if SameText(source_span_text_local, segment_text_local) then
                    begin
                        source_weight_local :=
                            get_fast_reliable_exact_span_weight_local(
                            query_offset_local, segment_units_local,
                            segment_text_local);
                        if source_weight_local >= c_strong_source_exact_weight then
                        begin
                            repaired_span_text_local := build_units_range_text_local(
                                repaired_units_local, query_offset_local,
                                segment_units_local);
                            if not SameText(repaired_span_text_local,
                                segment_text_local) then
                            begin
                                repaired_weight_local :=
                                    get_fast_reliable_exact_span_weight_local(
                                    query_offset_local, segment_units_local,
                                    repaired_span_text_local);
                                if repaired_weight_local + c_same_span_slack <
                                    source_weight_local then
                                begin
                                    if previous_lost_end_local = query_offset_local then
                                    begin
                                        Exit(True);
                                    end;
                                    previous_lost_end_local := query_offset_local +
                                        segment_units_local;
                                end;
                            end;
                        end;
                    end;
                end;

                Inc(query_offset_local, segment_units_local);
            end;

            if query_offset_local <> syllable_count_local then
            begin
                Exit(False);
            end;

            // Preserve strong two-character phrases that the fast DP already
            // decoded as adjacent single units. This prevents a later repair
            // pass from merging them into a weaker homophone solely because
            // the merged path has fewer segments.
            for unit_idx_local := 0 to syllable_count_local - 2 do
            begin
                source_span_text_local := build_units_range_text_local(
                    source_units_local, unit_idx_local, 2);
                repaired_span_text_local := build_units_range_text_local(
                    repaired_units_local, unit_idx_local, 2);
                if SameText(source_span_text_local, repaired_span_text_local) then
                begin
                    Continue;
                end;

                source_weight_local := get_fast_exact_span_weight_local(
                    unit_idx_local, 2, source_span_text_local);
                if source_weight_local < c_strong_source_exact_weight then
                begin
                    Continue;
                end;

                repaired_weight_local := get_fast_exact_span_weight_local(
                    unit_idx_local, 2, repaired_span_text_local);
                if repaired_weight_local + c_source_pair_slack <
                    source_weight_local then
                begin
                    Exit(True);
                end;
            end;
        end;

        function should_promote_fast_repair_state_local(
            const source_state_local: TExactChunkChainState;
            const repaired_state_local: TExactChunkChainState): Boolean;
        const
            c_min_repair_path_quality_gain = 800;
            c_min_long_exact_span_weight = 260;
        var
            source_quality_local: Integer;
            repaired_quality_local: Integer;
            source_long_exact_units_local: Integer;
            repaired_long_exact_units_local: Integer;

            function get_long_exact_units_local(
                const local_state: TExactChunkChainState): Integer;
            var
                local_segments: TArray<string>;
                local_segment_idx: Integer;
                local_query_offset: Integer;
                local_segment_text: string;
                local_segment_units: Integer;
                local_segment_weight: Integer;

                function get_raw_exact_span_weight_local(
                    const local_start: Integer; const local_len: Integer;
                    const local_text: string): Integer;
                var
                    local_key: string;
                    local_results: TncCandidateList;
                    local_idx: Integer;
                    local_candidate_text: string;
                begin
                    Result := 0;
                    local_key := build_query_key_local(local_start, local_len);
                    if (local_key = '') or
                        (not lookup_exact_full_pinyin_cached_local(local_key,
                        local_results)) then
                    begin
                        Exit;
                    end;

                    for local_idx := 0 to High(local_results) do
                    begin
                        if Trim(local_results[local_idx].comment) <> '' then
                        begin
                            Continue;
                        end;

                        local_candidate_text := Trim(local_results[local_idx].text);
                        if SameText(local_candidate_text, local_text) and
                            (get_candidate_text_unit_count(local_candidate_text) =
                            local_len) then
                        begin
                            Result := Max(Result,
                                get_exact_chunk_raw_weight_local(
                                local_results[local_idx]));
                        end;
                    end;
                end;
            begin
                Result := 0;
                if Trim(local_state.path) = '' then
                begin
                    Exit;
                end;

                local_segments := local_state.path.Split([c_segment_path_separator]);
                local_query_offset := 0;
                for local_segment_idx := 0 to High(local_segments) do
                begin
                    local_segment_text := Trim(local_segments[local_segment_idx]);
                    local_segment_units :=
                        get_candidate_text_unit_count(local_segment_text);
                    if (local_segment_text = '') or (local_segment_units <= 0) or
                        (local_query_offset + local_segment_units >
                        syllable_count_local) then
                    begin
                        Exit(0);
                    end;

                    if local_segment_units >= 3 then
                    begin
                        local_segment_weight := get_raw_exact_span_weight_local(
                            local_query_offset, local_segment_units,
                            local_segment_text);
                        if local_segment_weight >= c_min_long_exact_span_weight then
                        begin
                            Inc(Result, local_segment_units);
                        end;
                    end;

                    Inc(local_query_offset, local_segment_units);
                end;

                if local_query_offset <> syllable_count_local then
                begin
                    Result := 0;
                end;
            end;
        begin
            Result := False;
            if SameText(Trim(repaired_state_local.text),
                Trim(source_state_local.text)) then
            begin
                Exit;
            end;
            if repaired_state_local.score <= source_state_local.score +
                c_fast_repair_promote_margin then
            begin
                Exit;
            end;

            source_long_exact_units_local :=
                get_long_exact_units_local(source_state_local);
            repaired_long_exact_units_local :=
                get_long_exact_units_local(repaired_state_local);
            if (repaired_state_local.segments <= source_state_local.segments) and
                (repaired_long_exact_units_local >=
                source_long_exact_units_local + 3) then
            begin
                Exit(True);
            end;

            source_quality_local :=
                get_fast_state_path_exact_quality_local(source_state_local);
            repaired_quality_local :=
                get_fast_state_path_exact_quality_local(repaired_state_local);

            if fast_repair_breaks_strong_source_exact_chain_local(
                source_state_local, repaired_state_local) and
                (repaired_quality_local < source_quality_local +
                c_min_repair_path_quality_gain) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        ' xfastrepair_skip=[strong-exact-chain]';
                end;
                Exit;
            end;

            if repaired_quality_local < source_quality_local +
                c_min_repair_path_quality_gain then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xfastrepair_skip=[quality %d/%d]',
                        [source_quality_local, repaired_quality_local]);
                end;
                Exit;
            end;

            Result := True;
        end;

        procedure upsert_fast_state_candidate_local(
            const local_state: TExactChunkChainState; const target_rank: Integer);
        var
            local_existing_index: Integer;
            local_idx: Integer;
            local_insert_rank: Integer;
            local_candidate: TncCandidate;
            local_text: string;
            local_score: Integer;
        begin
            local_text := Trim(local_state.text);
            if (local_text = '') or
                (get_candidate_text_unit_count(local_text) <> input_syllable_count) then
            begin
                Exit;
            end;

            local_insert_rank := target_rank;
            if local_insert_rank < 0 then
            begin
                local_insert_rank := 0;
            end;
            if local_insert_rank > Length(candidates) then
            begin
                local_insert_rank := Length(candidates);
            end;

            local_score := local_state.score;
            if local_insert_rank = 0 then
            begin
                local_score := Max(local_score, candidates[0].score + 2048);
            end;

            local_existing_index := -1;
            for local_idx := 0 to High(candidates) do
            begin
                if (Trim(candidates[local_idx].comment) = '') and
                    SameText(Trim(candidates[local_idx].text), local_text) then
                begin
                    local_existing_index := local_idx;
                    Break;
                end;
            end;

            if local_existing_index >= 0 then
            begin
                if local_existing_index <= local_insert_rank then
                begin
                    candidates[local_existing_index].score :=
                        Max(candidates[local_existing_index].score, local_score);
                    candidates[local_existing_index].has_dict_weight := True;
                    candidates[local_existing_index].dict_weight :=
                        Max(candidates[local_existing_index].dict_weight,
                        candidates[local_existing_index].score);
                    if local_state.path <> '' then
                    begin
                        remember_segment_path_for_candidate(local_text, '',
                            local_state.path, candidates[local_existing_index].score);
                    end;
                    if SameText(local_text, m_debug_target_recall_text) then
                    begin
                        m_debug_target_candidate_stage_mask :=
                            m_debug_target_candidate_stage_mask or 1;
                    end;
                    Exit;
                end;
                local_candidate := candidates[local_existing_index];
                for local_idx := local_existing_index to High(candidates) - 1 do
                begin
                    candidates[local_idx] := candidates[local_idx + 1];
                end;
                SetLength(candidates, Length(candidates) - 1);
            end
            else
            begin
                FillChar(local_candidate, SizeOf(local_candidate), 0);
                local_candidate.text := local_text;
            end;

            local_candidate.text := local_text;
            local_candidate.comment := '';
            local_candidate.source := cs_rule;
            local_candidate.has_dict_weight := True;
            local_candidate.dict_weight := local_state.score;
            local_candidate.score := local_score;
            local_candidate.dict_weight := local_score;

            SetLength(candidates, Length(candidates) + 1);
            for local_idx := High(candidates) downto local_insert_rank + 1 do
            begin
                candidates[local_idx] := candidates[local_idx - 1];
            end;
            candidates[local_insert_rank] := local_candidate;

            if local_state.path <> '' then
            begin
                remember_segment_path_for_candidate(local_text, '', local_state.path,
                    local_candidate.score);
            end;
            if SameText(local_text, m_debug_target_recall_text) then
            begin
                m_debug_target_candidate_stage_mask :=
                    m_debug_target_candidate_stage_mask or 1;
            end;
        end;

        procedure promote_best_fast_complete_candidate_by_score_local;
        const
            c_fast_complete_promote_margin = 256;
        var
            local_idx: Integer;
            best_idx_local: Integer;
            best_score_local: Integer;
            candidate_score_local: Integer;
            moved_candidate_local: TncCandidate;
        begin
            if Length(candidates) < 2 then
            begin
                Exit;
            end;
            if (Trim(candidates[0].comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidates[0].text)) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            best_idx_local := 0;
            best_score_local := candidates[0].score;
            for local_idx := 1 to Min(3, High(candidates)) do
            begin
                if (Trim(candidates[local_idx].comment) <> '') or
                    (get_candidate_text_unit_count(Trim(candidates[local_idx].text)) <>
                    input_syllable_count) then
                begin
                    Continue;
                end;
                candidate_score_local := candidates[local_idx].score;
                if candidate_score_local >
                    best_score_local + c_fast_complete_promote_margin then
                begin
                    best_idx_local := local_idx;
                    best_score_local := candidate_score_local;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            moved_candidate_local := candidates[best_idx_local];
            for local_idx := best_idx_local downto 1 do
            begin
                candidates[local_idx] := candidates[local_idx - 1];
            end;
            candidates[0] := moved_candidate_local;
        end;

        procedure force_fast_top_state_candidate_local(
            const local_state: TExactChunkChainState);
        var
            local_idx: Integer;
            existing_idx_local: Integer;
            local_candidate: TncCandidate;
            local_text: string;
        begin
            local_text := Trim(local_state.text);
            if (local_text = '') or
                (get_candidate_text_unit_count(local_text) <> input_syllable_count) then
            begin
                Exit;
            end;

            existing_idx_local := -1;
            for local_idx := 0 to High(candidates) do
            begin
                if (Trim(candidates[local_idx].comment) = '') and
                    SameText(Trim(candidates[local_idx].text), local_text) then
                begin
                    existing_idx_local := local_idx;
                    Break;
                end;
            end;

            if existing_idx_local >= 0 then
            begin
                local_candidate := candidates[existing_idx_local];
                for local_idx := existing_idx_local downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                end;
            end
            else
            begin
                FillChar(local_candidate, SizeOf(local_candidate), 0);
                SetLength(candidates, Length(candidates) + 1);
                for local_idx := High(candidates) downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                end;
            end;

            local_candidate.text := local_text;
            local_candidate.comment := '';
            local_candidate.source := cs_rule;
            local_candidate.has_dict_weight := True;
            local_candidate.score := Max(local_candidate.score,
                local_state.score);
            local_candidate.dict_weight := Max(local_candidate.dict_weight,
                local_candidate.score);
            candidates[0] := local_candidate;
            if local_state.path <> '' then
            begin
                remember_segment_path_for_candidate(local_text, '',
                    local_state.path, local_candidate.score);
            end;
        end;

    begin
        if (Length(candidates) = 0) or
            (input_syllable_count < c_long_sentence_exact_min_syllables) or
            (not is_full_pinyin_key(lookup_text)) or
            (m_dictionary = nil) then
        begin
            record_chain_search_status_local(c_chain_search_status_guard_rejected);
            Exit;
        end;

        if input_syllable_count <= 4 then
        begin
            record_chain_search_status_local(c_chain_search_status_short_query);
            Exit;
        end;

        if (not force_fast_validation) and
            (input_syllable_count >= 8) and
            (Trim(candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(candidates[0].text)) =
            input_syllable_count) and
            is_trusted_top_complete_candidate_local(candidates) then
        begin
            record_chain_search_status_local(
                c_chain_search_status_trusted_complete_exit);
            Exit;
        end;

        if (not force_fast_validation) and
            try_fast_visible_complete_exit_local then
        begin
            record_chain_search_status_local(
                c_chain_search_status_visible_complete_exit);
            Exit;
        end;

        if (input_syllable_count > 20) and
            ultra_long_exact_chunk_chain_miss_cached then
        begin
            record_chain_search_status_local(
                c_chain_search_status_cached_miss_exit);
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' xfastdp=[cached-miss]';
            end;
            Exit;
        end;

        effective_syllables := get_effective_compact_pinyin_syllables(lookup_text);
        syllable_count_local := Length(effective_syllables);
        if syllable_count_local <> input_syllable_count then
        begin
            record_chain_search_status_local(
                c_chain_search_status_syllable_mismatch);
            Exit;
        end;

        fast_phase_tick := GetTickCount64;
        record_chain_search_status_local(c_chain_search_status_fast_search);
        Inc(long_path_exact_lookup_filter_depth);
        try
            fast_build_ok := try_build_fast_dictionary_sentence_candidate_local(
                fast_text, fast_path, fast_score, fast_segments, fast_states);
        finally
            Dec(long_path_exact_lookup_filter_depth);
        end;
        fast_model_order_active := (Length(fast_states) > 0) and
            fast_states[0].ranker_model_ordered;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' txfastdp=%d', [GetTickCount64 - fast_phase_tick]);
        end;
        if fast_build_ok and (fast_text <> '') then
        begin
            if m_composition_built_incrementally and
                (not force_fast_validation) and
                (Length(fast_states) > 0) and
                ((Length(fast_states) = 1) or
                (fast_states[0].score >= fast_states[1].score +
                c_incremental_fast_direct_min_gap)) and
                (input_syllable_count >= 10) and
                (get_candidate_text_unit_count(Trim(fast_text)) =
                input_syllable_count) and
                (Trim(fast_path) <> '') and
                (fast_score >= input_syllable_count * 9000) and
                (fast_segments <= input_syllable_count - 3) then
            begin
                force_fast_top_state_candidate_local(fast_states[0]);
                mark_debug_target_candidate_stage_local(1024, candidates);
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xfastdirect=[text=%s score=%d seg=%d]',
                        [fast_text, fast_score, fast_segments]);
                end;
                Exit;
            end;
            fast_phase_tick := GetTickCount64;
            fast_repair_inserted := False;
            for fast_state_idx := 0 to Min(
                c_chain_lattice_baseline_beam_width - 1,
                High(fast_states)) do
            begin
                fast_state_to_upsert := fast_states[fast_state_idx];
                if fast_state_idx = 0 then
                begin
                    if (allow_fast_repair or allow_incremental_tail_repair) and
                        try_repair_state_with_covering_exact_pairs_local(
                        fast_states[fast_state_idx], fast_repaired_state,
                        allow_incremental_tail_repair and
                        (not allow_fast_repair)) and
                        should_promote_fast_repair_state_local(
                        fast_state_to_upsert, fast_repaired_state) then
                    begin
                        if fast_model_order_active then
                        begin
                            { The repair remains available, but it was not in
                              the ranked candidate set and must not bypass the
                              learned ordering. }
                            upsert_fast_state_candidate_local(
                                fast_state_to_upsert, 0);
                            upsert_fast_state_candidate_local(
                                fast_repaired_state, 1);
                        end
                        else
                        begin
                            upsert_fast_state_candidate_local(
                                fast_repaired_state, 0);
                            upsert_fast_state_candidate_local(
                                fast_state_to_upsert, 1);
                        end;
                        fast_repair_inserted := True;
                        if m_config.debug_mode then
                        begin
                            m_last_full_path_debug_info :=
                                m_last_full_path_debug_info +
                                Format(' xfastrepair=[%s score=%d]',
                                [fast_repaired_state.text,
                                fast_repaired_state.score]);
                        end;
                    end;
                    if not fast_repair_inserted then
                    begin
                        upsert_fast_state_candidate_local(fast_state_to_upsert, 0);
                    end;
                    Continue;
                end;
                upsert_fast_state_candidate_local(fast_state_to_upsert,
                    fast_state_idx + Ord(fast_repair_inserted));
            end;
            if Length(fast_states) > 0 then
            begin
                if fast_model_order_active then
                begin
                    force_fast_top_state_candidate_local(fast_states[0]);
                end
                else if fast_repair_inserted then
                begin
                    force_fast_top_state_candidate_local(fast_repaired_state);
                end
                else
                begin
                    force_fast_top_state_candidate_local(fast_states[0]);
                end;
            end;
            if not fast_model_order_active then
            begin
                promote_best_fast_complete_candidate_by_score_local;
            end;
            mark_debug_target_candidate_stage_local(1024, candidates);
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' xfastdp=[text=%s score=%d seg=%d alts=%d]',
                    [fast_text, fast_score, fast_segments, Length(fast_states)]);
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' txfastup=%d', [GetTickCount64 - fast_phase_tick]);
            end;
            Exit;
        end;

        if input_syllable_count > 20 then
        begin
            record_chain_search_status_local(
                c_chain_search_status_ultra_long_fast_miss);
            ultra_long_exact_chunk_chain_miss_cached := True;
            Exit;
        end;

        record_chain_search_status_local(c_chain_search_status_fallback_search);

        SetLength(best_scores, syllable_count_local + 1);
        SetLength(best_texts, syllable_count_local + 1);
        SetLength(best_paths, syllable_count_local + 1);
        SetLength(best_segments, syllable_count_local + 1);
        SetLength(best_has_anchor, syllable_count_local + 1);
        SetLength(best_anchor_units, syllable_count_local + 1);
        standalone_chunk_states := TDictionary<string, Integer>.Create;
        standalone_chunk_texts := TDictionary<string, string>.Create;
        standalone_chunk_scores := TDictionary<string, Integer>.Create;
        standalone_chunk_options :=
            TDictionary<string, TExactChunkChainOptionArray>.Create;
        standalone_chunk_engine := nil;
        standalone_chunk_budget_remaining := 12;
        use_direct_chunk_lattice_only := True;
        suppress_subspan_oracle_local := syllable_count_local <= 8;
        runtime_exact_edge_probe_collection_local := False;
        if suppress_subspan_oracle_local then
        begin
            Inc(m_disable_subspan_standalone_oracle);
        end;
        if syllable_count_local >= 12 then
        begin
            standalone_chunk_budget_remaining := 16;
        end;
        if syllable_count_local >= 18 then
        begin
            standalone_chunk_budget_remaining := 24;
        end;

        try
            for idx := 0 to syllable_count_local do
            begin
                best_scores[idx] := Low(Integer);
                best_texts[idx] := '';
                best_paths[idx] := '';
                best_segments[idx] := MaxInt;
                best_has_anchor[idx] := False;
                best_anchor_units[idx] := -1;
            end;

            best_scores[syllable_count_local] := 0;
            best_texts[syllable_count_local] := '';
            best_paths[syllable_count_local] := '';
            best_segments[syllable_count_local] := 0;
            best_has_anchor[syllable_count_local] := False;
            best_anchor_units[syllable_count_local] := -1;

            if not use_direct_chunk_lattice_only then
            begin
                for idx := syllable_count_local - 1 downto 0 do
                begin
                    try_update_best_from_position(idx);
                end;
            end;

            if (input_syllable_count >= 4) and
                try_build_exact_chunk_lattice_local(lattice_text, lattice_path,
                lattice_score, lattice_segments, lattice_has_anchor,
                lattice_anchor_units) and
                (lattice_text <> '') and
                (get_candidate_text_unit_count(lattice_text) = input_syllable_count) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xlattice=[text=%s score=%d seg=%d top=%s topscore=%d]',
                        [lattice_text, lattice_score, lattice_segments,
                        best_texts[0], best_scores[0]]);
                end;
                if (best_scores[0] = Low(Integer)) or
                    (lattice_score > best_scores[0]) or
                    ((lattice_score = best_scores[0]) and
                    lattice_has_anchor and (not best_has_anchor[0])) or
                    ((lattice_score = best_scores[0]) and
                    (lattice_has_anchor = best_has_anchor[0]) and
                    (lattice_anchor_units > best_anchor_units[0])) or
                    ((lattice_score = best_scores[0]) and
                    (lattice_anchor_units = best_anchor_units[0]) and
                    (lattice_segments < best_segments[0])) then
                begin
                    best_scores[0] := lattice_score;
                    best_texts[0] := lattice_text;
                    best_paths[0] := lattice_path;
                    best_segments[0] := lattice_segments;
                    best_has_anchor[0] := lattice_has_anchor;
                    best_anchor_units[0] := lattice_anchor_units;
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info := m_last_full_path_debug_info +
                            Format(' xlattice=[promote text=%s seg=%d]',
                            [lattice_text, lattice_segments]);
                    end;
                end;
            end;

            preferred_phrase_bonus := get_preferred_query_phrase_bonus_local(
                lookup_text, best_texts[0]);
            current_path_preference_local := 0;
            support_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, best_texts[0], current_support_local,
                current_path_preference_local);
            xchain_metric_local := current_support_local + preferred_phrase_bonus;
            FillChar(problematic_candidate_local, SizeOf(problematic_candidate_local), 0);
            problematic_candidate_local.text := best_texts[0];
            problematic_candidate_local.comment := '';
            xchain_problematic_local :=
                is_problematic_single_char_chain_candidate_for_query(lookup_text,
                problematic_candidate_local);
            if xchain_problematic_local then
            begin
                Dec(xchain_metric_local, 1536);
            end;
            if support_path_local <> '' then
            begin
                best_paths[0] := support_path_local;
            end;

            if (best_scores[0] = Low(Integer)) or
                ((not best_has_anchor[0]) and (preferred_phrase_bonus <= 0)) or
                (best_texts[0] = '') or
                (get_candidate_text_unit_count(best_texts[0]) <> input_syllable_count) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xchain=[miss text=%s anchor=%d seg=%d]',
                        [best_texts[0], Ord(best_has_anchor[0]), best_segments[0]]);
                end;
                Exit;
            end;

            best_visible_index := -1;
            best_visible_metric := Low(Integer);
            best_visible_problematic_local := False;
            for idx := 0 to High(candidates) do
            begin
                current_candidate_text_local := Trim(candidates[idx].text);
                if (Trim(candidates[idx].comment) <> '') or
                    (current_candidate_text_local = '') or
                    (get_candidate_text_unit_count(current_candidate_text_local) <>
                    input_syllable_count) then
                begin
                    Continue;
                end;
                current_path_preference_local := 0;
                support_path_local := infer_segment_path_for_query_text_with_score(
                    lookup_text, current_candidate_text_local,
                    current_support_local, current_path_preference_local);
                current_metric_local := current_support_local +
                    get_preferred_query_phrase_bonus_local(lookup_text,
                    current_candidate_text_local);
                FillChar(problematic_candidate_local, SizeOf(problematic_candidate_local), 0);
                problematic_candidate_local.text := current_candidate_text_local;
                problematic_candidate_local.comment := '';
                if is_problematic_single_char_chain_candidate_for_query(lookup_text,
                    problematic_candidate_local) then
                begin
                    Dec(current_metric_local, 1536);
                end;
                if (best_visible_index < 0) or
                    (current_metric_local > best_visible_metric) or
                    ((current_metric_local = best_visible_metric) and
                    (CompareText(current_candidate_text_local,
                    Trim(candidates[best_visible_index].text)) < 0)) then
                begin
                    best_visible_index := idx;
                    best_visible_metric := current_metric_local;
                    best_visible_problematic_local :=
                        is_problematic_single_char_chain_candidate_for_query(
                        lookup_text, problematic_candidate_local);
                end;
            end;

            if (best_visible_index >= 0) and
                (not SameText(Trim(candidates[best_visible_index].text),
                best_texts[0])) and
                ((best_visible_metric > xchain_metric_local + 2048) or
                ((best_visible_metric = xchain_metric_local) and
                (not best_visible_problematic_local) and
                xchain_problematic_local)) then
            begin
                best_texts[0] := Trim(candidates[best_visible_index].text);
                preferred_phrase_bonus := get_preferred_query_phrase_bonus_local(
                    lookup_text, best_texts[0]);
                best_paths[0] := get_segment_path_for_candidate(
                    candidates[best_visible_index]);
                if best_paths[0] = '' then
                begin
                    current_path_preference_local := 0;
                    support_path_local := infer_segment_path_for_query_text_with_score(
                        lookup_text, best_texts[0], current_support_local,
                        current_path_preference_local);
                    best_paths[0] := support_path_local;
                end;
                best_segments[0] := get_path_segment_count_local(best_paths[0]);
                if best_segments[0] <= 0 then
                begin
                    best_segments[0] := 1;
                end;
                best_has_anchor[0] := True;
                best_anchor_units[0] := input_syllable_count;
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xchain=[prefer_visible text=%s metric=%d xmetric=%d]',
                        [best_texts[0], best_visible_metric, xchain_metric_local]);
                end;
            end;

            existing_index := -1;
            for idx := 0 to High(candidates) do
            begin
                if (Trim(candidates[idx].comment) = '') and
                    SameText(Trim(candidates[idx].text), best_texts[0]) then
                begin
                    existing_index := idx;
                    Break;
                end;
            end;

            if existing_index = 0 then
            begin
                Exit;
            end;

            top_path_segment_count := get_path_segment_count_local(
                get_segment_path_for_candidate(candidates[0]));
            top_preferred_phrase_bonus := get_preferred_query_phrase_bonus_local(
                lookup_text, Trim(candidates[0].text));
            should_promote := False;
            if Trim(candidates[0].comment) <> '' then
            begin
                should_promote := True;
            end
            else if get_candidate_text_unit_count(Trim(candidates[0].text)) <>
                input_syllable_count then
            begin
                should_promote := True;
            end
            else if (top_path_segment_count > 0) and
                (best_segments[0] < top_path_segment_count) then
            begin
                should_promote := True;
            end
            else if (top_path_segment_count = 0) and best_has_anchor[0] and
                (best_segments[0] <= 2) then
            begin
                should_promote := True;
            end
            else if existing_index > 0 then
            begin
                should_promote := True;
            end
            else if preferred_phrase_bonus > top_preferred_phrase_bonus then
            begin
                should_promote := True;
            end
            else if best_scores[0] > candidates[0].score + 4096 then
            begin
                should_promote := True;
            end;

            if not should_promote then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xchain=[skip text=%s seg=%d topseg=%d top=%s]',
                        [best_texts[0], best_segments[0], top_path_segment_count,
                        Trim(candidates[0].text)]);
                end;
                Exit;
            end;

            if existing_index > 0 then
            begin
                picked := candidates[existing_index];
                if picked.score < Max(candidates[0].score + 2048,
                    best_scores[0]) then
                begin
                    picked.score := Max(candidates[0].score + 2048,
                        best_scores[0]);
                end;
            end
            else
            begin
                FillChar(picked, SizeOf(picked), 0);
                picked.text := best_texts[0];
                picked.comment := '';
                picked.score := Max(candidates[0].score + 2048, best_scores[0]);
                picked.source := cs_rule;
                picked.has_dict_weight := True;
                picked.dict_weight := picked.score;
                remember_segment_path_for_candidate(picked.text, '',
                    best_paths[0], picked.score);
            end;

            if best_paths[0] <> '' then
            begin
                remember_segment_path_for_candidate(Trim(picked.text), '',
                    best_paths[0], picked.score);
            end;

            if existing_index > 0 then
            begin
                for idx := existing_index downto 1 do
                begin
                    candidates[idx] := candidates[idx - 1];
                end;
            end
            else
            begin
                SetLength(candidates, Length(candidates) + 1);
                for idx := High(candidates) downto 1 do
                begin
                    candidates[idx] := candidates[idx - 1];
                end;
            end;
            candidates[0] := picked;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' xchain=[promote text=%s seg=%d]',
                    [best_texts[0], best_segments[0]]);
            end;
        finally
            if suppress_subspan_oracle_local then
            begin
                Dec(m_disable_subspan_standalone_oracle);
            end;
            standalone_chunk_engine.Free;
            standalone_chunk_options.Free;
            standalone_chunk_scores.Free;
            standalone_chunk_texts.Free;
            standalone_chunk_states.Free;
        end;
    end;

