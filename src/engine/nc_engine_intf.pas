        function candidate_has_structural_path_signal_local(
            const candidate_idx: Integer): Boolean;
        var
            path_local: string;
            parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_text_local: string;
            next_segment_text_local: string;
            next_next_segment_text_local: string;
            segment_units_local: Integer;
            next_units_local: Integer;
            next_next_units_local: Integer;
            segment_last_unit_local: string;
            next_first_unit_local: string;
            inferred_score_local: Integer;
            inferred_count_local: Integer;
        begin
            Result := False;
            if (candidate_idx < 0) or
                (candidate_idx >= Length(m_candidates)) then
            begin
                Exit;
            end;

            path_local := '';
            if candidate_idx < Length(m_candidate_segment_paths) then
            begin
                path_local := Trim(m_candidate_segment_paths[candidate_idx]);
            end;
            if path_local = '' then
            begin
                path_local := Trim(get_segment_path_for_candidate(
                    m_candidates[candidate_idx], candidate_idx));
            end;
            if path_local = '' then
            begin
                path_local := infer_segment_path_for_query_text_with_score(
                    normalized_pinyin, Trim(m_candidates[candidate_idx].text),
                    inferred_score_local, inferred_count_local);
            end;
            if get_encoded_path_segment_count_local(path_local) <= 1 then
            begin
                Exit;
            end;

            parts_local := path_local.Split([c_segment_path_separator]);
            for part_idx_local := 0 to High(parts_local) - 1 do
            begin
                segment_text_local := Trim(parts_local[part_idx_local]);
                next_segment_text_local := Trim(parts_local[part_idx_local + 1]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                next_units_local := get_candidate_text_unit_count(
                    next_segment_text_local);
                if (segment_units_local <= 0) or (next_units_local <= 0) then
                begin
                    Continue;
                end;

                segment_last_unit_local := get_last_text_unit_local(
                    segment_text_local);
                next_first_unit_local := get_first_text_unit_local(
                    next_segment_text_local);

                if (segment_units_local = 1) and (next_units_local >= 2) then
                begin
                    if SameText(segment_last_unit_local, string(Char($5BF9))) or
                        (is_path_pronoun_unit_local(segment_last_unit_local) and
                        is_path_predicate_or_modifier_head_local(
                        next_first_unit_local)) or
                        (SameText(segment_last_unit_local, string(Char($66F4))) and
                        SameText(next_first_unit_local, string(Char($4E3A)))) then
                    begin
                        Exit(True);
                    end;
                end;

                if (segment_units_local = 1) and (next_units_local = 1) and
                    (part_idx_local + 1 < High(parts_local)) then
                begin
                    next_next_segment_text_local :=
                        Trim(parts_local[part_idx_local + 2]);
                    next_next_units_local := get_candidate_text_unit_count(
                        next_next_segment_text_local);
                    if (next_next_units_local >= 2) and
                        SameText(segment_last_unit_local, string(Char($5E76))) and
                        SameText(next_first_unit_local, string(Char($4E0D))) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function particle_path_context_score_local(const candidate_idx: Integer): Integer;
        var
