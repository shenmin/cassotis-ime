        is_ordinal_quantity_local: Boolean;

        function is_protected_complete_candidate_local(
            const candidate_value_local: TncCandidate): Boolean;
        var
            candidate_text_local: string;
        begin
            Result := False;
            candidate_text_local := Trim(candidate_value_local.text);
            if (candidate_text_local = '') or
                (Trim(candidate_value_local.comment) <> '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                actual_units_local) then
            begin
                Exit;
            end;

            if candidate_value_local.source = cs_user then
            begin
                Exit(True);
            end;
            if (m_dictionary <> nil) and
                m_dictionary.is_user_entry(structured_query_local,
                candidate_text_local) then
            begin
                Exit(True);
            end;

            if not is_ordinal_quantity_local then
            begin
                Exit(True);
            end;
        end;

        function get_structured_insert_index_local: Integer;
        begin
            Result := 0;
            while (Result <= High(m_candidates)) and
                is_protected_complete_candidate_local(m_candidates[Result]) do
            begin
                Inc(Result);
            end;
        end;

        procedure insert_structured_candidate_local(const target_idx: Integer);
        var
            idx: Integer;
            insert_idx: Integer;
            candidate_count: Integer;
        begin
            candidate_count := Length(m_candidates);
            insert_idx := Max(0, Min(target_idx, candidate_count));
            SetLength(m_candidates, candidate_count + 1);
            if Length(m_candidate_segment_paths) < candidate_count + 1 then
            begin
                SetLength(m_candidate_segment_paths, candidate_count + 1);
            end;
            for idx := candidate_count downto insert_idx + 1 do
            begin
                m_candidates[idx] := m_candidates[idx - 1];
                m_candidate_segment_paths[idx] := m_candidate_segment_paths[idx - 1];
            end;
            m_candidates[insert_idx] := candidate_local;
            m_candidate_segment_paths[insert_idx] := structured_path_local;
        end;

        procedure upsert_structured_candidate_local;
        begin
            if structured_text_local = '' then
            begin
                Exit;
            end;
            target_idx_local := get_structured_insert_index_local;

            existing_idx_local := find_display_candidate(
                structured_text_local, '');
            if existing_idx_local >= 0 then
            begin
                if existing_idx_local < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[existing_idx_local] :=
                        structured_path_local;
                end;
                if existing_idx_local > target_idx_local then
                begin
                    move_display_candidate_to_index(existing_idx_local,
                        target_idx_local);
                end;
                Exit;
            end;

            FillChar(candidate_local, SizeOf(candidate_local), 0);
            candidate_local.text := structured_text_local;
            candidate_local.comment := '';
            candidate_local.score := 0;
            candidate_local.source := cs_rule;
            candidate_local.has_dict_weight := False;
            candidate_local.dict_weight := 0;
            insert_structured_candidate_local(target_idx_local);
        end;
    begin
        is_ordinal_quantity_local := False;
        structured_query_local := normalized_pinyin;
        structured_syllables_local := syllables;
        actual_units_local := Length(structured_syllables_local);
        if ((structured_query_local = '') or
            ((actual_units_local <> 2) and (actual_units_local <> 3))) and
            (user_entry_query <> '') then
        begin
            structured_query_local := user_entry_query;
            structured_syllables_local :=
                get_effective_compact_pinyin_syllables(
                structured_query_local, True);
            actual_units_local := Length(structured_syllables_local);
        end;

        if (structured_query_local = '') or
            ((actual_units_local <> 2) and (actual_units_local <> 3)) then
        begin
            Exit;
        end;

        if actual_units_local = 2 then
        begin
            number_text_local := get_display_number_text_outer(
                structured_syllables_local[0].text);
            tail_text_local := get_display_structured_quantity_tail_text_outer(
                structured_syllables_local[1].text);
            if (number_text_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;

            structured_text_local := number_text_local + tail_text_local;
            structured_path_local := number_text_local +
                c_segment_path_separator + tail_text_local;
            upsert_structured_candidate_local;
            Exit;
        end;

        if normalize_pinyin_text(structured_syllables_local[0].text) <> 'di' then
        begin
            Exit;
        end;
        is_ordinal_quantity_local := True;

        number_text_local := get_display_number_text_outer(
            structured_syllables_local[1].text);
        tail_text_local := get_display_structured_quantity_tail_text_outer(
            structured_syllables_local[2].text);
        if (number_text_local = '') or (tail_text_local = '') then
        begin
            Exit;
        end;

        structured_text_local := string(Char($7B2C)) + number_text_local +
            tail_text_local;
        structured_path_local := string(Char($7B2C)) +
            c_segment_path_separator + number_text_local + tail_text_local;
        upsert_structured_candidate_local;
    end;

    procedure promote_display_longer_prefix_completion_candidate;
    const
        c_probe_limit = 8;
    var
        top_text_local: string;
        top_units_local: Integer;
        idx: Integer;
        candidate_text_local: string;
        candidate_units_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Trim(m_candidates[0].comment) <> '') then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        top_units_local := get_candidate_text_unit_count(top_text_local);
        if (top_text_local = '') or (top_units_local < 2) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            if (candidate_units_local <= top_units_local) or
                (candidate_units_local > expected_units + 3) or
                (Pos(top_text_local, candidate_text_local) <> 1) then
            begin
                Continue;
            end;

            candidate_rank_local := candidate_units_local * 4096 +
                display_candidate_effective_weight(m_candidates[idx]);
            if (idx < Length(m_candidate_segment_paths)) and
                (get_encoded_path_segment_count_local(
                m_candidate_segment_paths[idx]) > 1) then
            begin
                Inc(candidate_rank_local, 6000);
            end;

            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_more_resolved_partial_candidate;
    const
        c_probe_limit = 8;
    var
        top_text_local: string;
        top_comment_units_local: Integer;
        top_text_units_local: Integer;
        idx: Integer;
        candidate_text_local: string;
        candidate_comment_local: string;
        candidate_text_units_local: Integer;
        candidate_comment_units_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Trim(m_candidates[0].comment) = '') then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        top_text_units_local := get_candidate_text_unit_count(top_text_local);
        top_comment_units_local := get_effective_compact_pinyin_unit_count(
            normalize_pinyin_text(Trim(m_candidates[0].comment)));
        if (top_text_local = '') or (top_comment_units_local <= 1) or
            (top_text_units_local + top_comment_units_local <> expected_units) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_comment_local := normalize_pinyin_text(
                Trim(m_candidates[idx].comment));
            if (candidate_text_local = '') or (candidate_comment_local = '') or
                (Pos(top_text_local, candidate_text_local) <> 1) then
            begin
                Continue;
            end;

            candidate_text_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            candidate_comment_units_local :=
                get_effective_compact_pinyin_unit_count(candidate_comment_local);
            if (candidate_text_units_local <= top_text_units_local) or
                (candidate_text_units_local + candidate_comment_units_local <>
                expected_units) or
                (candidate_comment_units_local >= top_comment_units_local) then
            begin
                Continue;
            end;

            candidate_rank_local := candidate_text_units_local * 4096 +
                display_candidate_effective_weight(m_candidates[idx]);
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_fixed_alignment_complete_candidate;
    const
        c_probe_limit = 10;
        c_min_alignment_gain = 12000;
    var
        idx: Integer;
        best_idx_local: Integer;
        top_alignment_local: Integer;
        candidate_alignment_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;

        function get_alignment_local(const candidate_value: TncCandidate): Integer;
        begin
            Result := get_display_fixed_tail_alignment_score_outer(
                candidate_value) +
                get_display_fixed_quantity_alignment_score_outer(
                candidate_value);
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) then
        begin
            Exit;
        end;

        top_alignment_local := get_alignment_local(m_candidates[0]);
        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_alignment_local := get_alignment_local(m_candidates[idx]);
            if candidate_alignment_local < top_alignment_local +
                c_min_alignment_gain then
            begin
                Continue;
            end;

            candidate_rank_local := candidate_alignment_local +
                Max(-16000, Min(16000,
                display_candidate_effective_weight(m_candidates[idx]) -
                display_candidate_effective_weight(m_candidates[0])));
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_xiang_yiyang_grammar_candidate;
    const
        c_probe_limit = 8;
    var
        top_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        idx: Integer;
        unit_idx: Integer;
        diff_idx_local: Integer;
        candidate_text_local: string;
        top_text_local: string;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 4) or
            (Length(syllables) <> expected_units) or
            (Trim(m_candidates[0].comment) <> '') then
        begin
            Exit;
        end;

        if (normalize_pinyin_text(syllables[expected_units - 2].text) <>
            'yi') or
            (normalize_pinyin_text(syllables[expected_units - 1].text) <>
            'yang') then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        top_units_local := split_text_units(top_text_local);
        if (Length(top_units_local) <> expected_units) or
            (not SameText(Trim(top_units_local[expected_units - 2]),
            string(Char($4E00)))) or
            (not SameText(Trim(top_units_local[expected_units - 1]),
            string(Char($6837)))) then
        begin
            Exit;
        end;

        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_units_local := split_text_units(candidate_text_local);
            if (Length(candidate_units_local) <> expected_units) or
                (not SameText(Trim(candidate_units_local[expected_units - 2]),
                string(Char($4E00)))) or
                (not SameText(Trim(candidate_units_local[expected_units - 1]),
                string(Char($6837)))) then
            begin
                Continue;
            end;

            diff_idx_local := -1;
            for unit_idx := 0 to expected_units - 1 do
            begin
                if SameText(Trim(candidate_units_local[unit_idx]),
                    Trim(top_units_local[unit_idx])) then
                begin
                    Continue;
                end;
                if diff_idx_local >= 0 then
                begin
                    diff_idx_local := -2;
                    Break;
                end;
                diff_idx_local := unit_idx;
            end;

            if (diff_idx_local < 0) or
                (normalize_pinyin_text(syllables[diff_idx_local].text) <>
                'xiang') then
            begin
                Continue;
            end;

            if SameText(Trim(top_units_local[diff_idx_local]),
                string(Char($60F3))) and
                SameText(Trim(candidate_units_local[diff_idx_local]),
                string(Char($50CF))) then
            begin
                force_move_display_candidate_to_index(idx, 0);
                Exit;
            end;
        end;
    end;

    procedure promote_display_contextual_modifier_repair_candidate;
    const
        c_probe_limit = 10;
        c_protected_exact_phrase_weight = 700;
    var
        top_units_local: TArray<string>;

        function build_units_text_local(const start_idx: Integer;
            const unit_count: Integer): string;
        var
            unit_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (unit_count <= 0) or
                (start_idx + unit_count > Length(top_units_local)) then
            begin
                Exit;
            end;
            for unit_idx := start_idx to start_idx + unit_count - 1 do
            begin
                Result := Result + top_units_local[unit_idx];
            end;
        end;

        function build_repaired_text_local(const start_idx: Integer;
            const unit_count: Integer; const replacement_text: string): string;
        var
            unit_idx: Integer;
        begin
            Result := '';
            for unit_idx := 0 to High(top_units_local) do
            begin
                if unit_idx = start_idx then
                begin
                    Result := Result + replacement_text;
                end;
                if (unit_idx < start_idx) or
                    (unit_idx >= start_idx + unit_count) then
                begin
                    Result := Result + top_units_local[unit_idx];
                end;
            end;
        end;

        function has_exact_phrase_local(const start_idx: Integer;
            const unit_count: Integer): Boolean;
        var
            query_key_local: string;
            text_local: string;
        begin
            Result := False;
            if (unit_count < 2) or
                (start_idx < 0) or
                (start_idx + unit_count > expected_units) then
            begin
                Exit;
            end;
            query_key_local := build_display_query_key(start_idx, unit_count);
            text_local := build_units_text_local(start_idx, unit_count);
            Result := display_exact_key_has_text(query_key_local, text_local);
        end;

        function has_following_phrase_local(const start_idx: Integer): Boolean;
        var
            unit_count: Integer;
        begin
            Result := False;
            if (start_idx < 0) or (start_idx >= expected_units) then
            begin
                Exit;
            end;
            for unit_count := 2 to Min(4, expected_units - start_idx) do
            begin
                if has_exact_phrase_local(start_idx, unit_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_preceding_phrase_local(const end_idx: Integer): Boolean;
        var
            unit_count: Integer;
            start_idx: Integer;
        begin
            Result := False;
            if (end_idx <= 0) or (end_idx >= expected_units) then
            begin
                Exit;
            end;
            for unit_count := 2 to Min(4, end_idx + 1) do
            begin
                start_idx := end_idx - unit_count + 1;
                if has_exact_phrase_local(start_idx, unit_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function range_inside_strong_exact_phrase_local(const start_idx: Integer;
            const unit_count: Integer): Boolean;
        var
            span_len_local: Integer;
            span_start_local: Integer;
            span_end_local: Integer;
            query_key_local: string;
            span_text_local: string;
            span_weight_local: Integer;
        begin
            Result := False;
            if (unit_count <= 0) or (start_idx < 0) or
                (start_idx + unit_count > expected_units) then
            begin
                Exit;
            end;

            for span_len_local := unit_count + 1 to
                Min(4, expected_units) do
            begin
                for span_start_local := Max(0, start_idx - span_len_local + 1) to
                    Min(start_idx, expected_units - span_len_local) do
                begin
                    span_end_local := span_start_local + span_len_local;
                    if (span_start_local > start_idx) or
                        (span_end_local < start_idx + unit_count) then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(
                        span_start_local, span_len_local);
                    span_text_local := build_units_text_local(span_start_local,
                        span_len_local);
                    if (query_key_local <> '') and (span_text_local <> '') and
                        get_display_exact_text_weight(query_key_local,
                        span_text_local, span_len_local, span_weight_local) and
                        (span_weight_local >= c_protected_exact_phrase_weight) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function try_pick_modifier_single_local(const unit_idx: Integer;
            const current_text: string; out out_text: string;
            out out_weight: Integer; const require_context: Boolean): Boolean;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            candidate_idx: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            ranked_weight_local: Integer;
            between_phrases_local: Boolean;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            query_key_local := build_display_query_key(unit_idx, 1);
            if (query_key_local = '') or
                (not lookup_display_exact_cached(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            between_phrases_local := has_preceding_phrase_local(unit_idx - 1) and
                has_following_phrase_local(unit_idx + 1);
            if require_context and (not between_phrases_local) then
            begin
                Exit;
            end;

            for candidate_idx := 0 to High(exact_results_local) do
            begin
                if candidate_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[candidate_idx].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[candidate_idx].text);
                if (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                    (not is_display_function_or_modifier_single(
                    candidate_text_local)) or
                    (not m_dictionary.single_char_matches_pinyin(
                    query_key_local, candidate_text_local)) then
                begin
                    Continue;
                end;

                candidate_weight_local := display_candidate_effective_weight(
                    exact_results_local[candidate_idx]);
                ranked_weight_local := candidate_weight_local +
                    ((c_probe_limit - candidate_idx) * 32);
                if between_phrases_local and
                    ((candidate_text_local = string(Char($4E0E))) or
                    (candidate_text_local = string(Char($548C)))) then
                begin
                    Inc(ranked_weight_local, 260);
                end;
                if (out_text = '') or (ranked_weight_local > out_weight) then
                begin
                    out_text := candidate_text_local;
                    out_weight := ranked_weight_local;
                    Result := True;
                end;
            end;
        end;

        function try_pick_modifier_pair_local(const start_idx: Integer;
            const current_text: string; out out_text: string;
            out out_weight: Integer): Boolean;
        var
            left_text: string;
            right_text: string;
            left_weight: Integer;
            right_weight: Integer;
            current_weight: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (start_idx < 0) or (start_idx + 2 > expected_units) or
                ((not has_following_phrase_local(start_idx + 2)) and
                (not has_preceding_phrase_local(start_idx - 1))) or
                (not get_display_exact_text_weight(
                build_display_query_key(start_idx, 2), current_text, 2,
                current_weight)) then
            begin
                Exit;
            end;
            if current_weight >= 1100 then
            begin
                Exit;
            end;

            if (not try_pick_modifier_single_local(start_idx,
                top_units_local[start_idx], left_text, left_weight, False)) or
                (not try_pick_modifier_single_local(start_idx + 1,
                top_units_local[start_idx + 1], right_text, right_weight,
                False)) then
            begin
                Exit;
            end;

            if (left_weight < 780) or (right_weight < 780) then
            begin
                Exit;
            end;

            out_text := left_text + right_text;
            out_weight := left_weight + right_weight;
            Result := (not SameText(out_text, current_text)) and
                (out_weight > current_weight + 280);
        end;

        procedure promote_or_insert_repair_local(const repaired_text: string;
            const repaired_weight: Integer);
        var
            existing_idx: Integer;
            repaired_candidate: TncCandidate;
        begin
            if (repaired_text = '') or SameText(repaired_text,
                Trim(m_candidates[0].text)) or
                (get_candidate_text_unit_count(repaired_text) <> expected_units) then
            begin
                Exit;
            end;

            existing_idx := find_display_candidate(repaired_text, '');
            if existing_idx >= 0 then
            begin
                force_move_display_candidate_to_index(existing_idx, 0);
                Exit;
            end;

            repaired_candidate := m_candidates[0];
            repaired_candidate.text := repaired_text;
            repaired_candidate.comment := '';
            repaired_candidate.source := cs_rule;
            repaired_candidate.has_dict_weight := True;
            repaired_candidate.score := Max(repaired_candidate.score,
                repaired_weight + 52000);
            repaired_candidate.dict_weight := repaired_candidate.score;
            insert_display_candidate(repaired_candidate, '', 0);
            existing_idx := find_display_candidate(repaired_text, '');
            if existing_idx > 0 then
            begin
                force_move_display_candidate_to_index(existing_idx, 0);
            end;
        end;

    var
        unit_idx: Integer;
        current_text_local: string;
        repair_text_local: string;
        repair_weight_local: Integer;
    begin
        if (Length(m_candidates) = 0) or (m_dictionary = nil) or
            (expected_units < 5) or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;
        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;

        for unit_idx := 0 to expected_units - 2 do
        begin
            current_text_local := build_units_text_local(unit_idx, 2);
            if range_inside_strong_exact_phrase_local(unit_idx, 2) then
            begin
                Continue;
            end;
            if try_pick_modifier_pair_local(unit_idx, current_text_local,
                repair_text_local, repair_weight_local) then
            begin
                promote_or_insert_repair_local(build_repaired_text_local(
                    unit_idx, 2, repair_text_local), repair_weight_local);
                Exit;
            end;
        end;

        for unit_idx := 0 to expected_units - 1 do
        begin
            current_text_local := top_units_local[unit_idx];
            if range_inside_strong_exact_phrase_local(unit_idx, 1) then
            begin
                Continue;
            end;
            if try_pick_modifier_single_local(unit_idx, current_text_local,
                repair_text_local, repair_weight_local, True) and
                (not SameText(repair_text_local, current_text_local)) then
            begin
                promote_or_insert_repair_local(build_repaired_text_local(
                    unit_idx, 1, repair_text_local), repair_weight_local);
                Exit;
            end;
        end;
    end;

    procedure promote_display_better_exact_chunk_path_candidate;
    const
        c_probe_limit = 10;
        c_min_path_quality_gain = 1200;
    var
        top_path_score_local: Integer;
        best_idx_local: Integer;
        best_path_score_local: Integer;
        idx: Integer;
        candidate_path_score_local: Integer;

        function score_exact_chunk_path_local(const candidate_value: TncCandidate;
            const candidate_idx: Integer): Integer;
        var
            encoded_path_local: string;
            path_parts_local: TArray<string>;
            part_idx: Integer;
            part_text_local: string;
            part_units_local: Integer;
            query_key_local: string;
            syllable_pos_local: Integer;
            exact_weight_local: Integer;
            exact_units_local: Integer;
            multi_exact_units_local: Integer;
            non_function_exact_single_count_local: Integer;
            non_exact_units_local: Integer;
            prev_part_text_local: string;
            prev_part_units_local: Integer;
            pair_text_local: string;
            pair_key_local: string;
            combined_units_local: Integer;
            candidate_text_local: string;

            function segment_has_exact_prefix_fixed_tail_local(
                const start_pos_local: Integer; const unit_count_local: Integer;
                const text_local: string): Boolean;
            var
                segment_units_local: TArray<string>;
                prefix_text_local: string;
                prefix_key_local: string;
                unit_idx_local: Integer;
                expected_tail_text_local: string;
            begin
                Result := False;
                if (unit_count_local < 2) or
                    (start_pos_local + unit_count_local > expected_units) then
                begin
                    Exit;
                end;

                expected_tail_text_local := get_display_fixed_tail_text_outer(
                    syllables[start_pos_local + unit_count_local - 1].text);
                if expected_tail_text_local = '' then
                begin
                    Exit;
                end;

                segment_units_local := split_text_units(text_local);
                if (Length(segment_units_local) <> unit_count_local) or
                    (not SameText(Trim(segment_units_local[
                    High(segment_units_local)]), expected_tail_text_local)) then
                begin
                    Exit;
                end;

                prefix_text_local := '';
                for unit_idx_local := 0 to High(segment_units_local) - 1 do
                begin
                    prefix_text_local := prefix_text_local +
                        segment_units_local[unit_idx_local];
                end;
                prefix_key_local := build_display_query_key(start_pos_local,
                    unit_count_local - 1);
                Result := (prefix_key_local <> '') and
                    (prefix_text_local <> '') and
                    display_exact_key_has_text(prefix_key_local,
                    prefix_text_local);
            end;

            function is_function_bridge_single_text_local(
                const text_local: string): Boolean;
            begin
                Result := (text_local = string(Char($4E0D))) or
                    (text_local = string(Char($518D))) or
                    (text_local = string(Char($9AD8))) or
                    (text_local = string(Char($5F88))) or
                    (text_local = string(Char($66F4))) or
                    (text_local = string(Char($6700))) or
                    (text_local = string(Char($592A))) or
                    (text_local = string(Char($8981))) or
                    (text_local = string(Char($80FD))) or
                    (text_local = string(Char($6CA1))) or
                    (text_local = string(Char($65E0))) or
                    (text_local = string(Char($975E))) or
                    (text_local = string(Char($53EF))) or
                    (text_local = string(Char($4F1A))) or
                    (text_local = string(Char($5E94))) or
                    (text_local = string(Char($5C06))) or
                    (text_local = string(Char($672A))) or
                    (text_local = string(Char($5DF2))) or
                    (text_local = string(Char($6B63))) or
                    (text_local = string(Char($53C8))) or
                    (text_local = string(Char($4E5F))) or
                    (text_local = string(Char($8FD8))) or
                    (text_local = string(Char($90FD))) or
                    (text_local = string(Char($5C31))) or
                    (text_local = string(Char($522B))) or
                    (text_local = string(Char($6709))) or
                    (text_local = string(Char($5BF9))) or
                    (text_local = string(Char($5230))) or
                    (text_local = string(Char($4ECE))) or
                    (text_local = string(Char($548C))) or
                    (text_local = string(Char($4E0E))) or
                    (text_local = string(Char($4E8E))) or
                    (text_local = string(Char($628A))) or
                    (text_local = string(Char($88AB))) or
                    (text_local = string(Char($7ED9))) or
                    (text_local = string(Char($8BA9))) or
                    (text_local = string(Char($5728))) or
                    (text_local = string(Char($7684))) or
                    (text_local = string(Char($5730))) or
                    (text_local = string(Char($5F97))) or
                    (text_local = string(Char($6240))) or
                    (text_local = string(Char($662F))) or
                    (text_local = string(Char($53EA))) or
                    (text_local = string(Char($624D))) or
                    (text_local = string(Char($5E76))) or
                    (text_local = string(Char($4E14))) or
                    (text_local = string(Char($4E3A)));
            end;
        begin
            Result := Low(Integer) div 2;
            if (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
                expected_units) then
            begin
                Exit;
            end;

            encoded_path_local := get_display_candidate_path_for_index(
                candidate_value, candidate_idx);
            if get_encoded_path_segment_count_local(encoded_path_local) <= 1 then
            begin
                candidate_text_local := Trim(candidate_value.text);
                if (Trim(candidate_value.comment) = '') and
                    (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    expected_units) and
                    display_exact_key_has_text(normalized_pinyin,
                    candidate_text_local) then
                begin
                    Result := expected_units * 700;
                    if get_display_exact_text_weight(normalized_pinyin,
                        candidate_text_local, expected_units,
                        exact_weight_local) then
                    begin
                        Inc(Result, Min(4800, Max(0,
                            exact_weight_local * 3)));
                    end;
                    if display_candidate_has_base_full_entry(normalized_pinyin,
                        candidate_value) then
                    begin
                        Inc(Result, 600);
                    end;
                    if display_candidate_is_persistent_latest_choice(
                        normalized_pinyin, candidate_text_local) or
                        is_latest_session_query_choice(candidate_text_local) then
                    begin
                        Inc(Result, 2000);
                    end;
                end;
                Exit;
            end;

            path_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            syllable_pos_local := 0;
            exact_units_local := 0;
            multi_exact_units_local := 0;
            non_function_exact_single_count_local := 0;
            non_exact_units_local := 0;
            prev_part_text_local := '';
            prev_part_units_local := 0;
            Result := 0;
            for part_idx := 0 to High(path_parts_local) do
            begin
                part_text_local := Trim(path_parts_local[part_idx]);
                part_units_local := get_candidate_text_unit_count(
                    part_text_local);
                if (part_text_local = '') or (part_units_local <= 0) or
                    (syllable_pos_local + part_units_local > expected_units) then
                begin
                    Result := Low(Integer) div 2;
                    Exit;
                end;

                query_key_local := build_display_query_key(
                    syllable_pos_local, part_units_local);
                if display_exact_key_has_text(query_key_local,
                    part_text_local) then
                begin
                    Inc(exact_units_local, part_units_local);
                    Inc(Result, part_units_local * 1000);
                    if part_units_local >= 2 then
                    begin
                        Inc(multi_exact_units_local, part_units_local);
                        Inc(Result, 360);
                    end;
                    if (part_units_local = 1) and
                        (not is_function_bridge_single_text_local(
                        part_text_local)) then
                    begin
                        Inc(non_function_exact_single_count_local);
                    end;
                    if get_display_exact_text_weight(query_key_local,
                        part_text_local, part_units_local,
                        exact_weight_local) then
                    begin
                        Inc(Result, Min(2200, Max(0,
                            exact_weight_local)) div 2);
                    end;
                end
                else if segment_has_exact_prefix_fixed_tail_local(
                    syllable_pos_local, part_units_local, part_text_local) then
                begin
                    Inc(exact_units_local, part_units_local);
                    Inc(Result, part_units_local * 900);
                    Inc(Result, 420);
                end
                else
                begin
                    Inc(non_exact_units_local, part_units_local);
                    if part_units_local >= 2 then
                    begin
                        Dec(Result, part_units_local * 1600 + 600);
                    end
                    else
                    begin
                        Dec(Result, 260);
                    end;
                end;

                if (prev_part_units_local > 0) and (part_units_local > 0) and
                    (syllable_pos_local > 0) then
                begin
                    combined_units_local := prev_part_units_local + part_units_local;
                    pair_text_local := prev_part_text_local + part_text_local;
                    pair_key_local := build_display_query_key(
                        syllable_pos_local - prev_part_units_local,
                        combined_units_local);
                    if (combined_units_local >= 2) and
                        (combined_units_local <= 4) and (pair_key_local <> '') and
                        (prev_part_units_local = 1) and
                        (part_units_local = 1) and
                        is_function_bridge_single_text_local(prev_part_text_local) and
                        is_function_bridge_single_text_local(part_text_local) and
                        display_exact_key_has_text(pair_key_local,
                        pair_text_local) then
                    begin
                        Inc(Result, 90000);
                    end
                    else if (combined_units_local >= 2) and
                        (combined_units_local <= 4) and (pair_key_local <> '') and
                        (not display_exact_key_has_text(pair_key_local,
                        pair_text_local)) and
                        display_exact_key_has_any_complete_text(pair_key_local,
                        combined_units_local) then
                    begin
                        Dec(Result, 60000 + combined_units_local * 4000);
                    end;
                end;
                Inc(syllable_pos_local, part_units_local);
                prev_part_text_local := part_text_local;
                prev_part_units_local := part_units_local;
            end;

            if syllable_pos_local <> expected_units then
            begin
                Result := Low(Integer) div 2;
                Exit;
            end;

            Inc(Result, get_display_fixed_tail_alignment_score_outer(
                candidate_value));
            Inc(Result, get_display_fixed_quantity_alignment_score_outer(
                candidate_value));
            Inc(Result, exact_units_local * 180);
            Dec(Result, non_exact_units_local * 220);
            if non_exact_units_local = 0 then
            begin
                Inc(Result, 1200);
            end;
            if (multi_exact_units_local >= 4) and
                (non_function_exact_single_count_local > 0) then
            begin
                Dec(Result, non_function_exact_single_count_local * 1400);
            end;
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (expected_units > 18) then
        begin
            Exit;
        end;

        top_path_score_local := score_exact_chunk_path_local(
            m_candidates[0], 0);
        best_idx_local := -1;
        best_path_score_local := top_path_score_local;
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_path_score_local := score_exact_chunk_path_local(
                m_candidates[idx], idx);
            if candidate_path_score_local > best_path_score_local then
            begin
                best_path_score_local := candidate_path_score_local;
                best_idx_local := idx;
            end;
        end;

        if (best_idx_local > 0) and
            (best_path_score_local > top_path_score_local +
            c_min_path_quality_gain) then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_last_syllable_fixed_tail_candidate;
    const
        c_probe_limit = 10;
    var
        expected_tail_text_local: string;
        top_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        idx: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        expected_tail_text_local := get_display_fixed_tail_text_outer(
            syllables[expected_units - 1].text);
        if expected_tail_text_local = '' then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if (Trim(m_candidates[0].comment) = '') and
            (Length(top_units_local) = expected_units) and
            SameText(Trim(top_units_local[High(top_units_local)]),
            expected_tail_text_local) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;
            candidate_units_local := split_text_units(
                Trim(m_candidates[idx].text));
            if (Length(candidate_units_local) <> expected_units) or
                (not SameText(Trim(candidate_units_local[
                High(candidate_units_local)]), expected_tail_text_local)) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]) + Max(0,
                get_segment_path_support_score(m_candidates[idx]));
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_adverbial_de_particle_candidate;
