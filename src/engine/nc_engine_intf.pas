    procedure ensure_best_full_query_exact_candidate_visible;
    const
        c_exact_probe_limit = 16;
        c_min_force_top_exact_rank = 500;
        c_latest_session_exact_rank_bonus = 200000000;
        c_context_exact_rank_bonus = 100000000;
        c_query_choice_exact_rank_bonus = 50000000;
        c_query_choice_exact_rank_scale = 1000;
    var
        exact_results_local: TncCandidateList;
        exact_idx_local: Integer;
        best_candidate_local: TncCandidate;
        best_rank_local: Integer;
        rank_local: Integer;
        best_text_local: string;
        visible_idx_local: Integer;
        target_idx_local: Integer;

        function full_query_exact_candidate_rank_local(
            const candidate_value: TncCandidate; out out_rank: Integer): Boolean;
        var
            candidate_text_local: string;
            candidate_weight_local: Integer;
            query_choice_bonus_local: Integer;
            context_bonus_local: Integer;
            is_persistent_user_entry_local: Boolean;
        begin
            Result := False;
            out_rank := Low(Integer);

            candidate_text_local := Trim(candidate_value.text);
            if (normalized_pinyin = '') or (candidate_text_local = '') or
                (Trim(candidate_value.comment) <> '') or
                (expected_units < 2) or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units) then
            begin
                Exit;
            end;

            query_choice_bonus_local := 0;
            context_bonus_local := get_context_query_latest_bonus(
                candidate_text_local);
            is_persistent_user_entry_local := False;
            if m_dictionary <> nil then
            begin
                query_choice_bonus_local := m_dictionary.get_query_choice_bonus(
                    normalized_pinyin, candidate_text_local);
                is_persistent_user_entry_local := m_dictionary.is_user_entry(
                    normalized_pinyin, candidate_text_local);
            end;

            if (candidate_value.source = cs_user) and
                (not is_persistent_user_entry_local) and
                (not is_latest_session_query_choice(candidate_text_local)) and
                (context_bonus_local <= 0) and
                (query_choice_bonus_local <= 0) then
            begin
                Exit;
            end;

            if candidate_value.has_dict_weight then
            begin
                candidate_weight_local := candidate_value.dict_weight;
            end
            else
            begin
                candidate_weight_local := candidate_value.score;
            end;
            out_rank := candidate_weight_local;

            if is_latest_session_query_choice(candidate_text_local) then
            begin
                Inc(out_rank, c_latest_session_exact_rank_bonus);
            end;

            if context_bonus_local > 0 then
            begin
                Inc(out_rank, c_context_exact_rank_bonus +
                    (context_bonus_local * c_query_choice_exact_rank_scale));
            end;

            if query_choice_bonus_local > 0 then
            begin
                Inc(out_rank, c_query_choice_exact_rank_bonus +
                    (query_choice_bonus_local *
                    c_query_choice_exact_rank_scale));
            end;

            Result := True;
        end;

        function current_top_should_stay_before_exact_local(
            const exact_text_value: string): Boolean;
        var
            top_text_local: string;
            top_query_choice_bonus_local: Integer;
            exact_query_choice_bonus_local: Integer;
        begin
            Result := False;
            if (Length(m_candidates) = 0) or (exact_text_value = '') then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (top_text_local = '') or SameText(top_text_local,
                exact_text_value) or (Trim(m_candidates[0].comment) <> '') or
                (get_candidate_text_unit_count(top_text_local) <>
                expected_units) then
            begin
                Exit;
            end;

            if is_latest_session_query_choice(top_text_local) or
                display_candidate_is_persistent_latest_choice(
                normalized_pinyin, top_text_local) or
                (get_context_query_latest_bonus(top_text_local) > 0) then
            begin
                Exit(True);
            end;

            if m_dictionary <> nil then
            begin
                top_query_choice_bonus_local :=
                    m_dictionary.get_query_choice_bonus(normalized_pinyin,
                    top_text_local);
                exact_query_choice_bonus_local :=
                    m_dictionary.get_query_choice_bonus(normalized_pinyin,
                    exact_text_value);
                if top_query_choice_bonus_local > exact_query_choice_bonus_local
                then
                begin
                    Exit(True);
                end;

                if (m_candidates[0].source = cs_user) and
                    m_dictionary.is_user_entry(normalized_pinyin,
                    top_text_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function current_top_is_complete_display_candidate_local: Boolean;
        var
            top_text_local: string;
        begin
            Result := False;
            if Length(m_candidates) = 0 then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            Result := (top_text_local <> '') and
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(top_text_local) =
                expected_units);
        end;
    begin
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (expected_units < 2) or
            (Pos('''', normalized_pinyin) > 0) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_normalized_from) > 0) or
            (not m_dictionary.lookup_exact_full_pinyin(normalized_pinyin,
            exact_results_local)) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' fqens=[lookup-miss]';
            end;
            Exit;
        end;

        best_rank_local := Low(Integer);
        best_text_local := '';
        for exact_idx_local := 0 to High(exact_results_local) do
        begin
            if exact_idx_local >= c_exact_probe_limit then
            begin
                Break;
            end;

            if not full_query_exact_candidate_rank_local(
                exact_results_local[exact_idx_local], rank_local) then
            begin
                Continue;
            end;

            if (best_text_local = '') or (rank_local > best_rank_local) then
            begin
                best_rank_local := rank_local;
                best_candidate_local := exact_results_local[exact_idx_local];
                best_text_local := Trim(best_candidate_local.text);
            end;
        end;

        if best_text_local = '' then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' fqens=[no-best n=%d]', [Length(exact_results_local)]);
            end;
            Exit;
        end;

        target_idx_local := 0;
        if ((expected_units = 3) and
            (best_rank_local < c_min_force_top_exact_rank) and
            current_top_is_complete_display_candidate_local) or
            current_top_should_stay_before_exact_local(best_text_local) then
        begin
            target_idx_local := Min(1, Length(m_candidates));
        end;

        visible_idx_local := find_display_candidate(best_text_local, '');
        if visible_idx_local >= 0 then
        begin
            if visible_idx_local <> target_idx_local then
            begin
                move_display_candidate_to_index(visible_idx_local,
                    target_idx_local);
            end;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' fqens=[move %d->%d %s]', [visible_idx_local,
                    target_idx_local, best_text_local]);
            end;
            Exit;
        end;

        insert_display_candidate(best_candidate_local, best_text_local,
            target_idx_local);
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' fqens=[insert %d %s rank=%d]', [target_idx_local,
                best_text_local, best_rank_local]);
        end;
    end;

    procedure move_display_candidate_to_front(const candidate_idx: Integer);
    var
        idx: Integer;
        target_idx: Integer;
        moved_candidate: TncCandidate;
        moved_path: string;
    begin
        if (candidate_idx < 0) or (candidate_idx > High(m_candidates)) then
        begin
            Exit;
        end;

        moved_candidate := m_candidates[candidate_idx];
        target_idx := 0;
        if should_keep_display_top_before_candidate(moved_candidate) then
        begin
            target_idx := Min(1, High(m_candidates));
        end;
        if candidate_idx = target_idx then
        begin
            Exit;
        end;

        moved_path := '';
        if candidate_idx < Length(m_candidate_segment_paths) then
        begin
            moved_path := m_candidate_segment_paths[candidate_idx];
        end;

        if candidate_idx > target_idx then
        begin
            for idx := candidate_idx downto target_idx + 1 do
            begin
                m_candidates[idx] := m_candidates[idx - 1];
                if idx < Length(m_candidate_segment_paths) then
                begin
                    if idx - 1 < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[idx] :=
                            m_candidate_segment_paths[idx - 1];
                    end
                    else
                    begin
                        m_candidate_segment_paths[idx] := '';
                    end;
                end;
            end;
        end
        else
        begin
            for idx := candidate_idx to target_idx - 1 do
            begin
                m_candidates[idx] := m_candidates[idx + 1];
                if idx < Length(m_candidate_segment_paths) then
                begin
                    if idx + 1 < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[idx] :=
                            m_candidate_segment_paths[idx + 1];
                    end
                    else
                    begin
                        m_candidate_segment_paths[idx] := '';
                    end;
                end;
            end;
        end;

        m_candidates[target_idx] := moved_candidate;
        if target_idx < Length(m_candidate_segment_paths) then
        begin
            m_candidate_segment_paths[target_idx] := moved_path;
        end;
    end;

