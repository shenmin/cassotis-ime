            Result := False;
            top_units_local := split_text_units(Trim(m_candidates[0].text));
            candidate_units_local := split_text_units(Trim(candidate_value.text));
            if (Length(top_units_local) <> expected_units) or
                (Length(candidate_units_local) <> expected_units) then
            begin
                Exit;
            end;

            for span_len_local := Min(c_max_span_units, expected_units) downto 2 do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    span_touches_diff_local := False;
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        if not SameText(top_units_local[unit_idx_local],
                            candidate_units_local[unit_idx_local]) then
                        begin
                            span_touches_diff_local := True;
                            Break;
                        end;
                    end;
                    if not span_touches_diff_local then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(start_idx_local,
                        span_len_local);
                    top_span_text_local := join_units_range_local(top_units_local,
                        start_idx_local, span_len_local);
                    candidate_span_text_local := join_units_range_local(
                        candidate_units_local, start_idx_local, span_len_local);
                    if SameText(top_span_text_local, candidate_span_text_local) then
                    begin
                        Continue;
                    end;

                    top_span_weight_local := 0;
                    candidate_span_weight_local := 0;
                    if (query_key_local <> '') and
                        get_display_exact_text_weight(query_key_local,
                        top_span_text_local, span_len_local,
                        top_span_weight_local) and
                        get_display_exact_text_weight(query_key_local,
                        candidate_span_text_local, span_len_local,
                        candidate_span_weight_local) and
                        (top_span_weight_local >= c_min_protected_exact_weight) and
                        (top_span_weight_local >= candidate_span_weight_local +
                        c_protected_exact_margin) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;
    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 6) or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_score_local := m_candidates[0].score;
        best_idx_local := -1;
        best_advantage_local := c_min_advantage - 1;
        for idx_local := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx_local].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_score_local := m_candidates[idx_local].score;
            if candidate_score_local + c_max_score_deficit < top_score_local then
            begin
                Continue;
            end;

            advantage_local :=
                get_diff_exact_span_advantage_against_top(m_candidates[idx_local]);
            if (advantage_local >= c_min_advantage) and
                (advantage_local < c_strong_advantage_override) and
                candidate_replaces_stronger_same_position_exact_span(
                m_candidates[idx_local]) then
            begin
                Continue;
            end;
            if (advantage_local >= c_min_advantage) and
                display_candidate_replaces_protected_conjunction_boundary(
                m_candidates[idx_local]) then
            begin
                Continue;
            end;
            if advantage_local > best_advantage_local then
            begin
                best_advantage_local := advantage_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

