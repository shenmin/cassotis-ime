                for local_idx_value := 0 to High(local_results_value) do
                begin
                    if local_idx_value >= c_protected_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(local_results_value[local_idx_value].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results_value[local_idx_value].dict_weight,
                        local_results_value[local_idx_value].has_dict_weight) then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(local_results_value[local_idx_value]) or
                        is_runtime_common_pattern_candidate(
                        local_results_value[local_idx_value]) or
                        is_runtime_redup_candidate(
                        local_results_value[local_idx_value]) then
                    begin
                        Continue;
                    end;

                    local_text_value := Trim(local_results_value[local_idx_value].text);
                    if (local_text_value = '') or
                        (get_candidate_text_unit_count(local_text_value) <>
                        local_len_value) then
                    begin
                        Continue;
                    end;

                    local_weight_value :=
                        get_effective_candidate_weight_local(
                        local_results_value[local_idx_value]);
                    if local_weight_value < c_protected_min_weight_local then
                    begin
                        Continue;
                    end;

                    if local_weight_value > best_weight_value then
                    begin
                        best_text_value := local_text_value;
                        best_weight_value := local_weight_value;
                        best_rank_value := local_idx_value + 1;
                    end;
                end;
                if best_text_value <> '' then
                begin
                    out_text_value := best_text_value;
                    out_weight_value := best_weight_value;
                    out_rank_value := best_rank_value;
                    Result := True;
                end;
            end;

            function get_protected_span_overlap_adjustment_local(
                const local_pos_value: Integer; const local_span_len_value: Integer;
                const local_text_value: string): Integer;
            var
                span_start_value: Integer;
                span_len_value: Integer;
                protected_text_value: string;
                protected_weight_value: Integer;
                protected_rank_value: Integer;
                local_units_value: TArray<string>;
                protected_units_value: TArray<string>;
                overlap_start_value: Integer;
                overlap_end_value: Integer;
                unit_pos_value: Integer;
                mismatch_value: Boolean;
                penalty_value: Integer;
                exact_bonus_value: Integer;

                function is_confident_protected_span_local(
                    const span_len_local: Integer; const span_weight_local: Integer;
                    const span_rank_local: Integer): Boolean;
                begin
                    Result := False;
                    if span_rank_local <= 0 then
                    begin
                        Exit;
                    end;

                    if span_rank_local = 1 then
                    begin
                        case span_len_local of
                            2:
                                Result := span_weight_local >= 650;
                            3:
                                Result := span_weight_local >= 420;
                            4:
                                Result := span_weight_local >= 360;
                        end;
                    end
                    else if (span_rank_local = 2) and (span_len_local >= 3) then
                    begin
                        Result := span_weight_local >= 900;
                    end
                    else if (span_rank_local <= 4) then
                    begin
                        case span_len_local of
                            2:
                                Result := span_weight_local >= 900;
                            3:
                                Result := span_weight_local >= 760;
                            4:
                                Result := span_weight_local >= 680;
                        end;
                    end;
                end;
            begin
                Result := 0;
                if (local_text_value = '') or (local_span_len_value <= 0) then
                begin
                    Exit;
                end;

                if (local_span_len_value >= 2) and
                    try_get_protected_span_text_local(local_pos_value,
                    local_span_len_value, protected_text_value,
                    protected_weight_value, protected_rank_value) and
                    is_confident_protected_span_local(local_span_len_value,
                    protected_weight_value, protected_rank_value) and
                    SameText(protected_text_value, local_text_value) then
                begin
                    exact_bonus_value := 180 + (local_span_len_value * 120) +
                        Min(520, protected_weight_value div 3);
                    if protected_rank_value > 1 then
                    begin
                        Dec(exact_bonus_value, (protected_rank_value - 1) * 160);
                    end;
                    if exact_bonus_value > 0 then
                    begin
                        Inc(Result, exact_bonus_value);
                    end;
                end;

                local_units_value := split_text_units(Trim(local_text_value));
                if Length(local_units_value) <> local_span_len_value then
                begin
                    Exit;
                end;

                for span_start_value := Max(0, local_pos_value - 3) to
                    Min(local_pos_value + local_span_len_value - 1,
                    Length(syllables_local) - 1) do
                begin
                    for span_len_value := 2 to 4 do
                    begin
                        if span_start_value + span_len_value >
                            Length(syllables_local) then
                        begin
                            Break;
                        end;
                        if (span_start_value = local_pos_value) and
                            (span_len_value = local_span_len_value) then
                        begin
                            Continue;
                        end;
                        if (span_start_value >= local_pos_value +
                            local_span_len_value) or
                            (local_pos_value >= span_start_value +
                            span_len_value) then
                        begin
                            Continue;
                        end;
                        if not try_get_protected_span_text_local(
                            span_start_value, span_len_value,
                            protected_text_value, protected_weight_value,
                            protected_rank_value) then
                        begin
                            Continue;
                        end;
                        if not is_confident_protected_span_local(span_len_value,
                            protected_weight_value, protected_rank_value) then
                        begin
                            Continue;
                        end;

                        protected_units_value :=
                            split_text_units(Trim(protected_text_value));
                        if Length(protected_units_value) <> span_len_value then
                        begin
                            Continue;
                        end;

                        overlap_start_value := Max(local_pos_value,
                            span_start_value);
                        overlap_end_value := Min(local_pos_value +
                            local_span_len_value, span_start_value + span_len_value);
                        if (overlap_end_value - overlap_start_value) <= 0 then
                        begin
                            Continue;
                        end;
                        mismatch_value := False;
                        for unit_pos_value := overlap_start_value to
                            overlap_end_value - 1 do
                        begin
                            if not SameText(
                                local_units_value[unit_pos_value -
                                local_pos_value],
                                protected_units_value[unit_pos_value -
                                span_start_value]) then
                            begin
                                mismatch_value := True;
                                Break;
                            end;
                        end;
                        if not mismatch_value then
                        begin
                            Continue;
                        end;

                        penalty_value := 360 + (span_len_value * 160) +
                            ((overlap_end_value - overlap_start_value) * 220) +
                            Min(1800, protected_weight_value);
                        if protected_rank_value > 1 then
                        begin
                            Dec(penalty_value, (protected_rank_value - 1) * 260);
                        end;
                        if penalty_value > 0 then
                        begin
                            Dec(Result, penalty_value);
                        end;
                    end;
                end;
            end;

            function build_span_score_local(const candidate_local: TncCandidate;
                const local_pos_value: Integer; const local_span_len_value: Integer;
                const local_rank_value: Integer): Integer;
            begin
                Result := get_effective_candidate_weight_local(candidate_local) *
                    c_weight_scale_local;
                case local_span_len_value of
                    1:
                        Dec(Result, c_single_unit_penalty_local);
                    2:
                        Inc(Result, c_two_unit_bonus_local);
                    3:
                        Inc(Result, c_three_unit_bonus_local);
                else
                    Inc(Result, c_long_unit_bonus_local +
                        Max(0, local_span_len_value - 4) *
                        c_per_extra_unit_bonus_local);
                end;
                if (local_pos_value = 0) and
                    (local_span_len_value = input_syllable_count) and
                    (input_syllable_count >= 4) then
                begin
                    Inc(Result, c_full_query_exact_bonus_local);
                end;
                if candidate_local.source = cs_user then
                begin
                    Inc(Result, 1200);
                end;
                Inc(Result, get_temporal_process_context_bonus_local(
                    Trim(candidate_local.text), local_pos_value));
                Inc(Result, get_protected_span_overlap_adjustment_local(
                    local_pos_value, local_span_len_value,
                    Trim(candidate_local.text)));
                Dec(Result, local_rank_value * c_candidate_rank_penalty_local);
            end;

            function take_trailing_text_units_local(const value: string;
                const max_units: Integer): string;
            var
                units_local: TArray<string>;
                unit_idx_local: Integer;
                start_idx_local: Integer;
            begin
                Result := '';
                if (Trim(value) = '') or (max_units <= 0) then
                begin
                    Exit;
                end;

                units_local := split_text_units(Trim(value));
                if Length(units_local) <= 0 then
                begin
                    Exit;
                end;

                start_idx_local := Length(units_local) - max_units;
                if start_idx_local < 0 then
                begin
                    start_idx_local := 0;
                end;

                for unit_idx_local := start_idx_local to High(units_local) do
                begin
                    Result := Result + units_local[unit_idx_local];
                end;
            end;

            function get_exact_base_prefix_transition_bonus_local(
                const prev_prev_text: string; const prev_text: string;
                const candidate_text: string): Integer;
            const
                c_prefix_bonus_cap = 2200;
            var
                combined_text_local: string;
                raw_bonus_local: Integer;
                best_bonus_local: Integer;
            begin
                Result := 0;
                if (m_dictionary = nil) or (Trim(prev_text) = '') or
                    (Trim(candidate_text) = '') then
                begin
                    Exit;
                end;

                best_bonus_local := 0;

                combined_text_local := take_trailing_text_units_local(
                    Trim(prev_text) + Trim(candidate_text), 6);
                if get_candidate_text_unit_count(combined_text_local) >= 2 then
                begin
                    raw_bonus_local :=
                        get_sentence_text_prefix_bonus_local(
                        combined_text_local);
                    if raw_bonus_local > best_bonus_local then
                    begin
                        best_bonus_local := raw_bonus_local;
                    end;
                end;

                if Trim(prev_prev_text) <> '' then
                begin
                    combined_text_local := take_trailing_text_units_local(
                        Trim(prev_prev_text) + Trim(prev_text) +
                        Trim(candidate_text), 6);
                    if get_candidate_text_unit_count(
                        combined_text_local) >= 2 then
                    begin
                        raw_bonus_local :=
                            get_sentence_text_prefix_bonus_local(
                            combined_text_local);
                        if raw_bonus_local > best_bonus_local then
                        begin
                            best_bonus_local := raw_bonus_local;
                        end;
                    end;
                end;

                if best_bonus_local > 0 then
                begin
                    Result := Min(c_prefix_bonus_cap,
                        (best_bonus_local * 3) div 4);
                end;
            end;

            function get_transition_bonus_local(
                const prev_prev_text: string; const prev_text: string;
                const candidate_text: string): Integer;
            const
                c_temporal_process_transition_bonus = 12000;
            var
                cache_key_local: string;
                pair_bonus_local: Integer;
                trigram_bonus_local: Integer;
                prefix_bonus_local: Integer;
            begin
                Result := 0;
                if (Trim(prev_text) = '') or (Trim(candidate_text) = '') then
                begin
                    Exit;
                end;

                cache_key_local := LowerCase(Trim(prev_prev_text)) + #1 +
                    LowerCase(Trim(prev_text)) + #1 +
                    LowerCase(Trim(candidate_text));
                if (transition_bonus_cache_local <> nil) and
                    transition_bonus_cache_local.TryGetValue(cache_key_local,
                    Result) then
                begin
                    Exit;
                end;

                pair_bonus_local := 0;
                trigram_bonus_local := 0;
                prefix_bonus_local := 0;
                if m_dictionary <> nil then
                begin
                    pair_bonus_local := m_dictionary.get_context_bonus(
                        prev_text, candidate_text);
                    if Trim(prev_prev_text) <> '' then
                    begin
                        trigram_bonus_local :=
                            m_dictionary.get_context_trigram_bonus(
                            prev_prev_text, prev_text, candidate_text);
                    end;
                    prefix_bonus_local :=
                        get_exact_base_prefix_transition_bonus_local(
                        prev_prev_text, prev_text, candidate_text);
                end;

                if trigram_bonus_local > 0 then
                begin
                    Result := trigram_bonus_local + (pair_bonus_local div 2);
                end
                else
                begin
                    Result := pair_bonus_local;
                end;

                if prefix_bonus_local > 0 then
                begin
                    if Result > 0 then
                    begin
                        Inc(Result, prefix_bonus_local div 2);
                    end
                    else
                    begin
                        Result := prefix_bonus_local;
                    end;
                end;

                if Result > 0 then
                begin
                    Result := Result * c_transition_bonus_scale_local;
                end;

                if (SameText(Trim(prev_text), string(Char($7684))) or
                    SameText(Trim(prev_text), string(Char($5730))) or
                    SameText(Trim(prev_text), string(Char($5F97))) or
                    SameText(Trim(prev_text), string(Char($4E4B)))) and
                    is_temporal_process_span_text_local(Trim(candidate_text)) then
                begin
                    Inc(Result, c_temporal_process_transition_bonus);
                end;

                if transition_bonus_cache_local <> nil then
                begin
                    transition_bonus_cache_local.AddOrSetValue(cache_key_local,
                        Result);
                end;
            end;

            function has_exact_phrase_span_local(const local_pos_value: Integer;
                const local_span_len_value: Integer): Boolean;
            var
                local_key_value: string;
                local_results_value: TncCandidateList;
                local_idx_value: Integer;
            begin
                Result := False;
                if local_span_len_value < 2 then
                begin
                    Exit;
                end;

                local_key_value := build_query_key_local(local_pos_value,
                    local_span_len_value);
                if not lookup_exact_full_pinyin_cached_local(local_key_value,
                    local_results_value) then
                begin
                    Exit;
                end;

                for local_idx_value := 0 to High(local_results_value) do
                begin
                    if Trim(local_results_value[local_idx_value].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results_value[local_idx_value].dict_weight,
                        local_results_value[local_idx_value].has_dict_weight) then
                    begin
                        Continue;
                    end;
                    if get_candidate_text_unit_count(
                        Trim(local_results_value[local_idx_value].text)) =
                        local_span_len_value then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function has_exact_phrase_ending_at_local(
                const local_end_idx_value: Integer): Boolean;
            var
                local_start_idx_value: Integer;
                local_span_len_value: Integer;
            begin
                Result := False;
                for local_start_idx_value := Max(0,
                    local_end_idx_value - c_max_span + 1) to
                    local_end_idx_value - 1 do
                begin
                    local_span_len_value := local_end_idx_value -
                        local_start_idx_value + 1;
                    if has_exact_phrase_span_local(local_start_idx_value,
                        local_span_len_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function candidate_breaks_stable_boundary_local(
                const local_text_value: string; const local_pos_value: Integer;
                const local_span_len_value: Integer;
                const local_candidate_weight_value: Integer): Boolean;
            var
                local_units_value: TArray<string>;
                local_split_idx_value: Integer;
                local_stable_text_value: string;
                protected_span_len_value: Integer;
                protected_text_value: string;
                protected_weight_value: Integer;
                protected_rank_value: Integer;
                protected_units_value: TArray<string>;
                overlap_len_value: Integer;
                overlap_idx_value: Integer;
                mismatch_value: Boolean;

                function is_confident_following_span_value(
                    const span_len_value: Integer;
                    const span_weight_value: Integer;
                    const span_rank_value: Integer): Boolean;
                begin
                    Result := False;
                    if span_rank_value <= 0 then
                    begin
                        Exit;
                    end;
                    if span_rank_value = 1 then
                    begin
                        case span_len_value of
                            2:
                                Result := span_weight_value >= 900;
                            3:
                                Result := span_weight_value >= 520;
                            4:
                                Result := span_weight_value >= 420;
                        end;
                    end
                    else if span_rank_value <= 4 then
                    begin
                        case span_len_value of
                            2:
                                Result := span_weight_value >= 900;
                            3:
                                Result := span_weight_value >= 760;
                            4:
                                Result := span_weight_value >= 680;
                        end;
                    end;
                end;
            begin
                Result := False;
                if local_span_len_value < 2 then
                begin
                    Exit;
                end;

                local_units_value := split_text_units(Trim(local_text_value));
                if Length(local_units_value) <> local_span_len_value then
                begin
                    Exit;
                end;

                for local_split_idx_value := 1 to local_span_len_value - 1 do
                begin
                    for protected_span_len_value := Min(4,
                        Length(syllables_local) - local_pos_value -
                        local_split_idx_value) downto 2 do
                    begin
                        if not try_get_protected_span_text_local(
                            local_pos_value + local_split_idx_value,
                            protected_span_len_value, protected_text_value,
                            protected_weight_value, protected_rank_value) then
                        begin
                            Continue;
                        end;
                        if not is_confident_following_span_value(
                            protected_span_len_value, protected_weight_value,
                            protected_rank_value) then
                        begin
                            Continue;
                        end;

                        protected_units_value := split_text_units(
                            Trim(protected_text_value));
                        if Length(protected_units_value) <>
                            protected_span_len_value then
                        begin
                            Continue;
                        end;
                        overlap_len_value := Min(local_span_len_value -
                            local_split_idx_value, protected_span_len_value);
                        mismatch_value := False;
                        for overlap_idx_value := 0 to overlap_len_value - 1 do
                        begin
                            if not SameText(local_units_value[
                                local_split_idx_value + overlap_idx_value],
                                protected_units_value[overlap_idx_value]) then
                            begin
                                mismatch_value := True;
                                Break;
                            end;
                        end;
                        if mismatch_value and
                            (local_candidate_weight_value <=
                            protected_weight_value + 220) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

                local_stable_text_value := get_fixed_single_text_local(
                    syllables_local[local_pos_value].text);
                if (local_stable_text_value <> '') and
                    (not SameText(local_units_value[0], local_stable_text_value)) and
                    (local_span_len_value = 2) and
                    (local_candidate_weight_value <
                    c_weak_fixed_head_phrase_weight) then
                begin
                    Exit(True);
                end;
                if (local_stable_text_value <> '') and
                    (not SameText(local_units_value[0], local_stable_text_value)) and
                    has_exact_phrase_span_local(local_pos_value + 1,
                    local_span_len_value - 1) then
                begin
                    Exit(True);
                end;

                local_stable_text_value := get_fixed_single_text_local(
                    syllables_local[local_pos_value + local_span_len_value - 1].text);
                if (local_stable_text_value <> '') and
                    (not SameText(local_units_value[local_span_len_value - 1],
                    local_stable_text_value)) and
                    has_exact_phrase_ending_at_local(
                    local_pos_value + local_span_len_value - 2) then
                begin
                    Exit(True);
                end;

                for local_split_idx_value := 1 to local_span_len_value - 1 do
                begin
                    local_stable_text_value := get_fixed_single_text_local(
                        syllables_local[local_pos_value + local_split_idx_value].text);
                    if local_stable_text_value = '' then
                    begin
                        Continue;
                    end;
                    if SameText(local_units_value[local_split_idx_value],
                        local_stable_text_value) then
                    begin
                        Continue;
                    end;
                    if has_exact_phrase_span_local(local_pos_value,
                        local_split_idx_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function chain_option_is_nonbase_two_plus_single_local(
                const local_query_key_value: string;
                const local_span_len_value: Integer;
                const local_text_value: string): Boolean;
            var
                local_syllables_value: TncPinyinParseResult;
                local_units_value: TArray<string>;
                local_head_key_value: string;
                local_tail_key_value: string;
                local_tail_syllable_value: string;
                local_head_text_value: string;
                local_tail_text_value: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (local_span_len_value <> 3) then
                begin
                    Exit;
                end;
                if m_dictionary.is_base_entry(local_query_key_value,
                    local_text_value) or
                    m_dictionary.is_user_entry(local_query_key_value,
                    local_text_value) then
                begin
                    Exit;
                end;

                local_syllables_value := get_effective_compact_pinyin_syllables(
                    local_query_key_value);
                local_units_value := split_text_units(Trim(local_text_value));
                if (Length(local_syllables_value) <> 3) or
                    (Length(local_units_value) <> 3) then
                begin
                    Exit;
                end;

                local_tail_syllable_value := normalize_pinyin_text(
                    local_syllables_value[2].text);
                if (local_tail_syllable_value = 'de') or
                    (local_tail_syllable_value = 'le') or
                    (local_tail_syllable_value = 'la') or
                    (local_tail_syllable_value = 'ba') or
                    (local_tail_syllable_value = 'ma') then
                begin
                    Exit;
                end;

                local_head_key_value := normalize_pinyin_text(
                    local_syllables_value[0].text) +
                    normalize_pinyin_text(local_syllables_value[1].text);
                local_tail_key_value := local_tail_syllable_value;
                local_head_text_value := local_units_value[0] +
                    local_units_value[1];
                local_tail_text_value := local_units_value[2];

                Result := direct_exact_lookup_has_text_local(local_head_key_value,
                    local_head_text_value, 2) and
                    (direct_exact_lookup_has_text_local(local_tail_key_value,
                    local_tail_text_value, 1) or
                    m_dictionary.single_char_matches_pinyin(local_tail_key_value,
                    local_tail_text_value));
            end;

            function compare_chain_state_local(
                const left_local: TExactChainStateLocal;
                const right_local: TExactChainStateLocal): Integer;
            begin
                Result := left_local.score - right_local.score;
                if Result <> 0 then
                begin
                    Exit;
                end;
                Result := left_local.path_preference_score -
                    right_local.path_preference_score;
                if Result <> 0 then
                begin
                    Exit;
                end;
                Result := right_local.single_count - left_local.single_count;
                if Result <> 0 then
                begin
                    Exit;
                end;
                Result := right_local.segment_count - left_local.segment_count;
                if Result <> 0 then
                begin
                    Exit;
                end;
                Result := left_local.phrase_count - right_local.phrase_count;
                if Result <> 0 then
                begin
                    Exit;
                end;
                Result := Length(right_local.path_text) -
                    Length(left_local.path_text);
            end;

            procedure sort_chain_states_local(
                var states_local: TExactChainStateListLocal);
            var
                left_idx_local: Integer;
                right_idx_local: Integer;
                tmp_state_local: TExactChainStateLocal;
            begin
                for left_idx_local := 0 to High(states_local) do
                begin
                    for right_idx_local := left_idx_local + 1 to High(states_local) do
                    begin
                        if compare_chain_state_local(states_local[right_idx_local],
                            states_local[left_idx_local]) > 0 then
                        begin
                            tmp_state_local := states_local[left_idx_local];
                            states_local[left_idx_local] := states_local[right_idx_local];
                            states_local[right_idx_local] := tmp_state_local;
                        end;
                    end;
                end;
            end;

            procedure remember_chain_state_local(
                var states_local: TExactChainStateListLocal;
                const state_local: TExactChainStateLocal);
            var
                idx_local: Integer;
                state_key_local: string;
                existing_key_local: string;
            begin
                if Trim(state_local.text) = '' then
                begin
                    Exit;
                end;

                state_key_local := LowerCase(Trim(state_local.prev_prev_text)) +
                    #1 + LowerCase(Trim(state_local.prev_text)) + #1 +
                    IntToStr(Min(state_local.single_count, 4)) + #1 +
                    IntToStr(Min(state_local.phrase_count, 4)) + #1 +
                    IntToStr(Min(state_local.segment_count, 8));

                for idx_local := 0 to High(states_local) do
                begin
                    existing_key_local :=
                        LowerCase(Trim(states_local[idx_local].prev_prev_text)) +
                        #1 + LowerCase(Trim(states_local[idx_local].prev_text)) +
                        #1 + IntToStr(Min(states_local[idx_local].single_count, 4)) +
                        #1 + IntToStr(Min(states_local[idx_local].phrase_count, 4)) +
                        #1 + IntToStr(Min(states_local[idx_local].segment_count, 8));
                    if SameText(existing_key_local, state_key_local) then
                    begin
                        if compare_chain_state_local(state_local,
                            states_local[idx_local]) > 0 then
                        begin
                            states_local[idx_local] := state_local;
                            sort_chain_states_local(states_local);
                        end;
                        Exit;
                    end;
                end;

                SetLength(states_local, Length(states_local) + 1);
                states_local[High(states_local)] := state_local;
                sort_chain_states_local(states_local);
                if Length(states_local) > state_keep_limit_local then
                begin
                    SetLength(states_local, state_keep_limit_local);
                end;
            end;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := 0;
            out_phrase_count := 0;
            transition_bonus_cache_local := TDictionary<string, Integer>.Create;
            suffix_first_unit_cache_local := TDictionary<Integer, string>.Create;
            try
                state_keep_limit_local := c_state_keep_limit_local;
                multi_candidate_limit_local := c_multi_candidate_limit_local;
                if Length(syllables_local) >= 12 then
                begin
                    state_keep_limit_local := 5;
                    multi_candidate_limit_local := 3;
                end
                else if Length(syllables_local) >= 8 then
                begin
                    state_keep_limit_local := 6;
                    multi_candidate_limit_local := 3;
                end
                else if Length(syllables_local) >= 6 then
                begin
                    state_keep_limit_local := 7;
                    multi_candidate_limit_local := 3;
                end;

                SetLength(best_states_local, Length(syllables_local) + 1);
                SetLength(best_states_local[0], 1);
                best_states_local[0][0].text := '';
                best_states_local[0][0].path_text := '';
                best_states_local[0][0].prev_text := '';
                best_states_local[0][0].prev_prev_text := '';
                best_states_local[0][0].score := 0;
                best_states_local[0][0].path_preference_score := 0;
                best_states_local[0][0].segment_count := 0;
                best_states_local[0][0].phrase_count := 0;
                best_states_local[0][0].single_count := 0;

                for pos_local := 0 to Length(syllables_local) - 1 do
                begin
                    if Length(best_states_local[pos_local]) = 0 then
                    begin
                        Continue;
                    end;

                    for span_len_local := 1 to Min(get_effective_max_span_local,
                        Length(syllables_local) - pos_local) do
                    begin
                        span_key_local := build_query_key_local(pos_local,
                            span_len_local);
                        SetLength(exact_results_local, 0);
                        if not lookup_exact_full_pinyin_cached_local(
                            span_key_local, exact_results_local) and
                            (span_len_local = 1) and (m_dictionary <> nil) then
                        begin
                            m_dictionary.lookup(span_key_local,
                                exact_results_local);
                        end;

                        if span_len_local = 1 then
                        begin
                            candidate_limit_local :=
                                c_single_candidate_limit_local;
                        end
                        else
                        begin
                            candidate_limit_local :=
                                multi_candidate_limit_local;
                        end;
                        next_pos_local := pos_local + span_len_local;

                        for state_idx_local := 0 to
                            High(best_states_local[pos_local]) do
                        begin
                            base_state_local :=
                                best_states_local[pos_local][state_idx_local];
                            for option_idx_local := 0 to High(exact_results_local) do
                            begin
                                if option_idx_local >= candidate_limit_local then
                                begin
                                    Break;
                                end;

                                option_candidate_local :=
                                    exact_results_local[option_idx_local];
                                if Trim(option_candidate_local.comment) <> '' then
                                begin
                                    Continue;
                                end;
                                if (span_len_local >= 2) and
                                    (not long_exact_chunk_weight_is_eligible(
                                    option_candidate_local.dict_weight,
                                    option_candidate_local.has_dict_weight)) then
                                begin
                                    Continue;
                                end;

                                option_text_local := Trim(
                                    option_candidate_local.text);
                                option_units_local :=
                                    get_candidate_text_unit_count(
                                    option_text_local);
                                if (option_text_local = '') or
                                    (option_units_local <> span_len_local) then
                                begin
                                    Continue;
                                end;
                                if chain_option_is_nonbase_two_plus_single_local(
                                    span_key_local, span_len_local,
                                    option_text_local) then
                                begin
                                    Continue;
                                end;
                                if candidate_breaks_stable_boundary_local(
                                    option_text_local, pos_local,
                                    span_len_local,
                                    get_effective_candidate_weight_local(
                                    option_candidate_local)) then
                                begin
                                    Continue;
                                end;
                                if span_len_local = 1 then
                                begin
                                    option_is_preferred_local := False;
                                    if not match_single_char_candidate_for_syllable(
                                        syllables_local[pos_local].text,
                                        option_text_local,
                                        option_is_preferred_local) or
                                        (not option_is_preferred_local) then
                                    begin
                                        Continue;
                                    end;
                                    if not SameText(option_text_local,
                                        get_fixed_single_text_local(
                                        syllables_local[pos_local].text)) then
                                    begin
                                        Continue;
                                    end;
                                end;

                                option_score_local := build_span_score_local(
                                    option_candidate_local, pos_local,
                                    span_len_local, option_idx_local);
                                Inc(option_score_local,
                                    get_yu_following_context_adjustment_local(
                                    syllables_local[next_pos_local - 1].text,
                                    option_text_local, next_pos_local));
                                direction_bonus_local :=
                                    get_directional_locative_span_bonus_local(
                                    option_text_local);
                                direction_context_bonus_local :=
                                    get_directional_locative_context_bonus_local(
                                    option_text_local, pos_local,
                                    span_len_local);
                                Inc(option_score_local,
                                    direction_bonus_local);
                                Inc(option_score_local,
                                    direction_context_bonus_local);
                                Dec(option_score_local,
                                    get_crossing_previous_exact_phrase_penalty_local(
                                    pos_local, span_len_local));
                                Dec(option_score_local,
                                    get_stronger_split_span_penalty_local(
                                    pos_local, span_len_local,
                                    get_effective_candidate_weight_local(
                                    option_candidate_local)));
                                if (span_len_local = 2) and
                                    (normalize_pinyin_text(
                                    syllables_local[pos_local].text) = 'yi') then
                                begin
                                    candidate_units_local :=
                                        split_text_units(option_text_local);
                                    if (Length(candidate_units_local) = 2) and
                                        (candidate_units_local[0] =
                                        string(Char($4E00))) and
                                        is_quantity_tail_unit_local(
                                        candidate_units_local[1]) then
                                    begin
                                        Inc(option_score_local,
                                            c_quantity_tail_bonus);
                                    end;
                                end;
                                transition_bonus_local :=
                                    get_transition_bonus_local(
                                    base_state_local.prev_prev_text,
                                    base_state_local.prev_text,
                                    option_text_local);

                                combined_state_local.text :=
                                    base_state_local.text + option_text_local;
                                combined_state_local.path_text :=
                                    combine_path_segments_local(
                                    base_state_local.path_text,
                                    option_text_local);
                                combined_state_local.prev_prev_text :=
                                    base_state_local.prev_text;
                                combined_state_local.prev_text :=
                                    option_text_local;
                                combined_state_local.segment_count :=
                                    base_state_local.segment_count + 1;
                                combined_state_local.phrase_count :=
                                    base_state_local.phrase_count;
                                if span_len_local >= 2 then
                                begin
                                    Inc(combined_state_local.phrase_count);
                                end;
                                combined_state_local.single_count :=
                                    base_state_local.single_count;
                                if span_len_local = 1 then
                                begin
                                    Inc(combined_state_local.single_count);
                                end;
                                combined_state_local.path_preference_score :=
                                    base_state_local.path_preference_score +
                                    transition_bonus_local;
                                combined_state_local.score :=
                                    base_state_local.score + option_score_local -
                                    c_segment_penalty_local +
                                    transition_bonus_local;
                                if next_pos_local = Length(syllables_local) then
                                begin
                                    Inc(combined_state_local.score,
                                        c_completion_bonus_local);
                                end;
                                remember_chain_state_local(
                                    best_states_local[next_pos_local],
                                    combined_state_local);
                            end;

                            if span_len_local <> 1 then
                            begin
                                Continue;
                            end;

                            fixed_single_text_local := get_fixed_single_text_local(
                                syllables_local[pos_local].text);
                            if fixed_single_text_local = '' then
                            begin
                                Continue;
                            end;
                            if should_skip_fixed_single_chain_step_local(pos_local,
                                fixed_single_text_local) then
                            begin
                                Continue;
                            end;

                            fixed_single_candidate_local.text :=
                                fixed_single_text_local;
                            fixed_single_candidate_local.comment := '';
                            fixed_single_candidate_local.score := 420;
                            fixed_single_candidate_local.source := cs_rule;
                            fixed_single_candidate_local.has_dict_weight := False;
                            fixed_single_candidate_local.dict_weight := 0;

                            option_score_local := build_span_score_local(
                                fixed_single_candidate_local, pos_local, 1, 0) +
                                c_stable_single_bonus_local;
                            transition_bonus_local :=
                                get_transition_bonus_local(
                                base_state_local.prev_prev_text,
                                base_state_local.prev_text,
                                fixed_single_candidate_local.text);
                            combined_state_local.text := base_state_local.text +
                                fixed_single_candidate_local.text;
                            combined_state_local.path_text :=
                                combine_path_segments_local(
                                base_state_local.path_text,
                                fixed_single_candidate_local.text);
                            combined_state_local.prev_prev_text :=
                                base_state_local.prev_text;
                            combined_state_local.prev_text :=
                                fixed_single_candidate_local.text;
                            combined_state_local.segment_count :=
                                base_state_local.segment_count + 1;
                            combined_state_local.phrase_count :=
                                base_state_local.phrase_count;
                            combined_state_local.single_count :=
                                base_state_local.single_count + 1;
                            combined_state_local.path_preference_score :=
                                base_state_local.path_preference_score +
                                transition_bonus_local;
                            combined_state_local.score :=
                                base_state_local.score + option_score_local -
                                c_segment_penalty_local +
                                transition_bonus_local;
                            if next_pos_local = Length(syllables_local) then
                            begin
                                Inc(combined_state_local.score,
                                    c_completion_bonus_local);
                            end;
                            remember_chain_state_local(
                                best_states_local[next_pos_local],
                                combined_state_local);
                        end;
                    end;
                end;

                if Length(best_states_local[Length(syllables_local)]) = 0 then
                begin
                    Exit;
                end;

                best_state_local :=
                    best_states_local[Length(syllables_local)][0];
                if (best_state_local.phrase_count <= 0) and
                    (input_syllable_count >= 4) then
                begin
                    Dec(best_state_local.score, c_no_phrase_penalty_local);
                end;
                if best_state_local.single_count >=
                    best_state_local.segment_count then
                begin
                    Dec(best_state_local.score, c_no_phrase_penalty_local);
                end;
                if (best_state_local.path_text <> '') and
                    (m_dictionary <> nil) then
                begin
                    Inc(best_state_local.score,
                        get_cached_query_segment_path_bonus(lookup_text,
                        best_state_local.path_text));
                    Dec(best_state_local.score,
                        get_cached_query_segment_path_penalty(
                        lookup_text, best_state_local.path_text));
                end;
                if get_candidate_text_unit_count(best_state_local.text) <>
                    input_syllable_count then
                begin
                    Exit;
                end;
                if (input_syllable_count >= 6) and
                    (best_state_local.phrase_count >= 2) and
                    (best_state_local.single_count * 2 <=
                    best_state_local.segment_count) then
                begin
                    Inc(best_state_local.score, c_trusted_chain_bonus_local);
                end;

                out_text := best_state_local.text;
                out_path := best_state_local.path_text;
                out_score := best_state_local.score;
                out_phrase_count := best_state_local.phrase_count;
                Result := True;
            finally
                suffix_first_unit_cache_local.Free;
                transition_bonus_cache_local.Free;
            end;
        end;

        function try_build_compact_exact_phrase_chain_fast_local(
            out out_text: string; out out_path: string; out out_score: Integer;
            out out_phrase_count: Integer): Boolean;
        const
            c_low_score_local = Low(Integer) div 4;
            c_span_probe_limit_local = 8;
            c_weight_scale_local = 8;
            c_segment_penalty_local = 520;
            c_min_phrase_count_local = 2;
        var
            best_scores_local: TArray<Integer>;
            best_texts_local: TArray<string>;
            best_paths_local: TArray<string>;
            best_phrase_counts_local: TArray<Integer>;
            best_single_counts_local: TArray<Integer>;
            pos_local: Integer;
            span_len_local: Integer;
            next_pos_local: Integer;
            span_text_local: string;
            span_score_local: Integer;
            combined_score_local: Integer;
            suffix_adjustment_local: Integer;
            combined_path_local: string;
            compact_protected_span_text_cache_local: TDictionary<string, string>;
            compact_protected_span_weight_cache_local: TDictionary<string, Integer>;
            compact_protected_span_rank_cache_local: TDictionary<string, Integer>;

            function get_compact_first_text_unit_local(const value: string): string;
            var
                trimmed_local: string;
            begin
                Result := '';
                trimmed_local := Trim(value);
                if Length(trimmed_local) > 0 then
                begin
                    Result := trimmed_local[1];
                end;
            end;

            function get_compact_last_text_unit_local(const value: string): string;
            var
                trimmed_local: string;
            begin
                Result := '';
                trimmed_local := Trim(value);
                if Length(trimmed_local) > 0 then
                begin
                    Result := trimmed_local[Length(trimmed_local)];
                end;
            end;

            function is_compact_context_unit_code_local(const value: string;
                const code_local: Integer): Boolean;
            begin
                Result := (Length(value) = 1) and (Ord(value[1]) = code_local);
            end;

