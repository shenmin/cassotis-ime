        tail_units: Integer;
        head_text: string;
        head_units: Integer;
        prefix_key: string;
        head_key_for_rank: string;
        remaining_key: string;
        prefix_results: TncCandidateList;
        prefix_text: string;
        repaired_text: string;
        existing_idx: Integer;
        repaired_candidate: TncCandidate;
        repaired_path: string;
        repaired_rank: Integer;
        best_repaired_text: string;
        best_repaired_path: string;
        best_repaired_candidate: TncCandidate;
        best_repaired_rank: Integer;
        best_existing_idx: Integer;
        head_rank: Integer;

        function join_tail_syllables_local(const start_idx: Integer;
            const count: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if ((start_idx < 0) or (count <= 0) or
                (start_idx + count > Length(tail_syllables))) then
            begin
                Exit;
            end;
            for local_idx := start_idx to start_idx + count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    tail_syllables[local_idx].text);
            end;
        end;

        function lexical_candidate_rank_local(
            const candidate_value: TncCandidate): Integer;
        begin
            if candidate_value.has_dict_weight then
            begin
                Result := candidate_value.dict_weight;
            end
            else
            begin
                Result := candidate_value.score;
            end;

            if candidate_value.source = cs_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
        end;

        function lookup_exact_text_rank_local(const exact_key: string;
            const exact_text: string; const expected_text_units: Integer;
            const fallback_rank: Integer): Integer;
        var
            exact_results: TncCandidateList;
            exact_idx: Integer;
            candidate_text: string;
            candidate_rank: Integer;
            found_rank: Boolean;
        begin
            Result := fallback_rank;
            found_rank := False;
            if (m_dictionary = nil) or (exact_key = '') or (exact_text = '') or
                (not m_dictionary.lookup_exact_full_pinyin(exact_key,
                exact_results)) then
            begin
                Exit;
            end;

            for exact_idx := 0 to High(exact_results) do
            begin
                candidate_text := Trim(exact_results[exact_idx].text);
                if (candidate_text = '') or
                    (Trim(exact_results[exact_idx].comment) <> '') or
                    (not SameText(candidate_text, exact_text)) or
                    (get_candidate_text_unit_count(candidate_text) <>
                    expected_text_units) then
                begin
                    Continue;
                end;

                candidate_rank := lexical_candidate_rank_local(
                    exact_results[exact_idx]);
                if (not found_rank) or (candidate_rank > Result) then
                begin
                    Result := candidate_rank;
                    found_rank := True;
                end;
            end;
        end;
    begin
        if (m_dictionary = nil) or (expected_units < 3) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        best_repaired_text := '';
        best_repaired_path := '';
        best_repaired_rank := Low(Integer);
        best_existing_idx := -1;
        FillChar(best_repaired_candidate, SizeOf(best_repaired_candidate), 0);

        for idx := 0 to Min(c_visible_probe_limit - 1, High(m_candidates)) do
        begin
            head_text := Trim(m_candidates[idx].text);
            tail_key := normalize_pinyin_text(Trim(m_candidates[idx].comment));
            if (head_text = '') or (tail_key = '') or (Length(tail_key) > 16) then
            begin
                Continue;
            end;

            tail_syllables := get_effective_compact_pinyin_syllables(tail_key);
            tail_units := Length(tail_syllables);
            head_units := get_candidate_text_unit_count(head_text);
            if (tail_units < 2) or (head_units + tail_units <> expected_units) then
            begin
                Continue;
            end;
            if (head_units = 1) and (tail_units = 2) and
                (not is_display_one_plus_two_direct_complete_head_single(
                head_text)) then
            begin
                Continue;
            end;

            head_key_for_rank := build_display_query_key(0, head_units);
            head_rank := lookup_exact_text_rank_local(head_key_for_rank,
                head_text, head_units,
                lexical_candidate_rank_local(m_candidates[idx]));

            for split_units := tail_units - 1 downto 1 do
            begin
                prefix_key := join_tail_syllables_local(0, split_units);
                remaining_key := join_tail_syllables_local(split_units,
                    tail_units - split_units);
                if (prefix_key = '') or (remaining_key = '') or
                    (not is_full_pinyin_key(prefix_key)) or
                    (not m_dictionary.lookup_exact_full_pinyin(prefix_key,
                    prefix_results)) then
                begin
                    Continue;
                end;

                for prefix_idx := 0 to High(prefix_results) do
                begin
                    if prefix_idx >= c_prefix_probe_limit then
                    begin
                        Break;
                    end;
                    prefix_text := Trim(prefix_results[prefix_idx].text);
                    if (Trim(prefix_results[prefix_idx].comment) <> '') or
                        (get_candidate_text_unit_count(prefix_text) <>
                        split_units) then
                    begin
                        Continue;
                    end;

                    repaired_text := head_text + prefix_text;
                    existing_idx := find_display_candidate(repaired_text,
                        remaining_key);

                    repaired_candidate := m_candidates[idx];
                    repaired_candidate.text := repaired_text;
                    repaired_candidate.comment := remaining_key;
                    repaired_candidate.source := cs_rule;
                    repaired_candidate.has_dict_weight :=
                        prefix_results[prefix_idx].has_dict_weight;
                    repaired_candidate.dict_weight :=
                        prefix_results[prefix_idx].dict_weight;
                    repaired_candidate.score := Max(m_candidates[idx].score,
                        prefix_results[prefix_idx].score) + 8000;
                    repaired_path := head_text + c_segment_path_separator +
                        prefix_text;
                    repaired_rank := head_rank +
                        lexical_candidate_rank_local(prefix_results[prefix_idx]) +
                        (head_units * 256) + (split_units * 512);
                    if (best_repaired_text = '') or
                        (repaired_rank > best_repaired_rank) then
                    begin
                        best_repaired_text := repaired_text;
                        best_repaired_path := repaired_path;
                        best_repaired_candidate := repaired_candidate;
                        best_repaired_rank := repaired_rank;
                        best_existing_idx := existing_idx;
                    end;
                end;
            end;
        end;

        if best_repaired_text = '' then
        begin
            Exit;
        end;

        if best_existing_idx >= 0 then
        begin
            move_display_candidate_to_index(best_existing_idx, 0);
        end
        else
        begin
            insert_display_candidate(best_repaired_candidate,
                best_repaired_path, 0);
        end;
    end;

    procedure insert_tail_prefix_completion_from_partial;
    const
        c_visible_probe_limit = 8;
        c_prefix_probe_limit = 6;
    var
        idx: Integer;
        tail_key: string;
        prefix_results: TncCandidateList;
        prefix_idx: Integer;
        prefix_text: string;
        prefix_units: Integer;
        head_text: string;
        repaired_text: string;
        existing_idx: Integer;
        repaired_candidate: TncCandidate;
        repaired_path: string;
        top_units: TArray<string>;
        prefix_candidate_units: TArray<string>;
    begin
        if (m_dictionary = nil) or (expected_units < 5) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables[expected_units - 1].text);
        if (tail_key = '') or (Length(tail_key) > 4) or
            (not m_dictionary.lookup_full_pinyin_prefix(tail_key,
            prefix_results)) then
        begin
            if (Length(tail_key) <= 1) or
                (not m_dictionary.lookup_full_pinyin_prefix(
                Copy(tail_key, 1, 1), prefix_results)) then
            begin
                Exit;
            end;
        end;

        head_text := '';
        for idx := 0 to Min(c_visible_probe_limit - 1, High(m_candidates)) do
        begin
            if not SameText(normalize_pinyin_text(Trim(m_candidates[idx].comment)),
                tail_key) then
            begin
                Continue;
            end;
            if get_candidate_text_unit_count(Trim(m_candidates[idx].text)) =
                expected_units - 1 then
            begin
                head_text := Trim(m_candidates[idx].text);
                Break;
            end;
        end;
        if head_text = '' then
        begin
            Exit;
        end;

        top_units := nil;
        if (Length(m_candidates) > 0) and
            (Trim(m_candidates[0].comment) = '') then
        begin
            top_units := split_text_units(Trim(m_candidates[0].text));
        end;

        for prefix_idx := 0 to High(prefix_results) do
        begin
            if prefix_idx >= c_prefix_probe_limit then
            begin
                Break;
            end;
            prefix_text := Trim(prefix_results[prefix_idx].text);
            prefix_units := get_candidate_text_unit_count(prefix_text);
            if (Trim(prefix_results[prefix_idx].comment) <> '') or
                (prefix_units <= 1) or (prefix_units > 3) then
            begin
                Continue;
            end;

            prefix_candidate_units := split_text_units(prefix_text);
            if (Length(top_units) = expected_units) and
                (Length(prefix_candidate_units) > 0) and
                (not SameText(Trim(top_units[High(top_units)]),
                Trim(prefix_candidate_units[0]))) then
            begin
                Continue;
            end;

            repaired_text := head_text + prefix_text;
            existing_idx := find_display_candidate(repaired_text, '');
            if existing_idx >= 0 then
            begin
                move_display_candidate_to_front(existing_idx);
                Exit;
            end;

            repaired_candidate := prefix_results[prefix_idx];
            repaired_candidate.text := repaired_text;
            repaired_candidate.comment := '';
            repaired_candidate.source := cs_rule;
            Inc(repaired_candidate.score, 20000);
            repaired_path := head_text + c_segment_path_separator + prefix_text;
            insert_display_candidate(repaired_candidate, repaired_path, 0);
            Exit;
        end;
    end;

    procedure insert_fixed_tail_partial_from_complete;
    var
        tail_key: string;
        tail_text: string;
        idx: Integer;
        units: TArray<string>;
        head_text: string;
        partial_candidate: TncCandidate;
        existing_idx: Integer;
    begin
        if (expected_units < 4) or (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables[expected_units - 1].text);
        tail_text := get_display_fixed_tail_text_outer(tail_key);
        if tail_text = '' then
        begin
            Exit;
        end;

        for idx := 0 to Min(5, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            units := split_text_units(Trim(m_candidates[idx].text));
            if (Length(units) <> expected_units) or
                (not SameText(Trim(units[High(units)]), tail_text)) then
            begin
                Continue;
            end;

            head_text := '';
            for existing_idx := 0 to High(units) - 1 do
            begin
                head_text := head_text + units[existing_idx];
            end;
            if head_text = '' then
            begin
                Continue;
            end;

            existing_idx := find_display_candidate(head_text, tail_key);
            if existing_idx >= 0 then
            begin
                Exit;
            end;

            partial_candidate := m_candidates[idx];
            partial_candidate.text := head_text;
            partial_candidate.comment := tail_key;
            Dec(partial_candidate.score, 64);
            insert_display_candidate(partial_candidate, '', Min(idx + 1, 2));
            Exit;
        end;
    end;

    procedure promote_demonstrative_head_partial;
    var
        tail_key: string;
        idx: Integer;
        desired_head: string;
        candidate_text: string;
        candidate_tail_key: string;
        candidate_text_units: Integer;
        candidate_tail_units: Integer;
    begin
        if (expected_units < 2) or (expected_units > 3) or
            (Length(syllables) <> expected_units) or
            (not SameText(normalize_pinyin_text(syllables[0].text), 'zhe')) then
        begin
            Exit;
        end;

        desired_head := string(Char($8FD9));
        tail_key := build_display_query_key(1, expected_units - 1);
        if tail_key = '' then
        begin
            Exit;
        end;

        if expected_units >= 3 then
        begin
            for idx := 0 to Min(8, High(m_candidates)) do
            begin
                candidate_text := Trim(m_candidates[idx].text);
                candidate_tail_key :=
                    normalize_pinyin_text(Trim(m_candidates[idx].comment));
                candidate_text_units :=
                    get_candidate_text_unit_count(candidate_text);
                candidate_tail_units :=
                    get_effective_compact_pinyin_unit_count(candidate_tail_key);
                if (candidate_text_units > 1) and (candidate_tail_units > 0) and
                    (candidate_text_units + candidate_tail_units =
                    expected_units) and
                    (Copy(candidate_text, 1, Length(desired_head)) =
                    desired_head) then
                begin
                    Exit;
                end;
            end;
        end;

        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if SameText(Trim(m_candidates[idx].text), desired_head) and
                SameText(normalize_pinyin_text(Trim(m_candidates[idx].comment)),
                tail_key) then
            begin
                move_display_candidate_to_front(idx);
                Exit;
            end;
        end;
    end;

    procedure insert_compact_interrogative_location_candidate;
    var
        expected_syllables_local: TArray<string>;
        expected_units_local: TArray<string>;
        idx: Integer;
        lookup_results: TncCandidateList;
        lookup_idx: Integer;
        found_unit: Boolean;
        candidate_value: TncCandidate;
        total_score: Integer;
        existing_idx: Integer;
    begin
        if m_dictionary = nil then
        begin
            Exit;
        end;

        if SameText(normalized_pinyin, 'naer') then
        begin
            expected_syllables_local := TArray<string>.Create('na', 'er');
            expected_units_local := TArray<string>.Create(
                string(Char($54EA)), string(Char($513F)));
        end
        else if SameText(normalized_pinyin, 'ner') then
        begin
            expected_syllables_local := TArray<string>.Create('na', 'er');
            expected_units_local := TArray<string>.Create(
                string(Char($54EA)), string(Char($513F)));
        end
        else if SameText(normalized_pinyin, 'qunaer') then
        begin
            expected_syllables_local := TArray<string>.Create('qu', 'na', 'er');
            expected_units_local := TArray<string>.Create(
                string(Char($53BB)), string(Char($54EA)),
                string(Char($513F)));
        end
        else if SameText(normalized_pinyin, 'qner') then
        begin
            expected_syllables_local := TArray<string>.Create('qu', 'na', 'er');
            expected_units_local := TArray<string>.Create(
                string(Char($53BB)), string(Char($54EA)),
                string(Char($513F)));
        end
        else
        begin
            Exit;
        end;

        total_score := 0;
        candidate_value.text := '';
        for idx := 0 to High(expected_units_local) do
        begin
            if not m_dictionary.lookup_exact_full_pinyin(
                expected_syllables_local[idx], lookup_results) then
            begin
                Exit;
            end;
            found_unit := False;
            for lookup_idx := 0 to High(lookup_results) do
            begin
                if SameText(Trim(lookup_results[lookup_idx].text),
                    expected_units_local[idx]) and
                    (Trim(lookup_results[lookup_idx].comment) = '') then
                begin
                    candidate_value.text := candidate_value.text +
                        expected_units_local[idx];
                    Inc(total_score, lookup_results[lookup_idx].score);
                    found_unit := True;
                    Break;
                end;
            end;
            if not found_unit then
            begin
                Exit;
            end;
        end;

        existing_idx := find_display_candidate(candidate_value.text, '');
        if existing_idx >= 0 then
        begin
            move_display_candidate_to_front(existing_idx);
            Exit;
        end;

        candidate_value.comment := '';
        candidate_value.score := total_score * 2 + 560 +
            Length(expected_units_local) * 40;
        candidate_value.source := cs_rule;
        candidate_value.has_dict_weight := True;
        candidate_value.dict_weight := total_score div
            Max(1, Length(expected_units_local));
        insert_display_candidate(candidate_value, candidate_value.text, 0);
    end;

    procedure insert_two_function_singles_before_phrase_repair;
    const
        c_visible_probe_limit = 6;
        c_strong_pair_protection_weight = 700;
        c_existing_repair_score_margin = 1024;
    var
        source_idx: Integer;
        start_idx: Integer;
        follow_len: Integer;
        units: TArray<string>;
        current_pair_text: string;
        current_pair_best_text: string;
        current_pair_best_weight: Integer;
        first_single_text: string;
        second_single_text: string;
        following_phrase_text: string;
        first_single_weight: Integer;
        second_single_weight: Integer;
        following_phrase_weight: Integer;
        phrase_units: TArray<string>;
        repaired_units: TArray<string>;
        unit_idx: Integer;
        repaired_text: string;
        repaired_path: string;
        existing_idx: Integer;
        repaired_candidate: TncCandidate;
        best_text: string;
        best_path: string;
        best_score: Integer;
        best_target: Integer;
    begin
        if (m_dictionary = nil) or (expected_units < 5) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        best_text := '';
        best_path := '';
        best_score := Low(Integer);
        best_target := 0;
        for source_idx := 0 to Min(c_visible_probe_limit - 1,
            High(m_candidates)) do
        begin
            if Trim(m_candidates[source_idx].comment) <> '' then
            begin
                Continue;
            end;

            units := split_text_units(Trim(m_candidates[source_idx].text));
            if Length(units) <> expected_units then
            begin
                Continue;
            end;

            for start_idx := 0 to expected_units - 4 do
            begin
                current_pair_text := units[start_idx] + units[start_idx + 1];
                if not display_exact_key_has_text(
                    build_display_query_key(start_idx, 2),
                    current_pair_text) then
                begin
                    Continue;
                end;
                if try_get_display_exact_phrase(start_idx, 2,
                    current_pair_best_text, current_pair_best_weight) and
                    SameText(Trim(current_pair_best_text),
                    current_pair_text) and
                    (current_pair_best_weight >=
                    c_strong_pair_protection_weight) then
                begin
                    Continue;
                end;
                if not try_get_display_function_single(
                    normalize_pinyin_text(syllables[start_idx].text),
                    first_single_text, first_single_weight) then
                begin
                    Continue;
                end;
                if not try_get_display_function_single(
                    normalize_pinyin_text(syllables[start_idx + 1].text),
                    second_single_text, second_single_weight) then
                begin
                    Continue;
                end;
                if SameText(current_pair_text,
                    first_single_text + second_single_text) then
                begin
                    Continue;
                end;

                for follow_len := 2 to Min(4, expected_units - start_idx - 2) do
                begin
                    if not try_get_display_exact_phrase(start_idx + 2,
                        follow_len, following_phrase_text,
                        following_phrase_weight) then
                    begin
                        Continue;
                    end;

                    phrase_units := split_text_units(following_phrase_text);
                    if Length(phrase_units) <> follow_len then
                    begin
                        Continue;
                    end;

                    for unit_idx := 0 to follow_len - 1 do
                    begin
                        if not SameText(Trim(units[start_idx + 2 + unit_idx]),
                            Trim(phrase_units[unit_idx])) then
                        begin
                            following_phrase_text := '';
                            Break;
                        end;
                    end;
                    if following_phrase_text = '' then
                    begin
                        Continue;
                    end;

                    repaired_units := Copy(units);
                    repaired_units[start_idx] := first_single_text;
                    repaired_units[start_idx + 1] := second_single_text;
                    repaired_text := '';
                    for unit_idx := 0 to High(repaired_units) do
                    begin
                        repaired_text := repaired_text + repaired_units[unit_idx];
                    end;
                    if SameText(repaired_text,
                        Trim(m_candidates[source_idx].text)) then
                    begin
                        Continue;
                    end;

                    existing_idx := find_display_candidate(repaired_text, '');
                    if existing_idx >= 0 then
                    begin
                        if m_candidates[existing_idx].score <
                            m_candidates[source_idx].score +
                            c_existing_repair_score_margin then
                        begin
                            Continue;
                        end;
                        move_display_candidate_to_front(existing_idx);
                        Exit;
                    end;

                    repaired_path := '';
                    for unit_idx := 0 to start_idx - 1 do
                    begin
                        if repaired_path <> '' then
                        begin
                            repaired_path := repaired_path +
                                c_segment_path_separator;
                        end;
                        repaired_path := repaired_path + repaired_units[unit_idx];
                    end;
                    if repaired_path <> '' then
                    begin
                        repaired_path := repaired_path + c_segment_path_separator;
                    end;
                    repaired_path := repaired_path + first_single_text +
                        c_segment_path_separator + second_single_text +
                        c_segment_path_separator + following_phrase_text;
                    for unit_idx := start_idx + 2 + follow_len to
                        High(repaired_units) do
                    begin
                        repaired_path := repaired_path + c_segment_path_separator +
                            repaired_units[unit_idx];
                    end;

                    if m_candidates[source_idx].score + first_single_weight +
                        second_single_weight + following_phrase_weight >
                        best_score then
                    begin
                        best_text := repaired_text;
                        best_path := repaired_path;
                        best_score := m_candidates[source_idx].score +
                            first_single_weight + second_single_weight +
                            following_phrase_weight;
                        best_target := Min(source_idx, 1);
                    end;
                end;
            end;
        end;

        if best_text = '' then
        begin
            Exit;
        end;

        repaired_candidate.text := best_text;
        repaired_candidate.comment := '';
        repaired_candidate.score := best_score + 4096;
        repaired_candidate.source := cs_rule;
        repaired_candidate.has_dict_weight := False;
        repaired_candidate.dict_weight := 0;
        insert_display_candidate(repaired_candidate, best_path, best_target);
    end;

    procedure ensure_missing_apostrophe_display_partial;
    const
        c_max_probe_chars = 8;
    var
        split_pos: Integer;
        left_key: string;
        right_key: string;
        left_results: TncCandidateList;
        full_results: TncCandidateList;
        result_idx: Integer;
        existing_idx: Integer;
        target_idx: Integer;
        insert_idx: Integer;
        move_idx: Integer;
        best_text: string;
        best_score: Integer;
        candidate_text: string;
        candidate_units: TArray<string>;
        partial_candidate: TncCandidate;
        has_full_multi_anchor: Boolean;
        has_boundary_shift: Boolean;
    begin
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (Pos('''', m_composition_text) > 0) or
            (Length(normalized_pinyin) > c_max_probe_chars) or
            (expected_units > 3) then
        begin
            Exit;
        end;

        has_boundary_shift :=
            detect_relaxed_missing_apostrophe_boundary_shift(normalized_pinyin);
        has_full_multi_anchor := False;
        if m_dictionary.lookup(normalized_pinyin, full_results) then
        begin
            for result_idx := 0 to High(full_results) do
            begin
                if (Trim(full_results[result_idx].comment) = '') and
                    (get_candidate_text_unit_count(Trim(full_results[result_idx].text)) >
                    1) then
                begin
                    has_full_multi_anchor := True;
                    Break;
                end;
            end;
        end;

        if (not has_boundary_shift) and (not has_full_multi_anchor) then
        begin
            Exit;
        end;

        for split_pos := 1 to Length(normalized_pinyin) - 1 do
        begin
            left_key := Copy(normalized_pinyin, 1, split_pos);
            right_key := Copy(normalized_pinyin, split_pos + 1,
                Length(normalized_pinyin) - split_pos);
            if (left_key = '') or (right_key = '') or
                (not is_relaxed_no_initial_syllable_text(right_key)) then
            begin
                Continue;
            end;

            best_text := '';
            best_score := Low(Integer);
            if m_dictionary.lookup(left_key, left_results) then
            begin
                for result_idx := 0 to High(left_results) do
                begin
                    candidate_text := Trim(left_results[result_idx].text);
                    if (Trim(left_results[result_idx].comment) <> '') or
                        (get_candidate_text_unit_count(candidate_text) <= 0) then
                    begin
                        Continue;
                    end;
                    if left_results[result_idx].score > best_score then
                    begin
                        best_text := candidate_text;
                        best_score := left_results[result_idx].score;
                    end;
                end;
            end;

            if (best_text = '') and has_full_multi_anchor then
            begin
                for result_idx := 0 to High(full_results) do
                begin
                    candidate_text := Trim(full_results[result_idx].text);
                    if Trim(full_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_units := split_text_units(candidate_text);
                    if Length(candidate_units) <= 1 then
                    begin
                        Continue;
                    end;
                    best_text := candidate_units[0];
                    best_score := full_results[result_idx].score;
                    Break;
                end;
            end;

            if best_text = '' then
            begin
                Continue;
            end;

            existing_idx := -1;
            for result_idx := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[result_idx].text), best_text) and
                    SameText(Trim(m_candidates[result_idx].comment), right_key) then
                begin
                    existing_idx := result_idx;
                    Break;
                end;
            end;

            target_idx := 0;
            for result_idx := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[result_idx].comment) = '') and
                    (get_candidate_text_unit_count(Trim(m_candidates[result_idx].text)) >
                    1) then
                begin
                    target_idx := result_idx + 1;
                    Break;
                end;
            end;
            target_idx := Min(target_idx, 2);

            if existing_idx >= 0 then
            begin
                if existing_idx <= target_idx then
                begin
                    if get_candidate_text_unit_count(best_text) > 1 then
                    begin
                        Exit;
                    end;
                    Continue;
                end;
                partial_candidate := m_candidates[existing_idx];
                for move_idx := existing_idx downto target_idx + 1 do
                begin
                    m_candidates[move_idx] := m_candidates[move_idx - 1];
                    if move_idx < Length(m_candidate_segment_paths) then
                    begin
                        if move_idx - 1 < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[move_idx] :=
                                m_candidate_segment_paths[move_idx - 1];
                        end
                        else
                        begin
                            m_candidate_segment_paths[move_idx] := '';
                        end;
                    end;
                end;
                m_candidates[target_idx] := partial_candidate;
                if target_idx < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[target_idx] := '';
                end;
                if get_candidate_text_unit_count(best_text) > 1 then
                begin
                    Exit;
                end;
                Continue;
            end;

            partial_candidate.text := best_text;
            partial_candidate.comment := right_key;
            partial_candidate.score := best_score + 64;
            partial_candidate.source := cs_rule;
            partial_candidate.has_dict_weight := False;
            partial_candidate.dict_weight := 0;

            SetLength(m_candidates, Length(m_candidates) + 1);
            if Length(m_candidate_segment_paths) < Length(m_candidates) then
            begin
                SetLength(m_candidate_segment_paths, Length(m_candidates));
            end;
            insert_idx := Min(target_idx, High(m_candidates));
            for move_idx := High(m_candidates) downto insert_idx + 1 do
            begin
                m_candidates[move_idx] := m_candidates[move_idx - 1];
                if move_idx < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx] :=
                        m_candidate_segment_paths[move_idx - 1];
                end;
            end;
            m_candidates[insert_idx] := partial_candidate;
            if insert_idx < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[insert_idx] := '';
            end;
            if get_candidate_text_unit_count(best_text) > 1 then
            begin
                Exit;
            end;
        end;
    end;

    procedure prefer_display_relaxed_no_initial_tail_boundary;
    const
        c_min_base_exact_weight = 160;
    var
        relaxed_syllables: TncPinyinParseResult;
        head_key: string;
        tail_key: string;
        head_units: Integer;
        tail_units: Integer;
        out_idx: Integer;
        best_head_text: string;
        best_head_score: Integer;
        head_results: TncCandidateList;
        head_candidate_text: string;
        partial_idx: Integer;
        complete_idx: Integer;
        partial_candidate: TncCandidate;
        complete_candidate: TncCandidate;

        function build_relaxed_head_key_local: string;
        var
            part_idx: Integer;
        begin
            Result := '';
            for part_idx := 0 to High(relaxed_syllables) - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    Trim(relaxed_syllables[part_idx].text));
            end;
        end;

        function try_set_boundary_keys_local(const head_key_value: string;
            const tail_key_value: string): Boolean;
        var
            normalized_head_key: string;
            normalized_tail_key: string;
            calculated_head_units: Integer;
            calculated_tail_units: Integer;
        begin
            Result := False;
            normalized_head_key := normalize_pinyin_text(head_key_value);
            normalized_tail_key := normalize_pinyin_text(tail_key_value);
            if (normalized_head_key = '') or (normalized_tail_key = '') or
                (not is_relaxed_no_initial_syllable_text(
                normalized_tail_key)) then
            begin
                Exit;
            end;
            calculated_head_units :=
                get_effective_compact_pinyin_unit_count(normalized_head_key);
            calculated_tail_units :=
                get_effective_compact_pinyin_unit_count(normalized_tail_key);
            if (calculated_head_units <= 0) or
                (calculated_tail_units <= 0) or
                (calculated_head_units + calculated_tail_units <>
                expected_units) then
            begin
                Exit;
            end;

            head_key := normalized_head_key;
            tail_key := normalized_tail_key;
            head_units := calculated_head_units;
            tail_units := calculated_tail_units;
            Result := True;
        end;

        function load_explicit_apostrophe_boundary_local: Boolean;
        var
            raw_text_local: string;
            apostrophe_pos_local: Integer;
        begin
            Result := False;
            raw_text_local := Trim(m_composition_text);
            apostrophe_pos_local := LastDelimiter('''', raw_text_local);
            if (apostrophe_pos_local <= 1) or
                (apostrophe_pos_local >= Length(raw_text_local)) then
            begin
                Exit;
            end;

            Result := try_set_boundary_keys_local(
                Copy(raw_text_local, 1, apostrophe_pos_local - 1),
                Copy(raw_text_local, apostrophe_pos_local + 1, MaxInt));
        end;

        function load_relaxed_parts_boundary_local: Boolean;
        begin
            Result := False;
            relaxed_syllables := parse_pinyin_with_relaxed_missing_apostrophe(
                normalized_pinyin);
            if Length(relaxed_syllables) < 2 then
            begin
                Exit;
            end;

            Result := try_set_boundary_keys_local(build_relaxed_head_key_local,
                Trim(relaxed_syllables[High(relaxed_syllables)].text));
        end;

        function normalized_query_has_strong_base_complete_local: Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if (m_last_lookup_normalized_from <> '') or
                (not lookup_display_exact_cached(normalized_pinyin,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(exact_text_local) <>
                    expected_units) then
                begin
                    Continue;
                end;

                if m_dictionary.is_base_entry(normalized_pinyin,
                    exact_text_local) then
                begin
                    if find_display_candidate(exact_text_local, '') >= 0 then
                    begin
                        Exit(True);
                    end;
                    Continue;
                end;

                if (exact_results_local[exact_idx_local].source = cs_rule) and
                    exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight >=
                    c_min_base_exact_weight) then
                begin
                    if find_display_candidate(exact_text_local, '') >= 0 then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function text_matches_head_key_local(const text_value: string): Boolean;
        begin
            Result := False;
            if (head_key = '') or (text_value = '') or
                (get_candidate_text_unit_count(text_value) <> head_units) then
            begin
                Exit;
            end;

            if display_exact_key_has_text(head_key, text_value) then
            begin
                Exit(True);
            end;

            Result := (head_units = 1) and
                m_dictionary.single_char_matches_pinyin(head_key, text_value);
        end;

        function text_matches_tail_key_local(const text_value: string): Boolean;
        begin
            Result := False;
            if (tail_key = '') or (text_value = '') or
                (get_candidate_text_unit_count(text_value) <> tail_units) then
            begin
                Exit;
            end;

            if display_exact_key_has_text(tail_key, text_value) then
            begin
                Exit(True);
            end;

            Result := (tail_units = 1) and
                m_dictionary.single_char_matches_pinyin(tail_key, text_value);
        end;

        function load_longest_supported_boundary_local: Boolean;
        var
            split_pos_local: Integer;
            head_results_local: TncCandidateList;
            head_idx_local: Integer;
        begin
            Result := False;
            for split_pos_local := Length(normalized_pinyin) - 1 downto 2 do
            begin
                if not try_set_boundary_keys_local(
                    Copy(normalized_pinyin, 1, split_pos_local),
                    Copy(normalized_pinyin, split_pos_local + 1, MaxInt)) then
                begin
                    Continue;
                end;

                if not lookup_display_complete_cached(head_key,
                    head_results_local) then
                begin
                    Continue;
                end;

                for head_idx_local := 0 to High(head_results_local) do
                begin
                    if (Trim(head_results_local[head_idx_local].comment) = '') and
                        text_matches_head_key_local(
                        Trim(head_results_local[head_idx_local].text)) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function complete_matches_relaxed_boundary_local(
            const text_value: string): Boolean;
        var
            units_local: TArray<string>;
            unit_idx_local: Integer;
            head_text_local: string;
            tail_text_local: string;
        begin
            Result := False;
            units_local := split_text_units(Trim(text_value));
            if Length(units_local) <> expected_units then
            begin
                Exit;
            end;

            head_text_local := '';
            for unit_idx_local := 0 to head_units - 1 do
            begin
                head_text_local := head_text_local + units_local[unit_idx_local];
            end;

            tail_text_local := '';
            for unit_idx_local := head_units to High(units_local) do
            begin
                tail_text_local := tail_text_local + units_local[unit_idx_local];
            end;

            Result := text_matches_head_key_local(head_text_local) and
                text_matches_tail_key_local(tail_text_local);
        end;

        function find_relaxed_boundary_partial_local: Integer;
        var
            idx_local: Integer;
        begin
            Result := -1;
            for idx_local := 0 to High(m_candidates) do
            begin
                if SameText(normalize_pinyin_text(Trim(m_candidates[idx_local].comment)),
                    tail_key) and
                    text_matches_head_key_local(Trim(m_candidates[idx_local].text)) then
                begin
                    Exit(idx_local);
                end;
            end;
        end;

        function find_relaxed_boundary_complete_local: Integer;
        var
            idx_local: Integer;
        begin
            Result := -1;
            for idx_local := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[idx_local].comment) = '') and
                    complete_matches_relaxed_boundary_local(
                    Trim(m_candidates[idx_local].text)) then
                begin
                    Exit(idx_local);
                end;
            end;
        end;

        procedure remove_misaligned_complete_candidates_local;
        var
            idx_local: Integer;
        begin
            out_idx := 0;
            for idx_local := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[idx_local].comment) = '') and
                    (get_candidate_text_unit_count(Trim(m_candidates[idx_local].text)) =
                    expected_units) and
                    (not complete_matches_relaxed_boundary_local(
                    Trim(m_candidates[idx_local].text))) and
                    (not display_candidate_has_base_full_entry(normalized_pinyin,
                    m_candidates[idx_local])) then
                begin
                    Continue;
                end;

                if out_idx <> idx_local then
                begin
                    m_candidates[out_idx] := m_candidates[idx_local];
                    if out_idx < Length(m_candidate_segment_paths) then
                    begin
                        if idx_local < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[out_idx] :=
                                m_candidate_segment_paths[idx_local];
                        end
                        else
                        begin
                            m_candidate_segment_paths[out_idx] := '';
                        end;
                    end;
                end;
                Inc(out_idx);
            end;

            if out_idx <> Length(m_candidates) then
            begin
                SetLength(m_candidates, out_idx);
                if Length(m_candidate_segment_paths) > out_idx then
                begin
                    SetLength(m_candidate_segment_paths, out_idx);
                end;
            end;
        end;

        function try_build_head_partial_candidate_local: Boolean;
        var
            head_result_idx_local: Integer;
        begin
            Result := False;
            best_head_text := '';
            best_head_score := Low(Integer);
            if not lookup_display_complete_cached(head_key, head_results) then
            begin
                Exit;
            end;

            for head_result_idx_local := 0 to High(head_results) do
            begin
                head_candidate_text := Trim(head_results[head_result_idx_local].text);
                if (Trim(head_results[head_result_idx_local].comment) <> '') or
                    (not text_matches_head_key_local(head_candidate_text)) then
                begin
                    Continue;
                end;

                if head_results[head_result_idx_local].score > best_head_score then
                begin
                    best_head_text := head_candidate_text;
                    best_head_score := head_results[head_result_idx_local].score;
                end;
            end;

            if best_head_text = '' then
            begin
                Exit;
            end;

            partial_candidate.text := best_head_text;
            partial_candidate.comment := tail_key;
            partial_candidate.score := best_head_score + 256;
            partial_candidate.source := cs_rule;
            partial_candidate.has_dict_weight := False;
            partial_candidate.dict_weight := 0;
            Result := True;
        end;

        function try_build_relaxed_boundary_complete_candidate_local(
            out out_candidate: TncCandidate): Boolean;
        var
            explicit_boundary_key: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            candidate_text_local: string;
            candidate_score_local: Integer;
            best_idx_local: Integer;
            best_score_local: Integer;
        begin
            Result := False;
            best_idx_local := -1;
            best_score_local := Low(Integer);
            explicit_boundary_key := head_key + '''' + tail_key;
            if (head_key = '') or (tail_key = '') or
                (not lookup_display_complete_cached(explicit_boundary_key,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (get_candidate_text_unit_count(candidate_text_local) <>
                    expected_units) or
                    (not complete_matches_relaxed_boundary_local(
                    candidate_text_local)) then
                begin
                    Continue;
                end;

                candidate_score_local := exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight then
                begin
                    Inc(candidate_score_local,
                        exact_results_local[exact_idx_local].dict_weight);
                end;

                if (best_idx_local < 0) or
                    (candidate_score_local > best_score_local) then
                begin
                    best_idx_local := exact_idx_local;
                    best_score_local := candidate_score_local;
                end;
            end;

            if best_idx_local < 0 then
            begin
                Exit;
            end;

            out_candidate := exact_results_local[best_idx_local];
            out_candidate.comment := '';
            Result := True;
        end;
    begin
        if (m_dictionary = nil) or (Length(m_candidates) = 0) or
            (normalized_pinyin = '') or (expected_units < 2) then
        begin
            Exit;
        end;

        if relaxed_boundary_cache_ready then
        begin
            if not relaxed_boundary_cache_found then
            begin
                Exit;
            end;
            head_key := relaxed_boundary_cache_head_key;
            tail_key := relaxed_boundary_cache_tail_key;
            head_units := relaxed_boundary_cache_head_units;
            tail_units := relaxed_boundary_cache_tail_units;
        end
        else
        begin
            relaxed_boundary_cache_ready := True;
            relaxed_boundary_cache_found :=
                load_explicit_apostrophe_boundary_local or
                load_longest_supported_boundary_local or
                load_relaxed_parts_boundary_local;
            if not relaxed_boundary_cache_found then
            begin
                Exit;
            end;
            relaxed_boundary_cache_head_key := head_key;
            relaxed_boundary_cache_tail_key := tail_key;
            relaxed_boundary_cache_head_units := head_units;
            relaxed_boundary_cache_tail_units := tail_units;
        end;

        if normalized_query_has_strong_base_complete_local then
        begin
            Exit;
        end;

        partial_idx := find_relaxed_boundary_partial_local;
        if (partial_idx < 0) and try_build_head_partial_candidate_local then
        begin
            insert_display_candidate(partial_candidate, '', 0);
            partial_idx := find_relaxed_boundary_partial_local;
        end;
        if partial_idx < 0 then
        begin
            Exit;
        end;

        remove_misaligned_complete_candidates_local;

        complete_idx := find_relaxed_boundary_complete_local;
        if complete_idx >= 0 then
        begin
            force_move_display_candidate_to_index(complete_idx, 0);
            Exit;
        end;

        if try_build_relaxed_boundary_complete_candidate_local(complete_candidate) then
        begin
            complete_idx := find_display_candidate(Trim(complete_candidate.text), '');
            if complete_idx >= 0 then
            begin
                force_move_display_candidate_to_index(complete_idx, 0);
            end
            else
            begin
                insert_display_candidate(complete_candidate, '', 0);
            end;
            Exit;
        end;

        partial_idx := find_relaxed_boundary_partial_local;
        if partial_idx >= 0 then
        begin
            force_move_display_candidate_to_index(partial_idx, 0);
        end;
    end;

    procedure insert_function_phrase_split_repairs;
    const
        c_source_probe_limit = 3;
        c_min_phrase_weight = 700;
    var
        source_idx: Integer;
        start_idx: Integer;
        follow_len: Integer;
        units: TArray<string>;
        repaired_units: TArray<string>;
        phrase_units: TArray<string>;
        unit_idx: Integer;
        single_text: string;
        single_weight: Integer;
        phrase_text: string;
        phrase_weight: Integer;
        current_two_text: string;
        repair_text: string;
        repair_path: string;
        duplicate_idx: Integer;
        duplicate_found: Boolean;
        repair_candidate: TncCandidate;
        best_text: string;
        best_path: string;
        best_score: Integer;
        best_target: Integer;
        current_two_best_text: string;
        current_two_weight: Integer;
    begin
        if (m_dictionary = nil) or (Length(m_candidates) <= 0) or
            (expected_units < 3) then
        begin
            Exit;
        end;

        best_text := '';
        best_path := '';
        best_score := Low(Integer);
        best_target := 0;
        for source_idx := 0 to Min(c_source_probe_limit - 1,
            High(m_candidates)) do
        begin
            if Trim(m_candidates[source_idx].comment) <> '' then
            begin
                Continue;
            end;

            units := split_text_units(Trim(m_candidates[source_idx].text));
            if Length(units) <> expected_units then
            begin
                Continue;
            end;

            for start_idx := 0 to expected_units - 3 do
            begin
                if not try_get_display_function_single(
                    normalize_pinyin_text(syllables[start_idx].text),
                    single_text, single_weight) then
                begin
                    Continue;
                end;

                for follow_len := 2 to Min(4, expected_units - start_idx - 1) do
                begin
                    current_two_text := units[start_idx] + units[start_idx + 1];
                    if (not try_get_display_exact_phrase(start_idx, 2,
                        current_two_best_text, current_two_weight)) or
                        (not SameText(current_two_best_text,
                        current_two_text)) then
                    begin
                        Continue;
                    end;
                    if not try_get_display_exact_phrase(start_idx + 1,
                        follow_len, phrase_text, phrase_weight) then
                    begin
                        Continue;
                    end;
                    if phrase_weight < c_min_phrase_weight then
                    begin
                        Continue;
                    end;
                    if current_two_weight >= phrase_weight + 400 then
                    begin
                        Continue;
                    end;

                    phrase_units := split_text_units(phrase_text);
                    if Length(phrase_units) <> follow_len then
                    begin
                        Continue;
                    end;

                    repaired_units := Copy(units);
                    repaired_units[start_idx] := single_text;
                    for unit_idx := 0 to High(phrase_units) do
                    begin
                        repaired_units[start_idx + 1 + unit_idx] :=
                            phrase_units[unit_idx];
                    end;

                    repair_text := '';
                    for unit_idx := 0 to High(repaired_units) do
                    begin
                        repair_text := repair_text + repaired_units[unit_idx];
                    end;

                    if SameText(repair_text, Trim(m_candidates[source_idx].text)) then
                    begin
                        Continue;
                    end;

                    duplicate_found := False;
                    for duplicate_idx := 0 to High(m_candidates) do
                    begin
                        if SameText(Trim(m_candidates[duplicate_idx].text),
                            repair_text) and
                            (Trim(m_candidates[duplicate_idx].comment) = '') then
                        begin
                            duplicate_found := True;
                            Break;
                        end;
                    end;
                    if duplicate_found then
                    begin
                        Continue;
                    end;

                    repair_path := '';
                    for unit_idx := 0 to start_idx - 1 do
                    begin
                        if repair_path <> '' then
                        begin
                            repair_path := repair_path + c_segment_path_separator;
                        end;
                        repair_path := repair_path + repaired_units[unit_idx];
                    end;
                    if repair_path <> '' then
                    begin
                        repair_path := repair_path + c_segment_path_separator;
                    end;
                    repair_path := repair_path + single_text +
                        c_segment_path_separator + phrase_text;
                    for unit_idx := start_idx + 1 + Length(phrase_units) to
                        High(repaired_units) do
                    begin
                        repair_path := repair_path + c_segment_path_separator +
                            repaired_units[unit_idx];
                    end;

                    if m_candidates[source_idx].score + single_weight +
                        phrase_weight > best_score then
                    begin
                        best_score := m_candidates[source_idx].score +
                            single_weight + phrase_weight;
                        best_text := repair_text;
                        best_path := repair_path;
                        best_target := Min(source_idx, 1);
                    end;
                end;
            end;
        end;

        if best_text = '' then
        begin
            Exit;
        end;

        repair_candidate.text := best_text;
        repair_candidate.comment := '';
        repair_candidate.score := best_score + 4096;
        repair_candidate.source := cs_rule;
        repair_candidate.has_dict_weight := False;
        repair_candidate.dict_weight := 0;
        insert_display_candidate(repair_candidate, best_path, best_target);
    end;

    procedure promote_pathful_high_score_complete_candidate;
    const
        c_visible_probe_limit = 6;
        c_quality_margin = 1800;
        c_score_margin = 1024;
        c_score_quality_floor = -9600;
    var
        idx: Integer;
        local_idx: Integer;
        probe_limit: Integer;
        best_idx: Integer;
        best_quality: Integer;
        best_rank: Integer;
        top_quality: Integer;
        candidate_quality: Integer;
        candidate_rank: Integer;
        top_exact_match: Boolean;
        score_order_complete_path_candidate: Boolean;
        top_effective_dict_weight: Integer;
        moved_candidate: TncCandidate;
        moved_path: string;
        top_path: string;
        candidate_path: string;

        function is_display_function_single(const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $662F, $7684, $4E86, $5728, $4E8E, $4E5F, $548C, $4E0D,
                $518D, $9AD8, $5F88, $592A, $6700, $66F4, $6CA1, $8981,
                $4F1A, $80FD, $628A, $88AB, $8BA9, $7ED9, $5BF9, $4ECE,
                $5411, $4E0E, $90FD, $8FD8, $624D, $5C31, $53EA, $522B,
                $5DF2, $5C06, $53EF, $60F3, $65E0, $975E, $672A, $4ECD,
                $591A, $5C11, $5168, $8D85, $771F, $597D, $5982, $633A,
                $8F83, $6781, $800C, $5E76, $4E00, $4E14, $5427,
                $5417:
                    Result := True;
            end;
        end;

        function get_display_quantity_tail_text(
            const syllable_text: string): string;
        var
            normalized_syllable_value: string;
        begin
            Result := '';
            normalized_syllable_value := normalize_pinyin_text(syllable_text);
            if normalized_syllable_value = 'ci' then
            begin
                Result := string(Char($6B21));
            end
            else if normalized_syllable_value = 'ge' then
            begin
                Result := string(Char($4E2A));
            end
            else if normalized_syllable_value = 'tiao' then
            begin
                Result := string(Char($6761));
            end
            else if normalized_syllable_value = 'zhang' then
            begin
                Result := string(Char($5F20));
            end
            else if normalized_syllable_value = 'ben' then
            begin
                Result := string(Char($672C));
            end
            else if normalized_syllable_value = 'pian' then
            begin
                Result := string(Char($7247));
            end
            else if normalized_syllable_value = 'bu' then
            begin
                Result := string(Char($6B65));
            end
            else if normalized_syllable_value = 'lun' then
            begin
                Result := string(Char($8F6E));
            end
            else if normalized_syllable_value = 'hui' then
            begin
                Result := string(Char($56DE));
            end
            else if normalized_syllable_value = 'xia' then
            begin
                Result := string(Char($4E0B));
            end;
        end;

        function get_display_fixed_quantity_alignment_score(
            const candidate_value: TncCandidate): Integer;
        var
            candidate_units: TArray<string>;
            syllable_idx: Integer;
            expected_tail_text: string;
        begin
            Result := 0;
            if (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
                expected_units) then
            begin
                Exit;
            end;

            candidate_units := split_text_units(Trim(candidate_value.text));
            if Length(candidate_units) <> expected_units then
            begin
                Exit;
            end;

            for syllable_idx := 0 to expected_units - 2 do
            begin
                if syllable_idx < expected_units - 3 then
                begin
                    Continue;
                end;
                if normalize_pinyin_text(syllables[syllable_idx].text) <> 'yi' then
                begin
                    Continue;
                end;

                expected_tail_text := get_display_quantity_tail_text(
                    syllables[syllable_idx + 1].text);
                if expected_tail_text = '' then
                begin
                    Continue;
                end;

                if SameText(Trim(candidate_units[syllable_idx]),
                    string(Char($4E00))) and
                    SameText(Trim(candidate_units[syllable_idx + 1]),
                    expected_tail_text) then
                begin
                    Inc(Result, 22000);
                end
                else
                begin
                    Dec(Result, 22000);
                end;
            end;
        end;

        function get_display_path_quality(const candidate: TncCandidate;
            const path_value: string): Integer;
        var
            candidate_units: TArray<string>;
            parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
            segment_units: Integer;
            segment_start: Integer;
            query_key: string;
            previous_was_single: Boolean;
            boundary_start: Integer;
            span_units: Integer;
            span_start: Integer;
            span_start_min: Integer;
            span_start_max: Integer;
            span_text: string;
            span_key: string;
            function build_candidate_span_text(const start_idx: Integer;
                const unit_count: Integer): string;
            var
                unit_idx: Integer;
            begin
                Result := '';
                if (start_idx < 0) or (unit_count <= 0) or
                    (start_idx + unit_count > Length(candidate_units)) then
                begin
                    Exit;
                end;
                for unit_idx := start_idx to start_idx + unit_count - 1 do
                begin
                    Result := Result + candidate_units[unit_idx];
                end;
            end;
        begin
            Result := Low(Integer) div 4;
            if (Trim(candidate.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate.text)) <>
                expected_units) or
                (get_encoded_path_segment_count_local(path_value) <= 1) then
            begin
                Exit;
            end;

            Result := 0;
            candidate_units := split_text_units(Trim(candidate.text));
            if Length(candidate_units) <> expected_units then
            begin
                Exit(Low(Integer) div 4);
            end;
            Inc(Result, get_display_fixed_tail_alignment_score_outer(candidate));
            Inc(Result, get_display_fixed_quantity_alignment_score(candidate));
            parts := path_value.Split([c_segment_path_separator]);
            segment_start := 0;
            previous_was_single := False;
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                segment_units := get_candidate_text_unit_count(segment_text);
                if (segment_text = '') or (segment_units <= 0) or
                    (segment_start + segment_units > expected_units) then
                begin
                    Exit(Low(Integer) div 4);
                end;

                query_key := build_display_query_key(segment_start,
                    segment_units);
                boundary_start := segment_start;
                if boundary_start > 0 then
                begin
                    for span_units := 2 to 4 do
                    begin
                        span_start_min := Max(0, boundary_start - span_units + 1);
                        span_start_max := Min(boundary_start - 1,
                            expected_units - span_units);
                        for span_start := span_start_min to span_start_max do
                        begin
                            span_text := build_candidate_span_text(span_start,
                                span_units);
                            span_key := build_display_query_key(span_start,
                                span_units);
                            if (span_text <> '') and (span_key <> '') and
                                (not display_exact_key_has_text(span_key,
                                span_text)) and
                                display_exact_key_has_any_complete_text(span_key,
                                span_units) then
                            begin
                                Dec(Result, 4200 + span_units * 1200);
                            end
                            else if (span_units >= 3) and
                                display_exact_key_has_stronger_complete_text(
                                span_key, span_text, span_units, 5000) then
                            begin
                                Dec(Result, 9000 + span_units * 2600);
                            end
                            else if (span_units = 2) and
                                is_display_chinese_number_text(span_text) and
                                display_exact_key_has_stronger_complete_text(
                                span_key, span_text, span_units, 200) then
                            begin
                                Dec(Result, 9000);
                            end;
                        end;
                    end;
                end;
                if segment_units = 1 then
                begin
                    if is_display_function_single(segment_text) then
                    begin
                        Inc(Result, 240);
                    end
                    else
                    begin
                        Dec(Result, 2600);
                    end;
                    if previous_was_single then
                    begin
                        Dec(Result, 2200);
                    end;
                    previous_was_single := True;
                end
                else
                begin
                    Inc(Result, 900 + segment_units * 360);
                    if segment_units >= 4 then
                    begin
                        Inc(Result, 5000);
                    end;
                    if display_exact_key_has_text(query_key, segment_text) then
                    begin
                        Inc(Result, 2800 + segment_units * 520);
                    end
                    else if display_exact_key_has_any_complete_text(query_key,
                        segment_units) then
                    begin
                        Dec(Result, 4200 + segment_units * 700);
                    end
                    else
                    begin
                        Dec(Result, 900);
                    end;
                    previous_was_single := False;
                end;
                Inc(segment_start, segment_units);
            end;

            if segment_start <> expected_units then
            begin
                Exit(Low(Integer) div 4);
            end;
        end;

        function top_is_full_query_exact_dictionary_match: Boolean;
        var
            top_text: string;
        begin
            Result := False;
            if (Length(m_candidates) = 0) or (expected_units < 2) or
                (normalized_pinyin = '') or
                (Trim(m_candidates[0].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
                expected_units) then
            begin
                Exit;
            end;

            top_text := Trim(m_candidates[0].text);
            Result := display_exact_key_has_text(normalized_pinyin, top_text);
        end;

        function candidate_is_full_query_exact_dictionary_match(
            const candidate_value: TncCandidate): Boolean;
        var
            candidate_text: string;
        begin
            Result := False;
            if (expected_units < 2) or (normalized_pinyin = '') or
                (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
                expected_units) then
            begin
                Exit;
            end;

            candidate_text := Trim(candidate_value.text);
            Result := display_exact_key_has_text(normalized_pinyin,
                candidate_text);
        end;
    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 4) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_quality := Low(Integer);
        best_rank := Low(Integer);
        top_exact_match := top_is_full_query_exact_dictionary_match;
        top_quality := Low(Integer);
        top_path := get_display_candidate_path_for_index(m_candidates[0], 0);
        if top_path <> '' then
        begin
            top_quality := get_display_path_quality(m_candidates[0], top_path);
        end;
        probe_limit := Min(c_visible_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_path := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            if get_encoded_path_segment_count_local(candidate_path) <= 1 then
            begin
                Continue;
            end;

            candidate_quality := get_display_path_quality(m_candidates[idx],
                candidate_path);
            candidate_rank := candidate_quality + Max(-24000, Min(24000,
                m_candidates[idx].score - m_candidates[0].score));
            if candidate_rank > best_rank then
            begin
                best_rank := candidate_rank;
                best_quality := candidate_quality;
                best_idx := idx;
            end;
        end;

        if m_candidates[0].has_dict_weight then
        begin
            top_effective_dict_weight := m_candidates[0].dict_weight;
        end
        else
        begin
            top_effective_dict_weight := m_candidates[0].score;
        end;
        score_order_complete_path_candidate := (expected_units >= 7) and
            (best_idx > 0) and m_candidates[best_idx].has_dict_weight and
            (best_quality >= top_quality - 1800) and
            (m_candidates[best_idx].dict_weight >
            top_effective_dict_weight + 128);

        if (best_idx <= 0) or
            (Trim(m_candidates[0].comment) <> '') or
            ((expected_units <= 4) and top_exact_match and
            candidate_is_full_query_exact_dictionary_match(
            m_candidates[best_idx]) and
            (m_candidates[best_idx].score < m_candidates[0].score)) or
            ((top_quality <= Low(Integer) div 8) and
            (Trim(m_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
            expected_units) and
            (m_candidates[best_idx].score <
            m_candidates[0].score + c_score_margin)) or
            (top_exact_match and (not
            candidate_is_full_query_exact_dictionary_match(
            m_candidates[best_idx]))) or
            (top_exact_match and
            (m_candidates[best_idx].score <
            m_candidates[0].score + c_score_margin * 4) and
            (best_quality < top_quality + c_quality_margin)) or
            ((not score_order_complete_path_candidate) and
            (best_quality < top_quality + c_quality_margin) and
            ((m_candidates[best_idx].score <
            m_candidates[0].score + c_score_margin) or
            (best_quality < top_quality + c_score_quality_floor))) then
        begin
            Exit;
        end;

        moved_candidate := m_candidates[best_idx];
        moved_path := '';
        if best_idx < Length(m_candidate_segment_paths) then
        begin
            moved_path := m_candidate_segment_paths[best_idx];
        end;
        if moved_path = '' then
        begin
            moved_path := get_display_candidate_path_for_index(moved_candidate,
                best_idx);
        end;
        for local_idx := best_idx downto 1 do
        begin
            m_candidates[local_idx] := m_candidates[local_idx - 1];
            if local_idx < Length(m_candidate_segment_paths) then
            begin
                if (local_idx - 1) < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[local_idx] :=
                        m_candidate_segment_paths[local_idx - 1];
                end
                else
                begin
                    m_candidate_segment_paths[local_idx] := '';
                end;
            end;
        end;
        m_candidates[0] := moved_candidate;
        if Length(m_candidate_segment_paths) > 0 then
        begin
            m_candidate_segment_paths[0] := moved_path;
        end;
    end;

    procedure promote_lower_cross_boundary_exact_penalty_candidate;
    const
        c_visible_probe_limit = 6;
        c_min_penalty_delta = 6000;
        c_max_score_lag = 20000;
    var
        idx: Integer;
        local_idx: Integer;
        probe_limit: Integer;
        top_penalty: Integer;
        candidate_penalty: Integer;
        candidate_rank: Integer;
        top_weight_score: Integer;
        best_idx: Integer;
        best_rank: Integer;
        moved_candidate: TncCandidate;
        moved_path: string;

        function build_candidate_span_text_local(
            const candidate_units: TArray<string>; const start_idx: Integer;
            const unit_count: Integer): string;
        var
            unit_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (unit_count <= 0) or
                (start_idx + unit_count > Length(candidate_units)) then
            begin
                Exit;
            end;

            for unit_idx := start_idx to start_idx + unit_count - 1 do
            begin
                Result := Result + candidate_units[unit_idx];
            end;
        end;

        function get_cross_boundary_exact_penalty(
            const candidate: TncCandidate; const path_value: string): Integer;
        var
            candidate_units: TArray<string>;
            parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
            segment_units: Integer;
            segment_start: Integer;
            boundary_start: Integer;
            span_units: Integer;
            span_start: Integer;
            span_start_min: Integer;
            span_start_max: Integer;
            span_text: string;
            span_key: string;
        begin
            Result := MaxInt div 4;
            if (Trim(candidate.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate.text)) <>
                expected_units) or
                (get_encoded_path_segment_count_local(path_value) <= 1) then
            begin
                Exit;
            end;

            candidate_units := split_text_units(Trim(candidate.text));
            if Length(candidate_units) <> expected_units then
            begin
                Exit;
            end;

            Result := 0;
            parts := path_value.Split([c_segment_path_separator]);
            segment_start := 0;
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                segment_units := get_candidate_text_unit_count(segment_text);
                if (segment_text = '') or (segment_units <= 0) or
                    (segment_start + segment_units > expected_units) then
                begin
                    Exit(MaxInt div 4);
                end;

                boundary_start := segment_start;
                if boundary_start > 0 then
                begin
                    for span_units := 2 to 4 do
                    begin
                        span_start_min := Max(0, boundary_start - span_units + 1);
                        span_start_max := Min(boundary_start - 1,
                            expected_units - span_units);
                        for span_start := span_start_min to span_start_max do
                        begin
                            span_text := build_candidate_span_text_local(
                                candidate_units, span_start, span_units);
                            span_key := build_display_query_key(span_start,
                                span_units);
                            if (span_text = '') or (span_key = '') then
                            begin
                                Continue;
                            end;
                            if span_units >= 3 then
                            begin
                                if (not display_exact_key_has_text(span_key,
                                    span_text)) and
                                    display_exact_key_has_any_complete_text(
                                    span_key, span_units) then
                                begin
                                    Inc(Result, 9000 + span_units * 2600);
                                end
                                else if
                                    display_exact_key_has_stronger_complete_text(
                                    span_key, span_text, span_units, 5000) then
                                begin
                                    Inc(Result, 9000 + span_units * 2600);
                                end;
                            end
                            else if is_display_chinese_number_text(span_text) and
                                display_exact_key_has_stronger_complete_text(
                                span_key, span_text, span_units, 200) then
                            begin
                                Inc(Result, 9000);
                            end;
                        end;
                    end;
                end;

                Inc(segment_start, segment_units);
            end;

            if segment_start <> expected_units then
            begin
                Result := MaxInt div 4;
            end;
        end;

        function get_cross_boundary_exact_weight_score(
            const candidate: TncCandidate; const path_value: string): Integer;
        var
            candidate_units: TArray<string>;
            parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
            segment_units: Integer;
            segment_start: Integer;
            boundary_start: Integer;
            span_units: Integer;
            span_start: Integer;
            span_start_min: Integer;
            span_start_max: Integer;
            span_text: string;
            span_key: string;
            exact_weight: Integer;
        begin
            Result := Low(Integer) div 4;
            if (Trim(candidate.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate.text)) <>
                expected_units) or
                (get_encoded_path_segment_count_local(path_value) <= 1) then
            begin
                Exit;
            end;

            candidate_units := split_text_units(Trim(candidate.text));
            if Length(candidate_units) <> expected_units then
            begin
                Exit;
            end;

            Result := 0;
            parts := path_value.Split([c_segment_path_separator]);
            segment_start := 0;
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                segment_units := get_candidate_text_unit_count(segment_text);
                if (segment_text = '') or (segment_units <= 0) or
                    (segment_start + segment_units > expected_units) then
                begin
                    Exit(Low(Integer) div 4);
                end;

                boundary_start := segment_start;
                if boundary_start > 0 then
                begin
                    for span_units := 2 to 4 do
                    begin
                        span_start_min := Max(0, boundary_start - span_units + 1);
                        span_start_max := Min(boundary_start - 1,
                            expected_units - span_units);
                        for span_start := span_start_min to span_start_max do
                        begin
                            span_text := build_candidate_span_text_local(
                                candidate_units, span_start, span_units);
                            span_key := build_display_query_key(span_start,
                                span_units);
                            if (span_text = '') or (span_key = '') then
                            begin
                                Continue;
                            end;

                            if get_display_exact_text_weight(span_key, span_text,
                                span_units, exact_weight) then
                            begin
                                Inc(Result, exact_weight div 8);
                            end
                            else if (span_units >= 3) and
                                display_exact_key_has_any_complete_text(
                                span_key, span_units) then
                            begin
                                Dec(Result, 6000 + span_units * 1800);
                            end;
                        end;
                    end;
                end;

                Inc(segment_start, segment_units);
            end;

            if segment_start <> expected_units then
            begin
                Result := Low(Integer) div 4;
            end;
        end;
    begin
        if (Length(m_candidates) < 2) or (expected_units < 4) or
            (Length(m_candidate_segment_paths) = 0) then
        begin
            Exit;
        end;
        top_penalty := get_cross_boundary_exact_penalty(m_candidates[0],
            m_candidate_segment_paths[0]);
        if (top_penalty <= c_min_penalty_delta) or
            (top_penalty >= MaxInt div 8) then
        begin
            Exit;
        end;

        best_idx := -1;
        top_weight_score := get_cross_boundary_exact_weight_score(m_candidates[0],
            m_candidate_segment_paths[0]);
        best_rank := Low(Integer);
        probe_limit := Min(c_visible_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if idx >= Length(m_candidate_segment_paths) then
            begin
                Continue;
            end;

            candidate_penalty := get_cross_boundary_exact_penalty(
                m_candidates[idx], m_candidate_segment_paths[idx]);
            if (candidate_penalty >= top_penalty - c_min_penalty_delta) or
                (m_candidates[idx].score < m_candidates[0].score -
                c_max_score_lag) then
            begin
                Continue;
            end;

            candidate_rank := get_cross_boundary_exact_weight_score(
                m_candidates[idx], m_candidate_segment_paths[idx]) -
                top_weight_score + (top_penalty - candidate_penalty) * 4 +
                Max(-c_max_score_lag, Min(c_max_score_lag,
                m_candidates[idx].score - m_candidates[0].score));
            if (candidate_rank > c_min_penalty_delta) and
                (candidate_rank > best_rank) then
            begin
                best_rank := candidate_rank;
                best_idx := idx;
            end;
        end;

        if best_idx <= 0 then
        begin
            Exit;
        end;

        moved_candidate := m_candidates[best_idx];
        moved_path := '';
        if best_idx < Length(m_candidate_segment_paths) then
        begin
            moved_path := m_candidate_segment_paths[best_idx];
        end;
        for local_idx := best_idx downto 1 do
        begin
            m_candidates[local_idx] := m_candidates[local_idx - 1];
            if local_idx < Length(m_candidate_segment_paths) then
            begin
                if local_idx - 1 < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[local_idx] :=
                        m_candidate_segment_paths[local_idx - 1];
                end
                else
                begin
                    m_candidate_segment_paths[local_idx] := '';
                end;
            end;
        end;
        m_candidates[0] := moved_candidate;
        if Length(m_candidate_segment_paths) > 0 then
        begin
            m_candidate_segment_paths[0] := moved_path;
        end;
    end;

    procedure promote_higher_scored_pathful_dict_complete_candidate;
    const
        c_visible_probe_limit = 6;
        c_min_score_delta = 128;
    var
        idx: Integer;
        local_idx: Integer;
        probe_limit: Integer;
        best_idx: Integer;
        best_score: Integer;
        top_weight: Integer;
        moved_candidate: TncCandidate;
        moved_path: string;
    begin
        if (Length(m_candidates) < 2) or (expected_units < 7) or
            (Length(m_candidate_segment_paths) = 0) or
            (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;
        best_idx := -1;
        if m_candidates[0].has_dict_weight then
        begin
            top_weight := m_candidates[0].dict_weight;
        end
        else
        begin
            top_weight := m_candidates[0].score;
        end;
        best_score := top_weight + c_min_score_delta;
        probe_limit := Min(c_visible_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if (idx >= Length(m_candidate_segment_paths)) or
                (not m_candidates[idx].has_dict_weight) or
                (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) or
                (get_encoded_path_segment_count_local(
                m_candidate_segment_paths[idx]) <= 1) then
            begin
                Continue;
            end;

            if m_candidates[idx].dict_weight > best_score then
            begin
                best_score := m_candidates[idx].dict_weight;
                best_idx := idx;
            end;
        end;

        if best_idx <= 0 then
        begin
            Exit;
        end;

        moved_candidate := m_candidates[best_idx];
        moved_path := m_candidate_segment_paths[best_idx];
        for local_idx := best_idx downto 1 do
        begin
            m_candidates[local_idx] := m_candidates[local_idx - 1];
            if local_idx < Length(m_candidate_segment_paths) then
            begin
                if local_idx - 1 < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[local_idx] :=
                        m_candidate_segment_paths[local_idx - 1];
                end
                else
                begin
                    m_candidate_segment_paths[local_idx] := '';
                end;
            end;
        end;
        m_candidates[0] := moved_candidate;
        m_candidate_segment_paths[0] := moved_path;
    end;

    function is_ascii_letter(const value: Char): Boolean;
    begin
        Result := (value >= 'a') and (value <= 'z') or (value >= 'A') and (value <= 'Z');
    end;
    function split_trailing_ascii_candidate(const candidate_text: string; out head: string; out tail: string): Boolean;
    var
        idx: Integer;
        ch: Char;
        tail_len: Integer;
    begin
        Result := False;
        head := '';
        tail := '';
        if candidate_text = '' then
        begin
            Exit;
        end;

        idx := Length(candidate_text);
        while idx > 0 do
        begin
            ch := candidate_text[idx];
            if not is_ascii_letter(ch) then
            begin
                Break;
            end;
            Dec(idx);
        end;

        if idx = Length(candidate_text) then
        begin
            Exit;
        end;

        head := Copy(candidate_text, 1, idx);
        tail := Copy(candidate_text, idx + 1, Length(candidate_text) - idx);
        if (head = '') or (tail = '') then
        begin
            Exit;
        end;

        tail_len := Length(tail);
        if (tail_len <= 0) or (tail_len > Length(normalized_pinyin)) then
        begin
            Exit;
        end;

        if not SameText(Copy(normalized_pinyin, Length(normalized_pinyin) - tail_len + 1, tail_len), tail) then
        begin
            Exit;
        end;

        Result := True;
    end;

    function is_invisible_display_candidate(
        const candidate_value: TncCandidate): Boolean;
    var
        comment_key: string;
        idx: Integer;
        ch: Char;
        has_letter: Boolean;
    begin
        Result := False;
        if Trim(candidate_value.text) <> '' then
        begin
            Exit;
        end;

        comment_key := Trim(candidate_value.comment);
        if comment_key = '' then
        begin
            Result := True;
            Exit;
        end;

        has_letter := False;
        for idx := 1 to Length(comment_key) do
        begin
            ch := comment_key[idx];
            if ((ch >= 'a') and (ch <= 'z')) or
                ((ch >= 'A') and (ch <= 'Z')) then
            begin
                has_letter := True;
                Continue;
            end;
            if (ch = ' ') or (ch = #9) or (ch = '''') then
            begin
                Continue;
            end;
            Result := True;
            Exit;
        end;
        if not has_letter then
        begin
            Result := True;
            Exit;
        end;

        comment_key := normalize_pinyin_text(comment_key);
        comment_key := StringReplace(comment_key, ' ', '', [rfReplaceAll]);
        comment_key := StringReplace(comment_key, #9, '', [rfReplaceAll]);
        comment_key := StringReplace(comment_key, '''', '', [rfReplaceAll]);
        Result := (comment_key = '') or is_full_pinyin_key(comment_key);
    end;

    procedure remove_invisible_display_candidates;
    var
        in_idx: Integer;
        out_idx: Integer;
    begin
        if Length(m_candidates) = 0 then
        begin
            Exit;
        end;

        out_idx := 0;
        for in_idx := 0 to High(m_candidates) do
        begin
            if is_invisible_display_candidate(m_candidates[in_idx]) then
            begin
                Continue;
            end;

            if out_idx <> in_idx then
            begin
                m_candidates[out_idx] := m_candidates[in_idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if in_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[in_idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        SetLength(m_candidates, out_idx);
        if Length(m_candidate_segment_paths) > out_idx then
        begin
            SetLength(m_candidate_segment_paths, out_idx);
        end;
    end;

    procedure apply_single_syllable_fuzzy_exact_ranking;
    var
        original_candidates: TncCandidateList;
        original_paths: TArray<string>;
        seen_candidates: TDictionary<string, Boolean>;
        original_idx: Integer;
        candidate_idx_local: Integer;
        append_idx: Integer;
        relaxed_expected_units: Integer;
        candidate_key: string;
    begin
        original_candidates := Copy(m_candidates, 0, Length(m_candidates));
        original_paths := Copy(m_candidate_segment_paths, 0,
            Length(m_candidate_segment_paths));
        relaxed_expected_units := expected_units;

        { A valid raw single syllable can also have a relaxed missing-apostrophe
          split (for example le -> l/e). Rank fuzzy exacts against the raw
          syllable first, then restore those supplemental partial candidates. }
        expected_units := 1;
        try
            short_exact_query_mode :=
                apply_short_query_exact_display_ranking;
        finally
            expected_units := relaxed_expected_units;
        end;
        if not short_exact_query_mode then
        begin
            Exit;
        end;

        seen_candidates := TDictionary<string, Boolean>.Create;
        try
            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                candidate_key := build_candidate_identity_key(
                    m_candidates[candidate_idx_local].text,
                    m_candidates[candidate_idx_local].comment);
                if candidate_key <> '' then
                begin
                    seen_candidates.AddOrSetValue(candidate_key, True);
                end;
            end;

            for original_idx := 0 to High(original_candidates) do
            begin
                candidate_key := build_candidate_identity_key(
                    original_candidates[original_idx].text,
                    original_candidates[original_idx].comment);
                if (candidate_key = '') or
                    seen_candidates.ContainsKey(candidate_key) then
                begin
                    Continue;
                end;

                append_idx := Length(m_candidates);
                SetLength(m_candidates, append_idx + 1);
                SetLength(m_candidate_segment_paths, append_idx + 1);
                m_candidates[append_idx] := original_candidates[original_idx];
                if original_idx < Length(original_paths) then
                begin
                    m_candidate_segment_paths[append_idx] :=
                        original_paths[original_idx];
                end
                else
                begin
                    m_candidate_segment_paths[append_idx] := '';
                end;
                seen_candidates.AddOrSetValue(candidate_key, True);
            end;
        finally
            seen_candidates.Free;
        end;
    end;

    procedure filter_display_single_syllable_prefix_partials;
    var
        in_idx: Integer;
        out_idx: Integer;
        has_plain_single: Boolean;
        has_full_multi_anchor: Boolean;
        full_results: TncCandidateList;
        full_idx: Integer;

        function is_relaxed_missing_apostrophe_partial(
            const candidate: TncCandidate): Boolean;
        var
            relaxed_syllables: TncPinyinParseResult;
            part_idx: Integer;
            head_key: string;
            tail_key: string;
            candidate_text: string;
            candidate_comment: string;
            anchor_idx: Integer;
            anchor_units: TArray<string>;
        begin
            Result := False;
            if (m_dictionary = nil) or (normalized_pinyin = '') or
                (Pos('''', m_composition_text) > 0) then
            begin
                Exit;
            end;

            candidate_text := Trim(candidate.text);
            candidate_comment := normalize_pinyin_text(Trim(candidate.comment));
            if (candidate_text = '') or (candidate_comment = '') or
                (not is_relaxed_no_initial_syllable_text(candidate_comment)) or
                (get_candidate_text_unit_count(candidate_text) <> 1) then
            begin
                Exit;
            end;

            relaxed_syllables := parse_pinyin_with_relaxed_missing_apostrophe(
                normalized_pinyin);
            if Length(relaxed_syllables) < 2 then
            begin
                Exit;
            end;

            head_key := '';
            for part_idx := 0 to High(relaxed_syllables) - 1 do
            begin
                head_key := head_key + normalize_pinyin_text(
                    Trim(relaxed_syllables[part_idx].text));
            end;
            tail_key := normalize_pinyin_text(
                Trim(relaxed_syllables[High(relaxed_syllables)].text));

            if (head_key = '') or (not SameText(tail_key, candidate_comment)) then
            begin
                Exit;
            end;

            if m_dictionary.single_char_matches_pinyin(head_key, candidate_text) then
            begin
                Exit(True);
            end;

            if has_full_multi_anchor then
            begin
                for anchor_idx := 0 to High(full_results) do
                begin
                    if Trim(full_results[anchor_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    anchor_units := split_text_units(Trim(full_results[anchor_idx].text));
                    if (Length(anchor_units) > 1) and SameText(anchor_units[0],
                        candidate_text) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function is_full_multi_anchor_candidate(
            const candidate: TncCandidate): Boolean;
        var
            candidate_text: string;
            anchor_idx: Integer;
        begin
            Result := False;
            if (not has_full_multi_anchor) or (Trim(candidate.comment) <> '') then
            begin
                Exit;
            end;

            candidate_text := Trim(candidate.text);
            if (candidate_text = '') or
                (get_candidate_text_unit_count(candidate_text) <= 1) then
            begin
                Exit;
            end;

            for anchor_idx := 0 to High(full_results) do
            begin
                if (Trim(full_results[anchor_idx].comment) = '') and
                    SameText(Trim(full_results[anchor_idx].text), candidate_text) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (Length(m_candidates) = 0) or (m_last_lookup_syllable_count <> 1) then
        begin
            Exit;
        end;

        has_plain_single := False;
        for in_idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[in_idx].comment) = '') and
                (get_candidate_text_unit_count(Trim(m_candidates[in_idx].text)) =
                1) then
            begin
                has_plain_single := True;
                Break;
            end;
        end;
        has_full_multi_anchor := False;
        if (m_dictionary <> nil) and m_dictionary.lookup(normalized_pinyin,
            full_results) then
        begin
            for full_idx := 0 to High(full_results) do
            begin
                if (Trim(full_results[full_idx].comment) = '') and
                    (get_candidate_text_unit_count(Trim(full_results[full_idx].text)) >
                    1) then
                begin
                    has_full_multi_anchor := True;
                    Break;
                end;
            end;
        end;

        out_idx := 0;
        for in_idx := 0 to High(m_candidates) do
        begin
            if Trim(m_candidates[in_idx].comment) <> '' then
            begin
                if (has_plain_single and (not has_full_multi_anchor)) or
                    (not is_relaxed_missing_apostrophe_partial(
                    m_candidates[in_idx])) then
                begin
                    Continue;
                end;
            end
            else if get_candidate_text_unit_count(Trim(m_candidates[in_idx].text)) <>
                1 then
            begin
                if has_plain_single and
                    (not is_full_multi_anchor_candidate(m_candidates[in_idx])) then
                begin
                    Continue;
                end;
            end;

            if out_idx <> in_idx then
            begin
                m_candidates[out_idx] := m_candidates[in_idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if in_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[in_idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        SetLength(m_candidates, out_idx);
        if Length(m_candidate_segment_paths) > out_idx then
        begin
            SetLength(m_candidate_segment_paths, out_idx);
        end;
    end;

    function display_complete_text_matches_explicit_apostrophe_boundary(
        const text_value: string): Boolean;
    var
        parser_local: TncPinyinParser;
        apostrophe_syllables_local: TncPinyinParseResult;
        units_local: TArray<string>;
        idx_local: Integer;
    begin
        Result := False;
        if (Pos('''', m_composition_text) <= 0) or (expected_units <= 1) or
            (m_dictionary = nil) then
        begin
            Exit;
        end;

        units_local := split_text_units(Trim(text_value));
        if Length(units_local) <> expected_units then
        begin
            Exit;
        end;

        parser_local := TncPinyinParser.Create;
        try
            apostrophe_syllables_local := parser_local.parse(m_composition_text);
        finally
            parser_local.Free;
        end;

        if Length(apostrophe_syllables_local) <> expected_units then
        begin
            Exit;
        end;

        for idx_local := 0 to expected_units - 1 do
        begin
            if not m_dictionary.single_char_matches_pinyin(
                normalize_pinyin_text(Trim(apostrophe_syllables_local[idx_local].text)),
                units_local[idx_local]) then
            begin
                Exit;
            end;
        end;

        Result := True;
    end;

    procedure filter_display_explicit_apostrophe_complete_candidates;
    var
        idx: Integer;
        out_idx: Integer;
    begin
        if (Pos('''', m_composition_text) <= 0) or (expected_units <= 1) then
        begin
            Exit;
        end;

        out_idx := 0;
        for idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) =
                expected_units) and
                (not display_complete_text_matches_explicit_apostrophe_boundary(
                m_candidates[idx].text)) then
            begin
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
    end;

    procedure capture_entry_pathful_complete_top;
    var
        entry_text: string;
    begin
        has_entry_pathful_complete_top := False;
        FillChar(entry_top_candidate, SizeOf(entry_top_candidate), 0);
        entry_top_path := '';
        if (Length(m_candidates) = 0) or (expected_units <= 0) then
        begin
            Exit;
        end;

        entry_text := Trim(m_candidates[0].text);
        if (entry_text = '') or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(entry_text) <> expected_units) then
        begin
            Exit;
        end;

        if Length(m_candidate_segment_paths) > 0 then
        begin
            entry_top_path := m_candidate_segment_paths[0];
        end;
        if entry_top_path = '' then
        begin
            entry_top_path := get_segment_path_for_candidate(m_candidates[0], 0);
        end;
        if get_encoded_path_segment_count_local(entry_top_path) <= 1 then
        begin
            Exit;
        end;

        entry_top_candidate := m_candidates[0];
        has_entry_pathful_complete_top := True;
    end;

    procedure restore_entry_pathful_complete_top;
    var
        current_text: string;
        entry_text: string;
        found_idx: Integer;
        idx: Integer;
        moved_candidate: TncCandidate;
        moved_path: string;
        current_path: string;
        current_exact_weight: Integer;
        entry_exact_weight: Integer;
        force_entry_over_unpathful_current: Boolean;

        function entry_path_rank_beats_current_local(
            const current_candidate_value: TncCandidate): Boolean;
        const
            c_entry_path_rank_margin = 1024;
        var
            current_rank_local: Integer;
            entry_rank_local: Integer;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(entry_top_path) <= 1 then
            begin
                Exit;
            end;

            current_rank_local := display_candidate_effective_weight(
                current_candidate_value) +
                Max(0, get_segment_path_support_score(current_candidate_value));
            entry_rank_local := display_candidate_effective_weight(
                entry_top_candidate) +
                Max(0, get_segment_path_support_score(entry_top_candidate));
            Result := entry_rank_local >= current_rank_local +
                c_entry_path_rank_margin;
        end;
    begin
        if not has_entry_pathful_complete_top then
        begin
            Exit;
        end;

        entry_text := Trim(entry_top_candidate.text);
        if entry_text = '' then
        begin
            Exit;
        end;

        if Length(m_candidates) > 0 then
        begin
            current_text := Trim(m_candidates[0].text);
            if SameText(current_text, entry_text) and
                SameText(Trim(m_candidates[0].comment),
                Trim(entry_top_candidate.comment)) then
            begin
                Exit;
            end;
            if (m_candidates[0].source = cs_user) or
                is_latest_session_query_choice(current_text) or
                (get_context_query_latest_bonus(current_text) > 0) then
            begin
                Exit;
            end;
            current_path := get_display_candidate_path_for_index(m_candidates[0], 0);
            force_entry_over_unpathful_current :=
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(current_text) = expected_units) and
                (get_encoded_path_segment_count_local(entry_top_path) > 1) and
                (get_encoded_path_segment_count_local(current_path) <= 1) and
                ((normalized_pinyin = '') or
                (not display_exact_key_has_text(normalized_pinyin, current_text)));
            if (normalized_pinyin <> '') and
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(current_text) = expected_units) and
                display_exact_key_has_text(normalized_pinyin, current_text) and
                (not display_exact_key_has_text(normalized_pinyin,
                entry_text)) and
                (not force_entry_over_unpathful_current) and
                (not entry_path_rank_beats_current_local(m_candidates[0])) and
                (display_candidate_effective_weight(m_candidates[0]) +
                Max(0, get_segment_path_support_score(m_candidates[0])) >=
                display_candidate_effective_weight(entry_top_candidate) +
                Max(0, get_segment_path_support_score(entry_top_candidate)) -
                1024) then
            begin
                Exit;
            end;
            if (normalized_pinyin <> '') and
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(current_text) = expected_units) and
                display_exact_key_has_text(normalized_pinyin, current_text) and
                display_exact_key_has_text(normalized_pinyin, entry_text) and
                get_display_exact_text_weight(normalized_pinyin, current_text,
                expected_units, current_exact_weight) and
                get_display_exact_text_weight(normalized_pinyin, entry_text,
                expected_units, entry_exact_weight) and
                (current_exact_weight > entry_exact_weight + 256) then
            begin
                Exit;
            end;
            if (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(current_text) = expected_units) and
                (display_candidate_effective_weight(m_candidates[0]) +
                Max(0, get_segment_path_support_score(m_candidates[0])) >
                display_candidate_effective_weight(entry_top_candidate) +
                Max(0, get_segment_path_support_score(entry_top_candidate)) +
                1024) and
                (normalized_pinyin <> '') and
                (not force_entry_over_unpathful_current) and
                display_exact_key_has_text(normalized_pinyin, current_text) then
            begin
                Exit;
            end;
            if (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(current_text) = expected_units) and
                (not SameText(current_text, entry_text)) and
                display_path_has_nonprimary_multi_char_segment_outer(
                entry_top_path) and
                (not entry_path_rank_beats_current_local(m_candidates[0])) and
                (not force_entry_over_unpathful_current) and
                (display_candidate_effective_weight(m_candidates[0]) +
                Max(0, get_segment_path_support_score(m_candidates[0])) >
                display_candidate_effective_weight(entry_top_candidate) +
                Max(0, get_segment_path_support_score(entry_top_candidate)) +
                1024) and
                (not display_candidate_crosses_protected_exact_pair(
                m_candidates[0], 0)) then
            begin
                Exit;
            end;
        end;

        found_idx := -1;
        for idx := 0 to High(m_candidates) do
        begin
            if SameText(Trim(m_candidates[idx].text), entry_text) and
                SameText(Trim(m_candidates[idx].comment),
                Trim(entry_top_candidate.comment)) then
            begin
                found_idx := idx;
                Break;
            end;
        end;

        if found_idx < 0 then
        begin
            insert_display_candidate(entry_top_candidate, entry_top_path, 0);
            m_visible_candidates_cache_valid := False;
            Exit;
        end;

        if found_idx = 0 then
        begin
            Exit;
        end;

        moved_candidate := m_candidates[found_idx];
        moved_path := entry_top_path;
        if found_idx < Length(m_candidate_segment_paths) then
        begin
            if m_candidate_segment_paths[found_idx] <> '' then
            begin
                moved_path := m_candidate_segment_paths[found_idx];
            end;
        end;
        for idx := found_idx downto 1 do
        begin
            m_candidates[idx] := m_candidates[idx - 1];
            if idx < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[idx] := m_candidate_segment_paths[idx - 1];
            end;
        end;
        m_candidates[0] := moved_candidate;
        if Length(m_candidate_segment_paths) > 0 then
        begin
            m_candidate_segment_paths[0] := moved_path;
        end;
        m_visible_candidates_cache_valid := False;
    end;

    procedure filter_display_protected_exact_pair_crossing_candidates;
    var
        idx: Integer;
        out_idx: Integer;
        candidate_text_local: string;
        has_safe_complete_local: Boolean;
        removed_count_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) then
        begin
            Exit;
        end;

        has_safe_complete_local := False;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                (not display_candidate_crosses_protected_exact_pair(
                m_candidates[idx], idx)) then
            begin
                has_safe_complete_local := True;
                Break;
            end;
        end;

        if not has_safe_complete_local then
        begin
            Exit;
        end;

        out_idx := 0;
        removed_count_local := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                (m_candidates[idx].source <> cs_user) and
                (not is_latest_session_query_choice(candidate_text_local)) and
                (get_context_query_latest_bonus(candidate_text_local) <= 0) and
                (not (has_entry_pathful_complete_top and
                (get_encoded_path_segment_count_local(entry_top_path) > 1) and
                (get_encoded_path_segment_count_local(
                get_display_candidate_path_for_index(m_candidates[idx], idx)) >
                1) and
                SameText(candidate_text_local, Trim(entry_top_candidate.text)) and
                SameText(Trim(m_candidates[idx].comment),
                Trim(entry_top_candidate.comment)))) and
                display_candidate_crosses_protected_exact_pair(
                m_candidates[idx], idx) then
            begin
                Inc(removed_count_local);
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
        if m_config.debug_mode and (removed_count_local > 0) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' disp_xpairdrop=[n=%d]', [removed_count_local]);
        end;
    end;

    procedure promote_display_full_query_exact_candidate;
    const
        c_probe_limit = 8;
        c_min_promotable_base_exact_weight = 160;
        c_min_promotable_short_exact_weight = 600;
    var
        idx: Integer;
        best_idx: Integer;
        probe_limit: Integer;
        min_promotable_exact_weight: Integer;
        candidate_text_local: string;
        exact_weight_local: Integer;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
        query_choice_bonus_local: Integer;
        has_supported_exact_candidate: Boolean;
        has_base_exact_candidate: Boolean;
        top_path_local: string;
        top_text_local: string;

        function candidate_is_recent_supported_user_exact_local(
            const candidate_value: TncCandidate; const candidate_text_value: string): Boolean;
        var
            latest_text_local: string;
            candidate_weight_local: Integer;
        begin
            latest_text_local := '';
            if m_dictionary <> nil then
            begin
                latest_text_local := get_cached_query_latest_choice_text(
                    normalized_pinyin);
            end;
            if (latest_text_local <> '') and
                SameText(latest_text_local, candidate_text_value) then
            begin
                Exit(True);
            end;
            Result := False;
            if (candidate_value.source <> cs_user) or
                (not (display_candidate_has_supported_full_entry(normalized_pinyin,
                candidate_value) or
                display_exact_key_has_text(normalized_pinyin,
                candidate_text_value) or
                ((m_dictionary <> nil) and
                m_dictionary.is_user_entry(normalized_pinyin,
                candidate_text_value)))) then
            begin
                Exit;
            end;

            if candidate_value.has_dict_weight then
            begin
                candidate_weight_local := candidate_value.dict_weight;
            end
            else
            begin
                candidate_weight_local := candidate_value.score;
            end;
            Result := is_latest_session_query_choice(candidate_text_value) or
                display_candidate_is_persistent_latest_choice(normalized_pinyin,
                candidate_text_value) or
                (get_context_query_latest_bonus(candidate_text_value) > 0) or
                (candidate_weight_local >= 256);
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 2) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank_local := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        if expected_units <= 3 then
        begin
            min_promotable_exact_weight := c_min_promotable_short_exact_weight;
        end
        else
        begin
            min_promotable_exact_weight := c_min_promotable_base_exact_weight;
        end;
        has_supported_exact_candidate := False;
        has_base_exact_candidate := False;
        for idx := 0 to probe_limit do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                display_candidate_has_supported_full_entry(normalized_pinyin,
                m_candidates[idx]) then
            begin
                has_supported_exact_candidate := True;
                if display_candidate_has_base_full_entry(normalized_pinyin,
                    m_candidates[idx]) then
                begin
                    has_base_exact_candidate := True;
                end;
            end;
        end;
        for idx := 0 to probe_limit do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local = '') or
                (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units) or
                (not display_exact_key_has_text(normalized_pinyin,
                candidate_text_local) and
                (not candidate_is_recent_supported_user_exact_local(
                m_candidates[idx], candidate_text_local))) then
            begin
                Continue;
            end;

            if (m_candidates[idx].source = cs_user) and
                (not candidate_is_recent_supported_user_exact_local(
                m_candidates[idx], candidate_text_local)) then
            begin
                Continue;
            end;

            if has_base_exact_candidate and
                (not display_candidate_has_base_full_entry(
                normalized_pinyin, m_candidates[idx])) and
                (not candidate_is_recent_supported_user_exact_local(
                m_candidates[idx], candidate_text_local)) then
            begin
                Continue;
            end;

            if has_supported_exact_candidate and
                (not display_candidate_has_supported_full_entry(
                normalized_pinyin, m_candidates[idx])) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]);
            if get_display_exact_text_weight(normalized_pinyin,
                candidate_text_local, expected_units, exact_weight_local) then
            begin
                Inc(candidate_rank_local, exact_weight_local * 2);
            end;
            if (m_dictionary <> nil) and is_full_pinyin_key(normalized_pinyin) then
            begin
                query_choice_bonus_local := m_dictionary.get_query_choice_bonus(
                    normalized_pinyin, candidate_text_local);
                if query_choice_bonus_local > 0 then
                begin
                    Inc(candidate_rank_local, query_choice_bonus_local * 1000);
                end;
            end;
            if (m_candidates[idx].source = cs_user) and
                candidate_is_recent_supported_user_exact_local(
                m_candidates[idx], candidate_text_local) then
            begin
                Inc(candidate_rank_local, 1000000);
            end;
            if is_latest_session_query_choice(candidate_text_local) or
                (get_context_query_latest_bonus(candidate_text_local) > 0) or
                ((m_dictionary <> nil) and
                SameText(get_cached_query_latest_choice_text(
                normalized_pinyin), candidate_text_local)) then
            begin
                Inc(candidate_rank_local, 2000000);
            end;

            if (best_idx < 0) or (candidate_rank_local > best_rank_local) then
            begin
                best_idx := idx;
                best_rank_local := candidate_rank_local;
            end;
        end;

        if best_idx > 0 then
        begin
            candidate_text_local := Trim(m_candidates[best_idx].text);
            top_text_local := '';
            top_path_local := '';
            if Length(m_candidates) > 0 then
            begin
                top_text_local := Trim(m_candidates[0].text);
                top_path_local := get_display_candidate_path_for_index(
                    m_candidates[0], 0);
            end;
            if (m_candidates[best_idx].source <> cs_user) and
                (not is_latest_session_query_choice(candidate_text_local)) and
                (get_context_query_latest_bonus(candidate_text_local) <= 0) and
                get_display_exact_text_weight(normalized_pinyin,
                candidate_text_local, expected_units, exact_weight_local) and
                (exact_weight_local < min_promotable_exact_weight) and
                (top_text_local <> '') and
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(top_text_local) = expected_units) and
                (not display_exact_key_has_text(normalized_pinyin,
                top_text_local)) and
                (get_encoded_path_segment_count_local(top_path_local) > 1) and
                (not display_path_has_nonprimary_multi_char_segment_outer(
                top_path_local)) then
            begin
                Exit;
            end;
            if display_path_has_nonprimary_multi_char_segment_outer(
                top_path_local) then
            begin
                force_move_display_candidate_to_index(best_idx, 0);
            end
            else
            begin
                move_display_candidate_to_index(best_idx, 0);
            end;
        end;
    end;

    procedure promote_display_one_plus_two_function_complete_candidate;
    const
        c_probe_limit = 8;
    var
        idx: Integer;
        best_idx: Integer;
        probe_limit: Integer;
        path_local: string;
        top_path_local: string;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units <> 3) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        if (Trim(m_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
            expected_units) and
            display_exact_key_has_text(normalized_pinyin,
            Trim(m_candidates[0].text)) then
        begin
            Exit;
        end;

        top_path_local := get_display_candidate_path_for_index(
            m_candidates[0], 0);
        if not display_path_has_two_plus_one_non_particle_tail(
            top_path_local) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank_local := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            path_local := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            if not display_path_has_one_plus_two_function_head(path_local) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]);
            if (m_candidates[idx].source = cs_user) and
                (((not m_candidates[idx].has_dict_weight) and
                (m_candidates[idx].score >= 4096)) or
                (m_candidates[idx].has_dict_weight and
                (m_candidates[idx].dict_weight >= 4096))) then
            begin
                Inc(candidate_rank_local, 1000000);
            end;
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx := idx;
            end;
        end;

        if best_idx > 0 then
        begin
            move_display_candidate_to_index(best_idx, 0);
        end;
    end;

    procedure promote_display_exact_two_syllable_head_path_candidate;
    const
        c_probe_limit = 8;
    var
        idx: Integer;
        best_idx: Integer;
        probe_limit: Integer;
        top_text_units_local: TArray<string>;
        top_head_text_local: string;
        head_key_local: string;
        path_local: string;
        parts_local: TArray<string>;
        head_segment_local: string;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        if (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        if (m_candidates[0].source = cs_user) and
            (((not m_candidates[0].has_dict_weight) and
            (m_candidates[0].score >= 4096)) or
            (m_candidates[0].has_dict_weight and
            (m_candidates[0].dict_weight >= 4096)) or
            is_latest_session_query_choice(Trim(m_candidates[0].text)) or
            (get_context_query_latest_bonus(Trim(m_candidates[0].text)) > 0)) then
        begin
            Exit;
        end;

        top_text_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_text_units_local) < 2 then
        begin
            Exit;
        end;
        top_head_text_local := top_text_units_local[0] +
            top_text_units_local[1];
        head_key_local := build_display_query_key(0, 2);
        if (head_key_local = '') or
            display_exact_key_has_text(head_key_local, top_head_text_local) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank_local := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            path_local := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            if get_encoded_path_segment_count_local(path_local) <= 1 then
            begin
                Continue;
            end;
            parts_local := path_local.Split([c_segment_path_separator]);
            if Length(parts_local) < 2 then
            begin
                Continue;
            end;

            head_segment_local := Trim(parts_local[0]);
            if (get_candidate_text_unit_count(head_segment_local) <> 2) or
                (not display_exact_key_has_text(head_key_local,
                head_segment_local)) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]);
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx := idx;
            end;
        end;

        if best_idx > 0 then
        begin
            move_display_candidate_to_index(best_idx, 0);
        end;
    end;

