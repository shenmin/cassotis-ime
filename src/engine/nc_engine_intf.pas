        function score_diff_local_exact_support_local(
            const candidate_units_local: TArray<string>): Integer;
        const
            c_max_span_len = 5;
            c_min_span_len = 3;
            c_score_cap = 36000;
            c_two_char_score_cap = 24000;
        var
            span_len_local: Integer;
            start_idx_local: Integer;
            candidate_weight_local: Integer;
            top_weight_for_span_local: Integer;
            candidate_exact_local: Boolean;
            top_exact_local: Boolean;
            weight_delta_local: Integer;
            two_char_candidate_only_count_local: Integer;
            two_char_candidate_only_score_local: Integer;

            function candidate_span_replaces_stronger_top_two_char_local(
                const start_idx_value: Integer; const span_len_value: Integer): Boolean;
            var
                pair_start_local: Integer;
                candidate_pair_weight_local: Integer;
                top_pair_weight_local: Integer;
                candidate_pair_exact_local: Boolean;
                top_pair_exact_local: Boolean;
            begin
                Result := False;
                if span_len_value <= 2 then
                begin
                    Exit;
                end;

                for pair_start_local := start_idx_value to
                    start_idx_value + span_len_value - 2 do
                begin
                    if (not range_has_diff_local(candidate_units_local,
                        pair_start_local, 2)) then
                    begin
                        Continue;
                    end;

                    candidate_pair_exact_local := get_exact_span_support_local(
                        candidate_units_local, pair_start_local, 2,
                        candidate_pair_weight_local);
                    top_pair_exact_local := get_exact_span_support_local(
                        top_units_local, pair_start_local, 2,
                        top_pair_weight_local);
                    if candidate_pair_exact_local and top_pair_exact_local and
                        (top_pair_weight_local >= candidate_pair_weight_local + 500) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := 0;
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            for span_len_local := Min(c_max_span_len, expected_units) downto
                c_min_span_len do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    if not range_has_diff_local(candidate_units_local,
                        start_idx_local, span_len_local) then
                    begin
                        Continue;
                    end;
                    if range_has_context_function_diff_local(
                        candidate_units_local, start_idx_local,
                        span_len_local) then
                    begin
                        Continue;
                    end;

                    candidate_exact_local := get_exact_span_support_local(
                        candidate_units_local, start_idx_local, span_len_local,
                        candidate_weight_local);
                    if not candidate_exact_local then
                    begin
                        Continue;
                    end;

                    top_exact_local := get_exact_span_support_local(
                        top_units_local, start_idx_local, span_len_local,
                        top_weight_for_span_local);
                    if not top_exact_local then
                    begin
                        if not candidate_span_replaces_stronger_top_two_char_local(
                            start_idx_local, span_len_local) then
                        begin
                            Inc(Result, span_len_local * span_len_local * 4200 +
                                Min(9000, Max(0, candidate_weight_local) * 4));
                        end;
                    end
                    else
                    begin
                        weight_delta_local := candidate_weight_local -
                            top_weight_for_span_local;
                        if weight_delta_local >= 2000 then
                        begin
                            Inc(Result, Min(6000, weight_delta_local * 2));
                        end;
                    end;

                    if Result >= c_score_cap then
                    begin
                        Exit(c_score_cap);
                    end;
                end;
            end;

            two_char_candidate_only_count_local := 0;
            two_char_candidate_only_score_local := 0;
            for start_idx_local := 0 to expected_units - 2 do
            begin
                if (not range_has_diff_local(candidate_units_local,
                    start_idx_local, 2)) or
                    range_has_context_function_diff_local(candidate_units_local,
                    start_idx_local, 2) then
                begin
                    Continue;
                end;

                candidate_exact_local := get_exact_span_support_local(
                    candidate_units_local, start_idx_local, 2,
                    candidate_weight_local);
                if not candidate_exact_local then
                begin
                    Continue;
                end;

                top_exact_local := get_exact_span_support_local(top_units_local,
                    start_idx_local, 2, top_weight_for_span_local);
                if not top_exact_local then
                begin
                    Inc(two_char_candidate_only_count_local);
                    Inc(two_char_candidate_only_score_local, 9000 +
                        Min(5000, Max(0, candidate_weight_local) * 3));
                end;
            end;

            if two_char_candidate_only_count_local >= 999 then
            begin
                Inc(Result, Min(c_two_char_score_cap,
                    two_char_candidate_only_score_local));
            end;

            if Result > c_score_cap then
            begin
                Result := c_score_cap;
            end;
        end;

        function score_context_preference_local(const candidate_units_local:
            TArray<string>): Integer;
        var
            unit_idx: Integer;
            diff_count_local: Integer;
            prev_unit_local: string;
            next_unit_local: string;

            function previous_unit_matches_local(const code_value: Word): Boolean;
            begin
                Result := (prev_unit_local <> '') and
                    unit_matches_local(prev_unit_local, code_value);
            end;

            function next_unit_matches_local(const code_value: Word): Boolean;
            begin
                Result := (next_unit_local <> '') and
                    unit_matches_local(next_unit_local, code_value);
            end;

            function previous_top_unit_matches_local(const code_value: Word): Boolean;
            begin
                Result := (unit_idx > 0) and
                    unit_matches_local(top_units_local[unit_idx - 1], code_value);
            end;

            function next_top_unit_matches_local(const code_value: Word): Boolean;
            begin
                Result := (unit_idx + 1 < expected_units) and
                    unit_matches_local(top_units_local[unit_idx + 1], code_value);
            end;

            function candidate_pair_replaces_top_pair_local(
                const candidate_first: Word; const candidate_second: Word;
                const top_first: Word; const top_second: Word): Boolean;
            begin
                Result := False;
                if unit_matches_local(candidate_units_local[unit_idx],
                    candidate_first) and unit_matches_local(
                    top_units_local[unit_idx], top_first) and
                    next_unit_matches_local(candidate_second) and
                    next_top_unit_matches_local(top_second) then
                begin
                    Exit(True);
                end;

                if unit_matches_local(candidate_units_local[unit_idx],
                    candidate_second) and unit_matches_local(
                    top_units_local[unit_idx], top_second) and
                    previous_unit_matches_local(candidate_first) and
                    previous_top_unit_matches_local(top_first) then
                begin
                    Exit(True);
                end;
            end;

            function following_units_form_exact_phrase_local(
                const start_idx_value: Integer; const unit_count_value: Integer): Boolean;
            var
                local_idx: Integer;
                query_key_local: string;
                text_local: string;
            begin
                Result := False;
                if (start_idx_value < 0) or (unit_count_value <= 1) or
                    (start_idx_value + unit_count_value > expected_units) then
                begin
                    Exit;
                end;

                query_key_local := build_display_query_key(start_idx_value,
                    unit_count_value);
                text_local := '';
                for local_idx := start_idx_value to
                    start_idx_value + unit_count_value - 1 do
                begin
                    text_local := text_local + candidate_units_local[local_idx];
                end;
                Result := (query_key_local <> '') and (text_local <> '') and
                    display_exact_key_has_text(query_key_local, text_local);
            end;

            function next_context_is_exact_phrase_local: Boolean;
            begin
                Result := following_units_form_exact_phrase_local(unit_idx + 1, 2) or
                    following_units_form_exact_phrase_local(unit_idx + 1, 3);
            end;

        begin
            Result := 0;
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            diff_count_local := 0;
            for unit_idx := 0 to expected_units - 1 do
            begin
                if units_equal_local(top_units_local, candidate_units_local,
                    unit_idx) then
                begin
                    Continue;
                end;

                Inc(diff_count_local);
                if diff_count_local > c_max_diff_units then
                begin
                    Dec(Result, 32000);
                    Exit;
                end;

                prev_unit_local := '';
                next_unit_local := '';
                if unit_idx > 0 then
                begin
                    prev_unit_local := candidate_units_local[unit_idx - 1];
                end;
                if unit_idx + 1 < expected_units then
                begin
                    next_unit_local := candidate_units_local[unit_idx + 1];
                end;

                if candidate_pair_replaces_top_pair_local($624B, $673A,
                    $6536, $96C6) or
                    candidate_pair_replaces_top_pair_local($6536, $96C6,
                    $53D7, $63A5) or
                    candidate_pair_replaces_top_pair_local($963B, $6B62,
                    $7EC4, $7EC7) or
                    candidate_pair_replaces_top_pair_local($518D, $6B21,
                    $5728, $6B64) or
                    candidate_pair_replaces_top_pair_local($751F, $547D,
                    $58F0, $660E) or
                    candidate_pair_replaces_top_pair_local($663E, $5F97,
                    $95F2, $7684) or
                    candidate_pair_replaces_top_pair_local($7F13, $7F13,
                    $6362, $6362) or
                    candidate_pair_replaces_top_pair_local($5176, $5B9E,
                    $8D77, $59CB) or
                    candidate_pair_replaces_top_pair_local($5408, $4F19,
                    $548C, $6D3B) or
                    candidate_pair_replaces_top_pair_local($540C, $610F,
                    $7EDF, $4E00) or
                    candidate_pair_replaces_top_pair_local($79D1, $6280,
                    $53EF, $53CA) then
                begin
                    Inc(Result, 70000);
                    Continue;
                end;

                if unit_matches_local(candidate_units_local[unit_idx], $7684) and
                    (unit_matches_local(top_units_local[unit_idx], $5730) or
                    unit_matches_local(top_units_local[unit_idx], $5F97)) then
                begin
                    if (next_unit_local <> '') and
                        ((not is_likely_predicate_head_unit_local(next_unit_local)) or
                        next_context_is_exact_phrase_local) then
                    begin
                        Inc(Result, 32000);
                    end;
                    Continue;
                end;

                if unit_matches_local(candidate_units_local[unit_idx], $5730) and
                    unit_matches_local(top_units_local[unit_idx], $7684) then
                begin
                    if (next_unit_local <> '') and
                        is_likely_predicate_head_unit_local(next_unit_local) and
                        (not next_context_is_exact_phrase_local) then
                    begin
                        Inc(Result, 30000);
                    end;
                    Continue;
                end;

                if unit_matches_local(candidate_units_local[unit_idx], $5F97) and
                    unit_matches_local(top_units_local[unit_idx], $7684) then
                begin
                    if previous_unit_matches_local($8BB0) then
                    begin
                        Inc(Result, 30000);
                    end;
                    Continue;
                end;

                if unit_matches_local(candidate_units_local[unit_idx], $5728) and
                    unit_matches_local(top_units_local[unit_idx], $518D) then
                begin
                    if (next_unit_local <> '') and
                        (is_zai_context_unit_local(next_unit_local) or
