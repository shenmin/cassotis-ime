    procedure clear_candidate_comments(var candidates: TncCandidateList);
    var
        idx: Integer;
    begin
        for idx := 0 to High(candidates) do
        begin
            candidates[idx].comment := '';
        end;
    end;

    procedure promote_longest_partial_prefix_candidate_local(
        var candidates: TncCandidateList);
    var
        idx: Integer;
        best_idx: Integer;
        best_units: Integer;
        units: Integer;
        picked: TncCandidate;
    begin
        best_idx := -1;
        best_units := 0;
        for idx := 0 to High(candidates) do
        begin
            if Trim(candidates[idx].comment) = '' then
            begin
                Continue;
            end;

            units := get_candidate_text_unit_count(Trim(candidates[idx].text));
            if (units < 2) or (units < best_units) then
            begin
                Continue;
            end;
            if (units = best_units) and (best_idx >= 0) and
                (candidates[idx].score <= candidates[best_idx].score) then
            begin
                Continue;
            end;

            best_idx := idx;
            best_units := units;
        end;

        if best_idx <= 0 then
        begin
            Exit;
        end;

        picked := candidates[best_idx];
        while best_idx > 0 do
        begin
            candidates[best_idx] := candidates[best_idx - 1];
            Dec(best_idx);
        end;
        candidates[0] := picked;
    end;

