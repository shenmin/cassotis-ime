        function candidate_has_sentence_particle_tail_split_local(
            const candidate: TncCandidate): Boolean;
        var
            encoded_path_local: string;
            segment_parts_local: TArray<string>;
            tail_text_local: string;
        begin
            Result := False;
            if Trim(candidate.comment) <> '' then
            begin
                Exit;
            end;

            encoded_path_local := get_candidate_segment_path_for_filter_local(
                candidate);
            if encoded_path_local = '' then
            begin
                Exit;
            end;
            segment_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            if Length(segment_parts_local) < 2 then
            begin
                Exit;
            end;

            tail_text_local := Trim(segment_parts_local[High(segment_parts_local)]);
            Result := (get_candidate_text_unit_count(tail_text_local) = 1) and
                is_sentence_particle_single_segment_text_local(tail_text_local);
        end;

        function is_complete_for_query_local(const candidate: TncCandidate): Boolean;
        begin
            Result := (Trim(candidate.comment) = '') and
                (get_candidate_text_unit_count(Trim(candidate.text)) = expected_units);
        end;

        function segment_path_has_nonbase_two_plus_single_segment_local(
            const candidate: TncCandidate): Boolean;
        var
            encoded_path_local: string;
            segment_parts_local: TArray<string>;
            syllables_local: TncPinyinParseResult;
            part_idx_local: Integer;
            syllable_pos_local: Integer;
            segment_units_local: Integer;
            segment_text_local: string;
            segment_key_local: string;
            head_key_local: string;
            tail_key_local: string;
            head_text_local: string;
            tail_text_local: string;
            segment_unit_texts_local: TArray<string>;

            function build_span_key_local(const start_idx_local: Integer;
                const count_local: Integer): string;
            var
                local_idx: Integer;
            begin
                Result := '';
                if (start_idx_local < 0) or (count_local <= 0) or
                    (start_idx_local + count_local > Length(syllables_local)) then
                begin
                    Exit;
                end;

                for local_idx := start_idx_local to
                    start_idx_local + count_local - 1 do
                begin
                    Result := Result + normalize_pinyin_text(
                        syllables_local[local_idx].text);
                end;
            end;

            function exact_lookup_has_text_local(const key_value: string;
                const text_value: string; const expected_units_value: Integer;
                const require_reliable: Boolean): Boolean;
            var
                exact_results_value: TncCandidateList;
                exact_idx_value: Integer;
                exact_text_value: string;
            begin
                Result := False;
                if (key_value = '') or (text_value = '') or
                    (expected_units_value <= 0) or
                    (not lookup_exact_full_pinyin_cached_local(key_value,
                    exact_results_value)) then
                begin
                    Exit;
                end;

                for exact_idx_value := 0 to High(exact_results_value) do
                begin
                    if Trim(exact_results_value[exact_idx_value].comment) <> '' then
                    begin
                        Continue;
                    end;
                    exact_text_value := Trim(
                        exact_results_value[exact_idx_value].text);
                    if SameText(exact_text_value, text_value) and
                        (get_candidate_text_unit_count(exact_text_value) =
                        expected_units_value) then
                    begin
                        if require_reliable and
                            (exact_results_value[exact_idx_value].source <> cs_user) and
                            ((not exact_results_value[exact_idx_value].has_dict_weight) or
                            (exact_results_value[exact_idx_value].dict_weight <= 0)) then
                        begin
                            Continue;
                        end;
                        Exit(True);
                    end;
                end;
            end;

            function is_allowed_single_tail_text_local(
                const text_value: string): Boolean;
            begin
                Result := is_sentence_particle_single_segment_text_local(
                    text_value) or is_function_single_segment_text_local(
                    text_value);
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (not is_complete_for_query_local(candidate)) then
            begin
                Exit;
            end;

            encoded_path_local := get_candidate_segment_path_for_filter_local(
                candidate);
            if get_encoded_path_segment_count_local(encoded_path_local) <= 1 then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(lookup_text));
            if Length(syllables_local) <> expected_units then
            begin
                Exit;
            end;

            segment_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            syllable_pos_local := 0;
            for part_idx_local := 0 to High(segment_parts_local) do
            begin
                segment_text_local := Trim(segment_parts_local[part_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if segment_units_local <= 0 then
                begin
                    Continue;
                end;
                if syllable_pos_local + segment_units_local >
                    Length(syllables_local) then
                begin
                    Exit;
                end;

                if segment_units_local = 3 then
                begin
                    segment_key_local := build_span_key_local(
                        syllable_pos_local, 3);
                    if (segment_key_local <> '') and
                        (not m_dictionary.is_user_entry(segment_key_local,
                        segment_text_local)) and
                        (not exact_lookup_has_text_local(segment_key_local,
                        segment_text_local, 3, True)) then
                    begin
                        segment_unit_texts_local := split_text_units(
                            segment_text_local);
                        if Length(segment_unit_texts_local) = 3 then
                        begin
                            head_key_local := build_span_key_local(
                                syllable_pos_local, 2);
                            tail_key_local := build_span_key_local(
                                syllable_pos_local + 2, 1);
                            head_text_local := segment_unit_texts_local[0] +
                                segment_unit_texts_local[1];
                            tail_text_local := segment_unit_texts_local[2];
                            if (not is_allowed_single_tail_text_local(
                                tail_text_local)) and
                                exact_lookup_has_text_local(head_key_local,
                                head_text_local, 2, False) and
                                (m_dictionary.single_char_matches_pinyin(
                                tail_key_local, tail_text_local) or
                                exact_lookup_has_text_local(tail_key_local,
                                tail_text_local, 1, False)) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                Inc(syllable_pos_local, segment_units_local);
            end;
        end;

        function candidate_has_supported_full_entry_local(
            const candidate: TncCandidate): Boolean;
        const
            c_min_supported_exact_dict_weight = 160;
        var
            candidate_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (lookup_text = '') or
                (not is_complete_for_query_local(candidate)) then
            begin
                Exit;
            end;

            candidate_text_local := Trim(candidate.text);
            Result := m_dictionary.is_base_entry(lookup_text,
                candidate_text_local) or
                ((candidate.source = cs_rule) and candidate.has_dict_weight and
                (candidate.dict_weight >= c_min_supported_exact_dict_weight) and
                candidate_has_exact_base_entry_local(candidate)) or
                ((candidate.source = cs_user) and
                m_dictionary.is_user_entry(lookup_text, candidate_text_local) and
                (not m_dictionary.should_suppress_exact_query_learning(
                    lookup_text, candidate_text_local)));
        end;

        function is_normal_complete_candidate_local(
            const candidate: TncCandidate): Boolean;
        begin
            Result := is_complete_for_query_local(candidate) and
                (candidate_has_supported_full_entry_local(candidate) or
                candidate_has_lexicon_longer_prefix_support_local(candidate) or
                candidate_has_three_syllable_lexicon_split_support_local(
                candidate) or
                candidate_has_fixed_pronoun_tail_split_support_local(candidate) or
                candidate_has_pronoun_connector_tail_split_support_local(candidate) or
                candidate_has_four_syllable_two_phrase_split_support_local(
                    candidate) or
                (candidate.has_dict_weight and
                segment_path_has_multi_char_segment_local(candidate) and
                (not segment_path_has_disallowed_single_segment_local(
                candidate)))) and
                (not is_problematic_single_char_chain_candidate_for_query(
                lookup_text, candidate));
        end;

        function is_polluted_complete_candidate_local(
            const candidate: TncCandidate): Boolean;
        var
            text_key_local: string;
        begin
            text_key_local := Trim(candidate.text);
            if (expected_units = 3) and is_complete_for_query_local(candidate) and
                (not candidate_has_supported_full_entry_local(candidate)) and
                candidate_has_two_plus_one_non_particle_tail_split_local(
                candidate) and
                (not is_short_three_exact_pair_candidate_supported_local(
                candidate.text)) and
                (not candidate_has_ordinal_quantity_two_plus_one_split_local(
                candidate)) then
            begin
                Exit(True);
            end;

            if is_complete_for_query_local(candidate) and
                candidate_has_fixed_pronoun_tail_split_support_local(candidate) then
            begin
                Exit(False);
            end;

            if is_complete_for_query_local(candidate) and
                candidate_has_pronoun_connector_tail_split_support_local(candidate) then
            begin
                Exit(False);
            end;

            if is_complete_for_query_local(candidate) and
                (not candidate_has_supported_full_entry_local(candidate)) and
                (candidate_has_one_plus_two_split_local(candidate) or
                candidate_has_one_plus_two_text_split_local(candidate)) and
                (not is_short_three_exact_pair_candidate_supported_local(
                candidate.text)) then
            begin
                Exit(True);
            end;

            if is_complete_for_query_local(candidate) and
                (not candidate_has_supported_full_entry_local(candidate)) and
                has_exact_full_complete and
                ((exact_full_complete_texts = nil) or
                (not exact_full_complete_texts.ContainsKey(text_key_local))) and
                (not candidate_has_three_syllable_lexicon_split_support_local(
                candidate)) and
                (not candidate_has_four_syllable_two_phrase_split_support_local(
                candidate)) and
                (not (candidate_has_sentence_particle_tail_split_local(candidate) and
                (strongest_exact_full_complete_weight <
                c_low_weight_exact_allows_particle_split))) then
            begin
                Exit(True);
            end;

            if is_complete_for_query_local(candidate) and
                (candidate.source = cs_rule) and candidate.has_dict_weight and
                segment_path_has_multi_char_segment_local(candidate) and
                (not segment_path_has_disallowed_single_segment_local(candidate)) then
            begin
                Exit(False);
            end;
            Result := is_complete_for_query_local(candidate) and
                ((normal_complete_texts = nil) or
                (not normal_complete_texts.ContainsKey(text_key_local))) and
                (not candidate_has_three_syllable_lexicon_split_support_local(
                candidate)) and
                (not candidate_has_four_syllable_two_phrase_split_support_local(
                candidate)) and
                ((not candidate_has_supported_full_entry_local(candidate)) and
                segment_path_has_disallowed_single_segment_local(candidate) or
                (((candidate.source = cs_user) and
                (not candidate_has_supported_full_entry_local(candidate)) and
                ((is_problematic_single_char_chain_candidate_for_query(lookup_text,
                candidate)) or
                (candidate.has_dict_weight and
                (candidate.dict_weight <= c_low_evidence_user_complete_weight) and
                (not candidate_has_exact_base_entry_local(candidate))))) or
                ((candidate.source = cs_rule) and
                (not candidate_has_exact_base_entry_local(candidate)) and
                ((not candidate.has_dict_weight) or
                (not segment_path_has_multi_char_segment_local(candidate))))));
        end;

        function has_strong_prefix_single_tail_segment_path_local(
            const candidate: TncCandidate): Boolean;
        var
            encoded_path: string;
            segment_parts: TArray<string>;
            part_idx: Integer;
            tail_text: string;
            has_multi_char_head_segment: Boolean;
        begin
            Result := False;
            if strongest_normal_complete_weight >= c_weak_complete_weight_for_prefix_tail then
            begin
                Exit;
            end;

            encoded_path := get_candidate_segment_path_for_filter_local(
                candidate);
            if get_encoded_path_segment_count_local(encoded_path) <= 1 then
            begin
                Exit;
            end;

            segment_parts := encoded_path.Split([c_segment_path_separator]);
            if Length(segment_parts) <= 1 then
            begin
                Exit;
            end;

            has_multi_char_head_segment := False;
            for part_idx := 0 to High(segment_parts) - 1 do
            begin
                if get_candidate_text_unit_count(Trim(segment_parts[part_idx])) >= 2 then
                begin
                    has_multi_char_head_segment := True;
                    Break;
                end;
            end;
            if not has_multi_char_head_segment then
            begin
                Exit;
            end;

            tail_text := Trim(segment_parts[High(segment_parts)]);
            if (tail_text = '') or (get_candidate_text_unit_count(tail_text) <> 1) then
            begin
                Exit;
            end;
            Result := True;
        end;
    begin
        normal_complete_texts := nil;
        exact_full_complete_texts := nil;
        if (Length(m_candidates) = 0) or (not has_multi_syllable_input) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

            expected_units := input_syllable_count;
            if (expected_units < 2) or (expected_units > 5) then
            begin
                Exit;
            end;

        normal_complete_texts := TDictionary<string, Byte>.Create;
        exact_full_complete_texts := TDictionary<string, Byte>.Create;
        try
            has_normal_complete := False;
            has_exact_full_complete := False;
            has_one_plus_two_function_head_complete := False;
            strongest_normal_complete_weight := Low(Integer);
            strongest_exact_full_complete_weight := Low(Integer);
            if dictionary_exact_lookup_cached(lookup_text, exact_results_local) then
            begin
                for idx := 0 to High(exact_results_local) do
                begin
                    candidate_text := Trim(exact_results_local[idx].text);
                    if (Trim(exact_results_local[idx].comment) = '') and
                        (candidate_text <> '') and
                        (get_candidate_text_unit_count(candidate_text) =
                        expected_units) and
                        (m_dictionary.is_base_entry(lookup_text,
                        candidate_text) or
                        ((exact_results_local[idx].source = cs_rule) and
                        exact_results_local[idx].has_dict_weight and
                        (exact_results_local[idx].dict_weight >= 160)) or
                        ((exact_results_local[idx].source = cs_user) and
                        m_dictionary.is_user_entry(lookup_text,
                        candidate_text) and
                        (not m_dictionary.should_suppress_exact_query_learning(
                        lookup_text, candidate_text)))) then
                    begin
                        exact_full_complete_texts.AddOrSetValue(
                            candidate_text, 1);
                        has_exact_full_complete := True;
                        if (exact_results_local[idx].source = cs_user) and
                            m_dictionary.is_user_entry(lookup_text,
                            candidate_text) and
                            (not m_dictionary.should_suppress_exact_query_learning(
                            lookup_text, candidate_text)) then
                        begin
                            strongest_exact_full_complete_weight := High(Integer);
                        end
                        else if exact_results_local[idx].has_dict_weight and
                            (exact_results_local[idx].dict_weight >
                            strongest_exact_full_complete_weight) then
                        begin
                            strongest_exact_full_complete_weight :=
                                exact_results_local[idx].dict_weight;
                        end
                        else if (not exact_results_local[idx].has_dict_weight) and
                            (exact_results_local[idx].score >
                            strongest_exact_full_complete_weight) then
                        begin
                            strongest_exact_full_complete_weight :=
                                exact_results_local[idx].score;
                        end;
                    end;
                end;
            end;
            for idx := 0 to High(m_candidates) do
            begin
                if is_complete_for_query_local(m_candidates[idx]) and
                    candidate_has_supported_full_entry_local(m_candidates[idx]) then
                begin
                    exact_full_complete_texts.AddOrSetValue(
                        Trim(m_candidates[idx].text), 1);
                    has_exact_full_complete := True;
                    if (m_candidates[idx].source = cs_user) and
                        m_dictionary.is_user_entry(lookup_text,
                        Trim(m_candidates[idx].text)) and
                        (not m_dictionary.should_suppress_exact_query_learning(
                        lookup_text, Trim(m_candidates[idx].text))) then
                    begin
                        strongest_exact_full_complete_weight := High(Integer);
                    end
                    else if m_candidates[idx].dict_weight >
                        strongest_exact_full_complete_weight then
                    begin
                        strongest_exact_full_complete_weight :=
                            m_candidates[idx].dict_weight;
                    end
                    else if (not m_candidates[idx].has_dict_weight) and
                        (m_candidates[idx].score >
                        strongest_exact_full_complete_weight) then
                    begin
                        strongest_exact_full_complete_weight :=
                            m_candidates[idx].score;
                    end;
                end;

                if is_normal_complete_candidate_local(m_candidates[idx]) then
                begin
                    normal_complete_texts.AddOrSetValue(
                        Trim(m_candidates[idx].text), 1);
                    has_normal_complete := True;
                    if candidate_has_one_plus_two_function_head_split_local(
                        m_candidates[idx]) then
                    begin
                        has_one_plus_two_function_head_complete := True;
                    end;
                    if m_candidates[idx].source = cs_user then
                    begin
                        strongest_normal_complete_weight := High(Integer);
                    end
                    else if m_candidates[idx].dict_weight >
                        strongest_normal_complete_weight then
                    begin
                        strongest_normal_complete_weight := m_candidates[idx].dict_weight;
                    end;
                end;
            end;
            out_idx := 0;
            removed_count := 0;
            for idx := 0 to High(m_candidates) do
            begin
                { Fuzzy exacts and fuzzy lattice paths have already been
                  validated against lexicon edges using alternate syllables. }
                if is_fuzzy_pinyin_active and
                    (m_candidates[idx].fuzzy_cost > 0) and
                    is_complete_for_query_local(m_candidates[idx]) and
                    (((m_candidates[idx].source = cs_user) or
                    ((m_candidates[idx].source = cs_rule) and
                    m_candidates[idx].has_dict_weight)) or
                    segment_path_has_multi_char_segment_local(
                    m_candidates[idx])) then
                begin
                    if out_idx <> idx then
                    begin
                        m_candidates[out_idx] := m_candidates[idx];
                        if out_idx < Length(m_candidate_segment_paths) then
                        begin
                            if idx < Length(m_candidate_segment_paths) then
                            begin
                                m_candidate_segment_paths[out_idx] :=
                                    m_candidate_segment_paths[idx];
                            end
                            else
                            begin
                                m_candidate_segment_paths[out_idx] := '';
                            end;
                        end;
                    end;
                    Inc(out_idx);
                    Continue;
                end;

                if is_polluted_complete_candidate_local(m_candidates[idx]) and
                    ((not has_normal_complete) or
                    (not has_strong_prefix_single_tail_segment_path_local(
                    m_candidates[idx]))) then
                begin
                    Inc(removed_count);
                    Continue;
                end;

                if segment_path_has_nonbase_two_plus_single_segment_local(
                    m_candidates[idx]) and
                    (not is_short_three_exact_pair_candidate_supported_local(
                    m_candidates[idx].text)) then
                begin
                    Inc(removed_count);
                    Continue;
                end;

                if has_one_plus_two_function_head_complete and
                    candidate_has_two_plus_one_non_particle_tail_split_local(
                    m_candidates[idx]) and
                    (not is_short_three_exact_pair_candidate_supported_local(
                    m_candidates[idx].text)) and
                    (not candidate_has_ordinal_quantity_two_plus_one_split_local(
                    m_candidates[idx])) then
                begin
                    Inc(removed_count);
                    Continue;
                end;

                if out_idx <> idx then
                begin
                    m_candidates[out_idx] := m_candidates[idx];
                    if out_idx < Length(m_candidate_segment_paths) then
                    begin
                        if idx < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[out_idx] :=
                                m_candidate_segment_paths[idx];
                        end
                        else
                        begin
                            m_candidate_segment_paths[out_idx] := '';
                        end;
                    end;
                end;
                Inc(out_idx);
            end;

            if out_idx <> Length(m_candidates) then
            begin
                SetLength(m_candidates, out_idx);
                if Length(m_candidate_segment_paths) > out_idx then
                begin
                    SetLength(m_candidate_segment_paths, out_idx);
                end;
            end;

            if m_config.debug_mode and (removed_count > 0) then
            begin
                candidate_text := '';
                if Length(m_candidates) > 0 then
                begin
                    candidate_text := Trim(m_candidates[0].text);
                end;
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' selfdrop=[n=%d top=%s]', [removed_count,
                    candidate_text]);
            end;
        finally
            exact_full_complete_texts.Free;
            normal_complete_texts.Free;
        end;
    end;

    procedure finalize_lookup_timing_info;
    var
        total_elapsed_ms: Int64;
        function should_skip_heavy_finalize_promotions_local: Boolean;
        var
            top_candidate_local: TncCandidate;
        begin
            Result := False;
            if (not has_multi_syllable_input) or
                (input_syllable_count < 7) or
                (Length(m_candidates) = 0) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            top_candidate_local := m_candidates[0];
            if (Trim(top_candidate_local.comment) = '') then
            begin
                Result := top_candidate_local.has_dict_weight and
                    (top_candidate_local.dict_weight >= 50000) and
                    (get_candidate_text_unit_count(Trim(top_candidate_local.text)) =
                    input_syllable_count);
                Exit;
            end;

            Result :=
                (get_candidate_text_unit_count(Trim(top_candidate_local.text)) >=
                input_syllable_count - 1) and
                (Length(normalize_pinyin_text(Trim(top_candidate_local.comment))) <= 3);
        end;

        procedure promote_preferred_three_syllable_partial_shape_local;
        var
            local_idx: Integer;
            best_idx: Integer;
            best_score: Integer;
            picked_local: TncCandidate;
            text_units_local: Integer;
            comment_syllables_local: Integer;
        begin
            if (input_syllable_count <> 3) or
                (m_last_three_syllable_partial_preference_kind <> 1) or
                (Length(m_candidates) <= 1) then
            begin
                Exit;
            end;
            if (Trim(m_candidates[0].comment) = '') and
                (m_candidates[0].has_dict_weight or (m_candidates[0].source = cs_user)) then
            begin
                Exit;
            end;

            best_idx := -1;
            best_score := Low(Integer);
            for local_idx := 0 to High(m_candidates) do
            begin
                if Trim(m_candidates[local_idx].comment) = '' then
                begin
                    Continue;
                end;
                text_units_local := get_candidate_text_unit_count(
                    Trim(m_candidates[local_idx].text));
                comment_syllables_local := get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(Trim(m_candidates[local_idx].comment)));
                if (text_units_local <> 1) or (comment_syllables_local <> 2) then
                begin
                    Continue;
                end;
                if (best_idx < 0) or (m_candidates[local_idx].score > best_score) then
                begin
                    best_idx := local_idx;
                    best_score := m_candidates[local_idx].score;
                end;
            end;
            if best_idx <= 0 then
            begin
                Exit;
            end;

            picked_local := m_candidates[best_idx];
            for local_idx := best_idx downto 1 do
            begin
                m_candidates[local_idx] := m_candidates[local_idx - 1];
            end;
            m_candidates[0] := picked_local;
        end;
        procedure promote_high_coverage_long_partial_local;
        var
            local_idx: Integer;
            best_idx: Integer;
            best_score: Integer;
            top_units: Integer;
            text_units_local: Integer;
            comment_syllables_local: Integer;
