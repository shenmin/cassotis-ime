                if (combined_tail_text_local = '') or
                    (get_candidate_text_unit_count(combined_tail_text_local) <>
                    tail_units + 1) then
                begin
                    Continue;
                end;

                combined_tail_weight_local :=
                    combined_tail_results_local[combined_tail_idx_local].score;
                if combined_tail_results_local[combined_tail_idx_local].has_dict_weight and
                    (combined_tail_results_local[combined_tail_idx_local].dict_weight >
                    combined_tail_weight_local) then
                begin
                    combined_tail_weight_local :=
                        combined_tail_results_local[combined_tail_idx_local].dict_weight;
