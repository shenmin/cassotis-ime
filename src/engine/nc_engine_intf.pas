        function try_get_best_exact_phrase_local(const start_idx: Integer;
            const len: Integer; const prefer_quantity_tail: Boolean;
            const prefer_compound_tail: Boolean;
            out out_text: string; out out_score: Integer;
            out out_reliable: Boolean): Boolean;
        var
            query_key: string;
            results: TncCandidateList;
            result_idx: Integer;
            candidate_text: string;
            candidate_score: Integer;
            direct_weight: Integer;
            best_direct_weight: Integer;
            fixed_first: string;
            first_unit: string;
            second_unit: string;
            split_len: Integer;
            left_text: string;
            right_text: string;
            left_score: Integer;
            right_score: Integer;
            left_reliable: Boolean;
            right_reliable: Boolean;
            compound_tail_support: Integer;

            function has_reliable_dict_weight_local(
                const candidate: TncCandidate): Boolean;
            begin
                Result := candidate.has_dict_weight and
                    (candidate.dict_weight > 0) and
                    ((candidate.score <= 0) or
                    (candidate.dict_weight <= candidate.score * 4));
            end;
        begin
            Result := False;
            out_text := '';
            out_score := Low(Integer);
            out_reliable := False;
            best_direct_weight := Low(Integer);
            query_key := build_query_key_local(start_idx, len);
            if query_key = '' then
            begin
                Exit;
            end;
            if not lookup_exact_full_pinyin_cached_local(query_key, results) then
            begin
                if len >= 3 then
                begin
                    // Exact lookup already falls back to lookup() for legacy
                    // providers.  Avoid probing the same long key again; split
                    // the span into cached exact subspans instead.
                if len = 3 then
                begin
                    for split_len := 2 downto 1 do
                    begin
                        if try_get_best_exact_phrase_local(start_idx,
                            split_len, False, False, left_text, left_score,
                            left_reliable) and
                            try_get_best_exact_phrase_local(start_idx + split_len,
                            len - split_len, False, False, right_text, right_score,
                            right_reliable) then
                        begin
                            candidate_text := left_text + right_text;
                            candidate_score := left_score + right_score +
                                c_prefix_tail_bonus + (len * len * 256);
                            if m_dictionary <> nil then
                            begin
                                Inc(candidate_score, m_dictionary.get_context_bonus(
                                    left_text, right_text));
                            end;
                            if (not Result) or (candidate_score > out_score) or
                                ((candidate_score = out_score) and
                                (CompareText(candidate_text, out_text) < 0)) then
                            begin
                                Result := True;
                                out_text := candidate_text;
                                out_score := candidate_score;
                                out_reliable := left_reliable and right_reliable;
                            end;
                        end;
                    end;
                end
                else
                begin
                        for split_len := len - 1 downto 2 do
                        begin
                            if try_get_best_exact_phrase_local(start_idx,
                                split_len, False, False, left_text, left_score,
                                left_reliable) and
                            try_get_best_exact_phrase_local(start_idx + split_len,
                            len - split_len, False, False, right_text, right_score,
                            right_reliable) then
                        begin
                            candidate_text := left_text + right_text;
                            candidate_score := left_score + right_score +
                                c_prefix_tail_bonus + (len * len * 256);
                            if m_dictionary <> nil then
                            begin
                                Inc(candidate_score, m_dictionary.get_context_bonus(
                                    left_text, right_text));
                            end;
                            if (not Result) or (candidate_score > out_score) or
                                ((candidate_score = out_score) and
                                (CompareText(candidate_text, out_text) < 0)) then
                            begin
                                Result := True;
                                out_text := candidate_text;
                                out_score := candidate_score;
                                out_reliable := left_reliable and right_reliable;
                            end;
                        end;
                    end;
                end;
                Exit;
            end;

                if not m_dictionary.lookup(query_key, results) then
                begin
                    Exit;
                end;
            end;

            fixed_first := '';
            if len >= 2 then
            begin
                fixed_first := get_fixed_tail_single_local(
                    syllables_local[start_idx].text);
            end;

            for result_idx := 0 to High(results) do
            begin
                if result_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text := Trim(results[result_idx].text);
                if (candidate_text = '') or
                    (get_candidate_text_unit_count(candidate_text) <> len) then
                begin
                    Continue;
                end;
                if (len >= 2) and (results[result_idx].source <> cs_user) and
                    (not has_reliable_dict_weight_local(results[result_idx])) then
                begin
                    Continue;
                end;

                candidate_score := get_candidate_weight_local(results[result_idx]);
                if results[result_idx].has_dict_weight and
                    (results[result_idx].dict_weight > 0) then
                begin
                    direct_weight := results[result_idx].dict_weight;
                end
                else
                begin
                    direct_weight := candidate_score;
                end;
                if (results[result_idx].source = cs_user) and
                    (direct_weight >= c_weak_direct_exact_split_weight) then
                begin
                    direct_weight := High(Integer);
                end;
                if direct_weight > best_direct_weight then
                begin
                    best_direct_weight := direct_weight;
                end;
                Inc(candidate_score, get_preferred_query_phrase_bonus_local(
                    query_key, candidate_text));
                Inc(candidate_score, (c_probe_limit - result_idx) * 96);

                if prefer_quantity_tail and (fixed_first <> '') then
                begin
                    first_unit := text_first_unit_local(candidate_text);
                    second_unit := text_second_unit_local(candidate_text);
                    if SameText(first_unit, fixed_first) and
                        is_quantity_tail_unit_local(second_unit) then
                    begin
                        Inc(candidate_score, c_quantity_tail_bonus);
                    end;
                end;
                if prefer_compound_tail and (len = 2) and
                    (m_dictionary <> nil) and
                    (direct_weight < best_direct_weight) and
                    ((best_direct_weight = Low(Integer)) or
                    ((direct_weight + c_compound_tail_candidate_window) >=
                    best_direct_weight)) then
                begin
                    compound_tail_support :=
                        m_dictionary.get_compound_tail_support(candidate_text);
                    if compound_tail_support > 0 then
                    begin
                        Inc(candidate_score,
                            Min(c_compound_tail_bonus_cap,
                            compound_tail_support));
                    end;
                end;

                if (not Result) or (candidate_score > out_score) or
                    ((candidate_score = out_score) and
                    (CompareText(candidate_text, out_text) < 0)) then
                begin
                    Result := True;
                    out_text := candidate_text;
                    out_score := candidate_score;
                    out_reliable := (len = 1) or
                        (results[result_idx].source = cs_user) or
                        has_reliable_dict_weight_local(results[result_idx]);
                end;
            end;

            if (len >= 3) and ((not Result) or
                (best_direct_weight < c_weak_direct_exact_split_weight)) then
            begin
                if len = 3 then
                begin
                    for split_len := 2 downto 1 do
                    begin
                        if try_get_best_exact_phrase_local(start_idx,
                            split_len, False, False, left_text, left_score,
                            left_reliable) and
                            try_get_best_exact_phrase_local(start_idx + split_len,
                            len - split_len, False, False, right_text, right_score,
                            right_reliable) then
                        begin
                            candidate_text := left_text + right_text;
                            candidate_score := left_score + right_score +
                                c_prefix_tail_bonus + (len * len * 256);
                            if m_dictionary <> nil then
                            begin
                                Inc(candidate_score, m_dictionary.get_context_bonus(
                                    left_text, right_text));
                            end;
                            if (not Result) or (candidate_score > out_score) or
                                ((candidate_score = out_score) and
                                (CompareText(candidate_text, out_text) < 0)) then
                            begin
                                Result := True;
                                out_text := candidate_text;
                                out_score := candidate_score;
                                out_reliable := left_reliable and right_reliable;
                            end;
                        end;
                    end;
                end
                else
                begin
                    for split_len := len - 1 downto 2 do
                    begin
                        if try_get_best_exact_phrase_local(start_idx,
                            split_len, False, False, left_text, left_score,
                            left_reliable) and
                            try_get_best_exact_phrase_local(start_idx + split_len,
                            len - split_len, False, False, right_text, right_score,
                            right_reliable) then
                        begin
                            candidate_text := left_text + right_text;
                            candidate_score := left_score + right_score +
                                c_prefix_tail_bonus + (len * len * 256);
                            if m_dictionary <> nil then
                            begin
                                Inc(candidate_score, m_dictionary.get_context_bonus(
                                    left_text, right_text));
                            end;
                            if (not Result) or (candidate_score > out_score) or
                                ((candidate_score = out_score) and
                                (CompareText(candidate_text, out_text) < 0)) then
                            begin
                                Result := True;
                                out_text := candidate_text;
                                out_score := candidate_score;
                                out_reliable := left_reliable and right_reliable;
                            end;
                        end;
                    end;
                end;
            end;
        end;

        function try_get_fixed_single_tail_local(const start_idx: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            query_key: string;
            results: TncCandidateList;
            result_idx: Integer;
            candidate_score: Integer;
        begin
            Result := False;
            out_text := get_fixed_tail_single_local(syllables_local[start_idx].text);
            out_score := 0;
            if out_text = '' then
            begin
                Exit;
            end;

            query_key := build_query_key_local(start_idx, 1);
            if (query_key <> '') and
                lookup_exact_full_pinyin_cached_local(query_key, results) then
            begin
                for result_idx := 0 to High(results) do
                begin
                    if result_idx >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if (Trim(results[result_idx].comment) <> '') or
                        (not SameText(Trim(results[result_idx].text), out_text)) then
                    begin
                        Continue;
                    end;
                    candidate_score := get_candidate_weight_local(results[result_idx]);
                    if candidate_score > out_score then
                    begin
                        out_score := candidate_score;
                    end;
                end;
            end;

            if out_score <= 0 then
            begin
                out_score := 520;
            end;
            Inc(out_score, c_fixed_tail_bonus);
            Result := True;
        end;

        function try_get_function_head_single_local(const start_idx: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            query_key: string;
            results: TncCandidateList;
            result_idx: Integer;
            candidate_text: string;
            candidate_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            query_key := build_query_key_local(start_idx, 1);
            if (query_key = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key, results)) then
            begin
                Exit;
            end;

            for result_idx := 0 to High(results) do
            begin
                if result_idx >= c_probe_limit * 4 then
                begin
                    Break;
                end;
                if Trim(results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text := Trim(results[result_idx].text);
                if not is_function_head_single_text_local(candidate_text) then
                begin
                    Continue;
                end;

                candidate_score := get_candidate_weight_local(results[result_idx]);
                Inc(candidate_score, (c_probe_limit * 4 - result_idx) * 48);
                if (not Result) or (candidate_score > out_score) then
                begin
                    Result := True;
                    out_text := candidate_text;
                    out_score := candidate_score;
                end;
            end;
        end;

        function path_has_unsupported_single_segment_local(
            const encoded_path: string): Boolean;
        var
            parts: TArray<string>;
            part_idx: Integer;
            part_text: string;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(encoded_path) <= 1 then
            begin
                Exit;
            end;

            parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(parts) do
            begin
                part_text := Trim(parts[part_idx]);
                if get_candidate_text_unit_count(part_text) <> 1 then
                begin
                    Continue;
                end;
                if is_function_head_single_text_local(part_text) or
                    is_quantity_tail_unit_local(part_text) then
                begin
                    Continue;
                end;
                Exit(True);
            end;
        end;

        function path_has_nonbase_two_plus_single_segment_local(
            const encoded_path: string): Boolean;
        var
            parts: TArray<string>;
            part_idx: Integer;
            syllable_pos: Integer;
            part_units: Integer;
            part_text: string;
            part_key: string;
            head_key_value: string;
            tail_key_value: string;
            head_text_value: string;
            tail_text_value: string;
            unit_texts: TArray<string>;

            function exact_span_has_text_local(const start_idx: Integer;
                const len: Integer; const text_value: string;
                const require_reliable: Boolean): Boolean;
            var
                key_value: string;
                exact_results_value: TncCandidateList;
                exact_idx_value: Integer;
                exact_text_value: string;
            begin
                Result := False;
                key_value := build_query_key_local(start_idx, len);
                if (key_value = '') or (text_value = '') or
                    (not lookup_exact_full_pinyin_cached_local(key_value,
                    exact_results_value)) then
                begin
                    Exit;
                end;

                for exact_idx_value := 0 to High(exact_results_value) do
                begin
                    if Trim(exact_results_value[exact_idx_value].comment) <> '' then
                    begin
                        Continue;
                    end;
                    exact_text_value := Trim(
                        exact_results_value[exact_idx_value].text);
                    if SameText(exact_text_value, text_value) and
                        (get_candidate_text_unit_count(exact_text_value) = len) then
                    begin
                        if require_reliable and
                            (exact_results_value[exact_idx_value].source <> cs_user) and
                            ((not exact_results_value[exact_idx_value].has_dict_weight) or
                            (exact_results_value[exact_idx_value].dict_weight <= 0)) then
                        begin
                            Continue;
                        end;
                        Exit(True);
                    end;
                end;
            end;

            function is_allowed_single_tail_text_local(
                const text_value: string): Boolean;
            begin
                Result := is_modal_tail_syllable_local(tail_key_value) or
                    is_function_head_single_text_local(text_value);
            end;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(encoded_path) <= 1 then
            begin
                Exit;
            end;

            parts := encoded_path.Split([c_segment_path_separator]);
            syllable_pos := 0;
            for part_idx := 0 to High(parts) do
            begin
                part_text := Trim(parts[part_idx]);
                part_units := get_candidate_text_unit_count(part_text);
                if part_units <= 0 then
                begin
                    Continue;
                end;
                if syllable_pos + part_units > syllable_count_local then
                begin
                    Exit;
                end;

                if part_units = 3 then
                begin
                    part_key := build_query_key_local(syllable_pos, 3);
                    if (part_key <> '') and
                        (not m_dictionary.is_user_entry(part_key, part_text)) and
                        (not exact_span_has_text_local(syllable_pos, 3,
                        part_text, True)) then
                    begin
                        unit_texts := split_text_units(part_text);
                        if Length(unit_texts) = 3 then
                        begin
                            head_key_value := build_query_key_local(
                                syllable_pos, 2);
                            tail_key_value := build_query_key_local(
                                syllable_pos + 2, 1);
                            head_text_value := unit_texts[0] + unit_texts[1];
                            tail_text_value := unit_texts[2];
                            if (not is_allowed_single_tail_text_local(
                                tail_text_value)) and
                                exact_span_has_text_local(syllable_pos, 2,
                                head_text_value, False) and
                                (m_dictionary.single_char_matches_pinyin(
                                tail_key_value, tail_text_value) or
                                exact_span_has_text_local(syllable_pos + 2, 1,
                                tail_text_value, False)) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                Inc(syllable_pos, part_units);
            end;
        end;

        function try_get_function_head_remainder_candidate_local(
            out out_text: string; out out_path: string;
            out out_score: Integer): Boolean;
        var
            head_single_text: string;
            tail_phrase_text: string;
            head_single_score: Integer;
            tail_phrase_score: Integer;
            tail_reliable_local: Boolean;
            tail_span_len: Integer;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := Low(Integer);
            if syllable_count_local < 4 then
            begin
                Exit;
            end;

            tail_span_len := syllable_count_local - 1;
            if (not try_get_function_head_single_local(0, head_single_text,
                head_single_score)) or
                (not try_get_best_exact_phrase_local(1, tail_span_len, False,
                False, tail_phrase_text, tail_phrase_score,
                tail_reliable_local)) or (not tail_reliable_local) then
            begin
                Exit;
            end;

            out_text := head_single_text + tail_phrase_text;
            if get_candidate_text_unit_count(out_text) <> input_syllable_count then
            begin
                Exit;
            end;

            out_path := head_single_text + c_segment_path_separator +
                tail_phrase_text;
            out_score := head_single_score + tail_phrase_score +
                c_prefix_tail_bonus + (tail_span_len * tail_span_len * 512);
            Inc(out_score, m_dictionary.get_context_bonus(head_single_text,
                tail_phrase_text));
            Result := True;
        end;

        function is_pronoun_single_text_local(const value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(value) <> 1 then
            begin
                Exit;
            end;

            case Ord(value[1]) of
                $6211, $4F60, $60A8, $4ED6, $5979, $5B83, $54B1, $4FFA:
                    Result := True;
            end;
        end;

        function is_connector_single_text_local(const value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(value) <> 1 then
            begin
                Exit;
            end;

            case Ord(value[1]) of
                $8DDF, $548C, $4E0E, $540C:
                    Result := True;
            end;
        end;

        function try_get_best_role_single_local(const start_idx: Integer;
            const require_pronoun: Boolean; out out_text: string;
            out out_score: Integer): Boolean;
        var
            query_key: string;
            results: TncCandidateList;
            result_idx: Integer;
            candidate_text: string;
            candidate_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := Low(Integer);
            query_key := build_query_key_local(start_idx, 1);
            if (query_key = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key, results)) then
            begin
                Exit;
            end;

            for result_idx := 0 to High(results) do
            begin
                if result_idx >= c_probe_limit * 4 then
                begin
                    Break;
                end;
                if Trim(results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text := Trim(results[result_idx].text);
                if (require_pronoun and
                    (not is_pronoun_single_text_local(candidate_text))) or
                    ((not require_pronoun) and
                    (not is_connector_single_text_local(candidate_text))) then
                begin
                    Continue;
                end;

                candidate_score := get_candidate_weight_local(results[result_idx]);
                Inc(candidate_score, (c_probe_limit * 4 - result_idx) * 48);
                if (not Result) or (candidate_score > out_score) then
                begin
                    Result := True;
                    out_text := candidate_text;
                    out_score := candidate_score;
                end;
            end;
        end;

        function try_get_pronoun_connector_tail_candidate_local(
            out out_text: string; out out_path: string;
            out out_score: Integer): Boolean;
        var
            pronoun_text: string;
            connector_text: string;
            exact_tail_text: string;
            pronoun_score: Integer;
            connector_score: Integer;
            exact_tail_score: Integer;
            exact_tail_key: string;
            exact_tail_results: TncCandidateList;
            exact_tail_idx: Integer;
            exact_tail_candidate_text: string;
            exact_tail_candidate_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := Low(Integer);
            if (syllable_count_local < 4) or (syllable_count_local > 6) then
            begin
                Exit;
            end;

            if not try_get_best_role_single_local(0, True, pronoun_text,
                pronoun_score) then
            begin
                Exit;
            end;
            if not try_get_best_role_single_local(1, False, connector_text,
                connector_score) then
            begin
                Exit;
            end;
            exact_tail_key := build_query_key_local(2,
                syllable_count_local - 2);
            if (exact_tail_key = '') or
                (not lookup_exact_full_pinyin_cached_local(exact_tail_key,
                exact_tail_results)) then
            begin
                Exit;
            end;
            exact_tail_text := '';
            exact_tail_score := Low(Integer);
            for exact_tail_idx := 0 to High(exact_tail_results) do
            begin
                if exact_tail_idx >= c_probe_limit * 4 then
                begin
                    Break;
                end;
                if Trim(exact_tail_results[exact_tail_idx].comment) <> '' then
                begin
                    Continue;
                end;
                exact_tail_candidate_text := Trim(
                    exact_tail_results[exact_tail_idx].text);
                if (exact_tail_candidate_text = '') or
                    (get_candidate_text_unit_count(exact_tail_candidate_text) <>
                    syllable_count_local - 2) then
                begin
                    Continue;
                end;
                exact_tail_candidate_score := get_candidate_weight_local(
                    exact_tail_results[exact_tail_idx]);
                if (exact_tail_results[exact_tail_idx].source <> cs_user) and
                    (exact_tail_candidate_score <
                    c_weak_direct_exact_split_weight) then
                begin
                    Continue;
                end;
                Inc(exact_tail_candidate_score,
                    (c_probe_limit * 4 - exact_tail_idx) * 32);
                if (exact_tail_text = '') or
                    (exact_tail_candidate_score > exact_tail_score) then
                begin
                    exact_tail_text := exact_tail_candidate_text;
                    exact_tail_score := exact_tail_candidate_score;
                end;
            end;
            if exact_tail_text = '' then
            begin
                Exit;
            end;

            out_text := pronoun_text + connector_text + exact_tail_text;
            if get_candidate_text_unit_count(out_text) <> syllable_count_local then
            begin
                Exit;
            end;

            out_path := pronoun_text + c_segment_path_separator +
                connector_text + c_segment_path_separator + exact_tail_text;
            out_score := pronoun_score + connector_score + exact_tail_score +
                c_prefix_tail_bonus +
                ((syllable_count_local - 3) * c_exact_tail_span_bonus);
            Inc(out_score, m_dictionary.get_context_bonus(pronoun_text,
                connector_text));
            Inc(out_score, m_dictionary.get_context_bonus(connector_text,
                exact_tail_text));
            Result := True;
        end;

        procedure remember_best_candidate_path_local(const candidate_text: string;
            const candidate_score: Integer);
        var
            candidate_key_local: string;
        begin
            remember_segment_path_for_candidate(candidate_text, '', best_path,
                candidate_score);
            if (not best_is_pronoun_connector_tail) or
                (m_current_segment_path_map = nil) then
            begin
                Exit;
            end;

            // Every segment in this path was independently verified above.  Do
            // not let an earlier inferred path with fewer, non-exact segments
            // replace the structurally valid pronoun/connector/tail boundary.
            candidate_key_local := build_candidate_identity_key(candidate_text, '');
            if candidate_key_local <> '' then
            begin
                m_current_segment_path_map.AddOrSetValue(candidate_key_local,
                    best_path);
                remember_segment_path_score_hint_for_candidate(candidate_text,
                    '', candidate_score);
            end;
        end;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count < 3) or (input_syllable_count > 8) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        syllable_count_local := Length(syllables_local);
        if syllable_count_local <> input_syllable_count then
        begin
            Exit;
        end;
        has_pronoun_connector_tail_candidate :=
            try_get_pronoun_connector_tail_candidate_local(
            pronoun_connector_tail_text, pronoun_connector_tail_path,
            pronoun_connector_tail_score);
        if (syllable_count_local = 4) and has_covering_partial_anchor_local and
            (not has_pronoun_connector_tail_candidate) and
            (not is_modal_tail_syllable_local(
            syllables_local[High(syllables_local)].text)) then
        begin
            // Four-syllable prefix typing often already has a stable head/tail
            // partial such as "瀹屽叏/buzhi".  Do not spend a full exact-span
            // search only to discard the result below.
            Exit;
        end;
        if (syllable_count_local >= 4) and
            SameText(normalize_pinyin_text(syllables_local[0].text), 'yi') then
        begin
            // Avoid building speculative "yi + ..." short-chain candidates for
            // longer input.  They are often ambiguous and can dominate the
            // normal exact-prefix path while adding multiple exact span probes.
            Exit;
        end;

        if try_get_protective_full_exact_candidate_local(picked,
            best_score) then
        begin
            promote_or_insert_protective_full_exact_candidate_local(picked,
                best_score);
            Exit;
        end;

        if (syllable_count_local = 3) and
            (not has_weak_direct_full_exact_candidate_local) then
        begin
            Exit;
        end;

        best_text := '';
        best_path := '';
        best_score := Low(Integer);
        best_tail_len := 0;
        best_tail_is_fixed_single := False;
        best_is_pronoun_connector_tail := False;
        if has_pronoun_connector_tail_candidate then
        begin
            best_text := pronoun_connector_tail_text;
            best_path := pronoun_connector_tail_path;
            best_score := pronoun_connector_tail_score;
            best_tail_len := syllable_count_local - 2;
            best_is_pronoun_connector_tail := True;
        end;
        has_function_head_candidate :=
            try_get_function_head_remainder_candidate_local(function_head_text,
            function_head_path, function_head_score);
        for tail_probe_idx := 0 to Min(2, syllable_count_local - 2) - 1 do
        begin
            if syllable_count_local = 4 then
            begin
                tail_len := 2 - tail_probe_idx;
            end
            else
            begin
                tail_len := tail_probe_idx + 1;
            end;
            tail_is_fixed_single := False;
            head_len := syllable_count_local - tail_len;
            if not try_get_best_exact_phrase_local(0, head_len,
                (tail_len = 1) and
                is_modal_tail_syllable_local(syllables_local[head_len].text),
                False,
                head_text, head_score, head_reliable) then
            begin
                Continue;
            end;

            if tail_len = 1 then
            begin
                if (head_len >= 1) and
                    try_get_best_exact_phrase_local(head_len - 1, 2, True, False,
                    preferred_two_tail_text, preferred_two_tail_score,
                    tail_reliable) and
                    SameText(text_first_unit_local(preferred_two_tail_text),
                    get_fixed_tail_single_local(syllables_local[head_len - 1].text)) and
                    is_quantity_tail_unit_local(
                    text_second_unit_local(preferred_two_tail_text)) then
                begin
                    Continue;
                end;

                tail_is_fixed_single := try_get_fixed_single_tail_local(
                    head_len, tail_text, tail_score);
                tail_reliable := tail_is_fixed_single;
                if (not tail_is_fixed_single) and
                    not try_get_best_exact_phrase_local(head_len, tail_len,
                    False, False, tail_text, tail_score, tail_reliable) then
                begin
                    Continue;
                end;
            end
            else if not try_get_best_exact_phrase_local(head_len, tail_len,
                True, (syllable_count_local = 4) and (tail_len = 2),
                tail_text, tail_score, tail_reliable) then
            begin
                Continue;
            end;

            combined_text := head_text + tail_text;
            if get_candidate_text_unit_count(combined_text) <>
                input_syllable_count then
            begin
                Continue;
            end;
            if not can_use_four_syllable_compound_tail_local(head_text,
                tail_text, tail_len) then
            begin
                Continue;
            end;

            combined_score := head_score + tail_score + c_prefix_tail_bonus +
                (head_len * head_len * 512);
            if tail_len > 1 then
            begin
                Inc(combined_score, (tail_len - 1) * c_exact_tail_span_bonus);
            end;
            Inc(combined_score, m_dictionary.get_context_bonus(head_text,
                tail_text));
            if (not best_is_pronoun_connector_tail) and
                (combined_score > best_score) then
            begin
                best_score := combined_score;
                best_text := combined_text;
                best_path := head_text + c_segment_path_separator + tail_text;
                best_tail_len := tail_len;
                best_tail_is_fixed_single := tail_is_fixed_single;
                best_is_pronoun_connector_tail := False;
            end;
            if (syllable_count_local = 4) and (tail_len = 2) and
                head_reliable and tail_reliable and (best_text <> '') then
            begin
                Break;
            end;
            if tail_is_fixed_single and (best_text <> '') then
            begin
                Break;
            end;
        end;

        if best_text = '' then
        begin
            if has_function_head_candidate then
            begin
                best_text := function_head_text;
                best_path := function_head_path;
                best_score := function_head_score;
                best_tail_len := syllable_count_local - 1;
                best_tail_is_fixed_single := False;
                best_is_pronoun_connector_tail := False;
            end
            else
            begin
                Exit;
            end;
        end
        else if has_function_head_candidate then
        begin
            best_path := infer_segment_path_for_query_text_with_score(
                lookup_text, best_text, inferred_path_score,
                inferred_path_segment_count);
            if (not best_is_pronoun_connector_tail) and
                ((syllable_count_local >= 5) or
                path_has_unsupported_single_segment_local(best_path) or
                (function_head_score > best_score)) then
            begin
                best_text := function_head_text;
                best_path := function_head_path;
                best_score := function_head_score;
                best_tail_len := syllable_count_local - 1;
                best_tail_is_fixed_single := False;
                best_is_pronoun_connector_tail := False;
            end;
        end;

        if (best_tail_len = 1) and (not best_tail_is_fixed_single) and
            has_covering_partial_anchor_local then
        begin
            Exit;
        end;
        if (not best_is_pronoun_connector_tail) and
            path_has_nonbase_two_plus_single_segment_local(best_path) then
        begin
            Exit;
        end;

        existing_index := -1;
        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) = '') and
                SameText(Trim(candidates[idx].text), best_text) then
            begin
                existing_index := idx;
                Break;
            end;
        end;

        if existing_index = 0 then
        begin
            remember_best_candidate_path_local(best_text,
                Max(candidates[0].score, best_score));
            Exit;
        end;

        if existing_index > 0 then
        begin
            picked := candidates[existing_index];
            picked.score := Max(Max(candidates[0].score + 2048,
                picked.score), best_score);
            remember_best_candidate_path_local(picked.text, picked.score);
            for idx := existing_index downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := picked;
        end
        else
        begin
            FillChar(picked, SizeOf(picked), 0);
            picked.text := best_text;
            picked.comment := '';
            picked.score := Max(candidates[0].score + 2048, best_score);
            picked.source := cs_rule;
            picked.has_dict_weight := False;
            picked.dict_weight := 0;
            remember_best_candidate_path_local(picked.text, picked.score);
            SetLength(candidates, Length(candidates) + 1);
            for idx := High(candidates) downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := picked;
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' sptail=[text=%s score=%d]', [best_text, best_score]);
        end;
    end;

    procedure ensure_two_syllable_quantity_phrase_candidate_visible(
        var candidates: TncCandidateList);
    var
        syllables_local: TncPinyinParseResult;
        head_text: string;
        tail_text: string;
        combined_text: string;
        existing_index: Integer;
        target_index: Integer;
        idx: Integer;
        picked: TncCandidate;

        function get_number_head_text_local(const syllable_text: string): string;
        var
            normalized_syllable: string;
        begin
            Result := '';
            normalized_syllable := normalize_pinyin_text(syllable_text);
            if normalized_syllable = 'yi' then
            begin
                Result := string(Char($4E00));
            end
            else if (normalized_syllable = 'er') or (normalized_syllable = 'liang') then
            begin
                Result := string(Char($4E8C));
            end
            else if normalized_syllable = 'san' then
            begin
                Result := string(Char($4E09));
            end
            else if normalized_syllable = 'si' then
            begin
                Result := string(Char($56DB));
            end
            else if normalized_syllable = 'wu' then
            begin
                Result := string(Char($4E94));
            end
            else if normalized_syllable = 'liu' then
            begin
                Result := string(Char($516D));
            end
            else if normalized_syllable = 'qi' then
            begin
                Result := string(Char($4E03));
            end
            else if normalized_syllable = 'ba' then
            begin
                Result := string(Char($516B));
            end
            else if normalized_syllable = 'jiu' then
            begin
                Result := string(Char($4E5D));
            end
            else if normalized_syllable = 'shi' then
            begin
                Result := string(Char($5341));
            end;
        end;

        function get_quantity_tail_text_local(const syllable_text: string): string;
        var
            normalized_syllable: string;
        begin
            Result := '';
            normalized_syllable := normalize_pinyin_text(syllable_text);
            if normalized_syllable = 'zi' then
            begin
                Result := string(Char($5B57));
            end
            else if normalized_syllable = 'xiang' then
            begin
                Result := string(Char($9879));
            end
            else if normalized_syllable = 'ci' then
            begin
                Result := string(Char($6B21));
            end
            else if normalized_syllable = 'ge' then
            begin
                Result := string(Char($4E2A));
            end
            else if normalized_syllable = 'tiao' then
            begin
                Result := string(Char($6761));
            end
            else if normalized_syllable = 'zhang' then
            begin
                Result := string(Char($5F20));
            end
            else if normalized_syllable = 'dian' then
            begin
                Result := string(Char($70B9));
            end
            else if normalized_syllable = 'bu' then
            begin
                Result := string(Char($6B65));
            end
            else if normalized_syllable = 'lun' then
            begin
                Result := string(Char($8F6E));
            end
            else if normalized_syllable = 'jie' then
            begin
                Result := string(Char($8282));
            end
            else if normalized_syllable = 'ye' then
            begin
                Result := string(Char($9875));
            end
            else if normalized_syllable = 'duan' then
            begin
                Result := string(Char($6BB5));
            end
            else if normalized_syllable = 'hang' then
            begin
                Result := string(Char($884C));
            end
            else if normalized_syllable = 'lie' then
            begin
                Result := string(Char($5217));
            end;
        end;

        function is_protected_complete_exact_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            candidate_text: string;
        begin
            Result := False;
            candidate_text := Trim(candidate_value.text);
            if (candidate_text = '') or (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(candidate_text) <>
                input_syllable_count) then
            begin
                Exit;
            end;
            Exit(True);
        end;

        function get_quantity_insert_index_local: Integer;
        begin
            Result := 0;
            while (Result <= High(candidates)) and
                is_protected_complete_exact_candidate_local(candidates[Result]) do
            begin
                Inc(Result);
            end;
        end;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count <> 2) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> 2 then
        begin
            Exit;
        end;

        head_text := get_number_head_text_local(syllables_local[0].text);
        tail_text := get_quantity_tail_text_local(syllables_local[1].text);
        if (head_text = '') or (tail_text = '') then
        begin
            Exit;
        end;

        combined_text := head_text + tail_text;
        if SameText(Trim(candidates[0].text), combined_text) and
            (Trim(candidates[0].comment) = '') then
        begin
            Exit;
        end;

        existing_index := -1;
        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) = '') and
                SameText(Trim(candidates[idx].text), combined_text) then
            begin
                existing_index := idx;
                Break;
            end;
        end;
        target_index := get_quantity_insert_index_local;

        if existing_index > target_index then
        begin
            picked := candidates[existing_index];
            for idx := existing_index downto target_index + 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[target_index] := picked;
            existing_index := target_index;
        end
        else if existing_index < 0 then
        begin
            FillChar(picked, SizeOf(picked), 0);
            picked.text := combined_text;
            picked.comment := '';
            picked.score := 0;
            picked.source := cs_rule;
            picked.has_dict_weight := False;
            picked.dict_weight := 0;
            SetLength(candidates, Length(candidates) + 1);
            for idx := High(candidates) downto target_index + 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[target_index] := picked;
            existing_index := target_index;
        end;

        if existing_index >= 0 then
        begin
            remember_segment_path_for_candidate(combined_text, '',
                head_text + c_segment_path_separator + tail_text,
                candidates[existing_index].score);
        end;
    end;

    procedure ensure_best_short_natural_split_candidate_visible(
        var candidates: TncCandidateList);
    const
        c_max_span_local = 3;
        c_probe_limit_local = 8;
        c_min_user_direct_weight_local = 300;
        c_invalid_score_local = Low(Integer) div 4;
    var
        syllables_local: TncPinyinParseResult;
        syllable_count_local: Integer;
        scores: TArray<Integer>;
        texts: TArray<string>;
        paths: TArray<string>;
        last_segments: TArray<string>;
        segment_counts: TArray<Integer>;
        pos: Integer;
        span_len: Integer;
        next_pos: Integer;
        result_idx: Integer;
        results: TncCandidateList;
        query_key: string;
        candidate_text: string;
        candidate_weight: Integer;
        segment_score: Integer;
        next_score: Integer;
        best_text: string;
        best_path: string;
        existing_index: Integer;
        idx: Integer;
        top_text: string;
        top_weight: Integer;
        top_complete: Boolean;
        picked: TncCandidate;

        function build_query_key_local(const start_idx: Integer;
            const local_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := start_idx to start_idx + local_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function get_candidate_weight_local(const candidate: TncCandidate): Integer;
        begin
            if candidate.has_dict_weight and (candidate.dict_weight > 0) then
            begin
                Result := candidate.dict_weight;
                Exit;
            end;
            Result := candidate.score;
        end;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count < 2) or (input_syllable_count > 6) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        syllable_count_local := Length(syllables_local);
        if syllable_count_local <> input_syllable_count then
        begin
            Exit;
        end;

        SetLength(scores, syllable_count_local + 1);
        SetLength(texts, syllable_count_local + 1);
        SetLength(paths, syllable_count_local + 1);
        SetLength(last_segments, syllable_count_local + 1);
        SetLength(segment_counts, syllable_count_local + 1);
        for idx := 0 to syllable_count_local do
        begin
            scores[idx] := c_invalid_score_local;
            texts[idx] := '';
            paths[idx] := '';
            last_segments[idx] := '';
            segment_counts[idx] := 0;
        end;
        scores[0] := 0;

        for pos := 0 to syllable_count_local - 1 do
        begin
            if scores[pos] <= c_invalid_score_local div 2 then
            begin
                Continue;
            end;

            for span_len := 1 to Min(c_max_span_local,
                syllable_count_local - pos) do
            begin
                if (pos = 0) and (span_len = syllable_count_local) then
                begin
                    Continue;
                end;
                query_key := build_query_key_local(pos, span_len);
                if (query_key = '') or (not m_dictionary.lookup(query_key,
                    results)) then
                begin
                    Continue;
                end;

                for result_idx := 0 to High(results) do
                begin
                    if result_idx >= c_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(results[result_idx].text);
                    if (candidate_text = '') or
                        (get_candidate_text_unit_count(candidate_text) <>
                        span_len) then
                    begin
                        Continue;
                    end;

                    candidate_weight := get_candidate_weight_local(
                        results[result_idx]);
                    if (Trim(results[result_idx].comment) = '') and
                        (m_dictionary <> nil) then
                    begin
                        Inc(candidate_weight,
                            m_dictionary.get_query_choice_bonus(query_key,
                            candidate_text) * 8);
                    end;
                    if (span_len >= 2) and
                        (not m_dictionary.is_base_entry(query_key,
                        candidate_text)) and
                        (not ((results[result_idx].source = cs_user) and
                        m_dictionary.is_user_entry(query_key,
                        candidate_text))) then
                    begin
                        candidate_weight := Min(candidate_weight,
                            240 + span_len * 80);
                    end;
                    if (results[result_idx].source = cs_user) and
                        (candidate_weight < c_min_user_direct_weight_local) then
                    begin
                        Continue;
                    end;

                    segment_score := candidate_weight + span_len * 512;
                    if span_len > 1 then
                    begin
                        Inc(segment_score, 1024);
                    end;
                    Inc(segment_score,
                        (c_probe_limit_local - result_idx) * 24);
                    if last_segments[pos] <> '' then
                    begin
                        Inc(segment_score, m_dictionary.get_context_bonus(
                            last_segments[pos], candidate_text));
                    end;

                    next_pos := pos + span_len;
                    next_score := scores[pos] + segment_score;
                    if next_score > scores[next_pos] then
                    begin
                        scores[next_pos] := next_score;
                        texts[next_pos] := texts[pos] + candidate_text;
                        if paths[pos] <> '' then
                        begin
                            paths[next_pos] := paths[pos] +
                                c_segment_path_separator + candidate_text;
                        end
                        else
                        begin
                            paths[next_pos] := candidate_text;
                        end;
                        last_segments[next_pos] := candidate_text;
                        segment_counts[next_pos] := segment_counts[pos] + 1;
                    end;
                end;
            end;
        end;

        if (scores[syllable_count_local] <= c_invalid_score_local div 2) or
            (segment_counts[syllable_count_local] < 2) then
        begin
            Exit;
        end;

        best_text := texts[syllable_count_local];
        best_path := paths[syllable_count_local];
        if (best_text = '') or
            (get_candidate_text_unit_count(best_text) <> input_syllable_count) then
        begin
            Exit;
        end;

        top_text := Trim(candidates[0].text);
        top_complete := (Trim(candidates[0].comment) = '') and
            (get_candidate_text_unit_count(top_text) = input_syllable_count);
        top_weight := get_candidate_weight_local(candidates[0]);
        if top_complete and SameText(top_text, best_text) then
        begin
            remember_segment_path_for_candidate(best_text, '', best_path,
                Max(candidates[0].score, scores[syllable_count_local]));
            Exit;
        end;
        if top_complete and (candidates[0].source <> cs_user) and
            (top_weight >= 1800) then
        begin
            Exit;
        end;
        if top_complete and
            (scores[syllable_count_local] < top_weight + 512) then
        begin
            Exit;
        end;

        existing_index := -1;
        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) = '') and
                SameText(Trim(candidates[idx].text), best_text) then
            begin
                existing_index := idx;
                Break;
            end;
        end;

        if existing_index = 0 then
        begin
            Exit;
        end;
        if existing_index > 0 then
        begin
            picked := candidates[existing_index];
            picked.score := Max(picked.score, candidates[0].score + 1024);
            picked.has_dict_weight := True;
            picked.dict_weight := Max(picked.dict_weight,
                scores[syllable_count_local]);
            for idx := existing_index downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := picked;
        end
        else
        begin
            FillChar(picked, SizeOf(picked), 0);
            picked.text := best_text;
            picked.comment := '';
            picked.score := Max(scores[syllable_count_local],
                candidates[0].score + 1024);
            picked.source := cs_rule;
            picked.has_dict_weight := True;
            picked.dict_weight := scores[syllable_count_local];
            SetLength(candidates, Length(candidates) + 1);
            for idx := High(candidates) downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := picked;
        end;
        remember_segment_path_for_candidate(best_text, '', best_path,
            scores[syllable_count_local]);
    end;

    procedure ensure_reliable_full_query_exact_complete_candidate_fast_visible(
        var candidates: TncCandidateList);
    const
        c_min_exact_weight = 700;
        c_min_three_syllable_exact_weight = 520;
        c_min_four_syllable_exact_weight = 520;
        c_supported_split_exact_margin = 512;
    var
        exact_results: TncCandidateList;
        best_idx: Integer;
        best_weight: Integer;
        min_exact_weight: Integer;
        best_candidate: TncCandidate;
        idx: Integer;
        existing_idx: Integer;
        candidate_text: string;
        candidate_weight: Integer;
        exact_support_score: Integer;
        exact_support_segments: Integer;
        top_support_score: Integer;
        top_support_segments: Integer;
        exact_rank: Integer;
        top_rank: Integer;
        exact_path: string;
        top_path: string;
        top_path_hint: string;
        exact_path_hint: string;
        top_text: string;

        function is_modifier_single_text_local(const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $662F, $7684, $4E86, $5728, $548C, $4E0D, $518D, $9AD8,
                $5F88, $592A, $6700, $66F4, $6CA1, $8981, $4F1A, $80FD,
                $628A, $88AB, $8BA9, $7ED9, $5982, $8001, $5C0F, $5927,
                $5168, $8D85, $771F, $597D, $53C8, $4E5F, $5DF2, $5C06,
                $53EF, $60F3, $65E0, $975E, $672A, $4ECD, $90FD, $8FD8,
                $624D, $5C31, $53EA, $522B, $591A, $5C11, $65B0, $633A,
                $8F83, $9887, $6781, $5411, $5BF9, $4ECE, $4E8E, $4E0E,
                $800C, $5E76:
                    Result := True;
            end;
        end;

        function get_modifier_head_tail_path_bonus_local(
            const encoded_path: string): Integer;
        var
            path_parts: TArray<string>;
            head_text_local: string;
            tail_text_local: string;
        begin
            Result := 0;
            if encoded_path = '' then
            begin
                Exit;
            end;

            path_parts := encoded_path.Split([c_segment_path_separator]);
            if Length(path_parts) <> 2 then
            begin
                Exit;
            end;

            head_text_local := Trim(path_parts[0]);
            tail_text_local := Trim(path_parts[1]);
            if is_modifier_single_text_local(head_text_local) and
                (get_candidate_text_unit_count(tail_text_local) >= 2) then
            begin
                Result := 3500;
            end;
        end;

        function build_support_rank_local(const encoded_path: string;
            const support_score: Integer; const support_segments: Integer;
            const candidate_score: Integer): Integer;
        begin
            if (encoded_path = '') or (support_segments <= 0) then
            begin
                Exit(candidate_score div 8 - 4096);
            end;

            Result := support_score + candidate_score div 32 -
                support_segments * 120 +
                get_modifier_head_tail_path_bonus_local(encoded_path);
        end;

        function build_support_rank_with_hint_local(const encoded_path: string;
            const path_hint: string; const support_score: Integer;
            const support_segments: Integer; const candidate_score: Integer): Integer;
        var
            encoded_bonus: Integer;
            hint_bonus: Integer;
        begin
            encoded_bonus := get_modifier_head_tail_path_bonus_local(encoded_path);
            hint_bonus := get_modifier_head_tail_path_bonus_local(path_hint);
            Result := build_support_rank_local(encoded_path, support_score,
                support_segments, candidate_score);
            if hint_bonus > encoded_bonus then
            begin
                Inc(Result, hint_bonus - encoded_bonus);
            end;
        end;

        function is_sentence_particle_unit_local(const unit_value: string): Boolean;
        begin
            Result := (unit_value = string(Char($4E86))) or
                (unit_value = string(Char($7740))) or

                (unit_value = string(Char($8FC7))) or
                (unit_value = string(Char($5417))) or
                (unit_value = string(Char($561B))) or
                (unit_value = string(Char($5427))) or
                (unit_value = string(Char($5462))) or
                (unit_value = string(Char($554A))) or
                (unit_value = string(Char($5440))) or

                (unit_value = string(Char($5566))) or
                (unit_value = string(Char($7684))) or
                (unit_value = string(Char($5730))) or
                (unit_value = string(Char($5F97)));
        end;

        function should_keep_supported_split_over_full_exact_local(
            const encoded_path: string; const path_hint: string;
            const exact_weight: Integer): Boolean;
        var
            local_path: string;
            path_parts: TArray<string>;
            tail_units: TArray<string>;
        begin
            Result := False;
            if input_syllable_count <> 3 then
            begin
                Exit;
            end;

            local_path := encoded_path;
            if local_path = '' then
            begin
                local_path := path_hint;
            end;
            if local_path = '' then
            begin
                Exit;
            end;

            path_parts := local_path.Split([c_segment_path_separator]);
            if Length(path_parts) <> 2 then
            begin
                Exit;
            end;
            if (get_candidate_text_unit_count(Trim(path_parts[0])) <> 2) then
            begin
                Exit;
            end;

            tail_units := split_text_units(Trim(path_parts[1]));
            if Length(tail_units) <> 1 then
            begin
                Exit;
            end;

            // Keep natural AB + sentence-particle parses (e.g. "鎴愬姛/浜?)
            // from being displaced by rare full-span technical nouns. Other
            // splits such as "宸ョ▼/鏄? or "鍙樻垚/鏂归潰" should not suppress an
            // exact full dictionary phrase.
            Result := is_sentence_particle_unit_local(tail_units[0]) and
                (exact_weight < 1600);
        end;
    begin
        if (m_dictionary = nil) or (input_syllable_count < 3) or
            (input_syllable_count > 8) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        min_exact_weight := c_min_exact_weight;
        if input_syllable_count = 3 then
        begin
            min_exact_weight := c_min_three_syllable_exact_weight;
        end
        else if input_syllable_count = 4 then
        begin
            min_exact_weight := c_min_four_syllable_exact_weight;
        end;

        if not lookup_exact_full_pinyin_cached_local(lookup_text, exact_results) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_weight := Low(Integer);
        for idx := 0 to High(exact_results) do
        begin
            if Trim(exact_results[idx].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text := Trim(exact_results[idx].text);
            if get_candidate_text_unit_count(candidate_text) <> input_syllable_count then
            begin
                Continue;
            end;

            if exact_results[idx].has_dict_weight then
            begin
                candidate_weight := exact_results[idx].dict_weight;
            end
            else
            begin
                candidate_weight := exact_results[idx].score;
            end;
            if (exact_results[idx].source <> cs_user) and
                (candidate_weight < min_exact_weight) then
            begin
                Continue;
            end;
            Inc(candidate_weight,
                get_preferred_query_phrase_bonus_local(lookup_text,
                candidate_text));

            if (best_idx < 0) or (candidate_weight > best_weight) then
            begin
                best_idx := idx;
                best_weight := candidate_weight;
            end;
        end;

        if best_idx < 0 then
        begin
            Exit;
        end;

        best_candidate := exact_results[best_idx];
        best_candidate.comment := '';
        if best_candidate.score < best_weight then
        begin
            best_candidate.score := best_weight;
        end;
        if not best_candidate.has_dict_weight then
        begin
            best_candidate.has_dict_weight := True;
            best_candidate.dict_weight := best_weight;
        end;
        if (Length(candidates) > 0) and
            (best_candidate.source <> cs_user) then
        begin
            top_text := Trim(candidates[0].text);
            if (top_text <> '') and (Trim(candidates[0].comment) = '') and
                (get_candidate_text_unit_count(top_text) = input_syllable_count) and
                (not SameText(top_text, Trim(best_candidate.text))) then
            begin
                top_path := infer_segment_path_for_query_text_with_score(
                    lookup_text, top_text, top_support_score, top_support_segments);
                exact_path := infer_segment_path_for_query_text_with_score(
                    lookup_text, Trim(best_candidate.text), exact_support_score,
                    exact_support_segments);
                top_path_hint := get_segment_path_for_candidate(candidates[0], 0);
                exact_path_hint := get_segment_path_for_candidate(best_candidate);
                top_rank := build_support_rank_with_hint_local(top_path,
                    top_path_hint, top_support_score, top_support_segments,
                    candidates[0].score);
                exact_rank := build_support_rank_with_hint_local(exact_path,
                    exact_path_hint, exact_support_score, exact_support_segments,
                    best_candidate.score);
                if (top_path <> '') and
                    (top_rank > exact_rank + c_supported_split_exact_margin) and
                    should_keep_supported_split_over_full_exact_local(top_path,
                    top_path_hint, best_weight) then
                begin
                    Exit;
                end;
            end;
        end;

        if (Length(candidates) > 0) and
            (not SameText(Trim(candidates[0].text),
            Trim(best_candidate.text))) then
        begin
            best_candidate.score := Max(best_candidate.score,
                candidates[0].score + 2048);
            if best_candidate.dict_weight < best_weight then
            begin
                best_candidate.dict_weight := best_weight;
            end;
        end;

        existing_idx := -1;
        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) = '') and
                SameText(Trim(candidates[idx].text), Trim(best_candidate.text)) then
            begin
                existing_idx := idx;
                Break;
            end;
        end;

        if existing_idx = 0 then
        begin
            if candidates[0].score < best_candidate.score then
            begin
                candidates[0].score := best_candidate.score;
            end;
            Exit;
        end;

        if existing_idx > 0 then
        begin
            for idx := existing_idx downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := best_candidate;
        end
        else
        begin
            SetLength(candidates, Length(candidates) + 1);
            for idx := High(candidates) downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := best_candidate;
        end;

    end;

    procedure prepare_short_two_single_pair_candidates_local;
    const
        c_min_lm_raw_weight = 420;
        c_max_visible_pair_candidates = 2;
        c_generated_complete_base_score = 15000;
    var
        syllables_local: TncPinyinParseResult;
        left_results_local: TncCandidateList;
        right_results_local: TncCandidateList;
        full_exact_results_local: TncCandidateList;
        model_paths_local: TncPairPathEvidenceList;
        accepted_texts_local: TArray<string>;
        accepted_paths_local: TArray<string>;
        accepted_ranks_local: TArray<Integer>;
        parts_local: TArray<string>;
        left_key_local: string;
        right_key_local: string;
        left_text_local: string;
        right_text_local: string;
        combined_text_local: string;
        path_local: string;
        evidence_idx_local: Integer;
        accepted_idx_local: Integer;
        scan_idx_local: Integer;
        left_weight_local: Integer;
        right_weight_local: Integer;
        rank_local: Integer;
        best_rank_local: Integer;
        temp_text_local: string;
        temp_rank_local: Integer;
        candidate_local: TncCandidate;

        function exact_single_weight_local(const results_value: TncCandidateList;
            const text_value: string): Integer;
        var
            idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := -1;
            for idx_local := 0 to High(results_value) do
            begin
                candidate_text_local := Trim(results_value[idx_local].text);
                if (Trim(results_value[idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                    (not SameText(candidate_text_local, text_value)) then
                begin
                    Continue;
                end;
                Result := Max(Result, results_value[idx_local].score);
                if results_value[idx_local].has_dict_weight then
                begin
                    Result := Max(Result, results_value[idx_local].dict_weight);
                end;
            end;
        end;

        function is_full_query_exact_text_local(const text_value: string): Boolean;
        var
            idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            for idx_local := 0 to High(full_exact_results_local) do
            begin
                candidate_text_local := Trim(full_exact_results_local[idx_local].text);
                if (Trim(full_exact_results_local[idx_local].comment) = '') and
                    (get_candidate_text_unit_count(candidate_text_local) = 2) and
                    SameText(candidate_text_local, text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure add_candidate_local(const text_value: string;
            const path_value: string; const rank_value: Integer);
        var
            idx_local: Integer;
        begin
            for idx_local := 0 to High(accepted_texts_local) do
            begin
                if SameText(accepted_texts_local[idx_local], text_value) then
                begin
                    if rank_value > accepted_ranks_local[idx_local] then
                    begin
                        accepted_paths_local[idx_local] := path_value;
                        accepted_ranks_local[idx_local] := rank_value;
                    end;
                    Exit;
                end;
            end;
            idx_local := Length(accepted_texts_local);
            SetLength(accepted_texts_local, idx_local + 1);
            SetLength(accepted_paths_local, idx_local + 1);
            SetLength(accepted_ranks_local, idx_local + 1);
            accepted_texts_local[idx_local] := text_value;
            accepted_paths_local[idx_local] := path_value;
            accepted_ranks_local[idx_local] := rank_value;
        end;
    begin
        if short_two_single_pair_prepared then
        begin
            Exit;
        end;
        short_two_single_pair_prepared := True;
        SetLength(short_two_single_pair_candidates, 0);
        SetLength(short_two_single_pair_paths, 0);
        SetLength(short_two_single_pair_rank_scores, 0);
        if m_config.debug_mode and (input_syllable_count = 2) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' t2probe=[apostrophe=%d full=%d]',
                [Ord(has_explicit_apostrophe_input),
                Ord(is_full_pinyin_key(lookup_text))]);
        end;

        if (m_dictionary = nil) or (input_syllable_count <> 2) or
            has_explicit_apostrophe_input or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(
            normalize_pinyin_text(lookup_text));
        if Length(syllables_local) <> 2 then
        begin
            Exit;
        end;

        left_key_local := normalize_pinyin_text(syllables_local[0].text);
        right_key_local := normalize_pinyin_text(syllables_local[1].text);
        if (left_key_local = '') or (right_key_local = '') or
            (not lookup_exact_full_pinyin_cached_local(left_key_local,
            left_results_local)) or
            (not lookup_exact_full_pinyin_cached_local(right_key_local,
            right_results_local)) then
        begin
            Exit;
        end;
        SetLength(full_exact_results_local, 0);
        lookup_exact_full_pinyin_cached_local(lookup_text,
            full_exact_results_local);
        SetLength(model_paths_local, 0);
        if not m_dictionary.get_exact_pair_path_evidence(lookup_text,
            model_paths_local) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' t2evidence=0';
            end;
            Exit;
        end;

        SetLength(accepted_texts_local, 0);
        SetLength(accepted_paths_local, 0);
        SetLength(accepted_ranks_local, 0);
        for evidence_idx_local := 0 to High(model_paths_local) do
        begin
            if model_paths_local[evidence_idx_local].lm_transition_weight <
                c_min_lm_raw_weight then
            begin
                Continue;
            end;
            path_local := Trim(model_paths_local[evidence_idx_local].encoded_path);
            parts_local := path_local.Split([c_segment_path_separator]);
            if (Length(parts_local) <> 2) or
                (get_candidate_text_unit_count(Trim(parts_local[0])) <> 1) or
                (get_candidate_text_unit_count(Trim(parts_local[1])) <> 1) then
            begin
                Continue;
            end;
            left_text_local := Trim(parts_local[0]);
            right_text_local := Trim(parts_local[1]);
            combined_text_local := left_text_local + right_text_local;
            if is_full_query_exact_text_local(combined_text_local) then
            begin
                Continue;
            end;
            left_weight_local := exact_single_weight_local(left_results_local,
                left_text_local);
            right_weight_local := exact_single_weight_local(right_results_local,
                right_text_local);
            if (left_weight_local < 0) or (right_weight_local < 0) then
            begin
                Continue;
            end;
            rank_local := model_paths_local[evidence_idx_local].lm_transition_weight *
                4 + Min(4096, left_weight_local) + Min(4096,
                right_weight_local);
            add_candidate_local(combined_text_local, path_local, rank_local);
        end;
        if Length(accepted_texts_local) = 0 then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' t2accepted=0 evidence=%d',
                    [Length(model_paths_local)]);
            end;
            Exit;
        end;

        for accepted_idx_local := 0 to High(accepted_texts_local) - 1 do
        begin
            for scan_idx_local := accepted_idx_local + 1 to
                High(accepted_texts_local) do
            begin
                if accepted_ranks_local[scan_idx_local] <=
                    accepted_ranks_local[accepted_idx_local] then
                begin
                    Continue;
                end;
                temp_text_local := accepted_texts_local[accepted_idx_local];
                accepted_texts_local[accepted_idx_local] :=
                    accepted_texts_local[scan_idx_local];
                accepted_texts_local[scan_idx_local] := temp_text_local;
                temp_text_local := accepted_paths_local[accepted_idx_local];
                accepted_paths_local[accepted_idx_local] :=
                    accepted_paths_local[scan_idx_local];
                accepted_paths_local[scan_idx_local] := temp_text_local;
                temp_rank_local := accepted_ranks_local[accepted_idx_local];
                accepted_ranks_local[accepted_idx_local] :=
                    accepted_ranks_local[scan_idx_local];
                accepted_ranks_local[scan_idx_local] := temp_rank_local;
            end;
        end;
        if Length(accepted_texts_local) > c_max_visible_pair_candidates then
        begin
            SetLength(accepted_texts_local, c_max_visible_pair_candidates);
            SetLength(accepted_paths_local, c_max_visible_pair_candidates);
            SetLength(accepted_ranks_local, c_max_visible_pair_candidates);
        end;

        best_rank_local := accepted_ranks_local[0];
        SetLength(short_two_single_pair_candidates,
            Length(accepted_texts_local));
        SetLength(short_two_single_pair_paths, Length(accepted_texts_local));
        SetLength(short_two_single_pair_rank_scores,
            Length(accepted_texts_local));
        for accepted_idx_local := 0 to High(accepted_texts_local) do
        begin
            FillChar(candidate_local, SizeOf(candidate_local), 0);
            candidate_local.text := accepted_texts_local[accepted_idx_local];
            candidate_local.comment := '';
            candidate_local.score := c_generated_complete_base_score -
                Min(2000, Max(0, best_rank_local -
                accepted_ranks_local[accepted_idx_local]));
            candidate_local.source := cs_rule;
            candidate_local.has_dict_weight := False;
            candidate_local.dict_weight := 0;
            candidate_local.display_kind := cdk_lm_compound;
            short_two_single_pair_candidates[accepted_idx_local] :=
                candidate_local;
            short_two_single_pair_paths[accepted_idx_local] :=
                accepted_paths_local[accepted_idx_local];
            short_two_single_pair_rank_scores[accepted_idx_local] :=
                accepted_ranks_local[accepted_idx_local];
        end;

        m_short_two_single_pair_query := normalize_pinyin_text(lookup_text);
        SetLength(m_short_two_single_pair_texts,
            Length(short_two_single_pair_candidates));
        for accepted_idx_local := 0 to
            High(short_two_single_pair_candidates) do
        begin
            m_short_two_single_pair_texts[accepted_idx_local] :=
                Trim(short_two_single_pair_candidates[accepted_idx_local].text);
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' t2single=[n=%d top=%s rank=%d]',
                [Length(short_two_single_pair_candidates),
                Trim(short_two_single_pair_candidates[0].text),
                short_two_single_pair_rank_scores[0]]);
        end;
    end;

    procedure ensure_short_two_single_pair_candidates_visible_local(
        var candidates: TncCandidateList);
    var
        exact_results_local: TncCandidateList;
        candidate_idx_local: Integer;
        accepted_idx_local: Integer;
        move_idx_local: Integer;
        insert_idx_local: Integer;
        picked_local: TncCandidate;

        function is_full_query_exact_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <> 2) then
            begin
                Exit;
            end;
            if candidate_value.source = cs_user then
            begin
                Exit(True);
            end;
            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(exact_text_local) = 2) and
                    SameText(exact_text_local, Trim(candidate_value.text)) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        prepare_short_two_single_pair_candidates_local;
        if Length(short_two_single_pair_candidates) = 0 then
        begin
            Exit;
        end;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' t2visible-before=%d', [Length(candidates)]);
        end;

        SetLength(exact_results_local, 0);
        lookup_exact_full_pinyin_cached_local(lookup_text,
            exact_results_local);
        for accepted_idx_local := 0 to
            High(short_two_single_pair_candidates) do
        begin
            candidate_idx_local := -1;
            for move_idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[move_idx_local].comment) = '') and
                    SameText(Trim(candidates[move_idx_local].text),
                    Trim(short_two_single_pair_candidates[
                    accepted_idx_local].text)) then
                begin
                    candidate_idx_local := move_idx_local;
                    Break;
                end;
            end;
            if candidate_idx_local >= 0 then
            begin
                for move_idx_local := candidate_idx_local to
                    High(candidates) - 1 do
                begin
                    candidates[move_idx_local] := candidates[move_idx_local + 1];
                end;
                SetLength(candidates, Length(candidates) - 1);
            end;
        end;

        insert_idx_local := 0;
        for candidate_idx_local := 0 to High(candidates) do
        begin
            if is_full_query_exact_candidate_local(
                candidates[candidate_idx_local]) then
            begin
                insert_idx_local := candidate_idx_local + 1;
            end;
        end;

        for accepted_idx_local := 0 to
            High(short_two_single_pair_candidates) do
        begin
            picked_local := short_two_single_pair_candidates[
                accepted_idx_local];
            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto
                insert_idx_local + 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[insert_idx_local] := picked_local;
            remember_segment_path_for_candidate(picked_local.text, '',
                short_two_single_pair_paths[accepted_idx_local],
                picked_local.score);
            Inc(insert_idx_local);
        end;
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' t2visible-after=%d', [Length(candidates)]);
        end;
    end;

    procedure prepare_short_three_exact_pair_candidates_local;
    const
        c_segment_probe_limit = 16;
        c_pair_prebeam_per_split = 8;
        c_max_visible_pair_candidates = 3;
        c_min_lm_raw_weight = 390;
        c_min_query_path_raw_weight = 420;
        c_min_corroborated_raw_weight = 360;
        c_model_evidence_cap = 1560;
        c_generated_complete_base_score = 16000;
    var
        syllables_local: TncPinyinParseResult;
        full_exact_results_local: TncCandidateList;
        head_results_local: TncCandidateList;
        tail_results_local: TncCandidateList;
        model_paths_local: TncPairPathEvidenceList;
        pair_texts_local: TArray<string>;
        pair_paths_local: TArray<string>;
        pair_splits_local: TArray<Integer>;
        pair_head_weights_local: TArray<Integer>;
        pair_tail_weights_local: TArray<Integer>;
        pair_model_evidence_local: TArray<Integer>;
        pair_pre_ranks_local: TArray<Integer>;
        pair_final_ranks_local: TArray<Integer>;
        accepted_indices_local: TArray<Integer>;
        head_key_local: string;
        tail_key_local: string;
        head_text_local: string;
        tail_text_local: string;
        pair_text_local: string;
        pair_path_local: string;
        split_local: Integer;
        head_idx_local: Integer;
        tail_idx_local: Integer;
        pair_idx_local: Integer;
        accepted_idx_local: Integer;
        best_rank_local: Integer;
        model_evidence_local: Integer;
        has_usable_model_evidence_local: Boolean;
        lexical_rank_local: Integer;
        display_score_local: Integer;
        candidate_local: TncCandidate;

        function build_span_key_local(const start_idx: Integer;
            const span_len: Integer): string;
        var
            idx_local: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (span_len <= 0) or
                (start_idx + span_len > Length(syllables_local)) then
            begin
                Exit;
            end;
            for idx_local := start_idx to start_idx + span_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[idx_local].text);
            end;
        end;

        function candidate_weight_local(const candidate_value: TncCandidate): Integer;
        begin
            Result := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;
            if candidate_value.source = cs_user then
            begin
                Result := Max(Result, 4096);
            end;
            Result := Max(0, Min(4096, Result));
        end;

        function has_full_query_exact_local: Boolean;
        var
            idx_local: Integer;
            text_local: string;
        begin
            Result := False;
            if not lookup_exact_full_pinyin_cached_local(lookup_text,
                full_exact_results_local) then
            begin
                Exit;
            end;
            for idx_local := 0 to High(full_exact_results_local) do
            begin
                text_local := Trim(full_exact_results_local[idx_local].text);
                if (Trim(full_exact_results_local[idx_local].comment) = '') and
                    (get_candidate_text_unit_count(text_local) = 3) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure collect_exact_segments_local(const key_value: string;
            const expected_units_value: Integer; out results_value: TncCandidateList);
        var
            raw_results_local: TncCandidateList;
            raw_idx_local: Integer;
            result_idx_local: Integer;
            existing_idx_local: Integer;
            text_local: string;
        begin
            SetLength(results_value, 0);
            if (key_value = '') or
                (not m_dictionary.lookup_isolated_exact_component(key_value,
                raw_results_local)) then
            begin
                Exit;
            end;

            for raw_idx_local := 0 to High(raw_results_local) do
            begin
                if Length(results_value) >= c_segment_probe_limit then
                begin
                    Break;
                end;
                text_local := Trim(raw_results_local[raw_idx_local].text);
                if (Trim(raw_results_local[raw_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(text_local) <>
                    expected_units_value) or
                    ((raw_results_local[raw_idx_local].source <> cs_user) and
                    (not raw_results_local[raw_idx_local].has_dict_weight) and
                    (not m_dictionary.is_base_entry(key_value, text_local))) then
                begin
                    Continue;
                end;

                existing_idx_local := -1;
                for result_idx_local := 0 to High(results_value) do
                begin
                    if SameText(Trim(results_value[result_idx_local].text),
                        text_local) then
                    begin
                        existing_idx_local := result_idx_local;
                        Break;
                    end;
                end;
                if existing_idx_local >= 0 then
                begin
                    if candidate_weight_local(raw_results_local[raw_idx_local]) >
                        candidate_weight_local(results_value[existing_idx_local]) then
                    begin
                        results_value[existing_idx_local] :=
                            raw_results_local[raw_idx_local];
                    end;
                    Continue;
                end;

                result_idx_local := Length(results_value);
                SetLength(results_value, result_idx_local + 1);
                results_value[result_idx_local] := raw_results_local[raw_idx_local];
            end;
        end;

        function get_model_evidence_local(const path_value: string): Integer;
        var
            idx_local: Integer;
            query_path_raw_local: Integer;
            lm_raw_local: Integer;
            path_penalty_local: Integer;
        begin
            Result := 0;
            query_path_raw_local := 0;
            lm_raw_local := 0;
            for idx_local := 0 to High(model_paths_local) do
            begin
                if SameText(Trim(model_paths_local[idx_local].encoded_path),
                    path_value) then
                begin
                    query_path_raw_local := Max(query_path_raw_local,
                        model_paths_local[idx_local].query_path_weight);
                    lm_raw_local := Max(lm_raw_local,
                        model_paths_local[idx_local].lm_transition_weight);
                end;
            end;

            if (lm_raw_local >= c_min_lm_raw_weight) or
                ((lm_raw_local >= c_min_corroborated_raw_weight) and
                (query_path_raw_local >= c_min_corroborated_raw_weight)) then
            begin
                Result := Min(c_model_evidence_cap, 3 * lm_raw_local);
            end;
            if query_path_raw_local >= c_min_query_path_raw_weight then
            begin
                Result := Max(Result, Min(420,
                    (query_path_raw_local * 3) div 5 + 28));
            end;

            if Result = 0 then Exit;
            path_penalty_local := Max(0, get_cached_query_segment_path_penalty(
                lookup_text, path_value));
            if path_penalty_local > 0 then
            begin
                Result := Max(0, Result - path_penalty_local);
            end;
        end;

        procedure add_pair_prebeam_local(const split_value: Integer;
            const head_candidate_value: TncCandidate;
            const tail_candidate_value: TncCandidate);
        var
            idx_local: Integer;
            same_split_count_local: Integer;
            worst_idx_local: Integer;
            worst_rank_local: Integer;
            head_weight_local: Integer;
            tail_weight_local: Integer;
            pre_rank_local: Integer;

            procedure write_pair_local(const target_idx: Integer);
            begin
                pair_texts_local[target_idx] := pair_text_local;
                pair_paths_local[target_idx] := pair_path_local;
                pair_splits_local[target_idx] := split_value;
                pair_head_weights_local[target_idx] := head_weight_local;
                pair_tail_weights_local[target_idx] := tail_weight_local;
                pair_model_evidence_local[target_idx] := model_evidence_local;
                pair_pre_ranks_local[target_idx] := pre_rank_local;
            end;
        begin
            head_text_local := Trim(head_candidate_value.text);
            tail_text_local := Trim(tail_candidate_value.text);
            if (head_text_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;
            pair_text_local := head_text_local + tail_text_local;
            pair_path_local := head_text_local + c_segment_path_separator +
                tail_text_local;
            head_weight_local := candidate_weight_local(head_candidate_value);
            tail_weight_local := candidate_weight_local(tail_candidate_value);
            model_evidence_local := get_model_evidence_local(pair_path_local);
            pre_rank_local := head_weight_local + tail_weight_local +
                model_evidence_local * 2;

            for idx_local := 0 to High(pair_texts_local) do
            begin
                if SameText(pair_texts_local[idx_local], pair_text_local) then
                begin
                    if pre_rank_local > pair_pre_ranks_local[idx_local] then
                    begin
                        write_pair_local(idx_local);
                    end;
                    Exit;
                end;
            end;

            same_split_count_local := 0;
            worst_idx_local := -1;
            worst_rank_local := High(Integer);
            for idx_local := 0 to High(pair_texts_local) do
            begin
                if pair_splits_local[idx_local] <> split_value then
                begin
                    Continue;
                end;
                Inc(same_split_count_local);
                if pair_pre_ranks_local[idx_local] < worst_rank_local then
                begin
                    worst_rank_local := pair_pre_ranks_local[idx_local];
                    worst_idx_local := idx_local;
                end;
            end;

            if same_split_count_local >= c_pair_prebeam_per_split then
            begin
                if (worst_idx_local >= 0) and
                    (pre_rank_local > worst_rank_local) then
                begin
                    write_pair_local(worst_idx_local);
                end;
                Exit;
            end;

            idx_local := Length(pair_texts_local);
            SetLength(pair_texts_local, idx_local + 1);
            SetLength(pair_paths_local, idx_local + 1);
            SetLength(pair_splits_local, idx_local + 1);
            SetLength(pair_head_weights_local, idx_local + 1);
            SetLength(pair_tail_weights_local, idx_local + 1);
            SetLength(pair_model_evidence_local, idx_local + 1);
            SetLength(pair_pre_ranks_local, idx_local + 1);
            write_pair_local(idx_local);
        end;

        procedure add_accepted_index_local(const pair_index_value: Integer);
        var
            idx_local: Integer;
        begin
            if (pair_index_value < 0) or
                (pair_index_value > High(pair_texts_local)) then
            begin
                Exit;
            end;
            for idx_local := 0 to High(accepted_indices_local) do
            begin
                if SameText(pair_texts_local[accepted_indices_local[idx_local]],
                    pair_texts_local[pair_index_value]) then
                begin
                    if pair_final_ranks_local[pair_index_value] >
                        pair_final_ranks_local[accepted_indices_local[idx_local]] then
                    begin
                        accepted_indices_local[idx_local] := pair_index_value;
                    end;
                    Exit;
                end;
            end;
            idx_local := Length(accepted_indices_local);
            SetLength(accepted_indices_local, idx_local + 1);
            accepted_indices_local[idx_local] := pair_index_value;
        end;

        procedure sort_accepted_indices_local;
        var
            left_idx_local: Integer;
            right_idx_local: Integer;
            temp_idx_local: Integer;
        begin
            for left_idx_local := 0 to High(accepted_indices_local) - 1 do
            begin
                for right_idx_local := left_idx_local + 1 to
                    High(accepted_indices_local) do
                begin
                    if pair_final_ranks_local[
                        accepted_indices_local[right_idx_local]] >
                        pair_final_ranks_local[
                        accepted_indices_local[left_idx_local]] then
                    begin
                        temp_idx_local := accepted_indices_local[left_idx_local];
                        accepted_indices_local[left_idx_local] :=
                            accepted_indices_local[right_idx_local];
                        accepted_indices_local[right_idx_local] := temp_idx_local;
                    end;
                end;
            end;
        end;

        procedure consider_attested_char_pair_local;
        const
            c_min_component_weight = 80;
            c_min_trigram_score = -3072;
            c_min_particle_bigram_score = -6144;
            c_min_conditional_score = -12288;
            c_min_competitor_margin = 1024;
            c_min_tail_context_lift = 512;
            c_min_lift_head_weight = 200;
            c_min_lift_tail_weight = 420;
            c_grams_per_pair = 5;
            // Below the display-stage dictionary-exact override threshold.
            c_char_evidence = 350;
        var
            ngrams_local: TArray<string>;
            observed_scores_local: TArray<Integer>;
            observed_backoffs_local: TArray<Integer>;
            text_scores_local: TArray<Integer>;
            context_scores_local: TArray<Integer>;
            units_local: TArray<string>;
            idx_local, best_idx_local: Integer;
            score_local, best_score_local, next_score_local: Integer;
            particle_key_local, particle_text_local, particle_head_local: string;
            left_context_local: string;
            particle_query_local, attested_local: Boolean;

            function has_attested_tail_context_lift_local(
                const index: Integer): Boolean;
            var
                offset_local, gram_idx_local: Integer;
            begin
                Result := False;
                if (pair_splits_local[index] <> 1) or
                    (not is_one_plus_two_supported_head_single_local(
                    Copy(pair_texts_local[index], 1, 1))) or
                    (Length(observed_backoffs_local) <> Length(observed_scores_local)) or
                    (pair_head_weights_local[index] < c_min_lift_head_weight) or
                    (pair_tail_weights_local[index] < c_min_lift_tail_weight) then Exit;
                offset_local := index * c_grams_per_pair;
                for gram_idx_local := 0 to c_grams_per_pair - 1 do
                    if observed_scores_local[offset_local + gram_idx_local] =
                        Low(Integer) then Exit;
                // A retained higher-order continuation makes this weak trigram
                // boundary inconclusive. Leave it to the original evidence
                // channels rather than approving a clipped longer expression.
                if observed_backoffs_local[offset_local] <> 0 then Exit;
                // Compare P(BC|A) with P(BC), as well as P(C|AB) with
                // P(C|B). A familiar exact tail must gain observed contextual
                // support, not merely inherit a high backoff word probability.
                // Productive heads avoid treating a word's last character as
                // an independent head (e.g. a noun fragment before its verb).
                Result := (Int64(observed_scores_local[offset_local]) -
                    observed_scores_local[offset_local + 1] >= c_min_tail_context_lift) and
                    (Int64(observed_scores_local[offset_local + 3]) +
                    observed_scores_local[offset_local] -
                    observed_scores_local[offset_local + 4] -
                    observed_scores_local[offset_local + 1] >= c_min_tail_context_lift);
            end;

            function path_is_attested_local(const index: Integer): Boolean;
            begin
                Result := (observed_scores_local[index * c_grams_per_pair] >=
                    c_min_trigram_score) or has_attested_tail_context_lift_local(index);
                if (not Result) and particle_query_local and
                    (pair_splits_local[index] = 2) and
                    (Copy(pair_texts_local[index], Length(pair_texts_local[index]),
                    1) = particle_text_local) then
                    Result := observed_scores_local[index * c_grams_per_pair + 1] >=
                        c_min_particle_bigram_score;
            end;

            function has_independent_left_boundary_local(const index: Integer): Boolean;
            var
                reversed_local: string;
                reverse_scores_local, reverse_backoffs_local: TArray<Integer>;
            begin
                Result := False;
                reversed_local := Copy(pair_texts_local[index], 3, 1) +
                    Copy(pair_texts_local[index], 2, 1) +
                    Copy(pair_texts_local[index], 1, 1);
                if not m_dictionary.get_char_lm_parameters(
                    TArray<string>.Create(reversed_local, reversed_local + #3),
                    reverse_scores_local, reverse_backoffs_local, True) or
                    (Length(reverse_scores_local) <> 2) or
                    (Length(reverse_backoffs_local) <> 2) or
                    (reverse_scores_local[0] = Low(Integer)) then Exit;
                // A retained preceding context can be the start of a clipped
                // word. Require observed sentence-start support in that case;
                // neither missing data nor a backoff estimate proves a boundary.
                Result := (reverse_backoffs_local[0] = 0) or
                    (reverse_scores_local[1] <> Low(Integer));
            end;
        begin
            // This is a bounded fallback for missing word transitions, not a
            // replacement for them. Backoff probability alone cannot admit a path.
            if has_usable_model_evidence_local or
                (Length(pair_texts_local) < 2) then Exit;
            SetLength(ngrams_local, Length(pair_texts_local) * c_grams_per_pair);
            for idx_local := 0 to High(pair_texts_local) do
            begin
                units_local := split_text_units(pair_texts_local[idx_local]);
                if Length(units_local) <> 3 then Exit;
                ngrams_local[idx_local * c_grams_per_pair] := pair_texts_local[idx_local];
                ngrams_local[idx_local * c_grams_per_pair + 1] := units_local[1] + units_local[2];
                ngrams_local[idx_local * c_grams_per_pair + 2] := units_local[0];
                ngrams_local[idx_local * c_grams_per_pair + 3] := units_local[0] + units_local[1];
                ngrams_local[idx_local * c_grams_per_pair + 4] := units_local[1];
            end;
            SetLength(observed_backoffs_local, 0);
            if not m_dictionary.get_char_lm_parameters(ngrams_local,
                observed_scores_local, observed_backoffs_local) then
            begin
                SetLength(observed_backoffs_local, 0);
                if not m_dictionary.get_char_lm_attested_scores(ngrams_local,
                    observed_scores_local) then Exit;
            end;
            if Length(observed_scores_local) <> Length(ngrams_local) then Exit;
            particle_query_local := try_get_short_particle_tail_query_parts(
                lookup_text, particle_key_local, particle_text_local,
                particle_head_local);
            attested_local := False;
            for idx_local := 0 to High(pair_texts_local) do
                if path_is_attested_local(idx_local) then
                begin
                    attested_local := True;
                    Break;
                end;
            if not attested_local then Exit;
            if (not m_dictionary.get_char_lm_continuation_scores('', pair_texts_local,
                text_scores_local)) or
                (Length(text_scores_local) <> Length(pair_texts_local)) then Exit;
            best_idx_local := -1;
            best_score_local := Low(Integer);
            next_score_local := Low(Integer);
            for idx_local := 0 to High(pair_texts_local) do
            begin
                if observed_scores_local[idx_local * c_grams_per_pair + 2] = Low(Integer) then Continue;
                // Rank whole phrases, without an artificial sentence end. The
                // scorer returns a per-character mean; all paths have three units.
                score_local := 3 * text_scores_local[idx_local];
                if score_local > best_score_local then
                begin
                    next_score_local := best_score_local;
                    best_score_local := score_local;
                    best_idx_local := idx_local;
                end
                else next_score_local := Max(next_score_local, score_local);
            end;
            if m_config.debug_mode and (best_idx_local >= 0) then
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' [s3char=%s score=%d next=%d obs=%d/%d w=%d/%d]',
                    [pair_texts_local[best_idx_local], best_score_local,
                    next_score_local, observed_scores_local[best_idx_local * c_grams_per_pair],
                    observed_scores_local[best_idx_local * c_grams_per_pair + 1],
                    pair_head_weights_local[best_idx_local],
                    pair_tail_weights_local[best_idx_local]]);
            if (best_idx_local < 0) or (next_score_local = Low(Integer)) or
                ((best_score_local - Int64(observed_scores_local[
                best_idx_local * c_grams_per_pair + 2]) < c_min_conditional_score) and
                (not has_attested_tail_context_lift_local(best_idx_local))) or
                (best_score_local - next_score_local < c_min_competitor_margin) or
                (pair_head_weights_local[best_idx_local] < c_min_component_weight) or
                (pair_tail_weights_local[best_idx_local] < c_min_component_weight) or
                (get_cached_query_segment_path_penalty(lookup_text,
                pair_paths_local[best_idx_local]) > 0) then Exit;

            if not path_is_attested_local(best_idx_local) then Exit;

            if ((observed_scores_local[best_idx_local * c_grams_per_pair] <
                c_min_trigram_score) or
                (best_score_local - Int64(observed_scores_local[
                best_idx_local * c_grams_per_pair + 2]) < c_min_conditional_score)) and
                has_attested_tail_context_lift_local(best_idx_local) and
                (not has_independent_left_boundary_local(best_idx_local)) then Exit;

            if m_config.debug_mode and has_attested_tail_context_lift_local(best_idx_local) then
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' [s3char-tail-lift]';

            // A context-free phrase preference must not overrule a conflicting
            // preceding context. Leave that decision to the contextual ranker.
            left_context_local := Trim(m_segment_left_context);
            if left_context_local = '' then
                left_context_local := Trim(m_external_left_context);
            if left_context_local = '' then
                left_context_local := Trim(m_left_context);
            left_context_local := context_model_tail(left_context_local);
            if left_context_local <> '' then
            begin
                if (not get_cached_char_lm_scores(pair_texts_local,
                    context_scores_local, clsm_context, left_context_local)) or
                    (Length(context_scores_local) <> Length(pair_texts_local)) then Exit;
                for idx_local := 0 to High(pair_texts_local) do
                    if (idx_local <> best_idx_local) and
                        (3 * (Int64(context_scores_local[best_idx_local]) -
                        context_scores_local[idx_local]) < c_min_competitor_margin) then
                    begin
                        if m_config.debug_mode then
                            m_last_full_path_debug_info := m_last_full_path_debug_info +
                                ' [s3char-context-abstain]';
                        Exit;
                    end;
            end;

            pair_model_evidence_local[best_idx_local] := 3 * c_char_evidence;
            m_short_three_char_pair_path := pair_paths_local[best_idx_local];
            m_short_three_char_pair_evidence := c_char_evidence;
        end;
    begin
        if short_three_exact_pair_prepared then
        begin
            Exit;
        end;
        short_three_exact_pair_prepared := True;
        SetLength(short_three_exact_pair_candidates, 0);
        SetLength(short_three_exact_pair_paths, 0);
        SetLength(short_three_exact_pair_rank_scores, 0);
        m_short_three_char_pair_path := '';
        m_short_three_char_pair_evidence := 0;

        if (m_dictionary = nil) or (input_syllable_count <> 3) or
            has_explicit_apostrophe_input or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(
            normalize_pinyin_text(lookup_text));
        if (Length(syllables_local) <> 3) or has_full_query_exact_local then
        begin
            Exit;
        end;

        SetLength(model_paths_local, 0);
        m_dictionary.get_exact_pair_path_evidence(lookup_text,
            model_paths_local);
        has_usable_model_evidence_local := False;
        for pair_idx_local := 0 to High(model_paths_local) do
        begin
            if (model_paths_local[pair_idx_local].lm_transition_weight >=
                c_min_lm_raw_weight) or
                (model_paths_local[pair_idx_local].query_path_weight >=
                c_min_query_path_raw_weight) or
                ((model_paths_local[pair_idx_local].lm_transition_weight >=
                c_min_corroborated_raw_weight) and
                (model_paths_local[pair_idx_local].query_path_weight >=
                c_min_corroborated_raw_weight)) then
            begin
                has_usable_model_evidence_local := True;
                Break;
            end;
        end;
        SetLength(pair_texts_local, 0);
        SetLength(pair_paths_local, 0);
        SetLength(pair_splits_local, 0);
        SetLength(pair_head_weights_local, 0);
        SetLength(pair_tail_weights_local, 0);
        SetLength(pair_model_evidence_local, 0);
        SetLength(pair_pre_ranks_local, 0);

        for split_local := 1 to 2 do
        begin
            head_key_local := build_span_key_local(0, split_local);
            tail_key_local := build_span_key_local(split_local,
                3 - split_local);
            collect_exact_segments_local(head_key_local, split_local,
                head_results_local);
            collect_exact_segments_local(tail_key_local, 3 - split_local,
                tail_results_local);
            for head_idx_local := 0 to High(head_results_local) do
            begin
                for tail_idx_local := 0 to High(tail_results_local) do
                begin
                    add_pair_prebeam_local(split_local,
                        head_results_local[head_idx_local],
                        tail_results_local[tail_idx_local]);
                end;
            end;
        end;
        if Length(pair_texts_local) = 0 then
        begin
            Exit;
        end;

        consider_attested_char_pair_local;

        SetLength(pair_final_ranks_local, Length(pair_texts_local));
        SetLength(accepted_indices_local, 0);
        for pair_idx_local := 0 to High(pair_texts_local) do
        begin
            lexical_rank_local := pair_head_weights_local[pair_idx_local] +
                pair_tail_weights_local[pair_idx_local];
            pair_final_ranks_local[pair_idx_local] := lexical_rank_local +
                pair_model_evidence_local[pair_idx_local] * 2;
            if pair_model_evidence_local[pair_idx_local] > 0 then
            begin
                add_accepted_index_local(pair_idx_local);
            end;
        end;
        if Length(accepted_indices_local) = 0 then
        begin
            Exit;
        end;
        sort_accepted_indices_local;
        if Length(accepted_indices_local) > c_max_visible_pair_candidates then
        begin
            SetLength(accepted_indices_local, c_max_visible_pair_candidates);
        end;

        best_rank_local := pair_final_ranks_local[accepted_indices_local[0]];
        for accepted_idx_local := 0 to High(accepted_indices_local) do
        begin
            pair_idx_local := accepted_indices_local[accepted_idx_local];
            display_score_local := c_generated_complete_base_score -
                Min(3000, Max(0, best_rank_local -
                pair_final_ranks_local[pair_idx_local]));
            FillChar(candidate_local, SizeOf(candidate_local), 0);
            candidate_local.text := pair_texts_local[pair_idx_local];
            candidate_local.comment := '';
            candidate_local.score := display_score_local;
            candidate_local.source := cs_rule;
            candidate_local.has_dict_weight := False;
            candidate_local.dict_weight := 0;
            candidate_local.display_kind := cdk_lm_compound;

            SetLength(short_three_exact_pair_candidates,
                accepted_idx_local + 1);
            SetLength(short_three_exact_pair_paths, accepted_idx_local + 1);
            SetLength(short_three_exact_pair_rank_scores,
                accepted_idx_local + 1);
            short_three_exact_pair_candidates[accepted_idx_local] :=
                candidate_local;
            short_three_exact_pair_paths[accepted_idx_local] :=
                pair_paths_local[pair_idx_local];
            short_three_exact_pair_rank_scores[accepted_idx_local] :=
                pair_final_ranks_local[pair_idx_local];
        end;

        m_short_three_exact_pair_query := normalize_pinyin_text(lookup_text);
        SetLength(m_short_three_exact_pair_texts,
            Length(short_three_exact_pair_candidates));
        for accepted_idx_local := 0 to
            High(short_three_exact_pair_candidates) do
        begin
            m_short_three_exact_pair_texts[accepted_idx_local] :=
                Trim(short_three_exact_pair_candidates[accepted_idx_local].text);
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' t3pair=[n=%d top=%s rank=%d]',
                [Length(short_three_exact_pair_candidates),
