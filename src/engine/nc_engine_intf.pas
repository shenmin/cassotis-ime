    procedure ensure_supported_short_four_two_exact_path_visible_local(
        const query_syllables_local: TncPinyinParseResult;
        var candidates_local: TncCandidateList);
    const
        c_aspect_probe_limit = 8;
        c_strong_path_top_evidence = 1000;
    var
        query_key_local: string;
        head_key_local: string;
        tail_key_local: string;
        head_results_local: TncCandidateList;
        tail_results_local: TncCandidateList;
        model_paths_local: TncPairPathEvidenceList;
        model_idx_local: Integer;
        head_idx_local: Integer;
        tail_idx_local: Integer;
        best_text_local: string;
        best_score_local: Integer;
        best_evidence_local: Integer;
        existing_idx_local: Integer;
        candidate_idx_local: Integer;
        picked_local: TncCandidate;
        has_full_query_exact_local: Boolean;
        has_full_query_user_exact_local: Boolean;
        full_query_exact_results_local: TncCandidateList;

        function candidate_weight_local(const candidate_value: TncCandidate): Integer;
        begin
            Result := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;
        end;

        function find_exact_candidate_local(
            const results_value: TncCandidateList; const text_value: string;
            out candidate_value: TncCandidate): Boolean;
        var
            idx_local: Integer;
        begin
            Result := False;
            FillChar(candidate_value, SizeOf(candidate_value), 0);
            for idx_local := 0 to High(results_value) do
            begin
                if (Trim(results_value[idx_local].comment) = '') and
                    (get_candidate_text_unit_count(
                    Trim(results_value[idx_local].text)) = 2) and
                    SameText(Trim(results_value[idx_local].text),
                    Trim(text_value)) then
                begin
                    candidate_value := results_value[idx_local];
                    Exit(True);
                end;
            end;
        end;

        function find_full_query_exact_candidate_local(
            const text_value: string; out candidate_value: TncCandidate): Boolean;
        var
            idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            FillChar(candidate_value, SizeOf(candidate_value), 0);
            for idx_local := 0 to High(full_query_exact_results_local) do
            begin
                exact_text_local := Trim(
                    full_query_exact_results_local[idx_local].text);
                if (Trim(full_query_exact_results_local[idx_local].comment) = '') and
                    (get_candidate_text_unit_count(exact_text_local) = 4) and
                    SameText(exact_text_local, Trim(text_value)) then
                begin
                    candidate_value := full_query_exact_results_local[idx_local];
                    Exit(True);
                end;
            end;
        end;

        procedure consider_path_local(const path_value: string);
        var
            parts_local: TArray<string>;
            head_candidate_local: TncCandidate;
            tail_candidate_local: TncCandidate;
            head_text_local: string;
            tail_text_local: string;
            combined_text_local: string;
            combined_score_local: Integer;
            context_bonus_local: Integer;
            evidence_score_local: Integer;
            evidence_path_local: string;
            existing_idx: Integer;
            idx_local: Integer;
            local_candidate: TncCandidate;
            full_exact_candidate_local: TncCandidate;
        begin
            if get_encoded_path_segment_count_local(path_value) <> 2 then
            begin
                Exit;
            end;
            parts_local := path_value.Split([c_segment_path_separator]);
            if Length(parts_local) <> 2 then
            begin
                Exit;
            end;
            head_text_local := Trim(parts_local[0]);
            tail_text_local := Trim(parts_local[1]);
            if (get_candidate_text_unit_count(head_text_local) <> 2) or
                (get_candidate_text_unit_count(tail_text_local) <> 2) or
                (not find_exact_candidate_local(head_results_local,
                head_text_local, head_candidate_local)) or
                (not find_exact_candidate_local(tail_results_local,
                tail_text_local, tail_candidate_local)) then
            begin
                Exit;
            end;

            combined_text_local := head_text_local + tail_text_local;
            if has_full_query_exact_local and
                (not find_full_query_exact_candidate_local(
                combined_text_local, full_exact_candidate_local)) then
            begin
                Exit;
            end;
            if not get_short_four_two_exact_path_evidence(query_key_local,
                combined_text_local, evidence_path_local,
                evidence_score_local) then
            begin
                Exit;
            end;
            if has_full_query_exact_local and
                (evidence_score_local < c_strong_path_top_evidence) then
            begin
                Exit;
            end;

            context_bonus_local := Max(0, Min(400,
                m_dictionary.get_context_bonus(head_text_local,
                tail_text_local)));
            combined_score_local :=
                (candidate_weight_local(head_candidate_local) +
                candidate_weight_local(tail_candidate_local)) div 2 +
                evidence_score_local + context_bonus_local;

            existing_idx := -1;
            for idx_local := 0 to High(candidates_local) do
            begin
                if (Trim(candidates_local[idx_local].comment) = '') and
                    SameText(Trim(candidates_local[idx_local].text),
                    combined_text_local) then
                begin
                    existing_idx := idx_local;
                    Break;
                end;
            end;
            if existing_idx >= 0 then
            begin
                local_candidate := candidates_local[existing_idx];
                local_candidate.score := Max(local_candidate.score,
                    combined_score_local);
                if not has_full_query_exact_local then
                begin
                    local_candidate.display_kind := cdk_lm_compound;
                end;
                candidates_local[existing_idx] := local_candidate;
            end
            else
            begin
                if has_full_query_exact_local then
                begin
                    local_candidate := full_exact_candidate_local;
                end
                else
                begin
                    FillChar(local_candidate, SizeOf(local_candidate), 0);
                    local_candidate.text := combined_text_local;
                    local_candidate.comment := '';
                    local_candidate.source := cs_rule;
                    local_candidate.has_dict_weight := False;
                    local_candidate.dict_weight := 0;
                    local_candidate.display_kind := cdk_lm_compound;
                end;
                local_candidate.score := combined_score_local;
                SetLength(candidates_local, Length(candidates_local) + 1);
                candidates_local[High(candidates_local)] := local_candidate;
            end;
            remember_segment_path_for_candidate(combined_text_local, '',
                evidence_path_local, combined_score_local);

            if (best_text_local = '') or
                (combined_score_local > best_score_local) or
                ((combined_score_local = best_score_local) and
                (CompareText(combined_text_local, best_text_local) < 0)) then
            begin
                best_text_local := combined_text_local;
                best_score_local := combined_score_local;
                best_evidence_local := evidence_score_local;
            end;
        end;
    begin
        if (m_dictionary = nil) or (Length(query_syllables_local) <> 4) then
        begin
            Exit;
        end;

        head_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, 2);
        tail_key_local := short_four_span_query_key_local(
            query_syllables_local, 2, 2);
        if (not lookup_exact_full_pinyin_cached_local(head_key_local,
            head_results_local)) or
            (not lookup_exact_full_pinyin_cached_local(tail_key_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        query_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, Length(query_syllables_local));
        SetLength(full_query_exact_results_local, 0);
        has_full_query_exact_local :=
            lookup_exact_full_pinyin_cached_local(query_key_local,
            full_query_exact_results_local) and
            (Length(full_query_exact_results_local) > 0);
        has_full_query_user_exact_local := False;
        if has_full_query_exact_local then
        begin
            for candidate_idx_local := 0 to High(
                full_query_exact_results_local) do
            begin
                if (full_query_exact_results_local[candidate_idx_local].source =
                    cs_user) and
                    (Trim(full_query_exact_results_local[
                    candidate_idx_local].comment) = '') then
                begin
                    has_full_query_user_exact_local := True;
                    Break;
                end;
            end;
        end;
        if has_full_query_user_exact_local then
        begin
            Exit;
        end;
        best_text_local := '';
        best_score_local := Low(Integer);
        best_evidence_local := 0;

        if m_dictionary.get_exact_pair_path_evidence(query_key_local,
            model_paths_local) then
        begin
            for model_idx_local := 0 to High(model_paths_local) do
            begin
                consider_path_local(model_paths_local[model_idx_local].encoded_path);
            end;
        end;

        // Productive aspect tails are a grammatical exception, not arbitrary
        // 2+2 composition. Keep their bounded fallback independent of the LM.
        if (not has_full_query_exact_local) and
            (SameText(normalize_pinyin_text(query_syllables_local[3].text),
            'le') or
            SameText(normalize_pinyin_text(query_syllables_local[3].text),
            'zhe') or
            SameText(normalize_pinyin_text(query_syllables_local[3].text),
            'guo')) then
        begin
            for head_idx_local := 0 to Min(c_aspect_probe_limit - 1,
                High(head_results_local)) do
            begin
                if (Trim(head_results_local[head_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(
                    Trim(head_results_local[head_idx_local].text)) <> 2) then
                begin
                    Continue;
                end;
                for tail_idx_local := 0 to Min(c_aspect_probe_limit - 1,
                    High(tail_results_local)) do
                begin
                    if (Trim(tail_results_local[tail_idx_local].comment) <> '') or
                        (get_candidate_text_unit_count(
                        Trim(tail_results_local[tail_idx_local].text)) <> 2) then
                    begin
                        Continue;
                    end;
                    consider_path_local(
                        Trim(head_results_local[head_idx_local].text) +
                        c_segment_path_separator +
                        Trim(tail_results_local[tail_idx_local].text));
                end;
            end;
        end;

        if best_text_local = '' then
        begin
            Exit;
        end;

        if SameText(query_key_local, lookup_text) then
            short_four_model_evidence_applied := True;
        sort_candidates_lightweight(candidates_local);
        if (((not has_full_query_exact_local) and
            (best_evidence_local > 0)) or
            (has_full_query_exact_local and
            (best_evidence_local >= c_strong_path_top_evidence) and
            find_full_query_exact_candidate_local(best_text_local,
            picked_local))) then
        begin
            existing_idx_local := -1;
            for candidate_idx_local := 0 to High(candidates_local) do
            begin
                if (Trim(candidates_local[candidate_idx_local].comment) = '') and
                    SameText(Trim(candidates_local[candidate_idx_local].text),
                    best_text_local) then
                begin
                    existing_idx_local := candidate_idx_local;
                    Break;
                end;
            end;
            if existing_idx_local > 0 then
            begin
                picked_local := candidates_local[existing_idx_local];
                for candidate_idx_local := existing_idx_local downto 1 do
                begin
                    candidates_local[candidate_idx_local] :=
                        candidates_local[candidate_idx_local - 1];
                end;
                candidates_local[0] := picked_local;
            end;
        end;
    end;

    procedure ensure_supported_short_four_two_prefix_partial_visible_local(
        const query_syllables_local: TncPinyinParseResult;
        var candidates_local: TncCandidateList);
    const
        c_prefix_syllable_count = 4;
        c_max_query_syllables = 8;
        c_remaining_syllable_penalty = 80;
    var
        prefix_syllables_local: TncPinyinParseResult;
        prefix_candidates_local: TncCandidateList;
        prefix_candidate_local: TncCandidate;
        prefix_query_local: string;
        remaining_pinyin_local: string;
        evidence_path_local: string;
        evidence_score_local: Integer;
        prefix_idx_local: Integer;
        candidate_idx_local: Integer;
        syllable_idx_local: Integer;
        existing_idx_local: Integer;
        remaining_count_local: Integer;
    begin
        if (m_dictionary = nil) or
            (Length(query_syllables_local) <= c_prefix_syllable_count) or
            (Length(query_syllables_local) > c_max_query_syllables) or
            has_explicit_apostrophe_input then
        begin
            Exit;
        end;

        SetLength(prefix_syllables_local, c_prefix_syllable_count);
        prefix_query_local := '';
        for syllable_idx_local := 0 to c_prefix_syllable_count - 1 do
        begin
            prefix_syllables_local[syllable_idx_local] :=
                query_syllables_local[syllable_idx_local];
            prefix_query_local := prefix_query_local + normalize_pinyin_text(
                query_syllables_local[syllable_idx_local].text);
        end;

        remaining_pinyin_local := '';
        for syllable_idx_local := c_prefix_syllable_count to
            High(query_syllables_local) do
        begin
            remaining_pinyin_local := remaining_pinyin_local +
                normalize_pinyin_text(
                query_syllables_local[syllable_idx_local].text);
        end;
        if (prefix_query_local = '') or (remaining_pinyin_local = '') then
        begin
            Exit;
        end;

        SetLength(prefix_candidates_local, 0);
        ensure_supported_short_four_two_exact_path_visible_local(
            prefix_syllables_local, prefix_candidates_local);
        for prefix_idx_local := 0 to High(prefix_candidates_local) do
        begin
            prefix_candidate_local := prefix_candidates_local[prefix_idx_local];
            if (Trim(prefix_candidate_local.comment) <> '') or
                (prefix_candidate_local.display_kind <> cdk_lm_compound) or
                (get_candidate_text_unit_count(
                Trim(prefix_candidate_local.text)) <>
                c_prefix_syllable_count) or
                (not get_short_four_two_exact_path_evidence(
                prefix_query_local, Trim(prefix_candidate_local.text),
                evidence_path_local, evidence_score_local)) then
            begin
                Continue;
            end;

            existing_idx_local := -1;
            for candidate_idx_local := 0 to High(candidates_local) do
            begin
                if SameText(Trim(candidates_local[candidate_idx_local].text),
                    Trim(prefix_candidate_local.text)) and
                    SameText(normalize_pinyin_text(Trim(
                    candidates_local[candidate_idx_local].comment)),
                    remaining_pinyin_local) then
                begin
                    existing_idx_local := candidate_idx_local;
                    Break;
                end;
            end;

            remaining_count_local := Length(query_syllables_local) -
                c_prefix_syllable_count;
            prefix_candidate_local.comment := remaining_pinyin_local;
            prefix_candidate_local.score := Max(1,
                prefix_candidate_local.score -
                (remaining_count_local * c_remaining_syllable_penalty));
            prefix_candidate_local.source := cs_rule;
            prefix_candidate_local.has_dict_weight := False;
            prefix_candidate_local.dict_weight := 0;
            prefix_candidate_local.display_kind := cdk_lm_compound;
            if existing_idx_local >= 0 then
            begin
                if prefix_candidate_local.score >
                    candidates_local[existing_idx_local].score then
                begin
                    candidates_local[existing_idx_local].score :=
                        prefix_candidate_local.score;
                end;
                candidates_local[existing_idx_local].source := cs_rule;
                candidates_local[existing_idx_local].has_dict_weight := False;
                candidates_local[existing_idx_local].dict_weight := 0;
                candidates_local[existing_idx_local].display_kind :=
                    cdk_lm_compound;
            end
            else
            begin
                SetLength(candidates_local, Length(candidates_local) + 1);
                candidates_local[High(candidates_local)] :=
                    prefix_candidate_local;
            end;
            remember_segment_path_for_candidate(
                Trim(prefix_candidate_local.text), remaining_pinyin_local,
                evidence_path_local, prefix_candidate_local.score);
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' s42prefix=1';
            end;
            Break;
        end;
    end;

    procedure ensure_supported_short_four_transition_particle_path_visible_local(
        const query_syllables_local: TncPinyinParseResult;
        var candidates_local: TncCandidateList);
    const
        c_generated_complete_base_score = 16000;
        c_max_generated_candidates = 3;
    var
        query_key_local: string;
        prefix_key_local: string;
        particle_key_local: string;
        particle_text_local: string;
        model_paths_local: TncPairPathEvidenceList;
        full_exact_results_local: TncCandidateList;
        model_idx_local: Integer;
        candidate_idx_local: Integer;
        existing_idx_local: Integer;
        move_idx_local: Integer;
        generated_count_local: Integer;
        evidence_score_local: Integer;
        best_evidence_local: Integer;
        generated_score_local: Integer;
        generated_text_local: string;
        evidence_path_local: string;
        model_path_local: string;
        path_parts_local: TArray<string>;
        generated_candidate_local: TncCandidate;
        picked_candidate_local: TncCandidate;
        best_text_local: string;

        function try_get_particle_text_local: Boolean;
        begin
            particle_key_local := normalize_pinyin_text(
                query_syllables_local[3].text);
            particle_text_local := '';
            if particle_key_local = 'de' then
            begin
                particle_text_local := string(Char($7684));
            end
            else if particle_key_local = 'le' then
            begin
                particle_text_local := string(Char($4E86));
            end
            else if particle_key_local = 'zhe' then
            begin
                particle_text_local := string(Char($7740));
            end
            else if particle_key_local = 'la' then
            begin
                particle_text_local := string(Char($5566));
            end
            else if particle_key_local = 'ba' then
            begin
                particle_text_local := string(Char($5427));
            end
            else if particle_key_local = 'ma' then
            begin
                particle_text_local := string(Char($5417));
            end
            else if particle_key_local = 'a' then
            begin
                particle_text_local := string(Char($554A));
            end;
            Result := particle_text_local <> '';
        end;

        function has_full_query_exact_local: Boolean;
        var
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if not lookup_exact_full_pinyin_cached_local(query_key_local,
                full_exact_results_local) then
            begin
                Exit;
            end;
            for exact_idx_local := 0 to High(full_exact_results_local) do
            begin
                exact_text_local := Trim(
                    full_exact_results_local[exact_idx_local].text);
                if (Trim(full_exact_results_local[exact_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(exact_text_local) = 4) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (m_dictionary = nil) or (Length(query_syllables_local) <> 4) or
            has_explicit_apostrophe_input or
            (not try_get_particle_text_local) then
        begin
            Exit;
        end;

        query_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, 4);
        prefix_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, 3);
        if (query_key_local = '') or (prefix_key_local = '') or
            has_full_query_exact_local or
            (not m_dictionary.get_exact_pair_path_evidence(prefix_key_local,
            model_paths_local)) then
        begin
            Exit;
        end;

        generated_count_local := 0;
        best_evidence_local := 0;
        best_text_local := '';
        for model_idx_local := 0 to High(model_paths_local) do
        begin
            if generated_count_local >= c_max_generated_candidates then
            begin
                Break;
            end;
            model_path_local := Trim(
                model_paths_local[model_idx_local].encoded_path);
            path_parts_local := model_path_local.Split(
                [c_segment_path_separator]);
            if Length(path_parts_local) <> 2 then
            begin
                Continue;
            end;
            generated_text_local := Trim(path_parts_local[0]) +
                Trim(path_parts_local[1]) + particle_text_local;
            if not get_short_four_transition_particle_path_evidence(
                query_key_local, generated_text_local, evidence_path_local,
                evidence_score_local) then
            begin
                Continue;
            end;

            generated_score_local := c_generated_complete_base_score +
                Min(1560, evidence_score_local);
            existing_idx_local := -1;
            for candidate_idx_local := 0 to High(candidates_local) do
            begin
                if (Trim(candidates_local[candidate_idx_local].comment) = '') and
                    SameText(Trim(candidates_local[candidate_idx_local].text),
                    generated_text_local) then
                begin
                    existing_idx_local := candidate_idx_local;
                    Break;
                end;
            end;

            if existing_idx_local >= 0 then
            begin
                generated_candidate_local :=
                    candidates_local[existing_idx_local];
                generated_candidate_local.score := Max(
                    generated_candidate_local.score, generated_score_local);
                generated_candidate_local.display_kind := cdk_lm_compound;
                candidates_local[existing_idx_local] :=
                    generated_candidate_local;
            end
            else
            begin
                FillChar(generated_candidate_local,
                    SizeOf(generated_candidate_local), 0);
                generated_candidate_local.text := generated_text_local;
                generated_candidate_local.comment := '';
                generated_candidate_local.source := cs_rule;
                generated_candidate_local.score := generated_score_local;
                generated_candidate_local.has_dict_weight := False;
                generated_candidate_local.dict_weight := 0;
                generated_candidate_local.display_kind := cdk_lm_compound;
                SetLength(candidates_local, Length(candidates_local) + 1);
                candidates_local[High(candidates_local)] :=
                    generated_candidate_local;
            end;
            remember_segment_path_for_candidate(generated_text_local, '',
                evidence_path_local, generated_score_local);
            Inc(generated_count_local);

            if (best_text_local = '') or
                (evidence_score_local > best_evidence_local) then
            begin
                best_text_local := generated_text_local;
                best_evidence_local := evidence_score_local;
            end;
        end;

        if best_text_local = '' then
        begin
            Exit;
        end;
        sort_candidates_lightweight(candidates_local);
        existing_idx_local := -1;
        for candidate_idx_local := 0 to High(candidates_local) do
        begin
            if (Trim(candidates_local[candidate_idx_local].comment) = '') and
                SameText(Trim(candidates_local[candidate_idx_local].text),
                best_text_local) then
            begin
                existing_idx_local := candidate_idx_local;
                Break;
            end;
        end;
        if existing_idx_local > 0 then
        begin
            picked_candidate_local := candidates_local[existing_idx_local];
            for move_idx_local := existing_idx_local downto 1 do
            begin
                candidates_local[move_idx_local] :=
                    candidates_local[move_idx_local - 1];
            end;
            candidates_local[0] := picked_candidate_local;
        end;
    end;

    function is_productive_short_function_head_text_local(
        const text_value: string): Boolean;
    begin
        Result := False;
        if get_candidate_text_unit_count(text_value) <> 2 then
        begin
            Exit;
        end;

        if SameText(text_value, string(Char($6709)) + string(Char($70B9))) or

            SameText(text_value, string(Char($4E00)) + string(Char($70B9))) or
            SameText(text_value, string(Char($4E0D)) + string(Char($662F))) or

            SameText(text_value, string(Char($4E0D)) + string(Char($4F1A))) or

            SameText(text_value, string(Char($4E0D)) + string(Char($80FD))) or

            SameText(text_value, string(Char($4E0D)) + string(Char($8981))) or

            SameText(text_value, string(Char($6CA1)) + string(Char($6709))) or

            SameText(text_value, string(Char($53EF)) + string(Char($4EE5))) or

            SameText(text_value, string(Char($5E94)) + string(Char($8BE5))) or

            SameText(text_value, string(Char($9700)) + string(Char($8981))) then
        begin
            Exit(True);
        end;
    end;

    function is_one_plus_two_supported_head_single_local(
        const text_value: string): Boolean;
    begin
        Result := False;
        if get_candidate_text_unit_count(text_value) <> 1 then
        begin
            Exit;
        end;

        case Ord(text_value[1]) of
            $4E0D, $518D, $5728, $9AD8, $5F88, $592A, $6700, $66F4,
            $53C8, $4E5F, $5C06, $53EF, $4F1A, $80FD, $8981,
            $60F3, $6CA1, $65E0, $975E, $672A, $4ECD, $90FD, $8FD8,
            $624D, $5C31, $53EA, $522B, $591A, $5C11, $5168, $8D85,
            $771F, $633A, $8F83, $628A, $88AB, $8BA9, $7ED9, $5411,
            $5BF9, $4ECE, $4E8E, $548C, $4E0E, $662F,
            $7B2C, $5148, $6211, $4F60, $60A8:
                Result := True;
        end;
    end;

    function is_unsupported_short_four_ab_cd_text_local(
        const text_value: string): Boolean;
    var
        units_local: TArray<string>;
        query_syllables_local: TncPinyinParseResult;
        first_unit_local: string;
        head_text_local: string;
        head_three_text_local: string;
        middle_text_local: string;
        tail_text_local: string;
        head_key_local: string;
        head_three_key_local: string;
        middle_key_local: string;
        tail_key_local: string;
        transition_particle_path_local: string;
        transition_particle_evidence_local: Integer;

        function is_short_particle_tail_unit_local(const pinyin_key_value: string;
            const text_value: string): Boolean;
        begin
            Result := ((pinyin_key_value = 'de') and
                SameText(text_value, string(Char($7684)))) or
                ((pinyin_key_value = 'le') and
                SameText(text_value, string(Char($4E86)))) or
                ((pinyin_key_value = 'zhe') and
                SameText(text_value, string(Char($7740)))) or
                ((pinyin_key_value = 'la') and
                SameText(text_value, string(Char($5566)))) or
                ((pinyin_key_value = 'ba') and
                SameText(text_value, string(Char($5427)))) or
                ((pinyin_key_value = 'ma') and
                SameText(text_value, string(Char($5417)))) or
                ((pinyin_key_value = 'a') and
                SameText(text_value, string(Char($554A))));
        end;

        function is_short_pronoun_unit_local(const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $6211, $4F60, $60A8, $4ED6, $5979, $5B83, $54B1:
                    Result := True;
            end;
        end;

        function is_short_connector_unit_local(const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $548C, $4E0E, $8DDF, $540C:
                    Result := True;
            end;
        end;

        function prefix_lookup_has_complete_text_local: Boolean;
        var
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or
                (not m_dictionary.lookup_full_pinyin_prefix(lookup_text,
                prefix_results_local)) then
            begin
                Exit;
            end;

            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                prefix_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                if (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                    prefix_results_local[prefix_idx_local].has_dict_weight and
                    (prefix_results_local[prefix_idx_local].dict_weight > 0) and
                    SameText(prefix_text_local, text_value) and
                    (get_candidate_text_unit_count(prefix_text_local) = 4) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (input_syllable_count <> 4) or
            (not is_full_pinyin_key(lookup_text)) or (text_value = '') then
        begin
            Exit;
        end;

        units_local := split_text_units(text_value);
        if Length(units_local) <> 4 then
        begin
            Exit;
        end;

        if direct_full_query_entry_has_text_local(lookup_text, text_value) then
        begin
            Exit;
        end;

        if prefix_lookup_has_complete_text_local then
        begin
            Exit;
        end;

        query_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(query_syllables_local) <> 4 then
        begin
            Exit;
        end;

        if short_four_two_exact_path_is_supported_local(
            query_syllables_local, text_value) then
        begin
            Exit;
        end;

        if get_short_four_transition_particle_path_evidence(lookup_text,
            text_value, transition_particle_path_local,
            transition_particle_evidence_local) then
        begin
            Exit;
        end;

        head_text_local := units_local[0] + units_local[1];
        tail_text_local := units_local[2] + units_local[3];
        head_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, 2);
        tail_key_local := short_four_span_query_key_local(
            query_syllables_local, 2, 2);

        if is_productive_short_function_head_text_local(head_text_local) and
            direct_exact_lookup_has_text_local(tail_key_local,
            tail_text_local, 2) then
        begin
            Exit;
        end;

        if direct_exact_lookup_has_text_local(head_key_local,
            head_text_local, 2) and
            is_short_pronoun_unit_local(units_local[2]) and
            is_short_connector_unit_local(units_local[3]) then
        begin
            Exit;
        end;

        if is_short_pronoun_unit_local(units_local[0]) and
            is_short_connector_unit_local(units_local[1]) and
            direct_exact_lookup_has_text_local(tail_key_local,
            tail_text_local, 2) then
        begin
            Exit;
        end;

        first_unit_local := units_local[0];
        middle_text_local := units_local[1] + units_local[2];
        middle_key_local := short_four_span_query_key_local(
            query_syllables_local, 1, 2);
        if is_one_plus_two_supported_head_single_local(first_unit_local) and
            direct_exact_lookup_has_text_local(middle_key_local,
            middle_text_local, 2) and
            is_short_particle_tail_unit_local(query_syllables_local[3].text,
            units_local[3]) then
        begin
            Exit;
        end;

        tail_text_local := units_local[1] + units_local[2] + units_local[3];
        tail_key_local := short_four_span_query_key_local(
            query_syllables_local, 1, 3);
        if is_one_plus_two_supported_head_single_local(first_unit_local) and
            direct_exact_lookup_has_text_local(tail_key_local,
            tail_text_local, 3) then
        begin
            Exit;
        end;

        head_three_text_local := units_local[0] + units_local[1] +
            units_local[2];
        head_three_key_local := short_four_span_query_key_local(
            query_syllables_local, 0, 3);
        if direct_exact_lookup_has_text_local(head_three_key_local,
            head_three_text_local, 3) and
            is_short_particle_tail_unit_local(query_syllables_local[3].text,
            units_local[3]) then
        begin
            Exit;
        end;

        Result := True;
    end;

    procedure filter_unsupported_short_four_ab_cd_complete_candidates_local(
        var candidates: TncCandidateList);
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_text_local: string;
    begin
        if (input_syllable_count <> 4) or (m_dictionary = nil) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        ensure_supported_short_four_two_exact_path_visible_local(
            get_effective_compact_pinyin_syllables(lookup_text), candidates);
        ensure_supported_short_four_transition_particle_path_visible_local(
            get_effective_compact_pinyin_syllables(lookup_text), candidates);
        if Length(candidates) = 0 then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(candidates) do
        begin
            candidate_text_local := Trim(candidates[in_idx_local].text);
            if (Trim(candidates[in_idx_local].comment) = '') and
                (candidate_text_local <> '') and
                (candidates[in_idx_local].source <> cs_user) and
                (not (candidates[in_idx_local].has_dict_weight and
                (candidates[in_idx_local].dict_weight > 0))) and
                (get_candidate_text_unit_count(candidate_text_local) =
                input_syllable_count) and
                is_unsupported_short_four_ab_cd_text_local(
                candidate_text_local) then
            begin
                Continue;
            end;

            if out_idx_local <> in_idx_local then
            begin
                candidates[out_idx_local] := candidates[in_idx_local];
            end;
            Inc(out_idx_local);
        end;
        SetLength(candidates, out_idx_local);
    end;

    function is_unsupported_short_four_ab_c_partial_candidate_local(
        const candidate: TncCandidate): Boolean;
    var
        units_local: TArray<string>;
        query_syllables_local: TncPinyinParseResult;
        head_text_local: string;
        tail_text_local: string;
        tail_key_local: string;
        prefix_text_local: string;
        prefix_key_local: string;
        normalized_comment_local: string;
        comment_unit_count_local: Integer;
        unit_idx_local: Integer;

        function candidate_has_allowed_one_plus_two_prefix_support_local:
            Boolean;
        begin
            Result := False;
            if Length(units_local) <> 3 then
            begin
                Exit;
            end;

            head_text_local := Trim(units_local[0]);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            tail_key_local := short_four_span_query_key_local(
                query_syllables_local, 1, 2);
            Result := (head_text_local <> '') and (tail_text_local <> '') and
                (tail_key_local <> '') and
                is_one_plus_two_supported_head_single_local(head_text_local) and
                direct_exact_lookup_has_text_local(tail_key_local,
                tail_text_local, 2);
        end;

    begin
        Result := False;
        if (m_dictionary = nil) or (input_syllable_count <> 4) or
            (not is_full_pinyin_key(lookup_text)) or
            (Trim(candidate.comment) = '') then
        begin
            Exit;
        end;

        normalized_comment_local := normalize_pinyin_text(Trim(candidate.comment));
        comment_unit_count_local := get_effective_compact_pinyin_unit_count(
            normalized_comment_local);
        if comment_unit_count_local <= 0 then
        begin
            Exit;
        end;

        units_local := split_text_units(Trim(candidate.text));
        if (Length(units_local) < 2) or (Length(units_local) > 3) then
        begin
            Exit;
        end;
        if Length(units_local) + comment_unit_count_local <> input_syllable_count
        then
        begin
            Exit;
        end;

        query_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);
        if Length(query_syllables_local) <> 4 then
        begin
            Exit;
        end;

        prefix_text_local := '';
        for unit_idx_local := 0 to High(units_local) do
        begin
            prefix_text_local := prefix_text_local + units_local[unit_idx_local];
        end;
        prefix_key_local := short_four_span_query_key_local(query_syllables_local,
            0, Length(units_local));
        if (prefix_key_local <> '') and (prefix_text_local <> '') and
            ((candidate.source = cs_user) or
            (candidate.has_dict_weight and (candidate.dict_weight > 0))) then
        begin
            Exit;
        end;

        if Length(units_local) <> 3 then
        begin
            Exit(True);
        end;

        if candidate_has_allowed_one_plus_two_prefix_support_local then
        begin
            Exit;
        end;

        Result := True;
    end;

