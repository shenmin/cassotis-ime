                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        SetLength(m_candidates, out_idx);
        if Length(m_candidate_segment_paths) > out_idx then
        begin
            SetLength(m_candidate_segment_paths, out_idx);
        end;
    end;

    procedure ensure_prefix_lookup_complete_visible;
    const
        c_max_units = 6;
        c_probe_limit = 4;
    var
        prefix_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
        existing_idx: Integer;
        prefix_candidate: TncCandidate;
    begin
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (expected_units < 3) or (expected_units > c_max_units) or
            (Length(m_candidates) = 0) or
            (Trim(m_candidates[0].comment) = '') or
            (not m_dictionary.lookup_full_pinyin_prefix(normalized_pinyin,
            prefix_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(prefix_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            if Trim(prefix_results[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text := Trim(prefix_results[idx].text);
            if get_candidate_text_unit_count(candidate_text) <> expected_units then
            begin
                Continue;
            end;

            existing_idx := find_display_candidate(candidate_text, '');
            if existing_idx >= 0 then
            begin
                move_display_candidate_to_front(existing_idx);
                Exit;
            end;

            prefix_candidate := prefix_results[idx];
            prefix_candidate.comment := '';
            prefix_candidate.source := cs_rule;
            Inc(prefix_candidate.score, 12000);
            insert_display_candidate(prefix_candidate, candidate_text, 0);
            Exit;
        end;
    end;

    procedure ensure_short_exact_full_candidates_before_partials;
    var
        exact_results: TncCandidateList;
        exact_candidates: TncCandidateList;
        idx: Integer;
        target_idx: Integer;
        candidate_text: string;
        candidate_units: Integer;
        has_exact_results: Boolean;
        existing_idx: Integer;
        picked: TncCandidate;

        function exact_effective_weight(const item: TncCandidate): Integer;
        begin
            Result := item.score;
            if item.has_dict_weight and (item.dict_weight > Result) then
            begin
                Result := item.dict_weight;
            end;
            if (item.source = cs_user) and
                display_candidate_has_supported_full_entry(normalized_pinyin,
                item) then
            begin
                Inc(Result, c_user_score_bonus);
            end;
            if display_candidate_has_supported_full_entry(normalized_pinyin,
                item) then
            begin
                Inc(Result, 1000000);
            end;
        end;

        function exact_text_already_selected(const text_value: string): Boolean;
        var
            exact_idx: Integer;
        begin
            Result := False;
            for exact_idx := 0 to High(exact_candidates) do
            begin
                if SameText(Trim(exact_candidates[exact_idx].text),
                    text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure sort_exact_candidates_by_weight;
        var
            left_idx: Integer;
            right_idx: Integer;
            tmp: TncCandidate;
        begin
            for left_idx := 0 to High(exact_candidates) - 1 do
            begin
                for right_idx := left_idx + 1 to High(exact_candidates) do
                begin
                    if exact_effective_weight(exact_candidates[right_idx]) >
                        exact_effective_weight(exact_candidates[left_idx]) then
                    begin
                        tmp := exact_candidates[left_idx];
                        exact_candidates[left_idx] := exact_candidates[right_idx];
                        exact_candidates[right_idx] := tmp;
                    end;
                end;
            end;
        end;
    begin
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (expected_units < 2) or (expected_units > 4) then
        begin
            Exit;
        end;

        has_exact_results := lookup_display_exact_cached(normalized_pinyin,
            exact_results);
        if not has_exact_results then
        begin
            Exit;
        end;

        SetLength(exact_candidates, 0);
        idx := 0;
        while idx <= High(exact_results) do
        begin
            if idx >= 16 then
            begin
                Break;
            end;
            candidate_text := Trim(exact_results[idx].text);
            candidate_units := get_candidate_text_unit_count(candidate_text);
            if (candidate_text = '') or (candidate_units <= 0) or
                (candidate_units <> expected_units) or
                (Trim(exact_results[idx].comment) <> '') or
                exact_text_already_selected(candidate_text) then
            begin
                Inc(idx);
                Continue;
            end;

            SetLength(exact_candidates, Length(exact_candidates) + 1);
            exact_candidates[High(exact_candidates)] := exact_results[idx];
            exact_candidates[High(exact_candidates)].text := candidate_text;
            exact_candidates[High(exact_candidates)].comment := '';
            Inc(idx);
        end;

        if Length(exact_candidates) = 0 then
        begin
            Exit;
        end;

        sort_exact_candidates_by_weight;
        if Length(exact_candidates) > 4 then
        begin
            SetLength(exact_candidates, 4);
        end;

        for idx := High(exact_candidates) downto 0 do
        begin
            picked := exact_candidates[idx];
            target_idx := 0;
            existing_idx := find_display_candidate(Trim(picked.text), '');
            if existing_idx >= 0 then
            begin
                move_display_candidate_to_index(existing_idx, target_idx);
            end
            else
            begin
                insert_display_candidate(picked, '', target_idx);
            end;
        end;
    end;

    procedure promote_recent_visible_choice_candidate;
    var
        idx: Integer;
        context_idx: Integer;
        context_bonus: Integer;
        best_context_bonus: Integer;
    begin
        if Length(m_candidates) = 0 then
        begin
            Exit;
        end;

        context_idx := -1;
        best_context_bonus := 0;
        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            context_bonus := get_context_query_latest_bonus(
                m_candidates[idx].text);
            if context_bonus > best_context_bonus then
            begin
                best_context_bonus := context_bonus;
                context_idx := idx;
            end;
        end;

        if context_idx >= 0 then
        begin
            move_display_candidate_to_front(context_idx);
            Exit;
        end;

        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx].comment) = '') and
                is_latest_session_query_choice(m_candidates[idx].text) then
            begin
                move_display_candidate_to_front(idx);
                Exit;
            end;
        end;
    end;

    procedure insert_tail_exact_completion_from_partial;
    const
        c_visible_probe_limit = 8;
        c_tail_probe_limit = 8;
    var
        idx: Integer;
        tail_key: string;
        tail_units: Integer;
        tail_results: TncCandidateList;
        tail_idx: Integer;
        head_text: string;
        head_units: Integer;
        tail_text: string;
        best_tail_text: string;
        best_tail_candidate: TncCandidate;
        best_tail_rank: Integer;
        tail_rank: Integer;
        repaired_text: string;
        existing_idx: Integer;
        target_idx: Integer;
        repaired_candidate: TncCandidate;
        repaired_path: string;
        repaired_rank: Integer;
        best_repaired_text: string;
        best_repaired_path: string;
        best_repaired_candidate: TncCandidate;
        best_repaired_rank: Integer;
        best_repaired_existing_idx: Integer;
        best_repaired_target_idx: Integer;

        function tail_key_is_controlled_modal_suffix_local(
            const key_value: string): Boolean;
        var
            normalized_key_value: string;
        begin
            normalized_key_value := normalize_pinyin_text(key_value);
            Result := SameText(normalized_key_value, 'de') or
                SameText(normalized_key_value, 'le') or
                SameText(normalized_key_value, 'la') or
                SameText(normalized_key_value, 'ba') or
                SameText(normalized_key_value, 'ma');
        end;

        function head_prefers_non_numeric_tail_local(
            const head_text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(head_text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(head_text_value[1]) of
                $4E0D, $6CA1, $65E0, $975E, $672A, $522B, $633A,
                $5F88, $592A, $6700, $66F4, $518D, $9AD8:
                    Result := True;
            end;
        end;

        function head_has_supported_segment_path_local(
            const candidate_idx: Integer): Boolean;
        var
            path_local: string;
            parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_pos_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            segment_key_local: string;
        begin
            Result := False;
            path_local := get_display_candidate_path_for_index(
                m_candidates[candidate_idx], candidate_idx);
            if get_encoded_path_segment_count_local(path_local) <= 1 then
            begin
                Exit;
            end;

            parts_local := path_local.Split([c_segment_path_separator]);
            segment_pos_local := 0;
            for part_idx_local := 0 to High(parts_local) do
            begin
                segment_text_local := Trim(parts_local[part_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) or
                    (segment_pos_local + segment_units_local > head_units) then
                begin
                    Exit(False);
                end;

                if segment_units_local >= 2 then
                begin
                    segment_key_local := build_display_query_key(
                        segment_pos_local, segment_units_local);
                    if display_exact_key_has_text(segment_key_local,
                        segment_text_local) then
                    begin
                        Exit(True);
                    end;
                end;
                Inc(segment_pos_local, segment_units_local);
            end;
        end;

        function head_matches_consumed_query_local(
            const candidate_idx: Integer): Boolean;
        var
            head_key_local: string;
        begin
            Result := False;
            if (head_units <= 0) or (head_units > expected_units) then
            begin
                Exit;
            end;

            if head_units = 1 then
            begin
                Exit(True);
            end;

            head_key_local := build_display_query_key(0, head_units);
            if (head_key_local <> '') and
                (m_dictionary.is_base_entry(head_key_local, head_text) or
                m_dictionary.is_user_entry(head_key_local, head_text)) then
            begin
                Exit(True);
            end;

            Result := head_has_supported_segment_path_local(candidate_idx);
        end;

        function is_productive_short_function_head_text_local(
            const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 2 then
            begin
                Exit;
            end;

            if SameText(text_value, string(Char($6709)) + string(Char($70B9))) or
                SameText(text_value, string(Char($4E00)) + string(Char($70B9))) or
                SameText(text_value, string(Char($4E0D)) + string(Char($662F))) or
                SameText(text_value, string(Char($4E0D)) + string(Char($4F1A))) or
                SameText(text_value, string(Char($4E0D)) + string(Char($80FD))) or
                SameText(text_value, string(Char($4E0D)) + string(Char($8981))) or
                SameText(text_value, string(Char($6CA1)) + string(Char($6709))) or
                SameText(text_value, string(Char($53EF)) + string(Char($4EE5))) or
                SameText(text_value, string(Char($5E94)) + string(Char($8BE5))) or
                SameText(text_value, string(Char($9700)) + string(Char($8981))) then
            begin
                Exit(True);
            end;
        end;

    begin
        if (m_dictionary = nil) or (expected_units < 3) or
            (expected_units > 5) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        best_repaired_text := '';
        best_repaired_path := '';
        best_repaired_rank := Low(Integer);
        best_repaired_existing_idx := -1;
        best_repaired_target_idx := 0;
        FillChar(best_repaired_candidate, SizeOf(best_repaired_candidate), 0);

        for idx := 0 to Min(c_visible_probe_limit - 1, High(m_candidates)) do
        begin
            tail_key := normalize_pinyin_text(Trim(m_candidates[idx].comment));
            if (tail_key = '') or (not is_full_pinyin_key(tail_key)) then
            begin
                Continue;
            end;

            head_text := Trim(m_candidates[idx].text);
            head_units := get_candidate_text_unit_count(head_text);
            tail_units := get_effective_compact_pinyin_unit_count(tail_key);
            if (tail_units < 2) or (tail_units > 4) or
                (Length(tail_key) > 16) or
                (head_units + tail_units <> expected_units) or
                (not lookup_display_complete_cached(tail_key,
                tail_results)) then
            begin
                Continue;
            end;
            if (head_units = 1) and (tail_units = 2) and
                (not is_display_one_plus_two_direct_complete_head_single(
                head_text)) then
            begin
                Continue;
            end;
            if (head_units >= 2) and
                (not head_matches_consumed_query_local(idx)) then
            begin
                Continue;
            end;

            best_tail_text := '';
            best_tail_rank := Low(Integer);
            FillChar(best_tail_candidate, SizeOf(best_tail_candidate), 0);
            for tail_idx := 0 to High(tail_results) do
            begin
                if tail_idx >= c_tail_probe_limit then
                begin
                    Break;
                end;
                tail_text := Trim(tail_results[tail_idx].text);
                if (Trim(tail_results[tail_idx].comment) <> '') or
                    (get_candidate_text_unit_count(tail_text) <> tail_units) then
                begin
                    Continue;
                end;

                tail_rank := display_candidate_effective_weight(
                    tail_results[tail_idx]);
                if head_prefers_non_numeric_tail_local(head_text) and
                    is_display_chinese_number_text(tail_text) then
                begin
                    Dec(tail_rank, 1200);
                end;
                if head_prefers_non_numeric_tail_local(head_text) and
                    is_display_repeated_unit_text(tail_text) then
                begin
                    Dec(tail_rank, 700);
                end;
                if (best_tail_text = '') or (tail_rank > best_tail_rank) then
                begin
                    best_tail_text := tail_text;
                    best_tail_candidate := tail_results[tail_idx];
                    best_tail_rank := tail_rank;
                end;
            end;

            if best_tail_text = '' then
            begin
                Continue;
            end;
            if (not tail_key_is_controlled_modal_suffix_local(tail_key)) and
                (not m_dictionary.is_base_entry(tail_key, best_tail_text)) and
                (not m_dictionary.is_user_entry(tail_key, best_tail_text)) then
            begin
                Continue;
            end;

            repaired_text := head_text + best_tail_text;
            if (expected_units = 4) and (head_units = 2) and
                (tail_units = 2) and
                (not display_exact_key_has_text(normalized_pinyin,
                repaired_text)) and
                (not is_productive_short_function_head_text_local(head_text)) then
            begin
                Continue;
            end;
            target_idx := 0;
            if (Length(m_candidates) > 0) and
                (Trim(m_candidates[0].comment) = '') and
                (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
                expected_units) and
                (not SameText(Trim(m_candidates[0].text),
                repaired_text)) then
            begin
                target_idx := 1;
            end;
            existing_idx := find_display_candidate(repaired_text, '');

            repaired_candidate := m_candidates[idx];
            repaired_candidate.text := repaired_text;
            repaired_candidate.comment := '';
            repaired_candidate.source := cs_rule;
            repaired_candidate.has_dict_weight := best_tail_candidate.has_dict_weight;
            repaired_candidate.dict_weight := best_tail_candidate.dict_weight;
            repaired_candidate.score := Max(m_candidates[idx].score,
                best_tail_candidate.score) + 16000;
            repaired_path := head_text + c_segment_path_separator +
                best_tail_text;
            repaired_rank := display_candidate_effective_weight(
                repaired_candidate) + best_tail_rank;
            if head_units = 1 then
            begin
                Inc(repaired_rank, 6000);
            end
            else if head_has_supported_segment_path_local(idx) then
            begin
                Inc(repaired_rank, 10000);
            end;
            Inc(repaired_rank, get_display_fixed_tail_alignment_score_outer(
                repaired_candidate));
            Inc(repaired_rank, get_display_fixed_quantity_alignment_score_outer(
                repaired_candidate));
            if (best_repaired_text = '') or
                (repaired_rank > best_repaired_rank) then
            begin
                best_repaired_text := repaired_text;
                best_repaired_path := repaired_path;
                best_repaired_candidate := repaired_candidate;
                best_repaired_rank := repaired_rank;
                best_repaired_existing_idx := existing_idx;
                best_repaired_target_idx := target_idx;
            end;
        end;

        if best_repaired_text <> '' then
        begin
            if best_repaired_existing_idx >= 0 then
            begin
                move_display_candidate_to_index(best_repaired_existing_idx,
                    best_repaired_target_idx);
            end
            else
            begin
                insert_display_candidate(best_repaired_candidate,
                    best_repaired_path, best_repaired_target_idx);
            end;
            if Pos('prefdirect=1', m_last_lookup_debug_extra) <= 0 then
            begin
                m_last_lookup_debug_extra :=
                    Trim(m_last_lookup_debug_extra + ' prefdirect=1');
            end;
        end;
    end;

