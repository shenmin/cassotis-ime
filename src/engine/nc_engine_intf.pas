            end;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (expected_units < 4) or
            (expected_units > 6) or (Length(syllables) <> expected_units) or
            (Trim(candidate_value.comment) <> '') then
        begin
            Exit;
        end;

        units_local := split_text_units(Trim(candidate_value.text));
        if (Length(units_local) <> expected_units) or
            (not is_pronoun_local(units_local[0])) or
            (not is_connector_local(units_local[1])) or
            (not m_dictionary.single_char_matches_pinyin(
            normalize_pinyin_text(syllables[0].text), units_local[0])) or
            (not m_dictionary.single_char_matches_pinyin(
            normalize_pinyin_text(syllables[1].text), units_local[1])) then
        begin
            Exit;
        end;

        tail_key_local := build_display_query_key(2, expected_units - 2);
        tail_text_local := '';
        for tail_unit_idx_local := 2 to High(units_local) do
        begin
            tail_text_local := tail_text_local + units_local[tail_unit_idx_local];
        end;
        Result := display_exact_key_has_text(tail_key_local, tail_text_local) or
            m_dictionary.is_base_entry(tail_key_local, tail_text_local) or
            m_dictionary.is_user_entry(tail_key_local, tail_text_local);
    end;

