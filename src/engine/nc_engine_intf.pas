        function candidate_has_pronoun_connector_tail_split_support_local(
            const candidate: TncCandidate): Boolean;
        var
            units_local: TArray<string>;
            syllables_local: TncPinyinParseResult;
            exact_tail_results_local: TncCandidateList;
            exact_tail_idx_local: Integer;
            tail_unit_idx_local: Integer;
            pronoun_text_local: string;
            connector_text_local: string;
            tail_text_local: string;
            tail_key_local: string;
            ignored_preferred_local: Boolean;

            function is_pronoun_local(const value: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(value) <> 1 then
                begin
                    Exit;
                end;
                case Ord(value[1]) of
                    $6211, $4F60, $60A8, $4ED6, $5979, $5B83, $54B1, $4FFA:
                        Result := True;
                end;
            end;

            function is_connector_local(const value: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(value) <> 1 then
                begin
                    Exit;
                end;
                case Ord(value[1]) of
                    $8DDF, $548C, $4E0E, $540C:
                        Result := True;
                end;
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (expected_units < 4) or
                (expected_units > 6) or
                (Trim(candidate.comment) <> '') then
            begin
                Exit;
            end;

            // Validate the fixed boundary directly from the query and text.
            // The candidate path cache may legitimately retain another inferred
            // segmentation, but that must not hide a fully lexicon-backed tail.
            units_local := split_text_units(Trim(candidate.text));
            if Length(units_local) <> expected_units then
            begin
                Exit;
            end;

            pronoun_text_local := Trim(units_local[0]);
            connector_text_local := Trim(units_local[1]);
            tail_text_local := '';
            for tail_unit_idx_local := 2 to High(units_local) do
            begin
                tail_text_local := tail_text_local + Trim(
                    units_local[tail_unit_idx_local]);
            end;
            if (not is_pronoun_local(pronoun_text_local)) or
                (not is_connector_local(connector_text_local)) or
                (get_candidate_text_unit_count(tail_text_local) <>
                expected_units - 2) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(lookup_text));
            if (Length(syllables_local) <> expected_units) or
                (not match_single_char_candidate_for_syllable(
                normalize_pinyin_text(syllables_local[0].text),
                pronoun_text_local, ignored_preferred_local)) or
                (not match_single_char_candidate_for_syllable(
                normalize_pinyin_text(syllables_local[1].text),
                connector_text_local, ignored_preferred_local)) then
            begin
                Exit;
            end;

            tail_key_local := '';
            for tail_unit_idx_local := 2 to High(syllables_local) do
            begin
                tail_key_local := tail_key_local + normalize_pinyin_text(
                    syllables_local[tail_unit_idx_local].text);
            end;
            if m_dictionary.is_base_entry(tail_key_local, tail_text_local) or
                m_dictionary.is_user_entry(tail_key_local, tail_text_local) then
            begin
                Exit(True);
            end;
            if not lookup_exact_full_pinyin_cached_local(tail_key_local,
                exact_tail_results_local) then
            begin
                Exit;
            end;
            for exact_tail_idx_local := 0 to High(exact_tail_results_local) do
            begin
                if (Trim(exact_tail_results_local[exact_tail_idx_local].comment) = '') and
                    SameText(Trim(exact_tail_results_local[
                    exact_tail_idx_local].text), tail_text_local) and
                    (get_candidate_text_unit_count(tail_text_local) =
                    expected_units - 2) then
                begin
                    Exit(True);
                end;
            end;
        end;

