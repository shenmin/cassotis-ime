                    SameText(unit_text, string(Char($533A))) or
                    SameText(unit_text, string(Char($5E02))) or
                    SameText(unit_text, string(Char($6751))) or
                    SameText(unit_text, string(Char($9547))) or
                    SameText(unit_text, string(Char($53BF))) or
                    SameText(unit_text, string(Char($8DEF))) or
                    SameText(unit_text, string(Char($8857))) or
                    SameText(unit_text, string(Char($6865))) or
                    SameText(unit_text, string(Char($6CB3))) or
                    SameText(unit_text, string(Char($6D77))) or
                    SameText(unit_text, string(Char($5C71))) or
                    SameText(unit_text, string(Char($5C9B))) or
                    SameText(unit_text, string(Char($95E8))) or
                    SameText(unit_text, string(Char($5385))) or
                    SameText(unit_text, string(Char($5BA4))) or
                    SameText(unit_text, string(Char($623F))) or
                    SameText(unit_text, string(Char($5BB6))) or
                    SameText(unit_text, string(Char($516C))) or
                    SameText(unit_text, string(Char($5BD3)));
            end;
        begin
            Result := 0;
            if (candidate_idx < 0) or
                (candidate_idx >= Length(m_candidates)) then
            begin
                Exit;
            end;

            path_local := '';
            if candidate_idx < Length(m_candidate_segment_paths) then
            begin
                path_local := Trim(m_candidate_segment_paths[candidate_idx]);
            end;
            if path_local = '' then
            begin
                path_local := Trim(get_segment_path_for_candidate(
                    m_candidates[candidate_idx], candidate_idx));
            end;
            if path_local = '' then
            begin
                path_local := infer_segment_path_for_query_text_with_score(
                    normalized_pinyin, Trim(m_candidates[candidate_idx].text),
                    inferred_score_local, inferred_count_local);
            end;
            if get_encoded_path_segment_count_local(path_local) <= 1 then
            begin
                Exit;
            end;

            parts_local := path_local.Split([c_segment_path_separator]);
            segment_start_local := 0;
            low_multi_exact_run_local := 0;
            low_run_after_high_multi_local := False;
            previous_high_multi_local := False;
            for part_idx_local := 0 to High(parts_local) do
            begin
                segment_text_local := Trim(parts_local[part_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) then
                begin
                    Exit;
                end;

                next_segment_text_local := '';
                next_next_segment_text_local := '';
                next_units_local := 0;
                next_next_units_local := 0;
                next_first_unit_local := '';
                next_last_unit_local := '';
                next_is_verbal_local := False;
                if part_idx_local < High(parts_local) then
                begin
                    next_segment_text_local := Trim(parts_local[part_idx_local + 1]);
                    next_units_local := get_candidate_text_unit_count(
                        next_segment_text_local);
                    next_first_unit_local := get_first_text_unit_local(
                        next_segment_text_local);
                    next_last_unit_local := get_last_text_unit_local(
                        next_segment_text_local);
                    next_is_verbal_local :=
                        is_likely_verbal_unit_local(next_first_unit_local);
                end;
                if part_idx_local + 1 < High(parts_local) then
                begin
                    next_next_segment_text_local :=
                        Trim(parts_local[part_idx_local + 2]);
                    next_next_units_local := get_candidate_text_unit_count(
                        next_next_segment_text_local);
                end;

                segment_first_unit_local := get_first_text_unit_local(
                    segment_text_local);
                segment_last_unit_local := get_last_text_unit_local(
                    segment_text_local);
                segment_weight_local := 0;
                segment_has_exact_weight_local := False;
                current_high_multi_local := False;
                if segment_units_local >= 2 then
                begin
                    segment_key_local := build_display_query_key(
                        segment_start_local, segment_units_local);
                    segment_has_exact_weight_local :=
                        (segment_key_local <> '') and
                        try_get_particle_exact_weight_local(segment_key_local,
                        segment_text_local, segment_units_local,
                        segment_weight_local);
                    current_high_multi_local :=
                        ((segment_units_local >= 4) or
                        (segment_has_exact_weight_local and
                        (segment_units_local >= 3) and
                        (segment_weight_local >= 900)));
                    if (not segment_has_exact_weight_local) or
                        (segment_weight_local < 700) then
                    begin
                        if low_multi_exact_run_local = 0 then
                        begin
                            low_run_after_high_multi_local :=
                                previous_high_multi_local;
                        end;
                        Inc(low_multi_exact_run_local);
                        if low_run_after_high_multi_local and
                            (low_multi_exact_run_local >= 2) then
                        begin
                            Dec(Result, 26000 +
                                ((low_multi_exact_run_local - 2) * 8000));
                        end;
                    end
                    else
                    begin
                        low_multi_exact_run_local := 0;
                        low_run_after_high_multi_local := False;
                    end;
                    if current_high_multi_local then
                    begin
                        Inc(Result, 16000);
                    end;
                    if segment_has_exact_weight_local then
                    begin
                        if segment_units_local = 2 then
                        begin
                            if segment_weight_local >= 900 then
                            begin
                                Inc(Result, 11000);
                            end
                            else if segment_weight_local >= 700 then
                            begin
                                Inc(Result, 8000);
                            end
                            else if segment_weight_local >= 520 then
                            begin
                                Inc(Result, 4200);
                            end
                            else if segment_weight_local < 460 then
                            begin
                                Dec(Result, 6200);
                            end;
                        end
                        else if (segment_units_local >= 3) and
                            (segment_weight_local >= 700) then
                        begin
                            Inc(Result, 7000 + Min(5000, segment_weight_local * 2));
                        end;
                    end;
                    if (segment_units_local = 2) and
                        is_directional_location_head_local(segment_first_unit_local) and
                        SameText(segment_last_unit_local, string(Char($9762))) and
                        (next_units_local = 1) and
                        SameText(next_first_unit_local, string(Char($7684))) then
                    begin
                        Inc(Result, 18000);
                    end;
                end
                else
                begin
                    low_multi_exact_run_local := 0;
                    low_run_after_high_multi_local := False;
                end;

                if segment_units_local = 1 then
                begin
                    if (next_segment_text_local <> '') and (next_units_local >= 2) then
                    begin
                        if SameText(segment_last_unit_local, string(Char($5BF9))) then
                        begin
                            Inc(Result, 14000);
                        end
                        else if is_path_pronoun_unit_local(segment_last_unit_local) and
                            is_path_predicate_or_modifier_head_local(next_first_unit_local) then
                        begin
                            Inc(Result, 9000);
                        end
                        else if SameText(segment_last_unit_local, string(Char($66F4))) and
                            SameText(next_first_unit_local, string(Char($4E3A))) then
                        begin
                            Inc(Result, 12000);
                        end
                        else if SameText(segment_last_unit_local, string(Char($53BB))) and
                            is_place_like_tail_unit_local(next_last_unit_local) then
                        begin
                            Inc(Result, 14000);
                        end;
                    end
                    else if (next_units_local = 1) and
                        (next_next_segment_text_local <> '') and (next_next_units_local >= 2) then
                    begin
                        if SameText(segment_last_unit_local, string(Char($5E76))) and
                            SameText(next_first_unit_local, string(Char($4E0D))) then
                        begin
                            Inc(Result, 16000);
                        end;
                    end;
                end;

                if (segment_units_local > 1) and (next_units_local >= 2) and
                    SameText(segment_last_unit_local, string(Char($53BB))) and
                    is_place_like_tail_unit_local(next_last_unit_local) then
                begin
                    Inc(Result, 14000);
                end;

                if SameText(segment_last_unit_local, string(Char($5730))) then
                begin
                    if (segment_units_local >= 2) and
                        (next_units_local >= 2) and
                        ((not segment_has_exact_weight_local) or
                        (segment_weight_local < 700)) then
                    begin
                        Dec(Result, 18000);
                    end
                    else if next_is_verbal_local then
                    begin
                        Inc(Result, 6000);
                    end
                    else if next_segment_text_local <> '' then
                    begin
                        Dec(Result, 8000);
                    end;
                end
                else if SameText(segment_last_unit_local, string(Char($7684))) then
                begin
                    if segment_units_local = 1 then
                    begin
                        if next_units_local >= 2 then
                        begin
                            if (next_next_segment_text_local = '') or
                                (next_next_units_local >= 2) then
                            begin
                                Inc(Result, 12000);
                            end;
                            if (next_next_units_local = 1) and
                                SameText(get_first_text_unit_local(
                                next_next_segment_text_local),
                                string(Char($662F))) then
                            begin
                                Dec(Result, 12000);
                            end;
                            next_weight_local := 0;
                            next_key_local := build_display_query_key(
                                segment_start_local + segment_units_local,
                                next_units_local);
                            next_has_exact_weight_local := (next_key_local <> '') and
                                (next_segment_text_local <> '') and
                                try_get_particle_exact_weight_local(next_key_local,
                                next_segment_text_local, next_units_local,
                                next_weight_local);
                            if next_has_exact_weight_local and
                                (next_weight_local >= 900) and
                                ((next_next_segment_text_local = '') or
                                (next_next_units_local >= 2)) then
                            begin
                                Inc(Result, 14000);
                            end;
                        end;
                    end
                    else if next_is_verbal_local then
                    begin
                        Dec(Result, 10000);
                    end
                    else if next_segment_text_local <> '' then
                    begin
                        Inc(Result, 3000);
                    end;
                end
                else if SameText(segment_last_unit_local, string(Char($5F97))) then
                begin
                    if next_segment_text_local = '' then
                    begin
                        Dec(Result, 7000);
                    end
                    else if (segment_units_local >= 2) and
                        (next_units_local >= 2) and
                        is_likely_result_complement_head_unit_local(
                        next_first_unit_local) then
                    begin
                        Inc(Result, 14000);
                    end
                    else if (segment_units_local >= 2) and (next_units_local >= 2) then
                    begin
                        Dec(Result, 10000);
                    end;
                end;

                Inc(segment_start_local, segment_units_local);
                previous_high_multi_local := current_high_multi_local;
            end;
        end;

        function particle_candidate_context_score_local(
            const candidate_idx: Integer; const candidate_text_value: string): Integer;
        begin
            Result := particle_text_context_score_local(candidate_text_value) +
                particle_path_context_score_local(candidate_idx);
        end;
    begin
        if (expected_units < c_min_long_units) or (Length(m_candidates) <= 1) then
        begin
            Exit;
        end;

        particle_exact_weight_cache := TDictionary<string, Integer>.Create;
        try
            top_is_complete := is_complete_display_candidate_local(m_candidates[0]);
            top_score := complete_candidate_rank_score(m_candidates[0]) +
                particle_candidate_context_score_local(0,
                Trim(m_candidates[0].text));
            best_idx := -1;
            best_score := Low(Integer);
            probe_limit := Min(c_probe_limit - 1, High(m_candidates));
            for idx := 1 to probe_limit do
            begin
                if not is_complete_display_candidate_local(m_candidates[idx]) then
                begin
                    Continue;
                end;
                if require_structural_signal and
                    (not candidate_has_structural_path_signal_local(idx)) then
                begin
                    Continue;
                end;

                candidate_text := Trim(m_candidates[idx].text);
                if candidate_text = '' then
                begin
                    Continue;
                end;

                candidate_score := complete_candidate_rank_score(m_candidates[idx]) +
                    particle_candidate_context_score_local(idx, candidate_text);
                if (best_idx < 0) or (candidate_score > best_score) then
                begin
                    best_idx := idx;
                    best_score := candidate_score;
                end;
            end;

            if best_idx <= 0 then
            begin
                Exit;
            end;

            if top_is_complete then
            begin
                if best_score < top_score + c_complete_over_complete_margin then
                begin
                    Exit;
                end;
            end
            else if best_score < top_score + c_complete_over_partial_margin then
            begin
                Exit;
            end;

            force_move_display_candidate_to_index(best_idx, 0);
        finally
            particle_exact_weight_cache.Free;
        end;
    end;

    procedure promote_higher_rank_complete_long_candidate_final;
    const
        c_probe_limit = 8;
        c_min_units = 7;
        c_min_rank_margin = 128;
    var
        idx: Integer;
        probe_limit: Integer;
        top_units_local: Integer;
        top_rank_local: Integer;
        candidate_units_local: Integer;
        candidate_rank_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;

        function complete_candidate_rank_local(
            const candidate_value: TncCandidate): Integer;
        begin
            Result := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;
        end;
    begin
        if Length(m_candidates) <= 1 then
        begin
            Exit;
        end;

        if Trim(m_candidates[0].comment) <> '' then
        begin
            Exit;
        end;
        top_units_local := get_candidate_text_unit_count(
            Trim(m_candidates[0].text));
        if top_units_local < c_min_units then
        begin
            Exit;
        end;

        top_rank_local := complete_candidate_rank_local(m_candidates[0]);
        best_idx_local := -1;
        best_rank_local := top_rank_local;
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;
            candidate_units_local := get_candidate_text_unit_count(
                Trim(m_candidates[idx].text));
            if candidate_units_local <> top_units_local then
            begin
                Continue;
            end;

            candidate_rank_local := complete_candidate_rank_local(
                m_candidates[idx]);
            if candidate_rank_local >= best_rank_local + c_min_rank_margin then
            begin
                best_idx_local := idx;
                best_rank_local := candidate_rank_local;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    function get_display_candidate_path_for_index(
        const candidate_value: TncCandidate; const candidate_idx: Integer): string;
    var
        inferred_score_local: Integer;
        inferred_count_local: Integer;
    begin
        Result := '';
        if (candidate_idx >= 0) and
            (candidate_idx < Length(m_candidate_segment_paths)) then
        begin
            Result := m_candidate_segment_paths[candidate_idx];
        end;
        if Result = '' then
        begin
            Result := get_segment_path_for_candidate(candidate_value,
                candidate_idx);
        end;
        if (Result = '') and (normalized_pinyin <> '') then
        begin
            Result := infer_segment_path_for_query_text_with_score(
                normalized_pinyin, Trim(candidate_value.text),
            inferred_score_local, inferred_count_local);
        end;
    end;

    function get_display_complete_exact_span_coverage_score(
        const candidate_value: TncCandidate): Integer;
    const
        c_max_span_units = 5;
        c_min_span_weight = 120;
    var
        cache_key_local: string;
        units_local: TArray<string>;
        occupied_local: TArray<Boolean>;
        span_len_local: Integer;
        start_idx_local: Integer;
        unit_idx_local: Integer;
        query_key_local: string;
        span_text_local: string;
        span_weight_local: Integer;
        overlaps_local: Boolean;
    begin
        Result := 0;
        if (expected_units < 6) or (Trim(candidate_value.comment) <> '') then
        begin
            Exit;
        end;

        units_local := split_text_units(Trim(candidate_value.text));
        if Length(units_local) <> expected_units then
        begin
            Exit;
        end;
        cache_key_local := 'span' + #1 + normalized_pinyin + #1 +
            Trim(candidate_value.text);
        if (m_lookup_display_feature_cache <> nil) and
            m_lookup_display_feature_cache.TryGetValue(cache_key_local,
            Result) then
        begin
            Exit;
        end;

        SetLength(occupied_local, Length(units_local));
        for span_len_local := Min(c_max_span_units, expected_units) downto 2 do
        begin
            for start_idx_local := 0 to expected_units - span_len_local do
            begin
                overlaps_local := False;
                for unit_idx_local := start_idx_local to
                    start_idx_local + span_len_local - 1 do
                begin
                    if occupied_local[unit_idx_local] then
                    begin
                        overlaps_local := True;
                        Break;
                    end;
                end;
                if overlaps_local then
                begin
                    Continue;
                end;

                query_key_local := build_display_query_key(start_idx_local,
                    span_len_local);
                span_text_local := '';
                for unit_idx_local := start_idx_local to
                    start_idx_local + span_len_local - 1 do
                begin
                    span_text_local := span_text_local + units_local[unit_idx_local];
                end;

                if (query_key_local <> '') and
                    get_display_exact_text_weight(query_key_local,
                    span_text_local, span_len_local, span_weight_local) and
                    (span_weight_local >= c_min_span_weight) then
                begin
                    Inc(Result, span_len_local * span_len_local * 800 +
                        span_weight_local * span_len_local);
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        occupied_local[unit_idx_local] := True;
                    end;
                end;
            end;
        end;
        if m_lookup_display_feature_cache <> nil then
        begin
            m_lookup_display_feature_cache.AddOrSetValue(cache_key_local,
                Result);
        end;
    end;

    function display_candidate_replaces_protected_conjunction_boundary(
        const candidate_value: TncCandidate): Boolean;
    const
        c_max_neighbor_units = 4;
    var
        top_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        diff_idx_local: Integer;

        function is_protected_conjunction_unit_local(
            const unit_value: string): Boolean;
        begin
            Result := False;
            if Length(unit_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(unit_value[1]) of
                $548C, $4E0E, $800C, $53CA, $6216, $5E76, $4E14:
                    Result := True;
            end;
        end;

        function join_units_range_local(const units_value: TArray<string>;
            const local_start_idx: Integer; const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len > Length(units_value)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to local_start_idx + local_span_len - 1 do
            begin
                Result := Result + units_value[local_idx];
            end;
        end;

        function top_exact_neighbor_exists_local(const local_start_idx: Integer;
            const local_span_len: Integer): Boolean;
        var
            query_key_local: string;
            text_local: string;
            weight_local: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or (local_span_len < 2) or
                (local_start_idx + local_span_len > Length(top_units_local)) then
            begin
                Exit;
            end;

            query_key_local := build_display_query_key(local_start_idx,
                local_span_len);
            text_local := join_units_range_local(top_units_local,
                local_start_idx, local_span_len);
            Result := (query_key_local <> '') and (text_local <> '') and
                get_display_exact_text_weight(query_key_local, text_local,
                local_span_len, weight_local) and (weight_local > 0);
        end;

        function has_protected_neighbor_local(const local_idx: Integer): Boolean;
        var
            span_len_local: Integer;
        begin
            Result := False;
            for span_len_local := 2 to c_max_neighbor_units do
            begin
                if top_exact_neighbor_exists_local(local_idx + 1,
                    span_len_local) or
                    top_exact_neighbor_exists_local(local_idx - span_len_local,
                    span_len_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        Result := False;
        top_units_local := split_text_units(Trim(m_candidates[0].text));
        candidate_units_local := split_text_units(Trim(candidate_value.text));
        if (Length(top_units_local) <> expected_units) or
            (Length(candidate_units_local) <> expected_units) then
        begin
            Exit;
        end;

        for diff_idx_local := 0 to expected_units - 1 do
        begin
            if (diff_idx_local = 0) or
                SameText(top_units_local[diff_idx_local],
                candidate_units_local[diff_idx_local]) or
                (not is_protected_conjunction_unit_local(
                top_units_local[diff_idx_local])) or
                is_display_function_or_modifier_single(
                candidate_units_local[diff_idx_local]) then
            begin
                Continue;
            end;

            if has_protected_neighbor_local(diff_idx_local) then
            begin
                Exit(True);
            end;
        end;
    end;

    procedure promote_better_exact_span_covered_complete_candidate;
    const
        c_probe_limit = 5;
        c_min_coverage_gain = 1200;
        c_max_score_deficit = 120000;
        c_min_protected_exact_weight = 700;
        c_protected_exact_margin = 80;
    var
        idx_local: Integer;
        best_idx_local: Integer;
        top_score_local: Integer;
        top_coverage_local: Integer;
        candidate_score_local: Integer;
        candidate_coverage_local: Integer;
        best_metric_local: Integer;
        candidate_metric_local: Integer;

        function candidate_replaces_stronger_same_position_exact_span(
            const candidate_value: TncCandidate): Boolean;
        const
            c_max_span_units = 5;
        var
            top_units_local: TArray<string>;
            candidate_units_local: TArray<string>;
            span_len_local: Integer;
            start_idx_local: Integer;
            unit_idx_local: Integer;
            query_key_local: string;
            top_span_text_local: string;
            candidate_span_text_local: string;
            top_span_weight_local: Integer;
            candidate_span_weight_local: Integer;
            span_touches_diff_local: Boolean;

            function join_units_range_local(const units_value: TArray<string>;
                const local_start_idx: Integer; const local_span_len: Integer): string;
            var
                local_idx: Integer;
            begin
                Result := '';
                if (local_start_idx < 0) or (local_span_len <= 0) or
                    (local_start_idx + local_span_len > Length(units_value)) then
                begin
                    Exit;
                end;

                for local_idx := local_start_idx to
                    local_start_idx + local_span_len - 1 do
                begin
                    Result := Result + units_value[local_idx];
                end;
            end;

        begin
            Result := False;
            top_units_local := split_text_units(Trim(m_candidates[0].text));
            candidate_units_local := split_text_units(Trim(candidate_value.text));
            if (Length(top_units_local) <> expected_units) or
                (Length(candidate_units_local) <> expected_units) then
            begin
                Exit;
            end;

            for span_len_local := Min(c_max_span_units, expected_units) downto 2 do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    span_touches_diff_local := False;
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        if not SameText(top_units_local[unit_idx_local],
                            candidate_units_local[unit_idx_local]) then
                        begin
                            span_touches_diff_local := True;
                            Break;
                        end;
                    end;
                    if not span_touches_diff_local then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(start_idx_local,
                        span_len_local);
                    top_span_text_local := join_units_range_local(top_units_local,
                        start_idx_local, span_len_local);
                    candidate_span_text_local := join_units_range_local(
                        candidate_units_local, start_idx_local, span_len_local);
                    if SameText(top_span_text_local, candidate_span_text_local) then
                    begin
                        Continue;
                    end;

                    top_span_weight_local := 0;
                    candidate_span_weight_local := 0;
                    if (query_key_local <> '') and
                        get_display_exact_text_weight(query_key_local,
                        top_span_text_local, span_len_local,
                        top_span_weight_local) and
                        get_display_exact_text_weight(query_key_local,
                        candidate_span_text_local, span_len_local,
                        candidate_span_weight_local) and
                        (top_span_weight_local >= c_min_protected_exact_weight) and
                        (top_span_weight_local >= candidate_span_weight_local +
                        c_protected_exact_margin) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;
    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 6) or
            (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_score_local := m_candidates[0].score;
        top_coverage_local :=
            get_display_complete_exact_span_coverage_score(m_candidates[0]);
        best_idx_local := -1;
        best_metric_local := top_coverage_local + top_score_local div 12;

        for idx_local := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx_local].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_coverage_local :=
                get_display_complete_exact_span_coverage_score(
                m_candidates[idx_local]);
            if candidate_coverage_local < top_coverage_local +
                c_min_coverage_gain then
            begin
                Continue;
            end;
            if candidate_replaces_stronger_same_position_exact_span(
                m_candidates[idx_local]) then
            begin
                Continue;
            end;
            if display_candidate_replaces_protected_conjunction_boundary(
                m_candidates[idx_local]) then
            begin
                Continue;
            end;

            candidate_score_local := m_candidates[idx_local].score;
            if candidate_score_local + c_max_score_deficit < top_score_local then
            begin
                Continue;
            end;

            candidate_metric_local := candidate_coverage_local +
                candidate_score_local div 12;
            if candidate_metric_local > best_metric_local then
            begin
                best_metric_local := candidate_metric_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    function get_diff_exact_span_advantage_against_top(
        const candidate_value: TncCandidate): Integer;
    const
        c_max_span_units = 5;
        c_min_span_weight = 120;
    var
        top_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        span_len_local: Integer;
        start_idx_local: Integer;
        unit_idx_local: Integer;
        query_key_local: string;
        top_span_text_local: string;
        candidate_span_text_local: string;
        top_span_weight_local: Integer;
        candidate_span_weight_local: Integer;
        span_touches_diff_local: Boolean;

        function join_units_range_local(const units_value: TArray<string>;
            const local_start_idx: Integer; const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len > Length(units_value)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + units_value[local_idx];
            end;
        end;

        function exact_span_weight_or_zero_local(const query_key_value: string;
            const text_value: string; const span_len_value: Integer): Integer;
        begin
            Result := 0;
            if (query_key_value = '') or (text_value = '') then
            begin
                Exit;
            end;

            if not get_display_exact_text_weight(query_key_value, text_value,
                span_len_value, Result) then
            begin
                Result := 0;
            end;
            if Result < c_min_span_weight then
            begin
                Result := 0;
            end;
        end;

        function top_neighbor_exact_phrase_exists_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            local_query_key: string;
            local_text: string;
        begin
            Result := False;
            if (local_start_idx < 0) or (local_span_len < 2) or
                (local_start_idx + local_span_len > Length(top_units_local)) then
            begin
                Exit;
            end;

            local_query_key := build_display_query_key(local_start_idx,
                local_span_len);
            local_text := join_units_range_local(top_units_local,
                local_start_idx, local_span_len);
            Result := exact_span_weight_or_zero_local(local_query_key,
                local_text, local_span_len) > 0;
        end;

        function top_has_protected_function_boundary_at_diff_local(
            const diff_idx_value: Integer): Boolean;
        var
            local_len: Integer;
        begin
            Result := False;
            if (diff_idx_value < 0) or
                (diff_idx_value >= Length(top_units_local)) or
                (not is_display_function_or_modifier_single(
                top_units_local[diff_idx_value])) then
            begin
                Exit;
            end;

            for local_len := 2 to 4 do
            begin
                if top_neighbor_exact_phrase_exists_local(diff_idx_value + 1,
                    local_len) or
                    top_neighbor_exact_phrase_exists_local(diff_idx_value -
                    local_len, local_len) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function candidate_span_crosses_protected_top_boundary_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                if (not SameText(top_units_local[local_idx],
                    candidate_units_local[local_idx])) and
                    top_has_protected_function_boundary_at_diff_local(
                    local_idx) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        Result := 0;
        if short_exact_query_mode or (expected_units < 6) or
            (Length(m_candidates) < 2) or (Trim(m_candidates[0].comment) <> '') or
            (Trim(candidate_value.comment) <> '') then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        candidate_units_local := split_text_units(Trim(candidate_value.text));
        if (Length(top_units_local) <> expected_units) or
            (Length(candidate_units_local) <> expected_units) then
        begin
            Exit;
        end;

        for span_len_local := Min(c_max_span_units, expected_units) downto 2 do
        begin
            for start_idx_local := 0 to expected_units - span_len_local do
            begin
                span_touches_diff_local := False;
                for unit_idx_local := start_idx_local to
                    start_idx_local + span_len_local - 1 do
                begin
                    if not SameText(top_units_local[unit_idx_local],
                        candidate_units_local[unit_idx_local]) then
                    begin
                        span_touches_diff_local := True;
                        Break;
                    end;
                end;
                if not span_touches_diff_local then
                begin
                    Continue;
                end;

                query_key_local := build_display_query_key(start_idx_local,
                    span_len_local);
                top_span_text_local := join_units_range_local(top_units_local,
                    start_idx_local, span_len_local);
                candidate_span_text_local := join_units_range_local(
                    candidate_units_local, start_idx_local, span_len_local);
                top_span_weight_local := exact_span_weight_or_zero_local(
                    query_key_local, top_span_text_local, span_len_local);
                candidate_span_weight_local := exact_span_weight_or_zero_local(
                    query_key_local, candidate_span_text_local, span_len_local);

                if (candidate_span_weight_local > 0) and
                    (top_span_weight_local = 0) then
                begin
                    if not candidate_span_crosses_protected_top_boundary_local(
                        start_idx_local, span_len_local) then
                    begin
                        Inc(Result, span_len_local * span_len_local * 2200 +
                            Min(10000, candidate_span_weight_local *
                            span_len_local));
                    end;
                end
                else if (candidate_span_weight_local = 0) and
                    (top_span_weight_local > 0) then
                begin
                    Dec(Result, span_len_local * span_len_local * 2200 +
                        Min(10000, top_span_weight_local * span_len_local));
                end
                else if (candidate_span_weight_local > 0) and
                    (top_span_weight_local > 0) and
                    (candidate_span_weight_local >= top_span_weight_local + 120) then
                begin
                    Inc(Result, span_len_local * span_len_local * 1800 +
                        Min(12000, (candidate_span_weight_local -
                        top_span_weight_local) * span_len_local * 6));
                end;
            end;
        end;
    end;

    procedure promote_complete_candidate_with_better_diff_exact_spans;
