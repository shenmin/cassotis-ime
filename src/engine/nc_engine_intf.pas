                        $7ED9, $5BF9, $4ECE, $5411, $4E0E, $90FD, $8FD8,
                        $624D, $5C31, $53EA, $522B, $5DF2, $5C06, $53EF,
                        $60F3, $65E0, $975E, $672A, $4ECD, $591A, $5C11,
                        $65B0, $8001, $5C0F, $5927, $5168, $8D85, $771F,
                        $597D, $5982, $633A, $8F83, $6781, $800C, $5E76:
