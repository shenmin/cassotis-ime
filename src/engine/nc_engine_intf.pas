            case Ord(units_local[0][1]) of
                $4E00, $4E8C, $4E24, $4E09, $56DB, $4E94, $516D,
                $4E03, $516B, $4E5D, $5341:
                    ;
            else
                Exit(False);
            end;

            case Ord(units_local[1][1]) of
                $5B57, $9879, $6761, $4E2A, $70B9, $79CD, $7C7B,
                $6B21, $6B65, $8F6E, $7AE0, $8282, $9875, $6BB5,
                $884C, $5217, $5C42:
                    Result := True;
            else
                Result := False;
            end;
        end;

        function is_chinese_number_text_unit_local(const value: string): Boolean;
        begin
            Result := False;
            if Length(value) <> 1 then
            begin
                Exit;
            end;

            case Ord(value[1]) of
                $4E00, $4E8C, $4E24, $4E09, $56DB, $4E94, $516D,
                $4E03, $516B, $4E5D, $5341, $767E, $5343, $4E07,
                $4EBF:
                    Result := True;
            end;
        end;

        function get_function_tail_quality_penalty_local(
            const head_value: string; const tail_value: string): Integer;
        var
            units_local: TArray<string>;
        begin
            Result := 0;
            if SameText(head_value, string(Char($7B2C))) then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(tail_value));
            if Length(units_local) <> 2 then
            begin
                Exit;
            end;

            if is_chinese_number_text_unit_local(units_local[0]) and
                is_chinese_number_text_unit_local(units_local[1]) then
            begin
                Inc(Result, 6000);
            end;
            if SameText(units_local[0], units_local[1]) then
            begin
                Inc(Result, 3000);
            end;
        end;

