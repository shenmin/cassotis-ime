        function try_get_best_sentence_phrase_weight_local(const query_key: string;
            const min_units: Integer; out best_text: string;
            out best_weight: Integer): Boolean;
        const
            c_probe_limit = 8;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            candidate_text: string;
            candidate_units: Integer;
            weight_value: Integer;
            lookup_ok: Boolean;
        begin
            Result := False;
            best_text := '';
            best_weight := 0;
            if query_key = '' then
            begin
                Exit;
            end;

            { This helper scores dictionary phrase evidence for an already
              parsed full-pinyin span. Prefix, jianpin and typo expansion
              cannot produce stronger exact evidence here and made every
              missing lattice span run the full short-query pipeline. }
            lookup_ok := dictionary_exact_lookup_cached(query_key,
                local_results);
            if not lookup_ok then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if (local_results[local_idx].source = cs_user) or
                    (not local_results[local_idx].has_dict_weight) or
                    is_runtime_chain_candidate(local_results[local_idx]) or
                    is_runtime_common_pattern_candidate(local_results[local_idx]) or
                    is_runtime_redup_candidate(local_results[local_idx]) then
                begin
                    Continue;
                end;

                candidate_text := Trim(local_results[local_idx].text);
                candidate_units := get_candidate_text_unit_count(candidate_text);
                if candidate_units < min_units then
                begin
                    Continue;
                end;

                if local_results[local_idx].has_dict_weight then
                begin
                    weight_value := local_results[local_idx].dict_weight;
                end
                else
                begin
                    weight_value := local_results[local_idx].score;
                end;

                Inc(weight_value, get_preferred_exact_phrase_bonus_local(
                    query_key, candidate_text));

                if (not Result) or (weight_value > best_weight) then
                begin
                    best_text := candidate_text;
                    best_weight := weight_value;
                    Result := True;
                end;
            end;
        end;

        function get_single_plus_following_phrase_penalty_local(
            const segment_start: Integer; const segment_syllables: Integer;
            const candidate_text: string; const candidate_weight: Integer): Integer;
        var
            single_text: string;
            single_weight: Integer;
            follow_len: Integer;
            query_key: string;
            follow_text: string;
            best_follow_weight: Integer;
            combined_weight: Integer;
        begin
            Result := 0;
            if (segment_syllables <> 2) or
                (get_candidate_text_unit_count(candidate_text) <> 2) or
                (segment_start < 0) or
                (segment_start + 2 >= Length(exact_syllables)) then
            begin
                Exit;
            end;

            if not try_get_best_long_sentence_single_char_local(
                exact_syllables[segment_start].text, single_text, single_weight) then
            begin
                Exit;
            end;

            best_follow_weight := Low(Integer);
            for follow_len := 2 to
                Min(c_long_sentence_max_segment_len, Length(exact_syllables) - (segment_start + 1)) do
            begin
                query_key := build_exact_syllable_text(segment_start + 1, follow_len);
                if not try_get_best_sentence_phrase_weight_local(query_key, 2,
                    follow_text, best_follow_weight) then
                begin
                    Continue;
                end;
            end;

            if best_follow_weight <= Low(Integer) div 4 then
            begin
                Exit;
            end;

            combined_weight := single_weight + best_follow_weight;
            if is_strong_sentence_boundary_single_local(
                exact_syllables[segment_start].text) then
            begin
                if combined_weight >= candidate_weight + 240 then
                begin
                    Exit(2400);
                end
                else if combined_weight >= candidate_weight + 80 then
                begin
                    Exit(1800);
                end
                else if combined_weight >= candidate_weight - 120 then
                begin
                    Exit(1200);
                end;
            end;

            if combined_weight >= candidate_weight + 520 then
            begin
                Exit(880);
            end
            else if combined_weight >= candidate_weight + 320 then
            begin
                Exit(640);
            end
            else if combined_weight >= candidate_weight + 180 then
            begin
                Exit(420);
            end;
        end;

        function get_preferred_phrase_split_penalty_local(
            const segment_start: Integer; const segment_syllables: Integer;
            const candidate_text: string; const candidate_weight: Integer): Integer;
        var
            candidate_units: Integer;
            split_pos: Integer;
            left_query: string;
            right_query: string;
            left_text: string;
            right_text: string;
            left_weight: Integer;
            right_weight: Integer;
            combined_text: string;
            combined_weight: Integer;
            best_combined_weight: Integer;
            left_bonus: Integer;
            right_bonus: Integer;
        begin
            Result := 0;
            if (segment_syllables < 4) or (segment_start < 0) or
                (segment_start + segment_syllables > Length(exact_syllables)) then
            begin
                Exit;
            end;

            candidate_units := get_candidate_text_unit_count(candidate_text);
            if candidate_units <> segment_syllables then
            begin
                Exit;
            end;

            best_combined_weight := Low(Integer);
            for split_pos := 2 to segment_syllables - 2 do
            begin
                left_query := build_exact_syllable_text(segment_start, split_pos);
                right_query := build_exact_syllable_text(segment_start + split_pos,
                    segment_syllables - split_pos);
                if (left_query = '') or (right_query = '') then
                begin
                    Continue;
                end;

                if not try_get_best_sentence_phrase_weight_local(left_query, 2,
                    left_text, left_weight) then
                begin
                    Continue;
                end;
                if not try_get_best_sentence_phrase_weight_local(right_query, 2,
                    right_text, right_weight) then
                begin
                    Continue;
                end;

                left_bonus := get_preferred_exact_phrase_bonus_local(left_query, left_text);
                right_bonus := get_preferred_exact_phrase_bonus_local(right_query, right_text);
                if (left_bonus <= 0) and (right_bonus <= 0) then
                begin
                    Continue;
                end;

                combined_text := left_text + right_text;
                if SameText(combined_text, candidate_text) then
                begin
                    Continue;
                end;

                combined_weight := left_weight + right_weight;
                if combined_weight > best_combined_weight then
                begin
                    best_combined_weight := combined_weight;
                end;
            end;

            if best_combined_weight <= Low(Integer) div 4 then
            begin
                Exit;
            end;

            if best_combined_weight >= candidate_weight + 320 then
            begin
                Exit(2200);
            end
            else if best_combined_weight >= candidate_weight + 140 then
            begin
                Exit(1400);
            end
            else if best_combined_weight >= candidate_weight - 40 then
            begin
                Exit(780);
            end;
        end;

