        function segment_path_has_disallowed_single_segment_local(
            const candidate: TncCandidate): Boolean;
        var
            encoded_path: string;
            segment_parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
            segment_units: Integer;
            inferred_score: Integer;
            inferred_segment_count: Integer;

            function has_quantity_neighbor_local(
                const idx_local: Integer): Boolean;
            var
                previous_text_local: string;
                next_text_local: string;

                function is_number_quantity_phrase_text_local(
                    const text_value_local: string): Boolean;
                var
                    units_local: TArray<string>;
                begin
                    units_local := split_text_units(Trim(text_value_local));
                    if Length(units_local) <> 2 then
                    begin
                        Exit(False);
                    end;
                    Result := is_number_single_segment_text_local(units_local[0]) and
                        is_quantity_tail_single_segment_text_local(units_local[1]);
                end;
            begin
                Result := False;
                if (idx_local < 0) or (idx_local > High(segment_parts)) then
                begin
                    Exit;
                end;

                if (idx_local < High(segment_parts)) and
                    is_number_single_segment_text_local(
                    Trim(segment_parts[idx_local])) then
                begin
                    next_text_local := Trim(segment_parts[idx_local + 1]);
                    if is_quantity_tail_single_segment_text_local(next_text_local) then
                    begin
                        Exit(True);
                    end;
                end;

                if (idx_local = High(segment_parts)) and
                    is_quantity_tail_single_segment_text_local(
                    Trim(segment_parts[idx_local])) and (idx_local > 0) then
                begin
                    previous_text_local := Trim(segment_parts[idx_local - 1]);
                    Exit(is_number_single_segment_text_local(previous_text_local) or
                        is_ordinal_head_segment_text_local(previous_text_local));
                end;

                if (idx_local = 0) and
                    SameText(Trim(segment_parts[idx_local]),
                    string(Char($7B2C))) and
                    (idx_local < High(segment_parts)) then
                begin
                    next_text_local := Trim(segment_parts[idx_local + 1]);
                    Exit(is_number_quantity_phrase_text_local(next_text_local));
                end;
            end;
        begin
            Result := False;
            if expected_units > 4 then
            begin
                Exit;
            end;

            encoded_path := get_segment_path_for_candidate(candidate);
            if encoded_path = '' then
            begin
                encoded_path := infer_segment_path_for_query_text_with_score(
                    lookup_text, Trim(candidate.text), inferred_score,
                    inferred_segment_count);
            end;
            if get_encoded_path_segment_count_local(encoded_path) <= 1 then
            begin
                Exit;
            end;

            segment_parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(segment_parts) do
            begin
                segment_text := Trim(segment_parts[part_idx]);
                segment_units := get_candidate_text_unit_count(segment_text);
                if segment_units <> 1 then
                begin
                    Continue;
                end;

                if has_quantity_neighbor_local(part_idx) then
                begin
                    Continue;
                end;

                if is_function_single_segment_text_local(segment_text) then
                begin
                    Continue;
                end;

                if (part_idx = High(segment_parts)) and
                    is_locative_tail_single_segment_text_local(segment_text) then
                begin
                    Continue;
                end;

                Exit(True);
            end;
        end;

