        function current_span_has_path_bonus_protection_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const current_text: string): Boolean;
        var
            segment_path: string;
            segment_parts: TArray<string>;
            segment_idx: Integer;
            segment_text: string;
            segment_units: Integer;
            unit_pos: Integer;
        begin
            Result := False;
            if (m_dictionary = nil) or (current_text = '') or
                (local_span_len <= 0) then
            begin
                Exit;
            end;

            segment_path := get_segment_path_for_candidate(candidates[0], 0);
            if (segment_path = '') or
                (get_cached_query_segment_path_bonus(lookup_text,
                segment_path) <= 0) then
            begin
                Exit;
            end;

            segment_parts := segment_path.Split([c_segment_path_separator]);
            unit_pos := 0;
            for segment_idx := 0 to High(segment_parts) do
            begin
                segment_text := Trim(segment_parts[segment_idx]);
                if segment_text = '' then
                begin
                    Continue;
                end;
                segment_units := get_candidate_text_unit_count(segment_text);
                if (unit_pos = local_start_idx) and
                    (segment_units = local_span_len) and
                    SameText(segment_text, current_text) then
                begin
                    Exit(True);
                end;
                Inc(unit_pos, segment_units);
            end;
        end;

        function should_keep_final_modal_tail_span_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const current_text: string): Boolean;
        var
            current_units: TArray<string>;
            prefix_text: string;
            prefix_key: string;
            tail_key: string;
            expected_tail_text: string;
            local_idx: Integer;
        begin
            Result := False;
            if (local_span_len < 2) or
                (local_start_idx + local_span_len <> input_syllable_count) then
            begin
                Exit;
            end;

            current_units := split_text_units(current_text);
            if Length(current_units) <> local_span_len then
            begin
                Exit;
            end;

            tail_key := normalize_pinyin_text(
                syllables_local[local_start_idx + local_span_len - 1].text);
            expected_tail_text := get_modal_tail_text_for_key_local(tail_key);
            if (expected_tail_text = '') or
                (not SameText(current_units[High(current_units)],
                expected_tail_text)) then
            begin
                Exit;
            end;

            prefix_key := build_query_key_local(local_start_idx,
                local_span_len - 1);
            prefix_text := '';
            for local_idx := 0 to High(current_units) - 1 do
            begin
                prefix_text := prefix_text + current_units[local_idx];
            end;

            Result := has_exact_phrase_text_for_key_local(prefix_key,
                prefix_text, local_span_len - 1) or
                (get_preferred_query_phrase_bonus_local(prefix_key,
                prefix_text) > 0);
        end;

        function try_get_exact_repair_text_local(const local_start_idx: Integer;
            const local_query_key: string; const local_span_len: Integer;
            const current_text: string; out out_text: string;
            out out_score: Integer): Boolean;
        var
            local_idx: Integer;
            local_text: string;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if ((local_span_len < c_exact_min_span) and
                (local_span_len <> 2)) or
                (m_dictionary = nil) or
                (not m_dictionary.lookup_exact_full_pinyin(local_query_key,
                exact_results_local)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(exact_results_local) do
            begin
                if local_idx >= 4 then
                begin
                    Break;
                end;
                if Trim(exact_results_local[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                local_text := Trim(exact_results_local[local_idx].text);
                if (local_text = '') or SameText(local_text, current_text) or
                    (get_candidate_text_unit_count(local_text) <> local_span_len) then
                begin
                    if (local_idx = 0) and SameText(local_text, current_text) then
                    begin
                        Exit(False);
                    end;
                    Continue;
                end;

                exact_weight_local := exact_results_local[local_idx].score;
                if exact_results_local[local_idx].has_dict_weight and
                    (exact_results_local[local_idx].dict_weight >
                    exact_weight_local) then
                begin
                    exact_weight_local := exact_results_local[local_idx].dict_weight;
                end;
                if ((local_span_len = 2) and (exact_weight_local < 800)) or
                    ((local_span_len <> 2) and
                    (exact_weight_local < c_exact_min_weight)) then
                begin
                    Continue;
                end;
                if (local_span_len = 2) and (exact_weight_local < 800) and
                    span_has_matching_fixed_boundary_local(local_start_idx,
                    local_span_len, current_text) then
                begin
                    Continue;
                end;

                out_text := local_text;
                out_score := exact_weight_local +
                    ((4 - local_idx) * 256) + (local_span_len * 512);
                Exit(True);
            end;
        end;

        function try_get_split_preferred_repair_text_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const current_text: string; out out_text: string;
            out out_score: Integer): Boolean;
        var
            split_len_local: Integer;
            left_query_key: string;
            right_query_key: string;
            left_text: string;
            right_text: string;
            left_bonus: Integer;
            right_bonus: Integer;
            combined_text: string;
            combined_score: Integer;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (local_span_len < 4) or
                (local_start_idx < 0) or
                (local_start_idx + local_span_len > input_syllable_count) then
            begin
                Exit;
            end;

            for split_len_local := 2 to local_span_len - 2 do
            begin
                left_query_key := build_query_key_local(local_start_idx,
                    split_len_local);
                right_query_key := build_query_key_local(
                    local_start_idx + split_len_local,
                    local_span_len - split_len_local);
                if (not try_get_preferred_query_phrase_text_local(
                    left_query_key, left_text, left_bonus)) or
                    (not try_get_preferred_query_phrase_text_local(
                    right_query_key, right_text, right_bonus)) or
                    (get_candidate_text_unit_count(left_text) <>
                    split_len_local) or
                    (get_candidate_text_unit_count(right_text) <>
                    local_span_len - split_len_local) then
                begin
                    Continue;
                end;

                combined_text := left_text + right_text;
                if SameText(combined_text, current_text) or
                    (get_candidate_text_unit_count(combined_text) <>
                    local_span_len) then
                begin
                    Continue;
                end;

                combined_score := left_bonus + right_bonus +
                    (local_span_len * 768);
                if (not Result) or (combined_score > out_score) then
                begin
                    Result := True;
                    out_text := combined_text;
                    out_score := combined_score;
                end;
            end;
        end;

        function should_leave_weak_same_span_open_for_following_phrase_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const local_preferred_bonus: Integer): Boolean;
        var
            next_query_key: string;
            next_text: string;
            next_bonus: Integer;
            current_weight_estimate: Integer;
            next_weight_estimate: Integer;
        begin
            Result := False;
            if (local_span_len <> 2) or
                (local_start_idx + local_span_len >= input_syllable_count) then
            begin
                Exit;
            end;

            current_weight_estimate := local_preferred_bonus - 1800 -
                (local_span_len * 180);
            if current_weight_estimate >= 420 then
            begin
                Exit;
            end;

            next_query_key := build_query_key_local(local_start_idx + 1, 2);
            if (next_query_key = '') or
                (not try_get_preferred_query_phrase_text_local(next_query_key,
                next_text, next_bonus)) or
                (get_candidate_text_unit_count(next_text) <> 2) then
            begin
                Exit;
            end;

            next_weight_estimate := next_bonus - 1800 - (2 * 180);
            Result := next_weight_estimate >= 800;
        end;

        function try_apply_overlap_single_then_phrase_repair_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const local_preferred_bonus: Integer; out out_single_text: string;
            out out_single_score: Integer): Boolean;
        var
            single_results: TncCandidateList;
            single_idx: Integer;
            single_text: string;
            single_score: Integer;
            next_query_key: string;
            next_text: string;
            next_bonus: Integer;
            current_weight_estimate: Integer;
            next_weight_estimate: Integer;
        begin
            Result := False;
            out_single_text := '';
            out_single_score := 0;
            if (local_span_len <> 2) or
                (local_start_idx + local_span_len >= input_syllable_count) then
            begin
                Exit;
            end;

            current_weight_estimate := local_preferred_bonus - 1800 -
                (local_span_len * 180);
            if current_weight_estimate >= 420 then
            begin
                Exit;
            end;

            next_query_key := build_query_key_local(local_start_idx + 1, 2);
            if (next_query_key = '') or
                (not try_get_preferred_query_phrase_text_local(next_query_key,
                next_text, next_bonus)) or
                (get_candidate_text_unit_count(next_text) <> 2) then
            begin
                Exit;
            end;
            next_weight_estimate := next_bonus - 1800 - (2 * 180);
            if next_weight_estimate < 800 then
            begin
                Exit;
            end;

            if not m_dictionary.lookup(
                normalize_pinyin_text(syllables_local[local_start_idx].text),
                single_results) then
            begin
                Exit;
            end;

            for single_idx := 0 to High(single_results) do
            begin
                single_text := Trim(single_results[single_idx].text);
                if get_candidate_text_unit_count(single_text) <> 1 then
                begin
                    Continue;
                end;
                single_score := single_results[single_idx].score;
                if single_results[single_idx].has_dict_weight and
                    (single_results[single_idx].dict_weight > single_score) then
                begin
                    single_score := single_results[single_idx].dict_weight;
                end;
                if SameText(normalize_pinyin_text(
                    syllables_local[local_start_idx].text), 'yu') and
                    (single_text = string(Char($4E0E))) then
                begin
                    Inc(single_score, 160);
                end;
                if (out_single_text = '') or (single_score > out_single_score) then
                begin
                    out_single_text := single_text;
                    out_single_score := single_score;
                end;
            end;

            Result := out_single_text <> '';
        end;

        function build_repaired_text_local: string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := 0 to High(repaired_units_local) do
            begin
                Result := Result + repaired_units_local[local_idx];
            end;
        end;

        procedure promote_repaired_candidate_local;
        var
            local_idx: Integer;
        begin
            repaired_text_local := build_repaired_text_local;
            if (repaired_text_local = '') or
                SameText(repaired_text_local, Trim(candidates[0].text)) or
                (get_candidate_text_unit_count(repaired_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            existing_idx_local := -1;
            for local_idx := 0 to High(candidates) do
            begin
                if (Trim(candidates[local_idx].comment) = '') and
                    SameText(Trim(candidates[local_idx].text),
                    repaired_text_local) then
                begin
                    existing_idx_local := local_idx;
                    Break;
                end;
            end;

            if existing_idx_local = 0 then
            begin
                Exit;
            end;

            if existing_idx_local > 0 then
            begin
                repaired_candidate_local := candidates[existing_idx_local];
            end
            else
            begin
                repaired_candidate_local := candidates[0];
                repaired_candidate_local.text := repaired_text_local;
                repaired_candidate_local.comment := '';
                repaired_candidate_local.source := cs_rule;
            end;
            repaired_candidate_local.score := Max(
                repaired_candidate_local.score + c_repair_base_bonus +
                total_repair_score_local,
                candidates[0].score + c_repair_base_bonus +
                total_repair_score_local);

            if existing_idx_local > 0 then
            begin
                for local_idx := existing_idx_local downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                end;
                candidates[0] := repaired_candidate_local;
            end
            else
            begin
                SetLength(candidates, Length(candidates) + 1);
                for local_idx := High(candidates) downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                end;
                candidates[0] := repaired_candidate_local;
            end;

            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' prefrepair=[text=%s score=%d]',
                    [repaired_text_local, total_repair_score_local]);
            end;
        end;
    begin
        // The span rank repair path has repeatedly promoted locally valid but
        // globally worse chains (for example a single + two-char technical word
        // split beating two ordinary two-char words). Keep the repair disabled
        // until it can prove end-to-end quality on corpus tests.
        Exit;
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count < c_min_syllables) or
            (Trim(candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(candidates[0].text)) <>
            input_syllable_count) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(candidates[0].text));
        if Length(top_units_local) <> input_syllable_count then
        begin
            Exit;
        end;

        repaired_units_local := Copy(top_units_local);
        SetLength(occupied_units_local, input_syllable_count);
        total_repair_score_local := 0;

        for span_len_local := c_max_span downto 2 do
        begin
            for start_idx_local := 0 to input_syllable_count - span_len_local do
            begin
                if any_occupied_local(start_idx_local, span_len_local) then
                begin
                    Continue;
                end;

                query_key_local := build_query_key_local(start_idx_local,
                    span_len_local);
                current_text_local := join_units_local(repaired_units_local,
                    start_idx_local, span_len_local);
                repair_text_local := '';
                repair_score_local := 0;
                preferred_text_local := '';
                preferred_bonus_local := 0;

                if should_keep_final_modal_tail_span_local(start_idx_local,
                    span_len_local, current_text_local) then
                begin
                    mark_occupied_local(start_idx_local, span_len_local);
                    Continue;
                end;

                if try_get_preferred_query_phrase_text_local(query_key_local,
                    preferred_text_local, preferred_bonus_local) and
                    (get_candidate_text_unit_count(preferred_text_local) =
                    span_len_local) then
                begin
                    preferred_weight_estimate_local := preferred_bonus_local -
                        1800 - (span_len_local * 180);
                    if (not SameText(preferred_text_local,
                        current_text_local)) and
                        (has_exact_phrase_text_only_for_key_local(
                        query_key_local, current_text_local,
                        span_len_local) or
                        current_span_has_path_bonus_protection_local(
                        start_idx_local, span_len_local,
                        current_text_local)) then
                    begin
                        mark_occupied_local(start_idx_local, span_len_local);
                        Continue;
                    end;
                    if (span_len_local = 2) and
                        (preferred_weight_estimate_local < 800) and
                        (not SameText(preferred_text_local,
                        current_text_local)) and
                        span_has_matching_fixed_boundary_local(start_idx_local,
                        span_len_local, current_text_local) then
                    begin
                        Continue;
                    end;
                    if (not SameText(preferred_text_local, current_text_local)) and
                        try_apply_overlap_single_then_phrase_repair_local(
                        start_idx_local, span_len_local, preferred_bonus_local,
                        repair_text_local, repair_score_local) then
                    begin
                        repaired_units_local[start_idx_local] := repair_text_local;
                        mark_occupied_local(start_idx_local, 1);
                        Inc(total_repair_score_local, repair_score_local +
                            (span_len_local * 512));
                        Continue;
                    end;
                    if SameText(preferred_text_local, current_text_local) then
                    begin
                        if should_leave_weak_same_span_open_for_following_phrase_local(
                            start_idx_local, span_len_local,
                            preferred_bonus_local) then
                        begin
                            Continue;
                        end;
                        mark_occupied_local(start_idx_local, span_len_local);
                        Continue;
                    end
                    else
                    begin
                        repair_text_local := preferred_text_local;
                        repair_score_local := preferred_bonus_local +
                            (span_len_local * 1024);
                    end;
                end
                else if not try_get_exact_repair_text_local(start_idx_local,
                    query_key_local, span_len_local, current_text_local,
                    repair_text_local, repair_score_local) and
                    not try_get_split_preferred_repair_text_local(
                    start_idx_local, span_len_local, current_text_local,
                    repair_text_local, repair_score_local) then
                begin
                    Continue;
                end;

                if (repair_text_local = '') or
                    (get_candidate_text_unit_count(repair_text_local) <>
                    span_len_local) then
                begin
                    Continue;
                end;

                for unit_idx_local := 0 to span_len_local - 1 do
                begin
                    repaired_units_local[start_idx_local + unit_idx_local] :=
                        split_text_units(repair_text_local)[unit_idx_local];
                end;
                mark_occupied_local(start_idx_local, span_len_local);
                Inc(total_repair_score_local, repair_score_local);
            end;
        end;

        if total_repair_score_local > 0 then
        begin
            promote_repaired_candidate_local;
        end;
    end;

    procedure ensure_exact_span_rank_repair_candidate_visible(
        var candidates: TncCandidateList);
    const
        c_min_syllables = 5;
        c_max_span = 5;
        c_probe_limit = 10;
        c_min_replace_weight = 520;
        c_min_chain_phrase_weight = 450;
        c_exact_replace_margin = 180;
        c_strong_split_override_weight = 20000;
        c_repair_base_bonus = 52000;
        c_weak_fixed_head_exact_weight = 720;
    var
        syllables_local: TncPinyinParseResult;
        top_units_local: TArray<string>;
        repaired_units_local: TArray<string>;
        occupied_units_local: TArray<Boolean>;
        span_len_local: Integer;
        start_idx_local: Integer;
        total_repair_score_local: Integer;
        repaired_text_local: string;
        repaired_candidate_local: TncCandidate;
        existing_idx_local: Integer;

        function build_query_key_local(const local_start_idx: Integer;
            const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len > Length(syllables_local)) then
            begin
                Exit;
            end;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function join_units_local(const local_start_idx: Integer;
            const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len > Length(repaired_units_local)) then
            begin
                Exit;
            end;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + repaired_units_local[local_idx];
            end;
        end;

        function any_occupied_local(const local_start_idx: Integer;
            const local_span_len: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := True;
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len > Length(occupied_units_local)) then
            begin
                Exit;
            end;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                if occupied_units_local[local_idx] then
                begin
                    Exit(True);
                end;
            end;
            Result := False;
        end;

        procedure mark_occupied_local(const local_start_idx: Integer;
            const local_span_len: Integer);
        var
            local_idx: Integer;
        begin
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                occupied_units_local[local_idx] := True;
            end;
        end;

        function get_effective_candidate_weight_local(
            const candidate: TncCandidate): Integer;
        begin
            Result := candidate.score;
            if candidate.has_dict_weight and (candidate.dict_weight > Result) then
            begin
                Result := candidate.dict_weight;
            end;
            if Result < 0 then
            begin
                Result := 0;
            end;
        end;

        function try_pick_best_exact_span_text_local(const query_key_local: string;
            const span_len_value: Integer; const current_text_value: string;
            const local_start_idx_value: Integer;
            out out_text: string; out out_weight: Integer;
            out out_current_weight: Integer): Boolean;
        var
            exact_results_local: TncCandidateList;
            ranked_lookup_results_local: TncCandidateList;
            local_idx: Integer;
            lookup_idx_local: Integer;
            candidate_text_local: string;
            ranked_text_local: string;
            candidate_weight_local: Integer;
            candidate_rank_weight_local: Integer;
            ranked_weight_local: Integer;
            query_choice_bonus_local: Integer;

            function should_skip_weak_fixed_head_candidate_local(
                const candidate_text_value: string;
                const candidate_weight_value: Integer;
                const candidate_source_value: TncCandidateSource): Boolean;
            var
                fixed_head_text_local: string;
                current_units_local: TArray<string>;
                candidate_units_local: TArray<string>;
            begin
                Result := False;
                if (span_len_value <> 2) or
                    (candidate_source_value = cs_user) or
                    (candidate_weight_value >= c_weak_fixed_head_exact_weight) then
                begin
                    Exit;
                end;

                fixed_head_text_local := get_fixed_resolved_boundary_char_local(
                    syllables_local[local_start_idx_value].text);
                if fixed_head_text_local = '' then
                begin
                    Exit;
                end;

                current_units_local := split_text_units(
                    Trim(current_text_value));
                candidate_units_local := split_text_units(
                    Trim(candidate_text_value));
                if (Length(current_units_local) <> span_len_value) or
                    (Length(candidate_units_local) <> span_len_value) or
                    (not SameText(current_units_local[0],
                    fixed_head_text_local)) then
                begin
                    Exit;
                end;

                Result := not SameText(candidate_units_local[0],
                    fixed_head_text_local);
            end;

            function get_primary_visible_lookup_text_local: string;
            var
                ranked_idx_local: Integer;
                ranked_units_local: Integer;
            begin
                Result := '';
                if Length(ranked_lookup_results_local) = 0 then
                begin
                    Exit;
                end;

                for ranked_idx_local := 0 to Min(High(ranked_lookup_results_local),
                    c_probe_limit - 1) do
                begin
                    if Trim(ranked_lookup_results_local[ranked_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    ranked_text_local := Trim(
                        ranked_lookup_results_local[ranked_idx_local].text);
                    ranked_units_local :=
                        get_candidate_text_unit_count(ranked_text_local);
                    if (ranked_text_local <> '') and
                        (ranked_units_local = span_len_value) then
                    begin
                        Exit(ranked_text_local);
                    end;
                end;
            end;

            function get_ranked_lookup_score_local(const text_value: string): Integer;
            var
                ranked_idx_local: Integer;
            begin
                Result := Low(Integer);
                if (text_value = '') or (Length(ranked_lookup_results_local) = 0) then
                begin
                    Exit;
                end;

                for ranked_idx_local := 0 to Min(High(ranked_lookup_results_local),
                    c_probe_limit - 1) do
                begin
                    if Trim(ranked_lookup_results_local[ranked_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    ranked_text_local := Trim(
                        ranked_lookup_results_local[ranked_idx_local].text);
                    if (ranked_text_local = '') or
                        (get_candidate_text_unit_count(ranked_text_local) <>
                        span_len_value) or
                        (not SameText(ranked_text_local, text_value)) then
                    begin
                        Continue;
                    end;

                    ranked_weight_local := get_effective_candidate_weight_local(
                        ranked_lookup_results_local[ranked_idx_local]);
                    // The visible exact lookup order already contains the
                    // lexicon/user ranking policy for this span. Respect it
                    // during repair so raw weights do not flip a better
                    // visible phrase, e.g. a common homophone selected by
                    // normal lookup.
                    Result := ranked_weight_local +
                        ((c_probe_limit - ranked_idx_local) * 640);
                    Exit;
                end;
            end;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            out_current_weight := Low(Integer);
            ranked_text_local := '';

            if (m_dictionary = nil) or (query_key_local = '') or
                (not m_dictionary.lookup_exact_full_pinyin(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            if not m_dictionary.lookup(query_key_local,
                ranked_lookup_results_local) then
            begin
                ranked_lookup_results_local := nil;
            end;
            ranked_text_local := get_primary_visible_lookup_text_local;

            for local_idx := 0 to High(exact_results_local) do
            begin
                if local_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(exact_results_local[local_idx].text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    span_len_value) then
                begin
                    Continue;
                end;

                candidate_weight_local :=
                    get_effective_candidate_weight_local(
                    exact_results_local[local_idx]);
                if should_skip_weak_fixed_head_candidate_local(
                    candidate_text_local, candidate_weight_local,
                    exact_results_local[local_idx].source) then
                begin
                    Continue;
                end;
                query_choice_bonus_local :=
                    m_dictionary.get_query_choice_bonus(query_key_local,
                    candidate_text_local);
                if (ranked_text_local <> '') and
                    SameText(current_text_value, ranked_text_local) and
                    (not SameText(candidate_text_local, ranked_text_local)) and
                    (query_choice_bonus_local <= 0) and
                    (not ((exact_results_local[local_idx].source = cs_user) and
                    m_dictionary.is_user_entry(query_key_local,
                    candidate_text_local))) then
                begin
                    Continue;
                end;
                if query_choice_bonus_local > 0 then
                begin
                    Inc(candidate_weight_local, query_choice_bonus_local * 8);
                end;
                if (span_len_value >= 2) and
                    (not m_dictionary.is_base_entry(query_key_local,
                    candidate_text_local)) and
                    (not ((exact_results_local[local_idx].source = cs_user) and
                    m_dictionary.is_user_entry(query_key_local,
                    candidate_text_local))) then
                begin
                    candidate_weight_local := Min(candidate_weight_local,
                        240 + span_len_value * 80);
                end;
                lookup_idx_local := get_ranked_lookup_score_local(
                    candidate_text_local);
                if lookup_idx_local > candidate_weight_local then
                begin
                    candidate_weight_local := lookup_idx_local;
                end;
                if (span_len_value >= 2) and
                    (not m_dictionary.is_base_entry(query_key_local,
                    candidate_text_local)) and
                    (not ((exact_results_local[local_idx].source = cs_user) and
                    m_dictionary.is_user_entry(query_key_local,
                    candidate_text_local))) then
                begin
                    candidate_weight_local := Min(candidate_weight_local,
                        240 + span_len_value * 80);
                end;

                if SameText(candidate_text_local, current_text_value) and
                    (candidate_weight_local > out_current_weight) then
                begin
                    out_current_weight := candidate_weight_local;
                end;

                candidate_rank_weight_local := candidate_weight_local +
                    ((c_probe_limit - local_idx) * 32);
                if (out_text = '') or
                    (candidate_rank_weight_local > out_weight) then
                begin
                    out_text := candidate_text_local;
                    out_weight := candidate_rank_weight_local;
                    Result := True;
                end;
            end;
        end;

        function should_replace_span_local(const best_text_value: string;
            const best_weight_value: Integer; const current_text_value: string;
            const current_weight_value: Integer): Boolean;
        var
            best_units_local: Integer;
        begin
            Result := False;
            if (best_text_value = '') or
                SameText(best_text_value, current_text_value) or
                (get_candidate_text_unit_count(best_text_value) <= 1) then
            begin
                Exit;
            end;

            best_units_local := get_candidate_text_unit_count(best_text_value);
            if current_weight_value <= Low(Integer) div 4 then
            begin
                if best_units_local >= 4 then
                begin
                    Exit(best_weight_value >= 220);
                end;
                Exit(best_weight_value >= c_min_replace_weight);
            end;

            Result := best_weight_value >=
                current_weight_value + c_exact_replace_margin;
        end;

        function is_modifier_single_text_for_repair_local(
            const text_value: string): Boolean;
        begin
            Result := False;
            if get_candidate_text_unit_count(text_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(text_value[1]) of
                $662F, $7684, $4E86, $5728, $4E8E, $4E5F, $548C, $4E0D,
                $518D, $9AD8, $5F88, $592A, $6700, $66F4, $6CA1, $8981,
                $4F1A, $80FD, $628A, $88AB, $8BA9, $7ED9, $5BF9, $4ECE,
                $5411, $4E0E, $90FD, $8FD8, $624D, $5C31, $53EA, $522B,
                $5DF2, $5C06, $53EF, $60F3, $65E0, $975E, $672A, $4ECD,
                $591A, $5C11, $65B0, $8001, $5C0F, $5927, $5168, $8D85,
                $771F, $597D, $5982, $633A, $8F83, $6781, $800C, $5E76,
                $6240, $4E0A, $4E0B, $4E00, $4E14, $5730, $5148:
                    Result := True;
            end;
        end;

        function is_modifier_tail_syllable_for_repair_local(
            const local_idx: Integer): Boolean;
        var
            syllable_text_local: string;
        begin
            Result := False;
            if (local_idx < 0) or (local_idx >= Length(syllables_local)) then
            begin
                Exit;
            end;

            syllable_text_local := normalize_pinyin_text(
                syllables_local[local_idx].text);
            Result := (syllable_text_local = 'shi') or
                (syllable_text_local = 'de') or
                (syllable_text_local = 'le') or
                (syllable_text_local = 'zai') or
                (syllable_text_local = 'he') or
                (syllable_text_local = 'yu') or
                (syllable_text_local = 'ye') or
                (syllable_text_local = 'you') or
                (syllable_text_local = 'jiu') or
                (syllable_text_local = 'dou') or
                (syllable_text_local = 'hai') or
                (syllable_text_local = 'cai') or
                (syllable_text_local = 'ba') or
                (syllable_text_local = 'bei') or
                (syllable_text_local = 'rang') or
                (syllable_text_local = 'gei') or
                (syllable_text_local = 'dui') or
                (syllable_text_local = 'cong') or
                (syllable_text_local = 'xiang') or
                (syllable_text_local = 'yao') or
                (syllable_text_local = 'hui') or
                (syllable_text_local = 'neng') or
                (syllable_text_local = 'ke') or
                (syllable_text_local = 'jiang') or
                (syllable_text_local = 'yi') or
                (syllable_text_local = 'bu') or
                (syllable_text_local = 'zui') or
                (syllable_text_local = 'geng') or
                (syllable_text_local = 'hen') or
                (syllable_text_local = 'tai');
        end;

        function has_following_exact_phrase_for_repair_local(
            const local_start_idx: Integer): Boolean;
        var
            follow_len_local: Integer;
            follow_query_key_local: string;
            follow_results_local: TncCandidateList;
            follow_idx_local: Integer;
            follow_text_local: string;
            follow_weight_local: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or
                (local_start_idx >= input_syllable_count) then
            begin
                Exit;
            end;

            for follow_len_local := 2 to
                Min(c_max_span, input_syllable_count - local_start_idx) do
            begin
                follow_query_key_local := build_query_key_local(local_start_idx,
                    follow_len_local);
                if (follow_query_key_local = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(
                    follow_query_key_local, follow_results_local)) then
                begin
                    Continue;
                end;

                for follow_idx_local := 0 to High(follow_results_local) do
                begin
                    if follow_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(follow_results_local[follow_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    follow_text_local := Trim(
                        follow_results_local[follow_idx_local].text);
                    if get_candidate_text_unit_count(follow_text_local) <>
                        follow_len_local then
                    begin
                        Continue;
                    end;
                    follow_weight_local :=
                        get_effective_candidate_weight_local(
                        follow_results_local[follow_idx_local]);
                    if follow_weight_local >= c_min_replace_weight then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function should_preserve_modifier_plus_phrase_boundary_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            local_units: TArray<string>;
        begin
            Result := False;
            if (local_span_len < 2) or
                (local_start_idx + 1 >= input_syllable_count) then
            begin
                Exit;
            end;
            local_units := split_text_units(join_units_local(local_start_idx,
                local_span_len));
            if (Length(local_units) <= 0) or
                (not is_modifier_single_text_for_repair_local(local_units[0])) then
            begin
                Exit;
            end;

            Result := has_following_exact_phrase_for_repair_local(
                local_start_idx + 1);
        end;

        function has_preceding_exact_phrase_for_repair_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            phrase_len_local: Integer;
            phrase_query_key_local: string;
            phrase_results_local: TncCandidateList;
            phrase_idx_local: Integer;
            phrase_text_local: string;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or (local_span_len < 2) then
            begin
                Exit;
            end;

            for phrase_len_local := 2 to Min(c_max_span, local_span_len - 1) do
            begin
                phrase_query_key_local := build_query_key_local(local_start_idx,
                    phrase_len_local);
                phrase_text_local := join_units_local(local_start_idx,
                    phrase_len_local);
                if (phrase_query_key_local = '') or (phrase_text_local = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(
                    phrase_query_key_local, phrase_results_local)) then
                begin
                    Continue;
                end;

                for phrase_idx_local := 0 to High(phrase_results_local) do
                begin
                    if phrase_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(phrase_results_local[phrase_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(
                        phrase_results_local[phrase_idx_local].text);
                    if not SameText(candidate_text_local, phrase_text_local) then
                    begin
                        Continue;
                    end;
                    candidate_weight_local := get_effective_candidate_weight_local(
                        phrase_results_local[phrase_idx_local]);
                    if candidate_weight_local >= c_min_replace_weight then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function should_preserve_phrase_plus_modifier_boundary_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            local_units: TArray<string>;
        begin
            Result := False;
            if local_span_len < 2 then
            begin
                Exit;
            end;
            local_units := split_text_units(join_units_local(local_start_idx,
                local_span_len));
            if (Length(local_units) <> local_span_len) or
                (not is_modifier_single_text_for_repair_local(
                local_units[High(local_units)])) then
            begin
                Exit;
            end;

            // A multi-character prefix followed by a function/modifier character
            // is a plausible word-boundary split even when the prefix is a name
            // or a low-frequency phrase not present as a base lexicon entry.
            // The caller still allows replacements that extend that prefix
            // (e.g. "宸ョ▼鏄? -> "宸ョ▼甯?).
            if (local_span_len >= 3) and
                (get_candidate_text_unit_count(join_units_local(local_start_idx,
                local_span_len - 1)) >= 2) then
            begin
                Exit(True);
            end;

            Result := has_preceding_exact_phrase_for_repair_local(
                local_start_idx, local_span_len);
        end;

        function replacement_extends_current_prefix_local(
            const best_text_value: string; const local_start_idx: Integer;
            const local_span_len: Integer): Boolean;
        var
            prefix_units_local: TArray<string>;
            best_units_local: TArray<string>;
            unit_idx_local: Integer;
        begin
            Result := False;
            if (best_text_value = '') or (local_span_len < 3) then
            begin
                Exit;
            end;

            prefix_units_local := split_text_units(join_units_local(
                local_start_idx, local_span_len - 1));
            best_units_local := split_text_units(best_text_value);
            if (Length(prefix_units_local) < 2) or
                (Length(best_units_local) <> local_span_len) or
                (Length(prefix_units_local) >= Length(best_units_local)) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(prefix_units_local) do
            begin
                if prefix_units_local[unit_idx_local] <>
                    best_units_local[unit_idx_local] then
                begin
                    Exit(False);
                end;
            end;
            Result := True;
        end;

        function try_get_exact_text_weight_for_repair_local(
            const query_key_value: string; const text_value: string;
            out out_weight: Integer): Boolean;
        const
            c_split_probe_limit = 48;
        var
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            out_weight := 0;
            if (query_key_value = '') or (text_value = '') or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            if m_dictionary.is_base_entry(query_key_value, text_value) then
            begin
                out_weight := 1000;
                Exit(True);
            end;

            if not m_dictionary.lookup_exact_full_pinyin(query_key_value,
                exact_results_local) then
            begin
                Exit;
            end;

            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if result_idx_local >= c_split_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[result_idx_local].text);
                if SameText(candidate_text_local, text_value) then
                begin
                    out_weight := get_effective_candidate_weight_local(
                        exact_results_local[result_idx_local]);
                    Exit(True);
                end;
            end;
        end;

        function current_span_has_strong_exact_split_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            split_len_local: Integer;
            left_key_local: string;
            right_key_local: string;
            left_text_local: string;
            right_text_local: string;
            left_weight_local: Integer;
            right_weight_local: Integer;
        begin
            Result := False;
            if local_span_len < 4 then
            begin
                Exit;
            end;

            for split_len_local := 2 to local_span_len - 2 do
            begin
                left_key_local := build_query_key_local(local_start_idx,
                    split_len_local);
                right_key_local := build_query_key_local(local_start_idx +
                    split_len_local, local_span_len - split_len_local);
                left_text_local := join_units_local(local_start_idx,
                    split_len_local);
                right_text_local := join_units_local(local_start_idx +
                    split_len_local, local_span_len - split_len_local);

                if try_get_exact_text_weight_for_repair_local(left_key_local,
                    left_text_local, left_weight_local) and
                    try_get_exact_text_weight_for_repair_local(right_key_local,
                    right_text_local, right_weight_local) and
                    (left_weight_local >= c_min_replace_weight) and
                    (right_weight_local >= c_min_replace_weight) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function range_has_strong_exact_phrase_for_repair_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            range_query_key_local: string;
            range_results_local: TncCandidateList;
            range_idx_local: Integer;
            range_text_local: string;
            range_weight_local: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or (local_span_len < 2) or
                (local_start_idx + local_span_len > input_syllable_count) then
            begin
                Exit;
            end;

            range_query_key_local := build_query_key_local(local_start_idx,
                local_span_len);
            if (range_query_key_local = '') or
                (not m_dictionary.lookup_exact_full_pinyin(range_query_key_local,
                range_results_local)) then
            begin
                Exit;
            end;

            for range_idx_local := 0 to High(range_results_local) do
            begin
                if range_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(range_results_local[range_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                range_text_local := Trim(range_results_local[range_idx_local].text);
                if get_candidate_text_unit_count(range_text_local) <>
                    local_span_len then
                begin
                    Continue;
                end;
                range_weight_local := get_effective_candidate_weight_local(
                    range_results_local[range_idx_local]);
                if range_weight_local >= c_min_chain_phrase_weight then
                begin
                    Exit(True);
                end;
            end;
        end;

        function range_has_strong_exact_phrase_chain_for_repair_local(
            const local_start_idx: Integer; const local_span_len: Integer): Boolean;
        var
            left_len_local: Integer;
            right_len_local: Integer;
        begin
            Result := False;
            if local_span_len < 2 then
            begin
                Exit;
            end;

            if range_has_strong_exact_phrase_for_repair_local(local_start_idx,
                local_span_len) then
            begin
                Exit(True);
            end;

            for left_len_local := 2 to local_span_len - 2 do
            begin
                right_len_local := local_span_len - left_len_local;
                if range_has_strong_exact_phrase_for_repair_local(local_start_idx,
                    left_len_local) and
                    range_has_strong_exact_phrase_chain_for_repair_local(
                    local_start_idx + left_len_local, right_len_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_following_strong_phrase_chain_for_repair_local(
            const local_start_idx: Integer): Boolean;
        var
            follow_len_local: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or
                (local_start_idx >= input_syllable_count) then
            begin
                Exit;
            end;

            for follow_len_local := Min(c_max_span,
                input_syllable_count - local_start_idx) downto 2 do
            begin
                if range_has_strong_exact_phrase_chain_for_repair_local(
                    local_start_idx, follow_len_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function current_unit_is_inside_exact_phrase_for_repair_local(
            const local_unit_idx: Integer): Boolean;
        var
            phrase_start_local: Integer;
            phrase_len_local: Integer;
            phrase_key_local: string;
            phrase_text_local: string;
            phrase_weight_local: Integer;
        begin
            Result := False;
            if (local_unit_idx < 0) or
                (local_unit_idx >= input_syllable_count) then
            begin
                Exit;
            end;

            for phrase_len_local := 2 to c_max_span do
            begin
                for phrase_start_local :=
                    Max(0, local_unit_idx - phrase_len_local + 1) to
                    Min(local_unit_idx, input_syllable_count - phrase_len_local) do
                begin
                    phrase_key_local := build_query_key_local(phrase_start_local,
                        phrase_len_local);
                    phrase_text_local := join_units_local(phrase_start_local,
                        phrase_len_local);
                    if (phrase_key_local = '') or (phrase_text_local = '') then
                    begin
                        Continue;
                    end;

                    if try_get_exact_text_weight_for_repair_local(
                        phrase_key_local, phrase_text_local,
                        phrase_weight_local) and
                        (phrase_weight_local >= c_min_chain_phrase_weight) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function replacement_preserves_current_prefix_local(
            const replacement_text_value: string; const local_start_idx: Integer;
            const local_prefix_len: Integer): Boolean;
        var
            prefix_units_local: TArray<string>;
            replacement_units_local: TArray<string>;
            unit_idx_local: Integer;
        begin
            Result := False;
            if (replacement_text_value = '') or (local_prefix_len < 2) then
            begin
                Exit;
            end;

            prefix_units_local := split_text_units(join_units_local(
                local_start_idx, local_prefix_len));
            replacement_units_local := split_text_units(replacement_text_value);
            if (Length(prefix_units_local) <> local_prefix_len) or
                (Length(replacement_units_local) <= local_prefix_len) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(prefix_units_local) do
            begin
                if prefix_units_local[unit_idx_local] <>
                    replacement_units_local[unit_idx_local] then
                begin
                    Exit(False);
                end;
            end;
            Result := True;
        end;

        function should_preserve_strong_prefix_boundary_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const replacement_text_value: string): Boolean;
        var
            prefix_len_local: Integer;
            prefix_query_key_local: string;
            prefix_text_local: string;
            prefix_weight_local: Integer;
            replacement_query_key_local: string;
        begin
            Result := False;
            if (local_span_len < 3) or (replacement_text_value = '') or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            replacement_query_key_local := build_query_key_local(local_start_idx,
                local_span_len);
            if (replacement_query_key_local <> '') and
                m_dictionary.is_base_entry(replacement_query_key_local,
                replacement_text_value) then
            begin
                Exit;
            end;

            for prefix_len_local := 2 to Min(c_max_span, local_span_len - 1) do
            begin
                prefix_query_key_local := build_query_key_local(local_start_idx,
                    prefix_len_local);
                prefix_text_local := join_units_local(local_start_idx,
                    prefix_len_local);
                if (prefix_query_key_local = '') or (prefix_text_local = '') then
                begin
                    Continue;
                end;

                if try_get_exact_text_weight_for_repair_local(
                    prefix_query_key_local, prefix_text_local,
                    prefix_weight_local) and
                    (prefix_weight_local >= c_min_replace_weight) and
                    ((has_following_exact_phrase_for_repair_local(
                    local_start_idx + prefix_len_local)) or
                    (has_following_strong_phrase_chain_for_repair_local(
                    local_start_idx + prefix_len_local))) and
                    (not replacement_preserves_current_prefix_local(
                    replacement_text_value, local_start_idx,
                    prefix_len_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function replacement_preserves_current_suffix_local(
            const replacement_text_value: string; const local_start_idx: Integer;
            const local_suffix_start_offset: Integer; const local_suffix_len: Integer): Boolean;
        var
            replacement_units_local: TArray<string>;
            suffix_units_local: TArray<string>;
            unit_idx_local: Integer;
        begin
            Result := False;
            if (replacement_text_value = '') or (local_suffix_start_offset <= 0) or
                (local_suffix_len < 2) then
            begin
                Exit;
            end;

            replacement_units_local := split_text_units(replacement_text_value);
            suffix_units_local := split_text_units(join_units_local(
                local_start_idx + local_suffix_start_offset, local_suffix_len));
            if (Length(replacement_units_local) <> local_suffix_start_offset +
                local_suffix_len) or (Length(suffix_units_local) <> local_suffix_len) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(suffix_units_local) do
            begin
                if suffix_units_local[unit_idx_local] <>
                    replacement_units_local[local_suffix_start_offset + unit_idx_local] then
                begin
                    Exit(False);
                end;
            end;
            Result := True;
        end;

        function should_preserve_single_plus_phrase_boundary_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const replacement_text_value: string): Boolean;
        var
            suffix_len_local: Integer;
            suffix_query_key_local: string;
            suffix_text_local: string;
            suffix_weight_local: Integer;
        begin
            Result := False;
            if (local_span_len < 3) or (replacement_text_value = '') or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            suffix_len_local := local_span_len - 1;
            suffix_query_key_local := build_query_key_local(local_start_idx + 1,
                suffix_len_local);
            suffix_text_local := join_units_local(local_start_idx + 1,
                suffix_len_local);
            if (suffix_query_key_local = '') or (suffix_text_local = '') then
            begin
                Exit;
            end;

            if try_get_exact_text_weight_for_repair_local(suffix_query_key_local,
                suffix_text_local, suffix_weight_local) and
                (suffix_weight_local >= c_min_replace_weight) and
                (not replacement_preserves_current_suffix_local(
                replacement_text_value, local_start_idx, 1, suffix_len_local)) then
            begin
                Exit(True);
            end;
        end;

        function should_preserve_top_path_exact_segment_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            const replacement_text_value: string): Boolean;
        var
            path_parts_local: TArray<string>;
            part_units_local: TArray<string>;
            replacement_units_local: TArray<string>;
            part_idx_local: Integer;
            segment_start_local: Integer;
            segment_len_local: Integer;
            segment_end_local: Integer;
            span_end_local: Integer;
            segment_query_key_local: string;
            segment_text_local: string;
            segment_weight_local: Integer;
            unit_idx_local: Integer;
            replacement_offset_local: Integer;
            top_path_local: string;
            replacement_dict_weight_known_local: Boolean;
            replacement_dict_weight_available_local: Boolean;
            replacement_dict_weight_local: Integer;

            function try_get_exact_dict_weight_local(const query_key_value: string;
                const text_value: string; out out_weight: Integer): Boolean;
            const
                c_probe_limit = 48;
            var
                exact_results_local: TncCandidateList;
                result_idx_local: Integer;
                candidate_text_local: string;
            begin
                Result := False;
                out_weight := 0;
                if (query_key_value = '') or (text_value = '') or
                    (m_dictionary = nil) then
                begin
                    Exit;
                end;

                if not m_dictionary.lookup_exact_full_pinyin(query_key_value,
                    exact_results_local) then
                begin
                    Exit;
                end;

                for result_idx_local := 0 to High(exact_results_local) do
                begin
                    if result_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(exact_results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(
                        exact_results_local[result_idx_local].text);
                    if SameText(candidate_text_local, text_value) then
                    begin
                        out_weight := exact_results_local[result_idx_local].dict_weight;
                        Exit(True);
                    end;
                end;
            end;

            procedure ensure_replacement_dict_weight_local;
            var
                replacement_query_key_local: string;
            begin
                if not replacement_dict_weight_known_local then
                begin
                    replacement_dict_weight_known_local := True;
                    replacement_dict_weight_available_local := False;
                    replacement_dict_weight_local := 0;
                    replacement_query_key_local := build_query_key_local(
                        local_start_idx, local_span_len);
                    if replacement_query_key_local <> '' then
                    begin
                        replacement_dict_weight_available_local :=
                            try_get_exact_dict_weight_local(
                            replacement_query_key_local, replacement_text_value,
                            replacement_dict_weight_local);
                    end;
                end;
            end;

            function replacement_exact_span_can_override_segment_local(
                const local_segment_weight: Integer): Boolean;
            const
                c_override_margin = 120;
            begin
                ensure_replacement_dict_weight_local;

                Result := replacement_dict_weight_available_local and
                    (replacement_dict_weight_local >= c_min_replace_weight) and
                    (replacement_dict_weight_local >= local_segment_weight +
                    c_override_margin);
            end;

            function replacement_can_resegment_tail_with_following_phrase_local(
                const local_segment_start: Integer; const local_segment_end: Integer;
                const local_segment_len: Integer;
                const local_segment_weight: Integer): Boolean;
            const
                c_min_following_phrase_weight = 780;

                function has_high_weight_following_phrase_local: Boolean;
                var
                    follow_start_local: Integer;
                    follow_len_local: Integer;
                    follow_key_local: string;
                    follow_text_local: string;
                    follow_weight_local: Integer;
                begin
                    Result := False;
                    follow_start_local := local_start_idx + local_span_len;
                    if follow_start_local >= input_syllable_count then
                    begin
                        Exit;
                    end;

                    for follow_len_local := 2 to Min(c_max_span,
                        input_syllable_count - follow_start_local) do
                    begin
                        follow_key_local := build_query_key_local(
                            follow_start_local, follow_len_local);
                        follow_text_local := join_units_local(follow_start_local,
                            follow_len_local);
                        if (follow_key_local = '') or
                            (follow_text_local = '') then
                        begin
                            Continue;
                        end;

                        if try_get_exact_dict_weight_local(
                            follow_key_local, follow_text_local,
                            follow_weight_local) and
                            (follow_weight_local >=
                            c_min_following_phrase_weight) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            begin
                Result := False;
                if (local_segment_len <> 2) or
                    (local_start_idx <> local_segment_end) or
                    (local_segment_start >= local_start_idx) then
                begin
                    Exit;
                end;

                ensure_replacement_dict_weight_local;

                Result := replacement_dict_weight_available_local and
                    (replacement_dict_weight_local >= c_min_replace_weight) and
                    (replacement_dict_weight_local >= local_segment_weight) and
                    has_high_weight_following_phrase_local;
            end;
        begin
            Result := False;
            if (local_span_len < 2) or (replacement_text_value = '') or
                (Length(candidates) = 0) then
            begin
                Exit;
            end;

            top_path_local := get_segment_path_for_candidate(candidates[0], 0);
            if top_path_local = '' then
            begin
                Exit;
            end;

            replacement_units_local := split_text_units(replacement_text_value);
            if Length(replacement_units_local) <> local_span_len then
            begin
                Exit;
            end;
            replacement_dict_weight_known_local := False;
            replacement_dict_weight_available_local := False;
            replacement_dict_weight_local := 0;

            span_end_local := local_start_idx + local_span_len - 1;
            segment_start_local := 0;
            path_parts_local := top_path_local.Split([c_segment_path_separator]);
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                part_units_local := split_text_units(segment_text_local);
                segment_len_local := Length(part_units_local);
                if segment_len_local <= 0 then
                begin
                    Continue;
                end;

                segment_end_local := segment_start_local + segment_len_local - 1;
                if (segment_end_local >= local_start_idx) and
                    (segment_start_local <= span_end_local) and
                    (segment_len_local >= 2) then
                begin
                    segment_query_key_local := build_query_key_local(
                        segment_start_local, segment_len_local);
                    if (segment_query_key_local <> '') and
                        try_get_exact_dict_weight_local(
                        segment_query_key_local, segment_text_local,
                        segment_weight_local) and
                        (segment_weight_local >= c_min_chain_phrase_weight) then
                    begin
                        if (segment_len_local >= 3) and
                            (local_start_idx > segment_start_local) and
                            (local_start_idx <= segment_end_local) then
                        begin
                            if (local_start_idx <> segment_end_local) or
                                (not replacement_exact_span_can_override_segment_local(
                                segment_weight_local)) then
                            begin
                                Exit(True);
                            end;
                        end;

                        if (segment_start_local < local_start_idx) or
                            (segment_end_local > span_end_local) then
                        begin
                            if replacement_exact_span_can_override_segment_local(
                                segment_weight_local) or
                                replacement_can_resegment_tail_with_following_phrase_local(
                                segment_start_local, segment_end_local,
                                segment_len_local, segment_weight_local) then
                            begin
                                Continue;
                            end;
                            Exit(True);
                        end;

                        replacement_offset_local := segment_start_local - local_start_idx;
                        for unit_idx_local := 0 to High(part_units_local) do
                        begin
                            if replacement_units_local[
                                replacement_offset_local + unit_idx_local] <>
                                part_units_local[unit_idx_local] then
                            begin
                                if replacement_exact_span_can_override_segment_local(
                                    segment_weight_local) then
                                begin
                                    Continue;
                                end;
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                Inc(segment_start_local, segment_len_local);
            end;
        end;

        function has_preceding_exact_phrase_ending_at_repair_local(
            const local_end_idx: Integer): Boolean;
        var
            phrase_len_local: Integer;
            phrase_start_local: Integer;
            phrase_query_key_local: string;
            phrase_text_local: string;
            phrase_results_local: TncCandidateList;
            phrase_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            if (local_end_idx <= 0) or (local_end_idx >= input_syllable_count) then
            begin
                Exit;
            end;

            for phrase_len_local := 2 to Min(c_max_span, local_end_idx + 1) do
            begin
                phrase_start_local := local_end_idx - phrase_len_local + 1;
                phrase_query_key_local := build_query_key_local(phrase_start_local,
                    phrase_len_local);
                phrase_text_local := join_units_local(phrase_start_local,
                    phrase_len_local);
                if (phrase_query_key_local = '') or (phrase_text_local = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(
                    phrase_query_key_local, phrase_results_local)) then
                begin
                    Continue;
                end;

                for phrase_idx_local := 0 to High(phrase_results_local) do
                begin
                    if phrase_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(phrase_results_local[phrase_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(
                        phrase_results_local[phrase_idx_local].text);
                    if not SameText(candidate_text_local, phrase_text_local) then
                    begin
                        Continue;
                    end;
                    candidate_weight_local := get_effective_candidate_weight_local(
                        phrase_results_local[phrase_idx_local]);
                    if candidate_weight_local >= c_min_replace_weight then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function try_pick_split_single_span_text_local(
            const local_start_idx: Integer; const current_text_value: string;
            const current_weight_value: Integer; out out_text: string;
            out out_weight: Integer): Boolean;
        var
            unit_idx_local: Integer;
            single_query_key_local: string;
            single_results_local: TncCandidateList;
            single_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            best_single_text_local: string;
            best_single_weight_local: Integer;
            combined_text_local: string;
            combined_weight_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (local_start_idx < 0) or
                (local_start_idx + 2 > input_syllable_count) or
                (get_candidate_text_unit_count(current_text_value) <> 2) or
                (current_weight_value >= c_min_replace_weight) or
                ((not has_following_exact_phrase_for_repair_local(
                local_start_idx + 2)) and
                (not has_following_strong_phrase_chain_for_repair_local(
                local_start_idx + 2)) and
                (not has_preceding_exact_phrase_ending_at_repair_local(
                local_start_idx - 1))) then
            begin
                Exit;
            end;

            combined_text_local := '';
            combined_weight_local := 0;
            for unit_idx_local := 0 to 1 do
            begin
                single_query_key_local := build_query_key_local(
                    local_start_idx + unit_idx_local, 1);
                if (single_query_key_local = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(
                    single_query_key_local, single_results_local)) then
                begin
                    Exit;
                end;

                best_single_text_local := '';
                best_single_weight_local := 0;
                for single_idx_local := 0 to High(single_results_local) do
                begin
                    if single_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(single_results_local[single_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(
                        single_results_local[single_idx_local].text);
                    if (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                        (not m_dictionary.single_char_matches_pinyin(
                        single_query_key_local, candidate_text_local)) then
                    begin
                        Continue;
                    end;
                    candidate_weight_local := get_effective_candidate_weight_local(
                        single_results_local[single_idx_local]);
                    if candidate_weight_local < 780 then
                    begin
                        Continue;
                    end;
                    if (best_single_text_local = '') or
                        (candidate_weight_local > best_single_weight_local) then
                    begin
                        best_single_text_local := candidate_text_local;
                        best_single_weight_local := candidate_weight_local;
                    end;
                end;

                if best_single_text_local = '' then
                begin
                    Exit;
                end;
                if not is_modifier_single_text_for_repair_local(
                    best_single_text_local) then
                begin
                    Exit;
                end;
                combined_text_local := combined_text_local + best_single_text_local;
                Inc(combined_weight_local, best_single_weight_local);
            end;

            if SameText(combined_text_local, current_text_value) or
                (combined_weight_local < current_weight_value + 280) then
            begin
                Exit;
            end;

            out_text := combined_text_local;
            out_weight := combined_weight_local + 512;
            Result := True;
        end;

        function try_pick_modifier_single_repair_local(
            const local_idx: Integer; const current_text_value: string;
            out out_text: string; out out_weight: Integer): Boolean;
        var
            single_query_key_local: string;
            single_results_local: TncCandidateList;
            single_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            ranked_weight_local: Integer;
            current_is_modifier_local: Boolean;
            has_preceding_local: Boolean;
            has_following_exact_local: Boolean;
            has_following_chain_local: Boolean;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (local_idx < 0) or (local_idx >= input_syllable_count) or
                (current_text_value = '') then
            begin
                Exit;
            end;

            current_is_modifier_local :=
                is_modifier_single_text_for_repair_local(current_text_value);
            has_preceding_local :=
                has_preceding_exact_phrase_ending_at_repair_local(local_idx);
            has_following_exact_local :=
                has_following_exact_phrase_for_repair_local(local_idx + 1);
            has_following_chain_local := False;
            if not has_following_exact_local then
            begin
                has_following_chain_local :=
                    has_following_strong_phrase_chain_for_repair_local(
                    local_idx + 1);
            end;

            if ((not has_following_exact_local) and
                (not has_following_chain_local)) or
                (current_is_modifier_local and (not has_preceding_local)) then
            begin
                Exit;
            end;

            single_query_key_local := build_query_key_local(local_idx, 1);
            if (single_query_key_local = '') or
                (not m_dictionary.lookup_exact_full_pinyin(single_query_key_local,
                single_results_local)) then
            begin
                Exit;
            end;

            for single_idx_local := 0 to High(single_results_local) do
            begin
                if single_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(single_results_local[single_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(single_results_local[single_idx_local].text);
                if (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                    (not is_modifier_single_text_for_repair_local(candidate_text_local)) or
                    (not m_dictionary.single_char_matches_pinyin(
                    single_query_key_local, candidate_text_local)) then
                begin
                    Continue;
                end;
                candidate_weight_local := get_effective_candidate_weight_local(
                    single_results_local[single_idx_local]);
                ranked_weight_local := candidate_weight_local +
                    ((c_probe_limit - single_idx_local) * 32);
                if has_preceding_local and
                    (has_following_exact_local or has_following_chain_local) and
                    ((candidate_text_local = string(Char($4E0E))) or
                    (candidate_text_local = string(Char($548C)))) then
                begin
                    Inc(ranked_weight_local, 260);
                end;
                if (out_text = '') or (ranked_weight_local > out_weight) then
                begin
                    out_text := candidate_text_local;
                    out_weight := ranked_weight_local;
                    Result := True;
                end;
            end;
        end;

        procedure apply_span_repair_local(const local_start_idx: Integer;
            const local_span_len: Integer; const replacement_text: string);
        var
            replacement_units: TArray<string>;
            local_idx: Integer;
        begin
            replacement_units := split_text_units(replacement_text);
            if Length(replacement_units) <> local_span_len then
            begin
                Exit;
            end;
            for local_idx := 0 to local_span_len - 1 do
            begin
                repaired_units_local[local_start_idx + local_idx] :=
                    replacement_units[local_idx];
            end;
            mark_occupied_local(local_start_idx, local_span_len);
        end;

        function build_repaired_text_local: string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := 0 to High(repaired_units_local) do
            begin
                Result := Result + repaired_units_local[local_idx];
            end;
        end;

        function build_repaired_segment_path_local: string;
        var
            local_idx: Integer;
            span_len_local: Integer;
            chosen_len_local: Integer;
            segment_text_local: string;
            segment_query_key_local: string;
            segment_weight_local: Integer;
        begin
            Result := '';
            local_idx := 0;
            while local_idx <= High(repaired_units_local) do
            begin
                chosen_len_local := 1;
                for span_len_local := Min(c_max_span,
                    Length(repaired_units_local) - local_idx) downto 2 do
                begin
                    segment_text_local := join_units_local(local_idx,
                        span_len_local);
                    segment_query_key_local := build_query_key_local(local_idx,
                        span_len_local);
                    if try_get_exact_text_weight_for_repair_local(
                        segment_query_key_local, segment_text_local,
                        segment_weight_local) and
                        (segment_weight_local >= c_min_chain_phrase_weight) then
                    begin
                        chosen_len_local := span_len_local;
                        Break;
                    end;
                end;

                segment_text_local := join_units_local(local_idx,
                    chosen_len_local);
                if Result <> '' then
                begin
                    Result := Result + c_segment_path_separator;
                end;
                Result := Result + segment_text_local;
                Inc(local_idx, chosen_len_local);
            end;
        end;

        procedure promote_repaired_candidate_local;
        var
            local_idx: Integer;
            candidate_count_before_local: Integer;
            path_count_matches_local: Boolean;
            repaired_path_local: string;
        begin
            repaired_text_local := build_repaired_text_local;
            if (repaired_text_local = '') or
                SameText(repaired_text_local, Trim(candidates[0].text)) or
                (get_candidate_text_unit_count(repaired_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            existing_idx_local := -1;
            for local_idx := 0 to High(candidates) do
            begin
                if (Trim(candidates[local_idx].comment) = '') and
                    SameText(Trim(candidates[local_idx].text),
                    repaired_text_local) then
                begin
                    existing_idx_local := local_idx;
                    Break;
                end;
            end;

            if existing_idx_local = 0 then
            begin
                Exit;
            end;

            if existing_idx_local > 0 then
            begin
                repaired_candidate_local := candidates[existing_idx_local];
            end
            else
            begin
                repaired_candidate_local := candidates[0];
                repaired_candidate_local.text := repaired_text_local;
                repaired_candidate_local.comment := '';
                repaired_candidate_local.source := cs_rule;
            end;
            repaired_candidate_local.score := Max(
                repaired_candidate_local.score + c_repair_base_bonus +
                total_repair_score_local,
                candidates[0].score + c_repair_base_bonus +
                total_repair_score_local);
            repaired_candidate_local.has_dict_weight := True;
            repaired_candidate_local.dict_weight := repaired_candidate_local.score;
            repaired_path_local := build_repaired_segment_path_local;
            if repaired_path_local <> '' then
            begin
                remember_segment_path_for_candidate(repaired_text_local, '',
                    repaired_path_local, repaired_candidate_local.score);
            end;

            if existing_idx_local > 0 then
            begin
                path_count_matches_local := Length(m_candidate_segment_paths) =
                    Length(candidates);
                for local_idx := existing_idx_local downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                    if path_count_matches_local then
                    begin
                        m_candidate_segment_paths[local_idx] :=
                            m_candidate_segment_paths[local_idx - 1];
                    end;
                end;
                candidates[0] := repaired_candidate_local;
                if path_count_matches_local then
                begin
                    m_candidate_segment_paths[0] := repaired_path_local;
                end;
            end
            else
            begin
                candidate_count_before_local := Length(candidates);
                path_count_matches_local := Length(m_candidate_segment_paths) =
                    candidate_count_before_local;
                SetLength(candidates, Length(candidates) + 1);
                if path_count_matches_local then
                begin
                    SetLength(m_candidate_segment_paths, Length(candidates));
                end;
                for local_idx := High(candidates) downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                    if path_count_matches_local then
                    begin
                        m_candidate_segment_paths[local_idx] :=
                            m_candidate_segment_paths[local_idx - 1];
                    end;
                end;
                candidates[0] := repaired_candidate_local;
                if path_count_matches_local then
                begin
                    m_candidate_segment_paths[0] := repaired_path_local;
                end;
            end;

            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' exactrepair=[text=%s score=%d]',
                    [repaired_text_local, total_repair_score_local]);
            end;
        end;

    var
        query_key_local: string;
        current_text_local: string;
        best_text_local: string;
        best_weight_local: Integer;
        current_weight_local: Integer;
        split_text_local: string;
        split_weight_local: Integer;
        modifier_text_local: string;
        modifier_weight_local: Integer;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count < c_min_syllables) or
            (Trim(candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(candidates[0].text)) <>
            input_syllable_count) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(candidates[0].text));
        if Length(top_units_local) <> input_syllable_count then
        begin
            Exit;
        end;

        repaired_units_local := Copy(top_units_local);
        SetLength(occupied_units_local, input_syllable_count);
        total_repair_score_local := 0;

        for span_len_local := Min(c_max_span, input_syllable_count) downto 2 do
        begin
            for start_idx_local := 0 to input_syllable_count - span_len_local do
            begin
                if any_occupied_local(start_idx_local, span_len_local) then
                begin
                    Continue;
                end;

                query_key_local := build_query_key_local(start_idx_local,
                    span_len_local);
                current_text_local := join_units_local(start_idx_local,
                    span_len_local);
                if (query_key_local = '') or (current_text_local = '') or
                    (not try_pick_best_exact_span_text_local(query_key_local,
                    span_len_local, current_text_local, start_idx_local,
                    best_text_local, best_weight_local,
                    current_weight_local)) then
                begin
                    Continue;
                end;

                if try_pick_split_single_span_text_local(start_idx_local,
                    current_text_local, current_weight_local,
                    split_text_local, split_weight_local) then
                begin
                    best_text_local := split_text_local;
                    best_weight_local := split_weight_local;
                end;

                if SameText(best_text_local, current_text_local) then
                begin
                    Continue;
                end;

                if (span_len_local >= 3) and
                    is_modifier_tail_syllable_for_repair_local(
                    start_idx_local + span_len_local - 1) and
                    (not replacement_extends_current_prefix_local(best_text_local,
                    start_idx_local, span_len_local)) then
                begin
                    Continue;
                end;

                if should_preserve_strong_prefix_boundary_local(
                    start_idx_local, span_len_local, best_text_local) then
                begin
                    Continue;
                end;

                if should_preserve_single_plus_phrase_boundary_local(
                    start_idx_local, span_len_local, best_text_local) then
                begin
                    Continue;
                end;

                if should_preserve_top_path_exact_segment_local(
                    start_idx_local, span_len_local, best_text_local) then
                begin
                    Continue;
                end;

                if should_preserve_phrase_plus_modifier_boundary_local(
                    start_idx_local, span_len_local) and
                    (not replacement_extends_current_prefix_local(best_text_local,
                    start_idx_local, span_len_local)) then
                begin
                    Continue;
                end;

                if should_preserve_modifier_plus_phrase_boundary_local(
                    start_idx_local, span_len_local) or
                    (current_span_has_strong_exact_split_local(start_idx_local,
                    span_len_local) and
                    (best_weight_local < c_strong_split_override_weight)) or
                    (not should_replace_span_local(best_text_local,
                    best_weight_local, current_text_local,
                    current_weight_local)) then
                begin
                    Continue;
                end;

                apply_span_repair_local(start_idx_local, span_len_local,
                    best_text_local);
                Inc(total_repair_score_local,
                    best_weight_local + (span_len_local * 768));
            end;
        end;

        for start_idx_local := 0 to input_syllable_count - 1 do
        begin
            if any_occupied_local(start_idx_local, 1) then
            begin
                Continue;
            end;
            if current_unit_is_inside_exact_phrase_for_repair_local(
                start_idx_local) then
            begin
                Continue;
            end;
            current_text_local := join_units_local(start_idx_local, 1);
            if try_pick_modifier_single_repair_local(start_idx_local,
                current_text_local, modifier_text_local, modifier_weight_local) and
                (not SameText(modifier_text_local, current_text_local)) then
            begin
                apply_span_repair_local(start_idx_local, 1,
                    modifier_text_local);
                Inc(total_repair_score_local, modifier_weight_local + 512);
            end;
        end;

        if total_repair_score_local > 0 then
        begin
            promote_repaired_candidate_local;
        end;
    end;

    procedure ensure_high_quality_complete_candidate_in_top2(
        var candidates: TncCandidateList);
    const
        c_probe_limit = 32;
        c_max_path_segment_units = 5;
        c_promote_to_second_margin = 900;
        c_promote_to_first_margin = 2400;
    var
        syllables_local: TncPinyinParseResult;
        expected_units_local: Integer;
        best_idx_local: Integer;
        best_quality_local: Integer;
        idx_local: Integer;
        candidate_quality_local: Integer;
        top_quality_local: Integer;
        second_quality_local: Integer;
        moved_candidate_local: TncCandidate;
        best_two_text_cache_local: TArray<string>;
        best_two_weight_cache_local: TArray<Integer>;
        best_two_known_cache_local: TArray<Boolean>;

        function build_query_key_local(const local_start_idx: Integer;
            const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_len <= 0) or
                (local_start_idx + local_span_len >
                Length(syllables_local)) then
            begin
                Exit;
            end;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function is_complete_candidate_local(
            const candidate: TncCandidate): Boolean;
        begin
            Result := (Trim(candidate.comment) = '') and
                (get_candidate_text_unit_count(Trim(candidate.text)) =
                expected_units_local);
        end;

        function get_exact_segment_quality_local(
            const query_key_value: string; const text_value: string;
            const segment_units_value: Integer): Integer;
        var
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            weight_local: Integer;
        begin
            Result := -900 - (segment_units_value * 220);
            if (query_key_value = '') or (text_value = '') or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            if not m_dictionary.lookup_exact_full_pinyin(query_key_value,
                exact_results_local) then
            begin
                Exit;
            end;

            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if result_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[result_idx_local].text);
                if not SameText(candidate_text_local, text_value) then
                begin
                    Continue;
                end;

                weight_local := exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight and
                    (exact_results_local[result_idx_local].dict_weight >
                    weight_local) then
                begin
                    weight_local := exact_results_local[result_idx_local].dict_weight;
                end;

                Result := 900 + Min(weight_local, 2400) +
                    ((c_probe_limit - result_idx_local) * 140) +
                    (segment_units_value * 180);
                if segment_units_value >= 3 then
                begin
                    Inc(Result, 520);
                end;
                if segment_units_value >= 4 then
                begin
                    Inc(Result, 2400);
                end;
                Exit;
            end;
        end;

        function try_get_best_exact_two_unit_text_local(
            const local_start_idx: Integer; out out_text: string;
            out out_weight: Integer): Boolean;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            best_score_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (local_start_idx < 0) or
                (local_start_idx + 2 > Length(syllables_local)) or
                (local_start_idx >= Length(best_two_known_cache_local)) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            if best_two_known_cache_local[local_start_idx] then
            begin
                out_text := best_two_text_cache_local[local_start_idx];
                out_weight := best_two_weight_cache_local[local_start_idx];
                Exit(out_text <> '');
            end;

            best_two_known_cache_local[local_start_idx] := True;
            query_key_local := build_query_key_local(local_start_idx, 2);
            if (query_key_local = '') or
                (not m_dictionary.lookup_exact_full_pinyin(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            best_score_local := Low(Integer);
            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if result_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[result_idx_local].text);
                if get_candidate_text_unit_count(candidate_text_local) <> 2 then
                begin
                    Continue;
                end;

                candidate_weight_local :=
                    exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight and
                    (exact_results_local[result_idx_local].dict_weight >
                    candidate_weight_local) then
                begin
                    candidate_weight_local :=
                        exact_results_local[result_idx_local].dict_weight;
                end;
                Inc(candidate_weight_local,
                    (c_probe_limit - result_idx_local) * 32);

                if candidate_weight_local > best_score_local then
                begin
                    best_score_local := candidate_weight_local;
                    best_two_text_cache_local[local_start_idx] :=
                        candidate_text_local;
                    best_two_weight_cache_local[local_start_idx] :=
                        candidate_weight_local;
                end;
            end;

            out_text := best_two_text_cache_local[local_start_idx];
            out_weight := best_two_weight_cache_local[local_start_idx];
            Result := out_text <> '';
        end;

        function try_get_best_exact_span_text_local(
            const local_start_idx: Integer; const local_span_len: Integer;
            out out_text: string; out out_weight: Integer): Boolean;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            best_score_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (local_start_idx < 0) or (local_span_len < 2) or
                (local_start_idx + local_span_len > Length(syllables_local)) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            query_key_local := build_query_key_local(local_start_idx,
                local_span_len);
            if (query_key_local = '') or
                (not m_dictionary.lookup_exact_full_pinyin(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            best_score_local := Low(Integer);
            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if result_idx_local >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[result_idx_local].text);
                if get_candidate_text_unit_count(candidate_text_local) <>
                    local_span_len then
                begin
                    Continue;
                end;

                candidate_weight_local :=
                    exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight and
                    (exact_results_local[result_idx_local].dict_weight >
                    candidate_weight_local) then
                begin
                    candidate_weight_local :=
                        exact_results_local[result_idx_local].dict_weight;
                end;
                Inc(candidate_weight_local,
                    (c_probe_limit - result_idx_local) * 32);

                if candidate_weight_local > best_score_local then
                begin
                    best_score_local := candidate_weight_local;
                    out_text := candidate_text_local;
                    out_weight := candidate_weight_local;
                    Result := True;
                end;
            end;
        end;

