            case Ord(unit_value[1]) of
                $6025, $822C, $5F85, $987E, $7EC6, $5927, $5C0F, $9AD8,
                $4F4E, $5FEB, $6162, $6DF1, $6D45, $8F7B, $91CD, $9759,
                $9ED8, $6781, $529B, $5FC3, $610F, $7136, $65AD, $7EED,
                $76F4, $660E, $786E, $6E05, $695A, $6084, $5174,
                $597D, $4E3B, $529F, $82E6, $4E25, $5BC6, $5B9A, $7A33,
                $51C6, $6EE1, $575A, $51B3, $6027, $7ECF, $5916, $89C9,
                $51C0, $901F, $987A, $631A, $6FC0, $594B, $548C, $7981,
                $601D, $8BB6, $7545, $8352, $56F4, $6599, $8D45, $5947,
