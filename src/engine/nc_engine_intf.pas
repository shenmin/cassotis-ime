        function get_function_particle_suffix_context_adjustment_local(
            const chunk_last_syllable_local: string; const chunk_text_local: string;
            const suffix_text_local: string): Integer;
        var
            last_unit_local: string;
            suffix_first_unit_local: string;
            last_syllable_local: string;
            predicate_suffix_local: Boolean;
            de_adverbial_suffix_local: Boolean;
            complement_suffix_local: Boolean;
            location_suffix_local: Boolean;
            chunk_units_local: TArray<string>;
            chunk_left_unit_local: string;
        begin
            Result := 0;
            if (chunk_last_syllable_local = '') or (chunk_text_local = '') or
                (suffix_text_local = '') then
            begin
                Exit;
            end;

            last_unit_local := get_last_text_unit_context_local(chunk_text_local);
            if (last_unit_local = '') or
                ((not is_text_unit_code_context_local(last_unit_local, $7684)) and
                (not is_text_unit_code_context_local(last_unit_local, $5730)) and
                (not is_text_unit_code_context_local(last_unit_local, $5F97)) and
                (not is_text_unit_code_context_local(last_unit_local, $518D)) and
                (not is_text_unit_code_context_local(last_unit_local, $5728)) and
                (not is_text_unit_code_context_local(last_unit_local, $4E00)) and
                (not is_text_unit_code_context_local(last_unit_local, $4EE5)) and
                (not is_text_unit_code_context_local(last_unit_local, $7740)) and
                (not is_text_unit_code_context_local(last_unit_local, $8FD9)) and
                (not is_text_unit_code_context_local(last_unit_local, $4E3A)) and
                (not is_text_unit_code_context_local(last_unit_local, $672A)) and
                (not is_text_unit_code_context_local(last_unit_local, $4E0E)) and
                (not is_text_unit_code_context_local(last_unit_local, $4E8E))) then
            begin
                Exit;
            end;

            last_syllable_local := normalize_pinyin_text(
                chunk_last_syllable_local);

            suffix_first_unit_local :=
                get_first_text_unit_context_local(suffix_text_local);
            predicate_suffix_local :=
                is_predicate_head_unit_context_local(suffix_first_unit_local);
            de_adverbial_suffix_local :=
                is_de_adverbial_predicate_head_unit_context_local(
                suffix_first_unit_local);
            complement_suffix_local :=
                is_result_complement_head_unit_context_local(
                suffix_first_unit_local);
            location_suffix_local :=
                is_location_or_measure_head_unit_context_local(
                suffix_first_unit_local);
            chunk_left_unit_local := '';
            chunk_units_local := split_text_units(Trim(chunk_text_local));
            if Length(chunk_units_local) >= 2 then
            begin
                chunk_left_unit_local := chunk_units_local[
                    High(chunk_units_local) - 1];
            end;

            if last_syllable_local = 'de' then
            begin
                if is_text_unit_code_context_local(last_unit_local, $5730) then
                begin
                    if de_adverbial_suffix_local then
                    begin
                        Inc(Result, 16000);
                    end
                    else
                    begin
                        Dec(Result, 82000);
                    end;
                end
                else if is_text_unit_code_context_local(last_unit_local, $5F97) then
                begin
                    if complement_suffix_local then
                    begin
                        Inc(Result, 12000);
                    end
                    else
                    begin
                        Dec(Result, 52000);
                    end;
                end
                else if is_text_unit_code_context_local(last_unit_local, $7684) then
                begin
                    if de_adverbial_suffix_local and (not location_suffix_local) then
                    begin
                        if is_de_adverbial_left_unit_context_local(
                            chunk_left_unit_local) then
                        begin
                            Dec(Result, 26000);
                        end;
                    end
                    else
                    begin
                        Inc(Result, 1500);
                    end;
                end;
            end
            else if last_syllable_local = 'zai' then
            begin
                if is_text_unit_code_context_local(last_unit_local, $518D) and
                    predicate_suffix_local then
                begin
                    Inc(Result, 6000);
                end
                else if is_text_unit_code_context_local(last_unit_local, $5728) and
                    location_suffix_local then
                begin
                    Inc(Result, 4500);
                end;
            end
            else if last_syllable_local = 'yi' then
            begin
                if is_text_unit_code_context_local(last_unit_local, $4EE5) and
                    ((suffix_first_unit_local = string(Char($4E3A))) or
                    (suffix_first_unit_local = string(Char($53CA))) or
                    (suffix_first_unit_local = string(Char($540E))) or
                    (suffix_first_unit_local = string(Char($524D))) or
                    (suffix_first_unit_local = string(Char($6765))) or
                    (suffix_first_unit_local = string(Char($4E0A))) or
                    (suffix_first_unit_local = string(Char($4E0B))) or
                    is_yi_preposition_suffix_head_context_local(
                    suffix_first_unit_local)) then
                begin
                    Inc(Result, 5000);
                end
                else if is_text_unit_code_context_local(last_unit_local, $4E00) and
                    is_yi_preposition_suffix_head_context_local(
                    suffix_first_unit_local) then
                begin
                    Dec(Result, 4500);
