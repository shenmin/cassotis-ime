        function get_de_particle_context_score_local(
            const previous_segment_text: string; const current_segment_text: string;
            const next_segment_text: string): Integer;
        var
            current_first_unit_local: string;
            current_last_unit_local: string;
            previous_last_unit_local: string;
            next_units_local: Integer;
            next_is_verbal_local: Boolean;
        begin
            Result := 0;
            if current_segment_text = '' then
            begin
                Exit;
            end;

            current_first_unit_local := get_first_text_unit_local(
                current_segment_text);
            current_last_unit_local := get_last_text_unit_local(
                current_segment_text);
            if (current_last_unit_local <> string(Char($7684))) and
                (current_last_unit_local <> string(Char($5730))) then
            begin
                Exit;
            end;

            previous_last_unit_local := get_last_text_unit_local(
                previous_segment_text);
            next_units_local := get_candidate_text_unit_count(
                next_segment_text);
            next_is_verbal_local :=
                is_likely_verbal_following_segment_local(next_segment_text);

            if current_last_unit_local = string(Char($5730)) then
            begin
                if SameText(previous_last_unit_local, string(Char($822C))) or
                    SameText(current_first_unit_local, string(Char($822C))) then
                begin
                    Inc(Result, 6000);
                end;
                if next_segment_text <> '' then
                begin
                    if next_is_verbal_local then
                    begin
                        Inc(Result, 9000);
                    end
                    else if next_units_local >= 2 then
                    begin
                        Dec(Result, 14000);
                    end;
                end;
            end
            else if current_last_unit_local = string(Char($7684)) then
            begin
                if (SameText(previous_last_unit_local, string(Char($822C))) or
                    SameText(current_first_unit_local, string(Char($822C)))) and
                    next_is_verbal_local then
                begin
                    Dec(Result, 14000);
                end
                else if (next_segment_text <> '') and (next_units_local >= 2) and
                    (not next_is_verbal_local) then
                begin
                    Inc(Result, 9000);
                end;
            end;
        end;

        function get_indexed_segment_path_local(
            const candidate: TncCandidate; const candidate_index: Integer): string;
        begin
            Result := '';
            if (candidate_index >= 0) and
                (candidate_index < Length(m_candidate_segment_paths)) then
            begin
                Result := m_candidate_segment_paths[candidate_index];
                Exit;
            end;
            Result := get_segment_path_for_candidate(candidate);
        end;

        function top_complete_path_is_stable_without_repair: Boolean;
        var
            encoded_path_local: string;
            segment_parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_text_local: string;
            next_segment_text_local: string;
            previous_segment_text_local: string;
            segment_units_local: Integer;
            previous_was_single_local: Boolean;
            multi_segment_count_local: Integer;
            effective_score_local: Integer;
            particle_context_score_local: Integer;
        begin
            Result := False;
            if (Length(candidates) = 0) or
                (not is_complete_candidate_local(candidates[0])) then
            begin
                Exit;
            end;
            if get_fixed_quantity_alignment_score_local(candidates[0]) < 0 then
            begin
                Exit;
            end;

            effective_score_local := candidates[0].score;
            if candidates[0].has_dict_weight and
                (candidates[0].dict_weight > effective_score_local) then
            begin
                effective_score_local := candidates[0].dict_weight;
            end;
            if (candidates[0].source <> cs_user) and
                (effective_score_local < 50000) then
            begin
                Exit;
            end;

            encoded_path_local := get_indexed_segment_path_local(candidates[0], 0);
            if get_encoded_path_segment_count_local(encoded_path_local) <= 1 then
            begin
                Exit;
            end;

            segment_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            previous_was_single_local := False;
            multi_segment_count_local := 0;
            previous_segment_text_local := '';
            for part_idx_local := 0 to High(segment_parts_local) do
            begin
                segment_text_local := Trim(segment_parts_local[part_idx_local]);
                next_segment_text_local := '';
                if part_idx_local < High(segment_parts_local) then
                begin
                    next_segment_text_local :=
                        Trim(segment_parts_local[part_idx_local + 1]);
                end;
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if segment_units_local <= 0 then
                begin
                    Exit;
                end;

                particle_context_score_local :=
                    get_de_particle_context_score_local(
                    previous_segment_text_local, segment_text_local,
                    next_segment_text_local);
                if particle_context_score_local < -8000 then
                begin
                    Exit;
                end;

                if segment_units_local = 1 then
                begin
                    if previous_was_single_local or
                        (not is_function_or_modifier_single_quality_local(
                        segment_text_local)) then
                    begin
                        Exit;
                    end;
                    previous_was_single_local := True;
                    previous_segment_text_local := segment_text_local;
                    Continue;
                end;

                previous_was_single_local := False;
                Inc(multi_segment_count_local);
                previous_segment_text_local := segment_text_local;
            end;

            Result := multi_segment_count_local >= 2;
        end;

        function get_candidate_path_quality_local(
            const candidate: TncCandidate; const candidate_index: Integer): Integer;
        var
            encoded_path_local: string;
            segment_parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            segment_start_local: Integer;
            query_key_local: string;
            prev_segment_text_local: string;
            prev_prev_segment_text_local: string;
            prev_single_text_local: string;
            prev_single_start_local: Integer;
            prev_was_single_local: Boolean;
            pair_text_local: string;
            best_pair_text_local: string;
            best_pair_weight_local: Integer;
            next_segment_text_local: string;
            next_segment_units_local: Integer;
            combined_text_local: string;
            combined_units_local: Integer;
            best_span_text_local: string;
            best_span_weight_local: Integer;
            next_segment_units_text_local: TArray<string>;
        begin
            Result := 0;
            if not is_complete_candidate_local(candidate) then
            begin
                Exit(Low(Integer) div 4);
            end;

            if candidate.source = cs_user then
            begin
                Inc(Result, 5000);
            end;
            Inc(Result, get_fixed_quantity_alignment_score_local(candidate));

            if (m_dictionary <> nil) and
                m_dictionary.is_base_entry(lookup_text, Trim(candidate.text)) then
            begin
                Inc(Result, 12000);
            end;

            encoded_path_local := get_indexed_segment_path_local(candidate,
                candidate_index);
            if get_encoded_path_segment_count_local(encoded_path_local) <= 1 then
            begin
                Dec(Result, 12000);
                Exit;
            end;

            segment_parts_local := encoded_path_local.Split(
                [c_segment_path_separator]);
            segment_start_local := 0;
            prev_segment_text_local := '';
            prev_prev_segment_text_local := '';
            prev_single_text_local := '';
            prev_single_start_local := -1;
            prev_was_single_local := False;
            for part_idx_local := 0 to High(segment_parts_local) do
            begin
                segment_text_local := Trim(segment_parts_local[part_idx_local]);
                segment_units_local :=
                    get_candidate_text_unit_count(segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) or
                    (segment_start_local + segment_units_local >
                    expected_units_local) then
                begin
                    Dec(Result, 16000);
                    Exit;
                end;

                next_segment_text_local := '';
                if part_idx_local < High(segment_parts_local) then
                begin
                    next_segment_text_local :=
                        Trim(segment_parts_local[part_idx_local + 1]);
                end;
                Inc(Result, get_de_particle_context_score_local(
                    prev_segment_text_local, segment_text_local,
                    next_segment_text_local));

                if segment_units_local > c_max_path_segment_units then
                begin
                    Dec(Result, 6000 + (segment_units_local * 400));
                end;

                if (segment_units_local = 1) and
                    (part_idx_local < High(segment_parts_local)) then
                begin
                    next_segment_units_local := get_candidate_text_unit_count(
                        next_segment_text_local);
                    combined_units_local := segment_units_local +
                        next_segment_units_local;
                    if (next_segment_text_local <> '') and
                        (combined_units_local >= 3) and
                        (combined_units_local <= 4) and
                        try_get_best_exact_span_text_local(segment_start_local,
                        combined_units_local, best_span_text_local,
                        best_span_weight_local) then
                    begin
                        combined_text_local := segment_text_local +
                            next_segment_text_local;
                        if (best_span_weight_local >= 900) and
                            (not SameText(best_span_text_local,
                            combined_text_local)) then
                        begin
                            Dec(Result, 9000 + Min(9000,
                                best_span_weight_local));
                        end;
                    end;

                    // Penalize an off-by-one split such as A/BC when AB is a
                    // strong phrase. This keeps complete long-sentence paths
                    // from preferring self-composed tails over phrase-aligned
                    // paths.
                    if next_segment_units_local = 2 then
                    begin
                        next_segment_units_text_local := split_text_units(
                            next_segment_text_local);
                        if (Length(next_segment_units_text_local) = 2) and
                            try_get_best_exact_two_unit_text_local(
                            segment_start_local, best_pair_text_local,
                            best_pair_weight_local) then
                        begin
                            pair_text_local := segment_text_local +
                                Trim(next_segment_units_text_local[0]);
                            if (best_pair_weight_local >= 520) and
                                (not SameText(best_pair_text_local,
                                pair_text_local)) then
                            begin
                                Dec(Result, 36000 +
                                    Min(16000, best_pair_weight_local * 4));
                            end;
                        end;
                    end;
                end;

                query_key_local := build_query_key_local(segment_start_local,
                    segment_units_local);
                Inc(Result, get_exact_segment_quality_local(query_key_local,
                    segment_text_local, segment_units_local));
                if (segment_units_local = 2) and
                    is_directional_location_phrase_text_local(
                    segment_text_local) and
                    (prev_segment_text_local <> '') and
                    (get_candidate_text_unit_count(prev_segment_text_local) >=
                    2) then
                begin
                    Inc(Result, 9600);
                end;
                if (segment_units_local = 2) and
                    try_get_best_exact_two_unit_text_local(segment_start_local,
                    best_pair_text_local, best_pair_weight_local) and
                    SameText(best_pair_text_local, segment_text_local) then
                begin
                    Inc(Result, 1800 + Min(1800, best_pair_weight_local div 2));
                end;
                if prev_segment_text_local <> '' then
                begin
                    Inc(Result, m_dictionary.get_context_bonus(
                        prev_segment_text_local, segment_text_local) * 4);
                    if prev_prev_segment_text_local <> '' then
                    begin
                        Inc(Result, m_dictionary.get_context_trigram_bonus(
                            prev_prev_segment_text_local,
                            prev_segment_text_local, segment_text_local) * 6);
                    end;
                end;
                if segment_units_local = 1 then
                begin
                    if prev_was_single_local and
                        (prev_single_start_local + 1 = segment_start_local) then
                    begin
                        pair_text_local := prev_single_text_local +
                            segment_text_local;
                        if try_get_best_exact_two_unit_text_local(
                            prev_single_start_local, best_pair_text_local,
                            best_pair_weight_local) then
                        begin
                            if SameText(best_pair_text_local, pair_text_local) then
                            begin
                                Inc(Result, 520 +
                                    Min(1200, best_pair_weight_local div 3));
                            end
                            else
                            begin
                                Dec(Result, 42000 +
                                    Min(18000, best_pair_weight_local * 4));
                            end;
                        end
                        else
                        begin
                            Dec(Result, 760);
                        end;
                    end;
                    if is_function_or_modifier_single_quality_local(
                        segment_text_local) then
                    begin
                        Inc(Result, 960);
                    end
                    else
                    begin
                        Dec(Result, 520);
                    end;
                    prev_was_single_local := True;
                    prev_single_text_local := segment_text_local;
                    prev_single_start_local := segment_start_local;
                end
                else
                begin
                    prev_was_single_local := False;
                    prev_single_text_local := '';
                    prev_single_start_local := -1;
                end;
                Inc(segment_start_local, segment_units_local);
                prev_prev_segment_text_local := prev_segment_text_local;
                prev_segment_text_local := segment_text_local;
            end;

            if segment_start_local <> expected_units_local then
            begin
                Dec(Result, 16000);
            end;
        end;

        procedure move_candidate_local(const from_idx: Integer;
            const to_idx: Integer);
        var
            local_idx: Integer;
            src_idx_local: Integer;
            candidate_count_local: Integer;
            moved_path_local: string;
            old_candidates_local: TncCandidateList;
            old_paths_local: TArray<string>;
        begin
            if (from_idx <= to_idx) or (from_idx < 0) or
                (from_idx > High(candidates)) or (to_idx < 0) then
            begin
                Exit;
            end;

            candidate_count_local := Length(candidates);
            moved_candidate_local := candidates[from_idx];
            moved_path_local := '';
            if from_idx < Length(m_candidate_segment_paths) then
            begin
                moved_path_local := m_candidate_segment_paths[from_idx];
            end;

            old_candidates_local := Copy(candidates);
            old_paths_local := Copy(m_candidate_segment_paths);
            SetLength(candidates, candidate_count_local);
            if Length(m_candidate_segment_paths) = candidate_count_local then
            begin
                SetLength(m_candidate_segment_paths, candidate_count_local);
            end;

            src_idx_local := 0;
            for local_idx := 0 to candidate_count_local - 1 do
            begin
                if local_idx = to_idx then
                begin
                    candidates[local_idx] := moved_candidate_local;
                    if local_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[local_idx] := moved_path_local;
                    end;
                    Continue;
                end;

                if src_idx_local = from_idx then
                begin
                    Inc(src_idx_local);
                end;
                if src_idx_local >= candidate_count_local then
                begin
                    Break;
                end;

                candidates[local_idx] := old_candidates_local[src_idx_local];
                if local_idx < Length(m_candidate_segment_paths) then
                begin
                    if src_idx_local < Length(old_paths_local) then
                    begin
                        m_candidate_segment_paths[local_idx] :=
                            old_paths_local[src_idx_local];
                    end
                    else
                    begin
                        m_candidate_segment_paths[local_idx] := '';
                    end;
                end;
                Inc(src_idx_local);
            end;
        end;

        procedure promote_best_fixed_quantity_tail_candidate_local;
        var
            local_idx: Integer;
            best_idx_quantity_local: Integer;
            best_score_quantity_local: Integer;
            candidate_alignment_local: Integer;
            candidate_score_local: Integer;
            top_alignment_local: Integer;
            top_score_local: Integer;
        begin
            best_idx_quantity_local := -1;
            best_score_quantity_local := Low(Integer);
            for local_idx := 0 to Min(8, High(candidates)) do
            begin
                candidate_alignment_local :=
                    get_fixed_quantity_alignment_score_local(candidates[local_idx]);
                if candidate_alignment_local <= 0 then
                begin
                    Continue;
                end;

                candidate_score_local := candidates[local_idx].score +
                    candidate_alignment_local;
                if candidate_score_local > best_score_quantity_local then
                begin
                    best_score_quantity_local := candidate_score_local;
                    best_idx_quantity_local := local_idx;
                end;
            end;

            if best_idx_quantity_local <= 0 then
            begin
                Exit;
            end;

            top_alignment_local :=
                get_fixed_quantity_alignment_score_local(candidates[0]);
            top_score_local := candidates[0].score + top_alignment_local;
            if (top_alignment_local > 0) and
                (top_score_local >= best_score_quantity_local - 2000) then
            begin
                Exit;
            end;

            if best_score_quantity_local < top_score_local + 8000 then
            begin
                Exit;
            end;

            move_candidate_local(best_idx_quantity_local, 0);
            m_candidates := candidates;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' qfixqty=[idx=%d score=%d text=%s]',
                    [best_idx_quantity_local, best_score_quantity_local -
                    top_score_local, Trim(candidates[0].text)]);
            end;
        end;

        procedure promote_best_scored_complete_candidate_local;
        const
            c_complete_score_promote_margin = 256;
        var
            local_idx: Integer;
            best_idx_local: Integer;
            best_score_local: Integer;
            candidate_score_local: Integer;
        begin
            if (Length(candidates) < 2) or
                (not is_complete_candidate_local(candidates[0])) then
            begin
                Exit;
            end;

            best_idx_local := 0;
            best_score_local := candidates[0].score;
            if candidates[0].has_dict_weight and
                (candidates[0].dict_weight > best_score_local) then
            begin
                best_score_local := candidates[0].dict_weight;
            end;

            for local_idx := 1 to Min(8, High(candidates)) do
            begin
                if not is_complete_candidate_local(candidates[local_idx]) then
                begin
                    Continue;
                end;
                candidate_score_local := candidates[local_idx].score;
                if candidates[local_idx].has_dict_weight and
                    (candidates[local_idx].dict_weight > candidate_score_local) then
                begin
                    candidate_score_local := candidates[local_idx].dict_weight;
                end;
                if candidate_score_local >
                    best_score_local + c_complete_score_promote_margin then
                begin
                    best_idx_local := local_idx;
                    best_score_local := candidate_score_local;
                end;
            end;

            if best_idx_local > 0 then
            begin
                move_candidate_local(best_idx_local, 0);
                m_candidates := candidates;
            end;
        end;

        begin
            if (Length(candidates) < 2) or (m_dictionary = nil) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            expected_units_local := input_syllable_count;
            if expected_units_local < 4 then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
            if Length(syllables_local) <> expected_units_local then
            begin
                Exit;
            end;
        SetLength(best_two_text_cache_local, expected_units_local);
        SetLength(best_two_weight_cache_local, expected_units_local);
        SetLength(best_two_known_cache_local, expected_units_local);
        promote_best_scored_complete_candidate_local;

        // A path that looks locally stable can still lose to a better complete
        // candidate already visible in top2/topN. Keep the quality comparison
        // active so long-sentence ranking can promote those candidates without
        // widening the search space.
        if is_complete_candidate_local(candidates[0]) and
            m_dictionary.is_base_entry(lookup_text, Trim(candidates[0].text)) then
        begin
            Exit;
        end;

        top_quality_local := get_candidate_path_quality_local(candidates[0], 0);
        second_quality_local := Low(Integer) div 4;
        if Length(candidates) > 1 then
        begin
            second_quality_local := get_candidate_path_quality_local(
                candidates[1], 1);
        end;

        best_idx_local := -1;
        best_quality_local := Low(Integer) div 4;
        for idx_local := 1 to Min(8, High(candidates)) do
        begin
            candidate_quality_local :=
                get_candidate_path_quality_local(candidates[idx_local],
                idx_local);
            if candidate_quality_local > best_quality_local then
            begin
                best_quality_local := candidate_quality_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local < 0 then
        begin
            Exit;
        end;

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' qeval=[idx=%d top=%d best=%d diff=%d text=%s]',
                [best_idx_local, top_quality_local, best_quality_local,
                best_quality_local - top_quality_local,
                Trim(candidates[best_idx_local].text)]);
        end;

        if best_quality_local >= top_quality_local + c_promote_to_first_margin then
        begin
            move_candidate_local(best_idx_local, 0);
            m_candidates := candidates;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' qpromote=[to=1 idx=%d q=%d text=%s]',
                    [best_idx_local, best_quality_local - top_quality_local,
                    Trim(candidates[0].text)]);
            end;
        end
        else if (best_idx_local > 1) and
            (best_quality_local >= second_quality_local +
            c_promote_to_second_margin) then
        begin
            move_candidate_local(best_idx_local, 1);
            m_candidates := candidates;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' qpromote=[to=2 idx=%d q=%d text=%s]',
                    [best_idx_local, best_quality_local - second_quality_local,
                    Trim(candidates[1].text)]);
            end;
        end;
        promote_best_fixed_quantity_tail_candidate_local;
    end;

    function get_preferred_exact_subspan_bonus_local(const query_key: string;
        const candidate_text: string): Integer;
    begin
        Result := 0;
    end;

    function try_resolve_best_exact_subspan_local(const start_idx: Integer;
        const span_syllables: Integer; out out_text: string; out out_score: Integer;
        out out_segments: Integer; out out_path: string; out out_has_anchor: Boolean;
        out out_anchor_units: Integer): Boolean;
    const
        c_state_unknown = 0;
        c_state_miss = 1;
        c_state_hit = 2;
        c_probe_limit = 8;
        c_span_max_syllables = 8;
        c_fixed_single_bonus = 1800;
        c_chunk_length_bonus = 1200;
        c_chunk_anchor_bonus = 3200;
        c_weak_fixed_head_exact_weight = 720;
        var
            syllable_count_local: Integer;
            oracle_preferred_text: string;
            oracle_preferred_bonus: Integer;
            standalone_promote_bonus_local: Integer;

        function get_fixed_boundary_single_char_local(
            const syllable_text: string): string;
        var
            normalized_syllable: string;
        begin
            Result := '';
            normalized_syllable := normalize_pinyin_text(syllable_text);
            if (normalized_syllable = 'qing') or
                (normalized_syllable = 'bei') then
            begin
                Exit;
            end;
            if normalized_syllable = 'dan' then
            begin
                Result := string(Char($4F46));
            end
            else if normalized_syllable = 'sui' then
            begin
                Result := string(Char($867D));
            end
            else if normalized_syllable = 'yi' then
            begin
                Result := string(Char($4E00));
            end
            else if normalized_syllable = 'wo' then
            begin
                Result := string(Char($6211));
            end
            else if normalized_syllable = 'ni' then
            begin
                Result := string(Char($4F60));
            end
            else if normalized_syllable = 'he' then
            begin
                Result := string(Char($548C));
            end
            else if normalized_syllable = 'qu' then
            begin
                Result := string(Char($53BB));
            end
            else if normalized_syllable = 'ye' then
            begin
                Result := string(Char($4E5F));
            end
            else if normalized_syllable = 'hui' then
            begin
                Result := string(Char($4F1A));
            end
            else if normalized_syllable = 'ba' then
            begin
                Result := string(Char($5427));
            end
            else if normalized_syllable = 'de' then
            begin
                Result := string(Char($7684));
            end
            else if normalized_syllable = 'zai' then
            begin
                Result := string(Char($5728));
            end
            else if normalized_syllable = 'zhe' then
            begin
                Result := string(Char($8FD9));
            end
            else if normalized_syllable = 'que' then
            begin
                Result := string(Char($5374));
            end
            else if normalized_syllable = 'bing' then
            begin
                Result := string(Char($5E76));
            end
            else if normalized_syllable = 'qie' then
            begin
                Result := string(Char($4E14));
            end;
        end;

        procedure prepare_exact_subspan_cache_local;
        var
            local_idx: Integer;
        begin
            if exact_subspan_cache_prepared then
            begin
                Exit;
            end;

            exact_subspan_cache_prepared := True;
            exact_subspan_cache_syllables := get_effective_compact_pinyin_syllables(lookup_text);
            if Length(exact_subspan_cache_syllables) <> input_syllable_count then
            begin
                SetLength(exact_subspan_cache_syllables, 0);
                Exit;
            end;

            syllable_count_local := Length(exact_subspan_cache_syllables);
            SetLength(exact_subspan_cache_states, syllable_count_local);
            SetLength(exact_subspan_cache_scores, syllable_count_local);
            SetLength(exact_subspan_cache_segments, syllable_count_local);
            SetLength(exact_subspan_cache_anchor_units, syllable_count_local);
            SetLength(exact_subspan_cache_has_anchor, syllable_count_local);
            SetLength(exact_subspan_cache_texts, syllable_count_local);
            SetLength(exact_subspan_cache_paths, syllable_count_local);
            SetLength(exact_subspan_single_cache_prepared, syllable_count_local);
            SetLength(exact_subspan_single_cache_texts, syllable_count_local);
            SetLength(exact_subspan_single_cache_weights, syllable_count_local);
            SetLength(exact_subspan_fixed_weight_cache_states,
                syllable_count_local);
            SetLength(exact_subspan_fixed_weight_cache_values,
                syllable_count_local);
            SetLength(exact_subspan_chunk_cache_prepared, syllable_count_local);
            SetLength(exact_subspan_chunk_cache_texts, syllable_count_local);
            SetLength(exact_subspan_chunk_cache_weights, syllable_count_local);
            for local_idx := 0 to syllable_count_local - 1 do
            begin
                SetLength(exact_subspan_cache_states[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_scores[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_segments[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_anchor_units[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_has_anchor[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_texts[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_cache_paths[local_idx], c_span_max_syllables + 1);
                SetLength(exact_subspan_chunk_cache_prepared[local_idx],
                    c_span_max_syllables + 1);
                SetLength(exact_subspan_chunk_cache_texts[local_idx],
                    c_span_max_syllables + 1);
                SetLength(exact_subspan_chunk_cache_weights[local_idx],
                    c_span_max_syllables + 1);
            end;
        end;

        function build_query_key_local(const local_start_idx: Integer;
            const local_span_syllables: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (local_start_idx < 0) or (local_span_syllables <= 0) or
                (local_start_idx + local_span_syllables - 1 > High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_span_syllables - 1 do
            begin
                Result := Result +
                    normalize_pinyin_text(exact_subspan_cache_syllables[local_idx].text);
            end;
        end;

        function subspan_has_fixed_boundary_local(const local_start_idx: Integer;
            const local_span_syllables: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            if (local_start_idx < 0) or (local_span_syllables <= 0) or
                (local_start_idx + local_span_syllables - 1 >
                High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            for local_idx := local_start_idx to
                local_start_idx + local_span_syllables - 1 do
            begin
                if get_fixed_boundary_single_char_local(
                    exact_subspan_cache_syllables[local_idx].text) <> '' then
                begin
                    Exit(True);
                end;
            end;
        end;

        function is_valid_cjk_phrase_text_local(const value: string;
            const expected_units: Integer): Boolean;
        var
            units: TArray<string>;
            unit_idx: Integer;
            codepoint: Integer;

            function try_get_codepoint_local(const unit_text: string;
                out out_codepoint: Integer): Boolean;
            begin
                Result := False;
                out_codepoint := 0;
                if unit_text = '' then
                begin
                    Exit;
                end;

                if Length(unit_text) = 1 then
                begin
                    out_codepoint := Ord(unit_text[1]);
                    Exit(True);
                end;

                if (Length(unit_text) = 2) and
                    (Ord(unit_text[1]) >= $D800) and
                    (Ord(unit_text[1]) <= $DBFF) and
                    (Ord(unit_text[2]) >= $DC00) and
                    (Ord(unit_text[2]) <= $DFFF) then
                begin
                    out_codepoint := ((Ord(unit_text[1]) - $D800) shl 10) +
                        (Ord(unit_text[2]) - $DC00) + $10000;
                    Exit(True);
                end;
            end;
        begin
            Result := False;
            if Trim(value) = '' then
            begin
                Exit;
            end;

            units := split_text_units(Trim(value));
            if Length(units) <> expected_units then
            begin
                Exit;
            end;

            for unit_idx := 0 to High(units) do
            begin
                if (not try_get_codepoint_local(units[unit_idx], codepoint)) or
                    (codepoint < $4E00) or (codepoint > $9FFF) then
                begin
                    Exit(False);
                end;
            end;

            Result := True;
        end;

        function try_get_best_subspan_standalone_query_candidate_local(
            const query_key_local: string; const expected_syllables: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        const
            c_subspan_oracle_probe_limit = 8;
        var
            cached_state_local: Integer;
            snapshot_candidates_local: TncCandidateList;
            snapshot_scores_local: TArray<Integer>;
            candidate_idx_local: Integer;
            candidate_local: TncCandidate;
            candidate_text_local: string;
            candidate_units_local: Integer;
            candidate_score_local: Integer;
            best_text_local: string;
            best_score_local: Integer;
            preferred_exact_bonus_local: Integer;
            preferred_text_local: string;
            preferred_bonus_local: Integer;
            support_score_local: Integer;
            support_segments_local: Integer;
            support_path_local: string;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            preferred_text_local := '';
            preferred_bonus_local := 0;
            if (query_key_local = '') or
                (not is_full_pinyin_key(query_key_local)) or
                (expected_syllables < 3) or (expected_syllables > 8) then
            begin
                Exit;
            end;
            if m_disable_subspan_standalone_oracle > 0 then
            begin
                Exit;
            end;
            try_get_preferred_query_phrase_text_local(query_key_local,
                preferred_text_local, preferred_bonus_local);

            if subspan_oracle_states = nil then
            begin
                subspan_oracle_states := TDictionary<string, Integer>.Create;
                subspan_oracle_texts := TDictionary<string, string>.Create;
                subspan_oracle_scores := TDictionary<string, Integer>.Create;
            end;

            if subspan_oracle_states.TryGetValue(query_key_local,
                cached_state_local) then
            begin
                if cached_state_local = 1 then
                begin
                    subspan_oracle_texts.TryGetValue(query_key_local, out_text);
                    subspan_oracle_scores.TryGetValue(query_key_local, out_score);
                    Exit(out_text <> '');
                end;
                Exit(False);
            end;

            if subspan_oracle_budget_remaining <= 0 then
            begin
                Exit;
            end;

            if subspan_oracle_engine = nil then
            begin
                subspan_oracle_config := m_config;
                subspan_oracle_config.debug_mode := False;
                subspan_oracle_config.max_candidates := 6;
                subspan_oracle_engine := TncEngine.Create(
                    subspan_oracle_config, False, False);
                inherit_search_budget_policy_to(subspan_oracle_engine);
            end;

            Dec(subspan_oracle_budget_remaining);
            subspan_oracle_states.AddOrSetValue(query_key_local, 3);
            subspan_oracle_engine.m_disable_subspan_standalone_oracle :=
                m_disable_subspan_standalone_oracle + 1;
            subspan_oracle_engine.reset;
            subspan_oracle_engine.m_composition_text := query_key_local;
            subspan_oracle_engine.build_candidates;

            SetLength(snapshot_candidates_local,
                Length(subspan_oracle_engine.m_candidates));
            SetLength(snapshot_scores_local,
                Length(subspan_oracle_engine.m_candidates));
            for candidate_idx_local := 0 to High(subspan_oracle_engine.m_candidates) do
            begin
                snapshot_candidates_local[candidate_idx_local] :=
                    subspan_oracle_engine.m_candidates[candidate_idx_local];
                snapshot_scores_local[candidate_idx_local] :=
                    subspan_oracle_engine.get_rank_score(
                    subspan_oracle_engine.m_candidates[candidate_idx_local]);
            end;

            best_text_local := '';
            best_score_local := Low(Integer);
            for candidate_idx_local := 0 to High(snapshot_candidates_local) do
            begin
                if candidate_idx_local >= c_subspan_oracle_probe_limit then
                begin
                    Break;
                end;

                candidate_local := snapshot_candidates_local[candidate_idx_local];
                if Trim(candidate_local.comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(candidate_local.text);
                candidate_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                if (candidate_units_local <> expected_syllables) or
                    (not is_valid_cjk_phrase_text_local(candidate_text_local,
                    expected_syllables)) then
                begin
                    Continue;
                end;

                candidate_score_local :=
                    snapshot_scores_local[candidate_idx_local] +
                    get_preferred_query_phrase_bonus_local(query_key_local,
                    candidate_text_local);
                preferred_exact_bonus_local :=
                    get_preferred_exact_subspan_bonus_local(query_key_local,
                    candidate_text_local);
                if preferred_exact_bonus_local > 0 then
                begin
                    Inc(candidate_score_local,
                        preferred_exact_bonus_local + 12000);
                end;
                support_path_local := infer_segment_path_for_query_text_with_score(
                    query_key_local, candidate_text_local, support_score_local,
                    support_segments_local);
                if support_path_local <> '' then
                begin
                    Inc(candidate_score_local, support_score_local);
                    Inc(candidate_score_local,
                        Max(0, 2048 - (support_segments_local * 128)));
                end
                else
                begin
                    Dec(candidate_score_local, 2048);
                end;

                if candidate_score_local > best_score_local then
                begin
                    best_score_local := candidate_score_local;
                    best_text_local := candidate_text_local;
                end;

                // The child engine has already applied the full candidate
                // ordering rules.  Do not let a later synthetic candidate with
                // an inflated internal rank score override the child top
                // complete result when resolving a sentence subspan.
                if candidate_idx_local = 0 then
                begin
                    Break;
                end;
            end;

            if best_text_local <> '' then
            begin
                out_text := best_text_local;
                out_score := best_score_local;
                subspan_oracle_states.AddOrSetValue(query_key_local, 1);
                subspan_oracle_texts.AddOrSetValue(query_key_local, out_text);
                subspan_oracle_scores.AddOrSetValue(query_key_local, out_score);
                Exit(True);
            end;

            subspan_oracle_states.AddOrSetValue(query_key_local, 2);
        end;

        function try_get_best_direct_exact_candidate_local(
            const local_start_idx: Integer; const local_span_syllables: Integer;
            out resolved_text: string; out resolved_score: Integer;
            out resolved_has_anchor: Boolean; out resolved_anchor_units: Integer;
            out resolved_exact_bonus: Integer): Boolean;
        const
            c_direct_probe_limit = 8;
            c_direct_rank_step = 240;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            exact_only_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_units_local: Integer;
            base_weight_local: Integer;
            best_score_local: Integer;
            best_text_local: string;
            best_anchor_units_local: Integer;
            best_has_anchor_local: Boolean;
            exact_bonus_local: Integer;
            preferred_text_local: string;
            preferred_bonus_local: Integer;
            preferred_base_weight_local: Integer;

            function preferred_phrase_matches_local: Boolean;
            begin
                Result := is_valid_cjk_phrase_text_local(preferred_text_local,
                    local_span_syllables);
            end;
        begin
            Result := False;
            resolved_text := '';
            resolved_score := 0;
            resolved_has_anchor := False;
            resolved_anchor_units := -1;
            resolved_exact_bonus := 0;
            if (local_span_syllables <= 1) then
            begin
                Exit;
            end;

            query_key_local := build_query_key_local(local_start_idx,
                local_span_syllables);
            if query_key_local = '' then
            begin
                Exit;
            end;

            preferred_text_local := '';
            preferred_bonus_local := 0;
            best_score_local := Low(Integer);
            best_text_local := '';
            best_anchor_units_local := -1;
            best_has_anchor_local := False;
            if try_get_preferred_query_phrase_text_local(query_key_local,
                preferred_text_local, preferred_bonus_local) and
                preferred_phrase_matches_local then
            begin
                preferred_base_weight_local := preferred_bonus_local +
                    (c_direct_probe_limit * c_direct_rank_step) + 12000;
                if local_span_syllables >= 3 then
                begin
                    Inc(preferred_base_weight_local, 12000);
                end;
                best_score_local := preferred_base_weight_local;
                best_text_local := preferred_text_local;
                best_has_anchor_local := local_span_syllables >= 3;
                if best_has_anchor_local then
                begin
                    best_anchor_units_local := local_span_syllables;
                    resolved_exact_bonus := Max(resolved_exact_bonus,
                        preferred_bonus_local);
                end
                else
                begin
                    best_anchor_units_local := 0;
                end;
                Result := True;
            end;

            SetLength(exact_results_local, 0);
            if lookup_exact_full_pinyin_cached_local(query_key_local,
                exact_only_results_local) then
            begin
                for result_idx_local := 0 to High(exact_only_results_local) do
                begin
                    SetLength(exact_results_local, Length(exact_results_local) + 1);
                    exact_results_local[High(exact_results_local)] :=
                        exact_only_results_local[result_idx_local];
                end;
            end;

            if Length(exact_results_local) = 0 then
            begin
                if not Result then
                begin
                    Exit;
                end;
            end;

            for result_idx_local := 0 to High(exact_results_local) do
            begin
                if result_idx_local >= c_direct_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(exact_results_local[result_idx_local]) or
                    is_runtime_common_pattern_candidate(exact_results_local[result_idx_local]) or
                    is_runtime_redup_candidate(exact_results_local[result_idx_local]) then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(exact_results_local[result_idx_local].text);
                candidate_units_local := get_candidate_text_unit_count(candidate_text_local);
                if candidate_units_local <> local_span_syllables then
                begin
                    Continue;
                end;
                if not is_valid_cjk_phrase_text_local(candidate_text_local,
                    local_span_syllables) then
                begin
                    Continue;
                end;

                base_weight_local := exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight then
                begin
                    if local_span_syllables <= 2 then
                    begin
                        base_weight_local :=
                            exact_results_local[result_idx_local].dict_weight;
                    end
                    else if (base_weight_local <= 0) or
                        (exact_results_local[result_idx_local].dict_weight >
                        base_weight_local) then
                    begin
                        base_weight_local :=
                            exact_results_local[result_idx_local].dict_weight;
                    end;
                end;
                Inc(base_weight_local, get_preferred_query_phrase_bonus_local(
                    query_key_local, candidate_text_local));
                exact_bonus_local := get_preferred_exact_subspan_bonus_local(
                    query_key_local, candidate_text_local);
                Inc(base_weight_local, exact_bonus_local);
                if (preferred_text_local <> '') and
                    SameText(candidate_text_local, preferred_text_local) then
                begin
                    Inc(base_weight_local, 12000);
                    if local_span_syllables >= 3 then
                    begin
                        Inc(base_weight_local, 12000);
                    end;
                end;
                Inc(base_weight_local,
                    (c_direct_probe_limit - result_idx_local) * c_direct_rank_step);
                if (local_span_syllables >= 3) and (exact_bonus_local > 0) then
                begin
                    Inc(base_weight_local, 12000);
                end;

                resolved_score := base_weight_local +
                    (local_span_syllables * local_span_syllables * c_chunk_length_bonus);
                resolved_has_anchor := local_span_syllables >= 3;
                if resolved_has_anchor then
                begin
                    Inc(resolved_score, c_chunk_anchor_bonus);
                    resolved_anchor_units := local_span_syllables;
                end
                else
                begin
                    resolved_anchor_units := 0;
                end;

                if (not Result) or (resolved_score > best_score_local) or
                    ((resolved_score = best_score_local) and
                    (CompareText(candidate_text_local, best_text_local) < 0)) then
                begin
                    Result := True;
                    best_score_local := resolved_score;
                    best_text_local := candidate_text_local;
                    best_has_anchor_local := resolved_has_anchor;
                    best_anchor_units_local := resolved_anchor_units;
                    resolved_exact_bonus := exact_bonus_local;
                end;
            end;

            if not Result then
            begin
                Exit;
            end;

            resolved_text := best_text_local;
            resolved_score := best_score_local;
            resolved_has_anchor := best_has_anchor_local;
            resolved_anchor_units := best_anchor_units_local;
        end;

        function try_get_best_three_syllable_fixed_boundary_compound_local(
            const local_start_idx: Integer; out resolved_text: string;
            out resolved_score: Integer; out resolved_has_anchor: Boolean;
            out resolved_anchor_units: Integer): Boolean;
        const
            c_compound_probe_limit = 8;
            c_fixed_compound_bonus = 4096;
            c_fixed_boundary_tail_bonus = 1800;
        var
            local_query_key: string;
            head_query_key: string;
            tail_query_key: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            candidate_text_local: string;
            candidate_units_local: Integer;
            candidate_weight_local: Integer;
            fixed_head_text_local: string;
            fixed_tail_text_local: string;
            fixed_head_weight_local: Integer;
            fixed_tail_weight_local: Integer;
            pair_text_local: string;
            pair_bonus_local: Integer;

            function normalize_compound_weight_local(
                const raw_weight: Integer): Integer;
            begin
                Result := raw_weight;
                if Result > 240 then
                begin
                    Result := 240 + ((Result - 240) div 10);
                end;
            end;

            function get_effective_weight_local(
                const candidate: TncCandidate): Integer;
            begin
                Result := candidate.score;
                if candidate.has_dict_weight and
                    (candidate.dict_weight > Result) then
                begin
                    Result := candidate.dict_weight;
                end;
            end;

            function try_get_fixed_single_weight_local(
                const local_fixed_start_idx: Integer; const expected_text: string;
                out out_weight: Integer): Boolean;
            var
                local_key: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                candidate_weight: Integer;
            begin
                Result := False;
                out_weight := 0;
                if (expected_text = '') or (m_dictionary = nil) then
                begin
                    Exit;
                end;
                local_key := normalize_pinyin_text(
                    exact_subspan_cache_syllables[local_fixed_start_idx].text);
                if (local_key = '') or
                    (not lookup_exact_full_pinyin_cached_local(local_key,
                    local_results)) then
                begin
                    Exit;
                end;
                for local_idx := 0 to High(local_results) do
                begin
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if Trim(local_results[local_idx].text) <> expected_text then
                    begin
                        Continue;
                    end;
                    candidate_weight := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight > candidate_weight) then
                    begin
                        candidate_weight := local_results[local_idx].dict_weight;
                    end;
                    if candidate_weight > out_weight then
                    begin
                        out_weight := candidate_weight;
                    end;
                end;
                Result := out_weight > 0;
            end;

            procedure consider_pair_local(const left_text: string;
                const left_weight: Integer; const right_text: string;
                const right_weight: Integer);
            var
                combined_text_local: string;
                combined_score_local: Integer;
            begin
                if (left_text = '') or (right_text = '') then
                begin
                    Exit;
                end;
                combined_text_local := left_text + right_text;
                if (get_candidate_text_unit_count(combined_text_local) <> 3) or
                    (not is_valid_cjk_phrase_text_local(combined_text_local, 3)) then
                begin
                    Exit;
                end;

                combined_score_local :=
                    normalize_compound_weight_local(
                    left_weight + right_weight + c_fixed_compound_bonus) +
                    (3 * 3 * c_chunk_length_bonus) + c_chunk_anchor_bonus;
                if m_dictionary <> nil then
                begin
                    Inc(combined_score_local,
                        m_dictionary.get_context_bonus(left_text, right_text));
                    Inc(combined_score_local,
                        m_dictionary.get_base_text_prefix_bonus(
                        combined_text_local));
                end;
                Inc(combined_score_local,
                    get_preferred_exact_subspan_bonus_local(local_query_key,
                    combined_text_local));
                Inc(combined_score_local,
                    get_preferred_query_phrase_bonus_local(local_query_key,
                    combined_text_local));

                if (not Result) or (combined_score_local > resolved_score) or
                    ((combined_score_local = resolved_score) and
                    (CompareText(combined_text_local, resolved_text) < 0)) then
                begin
                    Result := True;
                    resolved_text := combined_text_local;
                    resolved_score := combined_score_local;
                    resolved_has_anchor := True;
                    resolved_anchor_units := 3;
                end;
            end;
        begin
            Result := False;
            resolved_text := '';
            resolved_score := 0;
            resolved_has_anchor := False;
            resolved_anchor_units := 0;
            if (local_start_idx < 0) or
                (local_start_idx + 2 > High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            local_query_key := build_query_key_local(local_start_idx, 3);
            if local_query_key = '' then
            begin
                Exit;
            end;

            fixed_tail_text_local := get_fixed_boundary_single_char_local(
                exact_subspan_cache_syllables[local_start_idx + 2].text);
            if fixed_tail_text_local <> '' then
            begin
                if not try_get_fixed_single_weight_local(local_start_idx + 2,
                    fixed_tail_text_local, fixed_tail_weight_local) then
                begin
                    fixed_tail_weight_local := 520;
                end;
                Inc(fixed_tail_weight_local, c_fixed_boundary_tail_bonus);
                tail_query_key := normalize_pinyin_text(
                    exact_subspan_cache_syllables[local_start_idx + 2].text);
                Inc(fixed_tail_weight_local,
                    get_preferred_query_phrase_bonus_local(tail_query_key,
                    fixed_tail_text_local));

                head_query_key := build_query_key_local(local_start_idx, 2);
                if (head_query_key <> '') and
                    lookup_exact_full_pinyin_cached_local(head_query_key,
                    exact_results_local) then
                begin
                    for exact_idx_local := 0 to High(exact_results_local) do
                    begin
                        if exact_idx_local >= c_compound_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if is_runtime_chain_candidate(exact_results_local[exact_idx_local]) or
                            is_runtime_common_pattern_candidate(exact_results_local[exact_idx_local]) or
                            is_runtime_redup_candidate(exact_results_local[exact_idx_local]) then
                        begin
                            Continue;
                        end;

                        candidate_text_local := Trim(
                            exact_results_local[exact_idx_local].text);
                        candidate_units_local := get_candidate_text_unit_count(
                            candidate_text_local);
                        if (candidate_units_local <> 2) or
                            (not is_valid_cjk_phrase_text_local(
                            candidate_text_local, 2)) then
                        begin
                            Continue;
                        end;

                        candidate_weight_local :=
                            get_effective_weight_local(
                            exact_results_local[exact_idx_local]);
                        Inc(candidate_weight_local,
                            get_preferred_exact_subspan_bonus_local(
                            head_query_key, candidate_text_local));
                        Inc(candidate_weight_local,
                            get_preferred_query_phrase_bonus_local(
                            head_query_key, candidate_text_local));
                        consider_pair_local(candidate_text_local,
                            candidate_weight_local, fixed_tail_text_local,
                            fixed_tail_weight_local);
                    end;
                end;
            end;

            fixed_head_text_local := get_fixed_boundary_single_char_local(
                exact_subspan_cache_syllables[local_start_idx].text);
            if fixed_head_text_local <> '' then
            begin
                if not try_get_fixed_single_weight_local(local_start_idx,
                    fixed_head_text_local, fixed_head_weight_local) then
                begin
                    fixed_head_weight_local := 520;
                end;
                Inc(fixed_head_weight_local, c_fixed_boundary_tail_bonus);
                head_query_key := normalize_pinyin_text(
                    exact_subspan_cache_syllables[local_start_idx].text);
                Inc(fixed_head_weight_local,
                    get_preferred_query_phrase_bonus_local(head_query_key,
                    fixed_head_text_local));

                tail_query_key := build_query_key_local(local_start_idx + 1, 2);
                if (tail_query_key <> '') and
                    lookup_exact_full_pinyin_cached_local(tail_query_key,
                    exact_results_local) then
                begin
                    for exact_idx_local := 0 to High(exact_results_local) do
                    begin
                        if exact_idx_local >= c_compound_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if is_runtime_chain_candidate(exact_results_local[exact_idx_local]) or
                            is_runtime_common_pattern_candidate(exact_results_local[exact_idx_local]) or
                            is_runtime_redup_candidate(exact_results_local[exact_idx_local]) then
                        begin
                            Continue;
                        end;

                        candidate_text_local := Trim(
                            exact_results_local[exact_idx_local].text);
                        candidate_units_local := get_candidate_text_unit_count(
                            candidate_text_local);
                        if (candidate_units_local <> 2) or
                            (not is_valid_cjk_phrase_text_local(
                            candidate_text_local, 2)) then
                        begin
                            Continue;
                        end;

                        candidate_weight_local :=
                            get_effective_weight_local(
                            exact_results_local[exact_idx_local]);
                        Inc(candidate_weight_local,
                            get_preferred_exact_subspan_bonus_local(
                            tail_query_key, candidate_text_local));
                        Inc(candidate_weight_local,
                            get_preferred_query_phrase_bonus_local(
                            tail_query_key, candidate_text_local));
                        consider_pair_local(fixed_head_text_local,
                            fixed_head_weight_local, candidate_text_local,
                            candidate_weight_local);
                    end;
                end;
            end;

            if (not Result) and
                try_get_preferred_query_phrase_text_local(local_query_key,
                pair_text_local, pair_bonus_local) and
                is_valid_cjk_phrase_text_local(pair_text_local, 3) then
            begin
                resolved_text := pair_text_local;
                resolved_score :=
                    normalize_compound_weight_local(
                    pair_bonus_local + c_fixed_compound_bonus) +
                    (3 * 3 * c_chunk_length_bonus) + c_chunk_anchor_bonus;
                resolved_has_anchor := True;
                resolved_anchor_units := 3;
                Result := True;
            end;
        end;

        function get_candidate_effective_weight_local(
            const candidate: TncCandidate; const chunk_syllables: Integer): Integer;
        begin
            Result := candidate.score;
            if ((not is_fuzzy_pinyin_active) or
                (candidate.fuzzy_cost <= 0)) and candidate.has_dict_weight then
            begin
                if chunk_syllables <= 2 then
                begin
                    Result := candidate.dict_weight;
                end
                else if (Result <= 0) or (candidate.dict_weight > Result) then
                begin
                    Result := candidate.dict_weight;
                end;
            end;
        end;

        function get_first_meaningful_path_segment_local(
            const encoded_path: string): string;
        var
            parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
        begin
            Result := '';
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                if segment_text = '' then
                begin
                    Continue;
                end;
                if get_candidate_text_unit_count(segment_text) >= 2 then
                begin
                    Exit(segment_text);
                end;
                if Result = '' then
                begin
                    Result := segment_text;
                end;
            end;
        end;

        function get_suffix_context_bonus_local(const chunk_text: string;
            const suffix_path: string): Integer;
        var
            meaningful_segment: string;
        begin
            Result := 0;
            if (m_dictionary = nil) or (chunk_text = '') or (suffix_path = '') then
            begin
                Exit;
            end;
            meaningful_segment := get_first_meaningful_path_segment_local(suffix_path);
            if meaningful_segment <> '' then
            begin
                Result := m_dictionary.get_context_bonus(chunk_text, meaningful_segment);
            end;
        end;

        function get_suffix_base_prefix_bonus_local(const chunk_text: string;
            const suffix_path: string): Integer;
        var
            meaningful_segment: string;
            prefix_text: string;
        begin
            Result := 0;
            if (m_dictionary = nil) or (chunk_text = '') or (suffix_path = '') then
            begin
                Exit;
            end;

            meaningful_segment := get_first_meaningful_path_segment_local(suffix_path);
            if meaningful_segment = '' then
            begin
                Exit;
            end;

            prefix_text := chunk_text + meaningful_segment;
            if (get_candidate_text_unit_count(prefix_text) < 2) or
                (get_candidate_text_unit_count(prefix_text) > 6) then
            begin
                Exit;
            end;
            Result := m_dictionary.get_base_text_prefix_bonus(prefix_text);
        end;

        function get_first_path_text_unit_local(const encoded_path: string): string;
        var
            parts: TArray<string>;
            units: TArray<string>;
            part_idx: Integer;
            segment_text: string;
        begin
            Result := '';
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                if segment_text = '' then
                begin
                    Continue;
                end;
                units := split_text_units(segment_text);
                if Length(units) > 0 then
                begin
                    Exit(units[0]);
                end;
            end;
        end;

        function get_first_path_segment_text_local(
            const encoded_path: string): string;
        var
            parts: TArray<string>;
            part_idx: Integer;
            segment_text: string;
        begin
            Result := '';
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(parts) do
            begin
                segment_text := Trim(parts[part_idx]);
                if segment_text <> '' then
                begin
                    Exit(segment_text);
                end;
            end;
        end;

        function is_structural_particle_text_local(const value: string): Boolean;
        begin
            Result := (value = string(Char($7684))) or
                (value = string(Char($5F97))) or
                (value = string(Char($5730)));
        end;

        function try_get_best_exact_two_unit_text_local(
            const local_start_idx: Integer; out out_text: string;
            out out_weight: Integer): Boolean;
        const
            c_two_unit_probe_limit = 12;
        var
            query_key: string;
            local_results: TncCandidateList;
            result_idx: Integer;
            candidate_text: string;
            candidate_weight: Integer;
            ranked_weight: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (m_dictionary = nil) or (local_start_idx < 0) or
                (local_start_idx + 1 > High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            query_key := build_query_key_local(local_start_idx, 2);
            if (query_key = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key,
                local_results)) then
            begin
                Exit;
            end;

            for result_idx := 0 to High(local_results) do
            begin
                if result_idx >= c_two_unit_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(local_results[result_idx]) or
                    is_runtime_common_pattern_candidate(local_results[result_idx]) or
                    is_runtime_redup_candidate(local_results[result_idx]) then
                begin
                    Continue;
                end;

                candidate_text := Trim(local_results[result_idx].text);
                if (get_candidate_text_unit_count(candidate_text) <> 2) or
                    (not is_valid_cjk_phrase_text_local(candidate_text, 2)) then
                begin
                    Continue;
                end;

                candidate_weight := get_candidate_effective_weight_local(
                    local_results[result_idx], 2);
                Inc(candidate_weight, get_preferred_query_phrase_bonus_local(
                    query_key, candidate_text));
                Inc(candidate_weight, get_preferred_exact_subspan_bonus_local(
                    query_key, candidate_text));
                ranked_weight := candidate_weight +
                    ((c_two_unit_probe_limit - result_idx) * 96);
                if (not Result) or (ranked_weight > out_weight) then
                begin
                    Result := True;
                    out_text := candidate_text;
                    out_weight := ranked_weight;
                end;
            end;
        end;

        function try_get_exact_single_char_weight_local(const local_start_idx: Integer;
            const expected_text: string; out out_weight: Integer): Boolean;
        var
            query_key: string;
            local_results: TncCandidateList;
            result_idx: Integer;
            candidate_weight: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (expected_text = '') or (m_dictionary = nil) or
                (local_start_idx < 0) or
                (local_start_idx > High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            if exact_subspan_fixed_weight_cache_states[local_start_idx] = 2 then
            begin
                out_weight := exact_subspan_fixed_weight_cache_values[
                    local_start_idx];
                Exit(True);
            end;
            if exact_subspan_fixed_weight_cache_states[local_start_idx] = 1 then
            begin
                Exit(False);
            end;

            query_key := normalize_pinyin_text(
                exact_subspan_cache_syllables[local_start_idx].text);
            if (query_key = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key,
                local_results)) then
            begin
                Exit;
            end;

            for result_idx := 0 to High(local_results) do
            begin
                if Trim(local_results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if Trim(local_results[result_idx].text) <> expected_text then
                begin
                    Continue;
                end;

                candidate_weight := local_results[result_idx].score;
                if local_results[result_idx].has_dict_weight and
                    (local_results[result_idx].dict_weight > candidate_weight) then
                begin
                    candidate_weight := local_results[result_idx].dict_weight;
                end;
                if candidate_weight > out_weight then
                begin
                    out_weight := candidate_weight;
                end;
            end;

            Result := out_weight > 0;
            if Result then
            begin
                exact_subspan_fixed_weight_cache_states[local_start_idx] := 2;
                exact_subspan_fixed_weight_cache_values[local_start_idx] :=
                    out_weight;
            end
            else
            begin
                exact_subspan_fixed_weight_cache_states[local_start_idx] := 1;
            end;
        end;

        function get_exact_span_coverage_quality_local(
            const local_start_idx: Integer; const local_span_syllables: Integer;
            const text_value: string): Integer;
        const
            c_quality_probe_limit = 16;
            c_quality_max_span = 5;
        var
            units_local: TArray<string>;
            occupied_local: TArray<Boolean>;
            offset_local: Integer;
            span_len_local: Integer;
            query_key_local: string;
            span_text_local: string;
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;

            function range_is_occupied_local(const range_start: Integer;
                const range_len: Integer): Boolean;
            var
                range_idx: Integer;
            begin
                Result := True;
                if (range_start < 0) or (range_len <= 0) or
                    (range_start + range_len > Length(occupied_local)) then
                begin
                    Exit;
                end;

                for range_idx := range_start to range_start + range_len - 1 do
                begin
                    if occupied_local[range_idx] then
                    begin
                        Exit;
                    end;
                end;
                Result := False;
            end;

            procedure mark_range_occupied_local(const range_start: Integer;
                const range_len: Integer);
            var
                range_idx: Integer;
            begin
                if (range_start < 0) or (range_len <= 0) or
                    (range_start + range_len > Length(occupied_local)) then
                begin
                    Exit;
                end;

                for range_idx := range_start to range_start + range_len - 1 do
                begin
                    occupied_local[range_idx] := True;
                end;
            end;

            function join_units_range_local(const range_start: Integer;
                const range_len: Integer): string;
            var
                range_idx: Integer;
            begin
                Result := '';
                if (range_start < 0) or (range_len <= 0) or
                    (range_start + range_len > Length(units_local)) then
                begin
                    Exit;
                end;

                for range_idx := range_start to range_start + range_len - 1 do
                begin
                    Result := Result + units_local[range_idx];
                end;
            end;

        begin
            Result := 0;
            units_local := split_text_units(Trim(text_value));
            if (local_span_syllables < 2) or
                (Length(units_local) <> local_span_syllables) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            SetLength(occupied_local, local_span_syllables);
            for span_len_local := Min(c_quality_max_span,
                local_span_syllables) downto 2 do
            begin
                for offset_local := 0 to local_span_syllables - span_len_local do
                begin
                    if range_is_occupied_local(offset_local, span_len_local) then
                    begin
                        Continue;
                    end;

                    query_key_local := build_query_key_local(
                        local_start_idx + offset_local, span_len_local);
                    span_text_local := join_units_range_local(offset_local,
                        span_len_local);
                    if (query_key_local = '') or (span_text_local = '') or
                        (not lookup_exact_full_pinyin_cached_local(query_key_local,
                        exact_results_local)) then
                    begin
                        Continue;
                    end;

                    for result_idx_local := 0 to High(exact_results_local) do
                    begin
                        if result_idx_local >= c_quality_probe_limit then
                        begin
                            Break;
                        end;
                        candidate_text_local :=
                            Trim(exact_results_local[result_idx_local].text);
                        if (Trim(exact_results_local[result_idx_local].comment) <> '') or
                            (not SameText(candidate_text_local, span_text_local)) or
                            (get_candidate_text_unit_count(candidate_text_local) <>
                            span_len_local) then
                        begin
                            Continue;
                        end;

                        candidate_weight_local :=
                            get_candidate_effective_weight_local(
                            exact_results_local[result_idx_local], span_len_local);
                        Inc(Result, (span_len_local * span_len_local * 1800) +
                            Min(12000, candidate_weight_local * 6) +
                            ((c_quality_probe_limit - result_idx_local) * 80));
                        mark_range_occupied_local(offset_local, span_len_local);
                        Break;
                    end;
                end;
            end;
        end;

        procedure collect_exact_single_char_candidates_local(
            const local_start_idx: Integer; const max_options: Integer;
            out out_texts: TArray<string>; out out_weights: TArray<Integer>);
        const
            c_single_probe_limit = 16;
        var
            query_key: string;
            local_results: TncCandidateList;
            result_idx: Integer;
            candidate_text: string;
            candidate_weight: Integer;
            candidate_is_preferred: Boolean;
            existing_idx: Integer;
            insert_idx: Integer;
            swap_text: string;
            swap_weight: Integer;
        begin
            SetLength(out_texts, 0);
            SetLength(out_weights, 0);
            if (max_options <= 0) or (m_dictionary = nil) or
                (local_start_idx < 0) or
                (local_start_idx > High(exact_subspan_cache_syllables)) then
            begin
                Exit;
            end;

            if exact_subspan_single_cache_prepared[local_start_idx] then
            begin
                out_texts := exact_subspan_single_cache_texts[local_start_idx];
                out_weights := exact_subspan_single_cache_weights[local_start_idx];
                Exit;
            end;

            query_key := normalize_pinyin_text(
                exact_subspan_cache_syllables[local_start_idx].text);
            if (query_key = '') or
                (not lookup_exact_full_pinyin_cached_local(query_key,
                local_results)) then
            begin
                Exit;
            end;

            for result_idx := 0 to High(local_results) do
            begin
                if result_idx >= c_single_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[result_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text := Trim(local_results[result_idx].text);
                if (get_candidate_text_unit_count(candidate_text) <> 1) or
                    (not is_valid_cjk_phrase_text_local(candidate_text, 1)) then
                begin
                    Continue;
                end;
                if not match_single_char_candidate_for_syllable(
                    exact_subspan_cache_syllables[local_start_idx].text,
                    candidate_text, candidate_is_preferred) then
                begin
                    Continue;
                end;

                candidate_weight := local_results[result_idx].score;
                if local_results[result_idx].has_dict_weight and
                    (local_results[result_idx].dict_weight > candidate_weight) then
                begin
                    candidate_weight := local_results[result_idx].dict_weight;
                end;
                Inc(candidate_weight, get_preferred_query_phrase_bonus_local(
                    query_key, candidate_text));
                if candidate_is_preferred then
                begin
                    Inc(candidate_weight, 256);
                end;

                existing_idx := -1;
                for insert_idx := 0 to High(out_texts) do
                begin
                    if SameText(out_texts[insert_idx], candidate_text) then
                    begin
                        existing_idx := insert_idx;
                        Break;
                    end;
                end;

                if existing_idx >= 0 then
                begin
                    if candidate_weight <= out_weights[existing_idx] then
                    begin
                        Continue;
                    end;
                    out_weights[existing_idx] := candidate_weight;
                    insert_idx := existing_idx;
                end
                else
                begin
                    if Length(out_texts) < max_options then
                    begin
                        SetLength(out_texts, Length(out_texts) + 1);
                        SetLength(out_weights, Length(out_weights) + 1);
                        insert_idx := High(out_texts);
                        out_texts[insert_idx] := candidate_text;
                        out_weights[insert_idx] := candidate_weight;
                    end
                    else
                    begin
                        insert_idx := High(out_texts);
                        if (candidate_weight < out_weights[insert_idx]) or
                            ((candidate_weight = out_weights[insert_idx]) and
                            (CompareText(candidate_text, out_texts[insert_idx]) >= 0)) then
                        begin
                            Continue;
                        end;
                        out_texts[insert_idx] := candidate_text;
                        out_weights[insert_idx] := candidate_weight;
                    end;
                end;

                while (insert_idx > 0) and
                    ((out_weights[insert_idx] > out_weights[insert_idx - 1]) or
                    ((out_weights[insert_idx] = out_weights[insert_idx - 1]) and
                    (CompareText(out_texts[insert_idx], out_texts[insert_idx - 1]) < 0))) do
                begin
                    swap_text := out_texts[insert_idx - 1];
                    out_texts[insert_idx - 1] := out_texts[insert_idx];
                    out_texts[insert_idx] := swap_text;
                    swap_weight := out_weights[insert_idx - 1];
                    out_weights[insert_idx - 1] := out_weights[insert_idx];
                    out_weights[insert_idx] := swap_weight;
                    Dec(insert_idx);
                end;
            end;
            exact_subspan_single_cache_prepared[local_start_idx] := True;
            exact_subspan_single_cache_texts[local_start_idx] := out_texts;
            exact_subspan_single_cache_weights[local_start_idx] := out_weights;
        end;

        function normalize_long_sentence_chunk_weight_local(
            const raw_weight: Integer; const chunk_syllables_local: Integer): Integer;
        begin
            Result := raw_weight;
            case chunk_syllables_local of
                1:
                    if Result > 180 then
                    begin
                        Result := 180 + ((Result - 180) div 12);
                    end;
                2:
                    if Result > 240 then
                    begin
                        Result := 240 + ((Result - 240) div 10);
                    end;
            end;
        end;

        function is_preferred_phrase_match_local(const local_start_idx: Integer;
            const local_span_syllables: Integer; const preferred_text: string): Boolean;
        var
            preferred_units: TArray<string>;
            preferred_unit_idx: Integer;
            preferred_is_preferred: Boolean;
        begin
            Result := False;
            preferred_units := split_text_units(preferred_text);
            if Length(preferred_units) <> local_span_syllables then
            begin
                Exit;
            end;

            for preferred_unit_idx := 0 to High(preferred_units) do
            begin
                if not match_single_char_candidate_for_syllable(
                    exact_subspan_cache_syllables[local_start_idx + preferred_unit_idx].text,
                    preferred_units[preferred_unit_idx], preferred_is_preferred) then
                begin
                    Exit(False);
                end;
            end;

            Result := True;
        end;

        procedure store_cache_result_local(const local_start_idx: Integer;
            const local_span_syllables: Integer; const resolved: Boolean;
            const resolved_text: string; const resolved_score: Integer;
            const resolved_segments: Integer; const resolved_path: string;
            const resolved_has_anchor: Boolean; const resolved_anchor_units: Integer);
        begin
            if (not exact_subspan_cache_prepared) or
                (m_disable_subspan_standalone_oracle > 0) then
            begin
                Exit;
            end;
            exact_subspan_cache_states[local_start_idx][local_span_syllables] :=
                IfThen(resolved, c_state_hit, c_state_miss);
            if resolved then
            begin
                exact_subspan_cache_scores[local_start_idx][local_span_syllables] :=
                    resolved_score;
                exact_subspan_cache_segments[local_start_idx][local_span_syllables] :=
                    resolved_segments;
                exact_subspan_cache_anchor_units[local_start_idx][local_span_syllables] :=
                    resolved_anchor_units;
                exact_subspan_cache_has_anchor[local_start_idx][local_span_syllables] :=
                    resolved_has_anchor;
                exact_subspan_cache_texts[local_start_idx][local_span_syllables] :=
                    resolved_text;
                exact_subspan_cache_paths[local_start_idx][local_span_syllables] :=
                    resolved_path;
            end;
        end;

