        function build_replaced_text_local(const units_value: TArray<string>;
            const replacement_idx: Integer; const replacement_text: string): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := 0 to High(units_value) do
            begin
                if local_idx = replacement_idx then
                begin
                    Result := Result + replacement_text;
                end
                else
                begin
                    Result := Result + units_value[local_idx];
                end;
            end;
        end;

    begin
        if (Length(m_candidates) = 0) or (expected_units < 5) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        best_rank_local := Low(Integer);
        best_replacement_text_local := '';
        best_replacement_candidate_local := Default(TncCandidate);

        for idx := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_units_local := split_text_units(Trim(m_candidates[idx].text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Continue;
            end;

            for unit_idx := 1 to High(candidate_units_local) - 1 do
            begin
                if (normalize_pinyin_text(syllables[unit_idx].text) = 'de') and
                    (SameText(candidate_units_local[unit_idx],
                    string(Char($5730))) or SameText(candidate_units_local[
                    unit_idx], string(Char($5F97)))) and
                    (has_display_nominal_de_suffix_local(candidate_units_local,
                    unit_idx)) then
                begin
                    replacement_text_local := build_replaced_text_local(
                        candidate_units_local, unit_idx, string(Char($7684)));
                    candidate_rank_local := m_candidates[idx].score;
                    if (idx < Length(m_candidate_segment_paths)) and
                        (Trim(m_candidate_segment_paths[idx]) <> '') then
                    begin
                        Inc(candidate_rank_local, 50000);
                    end;
                    Dec(candidate_rank_local, idx * 256);
                    if candidate_rank_local > best_rank_local then
                    begin
                        best_rank_local := candidate_rank_local;
                        best_replacement_text_local := replacement_text_local;
                        best_replacement_candidate_local := m_candidates[idx];
                        best_replacement_candidate_local.text :=
                            replacement_text_local;
                        best_replacement_candidate_local.comment := '';
                        Inc(best_replacement_candidate_local.score, 36000);
                        best_replacement_candidate_local.has_dict_weight := False;
                        best_replacement_candidate_local.dict_weight := 0;
                    end;
                end;
            end;
        end;

        if best_replacement_text_local = '' then
        begin
            Exit;
        end;

        existing_idx_local := find_display_candidate(best_replacement_text_local,
            '');
        if existing_idx_local < 0 then
        begin
            replacement_candidate_local := best_replacement_candidate_local;
            insert_display_candidate(replacement_candidate_local,
                best_replacement_text_local, 0);
            existing_idx_local := find_display_candidate(best_replacement_text_local,
                '');
        end;
        if existing_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(existing_idx_local, 0);
