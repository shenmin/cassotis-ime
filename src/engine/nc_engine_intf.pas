        function has_function_particle_before_span_local(
            const local_pos: Integer): Boolean;
        var
            previous_key_local: string;
        begin
            Result := False;
            if local_pos <= 0 then
            begin
                Exit;
            end;

            previous_key_local := normalize_pinyin_text(
                syllables_local[local_pos - 1].text);
            Result := SameText(previous_key_local, 'de') or
                SameText(previous_key_local, 'zhi');
        end;

        function get_temporal_process_context_bonus_local(
            const candidate_text: string; const local_pos: Integer): Integer;
        begin
            Result := 0;
            if has_function_particle_before_span_local(local_pos) and
                is_temporal_process_span_text_local(candidate_text) then
            begin
                Result := 4200;
            end;
        end;

        function has_place_context_before_span_local(const local_pos: Integer): Boolean;
        const
            c_context_probe_limit = 8;
        var
            back_len_local: Integer;
            context_key_local: string;
            context_results_local: TncCandidateList;
            result_idx_local: Integer;
            context_text_local: string;
            context_units_local: TArray<string>;
        begin
            Result := False;
            if local_pos <= 0 then
            begin
                Exit;
            end;

            for back_len_local := 1 to Min(4, local_pos) do
            begin
                context_key_local := build_query_key_local(
                    local_pos - back_len_local, back_len_local);
                if (context_key_local = '') or
                    (not dictionary_exact_lookup_cached(context_key_local,
                    context_results_local)) then
                begin
                    Continue;
                end;

                for result_idx_local := 0 to High(context_results_local) do
                begin
                    if result_idx_local >= c_context_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(context_results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    context_text_local := Trim(context_results_local[result_idx_local].text);
                    context_units_local := split_text_units(context_text_local);
                    if (Length(context_units_local) > 0) and
                        is_place_noun_unit_local(
                        context_units_local[High(context_units_local)]) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function has_directional_locative_context_for_span_local(
            const local_pos: Integer; const expected_units: Integer): Boolean;
        var
            next_key_local: string;
        begin
            Result := False;
            if (expected_units <> 2) or
                (not has_place_context_before_span_local(local_pos)) then
            begin
                Exit;
            end;

            if local_pos + expected_units >= Length(syllables_local) then
            begin
                Exit(True);
            end;

            next_key_local := normalize_pinyin_text(
                syllables_local[local_pos + expected_units].text);
            if next_key_local = 'de' then
            begin
                Result := True;
            end;
        end;

        function get_directional_locative_context_bonus_local(
            const candidate_text: string; const local_pos: Integer;
            const expected_units: Integer): Integer;
        const
            c_place_context_directional_bonus = 12000;
        begin
            Result := 0;
            if is_directional_locative_text_local(candidate_text) and
                has_directional_locative_context_for_span_local(local_pos,
                expected_units) then
            begin
                Result := c_place_context_directional_bonus;
            end;
        end;

        function get_crossing_previous_exact_phrase_penalty_local(
            const local_pos: Integer; const current_span_len: Integer): Integer;
        const
            c_cross_boundary_min_weight = 420;
            c_cross_boundary_base_penalty = 4200;
            c_cross_boundary_len_penalty = 220;
        var
            back_len_local: Integer;
            phrase_key_local: string;
            phrase_results_local: TncCandidateList;
            phrase_idx_local: Integer;
            phrase_text_local: string;
            phrase_weight_local: Integer;
            best_weight_local: Integer;
        begin
            Result := 0;
            if (local_pos <= 0) or (current_span_len < 2) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            best_weight_local := 0;
            for back_len_local := 2 to Min(5, local_pos + 1) do
            begin
                phrase_key_local := build_query_key_local(
                    local_pos - back_len_local + 1, back_len_local);
                if (phrase_key_local = '') or
                    (not dictionary_exact_lookup_cached(phrase_key_local,
                    phrase_results_local)) then
                begin
                    Continue;
                end;

                for phrase_idx_local := 0 to High(phrase_results_local) do
                begin
                    if phrase_idx_local >= get_span_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(phrase_results_local[phrase_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    phrase_text_local := Trim(phrase_results_local[phrase_idx_local].text);
                    if (phrase_text_local = '') or
                        (get_candidate_text_unit_count(phrase_text_local) <>
                        back_len_local) then
                    begin
                        Continue;
                    end;

                    phrase_weight_local := phrase_results_local[phrase_idx_local].score;
                    if phrase_results_local[phrase_idx_local].has_dict_weight and
                        (phrase_results_local[phrase_idx_local].dict_weight >
                        phrase_weight_local) then
                    begin
                        phrase_weight_local :=
                            phrase_results_local[phrase_idx_local].dict_weight;
                    end;
                    if phrase_weight_local > best_weight_local then
                    begin
                        best_weight_local := phrase_weight_local;
                    end;
                end;
            end;

            if best_weight_local >= c_cross_boundary_min_weight then
            begin
                Result := c_cross_boundary_base_penalty +
                    Min(1600, best_weight_local) +
                    current_span_len * c_cross_boundary_len_penalty;
            end;
        end;

        function get_best_split_piece_weight_local(const local_pos: Integer;
            const local_len: Integer; out out_weight: Integer): Boolean;
        var
            piece_key_local: string;
            piece_results_local: TncCandidateList;
            piece_idx_local: Integer;
            piece_text_local: string;
            piece_weight_local: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (local_len <= 0) or
                (local_pos < 0) or
                (local_pos + local_len > Length(syllables_local)) then
            begin
                Exit;
            end;

            piece_key_local := build_query_key_local(local_pos, local_len);
            if (piece_key_local = '') or
                (not dictionary_exact_lookup_cached(piece_key_local,
                piece_results_local)) then
            begin
                Exit;
            end;

            for piece_idx_local := 0 to High(piece_results_local) do
            begin
                if piece_idx_local >= get_span_probe_limit_local then
                begin
                    Break;
                end;
                if Trim(piece_results_local[piece_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                piece_text_local := Trim(piece_results_local[piece_idx_local].text);
                if (piece_text_local = '') or
                    (get_candidate_text_unit_count(piece_text_local) <>
                    local_len) then
                begin
                    Continue;
                end;

                piece_weight_local := piece_results_local[piece_idx_local].score;
                if piece_results_local[piece_idx_local].has_dict_weight and
                    (piece_results_local[piece_idx_local].dict_weight >
                    piece_weight_local) then
                begin
                    piece_weight_local :=
                        piece_results_local[piece_idx_local].dict_weight;
                end;

                if piece_weight_local > out_weight then
                begin
                    out_weight := piece_weight_local;
                    Result := True;
                end;
            end;
        end;

        function get_stronger_split_span_penalty_local(
            const local_pos: Integer; const current_span_len: Integer;
            const current_weight: Integer): Integer;
        const
            c_weak_span_weight = 700;
            c_split_strong_piece_weight = 760;
            c_split_margin = 220;
            c_split_penalty = 4800;
        var
            split_pos_local: Integer;
            left_weight_local: Integer;
            right_weight_local: Integer;
            split_weight_local: Integer;
        begin
            Result := 0;
            if (current_span_len < 2) or (current_weight >= c_weak_span_weight) then
            begin
                Exit;
            end;

            for split_pos_local := 1 to current_span_len - 1 do
            begin
                if (not get_best_split_piece_weight_local(local_pos,
                    split_pos_local, left_weight_local)) or
                    (not get_best_split_piece_weight_local(local_pos +
                    split_pos_local, current_span_len - split_pos_local,
                    right_weight_local)) then
                begin
                    Continue;
                end;

                if Max(left_weight_local, right_weight_local) <
                    c_split_strong_piece_weight then
                begin
                    Continue;
                end;

                split_weight_local := left_weight_local + right_weight_local;
                if split_weight_local >= current_weight + c_split_margin then
                begin
                    Exit(c_split_penalty);
                end;
            end;
        end;

        function dictionary_lookup_has_span_text_local(const local_query_key: string;
            const local_text: string; const local_expected_units: Integer): Boolean;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            if (local_query_key = '') or (local_text = '') or
                (local_expected_units <= 0) then
            begin
                Exit;
            end;
            if m_dictionary is TncSqliteDictionary then
            begin
                if not dictionary_exact_lookup_cached(local_query_key,
                    local_results) then
                begin
                    Exit;
                end;
            end
            else if not dictionary_lookup_cached(local_query_key,
                local_results) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= get_span_probe_limit_local then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if not long_exact_chunk_weight_is_eligible(
                    local_results[local_idx].dict_weight,
                    local_results[local_idx].has_dict_weight) then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(local_results[local_idx].text);
                if SameText(candidate_text_local, local_text) and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    local_expected_units) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function is_nonbase_two_plus_single_dictionary_span_local(
            const local_query_key: string; const local_expected_units: Integer;
            const local_text: string): Boolean;
        var
            local_syllables: TncPinyinParseResult;
            local_units: TArray<string>;
            head_key_local: string;
            tail_key_local: string;
            tail_syllable_local: string;
            head_text_local: string;
            tail_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (local_expected_units <> 3) then
            begin
                Exit;
            end;
            if m_dictionary.is_base_entry(local_query_key, local_text) or
                m_dictionary.is_user_entry(local_query_key, local_text) then
            begin
                Exit;
            end;

            local_syllables := get_effective_compact_pinyin_syllables(
                local_query_key);
            local_units := split_text_units(Trim(local_text));
            if (Length(local_syllables) <> 3) or (Length(local_units) <> 3) then
            begin
                Exit;
            end;

            tail_syllable_local := normalize_pinyin_text(
                local_syllables[2].text);
            if (tail_syllable_local = 'de') or
                (tail_syllable_local = 'le') or
                (tail_syllable_local = 'la') or
                (tail_syllable_local = 'ba') or
                (tail_syllable_local = 'ma') then
            begin
                Exit;
            end;

            head_key_local := normalize_pinyin_text(local_syllables[0].text) +
                normalize_pinyin_text(local_syllables[1].text);
            tail_key_local := tail_syllable_local;
            head_text_local := local_units[0] + local_units[1];
            tail_text_local := local_units[2];

            Result := dictionary_lookup_has_span_text_local(head_key_local,
                head_text_local, 2) and
                (dictionary_lookup_has_span_text_local(tail_key_local,
                tail_text_local, 1) or
                m_dictionary.single_char_matches_pinyin(tail_key_local,
                tail_text_local));
        end;

        function try_get_dictionary_span_text_local(
            const query_key: string; const expected_units: Integer;
            const required_tail_text: string; const local_pos: Integer;
            out out_text: string;
            out out_weight: Integer; out out_is_ambiguous: Boolean): Boolean;
        var
            results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            candidate_base_weight_local: Integer;
            candidate_preferred_bonus_local: Integer;
            direction_bonus_local: Integer;
            direction_context_bonus_local: Integer;
            has_directional_context_local: Boolean;
            has_directional_candidate_local: Boolean;
            candidate_units_local: TArray<string>;
            second_weight_local: Integer;
            valid_count_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            out_is_ambiguous := False;
            second_weight_local := Low(Integer);
            valid_count_local := 0;
            if (query_key = '') or (expected_units <= 1) then
            begin
                Exit;
            end;
            if (expected_units >= 3) and
                (m_dictionary is TncSqliteDictionary) then
            begin
                if (not dictionary_exact_lookup_cached(query_key,
                    results_local)) and
                    (not dictionary_lookup_cached(query_key,
                    results_local)) then
                begin
                    Exit;
                end;
            end
            else if not dictionary_lookup_cached(query_key, results_local) then
            begin
                Exit;
            end;

            has_directional_context_local :=
                has_directional_locative_context_for_span_local(local_pos,
                expected_units);
            has_directional_candidate_local := False;
            if has_directional_context_local then
            begin
                for result_idx_local := 0 to High(results_local) do
                begin
                    if result_idx_local >= get_span_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        results_local[result_idx_local].dict_weight,
                        results_local[result_idx_local].has_dict_weight) then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(results_local[result_idx_local].text);
                    if (candidate_text_local <> '') and
                        (get_candidate_text_unit_count(candidate_text_local) =
                        expected_units) and
                        is_directional_locative_text_local(candidate_text_local) then
                    begin
                        has_directional_candidate_local := True;
                        Break;
                    end;
                end;
            end;

            for result_idx_local := 0 to High(results_local) do
            begin
                if result_idx_local >= get_span_probe_limit_local then
                begin
                    Break;
                end;
                if Trim(results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                if not long_exact_chunk_weight_is_eligible(
                    results_local[result_idx_local].dict_weight,
                    results_local[result_idx_local].has_dict_weight) then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(results_local[result_idx_local].text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    expected_units) then
                begin
                    Continue;
                end;
                if is_nonbase_two_plus_single_dictionary_span_local(query_key,
                    expected_units, candidate_text_local) then
                begin
                    Continue;
                end;
                candidate_base_weight_local := results_local[result_idx_local].score;
                if results_local[result_idx_local].has_dict_weight and
                    (results_local[result_idx_local].dict_weight >
                    candidate_base_weight_local) then
                begin
                    candidate_base_weight_local :=
                        results_local[result_idx_local].dict_weight;
                end;
                candidate_preferred_bonus_local :=
                    get_preferred_query_phrase_bonus_local(query_key,
                    candidate_text_local);
                if has_directional_context_local and
                    has_directional_candidate_local and
                    (not is_directional_locative_text_local(candidate_text_local)) then
                begin
                    candidate_preferred_bonus_local := 0;
                end;
                if required_tail_text <> '' then
                begin
                    candidate_units_local := split_text_units(candidate_text_local);
                    if (Length(candidate_units_local) <> expected_units) or
                        (candidate_units_local[High(candidate_units_local)] <>
                        required_tail_text) then
                    begin
                        if candidate_preferred_bonus_local <= 0 then
                        begin
                            Continue;
                        end;
                        if (not results_local[result_idx_local].has_dict_weight) or
                            (results_local[result_idx_local].dict_weight <
                            c_weak_fixed_head_phrase_weight) then
                        begin
                            Continue;
                        end;
                    end;
                end;

                candidate_weight_local := candidate_base_weight_local;
                direction_bonus_local :=
                    get_directional_locative_span_bonus_local(
                    candidate_text_local);
                direction_context_bonus_local :=
                    get_directional_locative_context_bonus_local(
                    candidate_text_local, local_pos, expected_units);
                Inc(candidate_weight_local, direction_bonus_local);
                Inc(candidate_weight_local,
                    direction_context_bonus_local);
                Inc(candidate_weight_local, candidate_preferred_bonus_local);
                Inc(candidate_weight_local,
                    get_temporal_process_context_bonus_local(
                    candidate_text_local, local_pos));
                Dec(candidate_weight_local,
                    get_crossing_previous_exact_phrase_penalty_local(
                    local_pos, expected_units));
                Dec(candidate_weight_local,
                    get_stronger_split_span_penalty_local(local_pos,
                    expected_units, candidate_base_weight_local));
                if (expected_units = 2) and
                    (normalize_pinyin_text(syllables_local[local_pos].text) = 'yi') then
                begin
                    candidate_units_local := split_text_units(candidate_text_local);
                    if (Length(candidate_units_local) = 2) and
                        (candidate_units_local[0] = string(Char($4E00))) and
                        is_quantity_tail_unit_local(candidate_units_local[1]) then
                    begin
                        Inc(candidate_weight_local, c_quantity_tail_bonus);
                    end;
                end;
                if candidate_weight_local >= c_ambiguity_min_competitor_weight then
                begin
                    Inc(valid_count_local);
                end;
                if candidate_weight_local <
                    get_min_span_weight_local(expected_units) then
                begin
                    second_weight_local := Max(second_weight_local,
                        candidate_weight_local);
                    Continue;
                end;

                if (not Result) or (candidate_weight_local > out_weight) then
                begin
                    if Result then
                    begin
                        second_weight_local := Max(second_weight_local,
                            out_weight);
                    end;
                    Result := True;
                    out_text := candidate_text_local;
                    out_weight := candidate_weight_local;
                end
                else
                begin
                    second_weight_local := Max(second_weight_local,
                        candidate_weight_local);
                end;
            end;

            if Result and (valid_count_local > 1) and
                (second_weight_local >= out_weight - c_ambiguous_span_margin) then
            begin
                out_is_ambiguous := True;
            end;
        end;

        function combine_path_segments_local(const head_path: string;
            const tail_path: string): string;
        begin
            Result := head_path;
            if tail_path = '' then
            begin
                Exit;
            end;
            if Result <> '' then
            begin
                Result := Result + string(Char($0003));
            end;
            Result := Result + tail_path;
        end;

        function get_first_path_segment_local(const encoded_path: string): string;
        var
            separator_pos_local: Integer;
        begin
            Result := Trim(encoded_path);
            if Result = '' then
            begin
                Exit;
            end;
            separator_pos_local := Pos(c_segment_path_separator, Result);
            if separator_pos_local > 0 then
            begin
                Result := Copy(Result, 1, separator_pos_local - 1);
            end;
        end;

        function get_last_path_segment_local(const encoded_path: string): string;
        var
            scan_idx_local: Integer;
        begin
            Result := Trim(encoded_path);
            for scan_idx_local := Length(Result) downto 1 do
            begin
                if Result[scan_idx_local] = c_segment_path_separator then
                begin
                    Result := Copy(Result, scan_idx_local + 1, MaxInt);
                    Exit;
                end;
            end;
        end;

        function stable_fixed_single_chain_with_phrase_local(
            const encoded_path: string): Boolean;
        var
            segment_parts_local: TArray<string>;
            segment_idx_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            has_phrase_segment_local: Boolean;
        begin
            Result := False;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            segment_parts_local := encoded_path.Split([c_segment_path_separator]);
            if Length(segment_parts_local) < 2 then
            begin
                Exit;
            end;

            has_phrase_segment_local := False;
            for segment_idx_local := 0 to High(segment_parts_local) do
            begin
                segment_text_local := Trim(segment_parts_local[segment_idx_local]);
                if segment_text_local = '' then
                begin
                    Exit;
                end;

                segment_units_local :=
                    get_candidate_text_unit_count(segment_text_local);
                if segment_units_local >= 2 then
                begin
                    has_phrase_segment_local := True;
                    Continue;
                end;

                if (segment_units_local <> 1) or
                    (not is_stable_fixed_single_text_local(segment_text_local)) then
                begin
                    Exit;
                end;
            end;

            Result := has_phrase_segment_local;
        end;

        function get_following_context_bonus_local(const head_text: string;
            const tail_path: string): Integer;
        var
            tail_head_text_local: string;
        begin
            Result := 0;
            if (m_dictionary = nil) or (Trim(head_text) = '') or
                (Trim(tail_path) = '') then
            begin
                Exit;
            end;

            tail_head_text_local := get_first_path_segment_local(tail_path);
            if tail_head_text_local <> '' then
            begin
                Result := m_dictionary.get_context_bonus(head_text,
                    tail_head_text_local);
            end;
        end;

        function try_get_dictionary_single_text_local(const query_key: string;
            out out_text: string; out out_weight: Integer): Boolean;
        var
            results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (query_key = '') or
                (not dictionary_exact_lookup_cached(query_key, results_local)) then
            begin
                Exit;
            end;

            for result_idx_local := 0 to High(results_local) do
            begin
                if result_idx_local >= get_span_probe_limit_local then
                begin
                    Break;
                end;
                if Trim(results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(results_local[result_idx_local].text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <> 1) then
                begin
                    Continue;
                end;

                candidate_weight_local := results_local[result_idx_local].score;
                if results_local[result_idx_local].has_dict_weight and
                    (results_local[result_idx_local].dict_weight >
                    candidate_weight_local) then
                begin
                    candidate_weight_local :=
                        results_local[result_idx_local].dict_weight;
                end;
                Inc(candidate_weight_local, get_preferred_query_phrase_bonus_local(
                    query_key, candidate_text_local));
                if (not Result) or (candidate_weight_local > out_weight) then
                begin
                    Result := True;
                    out_text := candidate_text_local;
                    out_weight := candidate_weight_local;
                end;
            end;
        end;

        function is_motion_tail_syllable_local(const syllable_text: string): Boolean;
        var
            normalized_local: string;
        begin
            normalized_local := normalize_pinyin_text(syllable_text);
            Result := (normalized_local = 'qu') or (normalized_local = 'lai') or
                (normalized_local = 'dao');
        end;

        function try_get_locative_li_span_text_local(const local_pos: Integer;
            out out_text: string; out out_weight: Integer): Boolean;
        const
            c_locative_li_motion_bonus = 3600;
        var
            head_key_local: string;
            local_results: TncCandidateList;
            local_idx: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            if (local_pos < 0) or (local_pos + 2 > High(syllables_local)) or
                (normalize_pinyin_text(syllables_local[local_pos + 1].text) <> 'li') or
                (not is_motion_tail_syllable_local(
                syllables_local[local_pos + 2].text)) then
            begin
                Exit;
            end;

            head_key_local := normalize_pinyin_text(syllables_local[local_pos].text);
            if (head_key_local = '') or
                (not dictionary_exact_lookup_cached(head_key_local, local_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= get_span_probe_limit_local then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(local_results[local_idx].text);
                if (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                    (not is_place_noun_unit_local(candidate_text_local)) then
                begin
                    Continue;
                end;

                candidate_weight_local := local_results[local_idx].score;
                if local_results[local_idx].has_dict_weight and
                    (local_results[local_idx].dict_weight > candidate_weight_local) then
                begin
                    candidate_weight_local := local_results[local_idx].dict_weight;
                end;
                Inc(candidate_weight_local, c_locative_li_motion_bonus);
                if (not Result) or (candidate_weight_local > out_weight) then
                begin
                    Result := True;
                    out_text := candidate_text_local + string(Char($91CC));
                    out_weight := candidate_weight_local;
                end;
            end;
        end;

        function try_get_locative_li_motion_span_text_local(const local_pos: Integer;
            out out_text: string; out out_path: string; out out_weight: Integer): Boolean;
        const
            c_locative_motion_span_bonus = 480;
        var
            locative_text_local: string;
            locative_weight_local: Integer;
            tail_key_local: string;
            previous_key_local: string;
            preferred_tail_text_local: string;
            tail_results_local: TncCandidateList;
            tail_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            tail_text_local: string;
            tail_weight_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_weight := 0;
            if (local_pos < 0) or (local_pos + 2 > High(syllables_local)) or
                (not try_get_locative_li_span_text_local(local_pos,
                locative_text_local, locative_weight_local)) then
            begin
                Exit;
            end;

            tail_key_local := normalize_pinyin_text(
                syllables_local[local_pos + 2].text);
            previous_key_local := '';
            if local_pos > 0 then
            begin
                previous_key_local := normalize_pinyin_text(
                    syllables_local[local_pos - 1].text);
            end;

            preferred_tail_text_local := get_fixed_single_text_local(
                tail_key_local);
            if (tail_key_local = 'qu') and (previous_key_local = 'qu') then
            begin
                preferred_tail_text_local := string(Char($53D6));
            end;

            tail_text_local := '';
            tail_weight_local := Low(Integer);
            if (preferred_tail_text_local <> '') and
                dictionary_exact_lookup_cached(tail_key_local,
                tail_results_local) then
            begin
                for tail_idx_local := 0 to High(tail_results_local) do
                begin
                    if tail_idx_local >= get_span_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(tail_results_local[tail_idx_local].text);
                    if (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                        (candidate_text_local <> preferred_tail_text_local) then
                    begin
                        Continue;
                    end;

                    candidate_weight_local := tail_results_local[tail_idx_local].score;
                    if tail_results_local[tail_idx_local].has_dict_weight and
                        (tail_results_local[tail_idx_local].dict_weight >
                        candidate_weight_local) then
                    begin
                        candidate_weight_local :=
                            tail_results_local[tail_idx_local].dict_weight;
                    end;
                    tail_text_local := candidate_text_local;
                    tail_weight_local := candidate_weight_local;
                    Break;
                end;
            end;

            if tail_text_local = '' then
            begin
                if not try_get_dictionary_single_text_local(tail_key_local,
                    tail_text_local, tail_weight_local) then
                begin
                    Exit;
                end;
            end;

            out_text := locative_text_local + tail_text_local;
            out_path := combine_path_segments_local(locative_text_local,
                tail_text_local);
            out_weight := locative_weight_local + tail_weight_local +
                c_locative_motion_span_bonus;
            Inc(out_weight, get_following_context_bonus_local(locative_text_local,
                tail_text_local));
            Result := True;
        end;

        function try_get_result_wan_span_text_local(const local_pos: Integer;
            out out_text: string; out out_path: string; out out_weight: Integer): Boolean;
        const
            c_result_wan_span_bonus = 3600;
        var
            head_key_local: string;
            head_text_local: string;
            head_weight_local: Integer;
            wan_text_local: string;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_weight := 0;
            if (local_pos < 0) or (local_pos + 1 > High(syllables_local)) or
                (normalize_pinyin_text(syllables_local[local_pos + 1].text) <>
                'wan') then
            begin
                Exit;
            end;

            head_key_local := normalize_pinyin_text(syllables_local[local_pos].text);
            if (head_key_local = '') or
                (not try_get_dictionary_single_text_local(head_key_local,
                head_text_local, head_weight_local)) then
            begin
                Exit;
            end;

            wan_text_local := string(Char($5B8C));
            out_text := head_text_local + wan_text_local;
            out_path := combine_path_segments_local(head_text_local, wan_text_local);
            out_weight := head_weight_local + c_result_wan_span_bonus;
            Inc(out_weight, get_following_context_bonus_local(head_text_local,
                wan_text_local));
            Result := True;
        end;

        function try_resolve_final_three_syllable_span_text_local(
            const local_start: Integer; out out_text: string; out out_path: string;
            out out_weight: Integer): Boolean;
        var
            left_key_local: string;
            right_key_local: string;
            left_text_local: string;
            right_text_local: string;
            left_weight_local: Integer;
            right_weight_local: Integer;
            left_ambiguous_local: Boolean;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_weight := 0;
            if (input_syllable_count > 8) or (local_start < 0) or
                (local_start + 2 <> High(syllables_local)) then
            begin
                Exit;
            end;

            left_key_local := build_query_key_local(local_start, 2);
            right_key_local := build_query_key_local(local_start + 2, 1);
            if (not try_get_dictionary_span_text_local(left_key_local, 2, '',
                local_start,
                left_text_local, left_weight_local, left_ambiguous_local)) or
                (left_ambiguous_local and (input_syllable_count < 7)) or
                (not try_get_dictionary_single_text_local(right_key_local,
                right_text_local, right_weight_local)) then
            begin
                Exit;
            end;

            out_text := left_text_local + right_text_local;
            out_path := combine_path_segments_local(left_text_local,
                right_text_local);
            out_weight := left_weight_local + right_weight_local;
            if m_dictionary <> nil then
            begin
                Inc(out_weight, m_dictionary.get_context_bonus(left_text_local,
                    right_text_local));
            end;
            Result := True;
        end;

        function has_resolved_final_tail_three_syllable_span_local: Boolean;
        var
            dummy_text_local: string;
            dummy_path_local: string;
            dummy_weight_local: Integer;
        begin
            Result := (Length(syllables_local) >= 3) and
                try_resolve_final_three_syllable_span_text_local(
                Length(syllables_local) - 3, dummy_text_local, dummy_path_local,
                dummy_weight_local);
        end;

        function has_exact_phrase_starting_at_local(const local_pos: Integer): Boolean;
        var
            local_span_len: Integer;
            local_key: string;
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
        begin
            Result := False;
            if (local_pos < 0) or (local_pos >= Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_span_len := 2 to Min(get_effective_max_span_local,
                Length(syllables_local) - local_pos) do
            begin
                local_key := build_query_key_local(local_pos, local_span_len);
                if (local_key = '') or
                    (not dictionary_exact_lookup_cached(local_key,
                    local_results)) then
                begin
                    Continue;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    local_text := Trim(local_results[local_idx].text);
                    if (local_text <> '') and
                        (get_candidate_text_unit_count(local_text) =
                        local_span_len) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function should_skip_fixed_single_chain_step_local(
            const local_pos: Integer; const local_single_text: string): Boolean;
        begin
            Result := (input_syllable_count >= 4) and
                (Trim(local_single_text) <> '') and
                (not is_pronoun_fixed_single_text_local(local_single_text)) and
                has_exact_phrase_starting_at_local(local_pos);
