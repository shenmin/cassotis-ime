        function try_get_particle_exact_weight_local(const query_key: string;
            const text_value: string; const unit_count: Integer;
            out out_weight: Integer): Boolean;
        var
            cache_key_local: string;
            cached_weight_local: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (query_key = '') or (text_value = '') or (unit_count <= 0) then
            begin
                Exit;
            end;

            cache_key_local := query_key + #1 + text_value + #1 +
                IntToStr(unit_count);
            if (particle_exact_weight_cache <> nil) and
                particle_exact_weight_cache.TryGetValue(cache_key_local,
                cached_weight_local) then
            begin
                if cached_weight_local > Low(Integer) then
                begin
                    out_weight := cached_weight_local;
                    Exit(True);
                end;
                Exit(False);
            end;

            Result := get_display_exact_text_weight(query_key, text_value,
                unit_count, out_weight);
            if particle_exact_weight_cache <> nil then
            begin
                if Result then
                begin
                    particle_exact_weight_cache.AddOrSetValue(cache_key_local,
                        out_weight);
                end
                else
                begin
                    particle_exact_weight_cache.AddOrSetValue(cache_key_local,
                        Low(Integer));
                end;
            end;
        end;

        function particle_text_context_score_local(
            const candidate_text_value: string): Integer;
        var
            units_local: TArray<string>;
            unit_idx: Integer;
            current_unit: string;
            next_unit: string;
            next_is_verbal: Boolean;
        begin
            Result := 0;
            units_local := split_text_units(Trim(candidate_text_value));
            for unit_idx := 0 to High(units_local) - 1 do
            begin
                current_unit := Trim(units_local[unit_idx]);
                next_unit := Trim(units_local[unit_idx + 1]);
                if (current_unit = '') or (next_unit = '') then
                begin
                    Continue;
                end;

                next_is_verbal := is_likely_verbal_unit_local(next_unit);
                if SameText(current_unit, string(Char($5730))) then
                begin
                    if next_is_verbal then
                    begin
                        Inc(Result, 5000);
                    end
                    else
                    begin
                        Dec(Result, 12000);
                    end;
                end
                else if SameText(current_unit, string(Char($7684))) then
                begin
                    if next_is_verbal then
                    begin
                        Dec(Result, 7000);
                    end
                    else
                    begin
                        Inc(Result, 3000);
                    end;
                end;
            end;
        end;

