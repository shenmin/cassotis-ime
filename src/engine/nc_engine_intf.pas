    function try_finalize_budgeted_long_postprocess_candidate_local(
        const stage_tag: string): Boolean;
    const
        c_long_postprocess_soft_budget_ms = 1200;
    var
        total_elapsed_ms_local: UInt64;
    begin
        Result := False;
        if (Length(m_candidates) = 0) or
            (not delayed_long_decode_mode) or
            (not is_full_pinyin_key(lookup_text)) or
            (input_syllable_count < 12) then
        begin
            Exit;
        end;

        total_elapsed_ms_local := GetTickCount64 - total_start_tick;
        if not search_budget_should_stop(total_start_tick, 0, 0,
            c_long_postprocess_soft_budget_ms,
            c_long_postprocess_emergency_budget_ms) then
        begin
            Exit;
