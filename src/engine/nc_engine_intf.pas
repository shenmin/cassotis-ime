                c_context_probe_limit_local = 4;
            var
                cached_value_local: string;
                local_span_len_value: Integer;
                local_key_value: string;
                local_results_value: TncCandidateList;
                local_idx_value: Integer;
                local_text_value: string;
            begin
                Result := '';
                if (local_pos_value < 0) or
                    (local_pos_value >= Length(syllables_local)) then
                begin
                    Exit;
                end;
                if (suffix_first_unit_cache_local <> nil) and
                    suffix_first_unit_cache_local.TryGetValue(local_pos_value,
                    cached_value_local) then
                begin
                    Exit(cached_value_local);
                end;

                for local_span_len_value :=
                    Min(4, Length(syllables_local) - local_pos_value) downto 2 do
                begin
                    local_key_value := build_query_key_local(local_pos_value,
                        local_span_len_value);
                    if (local_key_value = '') or
                        (not lookup_exact_full_pinyin_cached_local(
                        local_key_value, local_results_value)) then
                    begin
                        Continue;
                    end;
                    for local_idx_value := 0 to High(local_results_value) do
                    begin
                        if local_idx_value >= c_context_probe_limit_local then
                        begin
                            Break;
                        end;
                        if Trim(local_results_value[local_idx_value].comment) <> '' then
                        begin
                            Continue;
