        function display_prefix_lookup_has_complete_text_local: Boolean;
        var
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or
                (not m_dictionary.lookup_full_pinyin_prefix(normalized_pinyin,
                prefix_results_local)) then
            begin
                Exit;
            end;

            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                prefix_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                if (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                    prefix_results_local[prefix_idx_local].has_dict_weight and
                    (prefix_results_local[prefix_idx_local].dict_weight > 0) and
                    SameText(prefix_text_local, candidate_text_local) and
                    (get_candidate_text_unit_count(prefix_text_local) =
                    expected_units) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        Result := False;
        if (m_dictionary = nil) or (expected_units <> 4) or
            (Length(syllables) <> 4) or
            (not is_full_pinyin_key(normalized_pinyin)) or
            (Trim(candidate_value.comment) <> '') or
            (candidate_value.source = cs_user) then
        begin
            Exit;
        end;

        candidate_text_local := Trim(candidate_value.text);
        if (candidate_text_local = '') or
            display_exact_key_has_text(normalized_pinyin, candidate_text_local) or
            m_dictionary.is_user_entry(normalized_pinyin, candidate_text_local) then
        begin
            Exit;
        end;

        if display_prefix_lookup_has_complete_text_local then
        begin
            Exit;
        end;

        units_local := split_text_units(candidate_text_local);
        if Length(units_local) <> 4 then
        begin
            Exit;
        end;

        head_text_local := units_local[0] + units_local[1];
        tail_text_local := units_local[2] + units_local[3];

        head_key_local := build_display_query_key(0, 2);
        tail_key_local := build_display_query_key(2, 2);
        if display_short_four_two_exact_path_is_supported_local(
            candidate_value) then
        begin
            Exit;
        end;

        if get_short_four_transition_particle_path_evidence(
            normalized_pinyin, candidate_text_local,
            transition_particle_path_local,
            transition_particle_evidence_local) then
        begin
            Exit;
        end;

        if display_productive_short_function_head_text(head_text_local) and
            display_exact_key_has_text(tail_key_local, tail_text_local) then
        begin
            Exit;
        end;

        if display_exact_key_has_text(head_key_local, head_text_local) and
            is_display_short_pronoun_unit_local(units_local[2]) and
            is_display_short_connector_unit_local(units_local[3]) then
        begin
            Exit;
        end;

        if is_display_short_pronoun_unit_local(units_local[0]) and
            is_display_short_connector_unit_local(units_local[1]) and
            display_exact_key_has_text(tail_key_local, tail_text_local) then
        begin
            Exit;
        end;

        first_unit_local := units_local[0];
        middle_text_local := units_local[1] + units_local[2];
        middle_key_local := build_display_query_key(1, 2);
        if is_display_one_plus_two_supported_head_single(first_unit_local) and
            display_exact_key_has_text(middle_key_local, middle_text_local) and
            is_display_short_particle_tail_unit_local(syllables[3].text,
            units_local[3]) then
        begin
            Exit;
        end;

        tail_text_local := units_local[1] + units_local[2] + units_local[3];
        tail_key_local := build_display_query_key(1, 3);
        if is_display_one_plus_two_supported_head_single(first_unit_local) and
            display_exact_key_has_text(tail_key_local, tail_text_local) then
        begin
            Exit;
        end;

        head_three_text_local := units_local[0] + units_local[1] +
            units_local[2];
        head_three_key_local := build_display_query_key(0, 3);
        if display_exact_key_has_text(head_three_key_local,
            head_three_text_local) and
            is_display_short_particle_tail_unit_local(syllables[3].text,
            units_local[3]) then
        begin
            Exit;
        end;

        Result := True;
    end;

    procedure filter_display_unsupported_short_four_ab_cd_complete_candidates;
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        path_local: string;
    begin
        if (Length(m_candidates) = 0) or (expected_units <> 4) or
            (m_dictionary = nil) or (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(m_candidates) do
        begin
            path_local := '';
            if in_idx_local < Length(m_candidate_segment_paths) then
            begin
                path_local := m_candidate_segment_paths[in_idx_local];
            end;

            if (not (m_candidates[in_idx_local].has_dict_weight and
                (m_candidates[in_idx_local].dict_weight > 0))) and
                display_candidate_is_unsupported_short_four_ab_cd_complete(
                m_candidates[in_idx_local]) then
            begin
                Continue;
            end;

            if out_idx_local <> in_idx_local then
            begin
                m_candidates[out_idx_local] := m_candidates[in_idx_local];
                if out_idx_local < Length(m_candidate_segment_paths) then
                begin
                    path_local := '';
                    if in_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        path_local := m_candidate_segment_paths[in_idx_local];
                    end;
                    m_candidate_segment_paths[out_idx_local] := path_local;
                end;
            end;
            Inc(out_idx_local);
        end;

        SetLength(m_candidates, out_idx_local);
        if Length(m_candidate_segment_paths) > out_idx_local then
        begin
            SetLength(m_candidate_segment_paths, out_idx_local);
        end;
    end;

