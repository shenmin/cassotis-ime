        function build_syllable_query_key(const start_idx: Integer;
            const syllable_count_local: Integer): string;
        var
            idx: Integer;
            cache_idx: Integer;
            cache_key: string;
        begin
            Result := '';
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local > Length(syllables)) then
            begin
                Exit;
            end;

            cache_key := IntToStr(start_idx) + ':' +
                IntToStr(syllable_count_local);
            for cache_idx := 0 to syllable_key_cache_count - 1 do
            begin
                if syllable_key_cache_keys[cache_idx] = cache_key then
                begin
                    Exit(syllable_key_cache_values[cache_idx]);
                end;
            end;

            for idx := start_idx to start_idx + syllable_count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(syllables[idx].text);
            end;
            SetLength(syllable_key_cache_keys, syllable_key_cache_count + 1);
            SetLength(syllable_key_cache_values, syllable_key_cache_count + 1);
            syllable_key_cache_keys[syllable_key_cache_count] := cache_key;
            syllable_key_cache_values[syllable_key_cache_count] := Result;
            Inc(syllable_key_cache_count);
        end;

        function get_light_sentence_beam_width_local: Integer;
        begin
            if head_syllable_count >= 16 then
            begin
                Exit(c_light_sentence_ultra_long_beam_width);
            end;

            if head_syllable_count >= 10 then
            begin
                Exit(c_light_sentence_long_beam_width);
            end;

            Result := c_light_sentence_beam_width;
        end;

