                else if (preferred_three_syllable_partial_kind = 2) and item.is_one_plus_two_partial then
                begin
                    Dec(item.rank_score, 880);
                end;
                list[i] := item;
            end;
        end;

        if use_intent_layers and has_strong_complete_phrase then
        begin
            for i := 0 to list.Count - 1 do
