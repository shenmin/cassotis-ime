    procedure prepare_weak_chain_query_cache;
    var
        parser: TncPinyinParser;
        idx: Integer;
    begin
        if weak_chain_query_prepared then
        begin
            Exit;
        end;

        weak_chain_query_prepared := True;
        weak_chain_normalized_query := normalize_pinyin_text(m_last_lookup_key);
        if weak_chain_normalized_query = '' then
        begin
            weak_chain_normalized_query := normalize_pinyin_text(m_composition_text);
        end;
        if weak_chain_normalized_query = '' then
        begin
            Exit;
        end;

        parser := TncPinyinParser.Create;
        try
            weak_chain_query_syllables := parser.parse(weak_chain_normalized_query);
        finally
            parser.Free;
        end;

        if Length(weak_chain_query_syllables) < 2 then
        begin
            SetLength(weak_chain_query_syllables, 0);
            Exit;
        end;

        for idx := 0 to High(weak_chain_query_syllables) do
        begin
            if Length(Trim(weak_chain_query_syllables[idx].text)) <= 1 then
            begin
                SetLength(weak_chain_query_syllables, 0);
                Exit;
            end;
        end;

        SetLength(weak_chain_preference_maps, Length(weak_chain_query_syllables));
        SetLength(best_sentence_single_char_texts, Length(weak_chain_query_syllables));
        SetLength(best_sentence_single_char_weights, Length(weak_chain_query_syllables));
        SetLength(best_sentence_single_char_known, Length(weak_chain_query_syllables));
        SetLength(best_two_syllable_exact_texts, Length(weak_chain_query_syllables) - 1);
        SetLength(best_two_syllable_exact_weights, Length(weak_chain_query_syllables) - 1);
        SetLength(best_two_syllable_exact_known, Length(weak_chain_query_syllables) - 1);
        if Length(weak_chain_query_syllables) >= 3 then
        begin
            SetLength(best_three_syllable_exact_texts, Length(weak_chain_query_syllables) - 2);
            SetLength(best_three_syllable_exact_weights, Length(weak_chain_query_syllables) - 2);
            SetLength(best_three_syllable_exact_known, Length(weak_chain_query_syllables) - 2);
        end
        else
        begin
            SetLength(best_three_syllable_exact_texts, 0);
            SetLength(best_three_syllable_exact_weights, 0);
            SetLength(best_three_syllable_exact_known, 0);
        end;
        if Length(weak_chain_query_syllables) >= 4 then
        begin
            SetLength(best_four_syllable_exact_texts, Length(weak_chain_query_syllables) - 3);
            SetLength(best_four_syllable_exact_weights, Length(weak_chain_query_syllables) - 3);
            SetLength(best_four_syllable_exact_known, Length(weak_chain_query_syllables) - 3);
        end
        else
        begin
            SetLength(best_four_syllable_exact_texts, 0);
            SetLength(best_four_syllable_exact_weights, 0);
            SetLength(best_four_syllable_exact_known, 0);
        end;
    end;
    function try_get_best_sentence_single_char_for_sort(const syllable_index: Integer;
        out out_text: string; out out_weight: Integer): Boolean;
    const
        c_probe_limit = 6;
    var
        local_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
        is_preferred: Boolean;
        weight_value: Integer;
        fixed_text: string;
    begin
        Result := False;
        out_text := '';
        out_weight := 0;
        prepare_weak_chain_query_cache;
        if (syllable_index < 0) or (syllable_index > High(weak_chain_query_syllables)) then
        begin
            Exit;
        end;

        if best_sentence_single_char_known[syllable_index] then
        begin
            out_text := best_sentence_single_char_texts[syllable_index];
            out_weight := best_sentence_single_char_weights[syllable_index];
            Exit(out_text <> '');
        end;

        best_sentence_single_char_known[syllable_index] := True;
        fixed_text := get_fixed_sentence_single_char_for_sort(
            weak_chain_query_syllables[syllable_index].text);
        if fixed_text <> '' then
        begin
            best_sentence_single_char_texts[syllable_index] := fixed_text;
            best_sentence_single_char_weights[syllable_index] := 960;
            out_text := fixed_text;
            out_weight := 960;
            Exit(True);
        end;

        if (m_dictionary = nil) or
            (not dictionary_lookup_cached_for_sort(
            Trim(weak_chain_query_syllables[syllable_index].text), False,
            local_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(local_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            candidate_text := Trim(local_results[idx].text);
            if (get_candidate_text_unit_count(candidate_text) <> 1) or
                (not match_single_char_candidate_for_syllable(
                weak_chain_query_syllables[syllable_index].text, candidate_text, is_preferred)) or
                (not is_preferred) then
            begin
                Continue;
            end;

            if local_results[idx].has_dict_weight then
            begin
                weight_value := local_results[idx].dict_weight;
            end
            else
            begin
                weight_value := local_results[idx].score;
            end;

            if weight_value > out_weight then
            begin
                out_text := candidate_text;
                out_weight := weight_value;
                Result := True;
            end;
        end;

        if Result then
        begin
            best_sentence_single_char_texts[syllable_index] := out_text;
            best_sentence_single_char_weights[syllable_index] := out_weight;
        end;
    end;
    function build_sort_query_key(const start_idx: Integer;
        const syllable_count_local: Integer): string;
    var
        idx: Integer;
    begin
        Result := '';
        prepare_weak_chain_query_cache;
        if (start_idx < 0) or (syllable_count_local <= 0) or
            (start_idx + syllable_count_local - 1 > High(weak_chain_query_syllables)) then
        begin
            Exit;
        end;
        for idx := start_idx to start_idx + syllable_count_local - 1 do
        begin
            Result := Result + normalize_pinyin_text(weak_chain_query_syllables[idx].text);
        end;
    end;
    function try_get_best_exact_phrase_for_cached_span(const start_idx: Integer;
        const syllable_count_local: Integer; var text_cache: TArray<string>;
        var weight_cache: TArray<Integer>; var known_cache: TArray<Boolean>;
        out out_text: string; out out_weight: Integer): Boolean;
    const
        c_probe_limit = 8;
    var
        query_key: string;
        local_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
        candidate_units: Integer;
        weight_value: Integer;
    begin
        Result := False;
        out_text := '';
        out_weight := 0;
        prepare_weak_chain_query_cache;
        if (start_idx < 0) or (start_idx > High(known_cache)) then
        begin
            Exit;
        end;

        if known_cache[start_idx] then
        begin
            out_text := text_cache[start_idx];
            out_weight := weight_cache[start_idx];
            Exit(out_text <> '');
        end;

        known_cache[start_idx] := True;
        query_key := build_sort_query_key(start_idx, syllable_count_local);
        if (query_key = '') or (m_dictionary = nil) or
            (not dictionary_lookup_cached_for_sort(query_key, True,
            local_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(local_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            if Trim(local_results[idx].comment) <> '' then
            begin
                Continue;
            end;
            if (local_results[idx].source = cs_user) or
                (not local_results[idx].has_dict_weight) or
                is_runtime_chain_candidate(local_results[idx]) or
                is_runtime_common_pattern_candidate(local_results[idx]) or
                is_runtime_redup_candidate(local_results[idx]) then
            begin
                Continue;
            end;

            candidate_text := Trim(local_results[idx].text);
            candidate_units := get_candidate_text_unit_count(candidate_text);
            if candidate_units <> syllable_count_local then
            begin
                Continue;
            end;

            if local_results[idx].has_dict_weight then
            begin
                weight_value := local_results[idx].dict_weight;
            end
            else
            begin
                weight_value := local_results[idx].score;
            end;

            if weight_value > out_weight then
            begin
                out_text := candidate_text;
                out_weight := weight_value;
                Result := True;
            end;
        end;

        if Result then
        begin
            text_cache[start_idx] := out_text;
            weight_cache[start_idx] := out_weight;
        end;
    end;
    function try_get_best_exact_phrase_for_two_syllable_span(const start_idx: Integer;
        out out_text: string; out out_weight: Integer): Boolean;
    begin
        Result := try_get_best_exact_phrase_for_cached_span(start_idx, 2,
            best_two_syllable_exact_texts, best_two_syllable_exact_weights,
            best_two_syllable_exact_known, out_text, out_weight);
    end;
    function try_get_best_exact_phrase_for_three_syllable_span(const start_idx: Integer;
        out out_text: string; out out_weight: Integer): Boolean;
    begin
        Result := try_get_best_exact_phrase_for_cached_span(start_idx, 3,
            best_three_syllable_exact_texts, best_three_syllable_exact_weights,
            best_three_syllable_exact_known, out_text, out_weight);
    end;
    function try_get_best_exact_phrase_for_four_syllable_span(const start_idx: Integer;
        out out_text: string; out out_weight: Integer): Boolean;
    begin
        Result := try_get_best_exact_phrase_for_cached_span(start_idx, 4,
            best_four_syllable_exact_texts, best_four_syllable_exact_weights,
            best_four_syllable_exact_known, out_text, out_weight);
    end;
    function get_sentence_path_bridge_adjustment(const candidate: TncCandidate): Integer;
    const
        c_exact_span_min_weight = 1200;
        c_exact_two_span_match_bonus = 320;
        c_exact_three_span_match_bonus = 480;
        c_exact_four_span_match_bonus = 640;
        c_exact_two_span_mismatch_penalty = 720;
        c_exact_three_span_mismatch_penalty = 1040;
        c_exact_four_span_mismatch_penalty = 1520;
    var
        encoded_path: string;
        segment_parts: TArray<string>;
        segment_idx: Integer;
        syllable_idx: Integer;
        segment_text: string;
        next_segment_text: string;
        segment_units: Integer;
        next_segment_units: Integer;
        left_text: string;
        right_text: string;
        left_weight: Integer;
        right_weight: Integer;
        fixed_left: string;
        fixed_right: string;
        fixed_third: string;
        combined_text: string;
        candidate_units: TArray<string>;
        segment_units_texts: TArray<string>;
        unit_idx: Integer;
        append_idx: Integer;
        window_start: Integer;
        window_len: Integer;
        window_text: string;
        best_exact_span_text: string;
        best_exact_span_weight: Integer;
        best_exact_two_text: string;
        best_exact_two_weight: Integer;
        best_exact_three_text: string;
        best_exact_three_weight: Integer;
        bridge_cache_key: string;
        cached_bridge_adjustment: Integer;
        function try_get_best_exact_phrase_for_span_local(const start_idx: Integer;
            const span_len: Integer; out out_text: string;
            out out_weight: Integer): Boolean;
        begin
            Result := False;
            case span_len of
                2:
                    Result := try_get_best_exact_phrase_for_two_syllable_span(
                        start_idx, out_text, out_weight);
                3:
                    Result := try_get_best_exact_phrase_for_three_syllable_span(
                        start_idx, out_text, out_weight);
                4:
                    Result := try_get_best_exact_phrase_for_four_syllable_span(
                        start_idx, out_text, out_weight);
            end;
        end;
    begin
        Result := 0;
        if (candidate.comment <> '') or (candidate.source = cs_user) or
            (get_candidate_text_unit_count(candidate.text) < 2) then
        begin
            Exit;
        end;

        prepare_weak_chain_query_cache;
        if Length(weak_chain_query_syllables) < 2 then
        begin
            Exit;
        end;

        encoded_path := get_segment_path_for_candidate(candidate);
        if get_encoded_path_segment_count_local(encoded_path) <= 1 then
        begin
            Exit;
        end;
        bridge_cache_key := 'sortbridge' + #1 + m_last_lookup_key + #1 +
            Trim(candidate.text) + #1 + encoded_path;
        if (m_lookup_display_feature_cache <> nil) and
            m_lookup_display_feature_cache.TryGetValue(bridge_cache_key,
            cached_bridge_adjustment) then
        begin
            Exit(cached_bridge_adjustment);
        end;

        segment_parts := encoded_path.Split([c_segment_path_separator]);
        SetLength(candidate_units, 0);
        for segment_idx := 0 to High(segment_parts) do
        begin
            segment_units_texts := split_text_units(Trim(segment_parts[segment_idx]));
            for unit_idx := 0 to High(segment_units_texts) do
            begin
                append_idx := Length(candidate_units);
                SetLength(candidate_units, append_idx + 1);
                candidate_units[append_idx] := segment_units_texts[unit_idx];
            end;
        end;

        syllable_idx := 0;
        for segment_idx := 0 to High(segment_parts) do
        begin
            segment_text := Trim(segment_parts[segment_idx]);
            segment_units := get_candidate_text_unit_count(segment_text);
            if (segment_units = 2) and (syllable_idx + 1 <= High(weak_chain_query_syllables)) then
            begin
                fixed_left := get_fixed_sentence_single_char_for_sort(
                    weak_chain_query_syllables[syllable_idx].text);
                fixed_right := get_fixed_sentence_single_char_for_sort(
                    weak_chain_query_syllables[syllable_idx + 1].text);
                best_exact_two_text := '';
                best_exact_two_weight := 0;
                if try_get_best_exact_phrase_for_two_syllable_span(
                    syllable_idx, best_exact_two_text, best_exact_two_weight) then
                begin
                    if SameText(segment_text, best_exact_two_text) then
                    begin
                        Inc(Result, 720);
                    end
                    else if (fixed_left <> '') and (fixed_right <> '') and
                        SameText(segment_text, fixed_left + fixed_right) then
                    begin
                        Dec(Result, 1600);
                    end;
                end;

                if try_get_best_sentence_single_char_for_sort(
                    syllable_idx, left_text, left_weight) and
                    try_get_best_sentence_single_char_for_sort(
                    syllable_idx + 1, right_text, right_weight) and
                    (segment_text <> left_text + right_text) then
                begin
                    if (left_weight + right_weight) >= 1500 then
                    begin
                        Dec(Result, 1100);
                    end
                    else if (left_weight + right_weight) >= 1200 then
                    begin
                        Dec(Result, 780);
                    end;
                end;

                if (segment_idx < High(segment_parts)) and
                    (syllable_idx + 2 <= High(weak_chain_query_syllables)) then
                begin
                    next_segment_text := Trim(segment_parts[segment_idx + 1]);
                    next_segment_units := get_candidate_text_unit_count(next_segment_text);
                    if next_segment_units >= 1 then
                    begin
                        combined_text := segment_text + split_text_units(next_segment_text)[0];
                        fixed_third := get_fixed_sentence_single_char_for_sort(
                            weak_chain_query_syllables[syllable_idx + 2].text);
                        best_exact_three_text := '';
                        best_exact_three_weight := 0;
                        if try_get_best_exact_phrase_for_three_syllable_span(
                            syllable_idx, best_exact_three_text, best_exact_three_weight) then
                        begin
                            if combined_text = best_exact_three_text then
                            begin
                                Inc(Result, 520);
                            end
                            else if (fixed_left <> '') and (fixed_right <> '') and
                                (fixed_third <> '') and
                                SameText(combined_text,
                                fixed_left + fixed_right + fixed_third) then
                            begin
                                Dec(Result, 880);
                            end;
                        end;
                    end;
                end;
            end;
            Inc(syllable_idx, segment_units);
        end;

        if Length(candidate_units) = Length(weak_chain_query_syllables) then
        begin
            for window_len := 2 to 4 do
            begin
                for window_start := 0 to Length(candidate_units) - window_len do
                begin
                    best_exact_span_text := '';
                    best_exact_span_weight := 0;
                    if not try_get_best_exact_phrase_for_span_local(window_start,
                        window_len, best_exact_span_text, best_exact_span_weight) then
                    begin
                        Continue;
                    end;
                    if best_exact_span_weight < c_exact_span_min_weight then
                    begin
                        Continue;
                    end;

                    window_text := '';
                    for unit_idx := window_start to window_start + window_len - 1 do
                    begin
                        window_text := window_text + candidate_units[unit_idx];
                    end;

                    if SameText(window_text, best_exact_span_text) then
                    begin
                        case window_len of
                            2:
                                Inc(Result, c_exact_two_span_match_bonus);
                            3:
                                Inc(Result, c_exact_three_span_match_bonus);
                            4:
                                Inc(Result, c_exact_four_span_match_bonus);
                        end;
                    end
                    else
                    begin
                        case window_len of
                            2:
                                Dec(Result, c_exact_two_span_mismatch_penalty);
                            3:
                                Dec(Result, c_exact_three_span_mismatch_penalty);
                            4:
                                Dec(Result, c_exact_four_span_mismatch_penalty);
                        end;
                    end;
                end;
            end;
        end;
        if m_lookup_display_feature_cache <> nil then
        begin
            m_lookup_display_feature_cache.AddOrSetValue(bridge_cache_key,
                Result);
        end;
    end;
    function is_weighted_complete_phrase_candidate(const candidate: TncCandidate): Boolean;
    var
        encoded_path: string;
    begin
        Result := (candidate.comment = '') and candidate.has_dict_weight and
            (get_candidate_text_unit_count(candidate.text) >= 2);
        if Result then
        begin
            Exit;
        end;

        if (candidate.comment <> '') or
            (m_last_lookup_syllable_count < c_long_sentence_full_path_min_syllables) or
            (get_candidate_text_unit_count(candidate.text) < 2) or
            is_runtime_chain_candidate(candidate) or
            is_runtime_common_pattern_candidate(candidate) or
            is_runtime_redup_candidate(candidate) then
        begin
            Exit(False);
        end;

        encoded_path := get_segment_path_for_candidate(candidate);
        Result := get_encoded_path_segment_count_local(encoded_path) > 1;
    end;
    function has_multi_char_segment_path_candidate(const candidate: TncCandidate): Boolean;
    var
        encoded_path: string;
        segment_parts: TArray<string>;
        part: string;
    begin
        Result := False;
        if candidate.comment <> '' then
        begin
            Exit;
        end;

        encoded_path := get_segment_path_for_candidate(candidate);
        if get_encoded_path_segment_count_local(encoded_path) <= 1 then
        begin
            Exit;
        end;

        segment_parts := encoded_path.Split([c_segment_path_separator]);
        for part in segment_parts do
        begin
            if get_candidate_text_unit_count(Trim(part)) >= 2 then
            begin
                Exit(True);
            end;
        end;
    end;
    function is_runtime_constructed_complete_phrase_candidate(const candidate: TncCandidate): Boolean;
    begin
        Result := (candidate.comment = '') and (get_candidate_text_unit_count(candidate.text) >= 2) and
            (is_runtime_chain_candidate(candidate) or
            is_runtime_common_pattern_candidate(candidate) or
            is_runtime_redup_candidate(candidate));
    end;
    function is_weak_single_char_chain_candidate_cached(const candidate: TncCandidate): Boolean;
    var
        text_units: TArray<string>;
        idx: Integer;
        is_preferred: Boolean;
        is_matched: Boolean;
        has_weak_unit: Boolean;
    begin
        Result := False;
        if candidate.comment <> '' then
        begin
            Exit;
        end;

        if (candidate.source = cs_user) and
            (get_candidate_text_unit_count(candidate.text) >= 2) and
            (candidate.has_dict_weight or (candidate.score > 8)) then
        begin
            Exit(False);
        end;

        if has_multi_char_segment_path_candidate(candidate) then
        begin
            Exit(False);
        end;

        prepare_weak_chain_query_cache;
        if Length(weak_chain_query_syllables) < 2 then
        begin
            Exit;
        end;

        text_units := split_text_units(Trim(candidate.text));
        if Length(text_units) <> Length(weak_chain_query_syllables) then
        begin
            Exit;
        end;

        has_weak_unit := False;
        for idx := 0 to High(text_units) do
        begin
            is_preferred := get_cached_single_char_preference(idx, text_units[idx], is_matched);
            if not is_matched then
            begin
                Exit(False);
            end;
            if not is_preferred then
            begin
                has_weak_unit := True;
            end;
        end;

        Result := has_weak_unit;
    end;
    function is_problematic_single_char_chain_candidate_cached(const candidate: TncCandidate): Boolean;
    var
        text_units: TArray<string>;
        idx: Integer;
        is_matched: Boolean;
    begin
        Result := False;
        if candidate.comment <> '' then
        begin
            Exit;
        end;

        if (candidate.source = cs_user) and
            (get_candidate_text_unit_count(candidate.text) >= 2) and
            (candidate.has_dict_weight or (candidate.score > 8)) then
        begin
            Exit(False);
        end;

        if has_multi_char_segment_path_candidate(candidate) then
        begin
            Exit(False);
        end;

        prepare_weak_chain_query_cache;
        if Length(weak_chain_query_syllables) < 2 then
        begin
            Exit;
        end;

        if is_weak_single_char_chain_candidate_cached(candidate) then
        begin
            Exit(True);
        end;

        if (not is_runtime_chain_candidate(candidate)) and
            (candidate.source <> cs_user) then
        begin
            Exit(False);
        end;

        if not is_runtime_chain_candidate(candidate) then
        begin
            Exit(False);
        end;

        text_units := split_text_units(Trim(candidate.text));
        if Length(text_units) <> Length(weak_chain_query_syllables) then
        begin
            Exit;
        end;

        for idx := 0 to High(text_units) do
        begin
            get_cached_single_char_preference(idx, text_units[idx], is_matched);
            if not is_matched then
            begin
                Exit(False);
            end;
        end;

        Result := is_runtime_constructed_phrase_friendly(candidate.text);
    end;

    function is_demonstrative_head_friendly_partial_candidate_cached(
        const candidate: TncCandidate): Boolean;
    var
