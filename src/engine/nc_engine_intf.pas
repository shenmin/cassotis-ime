            if (right_fixed <> '') and (segment_start + 2 < head_syllable_count) and
                try_get_best_sentence_single_char(left_key, left_text, left_weight) and
                try_get_best_sentence_single_char(right_key, right_text, right_weight) and
                try_get_best_following_sentence_phrase_weight(segment_start + 2, 2,
                follow_weight) then
            begin
                combined_weight := left_weight + right_weight + follow_weight;
                if combined_weight >= candidate_weight + 640 then
                begin
                    Exit(3600);
                end
                else if combined_weight >= candidate_weight + 420 then
                begin
                    Exit(2600);
                end
                else if combined_weight >= candidate_weight + 220 then
                begin
                    Exit(1720);
                end;
            end;
        end;

        function get_exact_phrase_split_penalty(const segment_start: Integer;
            const segment_syllables: Integer; const candidate_text: string;
            const candidate_weight: Integer): Integer;
        const
            c_anchor_unit_bonus = 320;
            c_edge_fixed_bonus = 260;
        var
            split_pos: Integer;
            left_text: string;
            right_text: string;
            left_weight: Integer;
            right_weight: Integer;
            left_anchor_units: Integer;
            right_anchor_units: Integer;
            combined_text: string;
            combined_weight: Integer;
            best_split_weight: Integer;
            left_fixed: string;
            right_fixed: string;
        begin
            Result := 0;
            if (segment_syllables < 3) or
                (get_candidate_text_unit_count(candidate_text) < 2) or
                (segment_start < 0) or
                (segment_start + segment_syllables > head_syllable_count) then
            begin
                Exit;
            end;

            best_split_weight := Low(Integer);
            for split_pos := 1 to segment_syllables - 1 do
            begin
                if (not try_resolve_best_exact_sentence_subspan(segment_start,
                    split_pos, left_text, left_weight, left_anchor_units)) or
                    (not try_resolve_best_exact_sentence_subspan(
                    segment_start + split_pos,
                    segment_syllables - split_pos, right_text, right_weight,
                    right_anchor_units)) then
                begin
                    Continue;
                end;

                if (left_text = '') or (right_text = '') then
                begin
                    Continue;
                end;

                combined_text := left_text + right_text;
                if SameText(combined_text, candidate_text) then
                begin
                    Continue;
                end;

                combined_weight := left_weight + right_weight +
                    get_sentence_context_bonus_scaled(left_text, right_text) +
                    ((left_anchor_units + right_anchor_units) *
                    c_anchor_unit_bonus);

                left_fixed := get_fixed_sentence_single_char(
                    normalize_pinyin_text(syllables[segment_start].text));
                if (split_pos = 1) and (left_fixed <> '') and
                    SameText(left_text, left_fixed) then
                begin
                    Inc(combined_weight, c_edge_fixed_bonus);
                end;

                right_fixed := get_fixed_sentence_single_char(
                    normalize_pinyin_text(
                    syllables[segment_start + segment_syllables - 1].text));
                if (split_pos = segment_syllables - 1) and
                    (right_fixed <> '') and SameText(right_text, right_fixed) then
                begin
                    Inc(combined_weight, c_edge_fixed_bonus);
                end;

                if combined_weight > best_split_weight then
                begin
                    best_split_weight := combined_weight;
                end;
            end;

            if best_split_weight <= Low(Integer) div 4 then
            begin
                Exit;
            end;

            if (segment_syllables = 3) and (candidate_weight >= 900) then
            begin
                if best_split_weight >= candidate_weight + 2200 then
                begin
                    Exit(480);
                end;
                Exit(0);
            end;

            if best_split_weight >= candidate_weight + 960 then
            begin
                Exit(4200);
            end
            else if best_split_weight >= candidate_weight + 520 then
            begin
                Exit(2600);
            end
            else if best_split_weight >= candidate_weight + 220 then
            begin
                Exit(1400);
            end
            else if best_split_weight >= candidate_weight - 40 then
            begin
                Exit(720);
            end;
        end;

        function try_build_two_single_rescue_segment(const segment_start: Integer;
            out out_text: string; out out_weight: Integer;
            out out_rank_bonus: Integer): Boolean;
        var
            left_text: string;
            right_text: string;
            left_weight: Integer;
            right_weight: Integer;
            left_fixed: string;
            right_fixed: string;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            out_rank_bonus := 0;
            if (segment_start < 0) or (segment_start + 1 >= head_syllable_count) or
                (head_syllable_count < c_long_sentence_full_path_min_syllables) then
            begin
                Exit;
            end;

            left_fixed := get_fixed_sentence_single_char(
                normalize_pinyin_text(syllables[segment_start].text));
            right_fixed := get_fixed_sentence_single_char(
                normalize_pinyin_text(syllables[segment_start + 1].text));
            if (left_fixed = '') and (right_fixed = '') then
            begin
                Exit;
            end;

            if should_skip_two_single_rescue_segment(segment_start) then
            begin
                Exit;
            end;

            if (not try_get_best_sentence_single_char(
                normalize_pinyin_text(syllables[segment_start].text), left_text, left_weight)) or
                (not try_get_best_sentence_single_char(
                normalize_pinyin_text(syllables[segment_start + 1].text), right_text, right_weight)) then
            begin
                Exit;
            end;

            out_text := left_text + right_text;
            out_weight := left_weight + right_weight;
            out_rank_bonus := c_light_sentence_two_single_rescue_bonus;
            Result := get_candidate_text_unit_count(out_text) = 2;
        end;

        procedure add_state(var states: TLightSentenceStateArray;
            const candidate_state: TLightSentenceState);
        var
            idx: Integer;
            insert_idx: Integer;
            tmp_state: TLightSentenceState;
        begin
            if is_debug_target_recall_prefix(candidate_state.text) then
            begin
                m_debug_target_max_generated_syllable := Max(
                    m_debug_target_max_generated_syllable,
                    get_candidate_text_unit_count(candidate_state.text));
            end;

            for idx := 0 to High(states) do
            begin
                if states[idx].path = candidate_state.path then
                begin
                    if candidate_state.score > states[idx].score then
                    begin
                        states[idx] := candidate_state;
                    end;
                    Exit;
                end;
            end;

            insert_idx := Length(states);
            SetLength(states, insert_idx + 1);
            states[insert_idx] := candidate_state;
            while (insert_idx > 0) and (states[insert_idx].score > states[insert_idx - 1].score) do
            begin
                tmp_state := states[insert_idx - 1];
                states[insert_idx - 1] := states[insert_idx];
                states[insert_idx] := tmp_state;
                Dec(insert_idx);
            end;

            if Length(states) > get_light_sentence_beam_width_local then
            begin
                SetLength(states, get_light_sentence_beam_width_local);
            end;

            for idx := 0 to High(states) do
            begin
                if is_debug_target_recall_prefix(states[idx].text) then
                begin
                    m_debug_target_max_retained_syllable := Max(
                        m_debug_target_max_retained_syllable,
                        get_candidate_text_unit_count(states[idx].text));
                end;
            end;
        end;

        procedure append_light_candidate(const text_value: string; const comment_value: string;
            const path_value: string; const score_value: Integer;
            const path_score_hint_value: Integer;
            const fuzzy_cost_value: Integer = 0;
            const fuzzy_rules_value: TncFuzzyPinyinRules = []);
        var
            candidate: TncCandidate;
            next_index: Integer;
        begin
            if Trim(text_value) = '' then
            begin
                Exit;
            end;

            candidate := Default(TncCandidate);
            candidate.text := Trim(text_value);
            candidate.comment := Trim(comment_value);
            candidate.score := score_value;
            candidate.source := cs_rule;
            candidate.has_dict_weight := False;
            candidate.dict_weight := 0;
            candidate.fuzzy_cost := fuzzy_cost_value;
            candidate.fuzzy_rules := fuzzy_rules_value;

            next_index := Length(out_candidates);
            SetLength(out_candidates, next_index + 1);
            out_candidates[next_index] := candidate;
            remember_segment_path_for_candidate(candidate.text, candidate.comment,
                Trim(path_value), path_score_hint_value);
        end;

        procedure append_best_same_span_exact_segment_repair(
            const state_value: TLightSentenceState);
        const
            c_repair_min_gap = 160;
            c_repair_base_bonus = 1800;
            c_repair_gap_scale = 4;
            c_repair_max_gap_bonus = 8000;
        var
            path_parts: TArray<string>;
            repaired_parts: TArray<string>;
            part_idx: Integer;
            unit_pos: Integer;
            part_units: Integer;
            exact_results: TncCandidateList;
            query_key: string;
            current_text: string;
            best_text: string;
            repaired_text: string;
            repaired_path: string;
            current_weight: Integer;
            best_weight: Integer;
            best_rank: Integer;
            total_gap: Integer;
            repair_score: Integer;
            changed: Boolean;
            duplicate_idx: Integer;
            duplicate_found: Boolean;

            function get_candidate_weight_from_exact_results(
                const text_value: string; out out_weight: Integer): Boolean;
            var
                local_idx: Integer;
                local_text: string;
            begin
                Result := False;
                out_weight := 0;
                for local_idx := 0 to High(exact_results) do
                begin
                    if not is_allowed_sentence_segment_candidate(
                        exact_results[local_idx], unit_pos, part_units) then
                    begin
                        Continue;
                    end;
                    local_text := Trim(exact_results[local_idx].text);
                    if not SameText(local_text, text_value) then
                    begin
                        Continue;
                    end;
                    out_weight := get_light_sentence_segment_effective_weight(
                        exact_results[local_idx], query_key, local_text);
                    Exit(True);
                end;
            end;
        begin
            if (head_syllable_count < 5) or (Trim(state_value.path) = '') then
            begin
                Exit;
            end;

            path_parts := state_value.path.Split([c_segment_path_separator]);
            if Length(path_parts) <= 1 then
            begin
                Exit;
            end;
            SetLength(repaired_parts, Length(path_parts));
            for part_idx := 0 to High(path_parts) do
            begin
                repaired_parts[part_idx] := Trim(path_parts[part_idx]);
            end;

            unit_pos := 0;
            total_gap := 0;
            changed := False;
            for part_idx := 0 to High(repaired_parts) do
            begin
                current_text := Trim(repaired_parts[part_idx]);
                part_units := get_candidate_text_unit_count(current_text);
                if (current_text = '') or (part_units <= 0) or
                    (unit_pos + part_units > head_syllable_count) then
                begin
                    Exit;
                end;

                if part_units >= 2 then
                begin
                    query_key := build_syllable_query_key(unit_pos, part_units);
                    if (query_key <> '') and
                        dictionary_exact_lookup_cached(query_key, exact_results) and
                        find_best_same_span_exact_segment(exact_results, unit_pos,
                        part_units, query_key, best_text, best_weight,
                        best_rank) and (best_text <> '') and
                        (not SameText(best_text, current_text)) and
                        get_candidate_weight_from_exact_results(current_text,
                        current_weight) and
                        (best_weight >= current_weight + c_repair_min_gap) then
                    begin
                        repaired_parts[part_idx] := best_text;
                        Inc(total_gap, best_weight - current_weight);
                        changed := True;
                        if m_config.debug_mode then
                        begin
                            m_last_full_path_debug_info :=
                                m_last_full_path_debug_info +
                                Format(' spanrepair=[%s>%s gap=%d]',
                                [current_text, best_text,
                                best_weight - current_weight]);
                        end;
                    end;
                end;

                Inc(unit_pos, part_units);
            end;

            if (not changed) or (unit_pos <> head_syllable_count) then
            begin
                Exit;
            end;

            repaired_text := '';
            repaired_path := '';
            for part_idx := 0 to High(repaired_parts) do
            begin
                repaired_text := repaired_text + repaired_parts[part_idx];
                if repaired_path <> '' then
                begin
                    repaired_path := repaired_path + c_segment_path_separator;
                end;
                repaired_path := repaired_path + repaired_parts[part_idx];
            end;
            if (repaired_text = '') or SameText(repaired_text,
                Trim(state_value.text)) then
            begin
                Exit;
            end;

            repair_score := state_value.score + c_repair_base_bonus +
                Min(c_repair_max_gap_bonus, total_gap * c_repair_gap_scale);

            duplicate_found := False;
            for duplicate_idx := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[duplicate_idx].text),
                    repaired_text) and
                    (Trim(out_candidates[duplicate_idx].comment) = '') then
                begin
                    duplicate_found := True;
                    Break;
                end;
            end;
            if duplicate_found then
            begin
                if repair_score > out_candidates[duplicate_idx].score then
                begin
                    out_candidates[duplicate_idx].score := repair_score;
                    out_candidates[duplicate_idx].dict_weight := repair_score;
                    out_candidates[duplicate_idx].has_dict_weight := True;
                    remember_segment_path_for_candidate(repaired_text, '',
                        repaired_path, repair_score);
                end;
                Exit;
            end;

            append_light_candidate(repaired_text, '', repaired_path,
                repair_score, state_value.lexical_rank_score +
                c_repair_base_bonus + Min(c_repair_max_gap_bonus,
                total_gap * c_repair_gap_scale), state_value.fuzzy_cost,
                state_value.fuzzy_rules);
        end;

        procedure append_direct_exact_span_repair_candidate(
            const state_value: TLightSentenceState);
        const
            c_min_span_weight = 260;
            c_repair_base_bonus = 9000;
            c_repair_unit_bonus = 1400;
            c_repair_max_bonus = 24000;
        var
            source_units: TArray<string>;
            repaired_units: TArray<string>;
            pos: Integer;
            scan_len: Integer;
            best_len: Integer;
            best_text: string;
            best_weight: Integer;
            best_rank: Integer;
            exact_text: string;
            exact_weight: Integer;
            exact_rank: Integer;
            exact_units: TArray<string>;
            unit_idx: Integer;
            current_span_text: string;
            repaired_text: string;
            repaired_path: string;
            total_weight: Integer;
            total_units: Integer;
            replacement_count: Integer;
            repair_score: Integer;
            duplicate_idx: Integer;
            duplicate_found: Boolean;

            function join_source_units_local(const start_idx: Integer;
                const unit_count: Integer): string;
            var
                join_idx: Integer;
            begin
                Result := '';
                if (start_idx < 0) or (unit_count <= 0) or
                    (start_idx + unit_count > Length(source_units)) then
                begin
                    Exit;
                end;
                for join_idx := start_idx to start_idx + unit_count - 1 do
                begin
                    Result := Result + source_units[join_idx];
                end;
            end;

            procedure append_path_segment_local(const segment_text: string);
            begin
                if Trim(segment_text) = '' then
                begin
                    Exit;
                end;
                if repaired_path <> '' then
                begin
                    repaired_path := repaired_path + c_segment_path_separator;
                end;
                repaired_path := repaired_path + segment_text;
            end;
        begin
            if (head_syllable_count < c_long_sentence_full_path_min_syllables) or
                (Trim(state_value.text) = '') then
            begin
                Exit;
            end;

            source_units := split_text_units(Trim(state_value.text));
            if Length(source_units) <> head_syllable_count then
            begin
                Exit;
            end;
            SetLength(repaired_units, Length(source_units));
            for unit_idx := 0 to High(source_units) do
            begin
                repaired_units[unit_idx] := source_units[unit_idx];
            end;

            pos := 0;
            total_weight := 0;
            total_units := 0;
            replacement_count := 0;
            repaired_path := '';
            while pos < head_syllable_count do
            begin
                best_len := 0;
                best_text := '';
                best_weight := 0;
                best_rank := -1;
                for scan_len := Min(5, head_syllable_count - pos) downto 3 do
                begin
                    if not try_get_direct_exact_sentence_span_candidate(pos,
                        scan_len, exact_text, exact_weight, exact_rank) then
                    begin
                        Continue;
                    end;
                    if (exact_weight < c_min_span_weight) or (exact_text = '') then
                    begin
                        Continue;
                    end;

                    exact_units := split_text_units(exact_text);
                    if Length(exact_units) <> scan_len then
                    begin
                        Continue;
                    end;

                    current_span_text := join_source_units_local(pos, scan_len);
                    if SameText(current_span_text, exact_text) then
                    begin
                        Continue;
                    end;

                    if (best_len <= 0) or
                        (scan_len > best_len) or
                        ((scan_len = best_len) and (exact_weight > best_weight)) then
                    begin
                        best_len := scan_len;
                        best_text := exact_text;
                        best_weight := exact_weight;
                        best_rank := exact_rank;
                    end;
                end;

                if best_len > 0 then
                begin
                    exact_units := split_text_units(best_text);
                    for unit_idx := 0 to best_len - 1 do
                    begin
                        repaired_units[pos + unit_idx] := exact_units[unit_idx];
                    end;
                    Inc(total_weight, best_weight);
                    Inc(total_units, best_len);
                    Inc(replacement_count);
                    if best_rank = 0 then
                    begin
                        Inc(total_weight, 300);
                    end;
                    append_path_segment_local(best_text);
                    Inc(pos, best_len);
                end
                else
                begin
                    append_path_segment_local(source_units[pos]);
                    Inc(pos);
                end;
            end;

            if replacement_count <= 0 then
            begin
                Exit;
            end;

            repaired_text := '';
            for unit_idx := 0 to High(repaired_units) do
            begin
                repaired_text := repaired_text + repaired_units[unit_idx];
            end;
            if (repaired_text = '') or SameText(repaired_text,
                Trim(state_value.text)) then
            begin
                Exit;
            end;

            repair_score := state_value.score + c_repair_base_bonus +
                Min(c_repair_max_bonus, (total_weight * 3) +
                (total_units * c_repair_unit_bonus));

            duplicate_found := False;
            for duplicate_idx := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[duplicate_idx].text),
                    repaired_text) and
                    (Trim(out_candidates[duplicate_idx].comment) = '') then
                begin
                    duplicate_found := True;
                    Break;
                end;
            end;
            if duplicate_found then
            begin
                if repair_score > out_candidates[duplicate_idx].score then
                begin
                    out_candidates[duplicate_idx].score := repair_score;
                    out_candidates[duplicate_idx].dict_weight := repair_score;
                    out_candidates[duplicate_idx].has_dict_weight := True;
                    remember_segment_path_for_candidate(repaired_text, '',
                        repaired_path, repair_score);
                end;
                Exit;
            end;

            append_light_candidate(repaired_text, '', repaired_path,
                repair_score, state_value.lexical_rank_score + c_repair_base_bonus +
                Min(c_repair_max_bonus, (total_weight * 3) +
                (total_units * c_repair_unit_bonus)), state_value.fuzzy_cost,
                state_value.fuzzy_rules);
        end;

        procedure append_function_phrase_split_repairs;
        const
            c_repair_probe_limit = 4;
            c_min_follow_phrase_weight = 700;
            c_repair_base_bonus = 6200;
        var
            source_idx: Integer;
            start_idx: Integer;
            follow_len: Integer;
            units: TArray<string>;
            repaired_units: TArray<string>;
            unit_idx: Integer;
            repair_text: string;
            repair_path: string;
            single_text: string;
            single_weight: Integer;
            phrase_text: string;
            phrase_weight: Integer;
            phrase_units: Integer;
            phrase_anchor_units: Integer;
            duplicate_idx: Integer;
            duplicate_found: Boolean;
            score_bonus: Integer;
            current_two_key: string;
            current_two_text: string;
            current_two_results: TncCandidateList;
            current_two_best_text: string;
            current_two_weight: Integer;
            current_two_rank: Integer;
        begin
            if Length(out_candidates) <= 0 then
            begin
                Exit;
            end;

            for source_idx := 0 to Min(c_repair_probe_limit - 1,
                High(out_candidates)) do
            begin
                if Trim(out_candidates[source_idx].comment) <> '' then
                begin
                    Continue;
                end;

                units := split_text_units(Trim(out_candidates[source_idx].text));
                if Length(units) <> head_syllable_count then
                begin
                    Continue;
                end;

                for start_idx := 0 to head_syllable_count - 3 do
                begin
                    if not try_get_best_function_or_modifier_sentence_single_char(
                        normalize_pinyin_text(syllables[start_idx].text),
                        single_text, single_weight) then
                    begin
                        Continue;
                    end;

                    for follow_len := 2 to Min(max_segment_len,
                        head_syllable_count - start_idx - 1) do
                    begin
                        if not try_resolve_best_exact_sentence_subspan(
                            start_idx + 1, follow_len, phrase_text,
                            phrase_weight, phrase_anchor_units) then
                        begin
                            Continue;
                        end;
                        phrase_units := get_candidate_text_unit_count(
                            Trim(phrase_text));
                        if (phrase_units <> follow_len) or
                            (phrase_weight < c_min_follow_phrase_weight) then
                        begin
                            Continue;
                        end;

                        if start_idx + 1 < Length(units) then
                        begin
                            current_two_key := build_syllable_query_key(start_idx, 2);
                            current_two_text := Trim(units[start_idx]) +
                                Trim(units[start_idx + 1]);
                            if (current_two_key <> '') and (current_two_text <> '') and
                                dictionary_exact_lookup_cached(current_two_key,
                                current_two_results) and
                                find_best_same_span_exact_segment(
                                current_two_results, start_idx, 2,
                                current_two_key, current_two_best_text,
                                current_two_weight, current_two_rank) and
                                SameText(current_two_best_text,
                                current_two_text) and
                                (current_two_weight >= phrase_weight + 400) then
                            begin
                                Continue;
                            end;
                        end;

                        SetLength(repaired_units, Length(units));
                        for unit_idx := 0 to High(units) do
                        begin
                            repaired_units[unit_idx] := units[unit_idx];
                        end;
                        repaired_units[start_idx] := single_text;
                        for unit_idx := 0 to phrase_units - 1 do
                        begin
                            repaired_units[start_idx + 1 + unit_idx] :=
                                Copy(phrase_text, unit_idx + 1, 1);
                        end;

                        repair_text := '';
                        for unit_idx := 0 to High(repaired_units) do
                        begin
                            repair_text := repair_text + repaired_units[unit_idx];
                        end;
                        if SameText(repair_text,
                            Trim(out_candidates[source_idx].text)) then
                        begin
                            Continue;
                        end;

                        duplicate_found := False;
                        for duplicate_idx := 0 to High(out_candidates) do
                        begin
                            if SameText(Trim(out_candidates[duplicate_idx].text),
                                repair_text) and
                                (Trim(out_candidates[duplicate_idx].comment) = '') then
                            begin
                                duplicate_found := True;
                                Break;
                            end;
                        end;
                        if duplicate_found then
                        begin
                            Continue;
                        end;

                        repair_path := '';
                        for unit_idx := 0 to start_idx - 1 do
                        begin
                            if repair_path <> '' then
                            begin
                                repair_path := repair_path + c_segment_path_separator;
                            end;
                            repair_path := repair_path + repaired_units[unit_idx];
                        end;
                        if repair_path <> '' then
                        begin
                            repair_path := repair_path + c_segment_path_separator;
                        end;
                        repair_path := repair_path + single_text +
                            c_segment_path_separator + phrase_text;
                        for unit_idx := start_idx + 1 + phrase_units to
                            High(repaired_units) do
                        begin
                            repair_path := repair_path + c_segment_path_separator +
                                repaired_units[unit_idx];
                        end;

                        score_bonus := c_repair_base_bonus +
                            Min(phrase_weight, 1800) + (phrase_anchor_units * 360);
                        append_light_candidate(repair_text, '', repair_path,
                            out_candidates[source_idx].score + score_bonus,
                            out_candidates[source_idx].score + score_bonus,
                            out_candidates[source_idx].fuzzy_cost,
                            out_candidates[source_idx].fuzzy_rules);
                    end;
                end;
            end;
        end;

        procedure append_intermediate_state_partials;
        const
            c_intermediate_partial_limit = 12;
            c_intermediate_partial_bonus = 220;
            c_fixed_boundary_partial_bonus = 560;
        var
            pos_local: Integer;
            state_idx_local: Integer;
            remaining_key: string;
            state_text: string;
            state_units: Integer;
            emitted_count: Integer;
            duplicate_found: Boolean;
            existing_idx: Integer;
            state_value: TLightSentenceState;
            last_fixed_text: string;
            last_syllable_key: string;
            score_bonus: Integer;
        begin
            if tail_prefix <> '' then
            begin
                Exit;
            end;

            emitted_count := 0;
            for pos_local := head_syllable_count - 1 downto 2 do
            begin
                remaining_key := build_syllable_query_key(pos_local,
                    head_syllable_count - pos_local);
                if remaining_key = '' then
                begin
                    Continue;
                end;

                for state_idx_local := 0 to Min(7, High(state_map[pos_local])) do
                begin
                    state_value := state_map[pos_local][state_idx_local];
                    state_text := Trim(state_value.text);
                    state_units := get_candidate_text_unit_count(state_text);
                    if state_units < 2 then
                    begin
                        Continue;
                    end;

                    duplicate_found := False;
                    for existing_idx := 0 to High(out_candidates) do
                    begin
                        if SameText(Trim(out_candidates[existing_idx].text), state_text) and
                            SameText(normalize_pinyin_text(out_candidates[existing_idx].comment),
                            remaining_key) then
                        begin
                            duplicate_found := True;
                            Break;
                        end;
                    end;
                    if duplicate_found then
                    begin
                        Continue;
                    end;

                    score_bonus := c_intermediate_partial_bonus +
                        ((head_syllable_count - pos_local) * 36);
                    if state_value.last_segment_syllable_count = 1 then
                    begin
                        last_syllable_key := normalize_pinyin_text(
                            syllables[pos_local - 1].text);
                        last_fixed_text := get_fixed_sentence_single_char(
                            last_syllable_key);
                        if (last_fixed_text <> '') and
                            SameText(Trim(state_value.prev_text), last_fixed_text) then
                        begin
                            Inc(score_bonus, c_fixed_boundary_partial_bonus);
                        end;
                    end;

                    append_light_candidate(state_text, remaining_key,
                        state_value.path, state_value.score + score_bonus,
                        state_value.lexical_rank_score + score_bonus,
                        state_value.fuzzy_cost, state_value.fuzzy_rules);
                    Inc(emitted_count);
                    if emitted_count >= c_intermediate_partial_limit then
                    begin
                        Exit;
                    end;
                end;
            end;
        end;

        function can_predict_one_letter_tail_local(const prefix_value: string): Boolean;
        begin
            Result := (Length(prefix_value) <> 1) or
                SameText(prefix_value, 'w') or SameText(prefix_value, 'h');
        end;

        function try_predict_tail_single_char(const prefix_value: string;
            const prev_prev_text: string; const prev_text: string;
            out out_text: string): Boolean;
        const
            c_tail_completion_keys: array[0..17] of string = (
                'wo', 'he', 'yi', 'yu', 'you', 'yao', 'shi', 'zai', 'bu',
                'le', 'hai', 'hen', 'hui', 'neng', 'qu', 'lai', 'gei', 'de'
            );
        var
            completion_idx: Integer;
            exact_results: TncCandidateList;
            result_idx: Integer;
            completion_key: string;
            candidate_text: string;
            candidate_score: Integer;
            best_score: Integer;
            second_score: Integer;
            is_preferred: Boolean;
        begin
            Result := False;
            out_text := '';
            if prefix_value = '' then
            begin
                Exit;
            end;
            if not can_predict_one_letter_tail_local(prefix_value) then
            begin
                Exit;
            end;

            best_score := Low(Integer);
            second_score := Low(Integer);
            for completion_idx := Low(c_tail_completion_keys) to High(c_tail_completion_keys) do
            begin
                completion_key := c_tail_completion_keys[completion_idx];
                if (Copy(completion_key, 1, Length(prefix_value)) <> prefix_value) then
                begin
                    Continue;
                end;
                if not dictionary_exact_lookup_cached(completion_key, exact_results) then
                begin
                    Continue;
                end;

                for result_idx := 0 to High(exact_results) do
                begin
                    if result_idx >= c_light_sentence_tail_completion_top_n then
                    begin
                        Break;
                    end;
                    candidate_text := Trim(exact_results[result_idx].text);
                    if (get_candidate_text_unit_count(candidate_text) <> 1) or
                        (not match_single_char_candidate_for_syllable(
                        completion_key, candidate_text, is_preferred)) then
                    begin
                        Continue;
                    end;

                    candidate_score := exact_results[result_idx].score;
                    if exact_results[result_idx].has_dict_weight and
                        (exact_results[result_idx].dict_weight > candidate_score) then
                    begin
                        candidate_score := exact_results[result_idx].dict_weight;
                    end;
                    if is_preferred then
                    begin
                        Inc(candidate_score, 60);
                    end;
                    if is_allowed_single_char_for_sentence(candidate_text) then
                    begin
                        Inc(candidate_score, 80);
                    end;
                    if (m_dictionary <> nil) and (prev_text <> '') then
                    begin
                        Inc(candidate_score, get_sentence_context_bonus_scaled(
                            prev_text, candidate_text));
                        if prev_prev_text <> '' then
                        begin
                            Inc(candidate_score, get_sentence_trigram_bonus_scaled(
                                prev_prev_text, prev_text, candidate_text));
                        end;
                    end;

                    if candidate_score > best_score then
                    begin
                        second_score := best_score;
                        best_score := candidate_score;
                        out_text := candidate_text;
                    end
                    else if candidate_score > second_score then
                    begin
                        second_score := candidate_score;
                    end;
                end;
            end;

            Result := (out_text <> '') and
                ((second_score <= Low(Integer) div 4) or ((best_score - second_score) >= 120));
            if not Result then
            begin
                out_text := '';
            end;
        end;

        procedure append_complete_single_syllable_tail_from_partial_states;
        const
            c_completion_limit = 8;
            c_completion_bonus = c_light_sentence_tail_prediction_bonus + 760;
            c_tail_exact_probe_limit = 18;
            function pick_full_syllable_tail_exact(
                const tail_key_value: string; const prev_prev_text_value: string;
                const prev_text_value: string; out out_text: string): Boolean;
            var
                exact_results: TncCandidateList;
                result_idx: Integer;
                candidate_text: string;
                candidate_score: Integer;
                best_score: Integer;
                is_preferred: Boolean;
                function can_complete_tail_key_local(const value: string): Boolean;
                begin
                    Result := SameText(value, 'wo') or SameText(value, 'he') or
                        SameText(value, 'yi') or SameText(value, 'yu') or
                        SameText(value, 'you') or SameText(value, 'yao') or
                        SameText(value, 'shi') or SameText(value, 'zai') or
                        SameText(value, 'bu') or SameText(value, 'le') or
                        SameText(value, 'hai') or SameText(value, 'hen') or
                        SameText(value, 'hui') or SameText(value, 'neng') or
                        SameText(value, 'qu') or SameText(value, 'lai') or
                        SameText(value, 'gei') or SameText(value, 'de') or
                        SameText(value, 'ba') or SameText(value, 'ma') or
                        SameText(value, 'ne') or SameText(value, 'a') or
                        SameText(value, 'ya') or SameText(value, 'la');
                end;

            begin
                Result := False;
                out_text := '';
                if (tail_key_value = '') or (not can_complete_tail_key_local(tail_key_value)) or
                    (not is_full_pinyin_key(tail_key_value)) or
                    (not dictionary_exact_lookup_cached(tail_key_value, exact_results)) then
                begin
                    Exit;
                end;

                best_score := Low(Integer);
                for result_idx := 0 to High(exact_results) do
                begin
                    if result_idx >= c_tail_exact_probe_limit then
                    begin
                        Break;
                    end;
                    candidate_text := Trim(exact_results[result_idx].text);
                    if (get_candidate_text_unit_count(candidate_text) <> 1) or
                        (not match_single_char_candidate_for_syllable(
                        tail_key_value, candidate_text, is_preferred)) then
                    begin
                        Continue;
                    end;

                    candidate_score := exact_results[result_idx].score;
                    if exact_results[result_idx].has_dict_weight and
                        (exact_results[result_idx].dict_weight > candidate_score) then
                    begin
                        candidate_score := exact_results[result_idx].dict_weight;
                    end;
                    if is_preferred then
                    begin
                        Inc(candidate_score, 90);
                    end;
                    if is_allowed_single_char_for_sentence(candidate_text) then
                    begin
                        Inc(candidate_score, 120);
                    end;
                    if (m_dictionary <> nil) and (prev_text_value <> '') then
                    begin
                        Inc(candidate_score, get_sentence_context_bonus_scaled(
                            prev_text_value, candidate_text));
                        if prev_prev_text_value <> '' then
                        begin
                            Inc(candidate_score, get_sentence_trigram_bonus_scaled(
                                prev_prev_text_value, prev_text_value, candidate_text));
                        end;
                    end;

                    if candidate_score > best_score then
                    begin
                        best_score := candidate_score;
                        out_text := candidate_text;
                        Result := True;
                    end;
                end;
            end;
        var
            pos_local: Integer;
            state_idx_local: Integer;
            emitted_count: Integer;
            existing_idx: Integer;
            tail_key: string;
            tail_text: string;
            completed_text: string;
            completed_path: string;
            state_value: TLightSentenceState;
            state_text: string;
            duplicate_found: Boolean;
        begin
            if tail_prefix <> '' then
            begin
                Exit;
            end;
            if head_syllable_count < 2 then
            begin
                Exit;
            end;

            pos_local := head_syllable_count - 1;
            if (pos_local < 1) or (pos_local > High(state_map)) then
            begin
                Exit;
            end;

            tail_key := build_syllable_query_key(pos_local, 1);
            if (tail_key = '') or (not is_full_pinyin_key(tail_key)) or
                (get_effective_compact_pinyin_unit_count(tail_key) <> 1) then
            begin
                Exit;
            end;

            emitted_count := 0;
            for state_idx_local := 0 to Min(7, High(state_map[pos_local])) do
            begin
                state_value := state_map[pos_local][state_idx_local];
                state_text := Trim(state_value.text);
                if get_candidate_text_unit_count(state_text) < 2 then
                begin
                    Continue;
                end;

                tail_text := '';
                if not try_predict_tail_single_char(tail_key, state_value.prev_prev_text,
                    state_value.prev_text, tail_text) and
                    (not pick_full_syllable_tail_exact(tail_key, state_value.prev_prev_text,
                    state_value.prev_text, tail_text)) then
                begin
                    Continue;
                end;

                completed_text := state_text + tail_text;
                duplicate_found := False;
                for existing_idx := 0 to High(out_candidates) do
                begin
                    if (Trim(out_candidates[existing_idx].comment) = '') and
                        SameText(Trim(out_candidates[existing_idx].text), completed_text) then
                    begin
                        duplicate_found := True;
                        Break;
                    end;
                end;
                if duplicate_found then
                begin
                    Continue;
                end;

                completed_path := state_value.path;
                if completed_path <> '' then
                begin
                    completed_path := completed_path + c_segment_path_separator + tail_text;
                end
                else
                begin
                    completed_path := completed_text;
                end;

                append_light_candidate(completed_text, '', completed_path,
                    state_value.score + c_completion_bonus,
                    state_value.lexical_rank_score + c_completion_bonus,
                    state_value.fuzzy_cost, state_value.fuzzy_rules);
                Inc(emitted_count);
                if emitted_count >= c_completion_limit then
                begin
                    Exit;
                end;
            end;
        end;

        var
            pos: Integer;
            state_idx: Integer;
        seg_len: Integer;
        next_pos: Integer;
        seg_key: string;
        exact_results: TncCandidateList;
        fuzzy_results: TncCandidateList;
        lookup_results: TncCandidateList;
        exact_lookup_results: TncCandidateList;
        result_idx: Integer;
        merged_result_idx: Integer;
        accepted_count: Integer;
        base_state: TLightSentenceState;
        candidate_state: TLightSentenceState;
        candidate_text: string;
        candidate_units: Integer;
        exact_effective_weight: Integer;
        weak_phrase_penalty: Integer;
        lookahead_bonus: Integer;
        tail_text: string;
        tail_partial_bonus: Integer;
        rescue_text: string;
            rescue_weight: Integer;
            rescue_rank_bonus: Integer;
            top_exact_effective_weight: Integer;
            exact_same_as_rescue: Boolean;
            lookbehind_bonus: Integer;
            duplicate_found: Boolean;
            following_phrase_weight: Integer;
            best_same_span_text: string;
            best_same_span_weight: Integer;
            best_same_span_rank: Integer;
            static_adjustment: TLightSentenceStaticAdjustment;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        exact_sentence_subspan_cache_prepared := False;
        syllable_key_cache_count := 0;
        context_bonus_cache_count := 0;
        trigram_bonus_cache_count := 0;
        if (m_dictionary = nil) or (not m_config.enable_segment_candidates) then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        syllables := get_effective_compact_pinyin_syllables(normalized_query);
        if Length(syllables) < 2 then
        begin
            Exit;
        end;

        head_syllable_count := Length(syllables);
        tail_prefix := '';
        if not is_full_pinyin_key(normalize_pinyin_text(syllables[High(syllables)].text)) then
        begin
            tail_prefix := normalize_pinyin_text(syllables[High(syllables)].text);
            Dec(head_syllable_count);
        end;

        if head_syllable_count < 2 then
        begin
            Exit;
        end;
        if (tail_prefix = '') and (head_syllable_count < 4) then
        begin
            Exit;
        end;

        if head_syllable_count >= 16 then
        begin
            max_segment_len := 4;
        end
        else if head_syllable_count >= 5 then
        begin
            max_segment_len := 5;
        end
        else
        begin
            max_segment_len := 3;
        end;

        static_multi_adjustment_cache :=
            TDictionary<string, TLightSentenceStaticAdjustment>.Create;
        try
        SetLength(state_map, head_syllable_count + 1);
        SetLength(state_map[0], 1);
        state_map[0][0].score := 0;
        state_map[0][0].lexical_rank_score := 0;
        state_map[0][0].text := '';
        state_map[0][0].path := '';
        state_map[0][0].prev_text := '';
        state_map[0][0].prev_prev_text := '';
        state_map[0][0].last_segment_syllable_count := 0;
        state_map[0][0].fuzzy_cost := 0;
        state_map[0][0].fuzzy_rules := [];

        for pos := 0 to head_syllable_count - 1 do
        begin
            for state_idx := 0 to High(state_map[pos]) do
            begin
                base_state := state_map[pos][state_idx];
                for seg_len := 1 to Min(max_segment_len, head_syllable_count - pos) do
                begin
                    seg_key := build_syllable_query_key(pos, seg_len);
                    SetLength(exact_results, 0);
                    if dictionary_exact_lookup_cached(seg_key, exact_lookup_results) then
                    begin
                        SetLength(exact_results, Length(exact_lookup_results));
                        for result_idx := 0 to High(exact_lookup_results) do
                        begin
                            exact_results[result_idx] :=
                            exact_lookup_results[result_idx];
                        end;
                    end;
                    if (seg_len <= 4) and
                        dictionary_fuzzy_lattice_lookup_cached(seg_key,
                        fuzzy_results) then
                    begin
                        exact_results := merge_candidate_lists(exact_results,
                            fuzzy_results, 0);
                        reserve_fuzzy_lattice_edges_local(exact_results);
                    end;

                    if (Length(exact_results) = 0) and
                        (not (m_dictionary is TncSqliteDictionary)) and
                        dictionary_lookup_cached(seg_key, lookup_results) then
                    begin
                        for result_idx := 0 to High(lookup_results) do
                        begin
                            duplicate_found := False;
                            for merged_result_idx := 0 to High(exact_results) do
                            begin
                                if SameText(Trim(exact_results[merged_result_idx].text),
                                    Trim(lookup_results[result_idx].text)) and
                                    SameText(Trim(exact_results[merged_result_idx].comment),
                                    Trim(lookup_results[result_idx].comment)) then
                                begin
                                    duplicate_found := True;
                                    Break;
                                end;
                            end;
                            if duplicate_found then
                            begin
                                Continue;
                            end;
                            SetLength(exact_results, Length(exact_results) + 1);
                            exact_results[High(exact_results)] :=
                                lookup_results[result_idx];
                        end;
                    end;

                    if Length(exact_results) = 0 then
                    begin
                        Continue;
                    end;

                    accepted_count := 0;
                    top_exact_effective_weight := 0;
                    exact_same_as_rescue := False;
                    next_pos := pos + seg_len;
                    find_best_same_span_exact_segment(exact_results, pos,
                        seg_len, seg_key, best_same_span_text,
                        best_same_span_weight, best_same_span_rank);
                    for result_idx := 0 to High(exact_results) do
                    begin
                        if accepted_count >= get_light_sentence_exact_top_n_local then
                        begin
                            Break;
                        end;
                        if not is_allowed_sentence_segment_candidate(
                            exact_results[result_idx], pos, seg_len) then
                        begin
                            Continue;
                        end;

                        candidate_text := Trim(exact_results[result_idx].text);
                        candidate_units := get_candidate_text_unit_count(candidate_text);
                        exact_effective_weight :=
                            get_light_sentence_segment_effective_weight(
                            exact_results[result_idx], seg_key, candidate_text);
                        if exact_effective_weight > top_exact_effective_weight then
                        begin
                            top_exact_effective_weight := exact_effective_weight;
                        end;
                        candidate_state.score := base_state.score +
                            Max(exact_results[result_idx].score,
                            exact_effective_weight);
                        Inc(candidate_state.score,
                            get_preferred_query_phrase_bonus_local(seg_key,
                            candidate_text));
                        candidate_state.lexical_rank_score := base_state.lexical_rank_score +
                            ((get_light_sentence_exact_top_n_local - result_idx) *
                            c_light_sentence_exact_rank_step);
                        Inc(candidate_state.score,
                            (get_light_sentence_exact_top_n_local - result_idx) *
                            c_light_sentence_exact_rank_step);
                        if base_state.text <> '' then
                        begin
                            Dec(candidate_state.score, c_light_sentence_additional_segment_penalty);
                        end;

                        if candidate_units >= 2 then
                        begin
                            static_adjustment :=
                                get_static_multi_candidate_adjustment_local(
                                pos, seg_len, exact_results[result_idx],
                                candidate_text, exact_effective_weight,
                                result_idx, best_same_span_text,
                                best_same_span_weight, best_same_span_rank);
                            if static_adjustment.reject_candidate then
                            begin
                                Continue;
                            end;
                            Inc(candidate_state.score,
                                static_adjustment.score_delta);
                        end
                        else
                        begin
                            Dec(candidate_state.score, c_light_sentence_single_penalty);
                            Inc(candidate_state.score,
                                get_bridge_exact_single_context_bonus(pos,
                                base_state.prev_text,
                                base_state.last_segment_syllable_count,
                                candidate_text));
                            if get_candidate_text_unit_count(base_state.prev_text) = 1 then
                            begin
                                Dec(candidate_state.score, 240);
                            end;
                            if get_candidate_text_unit_count(base_state.prev_prev_text) = 1 then
                            begin
                                Dec(candidate_state.score, 120);
                            end;
                            weak_phrase_penalty :=
                                get_direct_exact_merged_phrase_penalty_for_recent_transition(
                                base_state, pos, seg_len, candidate_text);
                            if weak_phrase_penalty > 0 then
                            begin
                                Dec(candidate_state.score, weak_phrase_penalty);
                            end
                            else if has_exact_merged_phrase_for_recent_transition(base_state, pos, seg_len) then
                            begin
                                Dec(candidate_state.score, 1680);
                            end;
                            if has_exact_merged_phrase_for_single_bridge(base_state, pos, seg_len) then
                            begin
                                Dec(candidate_state.score, 1120);
                            end;

                            if is_function_or_modifier_single_for_sentence(candidate_text) and
                                try_get_best_following_sentence_phrase_weight(pos + 1, 2,
                                following_phrase_weight) then
                            begin
                                if following_phrase_weight >= 1400 then
                                begin
                                    Inc(candidate_state.score, 4600);
                                end
                                else if following_phrase_weight >= 900 then
                                begin
                                    Inc(candidate_state.score, 3400);
                                end
                                else if following_phrase_weight >= 700 then
                                begin
                                    Inc(candidate_state.score, 2400);
                                end
                                else if following_phrase_weight >= 520 then
                                begin
                                    Inc(candidate_state.score, 1480);
                                end;
                            end;

                            lookbehind_bonus := get_exact_phrase_lookbehind_bonus(
                                pos, seg_len, candidate_text, exact_effective_weight);
                            if lookbehind_bonus > 0 then
                            begin
                                Inc(candidate_state.score, lookbehind_bonus);
                            end;
                        end;

                        if (m_dictionary <> nil) and (base_state.prev_text <> '') then
                        begin
                            Inc(candidate_state.score,
                                get_sentence_context_bonus_scaled(
                                base_state.prev_text, candidate_text));
                            if base_state.prev_prev_text <> '' then
                            begin
                                Inc(candidate_state.score,
                                    get_sentence_trigram_bonus_scaled(
                                    base_state.prev_prev_text,
                                    base_state.prev_text, candidate_text));
                            end;
                        end;

                        Inc(candidate_state.score,
                            get_sentence_final_modal_particle_adjustment(
                            seg_key, candidate_text, next_pos = head_syllable_count));

                        if base_state.text <> '' then
                        begin
                            candidate_state.text := base_state.text + candidate_text;
                            candidate_state.path := base_state.path + c_segment_path_separator + candidate_text;
                        end
                        else
                        begin
                            candidate_state.text := candidate_text;
                            candidate_state.path := candidate_text;
                        end;
                        candidate_state.prev_prev_text := base_state.prev_text;
                        candidate_state.prev_text := candidate_text;
                        candidate_state.last_segment_syllable_count := seg_len;
                        candidate_state.fuzzy_cost := base_state.fuzzy_cost +
                            exact_results[result_idx].fuzzy_cost;
                        candidate_state.fuzzy_rules := base_state.fuzzy_rules +
                            exact_results[result_idx].fuzzy_rules;
                        add_state(state_map[next_pos], candidate_state);
                        Inc(accepted_count);
                    end;

                    if (seg_len = 2) and
                        try_build_two_single_rescue_segment(pos, rescue_text, rescue_weight,
                        rescue_rank_bonus) and
                        (accepted_count <= 0) then
                    begin
                        for result_idx := 0 to Min(get_light_sentence_exact_top_n_local - 1,
                            High(exact_results)) do
                        begin
                            if SameText(Trim(exact_results[result_idx].text), rescue_text) then
                            begin
                                exact_same_as_rescue := True;
                                Break;
                            end;
                        end;

                        if not exact_same_as_rescue then
                        begin
                            candidate_state.score := base_state.score + rescue_weight;
                            candidate_state.lexical_rank_score := base_state.lexical_rank_score +
                                rescue_rank_bonus;
                            Inc(candidate_state.score, rescue_rank_bonus);
                            if base_state.text <> '' then
                            begin
                                Dec(candidate_state.score, c_light_sentence_additional_segment_penalty);
                            end;
                            Inc(candidate_state.score, c_light_sentence_multi_bonus + (seg_len * 24));

                            if (m_dictionary <> nil) and (base_state.prev_text <> '') then
                            begin
                                Inc(candidate_state.score,
                                    get_sentence_context_bonus_scaled(
                                    base_state.prev_text, rescue_text));
                                if base_state.prev_prev_text <> '' then
                                begin
                                    Inc(candidate_state.score,
                                        get_sentence_trigram_bonus_scaled(
                                        base_state.prev_prev_text,
                                        base_state.prev_text, rescue_text));
                                end;
                            end;

                            lookahead_bonus := get_exact_phrase_lookahead_bonus(
                                pos, seg_len, rescue_text);
                            if lookahead_bonus > 0 then
                            begin
                                Inc(candidate_state.score, lookahead_bonus);
                            end;

                            lookbehind_bonus := get_exact_phrase_lookbehind_bonus(
                                pos, seg_len, rescue_text, rescue_weight);
                            if lookbehind_bonus > 0 then
                            begin
                                Inc(candidate_state.score, lookbehind_bonus);
                            end;

                            if next_pos = head_syllable_count then
                            begin
                                Inc(candidate_state.score, 220);
                            end;
                            Inc(candidate_state.score,
                                get_fixed_boundary_alignment_adjustment(
                                pos, seg_len, rescue_text));

                            if base_state.text <> '' then
                            begin
                                candidate_state.text := base_state.text + rescue_text;
                                candidate_state.path := base_state.path + c_segment_path_separator +
                                    rescue_text;
                            end
                            else
                            begin
                                candidate_state.text := rescue_text;
                                candidate_state.path := rescue_text;
                            end;
                            candidate_state.prev_prev_text := base_state.prev_text;
                            candidate_state.prev_text := rescue_text;
                            candidate_state.last_segment_syllable_count := seg_len;
                            candidate_state.fuzzy_cost := base_state.fuzzy_cost;
                            candidate_state.fuzzy_rules := base_state.fuzzy_rules;
                            add_state(state_map[next_pos], candidate_state);
                        end;
                    end;
                end;
            end;
        end;

        final_states := state_map[head_syllable_count];
        if Length(final_states) <= 0 then
        begin
            Exit;
        end;

        if m_debug_target_recall_text <> '' then
        begin
            m_debug_target_final_state_count := Max(
                m_debug_target_final_state_count, Length(final_states));
            for state_idx := 0 to High(final_states) do
            begin
                if SameText(Trim(final_states[state_idx].text),
                    m_debug_target_recall_text) then
                begin
                    m_debug_target_final_state_source_mask :=
                        m_debug_target_final_state_source_mask or 2;
                    if (m_debug_target_light_final_state_rank = 0) or
                        (state_idx + 1 < m_debug_target_light_final_state_rank) then
                    begin
                        m_debug_target_light_final_state_rank := state_idx + 1;
                    end;
                    if (not m_debug_target_final_state_found) or
                        (state_idx + 1 < m_debug_target_final_state_rank) then
                    begin
                        m_debug_target_final_state_found := True;
                        m_debug_target_final_state_rank := state_idx + 1;
                    end;
                end;
            end;
        end;

        for state_idx := 0 to Min(get_light_sentence_emit_limit_local - 1, High(final_states)) do
        begin
            append_light_candidate(final_states[state_idx].text, '',
                final_states[state_idx].path, final_states[state_idx].score + 320,
                final_states[state_idx].lexical_rank_score,
                final_states[state_idx].fuzzy_cost,
                final_states[state_idx].fuzzy_rules);
            append_best_same_span_exact_segment_repair(final_states[state_idx]);
            append_direct_exact_span_repair_candidate(final_states[state_idx]);
        end;

        append_function_phrase_split_repairs;
        append_intermediate_state_partials;
        append_complete_single_syllable_tail_from_partial_states;

        if tail_prefix <> '' then
        begin
            tail_partial_bonus := c_light_sentence_tail_partial_bonus;
            if not can_predict_one_letter_tail_local(tail_prefix) then
            begin
                Inc(tail_partial_bonus, c_light_sentence_tail_prediction_bonus);
            end;
            append_light_candidate(final_states[0].text, tail_prefix,
                final_states[0].path, final_states[0].score + tail_partial_bonus,
                final_states[0].lexical_rank_score,
                final_states[0].fuzzy_cost, final_states[0].fuzzy_rules);

            tail_text := '';
            if try_predict_tail_single_char(tail_prefix, final_states[0].prev_prev_text,
                final_states[0].prev_text, tail_text) then
            begin
                append_light_candidate(final_states[0].text + tail_text, '',
                    final_states[0].path + c_segment_path_separator + tail_text,
                    final_states[0].score + c_light_sentence_tail_prediction_bonus,
                    final_states[0].lexical_rank_score + c_light_sentence_tail_prediction_bonus,
                    final_states[0].fuzzy_cost, final_states[0].fuzzy_rules);
            end;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
        finally
            static_multi_adjustment_cache.Free;
        end;
    end;

    function build_exact_lattice_sentence_backup_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_lattice_beam_width = 6;
        c_lattice_emit_limit = 2;
        c_lattice_max_segment_syllables = 5;
        c_lattice_exact_probe_limit = 4;
        c_lattice_segment_penalty = 260;
        c_lattice_single_penalty = 1250;
        c_lattice_multi_bonus = 460;
        c_lattice_long_phrase_bonus = 720;
        c_lattice_context_scale = 4;
        c_lattice_trigram_scale = 6;
        c_lattice_work_limit = 5000;
    type
        TExactLatticeState = record
            score: Integer;
            text: string;
            path: string;
            prev_text: string;
            prev_prev_text: string;
            segments: Integer;
            single_segments: Integer;
        end;
        TExactLatticeStateArray = TArray<TExactLatticeState>;
    var
        normalized_query_local: string;
        syllables_local: TncPinyinParseResult;
        state_map_local: array of TExactLatticeStateArray;
        final_states_local: TExactLatticeStateArray;
        syllable_count_local: Integer;
        start_tick_local: UInt64;
        lattice_work_count_local: Int64;

        function budget_exceeded_local: Boolean;
        var
            timed_budget_ms_local: UInt64;
            emergency_budget_ms_local: UInt64;
        begin
            if m_composition_built_incrementally then
            begin
                timed_budget_ms_local := 45;
                emergency_budget_ms_local := 180;
            end
            else
            begin
                timed_budget_ms_local := 0;
                emergency_budget_ms_local := 0;
            end;
            Result := search_budget_should_stop(start_tick_local,
                lattice_work_count_local, c_lattice_work_limit,
                timed_budget_ms_local, emergency_budget_ms_local);
        end;

        function build_key_local(const start_idx: Integer;
            const unit_count: Integer): string;
        var
            unit_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (unit_count <= 0) or
                (start_idx + unit_count > syllable_count_local) then
            begin
                Exit;
            end;

            for unit_idx := start_idx to start_idx + unit_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[unit_idx].text);
            end;
        end;

        function get_candidate_weight_local(const candidate: TncCandidate): Integer;
        begin
            Result := candidate.score;
            if candidate.has_dict_weight and (candidate.dict_weight > Result) then
            begin
                Result := candidate.dict_weight;
            end;
        end;

        function normalize_segment_weight_local(const weight_value: Integer;
            const unit_count: Integer): Integer;
        begin
            Result := weight_value;
            if unit_count = 1 then
            begin
                if Result > 900 then
                begin
                    Result := 900 + ((Result - 900) div 8);
                end;
            end
            else if unit_count = 2 then
            begin
                if Result > 900 then
                begin
                    Result := 900 + ((Result - 900) div 5);
                end;
            end
            else if Result > 1800 then
            begin
                Result := 1800 + ((Result - 1800) div 3);
            end;
        end;

        function get_context_score_local(const left_text: string;
            const right_text: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (left_text = '') or (right_text = '') then
            begin
                Exit;
            end;
            Result := m_dictionary.get_context_bonus(left_text, right_text) *
                c_lattice_context_scale;
        end;

        function get_trigram_score_local(const prev_prev_text: string;
            const prev_text: string; const right_text: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (prev_prev_text = '') or
                (prev_text = '') or (right_text = '') then
            begin
                Exit;
            end;
            Result := m_dictionary.get_context_trigram_bonus(prev_prev_text,
                prev_text, right_text) * c_lattice_trigram_scale;
        end;

        procedure add_state_local(var states: TExactLatticeStateArray;
            const state_value: TExactLatticeState);
        var
            idx: Integer;
            insert_idx: Integer;
            temp_state: TExactLatticeState;
        begin
            if is_debug_target_recall_prefix(state_value.text) then
            begin
                m_debug_target_max_generated_syllable := Max(
                    m_debug_target_max_generated_syllable,
                    get_candidate_text_unit_count(state_value.text));
            end;

            for idx := 0 to High(states) do
            begin
                if SameText(states[idx].text, state_value.text) then
                begin
                    if state_value.score > states[idx].score then
                    begin
                        states[idx] := state_value;
                    end;
                    Exit;
                end;
            end;

            insert_idx := Length(states);
            SetLength(states, insert_idx + 1);
            states[insert_idx] := state_value;
            while (insert_idx > 0) and
                (states[insert_idx].score > states[insert_idx - 1].score) do
            begin
                temp_state := states[insert_idx - 1];
                states[insert_idx - 1] := states[insert_idx];
                states[insert_idx] := temp_state;
                Dec(insert_idx);
            end;

            if Length(states) > c_lattice_beam_width then
            begin
                SetLength(states, c_lattice_beam_width);
            end;

            for idx := 0 to High(states) do
            begin
                if is_debug_target_recall_prefix(states[idx].text) then
                begin
                    m_debug_target_max_retained_syllable := Max(
                        m_debug_target_max_retained_syllable,
                        get_candidate_text_unit_count(states[idx].text));
                end;
            end;
        end;

        procedure append_output_candidate_local(
            const state_value: TExactLatticeState);
        var
            next_idx: Integer;
        begin
            if Trim(state_value.text) = '' then
            begin
                Exit;
            end;
            for next_idx := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[next_idx].text),
                    Trim(state_value.text)) then
                begin
                    Exit;
                end;
            end;

            next_idx := Length(out_candidates);
            SetLength(out_candidates, next_idx + 1);
            out_candidates[next_idx].text := Trim(state_value.text);
            out_candidates[next_idx].comment := '';
            out_candidates[next_idx].score := state_value.score;
            out_candidates[next_idx].source := cs_rule;
            out_candidates[next_idx].has_dict_weight := False;
            out_candidates[next_idx].dict_weight := 0;
            remember_segment_path_for_candidate(out_candidates[next_idx].text,
                '', state_value.path, state_value.score);
        end;

        procedure extend_with_candidate_local(const base_state: TExactLatticeState;
            const pos_idx: Integer; const seg_len: Integer;
            const candidate: TncCandidate; const candidate_rank: Integer);
        var
            candidate_text: string;
            candidate_score: Integer;
            next_state: TExactLatticeState;
        begin
            candidate_text := Trim(candidate.text);
            if (candidate_text = '') or (Trim(candidate.comment) <> '') or
                (get_candidate_text_unit_count(candidate_text) <> seg_len) then
            begin
                Exit;
            end;
            Inc(lattice_work_count_local);

            candidate_score := normalize_segment_weight_local(
                get_candidate_weight_local(candidate), seg_len);
            Dec(candidate_score, candidate_rank * 180);
            Dec(candidate_score, c_lattice_segment_penalty);
            if seg_len = 1 then
            begin
                Dec(candidate_score, c_lattice_single_penalty);
            end
            else
            begin
                Inc(candidate_score, c_lattice_multi_bonus * seg_len);
                if seg_len >= 3 then
                begin
                    Inc(candidate_score, c_lattice_long_phrase_bonus);
                end;
            end;
            if candidate.source = cs_user then
            begin
                Inc(candidate_score, 2200);
            end;
            if pos_idx + seg_len = syllable_count_local then
            begin
                Inc(candidate_score, 420);
            end;
            Inc(candidate_score, get_context_score_local(base_state.prev_text,
                candidate_text));
            Inc(candidate_score, get_trigram_score_local(
                base_state.prev_prev_text, base_state.prev_text, candidate_text));

            next_state.score := base_state.score + candidate_score;
            if base_state.text <> '' then
            begin
                next_state.text := base_state.text + candidate_text;
                next_state.path := base_state.path + c_segment_path_separator +
                    candidate_text;
            end
            else
            begin
                next_state.text := candidate_text;
                next_state.path := candidate_text;
            end;
            next_state.prev_prev_text := base_state.prev_text;
            next_state.prev_text := candidate_text;
            next_state.segments := base_state.segments + 1;
            next_state.single_segments := base_state.single_segments;
            if seg_len = 1 then
            begin
                Inc(next_state.single_segments);
            end;
            if next_state.single_segments > (syllable_count_local div 2) + 1 then
            begin
                Dec(next_state.score,
                    (next_state.single_segments - ((syllable_count_local div 2) + 1)) *
                    900);
            end;
            add_state_local(state_map_local[pos_idx + seg_len], next_state);
        end;

        procedure sort_final_states_local(var states: TExactLatticeStateArray);
        var
            pass_idx: Integer;
            idx: Integer;
            temp_state: TExactLatticeState;
        begin
            for pass_idx := 0 to High(states) do
            begin
                for idx := 0 to High(states) - 1 do
                begin
                    if states[idx].score < states[idx + 1].score then
                    begin
                        temp_state := states[idx];
                        states[idx] := states[idx + 1];
                        states[idx + 1] := temp_state;
                    end;
                end;
            end;
        end;
    var
        pos_idx: Integer;
        state_idx: Integer;
        seg_len: Integer;
        query_key_local: string;
        exact_results_local: TncCandidateList;
        exact_idx: Integer;
        emit_idx: Integer;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if (m_dictionary = nil) or (Trim(query_text) = '') or
            (not is_full_pinyin_key(query_text)) then
        begin
            Exit;
        end;

        normalized_query_local := normalize_pinyin_text(query_text);
        syllables_local := get_effective_compact_pinyin_syllables(
            normalized_query_local);
        syllable_count_local := Length(syllables_local);
        if (syllable_count_local < 7) or (syllable_count_local > 40) then
        begin
            Exit;
        end;

        start_tick_local := GetTickCount64;
        lattice_work_count_local := 0;
        SetLength(state_map_local, syllable_count_local + 1);
        SetLength(state_map_local[0], 1);
        state_map_local[0][0].score := 0;
        state_map_local[0][0].text := '';
        state_map_local[0][0].path := '';
        state_map_local[0][0].prev_text := '';
        state_map_local[0][0].prev_prev_text := '';
        state_map_local[0][0].segments := 0;
        state_map_local[0][0].single_segments := 0;

        for pos_idx := 0 to syllable_count_local - 1 do
        begin
            if budget_exceeded_local then
            begin
                Break;
            end;
            if Length(state_map_local[pos_idx]) = 0 then
            begin
                Continue;
            end;

            for state_idx := 0 to High(state_map_local[pos_idx]) do
            begin
                for seg_len := Min(c_lattice_max_segment_syllables,
                    syllable_count_local - pos_idx) downto 1 do
                begin
                    query_key_local := build_key_local(pos_idx, seg_len);
                    if (query_key_local = '') or
                        (not lookup_exact_full_pinyin_cached_local(
                        query_key_local, exact_results_local)) then
                    begin
                        Continue;
                    end;
                    for exact_idx := 0 to High(exact_results_local) do
                    begin
                        if budget_exceeded_local then
                        begin
                            Break;
                        end;
                        if exact_idx >= c_lattice_exact_probe_limit then
                        begin
                            Break;
                        end;
                        extend_with_candidate_local(
                            state_map_local[pos_idx][state_idx], pos_idx,
                            seg_len, exact_results_local[exact_idx], exact_idx);
                    end;
                end;
            end;
        end;

        final_states_local := state_map_local[syllable_count_local];
        if Length(final_states_local) = 0 then
        begin
            Exit;
        end;

        sort_final_states_local(final_states_local);
        if m_debug_target_recall_text <> '' then
        begin
            m_debug_target_final_state_count := Max(
                m_debug_target_final_state_count, Length(final_states_local));
            for emit_idx := 0 to High(final_states_local) do
            begin
                if SameText(Trim(final_states_local[emit_idx].text),
                    m_debug_target_recall_text) then
                begin
                    m_debug_target_final_state_source_mask :=
                        m_debug_target_final_state_source_mask or 4;
                    if (m_debug_target_lattice_final_state_rank = 0) or
                        (emit_idx + 1 < m_debug_target_lattice_final_state_rank) then
                    begin
                        m_debug_target_lattice_final_state_rank := emit_idx + 1;
                    end;
                    if (not m_debug_target_final_state_found) or
                        (emit_idx + 1 < m_debug_target_final_state_rank) then
                    begin
                        m_debug_target_final_state_found := True;
                        m_debug_target_final_state_rank := emit_idx + 1;
                    end;
                end;
            end;
        end;
        for emit_idx := 0 to Min(c_lattice_emit_limit - 1,
            High(final_states_local)) do
        begin
            append_output_candidate_local(final_states_local[emit_idx]);
        end;

        Result := Length(out_candidates) > 0;
    end;

    procedure ensure_exact_lattice_backup_second_visible(
        var candidates: TncCandidateList);
    var
        backup_idx: Integer;
        existing_idx: Integer;
        move_idx: Integer;
        backup_candidate_local: TncCandidate;
        second_text_local: string;
        top_text_local: string;
    begin
        if (Length(candidates) = 0) or
            (Length(exact_lattice_backup_candidates) = 0) or
            (input_syllable_count < 7) or (not is_full_pinyin_key(lookup_text)) or
            all_initial_compact_query or has_internal_dangling_initial then
        begin
            Exit;
        end;

        if Length(candidates) > 1 then
        begin
            second_text_local := Trim(candidates[1].text);
            if (Trim(candidates[1].comment) = '') and
                (second_text_local <> '') and
                (get_candidate_text_unit_count(second_text_local) =
                input_syllable_count) then
            begin
                Exit;
            end;
        end;

        top_text_local := Trim(candidates[0].text);
        for backup_idx := 0 to High(exact_lattice_backup_candidates) do
        begin
            backup_candidate_local := exact_lattice_backup_candidates[backup_idx];
            if Trim(backup_candidate_local.comment) <> '' then
            begin
                Continue;
            end;
            if SameText(Trim(backup_candidate_local.text), top_text_local) then
            begin
                Continue;
            end;
            if get_candidate_text_unit_count(Trim(backup_candidate_local.text)) <>
                input_syllable_count then
            begin
                Continue;
            end;

            existing_idx := -1;
            for move_idx := 0 to High(candidates) do
            begin
                if SameText(Trim(candidates[move_idx].text),
                    Trim(backup_candidate_local.text)) and
                    (Trim(candidates[move_idx].comment) = '') then
                begin
                    existing_idx := move_idx;
                    Break;
                end;
            end;

            if existing_idx = 1 then
            begin
                Exit;
            end;
            if existing_idx > 1 then
            begin
                backup_candidate_local := candidates[existing_idx];
                for move_idx := existing_idx downto 2 do
                begin
                    candidates[move_idx] := candidates[move_idx - 1];
                end;
                candidates[1] := backup_candidate_local;
            end
            else
            begin
                SetLength(candidates, Length(candidates) + 1);
                for move_idx := High(candidates) downto 2 do
                begin
                    candidates[move_idx] := candidates[move_idx - 1];
                end;
                candidates[1] := backup_candidate_local;
            end;

            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' elat2=[%s]', [Trim(backup_candidate_local.text)]);
            end;
            Exit;
        end;
    end;

    function build_strict_chunk_oracle_sentence_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_enable_nested_oracle: Boolean = False;
        c_oracle_beam_width = 10;
        c_oracle_emit_limit = 4;
        c_oracle_probe_limit = 6;
        c_oracle_max_segment_syllables = 5;
        c_oracle_single_penalty = 420;
        c_oracle_additional_segment_penalty = 140;
        c_oracle_multi_bonus = 360;
        c_oracle_rank_step = 260;
        c_oracle_final_complete_bonus = 480;
        c_oracle_anchor_bonus = 220;
        c_oracle_standalone_match_bonus = 3200;
        c_oracle_standalone_mismatch_penalty = 2400;
        c_oracle_budget_ms = 180;
        // Bound direct/offline work while allowing a wider search than input.
        c_oracle_direct_budget_ms = 720;
        c_oracle_work_limit = 16384;
    type
        TOracleState = record
            score: Integer;
            text: string;
            path: string;
            prev_text: string;
            prev_prev_text: string;
        end;
        TOracleStateArray = TArray<TOracleState>;
        TOracleSegmentOption = record
            text: string;
            path_text: string;
            score: Integer;
            rank: Integer;
        end;
        TOracleSegmentOptionArray = TArray<TOracleSegmentOption>;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        state_map: array of TOracleStateArray;
        final_states: TOracleStateArray;
        head_syllable_count_local: Integer;
        nested_option_states: TDictionary<string, Integer>;
        nested_option_cache: TDictionary<string, TOracleSegmentOptionArray>;
        nested_engine: TncEngine;
        nested_engine_config: TncEngineConfig;
        single_option_cache: TArray<TOracleSegmentOptionArray>;
        single_option_cache_prepared: TArray<Boolean>;
        merged_result_cache: TDictionary<string, TncCandidateList>;
        oracle_start_tick: UInt64;
        oracle_work_count: Int64;
        oracle_timed_out: Boolean;

        function oracle_budget_exhausted_local: Boolean;
        var
            budget_ms_local: UInt64;
        begin
            if m_composition_built_incrementally then
            begin
                budget_ms_local := c_oracle_budget_ms;
            end
            else
            begin
                budget_ms_local := c_oracle_direct_budget_ms;
            end;
            Inc(oracle_work_count);
            Result := search_budget_should_stop(oracle_start_tick,
                oracle_work_count, c_oracle_work_limit, budget_ms_local,
                budget_ms_local * 2,
                head_syllable_count_local >=
                c_long_sentence_full_path_min_syllables);
            if Result and (not oracle_timed_out) then
            begin
                oracle_timed_out := True;
                if m_debug_target_recall_text <> '' then
                begin
                    m_debug_target_full_path_budget_exhausted := True;
                end;
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' oracle_budget=[mode=%d work=%d elapsed=%d]',
                        [Ord(m_search_budget_mode), oracle_work_count,
                        GetTickCount64 - oracle_start_tick]);
                end;
            end;
        end;

        function build_syllable_query_key_local(const start_idx: Integer;
            const syllable_count_local: Integer): string;
        var
            idx: Integer;
        begin
            Result := '';
            for idx := start_idx to start_idx + syllable_count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(syllables_local[idx].text);
            end;
        end;

        function get_oracle_context_bonus_local(const left_text: string;
            const right_text: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (left_text = '') or (right_text = '') then
            begin
                Exit;
            end;

            Result := m_dictionary.get_context_bonus(left_text, right_text) * 4;
        end;

        function get_oracle_trigram_bonus_local(const left_left_text: string;
            const left_text: string; const right_text: string): Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (left_left_text = '') or (left_text = '') or
                (right_text = '') then
            begin
                Exit;
            end;

            Result := m_dictionary.get_context_trigram_bonus(left_left_text,
                left_text, right_text) * 6;
        end;

        function get_fixed_oracle_single_char(
            const syllable_text: string): string;
        var
            normalized_syllable: string;
        begin
            Result := '';
            normalized_syllable := normalize_pinyin_text(syllable_text);
            if (normalized_syllable = 'ta') or
                (normalized_syllable = 'qing') or
                (normalized_syllable = 'bei') then
            begin
                Exit;
            end;
            if normalized_syllable = 'dan' then
            begin
                Result := string(Char($4F46));
            end
            else if normalized_syllable = 'sui' then
            begin
                Result := string(Char($867D));
            end
            else if normalized_syllable = 'er' then
            begin
                Result := string(Char($800C));
            end
            else if normalized_syllable = 'wo' then
            begin
                Result := string(Char($6211));
            end
            else if normalized_syllable = 'ni' then
            begin
                Result := string(Char($4F60));
            end
            else if normalized_syllable = 'he' then
            begin
                Result := string(Char($548C));
            end
            else if normalized_syllable = 'qu' then
            begin
                Result := string(Char($53BB));
            end
            else if normalized_syllable = 'shi' then
            begin
                Result := string(Char($662F));
            end
            else if normalized_syllable = 'ye' then
            begin
                Result := string(Char($4E5F));
            end
            else if normalized_syllable = 'yu' then
            begin
                Result := string(Char($4E8E));
            end
            else if normalized_syllable = 'de' then
            begin
                Result := string(Char($7684));
            end
            else if normalized_syllable = 'zai' then
            begin
                Result := string(Char($5728));
            end
            else if normalized_syllable = 'ba' then
            begin
                Result := string(Char($628A));
            end
            else if normalized_syllable = 'bei' then
            begin
                Result := string(Char($88AB));
            end
            else if normalized_syllable = 'bing' then
            begin
                Result := string(Char($5E76));
            end
            else if normalized_syllable = 'que' then
            begin
                Result := string(Char($5374));
            end;
        end;

        function segment_has_fixed_oracle_boundary_local(
            const start_idx: Integer; const syllable_count_local: Integer): Boolean;
        var
            unit_idx_local: Integer;
        begin
            Result := False;
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local > head_syllable_count_local) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to syllable_count_local - 1 do
            begin
                if get_fixed_oracle_single_char(
                    normalize_pinyin_text(
                    syllables_local[start_idx + unit_idx_local].text)) <> '' then
                begin
                    Exit(True);
                end;
            end;
        end;

        function oracle_candidate_respects_fixed_boundaries_local(
            const start_idx: Integer; const syllable_count_local: Integer;
            const text_value: string): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            expected_char_local: string;
        begin
            Result := False;
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local > head_syllable_count_local) then
            begin
                Exit;
            end;

            text_units_local := split_text_units(Trim(text_value));
            if Length(text_units_local) <> syllable_count_local then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to syllable_count_local - 1 do
            begin
                expected_char_local := get_fixed_oracle_single_char(
                    normalize_pinyin_text(
                    syllables_local[start_idx + unit_idx_local].text));
                if (expected_char_local <> '') and
                    (not SameText(text_units_local[unit_idx_local],
                    expected_char_local)) then
                begin
                    Exit(False);
                end;
            end;

            Result := True;
        end;

        function is_allowed_oracle_single_char(const value: string): Boolean;
        begin
            Result := False;
            if Length(value) <> 1 then
            begin
                Exit;
            end;

            case Ord(value[1]) of
                $6211, $4F60, $4ED6, $5979, $5B83, $4EEC, $548C, $53BB, $6765,
                $5728, $662F, $6709, $8981, $60F3, $4F1A, $80FD, $53EA, $628A, $88AB,
                $8BA9, $7ED9, $5411, $5BF9, $8DDF, $540C, $4ECE, $4E0E, $4E8E, $5C31,
                $4E5F, $90FD, $8FD8, $53C8, $518D, $4E0D, $5F88, $592A, $6700, $5DF2,
                $5C06, $5230, $7684, $4E86, $7740, $8FC7, $4F46, $867D, $800C, $5E76,
                $5374:
                    Result := True;
            end;
        end;

        function is_preferred_oracle_single_char_candidate_local(
            const syllable_key_local: string; const value: string;
            const effective_weight_local: Integer): Boolean;
        const
            c_oracle_single_probe_limit = 8;
            c_oracle_preferred_max_rank = 3;
            c_oracle_top_ratio_pct = 85;
        var
            exact_single_results_local: TncCandidateList;
            idx_local: Integer;
            candidate_text_local: string;
            weight_value_local: Integer;
            top_weight_value_local: Integer;
            single_char_rank_local: Integer;
            fixed_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (syllable_key_local = '') or
                (Length(Trim(value)) <> 1) then
            begin
                Exit;
            end;

            fixed_text_local := get_fixed_oracle_single_char(syllable_key_local);
            if fixed_text_local <> '' then
            begin
                Exit(SameText(fixed_text_local, value));
            end;

            if not m_dictionary.single_char_matches_pinyin(syllable_key_local,
                value) then
            begin
                Exit(False);
            end;

            if not dictionary_exact_lookup_cached(syllable_key_local,
                exact_single_results_local) then
            begin
                Exit(True);
            end;

            top_weight_value_local := 0;
            single_char_rank_local := 0;
            for idx_local := 0 to High(exact_single_results_local) do
            begin
                if idx_local >= c_oracle_single_probe_limit then
                begin
                    Break;
                end;

                candidate_text_local := Trim(exact_single_results_local[idx_local].text);
                if (candidate_text_local = '') or
                    (Trim(exact_single_results_local[idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <> 1) then
                begin
                    Continue;
                end;

                Inc(single_char_rank_local);
                if exact_single_results_local[idx_local].has_dict_weight then
                begin
                    weight_value_local :=
                        exact_single_results_local[idx_local].dict_weight;
                end
                else
                begin
                    weight_value_local := exact_single_results_local[idx_local].score;
                end;

                if top_weight_value_local <= 0 then
                begin
                    top_weight_value_local := weight_value_local;
                end;

                if not SameText(candidate_text_local, value) then
                begin
                    Continue;
                end;

                Exit((single_char_rank_local <= c_oracle_preferred_max_rank) or
                    (top_weight_value_local <= 0) or
                    ((effective_weight_local * 100) >=
                    (top_weight_value_local * c_oracle_top_ratio_pct)));
            end;
        end;

        function is_extended_allowed_oracle_single_char_local(
            const syllable_key_local: string; const value: string;
            const effective_weight_local: Integer): Boolean;
        const
            c_oracle_extended_single_min_weight = 300;
        var
            fixed_text_local: string;
        begin
            fixed_text_local := get_fixed_oracle_single_char(syllable_key_local);
            if fixed_text_local <> '' then
            begin
                Exit(SameText(fixed_text_local, value));
            end;

            Result := is_allowed_oracle_single_char(value);
            if Result then
            begin
                Exit;
            end;

            if head_syllable_count_local < 8 then
            begin
                Exit(False);
            end;
            if (Length(Trim(value)) <> 1) or
                (effective_weight_local < c_oracle_extended_single_min_weight) then
            begin
                Exit(False);
            end;

            Result := is_preferred_oracle_single_char_candidate_local(
                syllable_key_local, value, effective_weight_local);
        end;

        procedure get_oracle_single_options_local(const position_local: Integer;
            const syllable_key_local: string;
            out out_options: TOracleSegmentOptionArray);
        var
            exact_results_local: TncCandidateList;
            result_idx_local: Integer;
            candidate_text_local: string;
            effective_weight_local: Integer;
            option_local: TOracleSegmentOption;
        begin
            SetLength(out_options, 0);
            if (position_local < 0) or
                (position_local > High(single_option_cache_prepared)) then
            begin
                Exit;
            end;
            if single_option_cache_prepared[position_local] then
            begin
                out_options := Copy(single_option_cache[position_local]);
                Exit;
            end;

            single_option_cache_prepared[position_local] := True;
            if not dictionary_exact_lookup_cached(syllable_key_local,
                exact_results_local) then
            begin
                Exit;
            end;

            for result_idx_local := 0 to Min(c_oracle_probe_limit - 1,
                High(exact_results_local)) do
            begin
                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(
                    exact_results_local[result_idx_local].text);
                if get_candidate_text_unit_count(candidate_text_local) <> 1 then
                begin
                    Continue;
                end;

                effective_weight_local := exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight and
                    (exact_results_local[result_idx_local].dict_weight >
                    effective_weight_local) then
                begin
                    effective_weight_local :=
                        exact_results_local[result_idx_local].dict_weight;
                end;
                if not is_extended_allowed_oracle_single_char_local(
                    syllable_key_local, candidate_text_local,
                    effective_weight_local) then
                begin
                    Continue;
                end;

                option_local := Default(TOracleSegmentOption);
                option_local.text := candidate_text_local;
                option_local.path_text := candidate_text_local;
                option_local.score := effective_weight_local;
                option_local.rank := result_idx_local;
                SetLength(out_options, Length(out_options) + 1);
                out_options[High(out_options)] := option_local;
            end;
            single_option_cache[position_local] := Copy(out_options);
        end;

        function normalize_oracle_segment_weight_local(const raw_weight: Integer;
            const syllable_count_local: Integer): Integer;
        begin
            Result := raw_weight;
            if syllable_count_local = 2 then
            begin
                if Result > 240 then
                begin
                    Result := 240 + ((Result - 240) div 10);
                end;
            end;
        end;

        function try_get_best_oracle_standalone_query_candidate_local(
            const query_key_local: string; const expected_syllables_local: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        const
            c_probe_limit_local = 8;
        var
            cached_state_local: Integer;
            snapshot_candidates_local: TncCandidateList;
            snapshot_scores_local: TArray<Integer>;
            candidate_idx_local: Integer;
            candidate_local: TncCandidate;
            candidate_text_local: string;
            candidate_units_local: Integer;
            candidate_score_local: Integer;
            best_text_local: string;
            best_score_local: Integer;
            preferred_exact_bonus_local: Integer;
            preferred_text_local: string;
            preferred_bonus_local: Integer;
            support_score_local: Integer;
            support_segments_local: Integer;
            support_path_local: string;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            preferred_text_local := '';
            preferred_bonus_local := 0;
            if (query_key_local = '') or
                (not is_full_pinyin_key(query_key_local)) or
                (expected_syllables_local < 2) or
                (expected_syllables_local > 8) or
                (m_disable_subspan_standalone_oracle > 0) then
            begin
                Exit;
            end;

            try_get_preferred_query_phrase_text_local(query_key_local,
                preferred_text_local, preferred_bonus_local);

            if subspan_oracle_states = nil then
            begin
                subspan_oracle_states := TDictionary<string, Integer>.Create;
                subspan_oracle_texts := TDictionary<string, string>.Create;
                subspan_oracle_scores := TDictionary<string, Integer>.Create;
            end;

            if subspan_oracle_states.TryGetValue(query_key_local,
                cached_state_local) then
            begin
                if cached_state_local = 1 then
                begin
                    subspan_oracle_texts.TryGetValue(query_key_local, out_text);
                    subspan_oracle_scores.TryGetValue(query_key_local, out_score);
                    Exit(out_text <> '');
                end;
                Exit(False);
            end;

            if subspan_oracle_budget_remaining <= 0 then
            begin
                Exit;
            end;

            if subspan_oracle_engine = nil then
            begin
                subspan_oracle_config := m_config;
                subspan_oracle_config.debug_mode := False;
                subspan_oracle_config.max_candidates := 6;
                subspan_oracle_engine := TncEngine.Create(
                    subspan_oracle_config, False, False);
                inherit_search_budget_policy_to(subspan_oracle_engine);
            end;

            Dec(subspan_oracle_budget_remaining);
            subspan_oracle_states.AddOrSetValue(query_key_local, 3);
            subspan_oracle_engine.m_disable_subspan_standalone_oracle :=
                m_disable_subspan_standalone_oracle + 1;
            subspan_oracle_engine.reset;
            subspan_oracle_engine.m_composition_text := query_key_local;
            subspan_oracle_engine.build_candidates;

            SetLength(snapshot_candidates_local,
                Length(subspan_oracle_engine.m_candidates));
            SetLength(snapshot_scores_local,
                Length(subspan_oracle_engine.m_candidates));
            for candidate_idx_local := 0 to High(subspan_oracle_engine.m_candidates) do
            begin
                snapshot_candidates_local[candidate_idx_local] :=
                    subspan_oracle_engine.m_candidates[candidate_idx_local];
                snapshot_scores_local[candidate_idx_local] :=
                    subspan_oracle_engine.get_rank_score(
                    subspan_oracle_engine.m_candidates[candidate_idx_local]);
            end;

            best_text_local := '';
            best_score_local := Low(Integer);
            for candidate_idx_local := 0 to High(snapshot_candidates_local) do
            begin
                if candidate_idx_local >= c_probe_limit_local then
                begin
                    Break;
                end;

                candidate_local := snapshot_candidates_local[candidate_idx_local];
                if Trim(candidate_local.comment) <> '' then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(candidate_local.text);
                candidate_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                if candidate_units_local <> expected_syllables_local then
                begin
                    Continue;
                end;

                candidate_score_local :=
                    snapshot_scores_local[candidate_idx_local] +
                    get_preferred_query_phrase_bonus_local(query_key_local,
                    candidate_text_local);
                preferred_exact_bonus_local :=
                    get_preferred_exact_subspan_bonus_local(query_key_local,
                    candidate_text_local);
                if preferred_exact_bonus_local > 0 then
                begin
                    Inc(candidate_score_local,
                        preferred_exact_bonus_local + 12000);
                end;
                support_path_local := infer_segment_path_for_query_text_with_score(
                    query_key_local, candidate_text_local, support_score_local,
                    support_segments_local);
                if support_path_local <> '' then
                begin
                    Inc(candidate_score_local, support_score_local);
                    Inc(candidate_score_local,
                        Max(0, 2048 - (support_segments_local * 128)));
                end
                else
                begin
                    Dec(candidate_score_local, 2048);
                end;

                if candidate_score_local > best_score_local then
                begin
                    best_score_local := candidate_score_local;
                    best_text_local := candidate_text_local;
                end;
            end;

            if best_text_local <> '' then
            begin
                out_text := best_text_local;
                out_score := best_score_local;
                subspan_oracle_states.AddOrSetValue(query_key_local, 1);
                subspan_oracle_texts.AddOrSetValue(query_key_local, out_text);
                subspan_oracle_scores.AddOrSetValue(query_key_local, out_score);
                Exit(True);
            end;

            subspan_oracle_states.AddOrSetValue(query_key_local, 2);
        end;

        function is_oracle_segment_option_better_local(
            const left_option: TOracleSegmentOption;
            const right_option: TOracleSegmentOption): Boolean;
        begin
            Result := False;
            if left_option.score > right_option.score then
            begin
                Exit(True);
            end;
            if left_option.score < right_option.score then
            begin
                Exit(False);
            end;
            if left_option.rank < right_option.rank then
            begin
                Exit(True);
            end;
            if left_option.rank > right_option.rank then
            begin
                Exit(False);
            end;
            if (left_option.text <> '') and
                ((right_option.text = '') or
                (CompareText(left_option.text, right_option.text) < 0)) then
            begin
                Exit(True);
            end;
        end;

        procedure add_oracle_segment_option_local(
            var options: TOracleSegmentOptionArray;
            const option_value: TOracleSegmentOption);
        const
            c_nested_emit_limit = 4;
        var
            option_idx_local: Integer;
            insert_idx_local: Integer;
            tmp_option_local: TOracleSegmentOption;
        begin
            if Trim(option_value.text) = '' then
            begin
                Exit;
            end;

            for option_idx_local := 0 to High(options) do
            begin
                if SameText(options[option_idx_local].text, option_value.text) then
                begin
                    if is_oracle_segment_option_better_local(option_value,
                        options[option_idx_local]) then
                    begin
                        options[option_idx_local] := option_value;
                    end;
                    Exit;
                end;
            end;

            insert_idx_local := Length(options);
            SetLength(options, insert_idx_local + 1);
            options[insert_idx_local] := option_value;
            while (insert_idx_local > 0) and
                is_oracle_segment_option_better_local(options[insert_idx_local],
                options[insert_idx_local - 1]) do
            begin
                tmp_option_local := options[insert_idx_local - 1];
                options[insert_idx_local - 1] := options[insert_idx_local];
                options[insert_idx_local] := tmp_option_local;
                Dec(insert_idx_local);
            end;

            if Length(options) > c_nested_emit_limit then
            begin
                SetLength(options, c_nested_emit_limit);
            end;
        end;

        function collect_nested_oracle_segment_options_local(
            const query_key_local: string; const expected_units_local: Integer;
            out out_options: TOracleSegmentOptionArray): Boolean;
        const
            c_nested_probe_limit = 8;
        var
            cache_state_local: Integer;
            candidate_idx_local: Integer;
            nested_candidate_local: TncCandidate;
            candidate_text_local: string;
            candidate_units_local: Integer;
            candidate_rank_score_local: Integer;
            option_local: TOracleSegmentOption;
            path_text_local: string;
        begin
            SetLength(out_options, 0);
            if not c_enable_nested_oracle then
            begin
                Exit(False);
            end;
            if (query_key_local = '') or (expected_units_local < 2) then
            begin
                Exit(False);
            end;

            if nested_option_states.TryGetValue(query_key_local, cache_state_local) then
            begin
                if (cache_state_local = 1) and
                    nested_option_cache.TryGetValue(query_key_local, out_options) then
                begin
                    Exit(Length(out_options) > 0);
                end;
                Exit(False);
            end;

            if nested_engine = nil then
            begin
                nested_engine_config := m_config;
                nested_engine_config.debug_mode := False;
                nested_engine := TncEngine.Create(nested_engine_config,
                    False, False);
                inherit_search_budget_policy_to(nested_engine);
                nested_engine.m_disable_subspan_standalone_oracle :=
                    m_disable_subspan_standalone_oracle + 1;
            end;

            nested_engine.m_composition_text := query_key_local;
            nested_engine.build_candidates;

            for candidate_idx_local := 0 to High(nested_engine.m_candidates) do
            begin
                if candidate_idx_local >= c_nested_probe_limit then
                begin
                    Break;
                end;

                nested_candidate_local := nested_engine.m_candidates[candidate_idx_local];
                if Trim(nested_candidate_local.comment) <> '' then
                begin
                    Continue;
                end;
                if nested_engine.is_runtime_chain_candidate(nested_candidate_local) or
                    nested_engine.is_runtime_common_pattern_candidate(
                    nested_candidate_local) or
                    nested_engine.is_runtime_redup_candidate(nested_candidate_local) then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(nested_candidate_local.text);
                if candidate_text_local = '' then
                begin
                    Continue;
                end;
                candidate_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                if candidate_units_local <> expected_units_local then
                begin
                    Continue;
                end;

                candidate_rank_score_local :=
                    nested_engine.get_rank_score(nested_candidate_local);
                if candidate_rank_score_local < 0 then
                begin
                    candidate_rank_score_local := 0;
                end;
                candidate_rank_score_local := normalize_oracle_segment_weight_local(
                    Max(120, candidate_rank_score_local div 48),
                    expected_units_local);
                Inc(candidate_rank_score_local,
                    (c_nested_probe_limit - candidate_idx_local) *
                    (c_oracle_rank_step div 2));
                if expected_units_local >= 3 then
                begin
                    Inc(candidate_rank_score_local, 96);
                end;

                path_text_local := nested_engine.get_segment_path_for_candidate(
                    nested_candidate_local, candidate_idx_local);
                if Trim(path_text_local) = '' then
                begin
                    path_text_local := candidate_text_local;
                end;

                option_local := Default(TOracleSegmentOption);
                option_local.text := candidate_text_local;
                option_local.path_text := path_text_local;
                option_local.score := candidate_rank_score_local;
                option_local.rank := candidate_idx_local;
                add_oracle_segment_option_local(out_options, option_local);
            end;

            if Length(out_options) > 0 then
            begin
                nested_option_states.AddOrSetValue(query_key_local, 1);
                nested_option_cache.AddOrSetValue(query_key_local,
                    Copy(out_options));
                Exit(True);
            end;

            nested_option_states.AddOrSetValue(query_key_local, 2);
            Result := False;
        end;

        procedure add_state(var states: TOracleStateArray;
            const candidate_state: TOracleState);
        var
            idx: Integer;
            insert_idx: Integer;
            tmp_state: TOracleState;
        begin
            if is_debug_target_recall_prefix(candidate_state.text) then
            begin
                m_debug_target_max_generated_syllable := Max(
                    m_debug_target_max_generated_syllable,
                    get_candidate_text_unit_count(candidate_state.text));
            end;

            for idx := 0 to High(states) do
            begin
                if states[idx].path = candidate_state.path then
                begin
                    if candidate_state.score > states[idx].score then
                    begin
                        states[idx] := candidate_state;
                    end;
                    Exit;
                end;
            end;

            insert_idx := Length(states);
            SetLength(states, insert_idx + 1);
            states[insert_idx] := candidate_state;
            while (insert_idx > 0) and
                (states[insert_idx].score > states[insert_idx - 1].score) do
            begin
                tmp_state := states[insert_idx - 1];
                states[insert_idx - 1] := states[insert_idx];
                states[insert_idx] := tmp_state;
                Dec(insert_idx);
            end;

            if Length(states) > c_oracle_beam_width then
            begin
                SetLength(states, c_oracle_beam_width);
            end;

            for idx := 0 to High(states) do
            begin
                if is_debug_target_recall_prefix(states[idx].text) then
                begin
                    m_debug_target_max_retained_syllable := Max(
                        m_debug_target_max_retained_syllable,
                        get_candidate_text_unit_count(states[idx].text));
                end;
            end;
        end;

        procedure append_oracle_candidate(const text_value: string;
            const path_value: string; const score_value: Integer);
        var
            candidate: TncCandidate;
            next_index: Integer;
        begin
            if Trim(text_value) = '' then
            begin
                Exit;
            end;

            candidate.text := Trim(text_value);
            candidate.comment := '';
            candidate.score := score_value;
            candidate.source := cs_rule;
            candidate.has_dict_weight := False;
            candidate.dict_weight := 0;

            next_index := Length(out_candidates);
            SetLength(out_candidates, next_index + 1);
            out_candidates[next_index] := candidate;
            remember_segment_path_for_candidate(candidate.text, '',
                Trim(path_value), score_value);
        end;

    var
        pos: Integer;
        seg_len: Integer;
        next_pos: Integer;
        state_idx: Integer;
        base_state: TOracleState;
        candidate_state: TOracleState;
        seg_key: string;
        fixed_text: string;
        single_options: TOracleSegmentOptionArray;
        single_option: TOracleSegmentOption;
        lookup_results: TncCandidateList;
        exact_results: TncCandidateList;
        merged_results: TncCandidateList;
        exact_idx: Integer;
        merged_idx: Integer;
        duplicate_found: Boolean;
        candidate_text: string;
        candidate_units: Integer;
        effective_weight: Integer;
        result_idx: Integer;
        resolved_text_local: string;
        resolved_score_local: Integer;
        resolved_segments_local: Integer;
        resolved_path_local: string;
        resolved_has_anchor_local: Boolean;
        resolved_anchor_units_local: Integer;
        resolved_chunk_text_local: string;
        resolved_chunk_valid_local: Boolean;
        prefer_resolved_chunk_local: Boolean;
        allow_raw_merged_local: Boolean;
        nested_segment_options_local: TOracleSegmentOptionArray;
        nested_option_idx_local: Integer;
        nested_option_local: TOracleSegmentOption;
        standalone_query_text_local: string;
        standalone_query_score_local: Integer;
        standalone_query_candidate_local: TncCandidate;
        standalone_query_valid_local: Boolean;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        nested_option_states := nil;
        nested_option_cache := nil;
        nested_engine := nil;
        merged_result_cache := nil;
        oracle_start_tick := GetTickCount64;
        oracle_work_count := 0;
        oracle_timed_out := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(normalized_query);
        head_syllable_count_local := Length(syllables_local);
        if head_syllable_count_local < 4 then
        begin
            Exit;
        end;
        SetLength(single_option_cache, head_syllable_count_local);
        SetLength(single_option_cache_prepared, head_syllable_count_local);

        if c_enable_nested_oracle then
        begin
            nested_option_states := TDictionary<string, Integer>.Create;
            nested_option_cache := TDictionary<string, TOracleSegmentOptionArray>.Create;
        end;
        merged_result_cache := TDictionary<string, TncCandidateList>.Create;
        try
        SetLength(state_map, head_syllable_count_local + 1);
        SetLength(state_map[0], 1);
        state_map[0][0].score := 0;
        state_map[0][0].text := '';
        state_map[0][0].path := '';
        state_map[0][0].prev_text := '';
        state_map[0][0].prev_prev_text := '';

        for pos := 0 to head_syllable_count_local - 1 do
        begin
            if oracle_budget_exhausted_local then
            begin
                Exit(False);
            end;
            for state_idx := 0 to High(state_map[pos]) do
            begin
                if oracle_budget_exhausted_local then
                begin
                    Exit(False);
                end;
                base_state := state_map[pos][state_idx];

                seg_key := normalize_pinyin_text(syllables_local[pos].text);
                fixed_text := get_fixed_oracle_single_char(seg_key);
                if fixed_text <> '' then
                begin
                    candidate_state.score := base_state.score + 960 -
                        c_oracle_single_penalty;
                    if base_state.text <> '' then
                    begin
                        Dec(candidate_state.score,
                            c_oracle_additional_segment_penalty);
                        Inc(candidate_state.score,
                            get_oracle_context_bonus_local(base_state.prev_text,
                            fixed_text));
                        if base_state.prev_prev_text <> '' then
                        begin
                            Inc(candidate_state.score,
                                get_oracle_trigram_bonus_local(
                                base_state.prev_prev_text,
                                base_state.prev_text, fixed_text));
                        end;
                        candidate_state.text := base_state.text + fixed_text;
                        candidate_state.path := base_state.path +
                            c_segment_path_separator + fixed_text;
                    end
                    else
                    begin
                        candidate_state.text := fixed_text;
                        candidate_state.path := fixed_text;
                    end;
                    candidate_state.prev_prev_text := base_state.prev_text;
                    candidate_state.prev_text := fixed_text;
                    add_state(state_map[pos + 1], candidate_state);
                end
                else
                begin
                    get_oracle_single_options_local(pos, seg_key,
                        single_options);
                    for result_idx := 0 to High(single_options) do
                    begin
                        single_option := single_options[result_idx];
                        candidate_text := single_option.text;
                        effective_weight := single_option.score;

                        candidate_state.score := base_state.score + effective_weight -
                            c_oracle_single_penalty;
                        if base_state.text <> '' then
                        begin
                            Dec(candidate_state.score,
                                c_oracle_additional_segment_penalty);
                            Inc(candidate_state.score,
                                get_oracle_context_bonus_local(base_state.prev_text,
                                candidate_text));
                            if base_state.prev_prev_text <> '' then
                            begin
                                Inc(candidate_state.score,
                                    get_oracle_trigram_bonus_local(
                                    base_state.prev_prev_text,
                                    base_state.prev_text, candidate_text));
                            end;
                            candidate_state.text := base_state.text + candidate_text;
                            candidate_state.path := base_state.path +
                                c_segment_path_separator + candidate_text;
                        end
                        else
                        begin
                            candidate_state.text := candidate_text;
                            candidate_state.path := candidate_text;
                        end;
                        candidate_state.prev_prev_text := base_state.prev_text;
                        candidate_state.prev_text := candidate_text;
                        add_state(state_map[pos + 1], candidate_state);
                    end;
                end;

                for seg_len := 2 to Min(c_oracle_max_segment_syllables,
                    head_syllable_count_local - pos) do
                begin
                    if oracle_budget_exhausted_local then
                    begin
                        Exit(False);
                    end;
                    seg_key := build_syllable_query_key_local(pos, seg_len);
                    if seg_key = '' then
                    begin
                        Continue;
                    end;

                    resolved_chunk_text_local := '';
                    resolved_chunk_valid_local := False;
                    if try_resolve_best_exact_subspan_local(pos, seg_len,
                        resolved_text_local, resolved_score_local,
                        resolved_segments_local, resolved_path_local,
                        resolved_has_anchor_local,
                        resolved_anchor_units_local) then
                    begin
                        candidate_text := Trim(resolved_text_local);
                        candidate_units := get_candidate_text_unit_count(
                            candidate_text);
                        if (candidate_text <> '') and
                            (candidate_units = seg_len) then
                        begin
                            prefer_resolved_chunk_local :=
                                (seg_len >= 3) or resolved_has_anchor_local or
                                (resolved_segments_local > 1);
                            if prefer_resolved_chunk_local then
                            begin
                                next_pos := pos + seg_len;
                                candidate_state.score := base_state.score +
                                    resolved_score_local + c_oracle_multi_bonus +
                                    (seg_len * c_oracle_rank_step);
                                if resolved_segments_local > 1 then
                                begin
                                    Dec(candidate_state.score,
                                        (resolved_segments_local - 1) *
                                        (c_oracle_additional_segment_penalty div 2));
                                end;
                                if base_state.text <> '' then
                                begin
                                    Dec(candidate_state.score,
                                        c_oracle_additional_segment_penalty);
                                    Inc(candidate_state.score,
                                        get_oracle_context_bonus_local(
                                        base_state.prev_text, candidate_text));
                                    if base_state.prev_prev_text <> '' then
                                    begin
                                        Inc(candidate_state.score,
                                            get_oracle_trigram_bonus_local(
                                            base_state.prev_prev_text,
                                            base_state.prev_text, candidate_text));
                                    end;
                                    candidate_state.text := base_state.text +
                                        candidate_text;
                                    if Trim(resolved_path_local) <> '' then
                                    begin
                                        candidate_state.path := base_state.path +
                                            c_segment_path_separator +
                                            Trim(resolved_path_local);
                                    end
                                    else
                                    begin
                                        candidate_state.path := base_state.path +
                                            c_segment_path_separator +
                                            candidate_text;
                                    end;
                                end
                                else
                                begin
                                    candidate_state.text := candidate_text;
                                    if Trim(resolved_path_local) <> '' then
                                    begin
                                        candidate_state.path := Trim(
                                            resolved_path_local);
                                    end
                                    else
                                    begin
                                        candidate_state.path := candidate_text;
                                    end;
                                end;
                                if resolved_has_anchor_local or
                                    (seg_len >= 3) then
                                begin
                                    Inc(candidate_state.score,
                                        c_oracle_anchor_bonus);
                                end;
                                candidate_state.prev_prev_text := base_state.prev_text;
                                candidate_state.prev_text := candidate_text;
                                add_state(state_map[next_pos], candidate_state);
                                resolved_chunk_text_local := candidate_text;
                                resolved_chunk_valid_local := True;
                            end;
                        end;
                    end;

                    allow_raw_merged_local := not
                        ((head_syllable_count_local >= 8) and
                        (resolved_chunk_valid_local or (seg_len >= 4)));
                    SetLength(merged_results, 0);
                    if allow_raw_merged_local then
                    begin
                        if merged_result_cache.TryGetValue(seg_key,
                            merged_results) then
                        begin
                            merged_results := Copy(merged_results);
                        end
                        else
                        begin
                            if dictionary_lookup_cached(seg_key,
                                lookup_results) then
                            begin
                                SetLength(merged_results,
                                    Length(lookup_results));
                                for merged_idx := 0 to High(lookup_results) do
                                begin
                                    merged_results[merged_idx] :=
                                        lookup_results[merged_idx];
                                end;
                            end;

                            if dictionary_exact_lookup_cached(seg_key,
                                exact_results) then
                            begin
                                for exact_idx := 0 to High(exact_results) do
                                begin
                                    duplicate_found := False;
                                    for merged_idx := 0 to High(
                                        merged_results) do
                                    begin
                                        if SameText(Trim(
                                            merged_results[merged_idx].text),
                                            Trim(exact_results[exact_idx].text)) and
                                            SameText(Trim(
                                            merged_results[merged_idx].comment),
                                            Trim(exact_results[exact_idx].comment)) then
                                        begin
                                            duplicate_found := True;
                                            Break;
                                        end;
                                    end;
                                    if duplicate_found then
                                    begin
                                        Continue;
                                    end;
                                    SetLength(merged_results,
                                        Length(merged_results) + 1);
                                    merged_results[High(merged_results)] :=
                                        exact_results[exact_idx];
                                end;
                            end;
                            merged_result_cache.AddOrSetValue(seg_key,
                                Copy(merged_results));
                        end;
                    end;

                    if Length(merged_results) <= 0 then
                    begin
                        SetLength(merged_results, 0);
                    end;

                    standalone_query_valid_local := False;
                    if (seg_len <= 5) and (head_syllable_count_local >= 6) and
                        try_get_best_oracle_standalone_query_candidate_local(
                        seg_key, seg_len, standalone_query_text_local,
                        standalone_query_score_local) and
                        (standalone_query_text_local <> '') then
                    begin
                        standalone_query_valid_local :=
                            oracle_candidate_respects_fixed_boundaries_local(
                            pos, seg_len, standalone_query_text_local);
                        if standalone_query_valid_local then
                        begin
                            duplicate_found := False;
                            for merged_idx := 0 to High(merged_results) do
                            begin
                                if SameText(
                                    Trim(merged_results[merged_idx].text),
                                    standalone_query_text_local) then
                                begin
                                    duplicate_found := True;
                                    Break;
                                end;
                            end;

                            if not duplicate_found then
                            begin
                                FillChar(standalone_query_candidate_local,
                                    SizeOf(standalone_query_candidate_local), 0);
                                standalone_query_candidate_local.text :=
                                    standalone_query_text_local;
                                standalone_query_candidate_local.comment := '';
                                standalone_query_candidate_local.score :=
                                    standalone_query_score_local;
                                standalone_query_candidate_local.source := cs_rule;
                                standalone_query_candidate_local.has_dict_weight := True;
                                standalone_query_candidate_local.dict_weight :=
                                    standalone_query_score_local;
                                SetLength(merged_results, Length(merged_results) + 1);
                                for merged_idx := High(merged_results) downto 1 do
                                begin
                                    merged_results[merged_idx] :=
                                        merged_results[merged_idx - 1];
                                end;
                                merged_results[0] :=
                                    standalone_query_candidate_local;
                            end;
                        end;
                    end;

                    if standalone_query_valid_local and
                        ((seg_len >= 4) or
                        (standalone_query_score_local >= 24000)) then
                    begin
                        allow_raw_merged_local := False;
                    end;

                    if standalone_query_valid_local then
                    begin
                        next_pos := pos + seg_len;
                        candidate_state.score := base_state.score +
                            standalone_query_score_local + c_oracle_multi_bonus +
                            (seg_len * c_oracle_rank_step) +
                            c_oracle_standalone_match_bonus;
                        if base_state.text <> '' then
                        begin
                            Dec(candidate_state.score,
                                c_oracle_additional_segment_penalty);
                            Inc(candidate_state.score,
                                get_oracle_context_bonus_local(
                                base_state.prev_text,
                                standalone_query_text_local));
                            if base_state.prev_prev_text <> '' then
                            begin
                                Inc(candidate_state.score,
                                    get_oracle_trigram_bonus_local(
                                    base_state.prev_prev_text,
                                    base_state.prev_text,
                                    standalone_query_text_local));
                            end;
                            candidate_state.text := base_state.text +
                                standalone_query_text_local;
                            candidate_state.path := base_state.path +
                                c_segment_path_separator +
                                standalone_query_text_local;
                        end
                        else
                        begin
                            candidate_state.text := standalone_query_text_local;
                            candidate_state.path := standalone_query_text_local;
                        end;
                        if seg_len >= 3 then
                        begin
                            Inc(candidate_state.score, c_oracle_anchor_bonus);
                        end;
                        candidate_state.prev_prev_text := base_state.prev_text;
                        candidate_state.prev_text := standalone_query_text_local;
                        add_state(state_map[next_pos], candidate_state);
                    end;

                    if c_enable_nested_oracle and
                        ((seg_len >= 3) or
                        segment_has_fixed_oracle_boundary_local(pos, seg_len)) and
                        collect_nested_oracle_segment_options_local(seg_key, seg_len,
                        nested_segment_options_local) then
                    begin
                        next_pos := pos + seg_len;
                        for nested_option_idx_local := 0 to High(
                            nested_segment_options_local) do
                        begin
                            nested_option_local := nested_segment_options_local[
                                nested_option_idx_local];
                            if Trim(nested_option_local.text) = '' then
                            begin
                                Continue;
                            end;
                            if resolved_chunk_valid_local and SameText(
                                nested_option_local.text,
                                resolved_chunk_text_local) then
                            begin
                                Continue;
                            end;

                            candidate_state.score := base_state.score +
                                nested_option_local.score + c_oracle_multi_bonus +
                                ((c_oracle_probe_limit - Min(
                                nested_option_local.rank, c_oracle_probe_limit - 1)) *
                                c_oracle_rank_step);
                            if base_state.text <> '' then
                            begin
                                Dec(candidate_state.score,
                                    c_oracle_additional_segment_penalty);
                                Inc(candidate_state.score,
                                    get_oracle_context_bonus_local(
                                    base_state.prev_text,
                                    nested_option_local.text));
                                if base_state.prev_prev_text <> '' then
                                begin
                                    Inc(candidate_state.score,
                                        get_oracle_trigram_bonus_local(
                                        base_state.prev_prev_text,
                                        base_state.prev_text,
                                        nested_option_local.text));
                                end;
                                candidate_state.text := base_state.text +
                                    nested_option_local.text;
                                candidate_state.path := base_state.path +
                                    c_segment_path_separator +
                                    nested_option_local.path_text;
                            end
                            else
                            begin
                                candidate_state.text := nested_option_local.text;
                                candidate_state.path := nested_option_local.path_text;
                            end;
                            if seg_len >= 3 then
                            begin
                                Inc(candidate_state.score, c_oracle_anchor_bonus);
                            end;
                            candidate_state.prev_prev_text := base_state.prev_text;
                            candidate_state.prev_text := nested_option_local.text;
                            add_state(state_map[next_pos], candidate_state);
                        end;
                    end;

                    if allow_raw_merged_local and (Length(merged_results) > 0) then
                    begin
                        next_pos := pos + seg_len;
                        for result_idx := 0 to Min(c_oracle_probe_limit - 1,
                            High(merged_results)) do
                        begin
                            if Trim(merged_results[result_idx].comment) <> '' then
                            begin
                                Continue;
                            end;
                            if is_runtime_chain_candidate(
                                merged_results[result_idx]) or
                                is_runtime_common_pattern_candidate(
                                merged_results[result_idx]) or
                                is_runtime_redup_candidate(
                                merged_results[result_idx]) then
                            begin
                                Continue;
                            end;

                            candidate_text := Trim(merged_results[result_idx].text);
                            candidate_units := get_candidate_text_unit_count(
                                candidate_text);
                            if candidate_units < 2 then
                            begin
                                Continue;
                            end;
                            if resolved_chunk_valid_local and
                                SameText(candidate_text, resolved_chunk_text_local) then
                            begin
                                Continue;
                            end;

                            effective_weight := merged_results[result_idx].score;
                            if merged_results[result_idx].has_dict_weight and
                                (merged_results[result_idx].dict_weight >
                                effective_weight) then
                            begin
                                effective_weight :=
                                    merged_results[result_idx].dict_weight;
                            end;
                            effective_weight :=
                                normalize_oracle_segment_weight_local(
                                effective_weight, seg_len);
                            Inc(effective_weight,
                                get_preferred_query_phrase_bonus_local(seg_key,
                                candidate_text));
                            if standalone_query_valid_local then
                            begin
                                if SameText(candidate_text,
                                    standalone_query_text_local) then
                                begin
                                    Inc(effective_weight,
                                        c_oracle_standalone_match_bonus);
                                end
                                else if seg_len <= 5 then
                                begin
                                    Dec(effective_weight,
                                        c_oracle_standalone_mismatch_penalty *
                                        IfThen(seg_len >= 4, 2, 1));
                                end;
                            end;

                            candidate_state.score := base_state.score +
                                effective_weight + c_oracle_multi_bonus +
                                ((c_oracle_probe_limit - result_idx) *
                                c_oracle_rank_step);
                            if base_state.text <> '' then
                            begin
                                Dec(candidate_state.score,
                                    c_oracle_additional_segment_penalty);
                                Inc(candidate_state.score,
                                    get_oracle_context_bonus_local(
                                    base_state.prev_text, candidate_text));
                                if base_state.prev_prev_text <> '' then
                                begin
                                    Inc(candidate_state.score,
                                        get_oracle_trigram_bonus_local(
                                        base_state.prev_prev_text,
                                        base_state.prev_text, candidate_text));
                                end;
                                candidate_state.text := base_state.text +
                                    candidate_text;
                                candidate_state.path := base_state.path +
                                    c_segment_path_separator + candidate_text;
                            end
                            else
                            begin
                                candidate_state.text := candidate_text;
                                candidate_state.path := candidate_text;
                            end;
                            if seg_len >= 3 then
                            begin
                                Inc(candidate_state.score,
                                    c_oracle_anchor_bonus);
                            end;
                            candidate_state.prev_prev_text := base_state.prev_text;
                            candidate_state.prev_text := candidate_text;
                            add_state(state_map[next_pos], candidate_state);
                        end;
                    end;
                end;
            end;
        end;

        final_states := state_map[head_syllable_count_local];
        if Length(final_states) <= 0 then
        begin
            Exit;
        end;

        if m_debug_target_recall_text <> '' then
        begin
            m_debug_target_final_state_count := Max(
                m_debug_target_final_state_count, Length(final_states));
            for state_idx := 0 to High(final_states) do
            begin
                if SameText(Trim(final_states[state_idx].text),
                    m_debug_target_recall_text) then
                begin
                    m_debug_target_final_state_source_mask :=
                        m_debug_target_final_state_source_mask or 8;
                    if (m_debug_target_oracle_final_state_rank = 0) or
                        (state_idx + 1 < m_debug_target_oracle_final_state_rank) then
                    begin
                        m_debug_target_oracle_final_state_rank := state_idx + 1;
                    end;
                    if (not m_debug_target_final_state_found) or
                        (state_idx + 1 < m_debug_target_final_state_rank) then
                    begin
                        m_debug_target_final_state_found := True;
                        m_debug_target_final_state_rank := state_idx + 1;
                    end;
                end;
            end;
        end;

        for state_idx := 0 to Min(c_oracle_emit_limit - 1, High(final_states)) do
        begin
            append_oracle_candidate(final_states[state_idx].text,
                final_states[state_idx].path,
                final_states[state_idx].score + c_oracle_final_complete_bonus);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
        finally
            merged_result_cache.Free;
            nested_engine.Free;
            nested_option_cache.Free;
            nested_option_states.Free;
        end;
    end;

    function get_prefix_partial_syllables_for_query(const query_text: string;
        out out_syllables: TncPinyinParseResult): Boolean;
    var
        normalized_query_local: string;
        explicit_compact_local: string;
        syllable_idx_local: Integer;
    begin
        normalized_query_local := normalize_pinyin_text(query_text);
        SetLength(out_syllables, 0);
        if normalized_query_local = '' then
        begin
            Exit(False);
        end;

        if has_explicit_apostrophe_input and
            SameText(normalize_pinyin_text(m_composition_text),
            normalized_query_local) and
            ensure_explicit_apostrophe_query_syllables_parsed then
        begin
            explicit_compact_local := '';
            SetLength(out_syllables, Length(explicit_apostrophe_query_syllables));
            for syllable_idx_local := 0 to
                High(explicit_apostrophe_query_syllables) do
            begin
                out_syllables[syllable_idx_local] :=
                    explicit_apostrophe_query_syllables[syllable_idx_local];
                out_syllables[syllable_idx_local].text := normalize_pinyin_text(
                    out_syllables[syllable_idx_local].text);
                explicit_compact_local := explicit_compact_local +
                    out_syllables[syllable_idx_local].text;
            end;

            if SameText(explicit_compact_local, normalized_query_local) then
            begin
                Exit(Length(out_syllables) > 0);
            end;
        end;

        out_syllables :=
            get_effective_compact_pinyin_syllables(normalized_query_local);
        Result := Length(out_syllables) > 0;
    end;

    function build_explicit_apostrophe_prefix_partial_candidates(
        out out_candidates: TncCandidateList): Boolean;
    const
        c_explicit_prefix_total_limit = 16;
        c_explicit_prefix_base_bonus = 1800;
        c_explicit_prefix_bonus_per_syllable = 180;
        c_explicit_prefix_remaining_penalty = 42;
    var
        syllables_local: TncPinyinParseResult;
        prefix_count: Integer;
        tail_idx: Integer;
        result_idx: Integer;
        prefix_key: string;
        tail_comment: string;
        raw_prefix_key: string;
        head_results: TncCandidateList;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        base_score: Integer;
        accepted_total: Integer;
        seen_key: string;
        seen: TDictionary<string, Byte>;

        function candidate_matches_explicit_prefix_local(
            const text_value: string): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            is_preferred_local: Boolean;
        begin
            Result := False;
            text_units_local := split_text_units(Trim(text_value));
            if Length(text_units_local) <> prefix_count then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to prefix_count - 1 do
            begin
                if not match_single_char_candidate_for_syllable(
                    normalize_pinyin_text(syllables_local[unit_idx_local].text),
                    text_units_local[unit_idx_local],
                    is_preferred_local) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function get_raw_prefix_key_for_count_local(
            const target_prefix_count: Integer): string;
        var
            target_compact_len_local: Integer;
            unit_idx_local: Integer;
            raw_idx_local: Integer;
            compact_seen_local: Integer;
            raw_char_local: Char;
        begin
            Result := '';
            target_compact_len_local := 0;
            for unit_idx_local := 0 to target_prefix_count - 1 do
            begin
                Inc(target_compact_len_local, Length(normalize_pinyin_text(
                    syllables_local[unit_idx_local].text)));
            end;
            if target_compact_len_local <= 0 then
            begin
                Exit;
            end;

            compact_seen_local := 0;
            for raw_idx_local := 1 to Length(m_composition_text) do
            begin
                raw_char_local := m_composition_text[raw_idx_local];
                Result := Result + raw_char_local;
                if raw_char_local <> '''' then
                begin
                    Inc(compact_seen_local);
                    if compact_seen_local >= target_compact_len_local then
                    begin
                        Break;
                    end;
                end;
            end;
            Result := LowerCase(Trim(Result));
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if (m_dictionary = nil) or (not has_explicit_apostrophe_input) or
            (not ensure_explicit_apostrophe_query_syllables_parsed) then
        begin
            Exit;
        end;

        syllables_local := explicit_apostrophe_query_syllables;
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            prefix_key := '';
            for prefix_count := 1 to High(syllables_local) do
            begin
                prefix_key := prefix_key +
                    normalize_pinyin_text(syllables_local[prefix_count - 1].text);
                if prefix_count < 2 then
                begin
                    Continue;
                end;

                tail_comment := '';
                for tail_idx := prefix_count to High(syllables_local) do
                begin
                    tail_comment := tail_comment +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if tail_comment = '' then
                begin
                    Continue;
                end;

                raw_prefix_key := get_raw_prefix_key_for_count_local(prefix_count);
                if ((raw_prefix_key = '') or
                    ((not dictionary_lookup_cached(raw_prefix_key, head_results)) and
                    (not dictionary_exact_lookup_cached(raw_prefix_key,
                    head_results)))) and
                    ((not dictionary_exact_lookup_cached(prefix_key,
                    head_results)) and
                    (not dictionary_lookup_cached(prefix_key, head_results))) then
                begin
                    Continue;
                end;

                for result_idx := 0 to High(head_results) do
                begin
                    if accepted_total >= c_explicit_prefix_total_limit then
                    begin
                        Break;
                    end;

                    if Trim(head_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(head_results[result_idx].text);
                    candidate_units := get_candidate_text_unit_count(candidate_text);
                    if (candidate_text = '') or (candidate_units <> prefix_count) or
                        (not candidate_matches_explicit_prefix_local(candidate_text)) then
                    begin
                        Continue;
                    end;

                    seen_key := candidate_text + #9 + tail_comment;
                    if seen.ContainsKey(seen_key) then
                    begin
                        Continue;
                    end;

                    candidate := head_results[result_idx];
                    candidate.comment := tail_comment;
                    base_score := candidate.score;
                    if candidate.has_dict_weight and
                        (candidate.dict_weight > base_score) then
                    begin
                        base_score := candidate.dict_weight;
                    end;
                    candidate.score := base_score + c_explicit_prefix_base_bonus +
                        (prefix_count * c_explicit_prefix_bonus_per_syllable);
                    Dec(candidate.score,
                        (Length(syllables_local) - prefix_count) *
                        c_explicit_prefix_remaining_penalty);
                    candidate.dict_weight := base_score;
                    candidate.has_dict_weight := True;

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate;
                    seen.AddOrSetValue(seen_key, 1);
                    Inc(accepted_total);
                end;
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_exact_head_partial_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_head_partial_limit = 6;
        c_head_partial_bonus = 160;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        head_key: string;
        tail_comment: string;
        idx: Integer;
        head_results: TncCandidateList;
        candidate: TncCandidate;
        accepted_count: Integer;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        if not get_prefix_partial_syllables_for_query(query_text,
            syllables_local) then
        begin
            Exit;
        end;
        if Length(syllables_local) < 2 then
        begin
            Exit;
        end;

        tail_comment := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        if (tail_comment = '') or (not is_full_pinyin_key(tail_comment)) then
        begin
            Exit;
        end;

        head_key := '';
        for idx := 0 to High(syllables_local) - 1 do
        begin
            head_key := head_key + normalize_pinyin_text(syllables_local[idx].text);
        end;
        if head_key = '' then
        begin
            Exit;
        end;
        if not dictionary_exact_lookup_cached(head_key, head_results) then
        begin
            Exit;
        end;

        accepted_count := 0;
        for idx := 0 to High(head_results) do
        begin
            if accepted_count >= c_head_partial_limit then
            begin
                Break;
            end;
            if Trim(head_results[idx].comment) <> '' then
            begin
                Continue;
            end;
            candidate := head_results[idx];
            candidate.comment := tail_comment;
            Inc(candidate.score, c_head_partial_bonus);
            if candidate.dict_weight <= 0 then
            begin
                candidate.dict_weight := candidate.score;
            end;
            candidate.has_dict_weight := True;
            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate;
            Inc(accepted_count);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_lexicon_longer_prefix_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_total_limit = 8;
        c_prefix_base_bonus = 2100;
        c_prefix_unit_bonus = 260;
        c_prefix_tail_bonus = 320;
        c_prefix_complete_bonus = 980;
        c_prefix_remaining_penalty = 90;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        prefix_unit_count: Integer;
        tail_comment: string;
        prefix_results: TncCandidateList;
        accepted_total: Integer;
        candidate_text: string;
        text_units: TArray<string>;
        text_unit_count: Integer;
        prefix_text: string;
        candidate: TncCandidate;
        base_score: Integer;
        seen_key: string;
        seen: TDictionary<string, Byte>;

        function is_safe_longer_prefix_suffix_local(const units: TArray<string>;
            const suffix_start_idx: Integer): Boolean;
        var
            suffix_head: string;
        begin
            Result := False;
            if (suffix_start_idx < 0) or (suffix_start_idx > High(units)) then
            begin
                Exit;
            end;

            suffix_head := units[suffix_start_idx];
            if get_candidate_text_unit_count(suffix_head) <> 1 then
            begin
                Exit;
            end;

            Result :=
                (suffix_head = string(Char($533A))) or
                (suffix_head = string(Char($5E02))) or
                (suffix_head = string(Char($7701))) or
                (suffix_head = string(Char($53BF))) or
                (suffix_head = string(Char($9547))) or
                (suffix_head = string(Char($4E61))) or
                (suffix_head = string(Char($8DEF))) or
                (suffix_head = string(Char($8857))) or
                (suffix_head = string(Char($9053))) or
                (suffix_head = string(Char($4E0B))) or
                (suffix_head = string(Char($4E0A))) or
                (suffix_head = string(Char($4E2D))) or
                (suffix_head = string(Char($5185))) or
                (suffix_head = string(Char($5916))) or
                (suffix_head = string(Char($524D))) or
                (suffix_head = string(Char($540E))) or
                (suffix_head = string(Char($4E1C))) or
                (suffix_head = string(Char($897F))) or
                (suffix_head = string(Char($5357))) or
                (suffix_head = string(Char($5317))) or
                (suffix_head = string(Char($8FB9))) or
                (suffix_head = string(Char($9762))) or
                (suffix_head = string(Char($7248))) or
                (suffix_head = string(Char($53F7))) or
                (suffix_head = string(Char($5E97)));
        end;

        procedure append_longer_prefix_candidates_local(
            const local_prefix_unit_count: Integer;
            const local_tail_comment: string);
        var
            local_result_idx: Integer;
            local_unit_idx: Integer;
        begin
            if (local_prefix_unit_count < 1) or
                (local_prefix_unit_count > Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_result_idx := 0 to High(prefix_results) do
            begin
                if accepted_total >= c_prefix_total_limit then
                begin
                    Break;
                end;

                if (prefix_results[local_result_idx].source = cs_user) or
                    (Trim(prefix_results[local_result_idx].comment) <> '') then
                begin
                    Continue;
                end;

                candidate_text := Trim(prefix_results[local_result_idx].text);
                if candidate_text = '' then
                begin
                    Continue;
                end;

                text_units := split_text_units(candidate_text);
                text_unit_count := Length(text_units);
                if text_unit_count <= local_prefix_unit_count then
                begin
                    Continue;
                end;

                prefix_text := '';
                for local_unit_idx := 0 to local_prefix_unit_count - 1 do
                begin
                    prefix_text := prefix_text + text_units[local_unit_idx];
                end;
                if prefix_text = '' then
                begin
                    Continue;
                end;
                if (local_tail_comment = '') and
                    (not is_safe_longer_prefix_suffix_local(text_units,
                    local_prefix_unit_count)) then
                begin
                    Continue;
                end;
                if m_dictionary.is_base_entry(normalized_query, prefix_text) then
                begin
                    Continue;
                end;

                seen_key := prefix_text + #9 + local_tail_comment;
                if seen.ContainsKey(seen_key) then
                begin
                    Continue;
                end;

                candidate := prefix_results[local_result_idx];
                candidate.text := prefix_text;
                candidate.comment := local_tail_comment;
                base_score := candidate.score;
                if candidate.has_dict_weight and (candidate.dict_weight > base_score) then
                begin
                    base_score := candidate.dict_weight;
                end;
                if base_score < 0 then
                begin
                    base_score := 0;
                end;

                candidate.score := base_score + c_prefix_base_bonus +
                    (local_prefix_unit_count * c_prefix_unit_bonus) -
                    ((text_unit_count - local_prefix_unit_count) *
                    c_prefix_remaining_penalty);
                if local_tail_comment = '' then
                begin
                    Inc(candidate.score, c_prefix_complete_bonus);
                end
                else
                begin
                    Inc(candidate.score, c_prefix_tail_bonus);
                end;
                candidate.dict_weight := base_score;
                candidate.has_dict_weight := True;

                SetLength(out_candidates, Length(out_candidates) + 1);
                out_candidates[High(out_candidates)] := candidate;
                seen.AddOrSetValue(seen_key, 1);
                Inc(accepted_total);
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if (m_dictionary = nil) or (query_text = '') then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        if not get_prefix_partial_syllables_for_query(query_text,
            syllables_local) then
        begin
            Exit;
        end;
        if Length(syllables_local) < 2 then
        begin
            Exit;
        end;

        prefix_unit_count := Length(syllables_local);
        tail_comment := '';
        if not is_full_pinyin_key(
            normalize_pinyin_text(syllables_local[High(syllables_local)].text)) then
        begin
            Dec(prefix_unit_count);
            tail_comment := normalize_pinyin_text(
                syllables_local[High(syllables_local)].text);
        end;

        if prefix_unit_count < 2 then
        begin
            Exit;
        end;

        if not dictionary_prefix_lookup_cached(normalized_query, prefix_results) then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            append_longer_prefix_candidates_local(prefix_unit_count,
                tail_comment);

            if (tail_comment = '') and (Length(syllables_local) >= 2) then
            begin
                append_longer_prefix_candidates_local(
                    Length(syllables_local) - 1,
                    normalize_pinyin_text(
                    syllables_local[High(syllables_local)].text));
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_exact_leading_prefix_partial_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_total_limit = c_candidate_total_limit_max;
        c_prefix_single_limit = c_candidate_total_limit_max;
        c_prefix_phrase_limit = 16;
        c_prefix_base_bonus = 220;
        c_prefix_bonus_per_syllable = 180;
        c_prefix_remaining_penalty = 42;
        c_prefix_max_syllables = 6;
        c_prefix_phrase_extra_bonus = 520;
        c_prefix_short_query_phrase_bonus = 260;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        prefix_count: Integer;
        tail_idx: Integer;
        result_idx: Integer;
        accepted_total: Integer;
        accepted_for_prefix: Integer;
        accepted_limit: Integer;
        prefix_key: string;
        tail_comment: string;
        head_results: TncCandidateList;
        prefix_lookup_results: TncCandidateList;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        lookup_idx: Integer;
        lookup_text: string;
        base_score: Integer;
        effective_prefix_units: Integer;
        seen_key: string;
        cache_key: string;
        cached_candidates: TncCandidateList;
        seen: TDictionary<string, Byte>;
        longer_prefix_candidates: TncCandidateList;
        normalized_learning: Boolean;

        function explicit_prefix_lookup_entry_local(
            const text_value: string): Boolean;
        var
            local_lookup_idx: Integer;
        begin
            Result := prefix_count < 2;
            if Result then
            begin
                Exit;
            end;

            for local_lookup_idx := 0 to High(prefix_lookup_results) do
            begin
                if (Trim(prefix_lookup_results[local_lookup_idx].comment) = '') and
                    SameText(Trim(prefix_lookup_results[local_lookup_idx].text),
                    text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function compact_prefix_matches_two_unit_candidate_local(
            const prefix_key_value: string; const text_value: string): Boolean;
        var
            text_units_local: TArray<string>;
            parser_local: TncPinyinParser;
            left_text_local: string;
            right_text_local: string;
            is_preferred_local: Boolean;
        begin
            Result := False;
            text_units_local := split_text_units(Trim(text_value));
            if Length(text_units_local) <> 2 then
            begin
                Exit;
            end;

            parser_local := TncPinyinParser.Create;
            try
                if not try_split_relaxed_missing_apostrophe_token(parser_local,
                    prefix_key_value, left_text_local, right_text_local) then
                begin
                    Exit;
                end;
            finally
                parser_local.Free;
            end;

            Result := match_single_char_candidate_for_syllable(left_text_local,
                text_units_local[0], is_preferred_local) and
                match_single_char_candidate_for_syllable(right_text_local,
                text_units_local[1], is_preferred_local);
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;
        cache_key := '#exactleadingprefix#' + normalized_query;
        if (m_build_lookup_cache <> nil) and
            m_build_lookup_cache.TryGetValue(cache_key, cached_candidates) then
        begin
            out_candidates := Copy(cached_candidates, 0, Length(cached_candidates));
            Exit(Length(out_candidates) > 0);
        end;

        if not get_prefix_partial_syllables_for_query(query_text,
            syllables_local) then
        begin
            Exit;
        end;
        if Length(syllables_local) < 2 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            for prefix_count := Min(c_prefix_max_syllables,
                Length(syllables_local) - 1) downto 1 do
            begin
                // Reserve the bounded candidate pool for reliable phrase prefixes
                // before the usually much larger first-syllable character list.
                prefix_key := '';
                for tail_idx := 0 to prefix_count - 1 do
                begin
                    prefix_key := prefix_key +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if prefix_key = '' then
                begin
                    Continue;
                end;

                tail_comment := '';
                for tail_idx := prefix_count to High(syllables_local) do
                begin
                    tail_comment := tail_comment +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if tail_comment = '' then
                begin
                    Continue;
                end;

                if not dictionary_exact_lookup_cached(prefix_key,
                    head_results) then
                begin
                    if (m_dictionary is TncSqliteDictionary) or
                        (not dictionary_lookup_cached(prefix_key,
                        head_results)) then
                    begin
                        Continue;
                    end;
                end;
                normalized_learning := normalize_learned_prefix_exact_scores(
                    prefix_key, head_results);
                prefix_lookup_results := head_results;

                if prefix_count = 1 then
                begin
                    accepted_limit := c_prefix_single_limit;
                end
                else
                begin
                    accepted_limit := c_prefix_phrase_limit;
                end;

                accepted_for_prefix := 0;
                for result_idx := 0 to High(head_results) do
                begin
                    if (accepted_total >= c_prefix_total_limit) or
                        (accepted_for_prefix >= accepted_limit) then
                    begin
                        Break;
                    end;
                    if Trim(head_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(head_results[result_idx].text);
                    if candidate_text = '' then
                    begin
                        Continue;
                    end;

                    candidate_units := get_candidate_text_unit_count(candidate_text);
                    effective_prefix_units := prefix_count;
                    if prefix_count = 1 then
                    begin
                        if candidate_units <> 1 then
                        begin
                            if (tail_comment = '') or (candidate_units <> 2) or
                                (not compact_prefix_matches_two_unit_candidate_local(
                                prefix_key, candidate_text)) then
                            begin
                                Continue;
                            end;
                            effective_prefix_units := candidate_units;
                        end;
                    end
                    else if candidate_units < 2 then
                    begin
                        Continue;
                    end;
                    if not explicit_prefix_lookup_entry_local(candidate_text) then
                    begin
                        Continue;
                    end;

                    seen_key := candidate_text + #9 + tail_comment;
                    if seen.ContainsKey(seen_key) then
                    begin
                        Continue;
                    end;

                    candidate := head_results[result_idx];
                    candidate.comment := tail_comment;
                    base_score := candidate.score;
                    if candidate.has_dict_weight and
                        (candidate.dict_weight > base_score) then
                    begin
                        base_score := candidate.dict_weight;
                    end;
                    for lookup_idx := 0 to High(prefix_lookup_results) do
                    begin
                        if Trim(prefix_lookup_results[lookup_idx].comment) <> '' then
                        begin
                            Continue;
                        end;
                        lookup_text := Trim(prefix_lookup_results[lookup_idx].text);
                        if SameText(lookup_text, candidate_text) then
                        begin
                            base_score := prefix_lookup_results[lookup_idx].score;
                            if prefix_lookup_results[lookup_idx].has_dict_weight and
                                (prefix_lookup_results[lookup_idx].dict_weight >
                                base_score) then
                            begin
                                base_score :=
                                    prefix_lookup_results[lookup_idx].dict_weight;
                            end;
                            if lookup_idx = 0 then
                            begin
                                Inc(base_score, 720);
                            end;
                            Break;
                        end;
                    end;
                    candidate.score := base_score + c_prefix_base_bonus +
                        (effective_prefix_units * c_prefix_bonus_per_syllable);
                    if effective_prefix_units >= 2 then
                    begin
                        Inc(candidate.score, c_prefix_phrase_extra_bonus);
                        if Length(syllables_local) <= 4 then
                        begin
                            Inc(candidate.score, c_prefix_short_query_phrase_bonus);
                        end;
                    end;
                    Dec(candidate.score, (Length(syllables_local) - prefix_count) *
                        c_prefix_remaining_penalty);
                    // Keep legacy retrieval features for unlearned groups;
                    // learned groups carry only the raw weight, not recency.
                    if (not normalized_learning) or (not candidate.has_dict_weight) then
                    begin
                        candidate.dict_weight := base_score;
                        candidate.has_dict_weight := True;
                    end;

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate;
                    seen.AddOrSetValue(seen_key, 1);
                    Inc(accepted_total);
                    Inc(accepted_for_prefix);
                end;
            end;
        finally
            seen.Free;
        end;

        if build_lexicon_longer_prefix_candidates(query_text,
            longer_prefix_candidates) then
        begin
            out_candidates := merge_candidate_lists(out_candidates,
                longer_prefix_candidates, 0);
        end;
        sort_candidates_lightweight(out_candidates);
        if m_build_lookup_cache <> nil then
        begin
            m_build_lookup_cache.AddOrSetValue(cache_key,
                Copy(out_candidates, 0, Length(out_candidates)));
        end;
        Result := Length(out_candidates) > 0;
    end;

    function build_fuzzy_short_query_recall_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_total_limit = 40;
        c_full_limit = 16;
        c_single_prefix_limit = 16;
        c_phrase_prefix_limit = 8;
        c_prefix_base_bonus = 220;
        c_prefix_bonus_per_syllable = 180;
        c_prefix_phrase_extra_bonus = 520;
        c_prefix_short_query_phrase_bonus = 260;
        c_prefix_remaining_penalty = 42;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        fuzzy_results: TncCandidateList;
        seen: TDictionary<string, Byte>;
        prefix_count: Integer;
        syllable_idx: Integer;
        candidate_idx: Integer;
        accepted_for_prefix: Integer;
        accepted_limit: Integer;
        prefix_key: string;
        tail_comment: string;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        seen_key: string;

        procedure append_candidate_local(const candidate_value: TncCandidate;
            const comment_value: string; const expected_text_units: Integer;
            const add_prefix_score: Boolean);
        var
            local_candidate: TncCandidate;
            local_text: string;
            local_key: string;
        begin
            if Length(out_candidates) >= c_total_limit then
            begin
                Exit;
            end;

            local_candidate := candidate_value;
            local_text := Trim(local_candidate.text);
            if (local_text = '') or (Trim(local_candidate.comment) <> '') or
                (local_candidate.fuzzy_cost <= 0) or
                (get_candidate_text_unit_count(local_text) <>
                expected_text_units) then
            begin
                Exit;
            end;

            local_candidate.text := local_text;
            local_candidate.comment := comment_value;
            if add_prefix_score then
            begin
                Inc(local_candidate.score, c_prefix_base_bonus +
                    (expected_text_units * c_prefix_bonus_per_syllable));
                if expected_text_units >= 2 then
                begin
                    Inc(local_candidate.score, c_prefix_phrase_extra_bonus +
                        c_prefix_short_query_phrase_bonus);
                end;
                Dec(local_candidate.score,
                    (Length(syllables_local) - expected_text_units) *
                    c_prefix_remaining_penalty);
            end;

            local_key := LowerCase(local_text) + #1 +
                LowerCase(Trim(comment_value));
            if seen.ContainsKey(local_key) then
            begin
                Exit;
            end;

            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := local_candidate;
            seen.Add(local_key, 1);
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if (m_dictionary = nil) or (not is_fuzzy_pinyin_active) then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if (normalized_query = '') or
            (not get_prefix_partial_syllables_for_query(query_text,
            syllables_local)) or (Length(syllables_local) < 2) or
            (Length(syllables_local) > 4) then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            if m_dictionary.lookup_fuzzy_full_pinyin_bounded(normalized_query,
                fuzzy_results, 1, 6, 4, c_full_limit) then
            begin
                for candidate_idx := 0 to High(fuzzy_results) do
                begin
                    append_candidate_local(fuzzy_results[candidate_idx], '',
                        Length(syllables_local), False);
                end;
            end;

            { Explicit apostrophes carry authoritative syllable boundaries.
              The full fuzzy exact lookup above preserves them; do not rebuild
              prefix keys without those separators. }
            if Pos('''', normalized_query) = 0 then
            begin
                for prefix_count := Length(syllables_local) - 1 downto 1 do
                begin
                    prefix_key := '';
                    for syllable_idx := 0 to prefix_count - 1 do
                    begin
                        prefix_key := prefix_key + normalize_pinyin_text(
                            syllables_local[syllable_idx].text);
                    end;
                    tail_comment := '';
                    for syllable_idx := prefix_count to High(syllables_local) do
                    begin
                        tail_comment := tail_comment + normalize_pinyin_text(
                            syllables_local[syllable_idx].text);
                    end;
                    if (prefix_key = '') or (tail_comment = '') or
                        (not m_dictionary.lookup_fuzzy_full_pinyin_bounded(
                        prefix_key, fuzzy_results, 1, 6, 4,
                        c_single_prefix_limit)) then
                    begin
                        Continue;
                    end;

                    if prefix_count = 1 then
                    begin
                        accepted_limit := c_single_prefix_limit;
                    end
                    else
                    begin
                        accepted_limit := c_phrase_prefix_limit;
                    end;
                    accepted_for_prefix := 0;
                    for candidate_idx := 0 to High(fuzzy_results) do
                    begin
                        if (Length(out_candidates) >= c_total_limit) or
                            (accepted_for_prefix >= accepted_limit) then
                        begin
                            Break;
                        end;
                        candidate := fuzzy_results[candidate_idx];
                        candidate_text := Trim(candidate.text);
                        candidate_units := get_candidate_text_unit_count(
                            candidate_text);
                        seen_key := LowerCase(candidate_text) + #1 +
                            LowerCase(tail_comment);
                        if (candidate_text = '') or
                            (candidate_units <> prefix_count) or
                            seen.ContainsKey(seen_key) then
                        begin
                            Continue;
                        end;
                        append_candidate_local(candidate, tail_comment,
                            prefix_count, True);
                        Inc(accepted_for_prefix);
                    end;
                end;
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_lookup_leading_prefix_partial_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_total_limit = 10;
        c_prefix_base_bonus = 180;
        c_prefix_bonus_per_syllable = 160;
        c_prefix_max_syllables = 6;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        prefix_count: Integer;
        tail_idx: Integer;
        result_idx: Integer;
        accepted_total: Integer;
        prefix_key: string;
        tail_comment: string;
        head_results: TncCandidateList;
        prefix_lookup_results: TncCandidateList;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        seen_key: string;
        seen: TDictionary<string, Byte>;

        function explicit_prefix_entry_local(const text_value: string): Boolean;
        var
            local_lookup_idx: Integer;
        begin
            Result := prefix_count < 2;
            if Result then
            begin
                Exit;
            end;

            for local_lookup_idx := 0 to High(prefix_lookup_results) do
            begin
                if (Trim(prefix_lookup_results[local_lookup_idx].comment) = '') and
                    SameText(Trim(prefix_lookup_results[local_lookup_idx].text),
                    text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        if not get_prefix_partial_syllables_for_query(query_text,
            syllables_local) then
        begin
            Exit;
        end;
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            for prefix_count := Min(c_prefix_max_syllables,
                Length(syllables_local) - 1) downto 2 do
            begin
                prefix_key := '';
                for tail_idx := 0 to prefix_count - 1 do
                begin
                    prefix_key := prefix_key +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if prefix_key = '' then
                begin
                    Continue;
                end;

                tail_comment := '';
                for tail_idx := prefix_count to High(syllables_local) do
                begin
                    tail_comment := tail_comment +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if tail_comment = '' then
                begin
                    Continue;
                end;

                if not dictionary_exact_lookup_cached(prefix_key, head_results) then
                begin
                    Continue;
                end;

                for result_idx := 0 to High(head_results) do
                begin
                    if accepted_total >= c_prefix_total_limit then
                    begin
                        Break;
                    end;
                    if Trim(head_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(head_results[result_idx].text);
                    candidate_units := get_candidate_text_unit_count(candidate_text);
                    if (candidate_text = '') or (candidate_units <> prefix_count) then
                    begin
                        Continue;
                    end;
                    if not explicit_prefix_entry_local(candidate_text) then
                    begin
                        Continue;
                    end;

                    seen_key := candidate_text + #9 + tail_comment;
                    if seen.ContainsKey(seen_key) then
                    begin
                        Continue;
                    end;

                    candidate := head_results[result_idx];
                    candidate.comment := tail_comment;
                    Inc(candidate.score, c_prefix_base_bonus +
                        (prefix_count * c_prefix_bonus_per_syllable));
                    if candidate.dict_weight <= 0 then
                    begin
                        candidate.dict_weight := candidate.score;
                    end;
                    candidate.has_dict_weight := True;

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate;
                    seen.AddOrSetValue(seen_key, 1);
                    Inc(accepted_total);
                end;
            end;
        finally
            seen.Free;
        end;
        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_short_particle_prefix_partial_candidates_local(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    var
        normalized_query: string;
        parser: TncPinyinParser;
        syllables_local: TncPinyinParseResult;
        prefix_query: string;
        tail_comment: string;
        prefix_idx: Integer;
        candidate_idx: Integer;
        particle_candidates: TncCandidateList;
        candidate: TncCandidate;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        normalized_query := normalize_pinyin_text(query_text);
        if (normalized_query = '') or (not is_full_pinyin_key(normalized_query)) then
        begin
            Exit;
        end;

        parser := TncPinyinParser.Create;
        try
            syllables_local := parser.parse(normalized_query);
        finally
            parser.Free;
        end;
        if Length(syllables_local) <> 4 then
        begin
            Exit;
        end;

        prefix_query := '';
        for prefix_idx := 0 to High(syllables_local) - 1 do
        begin
            prefix_query := prefix_query + normalize_pinyin_text(
                syllables_local[prefix_idx].text);
        end;
        tail_comment := normalize_pinyin_text(
            syllables_local[High(syllables_local)].text);
        if (prefix_query = '') or (tail_comment = '') or
            (not build_short_particle_tail_dictionary_candidates(prefix_query,
            particle_candidates)) then
        begin
            Exit;
        end;

        for candidate_idx := 0 to High(particle_candidates) do
        begin
            candidate := particle_candidates[candidate_idx];
            if (Trim(candidate.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate.text)) <> 3) then
            begin
                Continue;
            end;
            candidate.comment := tail_comment;
            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate;
        end;
        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    procedure apply_selected_prefix_single_context_lm_local(
        var candidates: TncCandidateList);
    const
        c_max_context_candidates = 16;
        c_min_lm_lead = 1800;
        c_max_lexical_gap = 900;
        c_promotion_margin = 96;
        c_max_promotion_bonus = 1200;
    var
        context_value: string;
        normalized_query: string;
        latest_choice_text: string;
        candidate_texts: TArray<string>;
        candidate_indices: TArray<Integer>;
        lm_scores: TArray<Integer>;
        seen_texts: TDictionary<string, Byte>;
        idx: Integer;
        collected_idx: Integer;
        baseline_idx: Integer;
        best_idx: Integer;
        baseline_candidate_idx: Integer;
        best_candidate_idx: Integer;
        baseline_rank: Integer;
        best_rank: Integer;
        lexical_gap: Integer;
        lm_lead: Integer;
        promotion_bonus: Integer;
        candidate_text: string;

        function effective_candidate_rank_local(
            const candidate_value: TncCandidate): Integer;
        begin
            Result := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;
        end;
    begin
        // Standalone one-syllable input keeps the established lexical order.
        // Context is applied only to the remaining syllable after a partial
        // candidate was confirmed in the same composition.
        context_value := Trim(m_segment_left_context);
        normalized_query := normalize_pinyin_text(lookup_text);
        if (context_value = '') or (normalized_query = '') or
            (not is_full_pinyin_key(normalized_query)) or
            (m_dictionary = nil) or (Length(candidates) < 2) then
        begin
            Exit;
        end;

        seen_texts := TDictionary<string, Byte>.Create;
        try
            SetLength(candidate_texts, 0);
            SetLength(candidate_indices, 0);
            for idx := 0 to High(candidates) do
            begin
                if Length(candidate_texts) >= c_max_context_candidates then
                begin
                    Break;
                end;
                candidate_text := Trim(candidates[idx].text);
                if (Trim(candidates[idx].comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text) <> 1) or
                    (candidate_text = '') or seen_texts.ContainsKey(candidate_text) then
                begin
                    Continue;
                end;

                // Explicit query learning remains stronger than contextual LM.
                latest_choice_text := get_cached_query_latest_choice_text(
                    normalized_query);
                if (candidates[idx].source = cs_user) or
                    is_latest_session_query_choice(candidate_text) or
                    ((latest_choice_text <> '') and
                    SameText(latest_choice_text, candidate_text)) or
                    (m_dictionary.get_query_choice_bonus(normalized_query,
                    candidate_text) > 0) then
                begin
                    Exit;
                end;

                seen_texts.Add(candidate_text, 1);
                collected_idx := Length(candidate_texts);
                SetLength(candidate_texts, collected_idx + 1);
                SetLength(candidate_indices, collected_idx + 1);
                candidate_texts[collected_idx] := candidate_text;
                candidate_indices[collected_idx] := idx;
            end;
        finally
            seen_texts.Free;
        end;

        if (Length(candidate_texts) < 2) or
            (not get_cached_char_lm_scores(candidate_texts, lm_scores,
            clsm_context, context_value)) or
            (Length(lm_scores) <> Length(candidate_texts)) then
        begin
            Exit;
        end;

        baseline_idx := 0;
        best_idx := baseline_idx;
        for idx := 1 to High(candidate_texts) do
        begin
            if lm_scores[idx] > lm_scores[best_idx] then
            begin
                best_idx := idx;
            end;
        end;
        if best_idx = baseline_idx then
        begin
            Exit;
        end;

        lm_lead := lm_scores[best_idx] - lm_scores[baseline_idx];
        baseline_candidate_idx := candidate_indices[baseline_idx];
        best_candidate_idx := candidate_indices[best_idx];
        baseline_rank := effective_candidate_rank_local(
            candidates[baseline_candidate_idx]);
        best_rank := effective_candidate_rank_local(candidates[best_candidate_idx]);
        lexical_gap := baseline_rank - best_rank;
        if lexical_gap < 0 then
        begin
            lexical_gap := 0;
        end;
        if (lm_lead < c_min_lm_lead) or
            (lexical_gap > c_max_lexical_gap) then
        begin
            Exit;
        end;

        promotion_bonus := lexical_gap + c_promotion_margin;
        if promotion_bonus > c_max_promotion_bonus then
        begin
            promotion_bonus := c_max_promotion_bonus;
        end;
        Inc(candidates[best_candidate_idx].score, promotion_bonus);
        sort_candidates_lightweight(candidates);
        if m_config.debug_mode then
        begin
            if m_last_lookup_debug_extra <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
            end;
            m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                Format('singlectx=%s:%d', [candidate_texts[best_idx], lm_lead]);
        end;
    end;

    function build_short_pinyin_prefix_completion_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_completion_visible_bonus = 620;
        c_prefix_completion_limit = 8;
    var
        normalized_query: string;
        prefix_results: TncCandidateList;
        syllables_local: TncPinyinParseResult;
        query_units: Integer;
        result_idx: Integer;
        accepted_count: Integer;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        base_score: Integer;

        function prefix_completion_alignment_allowed_local(
            const text_value: string): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            syllable_key_local: string;

            function raw_query_alignment_allowed_local: Boolean;
                function match_from_local(const unit_index: Integer;
                    const query_pos: Integer): Boolean;
                var
                    end_pos_local: Integer;
                    max_end_local: Integer;
                    remaining_units_local: Integer;
                    segment_key_local: string;
                begin
                    Result := False;
                    if unit_index = query_units - 1 then
                    begin
                        Result := query_pos <= Length(normalized_query);
                        Exit;
                    end;

                    remaining_units_local := query_units - unit_index - 1;
                    max_end_local := Length(normalized_query) - remaining_units_local;
                    for end_pos_local := query_pos to max_end_local do
                    begin
                        segment_key_local := Copy(normalized_query, query_pos,
                            end_pos_local - query_pos + 1);
                        if (segment_key_local <> '') and
                            is_full_pinyin_key(segment_key_local) and
                            m_dictionary.single_char_matches_pinyin(
                            segment_key_local, text_units_local[unit_index]) and
                            match_from_local(unit_index + 1, end_pos_local + 1) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            begin
                // The raw parser may split a multi-letter initial across units:
                // "rich" can become "ric/h" even though the intended alignment is
                // "ri/ch". Earlier units must still be full-pinyin exact matches;
                // only the final unit may remain a prefix.
                Result := match_from_local(0, 1);
            end;
        begin
            Result := False;
            text_units_local := split_text_units(text_value);
            if Length(text_units_local) <> query_units then
            begin
                Exit;
            end;

            if Length(syllables_local) = query_units then
            begin
                // Predictive prefix completion may abbreviate only the final
                // syllable.  Earlier syllables must already match exactly;
                // otherwise "zheji + geci" can incorrectly become
                // "zhejiang + geci".
                for unit_idx_local := 0 to query_units - 2 do
                begin
                    syllable_key_local := normalize_pinyin_text(
                        syllables_local[unit_idx_local].text);
                    if (syllable_key_local = '') or
                        (not m_dictionary.single_char_matches_pinyin(
                        syllable_key_local, text_units_local[unit_idx_local])) then
                    begin
                        Exit(raw_query_alignment_allowed_local);
                    end;
                end;

                Exit(True);
            end;

            Result := raw_query_alignment_allowed_local;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        query_units := input_syllable_count;
        if query_units <= 0 then
        begin
            query_units := get_effective_compact_pinyin_unit_count(normalized_query);
        end;
        if (query_units < 2) or (query_units > 4) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            normalized_query);
        if Length(syllables_local) <> query_units then
        begin
            Exit;
        end;

        if not dictionary_prefix_lookup_cached(normalized_query, prefix_results) then
        begin
            Exit;
        end;

        accepted_count := 0;
        for result_idx := 0 to High(prefix_results) do
        begin
            if accepted_count >= c_prefix_completion_limit then
            begin
                Break;
            end;

            if Trim(prefix_results[result_idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text := Trim(prefix_results[result_idx].text);
            candidate_units := get_candidate_text_unit_count(candidate_text);
            if (candidate_text = '') or (candidate_units <> query_units) then
            begin
                Continue;
            end;
            if not prefix_completion_alignment_allowed_local(candidate_text) then
            begin
                Continue;
            end;

            candidate := prefix_results[result_idx];
            base_score := candidate.score;
            if candidate.has_dict_weight and (candidate.dict_weight > base_score) then
            begin
                base_score := candidate.dict_weight;
            end;
            candidate.score := base_score + c_prefix_completion_visible_bonus;
            if candidate.dict_weight <= 0 then
            begin
                candidate.dict_weight := base_score;
            end;
            candidate.has_dict_weight := True;

            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate;
            Inc(accepted_count);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_fixed_wo_tail_dictionary_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_tail_probe_limit = 8;
        c_fixed_wo_tail_base_bonus = 6400;
        c_fixed_wo_tail_unit_bonus = 920;
    var
        head_pinyin: string;
        head_text: string;
        normalized_query: string;
        tail_key: string;
        tail_units: Integer;
        tail_results: TncCandidateList;
        seen: TDictionary<string, Byte>;
        accepted_before: Integer;
        exact_accepted: Boolean;

        procedure append_tail_candidates_local(const candidates: TncCandidateList);
        var
            local_idx: Integer;
            candidate: TncCandidate;
            tail_text: string;
            tail_text_units: Integer;
            tail_score: Integer;
            seen_key: string;
        begin
            for local_idx := 0 to High(candidates) do
            begin
                if local_idx >= c_tail_probe_limit then
                begin
                    Break;
                end;
                if Trim(candidates[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(candidates[local_idx]) or
                    is_runtime_common_pattern_candidate(candidates[local_idx]) or
                    is_runtime_redup_candidate(candidates[local_idx]) then
                begin
                    Continue;
                end;

                tail_text := Trim(candidates[local_idx].text);
                tail_text_units := get_candidate_text_unit_count(tail_text);
                if (tail_text = '') or (tail_text_units < 2) or
                    (tail_text_units > 3) then
                begin
                    Continue;
                end;
                if (not m_dictionary.is_base_entry(tail_key, tail_text)) and
                    (not m_dictionary.is_user_entry(tail_key, tail_text)) then
                begin
                    Continue;
                end;

                seen_key := tail_text;
                if seen.ContainsKey(seen_key) then
                begin
                    Continue;
                end;

                tail_score := candidates[local_idx].score;
                if candidates[local_idx].has_dict_weight then
                begin
                    tail_score := candidates[local_idx].dict_weight;
                end;
                if candidates[local_idx].source = cs_user then
                begin
                    Inc(tail_score, c_user_score_bonus);
                end;

                FillChar(candidate, SizeOf(candidate), 0);
                candidate.text := head_text + tail_text;
                candidate.comment := '';
                candidate.source := cs_rule;
                candidate.score := tail_score + c_fixed_wo_tail_base_bonus +
                    (tail_text_units * c_fixed_wo_tail_unit_bonus);
                candidate.has_dict_weight := True;
                candidate.dict_weight := candidate.score;
                remember_segment_path_for_candidate(candidate.text, '',
                    head_text + c_segment_path_separator + tail_text,
                    candidate.score);

                SetLength(out_candidates, Length(out_candidates) + 1);
                out_candidates[High(out_candidates)] := candidate;
                seen.AddOrSetValue(seen_key, 1);
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        if not try_get_fixed_pronoun_tail_query_parts(normalized_query,
            input_syllable_count, head_pinyin, head_text, tail_key,
            tail_units) then
        begin
            Exit;
        end;

        if tail_key = '' then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            exact_accepted := False;
            if dictionary_exact_lookup_cached(tail_key, tail_results) then
            begin
                accepted_before := Length(out_candidates);
                append_tail_candidates_local(tail_results);
                exact_accepted := Length(out_candidates) > accepted_before;
            end;
            if (not (exact_accepted and is_full_pinyin_key(tail_key))) and
                dictionary_lookup_cached(tail_key, tail_results) then
            begin
                append_tail_candidates_local(tail_results);
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_short_particle_tail_dictionary_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_head_probe_limit = 8;
        c_particle_tail_min_head_score = 80;
        c_particle_tail_visible_bonus = 160;
        c_particle_tail_unit_bonus = 24;
        c_particle_tail_weak_bonus = 8;
    var
        normalized_query: string;
        head_units: Integer;
        head_key: string;
        tail_key: string;
        tail_text: string;
        head_results: TncCandidateList;
        seen: TDictionary<string, Byte>;

        function text_ends_with_tail_particle_local(
            const text_value: string; const tail_text_value: string): Boolean;
        var
            trimmed_text_local: string;
            last_char_local: string;
        begin
            Result := False;
            trimmed_text_local := Trim(text_value);
            if (trimmed_text_local = '') or (tail_text_value = '') then
            begin
                Exit;
            end;
            last_char_local := Copy(trimmed_text_local,
                Length(trimmed_text_local), 1);
            Result := SameText(last_char_local, tail_text_value);
        end;

        function has_full_query_exact_candidate_local: Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_units_local: Integer;
        begin
            Result := False;
            if not dictionary_exact_lookup_cached(normalized_query,
                exact_results_local) then
            begin
                Exit;
            end;
            exact_units_local := Length(get_effective_compact_pinyin_syllables(
                normalized_query));
            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    (Trim(exact_results_local[exact_idx_local].text) <> '') and
                    (get_candidate_text_unit_count(
                    Trim(exact_results_local[exact_idx_local].text)) =
                    exact_units_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function derived_particle_tail_score_local(
            const base_score: Integer): Integer;
        begin
            Result := base_score;
            if Result < 0 then
            begin
                Result := 0;
            end;
            if Result < c_particle_tail_min_head_score then
            begin
                Inc(Result, c_particle_tail_weak_bonus);
                Exit;
            end;

            Inc(Result, c_particle_tail_visible_bonus +
                (head_units * c_particle_tail_unit_bonus));
        end;

        procedure append_head_candidates_local(const candidates: TncCandidateList);
        var
            local_idx: Integer;
            candidate: TncCandidate;
            head_text: string;
            head_score: Integer;
            head_dict_weight: Integer;
            seen_key: string;
        begin
            for local_idx := 0 to High(candidates) do
            begin
                if local_idx >= c_head_probe_limit then
                begin
                    Break;
                end;
                if Trim(candidates[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(candidates[local_idx]) or
                    is_runtime_common_pattern_candidate(candidates[local_idx]) or
                    is_runtime_redup_candidate(candidates[local_idx]) then
                begin
                    Continue;
                end;

                head_text := Trim(candidates[local_idx].text);
                if (head_text = '') or
                    (get_candidate_text_unit_count(head_text) <> head_units) then
                begin
                    Continue;
                end;
                if text_ends_with_tail_particle_local(head_text, tail_text) then
                begin
                    Continue;
                end;

                seen_key := head_text + tail_text;
                if seen.ContainsKey(seen_key) then
                begin
                    Continue;
                end;

                head_score := candidates[local_idx].score;
                head_dict_weight := head_score;
                if candidates[local_idx].has_dict_weight and
                    (candidates[local_idx].dict_weight > head_score) then
                begin
                    head_score := candidates[local_idx].dict_weight;
                    head_dict_weight := candidates[local_idx].dict_weight;
                end;
                if candidates[local_idx].source = cs_user then
                begin
                    Inc(head_score, c_user_score_bonus);
                end;

                FillChar(candidate, SizeOf(candidate), 0);
                candidate.text := head_text + tail_text;
                candidate.comment := '';
                candidate.source := cs_rule;
                candidate.score :=
                    derived_particle_tail_score_local(head_score);
                candidate.has_dict_weight := True;
                candidate.dict_weight := head_dict_weight;

                SetLength(out_candidates, Length(out_candidates) + 1);
                out_candidates[High(out_candidates)] := candidate;
                seen.AddOrSetValue(seen_key, 1);
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        if not try_get_short_particle_tail_query_parts(normalized_query,
            tail_key, tail_text, head_key) then
        begin
            Exit;
        end;
        if head_key = '' then
        begin
            Exit;
        end;
        if has_full_query_exact_candidate_local and
            (not SameText(tail_key, 'a')) then
        begin
            Exit;
        end;

        head_units := get_effective_compact_pinyin_unit_count(head_key);
        if (head_units < 2) or (head_units > 3) then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            if dictionary_exact_lookup_cached(head_key, head_results) then
            begin
                append_head_candidates_local(head_results);
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_short_particle_tail_from_prefix_partials_fast_local(
        const query_text: string; const prefix_candidates: TncCandidateList;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_particle_tail_min_head_score = 80;
        c_particle_tail_visible_bonus = 160;
        c_particle_tail_unit_bonus = 24;
        c_particle_tail_weak_bonus = 8;
    var
        normalized_query: string;
        head_key: string;
        tail_key: string;
        tail_text: string;
        expected_head_units: Integer;
        idx: Integer;
        head_text: string;
        candidate: TncCandidate;
        base_weight: Integer;
        seen: TDictionary<string, Byte>;
        seen_key: string;

        function derived_particle_tail_score_local(const base_score: Integer;
            const unit_count: Integer): Integer;
        begin
            Result := base_score;
            if Result < 0 then
            begin
                Result := 0;
            end;
            if Result < c_particle_tail_min_head_score then
            begin
                Inc(Result, c_particle_tail_weak_bonus);
                Exit;
            end;

            Inc(Result, c_particle_tail_visible_bonus +
                (unit_count * c_particle_tail_unit_bonus));
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;

        normalized_query := normalize_pinyin_text(query_text);
        if not try_get_short_particle_tail_query_parts(normalized_query,
            tail_key, tail_text, head_key) then
        begin
            Exit;
        end;

        expected_head_units := get_effective_compact_pinyin_unit_count(
            head_key);
        if expected_head_units < 2 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            for idx := 0 to High(prefix_candidates) do
            begin
                if not SameText(normalize_pinyin_text(
                    Trim(prefix_candidates[idx].comment)), tail_key) then
                begin
                    Continue;
                end;

                head_text := Trim(prefix_candidates[idx].text);
                if (head_text = '') or
                    (get_candidate_text_unit_count(head_text) <>
                    expected_head_units) or
                    SameText(Copy(head_text, Length(head_text), 1),
                    tail_text) then
                begin
                    Continue;
                end;

                seen_key := head_text + tail_text;
                if seen.ContainsKey(seen_key) then
                begin
                    Continue;
                end;

                candidate := prefix_candidates[idx];
                base_weight := candidate.score;
                if candidate.has_dict_weight and (candidate.dict_weight > 0) then
                begin
                    base_weight := candidate.dict_weight;
                end;
                candidate.text := head_text + tail_text;
                candidate.comment := '';
                candidate.source := cs_rule;
                candidate.score := derived_particle_tail_score_local(
                    base_weight, expected_head_units);
                candidate.has_dict_weight := True;
                candidate.dict_weight := base_weight;

                SetLength(out_candidates, Length(out_candidates) + 1);
                out_candidates[High(out_candidates)] := candidate;
                seen.AddOrSetValue(seen_key, 1);
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    procedure suppress_non_fixed_wo_single_head_partials_local(
        var candidates: TncCandidateList);
    var
        has_fixed_wo_tail_candidate: Boolean;
        head_pinyin: string;
        head_text: string;
        tail_key: string;
        tail_units: Integer;
        idx: Integer;
        out_idx: Integer;
        candidate_text: string;
        candidate_units: TArray<string>;

        function is_exact_multi_char_prefix_local(const text_value: string;
            const unit_count: Integer): Boolean;
        var
            syllables_local: TncPinyinParseResult;
            prefix_key_local: string;
            syllable_idx_local: Integer;
            exact_candidates_local: TncCandidateList;
            exact_idx_local: Integer;
        begin
            Result := False;
            if (m_dictionary = nil) or (unit_count < 2) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            if Length(syllables_local) < unit_count then
            begin
                Exit;
            end;

            prefix_key_local := '';
            for syllable_idx_local := 0 to unit_count - 1 do
            begin
                prefix_key_local := prefix_key_local + normalize_pinyin_text(
                    syllables_local[syllable_idx_local].text);
            end;
            if prefix_key_local = '' then
            begin
                Exit;
            end;

            if not dictionary_exact_lookup_cached(prefix_key_local,
                exact_candidates_local) then
            begin
                Exit;
            end;
            for exact_idx_local := 0 to High(exact_candidates_local) do
            begin
                if (Trim(exact_candidates_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_candidates_local[exact_idx_local].text),
                    text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (Length(candidates) = 0) or
            (not try_get_fixed_pronoun_tail_query_parts(lookup_text,
            input_syllable_count, head_pinyin, head_text, tail_key,
            tail_units)) then
        begin
            Exit;
        end;

        has_fixed_wo_tail_candidate := False;
        for idx := 0 to High(candidates) do
        begin
            candidate_text := Trim(candidates[idx].text);
            if (Trim(candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text) >= 2) and
                (Copy(candidate_text, 1, 1) = head_text) then
            begin
                has_fixed_wo_tail_candidate := True;
                Break;
            end;
        end;
        if not has_fixed_wo_tail_candidate then
        begin
            Exit;
        end;

        out_idx := 0;
        for idx := 0 to High(candidates) do
        begin
            candidate_text := Trim(candidates[idx].text);
            candidate_units := split_text_units(candidate_text);
            if (Trim(candidates[idx].comment) <> '') and
                (Length(candidate_units) >= 2) and
                (Trim(candidate_units[0]) <> head_text) and
                (m_dictionary <> nil) and
                m_dictionary.single_char_matches_pinyin(head_pinyin,
                Trim(candidate_units[0])) and
                (not is_exact_multi_char_prefix_local(candidate_text,
                Length(candidate_units))) then
            begin
                Continue;
            end;

            if out_idx <> idx then
            begin
                candidates[out_idx] := candidates[idx];
            end;
            Inc(out_idx);
        end;
        if out_idx <> Length(candidates) then
        begin
            SetLength(candidates, out_idx);
        end;
    end;

    function build_long_exact_prefix_partial_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_suffix_window = 4;
        c_prefix_head_window_max = 6;
        c_prefix_total_limit = 12;
        c_prefix_per_probe_limit = 3;
        c_prefix_base_bonus = 920;
        c_prefix_bonus_per_syllable = 72;
        c_prefix_remaining_penalty = 26;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        prefix_count: Integer;
        accepted_total: Integer;
        seen: TDictionary<string, Byte>;

        procedure try_append_prefix_count(const local_prefix_count: Integer);
        var
            local_tail_idx: Integer;
            local_result_idx: Integer;
            local_prefix_key: string;
            local_tail_comment: string;
            local_head_results: TncCandidateList;
            local_candidate: TncCandidate;
            local_candidate_text: string;
            local_candidate_units: Integer;
            local_score_value: Integer;
            local_seen_key: string;
            local_accepted_for_prefix: Integer;
        begin
            if (local_prefix_count < 4) or
                (local_prefix_count >= Length(syllables_local)) then
            begin
                Exit;
            end;

            local_prefix_key := '';
            for local_tail_idx := 0 to local_prefix_count - 1 do
            begin
                local_prefix_key := local_prefix_key +
                    normalize_pinyin_text(syllables_local[local_tail_idx].text);
            end;
            if local_prefix_key = '' then
            begin
                Exit;
            end;

            local_tail_comment := '';
            for local_tail_idx := local_prefix_count to High(syllables_local) do
            begin
                local_tail_comment := local_tail_comment +
                    normalize_pinyin_text(syllables_local[local_tail_idx].text);
            end;
            if local_tail_comment = '' then
            begin
                Exit;
            end;

            if not dictionary_exact_lookup_cached(local_prefix_key, local_head_results) then
            begin
                Exit;
            end;

            local_accepted_for_prefix := 0;
            for local_result_idx := 0 to High(local_head_results) do
            begin
                if (accepted_total >= c_prefix_total_limit) or
                    (local_accepted_for_prefix >= c_prefix_per_probe_limit) then
                begin
                    Break;
                end;
                if Trim(local_head_results[local_result_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(local_head_results[local_result_idx]) or
                    is_runtime_common_pattern_candidate(local_head_results[local_result_idx]) or
                    is_runtime_redup_candidate(local_head_results[local_result_idx]) then
                begin
                    Continue;
                end;

                local_candidate_text := Trim(local_head_results[local_result_idx].text);
                if local_candidate_text = '' then
                begin
                    Continue;
                end;

                local_candidate_units := get_candidate_text_unit_count(local_candidate_text);
                if local_candidate_units <> local_prefix_count then
                begin
                    Continue;
                end;

                local_seen_key := local_candidate_text + #9 + local_tail_comment;
                if seen.ContainsKey(local_seen_key) then
                begin
                    Continue;
                end;

                local_candidate := local_head_results[local_result_idx];
                local_candidate.comment := local_tail_comment;
                local_score_value := local_candidate.score;
                if local_candidate.has_dict_weight and
                    (local_candidate.dict_weight > local_score_value) then
                begin
                    local_score_value := local_candidate.dict_weight;
                end;
                local_candidate.score := local_score_value + c_prefix_base_bonus +
                    (local_prefix_count * c_prefix_bonus_per_syllable) -
                    ((Length(syllables_local) - local_prefix_count) *
                    c_prefix_remaining_penalty);
                local_candidate.dict_weight := local_score_value;
                local_candidate.has_dict_weight := True;

                SetLength(out_candidates, Length(out_candidates) + 1);
                out_candidates[High(out_candidates)] := local_candidate;
                seen.AddOrSetValue(local_seen_key, 1);
                Inc(accepted_total);
                Inc(local_accepted_for_prefix);
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if (normalized_query = '') or (not is_full_pinyin_key(normalized_query)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(normalized_query);
        if Length(syllables_local) < 6 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            for prefix_count := Length(syllables_local) - 1 downto
                Max(4, Length(syllables_local) - c_prefix_suffix_window) do
            begin
                try_append_prefix_count(prefix_count);
            end;

            for prefix_count := Min(c_prefix_head_window_max,
                Length(syllables_local) - 2) downto 4 do
            begin
                if prefix_count >= Max(4, Length(syllables_local) - c_prefix_suffix_window) then
                begin
                    Continue;
                end;
                try_append_prefix_count(prefix_count);
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_raw_leading_prefix_partial_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_total_limit = c_candidate_total_limit_max;
        c_prefix_single_limit = c_candidate_total_limit_max;
        c_prefix_phrase_limit = 4;
        // A four-syllable raw-prefix page can otherwise hide a valid low-weight
        // exact prefix behind dozens of first-syllable character pages.
        c_four_syllable_prefix_phrase_limit = 16;
        c_prefix_base_bonus = 220;
        c_prefix_bonus_per_syllable = 180;
        c_prefix_remaining_penalty = 42;
        c_prefix_max_syllables = 3;
        c_prefix_phrase_extra_bonus = 520;
        c_prefix_short_query_phrase_bonus = 260;
    var
        normalized_query: string;
        parser: TncPinyinParser;
        syllables_local: TncPinyinParseResult;
        prefix_count: Integer;
        tail_idx: Integer;
        result_idx: Integer;
        accepted_total: Integer;
        accepted_for_prefix: Integer;
        accepted_limit: Integer;
        prefix_key: string;
        tail_comment: string;
        head_results: TncCandidateList;
        prefix_lookup_results: TncCandidateList;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        seen_key: string;
        seen: TDictionary<string, Byte>;

        procedure append_alternative_pair_prefixes;
        var
            boundary, shift, split_pos, idx, tail_idx: Integer;
            head_key, tail_key: string;
            heads, tails: TncCandidateList;
            item: TncCandidate;
            tail_is_exact: Boolean;
        begin
            if (Length(syllables_local) <> 4) or is_shuangpin_input or
                (Pos('''', normalized_query) > 0) then Exit;
            boundary := Length(syllables_local[0].text) +
                Length(syllables_local[1].text);
            // Adjacent n/g boundaries can hide an exact word (xin/an vs xi/nan).
            // Recover prefixes only; this must not authorize a new 2+2 compound.
            for shift := -1 to 1 do
            begin
                if shift = 0 then Continue;
                split_pos := boundary + shift;
                if (split_pos < 2) or (split_pos >= Length(normalized_query)) then Continue;
                if not CharInSet(normalized_query[Min(boundary, split_pos) + 1],
                    ['n', 'g']) then Continue;
                head_key := Copy(normalized_query, 1, split_pos);
                tail_key := Copy(normalized_query, split_pos + 1, MaxInt);
                if (not is_full_pinyin_key(head_key)) or
                    (not is_full_pinyin_key(tail_key)) or
                    (Length(get_effective_compact_pinyin_syllables(head_key)) <> 2) or
                    (Length(get_effective_compact_pinyin_syllables(tail_key)) <> 2) then Continue;
                if not dictionary_exact_lookup_cached(tail_key, tails) then Continue;
                tail_is_exact := False;
                for tail_idx := 0 to High(tails) do
                    if (tails[tail_idx].comment = '') and
                        (get_candidate_text_unit_count(tails[tail_idx].text) = 2) then
                    begin
                        tail_is_exact := True;
                        Break;
                    end;
                if (not tail_is_exact) or
                    (not dictionary_exact_lookup_cached(head_key, heads)) then Continue;
                normalize_learned_prefix_exact_scores(head_key, heads);
                for idx := 0 to Min(High(heads), c_four_syllable_prefix_phrase_limit - 1) do
                begin
                    if accepted_total >= c_prefix_total_limit then Break;
                    item := heads[idx];
                    if (item.comment <> '') or
                        (get_candidate_text_unit_count(item.text) <> 2) then Continue;
                    if seen.ContainsKey(item.text + #9 + tail_key) then Continue;
                    item.comment := tail_key;
                    Inc(item.score, c_prefix_base_bonus + 2 * c_prefix_bonus_per_syllable +
                        c_prefix_phrase_extra_bonus + c_prefix_short_query_phrase_bonus -
                        2 * c_prefix_remaining_penalty);
                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := item;
                    seen.AddOrSetValue(item.text + #9 + tail_key, 1);
                    Inc(accepted_total);
                end;
            end;
        end;

        function is_single_initial_tail_comment_local(const value: string): Boolean;
        var
            normalized_value: string;
        begin
            normalized_value := normalize_pinyin_text(value);
            Result := (Length(normalized_value) = 1) and
                CharInSet(normalized_value[1],
                ['b', 'c', 'd', 'f', 'g', 'h', 'j', 'k', 'l', 'm', 'n',
                'p', 'q', 'r', 's', 't', 'w', 'x', 'y', 'z']);
        end;

        function explicit_prefix_entry_local(const text_value: string): Boolean;
        var
            local_lookup_idx: Integer;
        begin
            Result := prefix_count < 2;
            if Result then
            begin
                Exit;
            end;

            for local_lookup_idx := 0 to High(prefix_lookup_results) do
            begin
                if (Trim(prefix_lookup_results[local_lookup_idx].comment) = '') and
                    SameText(Trim(prefix_lookup_results[local_lookup_idx].text),
                    text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        parser := TncPinyinParser.Create;
        try
            syllables_local := parser.parse(normalized_query);
        finally
            parser.Free;
        end;
        if Length(syllables_local) < 2 then
        begin
            Exit;
        end;

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            for prefix_count := Min(c_prefix_max_syllables,
                Length(syllables_local) - 1) downto 1 do
            begin
                if prefix_count = 1 then append_alternative_pair_prefixes;
                // Phrase prefixes must consume the bounded pool before the
                // much larger first-syllable character set.
                prefix_key := '';
                for tail_idx := 0 to prefix_count - 1 do
                begin
                    prefix_key := prefix_key +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if prefix_key = '' then
                begin
                    Continue;
                end;

                tail_comment := '';
                for tail_idx := prefix_count to High(syllables_local) do
                begin
                    tail_comment := tail_comment +
                        normalize_pinyin_text(syllables_local[tail_idx].text);
                end;
                if tail_comment = '' then
                begin
                    Continue;
                end;
                if (prefix_count >= 3) and
                    (prefix_count = Length(syllables_local) - 1) and
                    is_single_initial_tail_comment_local(tail_comment) then
                begin
                    Continue;
                end;

                if not dictionary_exact_lookup_cached(prefix_key, head_results) then
                begin
                    Continue;
                end;
                normalize_learned_prefix_exact_scores(prefix_key, head_results);
                prefix_lookup_results := head_results;

                if prefix_count = 1 then
                begin
                    accepted_limit := c_prefix_single_limit;
                end
                else
                begin
                    if Length(syllables_local) = 4 then
                    begin
                        accepted_limit := c_four_syllable_prefix_phrase_limit;
                    end
                    else
                    begin
                        accepted_limit := c_prefix_phrase_limit;
                    end;
                end;

                accepted_for_prefix := 0;
                for result_idx := 0 to High(head_results) do
                begin
                    if (accepted_total >= c_prefix_total_limit) or
                        (accepted_for_prefix >= accepted_limit) then
                    begin
                        Break;
                    end;
                    if Trim(head_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(head_results[result_idx].text);
                    if candidate_text = '' then
                    begin
                        Continue;
                    end;

                    candidate_units := get_candidate_text_unit_count(candidate_text);
                    if prefix_count = 1 then
                    begin
                        if candidate_units <> 1 then
                        begin
                            Continue;
                        end;
                    end
                    else if candidate_units < 2 then
                    begin
                        Continue;
                    end;
                    if not explicit_prefix_entry_local(candidate_text) then
                    begin
                        Continue;
                    end;

                    seen_key := candidate_text + #9 + tail_comment;
                    if seen.ContainsKey(seen_key) then
                    begin
                        Continue;
                    end;

                    candidate := head_results[result_idx];
                    candidate.comment := tail_comment;
                    Inc(candidate.score, c_prefix_base_bonus +
                        (prefix_count * c_prefix_bonus_per_syllable));
                    if prefix_count >= 2 then
                    begin
                        Inc(candidate.score, c_prefix_phrase_extra_bonus);
                        if Length(syllables_local) <= 4 then
                        begin
                            Inc(candidate.score, c_prefix_short_query_phrase_bonus);
                        end;
                    end;
                    Dec(candidate.score, (Length(syllables_local) - prefix_count) *
                        c_prefix_remaining_penalty);

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate;
                    seen.AddOrSetValue(seen_key, 1);
                    Inc(accepted_total);
                    Inc(accepted_for_prefix);
                end;
            end;
        finally
            seen.Free;
        end;
        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    function build_string_prefix_exact_partial_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_prefix_total_limit = 12;
        c_prefix_probe_limit = 10;
        c_prefix_base_bonus = 760;
        c_prefix_unit_bonus = 260;
        c_tail_penalty = 18;
    var
        normalized_query: string;
        prefix_len: Integer;
        prefix_key: string;
        tail_comment: string;
        head_results: TncCandidateList;
        result_idx: Integer;
        accepted_total: Integer;
        candidate: TncCandidate;
        candidate_text: string;
        candidate_units: Integer;
        candidate_score: Integer;
        seen_key: string;
        cache_key: string;
        cached_candidates: TncCandidateList;
        seen: TDictionary<string, Byte>;
        protected_syllables: TncPinyinParseResult;
        normalized_learning: Boolean;

        function tail_is_single_initial_extension_local(
            const value: string): Boolean;
        var
            normalized_value: string;
        begin
            normalized_value := normalize_pinyin_text(value);
            Result := (Length(normalized_value) = 1) and
                CharInSet(normalized_value[1],
                ['b', 'c', 'd', 'f', 'g', 'h', 'j', 'k', 'l', 'm', 'n',
                'p', 'q', 'r', 's', 't', 'w', 'x', 'y', 'z']);
        end;

        function prefix_tail_alignment_allowed_local: Boolean;
        var
            part: TncPinyinSyllable;
        begin
            // A trailing initial must not split a completed syllable:
            // zhen+zheng+d is not zhen+zhen+gd. Alternate full-syllable
            // parses (jian+gei vs jiang+ei) are deliberately unaffected.
            for part in protected_syllables do
                if (prefix_len > part.start_index) and
                    (prefix_len < part.start_index + part.length) and
                    nc_is_canonical_pinyin_syllable(part.text) then
                    Exit(False);
            if is_full_pinyin_key(prefix_key) then
            begin
                Exit(True);
            end;

            // Non-full prefix matches are predictive completions for an
            // unfinished current syllable, such as "yongc" -> "yongchu".
            // Once additional non-initial letters have been typed, the prefix
            // no longer aligns with the user's input; otherwise "gengbuy"
            // incorrectly becomes a "gengb/uy" partial.
            Result := tail_is_single_initial_extension_local(tail_comment);
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        normalized_query := normalize_pinyin_text(query_text);
        if (m_dictionary = nil) or (normalized_query = '') then
        begin
            Exit;
        end;
        cache_key := '#stringprefixexact#' + normalized_query;
        if (m_build_lookup_cache <> nil) and
            m_build_lookup_cache.TryGetValue(cache_key, cached_candidates) then
        begin
            out_candidates := Copy(cached_candidates, 0, Length(cached_candidates));
            Exit(Length(out_candidates) > 0);
        end;

        if has_raw_safe_trailing_initial_typing_state and
            SameText(normalized_query, lookup_text) then
            protected_syllables := get_effective_compact_pinyin_syllables(normalized_query);

        seen := TDictionary<string, Byte>.Create;
        try
            accepted_total := 0;
            for prefix_len := Length(normalized_query) - 1 downto 1 do
            begin
                if accepted_total >= c_prefix_total_limit then
                begin
                    Break;
                end;

                prefix_key := Copy(normalized_query, 1, prefix_len);
                tail_comment := Copy(normalized_query, prefix_len + 1,
                    Length(normalized_query) - prefix_len);
                if tail_comment = '' then
                begin
                    Continue;
                end;
                if not prefix_tail_alignment_allowed_local then
                begin
                    Continue;
                end;
                if not dictionary_exact_lookup_cached(prefix_key, head_results) then
                begin
                    Continue;
                end;

                normalized_learning := normalize_learned_prefix_exact_scores(
                    prefix_key, head_results);
                for result_idx := 0 to High(head_results) do
                begin
                    if (accepted_total >= c_prefix_total_limit) or
                        (result_idx >= c_prefix_probe_limit) then
                    begin
                        Break;
                    end;
                    if Trim(head_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    candidate_text := Trim(head_results[result_idx].text);
                    candidate_units := get_candidate_text_unit_count(candidate_text);
                    if (candidate_text = '') or (candidate_units <= 0) then
                    begin
                        Continue;
                    end;

                    seen_key := candidate_text + #9 + tail_comment;
                    if seen.ContainsKey(seen_key) then
                    begin
                        Continue;
                    end;

                    candidate := head_results[result_idx];
                    candidate.comment := tail_comment;
                    candidate_score := candidate.score;
                    if candidate.has_dict_weight and
                        (candidate.dict_weight > candidate_score) then
                    begin
                        candidate_score := candidate.dict_weight;
                    end;
                    candidate.score := candidate_score + c_prefix_base_bonus +
                        candidate_units * c_prefix_unit_bonus -
                        Length(tail_comment) * c_tail_penalty;
                    if (not normalized_learning) or (not candidate.has_dict_weight) then
                    begin
                        candidate.has_dict_weight := True;
                        candidate.dict_weight := candidate_score;
                    end;

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate;
                    seen.AddOrSetValue(seen_key, 1);
                    Inc(accepted_total);
                end;
            end;
        finally
            seen.Free;
        end;

        sort_candidates_lightweight(out_candidates);
        if m_build_lookup_cache <> nil then
        begin
            m_build_lookup_cache.AddOrSetValue(cache_key,
                Copy(out_candidates, 0, Length(out_candidates)));
        end;
        Result := Length(out_candidates) > 0;
    end;

    function build_adjacent_swap_prefix_partial_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    var
        normalized_query: string;
        swap_idx: Integer;
        swap_value: string;
        swap_char: Char;
    begin
        SetLength(out_candidates, 0);
        Result := False;

        normalized_query := normalize_pinyin_text(query_text);
        if (normalized_query = '') or (Length(normalized_query) < 5) or
            (Length(normalized_query) > 10) then
        begin
            Exit;
        end;

        for swap_idx := Length(normalized_query) - 1 downto 1 do
        begin
            if normalized_query[swap_idx] = normalized_query[swap_idx + 1] then
            begin
                Continue;
            end;

            swap_value := normalized_query;
            swap_char := swap_value[swap_idx];
            swap_value[swap_idx] := swap_value[swap_idx + 1];
            swap_value[swap_idx + 1] := swap_char;

            if build_string_prefix_exact_partial_candidates(swap_value,
                out_candidates) or
                build_exact_leading_prefix_partial_candidates(swap_value,
                out_candidates) or
                build_raw_leading_prefix_partial_candidates(swap_value,
                out_candidates) then
            begin
                Exit(True);
            end;
        end;
    end;

    function build_exact_head_modal_tail_complete_candidates(const query_text: string;
        out out_candidates: TncCandidateList): Boolean;
    const
        c_head_modal_complete_limit = 3;
        c_head_modal_complete_bonus = 1280;
    var
        normalized_query: string;
        syllables_local: TncPinyinParseResult;
        head_key: string;
        tail_key: string;
        tail_text: string;
        tail_units: TArray<string>;
        tail_syllable_count: Integer;
        idx: Integer;
        head_results: TncCandidateList;
        candidate: TncCandidate;
        accepted_count: Integer;
        score_value: Integer;
        path_hint: Integer;
        tail_path: string;

        function text_ends_with_tail_particle_local(
            const text_value: string; const tail_text_value: string): Boolean;
        var
            trimmed_text_local: string;
            last_char_local: string;
        begin
            Result := False;
            trimmed_text_local := Trim(text_value);
            if (trimmed_text_local = '') or (tail_text_value = '') then
            begin
                Exit;
            end;
            last_char_local := Copy(trimmed_text_local,
                Length(trimmed_text_local), 1);
            Result := SameText(last_char_local, tail_text_value);
        end;

        function has_full_query_exact_candidate_local: Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_units_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if not dictionary_exact_lookup_cached(normalized_query,
                exact_results_local) then
            begin
                Exit;
            end;
            exact_units_local := Length(syllables_local);
            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (exact_text_local <> '') and
                    (get_candidate_text_unit_count(exact_text_local) =
                    exact_units_local) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if normalized_query = '' then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(normalized_query);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;
        if has_full_query_exact_candidate_local then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        tail_text := '';
        SetLength(tail_units, 0);
        tail_syllable_count := 0;
        if tail_key = 'ba' then
        begin
            tail_text := string(Char($5427));
        end
        else if tail_key = 'ma' then
        begin
            tail_text := string(Char($5417));
        end
        else if tail_key = 'ne' then
        begin
            tail_text := string(Char($5462));
        end
        else if tail_key = 'a' then
        begin
            tail_text := string(Char($554A));
        end
        else if tail_key = 'ya' then
        begin
            tail_text := string(Char($5440));
        end
        else if tail_key = 'la' then
        begin
            tail_text := string(Char($5566));
        end
        else if tail_key = 'le' then
        begin
            tail_text := string(Char($4E86));
        end
        else if tail_key = 'wa' then
        begin
            tail_text := string(Char($54C7));
        end;
        if tail_key = 'le' then
        begin
            tail_units := TArray<string>.Create(tail_text);
            tail_syllable_count := 1;
        end
        else if tail_text <> '' then
        begin
            if (Length(syllables_local) >= 2) and
                SameText(normalize_pinyin_text(
                syllables_local[High(syllables_local) - 1].text), 'le') then
            begin
                tail_units := TArray<string>.Create(string(Char($4E86)), tail_text);
                tail_syllable_count := 2;
            end
            else
            begin
                tail_units := TArray<string>.Create(tail_text);
                tail_syllable_count := 1;
            end;
        end;
        if tail_syllable_count <= 0 then
        begin
            Exit;
        end;

        head_key := '';
        for idx := 0 to High(syllables_local) - tail_syllable_count do
        begin
            head_key := head_key + normalize_pinyin_text(syllables_local[idx].text);
        end;
        if head_key = '' then
        begin
            Exit;
        end;

        if not dictionary_exact_lookup_cached(head_key, head_results) then
        begin
            Exit;
        end;

        accepted_count := 0;
        for idx := 0 to High(head_results) do
        begin
            if accepted_count >= c_head_modal_complete_limit then
            begin
                Break;
            end;
            if Trim(head_results[idx].comment) <> '' then
            begin
                Continue;
            end;
            if get_candidate_text_unit_count(Trim(head_results[idx].text)) <>
                (Length(syllables_local) - tail_syllable_count) then
            begin
                Continue;
            end;
            if text_ends_with_tail_particle_local(Trim(head_results[idx].text),
                tail_text) then
            begin
                Continue;
            end;

            candidate := head_results[idx];
            score_value := candidate.score;
            if candidate.has_dict_weight and (candidate.dict_weight > score_value) then
            begin
                score_value := candidate.dict_weight;
            end;

            candidate.text := Trim(candidate.text) + String.Join('', tail_units);
            candidate.comment := '';
            candidate.source := cs_rule;
            candidate.has_dict_weight := False;
            candidate.dict_weight := 0;
            candidate.score := score_value + c_head_modal_complete_bonus;
            path_hint := score_value + c_head_modal_complete_bonus;
            tail_path := String.Join(c_segment_path_separator, tail_units);
            remember_segment_path_for_candidate(candidate.text, '',
                Trim(head_results[idx].text) + c_segment_path_separator + tail_path,
                path_hint);

            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate;
            Inc(accepted_count);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := Length(out_candidates) > 0;
    end;

    procedure finalize_le_plus_modal_particle_sentence_candidate(
        var candidates: TncCandidateList);
    const
        c_le_modal_finalize_bonus = 1180;
    var
        syllables_local: TncPinyinParseResult;
        tail_key: string;
        expected_units: TArray<string>;
        expected_tail_text: string;
        expected_first_tail_text: string;
        idx: Integer;
        candidate_units: Integer;
        best_index: Integer;
        best_score: Integer;
        existing_index: Integer;
        preferred_existing_index: Integer;
        preferred_existing_score: Integer;
        preferred_partial_index: Integer;
        preferred_partial_score: Integer;
        preferred_le_tail_partial_index: Integer;
        preferred_le_tail_partial_score: Integer;
        segment_path: string;
        segment_parts: TArray<string>;
        corrected_candidate: TncCandidate;
        corrected_text: string;
        corrected_path: string;
        text_units: TArray<string>;
        part_idx: Integer;
        tail_idx: Integer;
        tail_ok: Boolean;
    begin
        if (Length(candidates) = 0) or (input_syllable_count < 5) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        expected_tail_text := '';
        if tail_key = 'ba' then
        begin
            expected_tail_text := string(Char($5427));
        end
        else if tail_key = 'ma' then
        begin
            expected_tail_text := string(Char($5417));
        end
        else if tail_key = 'ne' then
        begin
            expected_tail_text := string(Char($5462));
        end
        else if tail_key = 'a' then
        begin
            expected_tail_text := string(Char($554A));
        end
        else if tail_key = 'ya' then
        begin
            expected_tail_text := string(Char($5440));
        end
        else if tail_key = 'la' then
        begin
            expected_tail_text := string(Char($5566));
        end
        else if tail_key = 'wa' then
        begin
            expected_tail_text := string(Char($54C7));
        end;

        if (expected_tail_text = '') or
            (not SameText(normalize_pinyin_text(
            syllables_local[High(syllables_local) - 1].text), 'le')) then
        begin
            Exit;
        end;

        expected_units := TArray<string>.Create(string(Char($4E86)), expected_tail_text);
        expected_first_tail_text := expected_units[0];
        preferred_existing_index := -1;
        preferred_existing_score := Low(Integer);
        preferred_partial_index := -1;
        preferred_partial_score := Low(Integer);
        preferred_le_tail_partial_index := -1;
        preferred_le_tail_partial_score := Low(Integer);
        best_index := -1;
        best_score := Low(Integer);
        existing_index := -1;

        for idx := 0 to High(candidates) do
        begin
            candidate_units := get_candidate_text_unit_count(Trim(candidates[idx].text));

            if SameText(Trim(candidates[idx].comment), 'le' + tail_key) then
            begin
                if (candidate_units = input_syllable_count - 2) and
                    (candidates[idx].score > preferred_le_tail_partial_score) then
                begin
                    preferred_le_tail_partial_score := candidates[idx].score;
                    preferred_le_tail_partial_index := idx;
                end;
            end;

            if SameText(Trim(candidates[idx].comment), tail_key) then
            begin
                if candidate_units = input_syllable_count - 1 then
                begin
                    text_units := split_text_units(Trim(candidates[idx].text));
                    if (Length(text_units) > 0) and
                        SameText(Trim(text_units[High(text_units)]), expected_first_tail_text) and
                        (candidates[idx].score > preferred_partial_score) then
                    begin
                        preferred_partial_score := candidates[idx].score;
                        preferred_partial_index := idx;
                    end;
                end;
            end;

            if Trim(candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_units := get_candidate_text_unit_count(Trim(candidates[idx].text));
            if candidate_units = input_syllable_count then
            begin
                text_units := split_text_units(Trim(candidates[idx].text));
                if Length(text_units) >= 2 then
                begin
                    if SameText(Trim(text_units[High(text_units) - 1]), expected_units[0]) and
                        SameText(Trim(text_units[High(text_units)]), expected_units[1]) and
                        (candidates[idx].score > preferred_existing_score) then
                    begin
                        preferred_existing_score := candidates[idx].score;
                        preferred_existing_index := idx;
                    end;
                end;
            end;

            if candidate_units <> input_syllable_count then
            begin
                Continue;
            end;

            segment_path := get_segment_path_for_candidate(candidates[idx]);
            if get_encoded_path_segment_count_local(segment_path) <= 2 then
            begin
                Continue;
            end;
            segment_parts := segment_path.Split([c_segment_path_separator]);
            if Length(segment_parts) <= 2 then
            begin
                Continue;
            end;

            tail_ok := True;
            for tail_idx := 0 to 1 do
            begin
                if get_candidate_text_unit_count(
                    Trim(segment_parts[High(segment_parts) - 1 + tail_idx])) <> 1 then
                begin
                    tail_ok := False;
                    Break;
                end;
            end;
            if not tail_ok then
            begin
                Continue;
            end;

            corrected_text := '';
            corrected_path := '';
            for part_idx := 0 to High(segment_parts) - 2 do
            begin
                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                if corrected_path = '' then
                begin
                    corrected_path := Trim(segment_parts[part_idx]);
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        Trim(segment_parts[part_idx]);
                end;
            end;
            for tail_idx := 0 to High(expected_units) do
            begin
                corrected_text := corrected_text + expected_units[tail_idx];
                if corrected_path = '' then
                begin
                    corrected_path := expected_units[tail_idx];
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        expected_units[tail_idx];
                end;
            end;

            if SameText(corrected_text, Trim(candidates[idx].text)) then
            begin
                if (preferred_existing_index < 0) and
                    (candidates[idx].score > preferred_existing_score) then
                begin
                    preferred_existing_score := candidates[idx].score;
                    preferred_existing_index := idx;
                end;
                Continue;
            end;

            if existing_index < 0 then
            begin
                for part_idx := 0 to High(candidates) do
                begin
                    if (Trim(candidates[part_idx].comment) = '') and
                        SameText(Trim(candidates[part_idx].text), corrected_text) then
                    begin
                        existing_index := part_idx;
                        Break;
                    end;
                end;
            end;

            if candidates[idx].score > best_score then
            begin
                best_score := candidates[idx].score;
                best_index := idx;
            end;
        end;

        if preferred_le_tail_partial_index >= 0 then
        begin
            corrected_candidate := candidates[preferred_le_tail_partial_index];
            corrected_candidate.text := Trim(corrected_candidate.text) +
                expected_units[0] + expected_units[1];
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            corrected_candidate.has_dict_weight := False;
            corrected_candidate.dict_weight := 0;
            corrected_candidate.score := Max(corrected_candidate.score +
                c_le_modal_finalize_bonus, candidates[0].score + c_le_modal_finalize_bonus);
            segment_path := get_segment_path_for_candidate(
                candidates[preferred_le_tail_partial_index]);
            if segment_path = '' then
            begin
                corrected_path := Trim(candidates[preferred_le_tail_partial_index].text) +
                    c_segment_path_separator + expected_units[0] +
                    c_segment_path_separator + expected_units[1];
            end
            else
            begin
                corrected_path := segment_path + c_segment_path_separator +
                    expected_units[0] + c_segment_path_separator + expected_units[1];
            end;
            remember_segment_path_for_candidate(corrected_candidate.text, '',
                corrected_path, corrected_candidate.score);
            for idx := Length(candidates) - 1 downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := corrected_candidate;
            Exit;
        end;

        if preferred_partial_index >= 0 then
        begin
            corrected_candidate := candidates[preferred_partial_index];
            corrected_candidate.text := Trim(corrected_candidate.text) + expected_units[1];
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            corrected_candidate.has_dict_weight := False;
            corrected_candidate.dict_weight := 0;
            corrected_candidate.score := Max(corrected_candidate.score +
                c_le_modal_finalize_bonus, candidates[0].score + c_le_modal_finalize_bonus);
            segment_path := get_segment_path_for_candidate(candidates[preferred_partial_index]);
            if segment_path = '' then
            begin
                corrected_path := Trim(candidates[preferred_partial_index].text) +
                    c_segment_path_separator + expected_units[1];
            end
            else
            begin
                corrected_path := segment_path + c_segment_path_separator + expected_units[1];
            end;
            remember_segment_path_for_candidate(corrected_candidate.text, '',
                corrected_path, corrected_candidate.score);
            for idx := Length(candidates) - 1 downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := corrected_candidate;
            Exit;
        end;

        if preferred_existing_index > 0 then
        begin
            corrected_candidate := candidates[preferred_existing_index];
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            Inc(corrected_candidate.score, c_le_modal_finalize_bonus);
            for idx := preferred_existing_index downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := corrected_candidate;
            Exit;
        end;

        if best_index < 0 then
        begin
            Exit;
        end;

        if existing_index >= 0 then
        begin
            corrected_candidate := candidates[existing_index];
            Inc(corrected_candidate.score, c_le_modal_finalize_bonus);
            corrected_candidate.source := cs_rule;
            corrected_candidate.comment := '';
        end
        else
        begin
            corrected_candidate := candidates[best_index];
            segment_path := get_segment_path_for_candidate(candidates[best_index]);
            segment_parts := segment_path.Split([c_segment_path_separator]);
            corrected_text := '';
            corrected_path := '';
            for part_idx := 0 to High(segment_parts) - 2 do
            begin
                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                if corrected_path = '' then
                begin
                    corrected_path := Trim(segment_parts[part_idx]);
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        Trim(segment_parts[part_idx]);
                end;
            end;
            for tail_idx := 0 to High(expected_units) do
            begin
                corrected_text := corrected_text + expected_units[tail_idx];
                if corrected_path = '' then
                begin
                    corrected_path := expected_units[tail_idx];
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        expected_units[tail_idx];
                end;
            end;

            corrected_candidate.text := corrected_text;
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            corrected_candidate.has_dict_weight := False;
            corrected_candidate.dict_weight := 0;
            Inc(corrected_candidate.score, c_le_modal_finalize_bonus);
            remember_segment_path_for_candidate(corrected_candidate.text, '',
                corrected_path, corrected_candidate.score);
        end;

        for idx := Length(candidates) - 1 downto 1 do
        begin
            candidates[idx] := candidates[idx - 1];
        end;
        candidates[0] := corrected_candidate;
    end;

    function build_dangling_exact_head_chain_sentence_candidates(
        const query_text: string; out out_candidates: TncCandidateList): Boolean;
    const
        c_chain_max_depth = 8;
        c_chain_min_prefix_len = 3;
        c_chain_max_prefix_len = 14;
        c_chain_max_prefix_hits_per_depth = 6;
        c_chain_max_results_per_prefix = 2;
        c_chain_completion_bonus = 1200;
        c_chain_segment_penalty = 280;
        c_chain_prefix_len_bonus = 90;
    var
        normalized_query: string;
        best_scores: TDictionary<string, Integer>;

        procedure remember_complete_chain(const text_value: string;
            const path_value: string; const score_value: Integer);
        var
            previous_score: Integer;
            candidate: TncCandidate;
            idx: Integer;
            encoded_path: string;
        begin
            if (Trim(text_value) = '') or
                (get_candidate_text_unit_count(Trim(text_value)) <> input_syllable_count) then
            begin
                Exit;
            end;

            if best_scores.TryGetValue(text_value, previous_score) and
                (previous_score >= score_value) then
            begin
                Exit;
            end;
            best_scores.AddOrSetValue(text_value, score_value);

            encoded_path := path_value;
            if (encoded_path <> '') and (encoded_path[1] = c_segment_path_separator) then
            begin
                Delete(encoded_path, 1, 1);
            end;

            for idx := 0 to High(out_candidates) do
            begin
                if SameText(Trim(out_candidates[idx].text), Trim(text_value)) then
                begin
                    out_candidates[idx].score := score_value;
                    out_candidates[idx].comment := '';
                    out_candidates[idx].source := cs_rule;
                    out_candidates[idx].has_dict_weight := False;
                    out_candidates[idx].dict_weight := 0;
                    remember_segment_path_for_candidate(out_candidates[idx].text, '',
                        encoded_path, score_value);
                    Exit;
                end;
            end;

            candidate := Default(TncCandidate);
            candidate.text := text_value;
            candidate.comment := '';
            candidate.score := score_value;
            candidate.source := cs_rule;
            candidate.has_dict_weight := False;
            candidate.dict_weight := 0;
            SetLength(out_candidates, Length(out_candidates) + 1);
            out_candidates[High(out_candidates)] := candidate;
            remember_segment_path_for_candidate(candidate.text, '', encoded_path,
                score_value);
        end;

        procedure build_chain_recursive(const remaining_query: string;
            const composed_text: string; const composed_path: string;
            const accumulated_score: Integer; const depth: Integer);
        var
            prefix_len: Integer;
            prefix_key: string;
            allow_nonfull_tail: Boolean;
            exact_results: TncCandidateList;
            result_idx: Integer;
            prefix_hit_count: Integer;
            accepted_count: Integer;
            piece_text: string;
            piece_score: Integer;
            piece_units: Integer;
            next_text: string;
            next_path: string;
            next_remaining: string;
        begin
            if remaining_query = '' then
            begin
                remember_complete_chain(composed_text, composed_path,
                    accumulated_score + c_chain_completion_bonus -
                    (depth * c_chain_segment_penalty));
                Exit;
            end;
            if depth >= c_chain_max_depth then
            begin
                Exit;
            end;

            prefix_hit_count := 0;
            for prefix_len := Min(c_chain_max_prefix_len, Length(remaining_query)) downto
                c_chain_min_prefix_len do
            begin
                prefix_key := Copy(remaining_query, 1, prefix_len);
                allow_nonfull_tail := prefix_len = Length(remaining_query);
                if (not is_full_pinyin_key(prefix_key)) and (not allow_nonfull_tail) then
                begin
                    Continue;
                end;
                if not dictionary_exact_lookup_cached(prefix_key, exact_results) then
                begin
                    Continue;
                end;

                accepted_count := 0;
                for result_idx := 0 to High(exact_results) do
                begin
                    if accepted_count >= c_chain_max_results_per_prefix then
                    begin
                        Break;
                    end;
                    if Trim(exact_results[result_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if is_runtime_chain_candidate(exact_results[result_idx]) or
                        is_runtime_common_pattern_candidate(exact_results[result_idx]) or
                        is_runtime_redup_candidate(exact_results[result_idx]) then
                    begin
                        Continue;
                    end;

                    piece_text := Trim(exact_results[result_idx].text);
                    if piece_text = '' then
                    begin
                        Continue;
                    end;
                    piece_units := get_candidate_text_unit_count(piece_text);
                    if (depth = 0) and (piece_units = 1) and
                        (prefix_len < Length(remaining_query)) then
                    begin
                        Continue;
                    end;

                    next_remaining := Copy(remaining_query, prefix_len + 1, MaxInt);
                    piece_score := exact_results[result_idx].score;
                    if exact_results[result_idx].has_dict_weight and
                        (exact_results[result_idx].dict_weight > piece_score) then
                    begin
                        piece_score := exact_results[result_idx].dict_weight;
                    end;
                    if piece_score <= 0 then
                    begin
                        piece_score := 1;
                    end;

                    next_text := composed_text + piece_text;
                    next_path := composed_path + c_segment_path_separator + piece_text;
                    build_chain_recursive(next_remaining, next_text, next_path,
                        accumulated_score + piece_score +
                        (prefix_len * c_chain_prefix_len_bonus), depth + 1);
                    Inc(accepted_count);
                end;

                if accepted_count > 0 then
                begin
                    Inc(prefix_hit_count);
                    if prefix_hit_count >= c_chain_max_prefix_hits_per_depth then
                    begin
                        Break;
                    end;
                end;
            end;
        end;
    begin
        SetLength(out_candidates, 0);
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        normalized_query := normalize_pinyin_text(query_text);
        if (normalized_query = '') or (Length(normalized_query) < 8) then
        begin
            Exit;
        end;

        best_scores := TDictionary<string, Integer>.Create;
        try
            build_chain_recursive(normalized_query, '', '', 0, 0);
        finally
            best_scores.Free;
        end;

        if Length(out_candidates) = 0 then
        begin
            Exit(False);
        end;

        sort_candidates_lightweight(out_candidates);
        Result := True;
    end;

    procedure apply_shifted_boundary_longer_exact_penalty(
        var candidates: TncCandidateList);
    const
        c_exact_probe_limit = 8;
        c_shifted_boundary_penalty = 3600;
        c_min_shifted_left_weight = 520;
        c_min_shifted_follow_weight = 520;
    var
        syllables_local: TncPinyinParseResult;
        idx: Integer;
        segment_path: string;
        segment_parts: TArray<string>;
        segment_idx: Integer;
        syllable_idx: Integer;
        left_units: Integer;
        right_units: Integer;
        adjustment: Integer;
        shifted_left_weight: Integer;
        shifted_follow_weight: Integer;

        function build_query_key_local(const start_idx: Integer;
            const syllable_count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := start_idx to start_idx + syllable_count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(syllables_local[local_idx].text);
            end;
        end;

        function get_exact_candidate_rank_weight(
            const candidate: TncCandidate): Integer;
        begin
            Result := candidate.score;
            if candidate.has_dict_weight and (candidate.dict_weight > Result) then
            begin
                Result := candidate.dict_weight;
            end;
        end;

        function try_get_best_exact_phrase_weight_local(const start_idx: Integer;
            const syllable_count_local: Integer; out out_weight: Integer): Boolean;
        var
            query_key: string;
            exact_results: TncCandidateList;
            exact_idx: Integer;
            candidate_text: string;
            candidate_units: Integer;
            weight_value: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (m_dictionary = nil) or
                (start_idx < 0) or (syllable_count_local <= 0) or
                (start_idx + syllable_count_local - 1 > High(syllables_local)) then
            begin
                Exit;
            end;

            query_key := build_query_key_local(start_idx, syllable_count_local);
            if (query_key = '') or
                (not m_dictionary.lookup_exact_full_pinyin(query_key, exact_results)) then
            begin
                Exit;
            end;

            for exact_idx := 0 to High(exact_results) do
            begin
                if exact_idx >= c_exact_probe_limit then
                begin
                    Break;
                end;
                if Trim(exact_results[exact_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(exact_results[exact_idx]) or
                    is_runtime_common_pattern_candidate(exact_results[exact_idx]) or
                    is_runtime_redup_candidate(exact_results[exact_idx]) then
                begin
                    Continue;
                end;

                candidate_text := Trim(exact_results[exact_idx].text);
                candidate_units := get_candidate_text_unit_count(candidate_text);
                if candidate_units <> syllable_count_local then
                begin
                    Continue;
                end;

                weight_value := get_exact_candidate_rank_weight(exact_results[exact_idx]);
                if weight_value > out_weight then
                begin
                    out_weight := weight_value;
                    Result := True;
                end;
            end;
        end;

        function try_get_best_shifted_follow_weight_local(
            const start_idx: Integer; out out_weight: Integer): Boolean;
        var
            probe_len: Integer;
            weight_value: Integer;
        begin
            Result := False;
            out_weight := 0;
            if (start_idx < 0) or (start_idx > High(syllables_local)) then
            begin
                Exit;
            end;

            for probe_len := 1 to Min(3, Length(syllables_local) - start_idx) do
            begin
                if not try_get_best_exact_phrase_weight_local(start_idx,
                    probe_len, weight_value) then
                begin
                    Continue;
                end;
                if weight_value > out_weight then
                begin
                    out_weight := weight_value;
                    Result := True;
                end;
            end;
        end;

    begin
        if (Length(candidates) = 0) or
            (input_syllable_count < c_long_sentence_exact_min_syllables) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            normalize_pinyin_text(m_last_lookup_key));
        if Length(syllables_local) <> m_last_lookup_syllable_count then
        begin
            Exit;
        end;

        for idx := 0 to High(candidates) do
        begin
            if Trim(candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            segment_path := get_segment_path_for_candidate(candidates[idx]);
            if get_encoded_path_segment_count_local(segment_path) <= 1 then
            begin
                Continue;
            end;

            segment_parts := segment_path.Split([c_segment_path_separator]);
            syllable_idx := 0;
            adjustment := 0;
            for segment_idx := 0 to High(segment_parts) - 1 do
            begin
                left_units := get_candidate_text_unit_count(Trim(segment_parts[segment_idx]));
                right_units := get_candidate_text_unit_count(Trim(segment_parts[segment_idx + 1]));

                if (left_units >= 2) and (right_units >= 2) and
                    (syllable_idx + left_units + right_units - 1 <= High(syllables_local)) and
                    try_get_best_exact_phrase_weight_local(syllable_idx,
                    left_units + 1, shifted_left_weight) and
                    (shifted_left_weight >= c_min_shifted_left_weight) and
                    try_get_best_shifted_follow_weight_local(
                    syllable_idx + left_units + 1, shifted_follow_weight) and
                    (shifted_follow_weight >= c_min_shifted_follow_weight) then
                begin
                    Dec(adjustment, c_shifted_boundary_penalty);
                end;

                Inc(syllable_idx, left_units);
            end;

            if adjustment <> 0 then
            begin
                Inc(candidates[idx].score, adjustment);
            end;
        end;
    end;

    procedure apply_compact_long_phrase_bonus(var candidates: TncCandidateList);
    const
        c_compact_long_phrase_bonus = 760;
        c_compact_long_phrase_extra_per_unit = 120;
    var
        idx: Integer;
        encoded_path: string;
        segment_parts: TArray<string>;
        part_idx: Integer;
        segment_units: Integer;
        max_segment_units: Integer;
        path_segment_count: Integer;
    begin
        if (Length(candidates) = 0) or
            (input_syllable_count < c_long_sentence_exact_min_syllables) then
        begin
            Exit;
        end;

        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidates[idx].text)) <>
                input_syllable_count) or
                is_runtime_chain_candidate(candidates[idx]) or
                is_runtime_common_pattern_candidate(candidates[idx]) or
                is_runtime_redup_candidate(candidates[idx]) then
            begin
                Continue;
            end;

            encoded_path := get_segment_path_for_candidate(candidates[idx]);
            path_segment_count := get_encoded_path_segment_count_local(encoded_path);
            if path_segment_count <= 1 then
            begin
                Continue;
            end;

            max_segment_units := 0;
            segment_parts := encoded_path.Split([c_segment_path_separator]);
            for part_idx := 0 to High(segment_parts) do
            begin
                if Trim(segment_parts[part_idx]) = '' then
                begin
                    Continue;
                end;
                segment_units := get_candidate_text_unit_count(Trim(segment_parts[part_idx]));
                if segment_units > max_segment_units then
                begin
                    max_segment_units := segment_units;
                end;
            end;

            if max_segment_units < 3 then
            begin
                Continue;
            end;

            Inc(candidates[idx].score,
                c_compact_long_phrase_bonus +
                Max(0, max_segment_units - 3) * c_compact_long_phrase_extra_per_unit);
        end;
    end;

    procedure apply_preferred_sentence_phrase_bonus(
        var candidates: TncCandidateList);
    begin
        // Phrase preference is intentionally dictionary-driven. Avoid hard-coded
        // sentence substring bonuses here; short phrases should be represented in
        // the lexicon and resolved through exact chunk lookup.
    end;
    procedure ensure_modal_tail_sentence_candidate_visible(var candidates: TncCandidateList);
    const
        c_modal_tail_correction_bonus = 980;
    var
        syllables_local: TncPinyinParseResult;
        tail_key: string;
        expected_text: string;
        idx: Integer;
        best_index: Integer;
        best_score: Integer;
        existing_index: Integer;
        segment_path: string;
        corrected_path: string;
        corrected_text: string;
        segment_parts: TArray<string>;
        corrected_candidate: TncCandidate;
        part_idx: Integer;
    begin
        if (Length(candidates) = 0) or (input_syllable_count < 4) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        expected_text := '';
        if tail_key = 'ba' then
        begin
            expected_text := string(Char($5427));
        end
        else if tail_key = 'ma' then
        begin
            expected_text := string(Char($5417));
        end
        else if tail_key = 'ne' then
        begin
            expected_text := string(Char($5462));
        end
        else if tail_key = 'a' then
        begin
            expected_text := string(Char($554A));
        end
        else if tail_key = 'ya' then
        begin
            expected_text := string(Char($5440));
        end
        else if tail_key = 'la' then
        begin
            expected_text := string(Char($5566));
        end
        else if tail_key = 'le' then
        begin
            expected_text := string(Char($4E86));
        end
        else if tail_key = 'wa' then
        begin
            expected_text := string(Char($54C7));
        end;
        if expected_text = '' then
        begin
            Exit;
        end;

        best_index := -1;
        best_score := Low(Integer);
        existing_index := -1;
        for idx := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidates[idx].text)) <> input_syllable_count) then
            begin
                Continue;
            end;

            segment_path := get_segment_path_for_candidate(candidates[idx]);
            if get_encoded_path_segment_count_local(segment_path) <= 1 then
            begin
                Continue;
            end;

            segment_parts := segment_path.Split([c_segment_path_separator]);
            if Length(segment_parts) <= 1 then
            begin
                Continue;
            end;
            if get_candidate_text_unit_count(Trim(segment_parts[High(segment_parts)])) <> 1 then
            begin
                Continue;
            end;

            corrected_text := '';
            corrected_path := '';
            for part_idx := 0 to High(segment_parts) - 1 do
            begin
                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                if corrected_path = '' then
                begin
                    corrected_path := Trim(segment_parts[part_idx]);
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        Trim(segment_parts[part_idx]);
                end;
            end;
            corrected_text := corrected_text + expected_text;
            if corrected_path = '' then
            begin
                corrected_path := expected_text;
            end
            else
            begin
                corrected_path := corrected_path + c_segment_path_separator + expected_text;
            end;

            if SameText(corrected_text, Trim(candidates[idx].text)) then
            begin
                if existing_index < 0 then
                begin
                    existing_index := idx;
                end;
                Continue;
            end;

            if existing_index < 0 then
            begin
                for part_idx := 0 to High(candidates) do
                begin
                    if (Trim(candidates[part_idx].comment) = '') and
                        SameText(Trim(candidates[part_idx].text), corrected_text) then
                    begin
                        existing_index := part_idx;
                        Break;
                    end;
                end;
            end;

            if candidates[idx].score > best_score then
            begin
                best_score := candidates[idx].score;
                best_index := idx;
            end;
        end;

        if best_index < 0 then
        begin
            Exit;
        end;

        segment_path := get_segment_path_for_candidate(candidates[best_index]);
        segment_parts := segment_path.Split([c_segment_path_separator]);
        corrected_text := '';
        corrected_path := '';
        for part_idx := 0 to High(segment_parts) - 1 do
        begin
            corrected_text := corrected_text + Trim(segment_parts[part_idx]);
            if corrected_path = '' then
            begin
                corrected_path := Trim(segment_parts[part_idx]);
            end
            else
            begin
                corrected_path := corrected_path + c_segment_path_separator +
                    Trim(segment_parts[part_idx]);
            end;
        end;
        corrected_text := corrected_text + expected_text;
        if corrected_path = '' then
        begin
            corrected_path := expected_text;
        end
        else
        begin
            corrected_path := corrected_path + c_segment_path_separator + expected_text;
        end;

        if existing_index >= 0 then
        begin
            Inc(candidates[existing_index].score, c_modal_tail_correction_bonus);
            candidates[existing_index].source := cs_rule;
            remember_segment_path_for_candidate(corrected_text, '',
                corrected_path, candidates[existing_index].score);
            Exit;
        end;

        corrected_candidate := candidates[best_index];
        corrected_candidate.text := corrected_text;
        corrected_candidate.comment := '';
        corrected_candidate.source := cs_rule;
        corrected_candidate.has_dict_weight := False;
        corrected_candidate.dict_weight := 0;
        Inc(corrected_candidate.score, c_modal_tail_correction_bonus);
        SetLength(candidates, Length(candidates) + 1);
        candidates[High(candidates)] := corrected_candidate;
        remember_segment_path_for_candidate(corrected_candidate.text, '',
            corrected_path, corrected_candidate.score);
    end;

    procedure finalize_modal_tail_sentence_candidate(var candidates: TncCandidateList);
    const
        c_modal_tail_finalize_bonus = 960;
    var
        syllables_local: TncPinyinParseResult;
        tail_key: string;
        expected_text: string;
        idx: Integer;
        candidate_units: Integer;
        best_index: Integer;
        best_score: Integer;
        existing_index: Integer;
        preferred_existing_index: Integer;
        preferred_existing_score: Integer;
        expanded_tail_index: Integer;
        expanded_tail_score: Integer;
        expanded_tail_text: string;
        expanded_tail_path: string;
        segment_path: string;
        segment_parts: TArray<string>;
        corrected_candidate: TncCandidate;
        corrected_text: string;
        corrected_path: string;
        part_idx: Integer;
        last_units: TArray<string>;
        last_segment_units: Integer;
        last_segment_start: Integer;
        tail_head_len: Integer;
        tail_head_key: string;
        tail_head_results: TncCandidateList;
        tail_head_idx: Integer;
        tail_head_text: string;
        tail_head_score: Integer;
        candidate_modal_score: Integer;
        fixed_quantity_modal_tail_text: string;
        fixed_quantity_modal_tail_units: TArray<string>;
        fixed_quantity_tail_score: Integer;
        fixed_quantity_tail_ready: Boolean;
        candidate_comment: string;
        candidate_text_value: string;

        function is_quantity_tail_unit_local(const unit_text: string): Boolean;
        begin
            Result :=
                SameText(unit_text, string(Char($6B21))) or
                SameText(unit_text, string(Char($4E2A))) or
                SameText(unit_text, string(Char($5929))) or
                SameText(unit_text, string(Char($65E5))) or
                SameText(unit_text, string(Char($8F6E))) or
                SameText(unit_text, string(Char($6B65))) or
                SameText(unit_text, string(Char($6761))) or
                SameText(unit_text, string(Char($6839))) or
                SameText(unit_text, string(Char($6279))) or
                SameText(unit_text, string(Char($5339))) or
                SameText(unit_text, string(Char($53F0))) or
                SameText(unit_text, string(Char($628A))) or
                SameText(unit_text, string(Char($526F))) or
                SameText(unit_text, string(Char($5BF9))) or
                SameText(unit_text, string(Char($53CC))) or
                SameText(unit_text, string(Char($74F6))) or
                SameText(unit_text, string(Char($6876))) or
                SameText(unit_text, string(Char($680B))) or
                SameText(unit_text, string(Char($5E62))) or
                SameText(unit_text, string(Char($7247))) or
                SameText(unit_text, string(Char($76D8))) or
                SameText(unit_text, string(Char($53EA)));
        end;

        function candidate_ends_with_units_local(const units: TArray<string>;
            const suffix_units: TArray<string>): Boolean;
        var
            suffix_idx: Integer;
            units_idx: Integer;
        begin
            Result := False;
            if (Length(units) < Length(suffix_units)) or
                (Length(suffix_units) = 0) then
            begin
                Exit;
            end;

            for suffix_idx := 0 to High(suffix_units) do
            begin
                units_idx := Length(units) - Length(suffix_units) + suffix_idx;
                if not SameText(Trim(units[units_idx]),
                    Trim(suffix_units[suffix_idx])) then
                begin
                    Exit;
                end;
            end;
            Result := True;
        end;

        function candidate_ends_with_fixed_quantity_head_local(
            const units: TArray<string>): Boolean;
        var
            suffix_len: Integer;
            suffix_idx: Integer;
            units_idx: Integer;
        begin
            Result := False;
            suffix_len := Length(fixed_quantity_modal_tail_units) - 1;
            if (suffix_len <= 0) or (Length(units) < suffix_len) then
            begin
                Exit;
            end;

            for suffix_idx := 0 to suffix_len - 1 do
            begin
                units_idx := Length(units) - suffix_len + suffix_idx;
                if not SameText(Trim(units[units_idx]),
                    Trim(fixed_quantity_modal_tail_units[suffix_idx])) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function concat_first_units_local(const units: TArray<string>;
            const unit_count: Integer): string;
        var
            unit_idx: Integer;
            safe_count: Integer;
        begin
            Result := '';
            safe_count := unit_count;
            if safe_count < 0 then
            begin
                safe_count := 0;
            end;
            if safe_count > Length(units) then
            begin
                safe_count := Length(units);
            end;

            for unit_idx := 0 to safe_count - 1 do
            begin
                Result := Result + Trim(units[unit_idx]);
            end;
        end;

        function try_get_fixed_quantity_modal_tail_local(out out_text: string;
            out out_score: Integer): Boolean;
        var
            quantity_key: string;
            quantity_results: TncCandidateList;
            quantity_idx: Integer;
            quantity_text: string;
            quantity_units: TArray<string>;
        begin
            Result := False;
            out_text := '';
            out_score := 0;
            if (tail_key <> 'ba') or (input_syllable_count < 3) or
                (not SameText(normalize_pinyin_text(
                syllables_local[input_syllable_count - 3].text), 'yi')) then
            begin
                Exit;
            end;

            quantity_key := 'yi' + normalize_pinyin_text(
                syllables_local[input_syllable_count - 2].text);
            if (quantity_key = 'yi') or
                (not dictionary_exact_lookup_cached(quantity_key,
                quantity_results)) then
            begin
                Exit;
            end;

            for quantity_idx := 0 to High(quantity_results) do
            begin
                if Trim(quantity_results[quantity_idx].comment) <> '' then
                begin
                    Continue;
                end;
                quantity_text := Trim(quantity_results[quantity_idx].text);
                quantity_units := split_text_units(quantity_text);
                if (Length(quantity_units) <> 2) or
                    (not SameText(Trim(quantity_units[0]),
                    string(Char($4E00)))) or
                    (not is_quantity_tail_unit_local(Trim(quantity_units[1]))) then
                begin
                    Continue;
                end;

                out_text := quantity_text + expected_text;
                out_score := quantity_results[quantity_idx].score;
                if quantity_results[quantity_idx].has_dict_weight and
                    (quantity_results[quantity_idx].dict_weight > out_score) then
                begin
                    out_score := quantity_results[quantity_idx].dict_weight;
                end;
                Exit(True);
            end;
        end;

        procedure remove_fixed_quantity_modal_tail_mismatches_local(
            var list: TncCandidateList);
        var
            remove_idx: Integer;
            shift_idx: Integer;
            units: TArray<string>;
        begin
            if not fixed_quantity_tail_ready then
            begin
                Exit;
            end;

            for remove_idx := High(list) downto 1 do
            begin
                if Trim(list[remove_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if get_candidate_text_unit_count(Trim(list[remove_idx].text)) <>
                    input_syllable_count then
                begin
                    Continue;
                end;

                units := split_text_units(Trim(list[remove_idx].text));
                if candidate_ends_with_units_local(units,
                    fixed_quantity_modal_tail_units) then
                begin
                    Continue;
                end;

                for shift_idx := remove_idx to High(list) - 1 do
                begin
                    list[shift_idx] := list[shift_idx + 1];
                end;
                SetLength(list, Length(list) - 1);
            end;
        end;

        function has_one_quantity_modal_tail_local(
            const units: TArray<string>): Boolean;
        begin
            Result := (Length(units) >= 3) and
                SameText(Trim(units[High(units)]), expected_text) and
                SameText(Trim(units[High(units) - 2]), string(Char($4E00))) and
                is_quantity_tail_unit_local(Trim(units[High(units) - 1]));
        end;
    begin
        if (Length(candidates) = 0) or (input_syllable_count < 4) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        expected_text := '';
        if tail_key = 'ba' then
        begin
            expected_text := string(Char($5427));
        end
        else if tail_key = 'ma' then
        begin
            expected_text := string(Char($5417));
        end
        else if tail_key = 'ne' then
        begin
            expected_text := string(Char($5462));
        end
        else if tail_key = 'a' then
        begin
            expected_text := string(Char($554A));
        end
        else if tail_key = 'ya' then
        begin
            expected_text := string(Char($5440));
        end
        else if tail_key = 'la' then
        begin
            expected_text := string(Char($5566));
        end
        else if tail_key = 'le' then
        begin
            expected_text := string(Char($4E86));
        end
        else if tail_key = 'wa' then
        begin
            expected_text := string(Char($54C7));
        end;
        if expected_text = '' then
        begin
            Exit;
        end;

        best_index := -1;
        best_score := Low(Integer);
        existing_index := -1;
        preferred_existing_index := -1;
        preferred_existing_score := Low(Integer);
        expanded_tail_index := -1;
        expanded_tail_score := Low(Integer);
        expanded_tail_text := '';
        expanded_tail_path := '';
        fixed_quantity_tail_ready := try_get_fixed_quantity_modal_tail_local(
            fixed_quantity_modal_tail_text, fixed_quantity_tail_score);
        if fixed_quantity_tail_ready then
        begin
            fixed_quantity_modal_tail_units :=
                split_text_units(fixed_quantity_modal_tail_text);
        end
        else
        begin
            SetLength(fixed_quantity_modal_tail_units, 0);
        end;
        for idx := 0 to High(candidates) do
        begin
            candidate_comment := normalize_pinyin_text(Trim(candidates[idx].comment));
            candidate_text_value := Trim(candidates[idx].text);
            candidate_units := get_candidate_text_unit_count(candidate_text_value);
            if fixed_quantity_tail_ready and SameText(candidate_comment,
                tail_key) and (candidate_units = input_syllable_count - 1) then
            begin
                last_units := split_text_units(candidate_text_value);
                if candidate_ends_with_fixed_quantity_head_local(last_units) then
                begin
                    corrected_text := candidate_text_value + expected_text;
                    candidate_modal_score := candidates[idx].score +
                        c_modal_tail_finalize_bonus +
                        fixed_quantity_tail_score + 60000;
                    if candidate_modal_score > expanded_tail_score then
                    begin
                        expanded_tail_score := candidate_modal_score;
                        expanded_tail_index := idx;
                        expanded_tail_text := corrected_text;
                        expanded_tail_path := get_segment_path_for_candidate(
                            candidates[idx], idx);
                        if expanded_tail_path = '' then
                        begin
                            expanded_tail_path := candidate_text_value;
                        end;
                        expanded_tail_path := expanded_tail_path +
                            c_segment_path_separator + expected_text;
                    end;
                end;
            end;

            if candidate_comment <> '' then
            begin
                Continue;
            end;

            if candidate_units = input_syllable_count then
            begin
                last_units := split_text_units(candidate_text_value);
                if (Length(last_units) > 0) and
                    SameText(Trim(last_units[High(last_units)]), expected_text) then
                begin
                    if fixed_quantity_tail_ready and
                        (not candidate_ends_with_units_local(last_units,
                        fixed_quantity_modal_tail_units)) then
                    begin
                        Continue;
                    end;
                    candidate_modal_score := candidates[idx].score;
                    if has_one_quantity_modal_tail_local(last_units) then
                    begin
                        Inc(candidate_modal_score, 60000);
                    end;
                    if candidate_modal_score > preferred_existing_score then
                    begin
                        preferred_existing_score := candidate_modal_score;
                        preferred_existing_index := idx;
                    end;
                end;
            end;

            if fixed_quantity_tail_ready and
                (candidate_units = input_syllable_count) then
            begin
                last_units := split_text_units(Trim(candidates[idx].text));
                if not candidate_ends_with_units_local(last_units,
                    fixed_quantity_modal_tail_units) then
                begin
                    corrected_text := concat_first_units_local(last_units,
                        input_syllable_count -
                        Length(fixed_quantity_modal_tail_units)) +
                        fixed_quantity_modal_tail_text;
                    if not SameText(corrected_text,
                        candidate_text_value) then
                    begin
                        candidate_modal_score := candidates[idx].score +
                            c_modal_tail_finalize_bonus +
                            fixed_quantity_tail_score + 60000;
                        if candidate_modal_score > expanded_tail_score then
                        begin
                            expanded_tail_score := candidate_modal_score;
                            expanded_tail_index := idx;
                            expanded_tail_text := corrected_text;
                            expanded_tail_path := '';
                        end;
                    end;
                end;
            end;

            if candidate_units <> input_syllable_count then
            begin
                Continue;
            end;

            segment_path := get_segment_path_for_candidate(candidates[idx]);
            if get_encoded_path_segment_count_local(segment_path) <= 1 then
            begin
                Continue;
            end;
            segment_parts := segment_path.Split([c_segment_path_separator]);
            if Length(segment_parts) <= 1 then
            begin
                Continue;
            end;

            last_segment_units := get_candidate_text_unit_count(
                Trim(segment_parts[High(segment_parts)]));
            if last_segment_units > 1 then
            begin
                last_segment_start := input_syllable_count - last_segment_units;
                tail_head_len := last_segment_units - 1;
                if (last_segment_start >= 0) and (tail_head_len >= 1) and
                    (last_segment_start + tail_head_len <= High(syllables_local)) then
                begin
                    tail_head_key := '';
                    for tail_head_idx := last_segment_start to
                        last_segment_start + tail_head_len - 1 do
                    begin
                        tail_head_key := tail_head_key + normalize_pinyin_text(
                            syllables_local[tail_head_idx].text);
                    end;

                    if (tail_head_key <> '') and
                        dictionary_exact_lookup_cached(tail_head_key,
                        tail_head_results) then
                    begin
                        for tail_head_idx := 0 to High(tail_head_results) do
                        begin
                            if Trim(tail_head_results[tail_head_idx].comment) <> '' then
                            begin
                                Continue;
                            end;
                            tail_head_text := Trim(tail_head_results[tail_head_idx].text);
                            if get_candidate_text_unit_count(tail_head_text) <>
                                tail_head_len then
                            begin
                                Continue;
                            end;
                            tail_head_score := tail_head_results[tail_head_idx].score;
                            if tail_head_results[tail_head_idx].has_dict_weight and
                                (tail_head_results[tail_head_idx].dict_weight >
                                tail_head_score) then
                            begin
                                tail_head_score := tail_head_results[tail_head_idx].dict_weight;
                            end;

                            corrected_text := '';
                            corrected_path := '';
                            for part_idx := 0 to High(segment_parts) - 1 do
                            begin
                                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                                if corrected_path = '' then
                                begin
                                    corrected_path := Trim(segment_parts[part_idx]);
                                end
                                else
                                begin
                                    corrected_path := corrected_path + c_segment_path_separator +
                                        Trim(segment_parts[part_idx]);
                                end;
                            end;
                            corrected_text := corrected_text + tail_head_text + expected_text;
                            if corrected_path = '' then
                            begin
                                corrected_path := tail_head_text;
                            end
                            else
                            begin
                                corrected_path := corrected_path + c_segment_path_separator +
                                    tail_head_text;
                            end;
                            corrected_path := corrected_path + c_segment_path_separator +
                                expected_text;

                            candidate_modal_score := candidates[idx].score +
                                c_modal_tail_finalize_bonus + tail_head_score;
                            if (not SameText(corrected_text, Trim(candidates[idx].text))) and
                                (candidate_modal_score > expanded_tail_score) then
                            begin
                                expanded_tail_score := candidate_modal_score;
                                expanded_tail_index := idx;
                                expanded_tail_text := corrected_text;
                                expanded_tail_path := corrected_path;
                            end;
                            Break;
                        end;
                    end;
                end;
                Continue;
            end;

            if last_segment_units <> 1 then
            begin
                Continue;
            end;

            corrected_text := '';
            corrected_path := '';
            for part_idx := 0 to High(segment_parts) - 1 do
            begin
                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                if corrected_path = '' then
                begin
                    corrected_path := Trim(segment_parts[part_idx]);
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        Trim(segment_parts[part_idx]);
                end;
            end;
            corrected_text := corrected_text + expected_text;

            if SameText(corrected_text, Trim(candidates[idx].text)) then
            begin
                if existing_index < 0 then
                begin
                    existing_index := idx;
                end;
                Continue;
            end;

            if existing_index < 0 then
            begin
                for part_idx := 0 to High(candidates) do
                begin
                    if (Trim(candidates[part_idx].comment) = '') and
                        SameText(Trim(candidates[part_idx].text), corrected_text) then
                    begin
                        existing_index := part_idx;
                        Break;
                    end;
                end;
            end;

            if candidates[idx].score > best_score then
            begin
                best_score := candidates[idx].score;
                best_index := idx;
            end;
        end;

        if preferred_existing_index > 0 then
        begin
            corrected_candidate := candidates[preferred_existing_index];
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            Inc(corrected_candidate.score, c_modal_tail_finalize_bonus);
            for idx := preferred_existing_index downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := corrected_candidate;
            remove_fixed_quantity_modal_tail_mismatches_local(candidates);
            Exit;
        end;

        if best_index < 0 then
        begin
            if expanded_tail_index < 0 then
            begin
                Exit;
            end;
        end;

        if expanded_tail_index >= 0 then
        begin
            corrected_candidate := candidates[expanded_tail_index];
            corrected_candidate.text := expanded_tail_text;
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            corrected_candidate.has_dict_weight := False;
            corrected_candidate.dict_weight := 0;
            corrected_candidate.score := expanded_tail_score;
            remember_segment_path_for_candidate(corrected_candidate.text, '',
                expanded_tail_path, corrected_candidate.score);
        end
        else if existing_index >= 0 then
        begin
            corrected_candidate := candidates[existing_index];
            Inc(corrected_candidate.score, c_modal_tail_finalize_bonus);
            corrected_candidate.source := cs_rule;
            corrected_candidate.comment := '';
            remove_fixed_quantity_modal_tail_mismatches_local(candidates);
        end
        else
        begin
            corrected_candidate := candidates[best_index];
            segment_path := get_segment_path_for_candidate(candidates[best_index]);
            segment_parts := segment_path.Split([c_segment_path_separator]);
            corrected_text := '';
            corrected_path := '';
            for part_idx := 0 to High(segment_parts) - 1 do
            begin
                corrected_text := corrected_text + Trim(segment_parts[part_idx]);
                if corrected_path = '' then
                begin
                    corrected_path := Trim(segment_parts[part_idx]);
                end
                else
                begin
                    corrected_path := corrected_path + c_segment_path_separator +
                        Trim(segment_parts[part_idx]);
                end;
            end;
            corrected_text := corrected_text + expected_text;
            if corrected_path = '' then
            begin
                corrected_path := expected_text;
            end
            else
            begin
                corrected_path := corrected_path + c_segment_path_separator + expected_text;
            end;

            corrected_candidate.text := corrected_text;
            corrected_candidate.comment := '';
            corrected_candidate.source := cs_rule;
            corrected_candidate.has_dict_weight := False;
            corrected_candidate.dict_weight := 0;
            Inc(corrected_candidate.score, c_modal_tail_finalize_bonus);
            corrected_candidate.comment := '';
            remember_segment_path_for_candidate(corrected_candidate.text, '',
                corrected_path, corrected_candidate.score);
        end;

        for idx := Length(candidates) - 1 downto 1 do
        begin
            candidates[idx] := candidates[idx - 1];
        end;
        candidates[0] := corrected_candidate;
        remove_fixed_quantity_modal_tail_mismatches_local(candidates);
    end;

    function build_segment_candidates_timed(out out_candidates: TncCandidateList;
        const include_full_path: Boolean = True;
        const allow_relaxed_split: Boolean = False): Boolean;
    var
        phase_start_tick: UInt64;
        local_path_search_elapsed_ms: Int64;
    begin
        phase_start_tick := GetTickCount64;
        local_path_search_elapsed_ms := 0;
        Result := build_segment_candidates(out_candidates, include_full_path, local_path_search_elapsed_ms,
            allow_relaxed_split);
        Inc(segment_elapsed_ms, Int64(GetTickCount64 - phase_start_tick));
        Inc(path_search_elapsed_ms, local_path_search_elapsed_ms);
    end;

    procedure sort_candidates_timed(var candidates: TncCandidateList);
    var
        phase_start_tick: UInt64;
        elapsed_ms_local: UInt64;
    begin
        phase_start_tick := GetTickCount64;
        sort_candidates(candidates);
        elapsed_ms_local := GetTickCount64 - phase_start_tick;
        Inc(sort_elapsed_ms, Int64(elapsed_ms_local));
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' sort=[n=%d ms=%d]',
                [Length(candidates), elapsed_ms_local]);
