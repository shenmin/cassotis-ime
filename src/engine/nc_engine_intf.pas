    function display_text_is_primary_for_query_key_outer(const query_key: string;
        const text_value: string; const text_units: Integer): Boolean;
    const
        c_probe_limit = 6;
    var
        ranked_results_local: TncCandidateList;
        ranked_idx_local: Integer;
        ranked_text_local: string;
        cache_key_local: string;
        lookup_cache_key_local: string;
        exact_cache_key_local: string;
        cached_state_local: Integer;
        build_hit_local: Boolean;

        procedure cache_result_local;
        begin
            if (m_lookup_display_feature_cache <> nil) and
                (cache_key_local <> '') then
            begin
                if Result then
                begin
                    cached_state_local := 1;
                end
                else
                begin
                    cached_state_local := 0;
                end;
                m_lookup_display_feature_cache.AddOrSetValue(cache_key_local,
                    cached_state_local);
            end;
        end;
    begin
        Result := True;
        cache_key_local := '';
        if (m_dictionary = nil) or (query_key = '') or (text_value = '') or
            (text_units <= 1) then
        begin
            Exit;
        end;

        cache_key_local := 'primary' + #1 + LowerCase(Trim(query_key)) + #1 +
            Trim(text_value) + #1 + IntToStr(text_units);
        if (m_lookup_display_feature_cache <> nil) and
            m_lookup_display_feature_cache.TryGetValue(cache_key_local,
            cached_state_local) then
        begin
            Exit(cached_state_local > 0);
        end;

        lookup_cache_key_local := '#lookup#' + query_key;
        build_hit_local := (m_build_lookup_cache <> nil) and
            (m_build_lookup_cache.TryGetValue(lookup_cache_key_local,
            ranked_results_local) or
            m_build_lookup_cache.TryGetValue(query_key,
            ranked_results_local));
        // Long-path subspan analysis normally populated the strict exact
        // bucket already. For an exact multi-character segment that bucket
        // has the same primary-word semantics and avoids another broad SQL
        // lookup for every segment in the path.
        exact_cache_key_local := '#exact#' + query_key;
        if (not build_hit_local) and (m_build_lookup_cache <> nil) then
        begin
            build_hit_local := m_build_lookup_cache.TryGetValue(
                exact_cache_key_local, ranked_results_local);
        end;
        if not build_hit_local then
        begin
            if not m_dictionary.lookup(query_key, ranked_results_local) then
            begin
                cache_result_local;
                Exit;
            end;
            if m_build_lookup_cache <> nil then
            begin
                m_build_lookup_cache.AddOrSetValue(lookup_cache_key_local,
                    ranked_results_local);
            end;
        end;
        for ranked_idx_local := 0 to
            Min(High(ranked_results_local), c_probe_limit - 1) do
        begin
            ranked_text_local := Trim(
                ranked_results_local[ranked_idx_local].text);
            if (Trim(ranked_results_local[ranked_idx_local].comment) <> '') or
                (ranked_text_local = '') or
                (get_candidate_text_unit_count(ranked_text_local) <>
                text_units) then
            begin
                Continue;
            end;

            Result := SameText(ranked_text_local, text_value);
            cache_result_local;
            Exit;
        end;
        cache_result_local;
    end;

    function display_path_has_nonprimary_multi_char_segment_outer(
        const path_value: string): Boolean;
    var
        cache_key_local: string;
        cache_value_local: TncLongPathStructureCacheValue;
        path_parts_local: TArray<string>;
        part_idx_local: Integer;
        segment_text_local: string;
        segment_units_local: Integer;
        segment_start_local: Integer;
        segment_key_local: string;

        procedure cache_result_local;
        begin
            if (m_lookup_long_path_structure_cache = nil) or
                (cache_key_local = '') then
            begin
                Exit;
            end;
            if not m_lookup_long_path_structure_cache.TryGetValue(
                cache_key_local, cache_value_local) then
            begin
                FillChar(cache_value_local, SizeOf(cache_value_local), 0);
            end;
            if Result then
            begin
                cache_value_local.nonprimary_multi_char_state := 2;
            end
            else
            begin
                cache_value_local.nonprimary_multi_char_state := 1;
            end;
            m_lookup_long_path_structure_cache.AddOrSetValue(cache_key_local,
                cache_value_local);
        end;
    begin
        Result := False;
        cache_key_local := Trim(path_value);
        if (m_dictionary = nil) or (path_value = '') or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;
        if (m_lookup_long_path_structure_cache <> nil) and
            m_lookup_long_path_structure_cache.TryGetValue(cache_key_local,
            cache_value_local) and
            (cache_value_local.nonprimary_multi_char_state <> 0) then
        begin
            Exit(cache_value_local.nonprimary_multi_char_state = 2);
        end;
        path_parts_local := path_value.Split([c_segment_path_separator]);
        if Length(path_parts_local) <= 1 then
        begin
            cache_result_local;
            Exit;
        end;

        segment_start_local := 0;
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            segment_text_local := Trim(path_parts_local[part_idx_local]);
            segment_units_local := get_candidate_text_unit_count(segment_text_local);
            if (segment_text_local = '') or (segment_units_local <= 0) or
                (segment_start_local + segment_units_local > expected_units) then
            begin
                Exit;
            end;

            if segment_units_local >= 2 then
            begin
                segment_key_local := build_display_query_key(segment_start_local,
                    segment_units_local);
                if not display_text_is_primary_for_query_key_outer(
                    segment_key_local, segment_text_local,
                    segment_units_local) then
                begin
                    Result := True;
                    cache_result_local;
                    Exit;
                end;
            end;

            Inc(segment_start_local, segment_units_local);
        end;
        cache_result_local;
    end;

    function display_path_multi_char_segment_count_outer(
        const path_value: string): Integer;
    var
        path_parts_local: TArray<string>;
        part_idx_local: Integer;
    begin
        Result := 0;
        if Trim(path_value) = '' then
        begin
            Exit;
        end;

        path_parts_local := path_value.Split([c_segment_path_separator]);
        for part_idx_local := 0 to High(path_parts_local) do
        begin
            if get_candidate_text_unit_count(Trim(path_parts_local[part_idx_local])) >= 2 then
            begin
                Inc(Result);
            end;
        end;
    end;

    function get_display_fixed_tail_alignment_score_outer(
        const candidate_value: TncCandidate): Integer;
    var
        cache_key_local: string;
        candidate_units: TArray<string>;
        expected_tail_text: string;

        procedure store_result_local;
        begin
            if (m_lookup_display_feature_cache <> nil) and
                (cache_key_local <> '') then
            begin
                m_lookup_display_feature_cache.AddOrSetValue(cache_key_local,
                    Result);
            end;
        end;
    begin
        Result := 0;
        cache_key_local := '';
        if (expected_units < 3) or (Length(syllables) <> expected_units) or
            (Trim(candidate_value.comment) <> '') or
            (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
            expected_units) then
        begin
            Exit;
        end;
        cache_key_local := 'tail' + #1 + normalized_pinyin + #1 +
            Trim(candidate_value.text);
        if (m_lookup_display_feature_cache <> nil) and
            m_lookup_display_feature_cache.TryGetValue(cache_key_local,
            Result) then
        begin
            Exit;
        end;

        expected_tail_text := get_display_fixed_tail_text_outer(
            syllables[expected_units - 1].text);
        if expected_tail_text = '' then
        begin
            store_result_local;
            Exit;
        end;

        candidate_units := split_text_units(Trim(candidate_value.text));
        if Length(candidate_units) <> expected_units then
        begin
            store_result_local;
            Exit;
        end;

        if display_candidate_has_nonmatching_exact_suffix_phrase_outer(
            Trim(candidate_value.text), 2, 4) then
        begin
            Dec(Result, 16000);
            store_result_local;
            Exit;
        end;
        if display_candidate_has_exact_suffix_phrase_outer(Trim(candidate_value.text),
            2, 4) then
        begin
            store_result_local;
            Exit;
        end;

        if SameText(Trim(candidate_units[High(candidate_units)]),
            expected_tail_text) then
        begin
            Inc(Result, 16000);
        end
        else
        begin
            Dec(Result, 16000);
        end;
        store_result_local;
    end;

    function get_display_fixed_quantity_alignment_score_outer(
        const candidate_value: TncCandidate): Integer;
    var
        candidate_units: TArray<string>;
        syllable_idx: Integer;
        expected_tail_text: string;
    begin
        Result := 0;
        if (expected_units < 4) or (Length(syllables) <> expected_units) or
            (Trim(candidate_value.comment) <> '') or
            (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
            expected_units) then
        begin
            Exit;
        end;

        candidate_units := split_text_units(Trim(candidate_value.text));
        if Length(candidate_units) <> expected_units then
        begin
            Exit;
        end;

        for syllable_idx := 0 to expected_units - 2 do
        begin
            if syllable_idx < expected_units - 3 then
            begin
                Continue;
            end;
            if normalize_pinyin_text(syllables[syllable_idx].text) <> 'yi' then
            begin
                Continue;
            end;

            expected_tail_text := get_display_quantity_tail_text_outer(
                syllables[syllable_idx + 1].text);
            if expected_tail_text = '' then
            begin
                Continue;
            end;

            if SameText(Trim(candidate_units[syllable_idx]),
                string(Char($4E00))) and
                SameText(Trim(candidate_units[syllable_idx + 1]),
                expected_tail_text) then
            begin
                Inc(Result, 22000);
            end
            else
            begin
                Dec(Result, 22000);
            end;
        end;
    end;

    procedure insert_fixed_tail_candidate_from_partial;
    var
        tail_key: string;
        tail_text: string;
        idx: Integer;
        duplicate_idx: Integer;
        found_duplicate: Boolean;
        head_text: string;
        head_key: string;
        head_units: Integer;
        repaired_text: string;
        repaired_candidate: TncCandidate;
        repaired_path: string;
        head_path: string;
        head_has_supported_exact_path: Boolean;

        function tail_accepts_supported_compound_head_local(
            const key_value: string): Boolean;
        var
            normalized_key_value: string;
        begin
            normalized_key_value := normalize_pinyin_text(key_value);
            Result := SameText(normalized_key_value, 'de') or
                SameText(normalized_key_value, 'le') or
                SameText(normalized_key_value, 'ba') or
                SameText(normalized_key_value, 'ma');
        end;

        function get_supported_exact_head_path_local(
            const candidate_idx: Integer; const local_head_units: Integer;
            out path_value: string): Boolean;
        var
            path_parts: TArray<string>;
            part_idx: Integer;
            segment_start: Integer;
            segment_text: string;
            segment_units: Integer;
            segment_key: string;
            head_query_key: string;
            evidence_path: string;
            evidence_score: Integer;
            has_supported_path: Boolean;
        begin
            Result := False;
            path_value := '';
            if (candidate_idx < 0) or (candidate_idx > High(m_candidates)) or
                (local_head_units < 2) then
            begin
                Exit;
            end;

            path_value := get_display_candidate_path_for_index(
                m_candidates[candidate_idx], candidate_idx);
            head_query_key := build_display_query_key(0, local_head_units);
            has_supported_path :=
                m_candidates[candidate_idx].display_kind = cdk_lm_compound;

            // Display styling is assigned late and may be absent after an
            // incremental reuse step. Validate supported compositions from
            // the same LM evidence that admitted the path instead of treating
            // the blue display marker as semantic state.
            if (local_head_units = 4) and (head_query_key <> '') and
                get_short_four_two_exact_path_evidence(head_query_key,
                Trim(m_candidates[candidate_idx].text), evidence_path,
                evidence_score) then
            begin
                path_value := evidence_path;
                has_supported_path := True;
            end
            else if (local_head_units = 3) and (head_query_key <> '') and
                is_current_short_three_exact_pair_candidate_supported(
                head_query_key, Trim(m_candidates[candidate_idx].text)) then
            begin
                has_supported_path := True;
            end
            else if (local_head_units = 2) and (head_query_key <> '') and
                is_current_short_two_single_pair_candidate_supported(
                head_query_key, Trim(m_candidates[candidate_idx].text)) then
            begin
                has_supported_path := True;
            end;
            if not has_supported_path then
            begin
                path_value := '';
                Exit;
            end;

            if get_encoded_path_segment_count_local(path_value) <= 1 then
            begin
                path_value := '';
                Exit;
            end;

            path_parts := path_value.Split([c_segment_path_separator]);
            segment_start := 0;
            for part_idx := 0 to High(path_parts) do
            begin
                segment_text := Trim(path_parts[part_idx]);
                segment_units := get_candidate_text_unit_count(segment_text);
                if (segment_text = '') or (segment_units <= 0) or
                    (segment_start + segment_units > local_head_units) then
                begin
                    path_value := '';
                    Exit;
                end;

                segment_key := build_display_query_key(segment_start,
                    segment_units);
                if (segment_key = '') or
                    (not (display_exact_key_has_text(segment_key,
                    segment_text) or m_dictionary.is_base_entry(segment_key,
                    segment_text) or m_dictionary.is_user_entry(segment_key,
                    segment_text))) then
                begin
                    path_value := '';
                    Exit;
                end;
                Inc(segment_start, segment_units);
            end;
            Result := segment_start = local_head_units;
            if not Result then
            begin
                path_value := '';
            end;
        end;

        procedure insert_forced_compound_tail_candidate_local;
        var
            candidate_local: TncCandidate;
            head_units_local: TArray<string>;
            left_text_local: string;
            right_text_local: string;
            left_key_local: string;
            right_key_local: string;
            inferred_path_local: string;
            existing_idx_local: Integer;
        begin
            if (expected_units <> 5) or
                (not tail_accepts_supported_compound_head_local(tail_key)) or
                (m_dictionary = nil) or
                (not m_has_forced_visible_top_candidate) or
                (not m_forced_visible_top_from_incremental_lm_prefix) or
                (m_forced_visible_top_candidate.display_kind <>
                cdk_lm_compound) or
                (not SameText(m_forced_visible_top_composition_text,
                m_composition_text)) or
                (not SameText(m_forced_visible_top_lookup_key,
                m_last_lookup_key)) or
                (not SameText(normalize_pinyin_text(Trim(
                m_forced_visible_top_candidate.comment)), tail_key)) or
                (get_candidate_text_unit_count(Trim(
                m_forced_visible_top_candidate.text)) <> 4) then
            begin
                Exit;
            end;

            candidate_local := m_forced_visible_top_candidate;
            head_units_local := split_text_units(Trim(candidate_local.text));
            if Length(head_units_local) <> 4 then
            begin
                Exit;
            end;
            left_text_local := head_units_local[0] + head_units_local[1];
            right_text_local := head_units_local[2] + head_units_local[3];
            left_key_local := build_display_query_key(0, 2);
            right_key_local := build_display_query_key(2, 2);
            if (left_key_local = '') or (right_key_local = '') or
                (not (display_exact_key_has_text(left_key_local,
                left_text_local) or m_dictionary.is_base_entry(left_key_local,
                left_text_local) or m_dictionary.is_user_entry(left_key_local,
                left_text_local))) or
                (not (display_exact_key_has_text(right_key_local,
                right_text_local) or m_dictionary.is_base_entry(right_key_local,
                right_text_local) or m_dictionary.is_user_entry(right_key_local,
                right_text_local))) then
            begin
                Exit;
            end;

            inferred_path_local := left_text_local +
                c_segment_path_separator + right_text_local +
                c_segment_path_separator + tail_text;
            candidate_local.text := Trim(candidate_local.text) + tail_text;
            candidate_local.comment := '';
            candidate_local.source := cs_rule;
            candidate_local.has_dict_weight := False;
            candidate_local.dict_weight := 0;
            candidate_local.display_kind := cdk_default;
            Inc(candidate_local.score, 20000);
            existing_idx_local := find_display_candidate(candidate_local.text,
                '');
            if existing_idx_local >= 0 then
            begin
                move_display_candidate_to_front(existing_idx_local);
                Exit;
            end;

            insert_display_candidate(candidate_local, inferred_path_local, 0);
            existing_idx_local := find_display_candidate(candidate_local.text,
                '');
            if existing_idx_local > 0 then
            begin
                move_display_candidate_to_front(existing_idx_local);
            end;
        end;

        function head_crosses_stronger_exact_pair_local(
            const candidate_idx: Integer; const local_head_text: string;
            const local_head_units: Integer): Boolean;
        const
            c_min_protected_pair_weight = 700;
            c_pair_weight_margin = 400;
        var
            local_units: TArray<string>;
            pair_pos: Integer;
            pair_key: string;
            pair_text: string;
            best_pair_text: string;
            best_pair_weight: Integer;
            current_pair_weight: Integer;

            function has_supported_exact_boundary_local(
                const local_pair_pos: Integer): Boolean;
            var
                local_path: string;
                local_parts: TArray<string>;
                local_part_idx: Integer;
                local_pos: Integer;
                left_text: string;
                right_text: string;
                left_units: Integer;
                right_units: Integer;
                left_key: string;
                right_key: string;
            begin
                Result := False;
                local_path := get_display_candidate_path_for_index(
                    m_candidates[candidate_idx], candidate_idx);
                if get_encoded_path_segment_count_local(local_path) <= 1 then
                begin
                    Exit;
                end;

                local_parts := local_path.Split([c_segment_path_separator]);
                local_pos := 0;
                for local_part_idx := 0 to High(local_parts) - 1 do
                begin
                    left_text := Trim(local_parts[local_part_idx]);
                    right_text := Trim(local_parts[local_part_idx + 1]);
                    left_units := get_candidate_text_unit_count(left_text);
                    right_units := get_candidate_text_unit_count(right_text);
                    if left_units <= 0 then
                    begin
                        Exit;
                    end;

                    if local_pos + left_units - 1 = local_pair_pos then
                    begin
                        // A true exact-word boundary such as 鎺ㄩ€?涓€娆?should not
                        // be overridden by an internal two-syllable alternative
                        // like songyi.  Single ordinary trailing characters do
                        // not provide the same evidence.
                        if (left_units >= 2) and (right_units >= 2) then
                        begin
                            left_key := build_display_query_key(local_pos,
                                left_units);
                            right_key := build_display_query_key(
                                local_pos + left_units, right_units);
                            Result := (left_key <> '') and (right_key <> '') and
                                display_exact_key_has_text(left_key,
                                left_text) and
                                display_exact_key_has_text(right_key,
                                right_text);
                        end;
                        Exit;
                    end;

                    Inc(local_pos, left_units);
                end;
            end;
        begin
            Result := False;
            if local_head_units < 3 then
            begin
                Exit;
            end;

            local_units := split_text_units(local_head_text);
            if Length(local_units) <> local_head_units then
            begin
                Exit;
            end;

            for pair_pos := 0 to local_head_units - 2 do
            begin
                pair_key := build_display_query_key(pair_pos, 2);
                if (pair_key = '') or
                    (not try_get_display_exact_phrase(pair_pos, 2,
                    best_pair_text, best_pair_weight)) or
                    (best_pair_weight < c_min_protected_pair_weight) then
                begin
                    Continue;
                end;

                pair_text := Trim(local_units[pair_pos]) +
                    Trim(local_units[pair_pos + 1]);
                if SameText(pair_text, best_pair_text) then
                begin
                    Continue;
                end;

                current_pair_weight := 0;
                get_display_exact_text_weight(pair_key, pair_text, 2,
                    current_pair_weight);
                if (current_pair_weight > 0) and
                    (best_pair_weight < current_pair_weight +
                    c_pair_weight_margin) then
                begin
                    Continue;
                end;

                if has_supported_exact_boundary_local(pair_pos) then
                begin
                    Continue;
                end;

                Exit(True);
            end;
        end;
    begin
        if (expected_units < 3) or (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables[expected_units - 1].text);
        tail_text := get_display_fixed_tail_text_outer(tail_key);
        if tail_text = '' then
        begin
            Exit;
        end;

        insert_forced_compound_tail_candidate_local;

        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if not SameText(Trim(m_candidates[idx].comment), tail_key) then
            begin
                Continue;
            end;

            head_text := Trim(m_candidates[idx].text);
            head_units := get_candidate_text_unit_count(head_text);
            if head_units <> expected_units - 1 then
            begin
                Continue;
            end;
            head_has_supported_exact_path :=
                tail_accepts_supported_compound_head_local(tail_key) and
                get_supported_exact_head_path_local(idx, head_units,
                head_path);
            head_key := build_display_query_key(0, head_units);
            if (expected_units = 4) and (head_key <> '') and
                (not display_exact_key_has_text(head_key, head_text)) then
            begin
                Continue;
            end;
            if (expected_units = 4) and
                head_crosses_stronger_exact_pair_local(idx, head_text,
                head_units) then
            begin
                Continue;
            end;
            if (head_key <> '') and
                display_exact_key_has_any_complete_text(head_key,
                head_units) and
                (not display_exact_key_has_text(head_key, head_text)) and
                (not head_has_supported_exact_path) then
            begin
                Continue;
            end;

            repaired_text := head_text + tail_text;
            found_duplicate := False;
            for duplicate_idx := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[duplicate_idx].text),
                    repaired_text) and
                    (Trim(m_candidates[duplicate_idx].comment) = '') then
                begin
                    found_duplicate := True;
                    Break;
                end;
            end;

            if found_duplicate then
            begin
                move_display_candidate_to_front(duplicate_idx);
                Exit;
            end;

            repaired_candidate := m_candidates[idx];
            repaired_candidate.text := repaired_text;
            repaired_candidate.comment := '';
            repaired_candidate.source := cs_rule;
            repaired_candidate.has_dict_weight := False;
            repaired_candidate.dict_weight := 0;
            Inc(repaired_candidate.score, 20000);
            if head_has_supported_exact_path then
            begin
                repaired_path := head_path + c_segment_path_separator +
                    tail_text;
            end
            else
            begin
                repaired_path := head_text + c_segment_path_separator +
                    tail_text;
            end;
            insert_display_candidate(repaired_candidate, repaired_path, 0);
            Exit;
        end;
    end;

    procedure insert_fixed_leading_tail_exact_completion_from_partial;
    const
        c_default_probe_limit = 8;
        c_long_probe_limit = 24;
    var
        idx: Integer;
        probe_limit: Integer;
        duplicate_idx: Integer;
        result_idx: Integer;
        head_text: string;
        head_key: string;
        head_units: Integer;
        comment_key: string;
        tail_syllables: TncPinyinParseResult;
        first_tail_key: string;
        first_tail_text: string;
        remaining_tail_key: string;
        remaining_tail_text: string;
        repaired_text: string;
        repaired_path: string;
        repaired_candidate: TncCandidate;
        exact_results: TncCandidateList;
        syllable_idx: Integer;
        expected_remaining_units: Integer;
        found_duplicate: Boolean;
        inferred_path: string;
        inferred_score: Integer;
        inferred_segments: Integer;
        best_repaired_text: string;
        best_repaired_path: string;
        best_repaired_candidate: TncCandidate;
        best_inferred_score: Integer;
        best_inferred_segments: Integer;
        has_best_repair: Boolean;
    begin
        if (expected_units < 4) or (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        probe_limit := c_default_probe_limit;
        if expected_units >= 5 then
        begin
            probe_limit := c_long_probe_limit;
        end;
        has_best_repair := False;
        best_inferred_score := Low(Integer);
        best_inferred_segments := MaxInt;

        for idx := 0 to Min(probe_limit, High(m_candidates)) do
        begin
            head_text := Trim(m_candidates[idx].text);
            comment_key := normalize_pinyin_text(Trim(m_candidates[idx].comment));
            if (head_text = '') or (comment_key = '') then
            begin
                Continue;
            end;

            tail_syllables := get_effective_compact_pinyin_syllables(
                comment_key);
            if (Length(tail_syllables) < 2) or
                (get_candidate_text_unit_count(head_text) +
                Length(tail_syllables) <> expected_units) then
            begin
                Continue;
            end;
            head_units := get_candidate_text_unit_count(head_text);
            head_key := build_display_query_key(0, head_units);
            if (head_key <> '') and
                display_exact_key_has_any_complete_text(head_key,
                head_units) and
                (not display_exact_key_has_text(head_key, head_text)) then
            begin
                Continue;
            end;

            first_tail_key := normalize_pinyin_text(tail_syllables[0].text);
            first_tail_text := get_display_fixed_tail_text_outer(
                first_tail_key);
            if first_tail_text = '' then
            begin
                Continue;
            end;

            remaining_tail_key := '';
            for syllable_idx := 1 to High(tail_syllables) do
            begin
                remaining_tail_key := remaining_tail_key +
                    normalize_pinyin_text(tail_syllables[syllable_idx].text);
            end;
            expected_remaining_units := Length(tail_syllables) - 1;
            if (remaining_tail_key = '') or
                (not lookup_display_exact_cached(remaining_tail_key,
                exact_results)) then
            begin
                Continue;
            end;

            for result_idx := 0 to High(exact_results) do
            begin
                if result_idx >= 8 then
                begin
                    Break;
                end;
                remaining_tail_text := Trim(exact_results[result_idx].text);
                if (Trim(exact_results[result_idx].comment) <> '') or
                    (remaining_tail_text = '') or
                    (get_candidate_text_unit_count(remaining_tail_text) <>
                    expected_remaining_units) then
                begin
                    Continue;
                end;

                repaired_text := head_text + first_tail_text +
                    remaining_tail_text;
                if expected_units >= 5 then
                begin
                    inferred_path :=
                        infer_segment_path_for_query_text_with_score(
                        normalized_pinyin, repaired_text,
                        inferred_score, inferred_segments, False);
                    if inferred_path = '' then
                    begin
                        Continue;
                    end;
                    if (not has_best_repair) or
                        (inferred_score > best_inferred_score) or
                        ((inferred_score = best_inferred_score) and
                        (inferred_segments < best_inferred_segments)) or
                        ((inferred_score = best_inferred_score) and
                        (inferred_segments = best_inferred_segments) and
                        (m_candidates[idx].score >
                        best_repaired_candidate.score)) then
                    begin
                        has_best_repair := True;
                        best_inferred_score := inferred_score;
                        best_inferred_segments := inferred_segments;
                        best_repaired_text := repaired_text;
                        best_repaired_path := inferred_path;
                        best_repaired_candidate := m_candidates[idx];
                    end;
                    Continue;
                end;

                found_duplicate := False;
                for duplicate_idx := 0 to High(m_candidates) do
                begin
                    if SameText(Trim(m_candidates[duplicate_idx].text),
                        repaired_text) and
                        (Trim(m_candidates[duplicate_idx].comment) = '') then
                    begin
                        move_display_candidate_to_index(duplicate_idx, 0);
                        found_duplicate := True;
                        Break;
                    end;
                end;
                if found_duplicate then
                begin
                    Exit;
                end;

                repaired_candidate := m_candidates[idx];
                repaired_candidate.text := repaired_text;
                repaired_candidate.comment := '';
                repaired_candidate.source := cs_rule;
                repaired_candidate.has_dict_weight := False;
                repaired_candidate.dict_weight := 0;
                Inc(repaired_candidate.score, 22000);
                repaired_path := head_text + c_segment_path_separator +
                    first_tail_text + c_segment_path_separator +
                    remaining_tail_text;
                insert_display_candidate(repaired_candidate, repaired_path, 0);
                Exit;
            end;
        end;

        if not has_best_repair then
        begin
            Exit;
        end;
        for duplicate_idx := 0 to High(m_candidates) do
        begin
            if SameText(Trim(m_candidates[duplicate_idx].text),
                best_repaired_text) and
                (Trim(m_candidates[duplicate_idx].comment) = '') then
            begin
                move_display_candidate_to_index(duplicate_idx, 0);
                Exit;
            end;
        end;

        repaired_candidate := best_repaired_candidate;
        repaired_candidate.text := best_repaired_text;
        repaired_candidate.comment := '';
        repaired_candidate.source := cs_rule;
        repaired_candidate.has_dict_weight := False;
        repaired_candidate.dict_weight := 0;
        Inc(repaired_candidate.score, 22000);
        insert_display_candidate(repaired_candidate, best_repaired_path, 0);
    end;

    procedure insert_fixed_quantity_tail_candidate_from_partial;
    var
        tail_key: string;
        tail_text: string;
        quantity_text: string;
        fixed_head_text: string;
        idx: Integer;
        duplicate_idx: Integer;
        found_duplicate: Boolean;
        head_text: string;
        head_units: Integer;
        head_text_units: TArray<string>;
        fixed_head_units: TArray<string>;
        suffix_idx: Integer;
        unit_idx: Integer;
        suffix_matches: Boolean;
        repaired_text: string;
        repaired_candidate: TncCandidate;
        repaired_path: string;
    begin
        if (expected_units < 4) or (Length(syllables) <> expected_units) or
            (normalize_pinyin_text(syllables[expected_units - 3].text) <> 'yi') then
        begin
            Exit;
        end;

        tail_key := normalize_pinyin_text(syllables[expected_units - 1].text);
        tail_text := get_display_fixed_tail_text_outer(tail_key);
        quantity_text := get_display_quantity_tail_text_outer(
            syllables[expected_units - 2].text);
        if (tail_key = '') or (tail_text = '') or (quantity_text = '') then
        begin
            Exit;
        end;

        fixed_head_text := string(Char($4E00)) + quantity_text;
        fixed_head_units := split_text_units(fixed_head_text);
        if Length(fixed_head_units) = 0 then
        begin
            Exit;
        end;

        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if not SameText(normalize_pinyin_text(Trim(m_candidates[idx].comment)),
                tail_key) then
            begin
                Continue;
            end;

            head_text := Trim(m_candidates[idx].text);
            head_units := get_candidate_text_unit_count(head_text);
            if head_units <> expected_units - 1 then
            begin
                Continue;
            end;

            head_text_units := split_text_units(head_text);
            if Length(head_text_units) < Length(fixed_head_units) then
            begin
                Continue;
            end;

            suffix_matches := True;
            for suffix_idx := 0 to High(fixed_head_units) do
            begin
                unit_idx := Length(head_text_units) - Length(fixed_head_units) +
                    suffix_idx;
                if not SameText(Trim(head_text_units[unit_idx]),
                    Trim(fixed_head_units[suffix_idx])) then
                begin
                    suffix_matches := False;
                    Break;
                end;
            end;
            if not suffix_matches then
            begin
                Continue;
            end;

            repaired_text := head_text + tail_text;
            found_duplicate := False;
            for duplicate_idx := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[duplicate_idx].text),
                    repaired_text) and
                    (Trim(m_candidates[duplicate_idx].comment) = '') then
                begin
                    move_display_candidate_to_front(duplicate_idx);
                    found_duplicate := True;
                    Break;
                end;
            end;
            if found_duplicate then
            begin
                Exit;
            end;

            repaired_candidate := m_candidates[idx];
            repaired_candidate.text := repaired_text;
            repaired_candidate.comment := '';
            repaired_candidate.source := cs_rule;
            repaired_candidate.has_dict_weight := False;
            repaired_candidate.dict_weight := 0;
            Inc(repaired_candidate.score, 60000);
            repaired_path := head_text + c_segment_path_separator + tail_text;
            insert_display_candidate(repaired_candidate, repaired_path, 0);
            Exit;
        end;
    end;

    procedure remove_bad_fixed_tail_candidates;
    var
        idx: Integer;
        out_idx: Integer;
        has_good_fixed_tail: Boolean;
        alignment_score: Integer;
        quantity_score: Integer;
    begin
        if (expected_units < 4) or (Length(m_candidates) = 0) then
        begin
            Exit;
        end;

        has_good_fixed_tail := False;
        for idx := 0 to Min(8, High(m_candidates)) do
        begin
            if (get_display_fixed_tail_alignment_score_outer(m_candidates[idx]) > 0) or
                (get_display_fixed_quantity_alignment_score_outer(
                m_candidates[idx]) > 0) then
            begin
                has_good_fixed_tail := True;
                Break;
            end;
        end;
        if not has_good_fixed_tail then
        begin
            Exit;
        end;

        out_idx := 0;
        for idx := 0 to High(m_candidates) do
        begin
            alignment_score := get_display_fixed_tail_alignment_score_outer(
                m_candidates[idx]);
            quantity_score := get_display_fixed_quantity_alignment_score_outer(
                m_candidates[idx]);
            if (quantity_score < 0) or
                ((quantity_score <= 0) and (alignment_score < 0) and
                (not display_candidate_is_exact_full_dictionary_entry(
                normalized_pinyin, m_candidates[idx]))) then
            begin
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        SetLength(m_candidates, out_idx);
        if Length(m_candidate_segment_paths) > out_idx then
        begin
            SetLength(m_candidate_segment_paths, out_idx);
        end;
    end;

    function is_all_initial_display_query: Boolean;
    var
        idx: Integer;
        ch: Char;
    begin
        Result := False;
        if Length(normalized_pinyin) < 5 then
        begin
            Exit;
        end;

        for idx := 1 to Length(normalized_pinyin) do
        begin
            ch := normalized_pinyin[idx];
            if Pos(string(ch), 'bpmfdtnlgkhjqxzcsryw') <= 0 then
            begin
                Exit;
            end;
        end;

        Result := True;
    end;

    procedure remove_complete_candidates_for_all_initial_query;
    var
        idx: Integer;
