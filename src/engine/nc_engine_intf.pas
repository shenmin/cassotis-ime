function TncEngine.get_dictionary_debug_info: string;
var
    sqlite_dict: TncSqliteDictionary;
    provider_name: string;
    ready_value: Integer;
    base_ready_value: Integer;
    user_ready_value: Integer;
    path_value: string;
    path_exists: Integer;
    sc_path_value: string;
    sc_path_exists: Integer;
    tc_path_value: string;
    tc_path_exists: Integer;
    user_path_value: string;
    user_path_exists: Integer;
    variant_text: string;
    active_path: string;
begin
    provider_name := 'none';
    ready_value := 0;
    base_ready_value := 0;
    user_ready_value := 0;
    path_value := '';
    path_exists := 0;
    sc_path_value := '';
    sc_path_exists := 0;
    tc_path_value := '';
    tc_path_exists := 0;
    user_path_value := '';
    user_path_exists := 0;
    active_path := get_active_dictionary_path;
    if m_config.dictionary_variant = dv_traditional then
    begin
        variant_text := 'traditional';
    end
    else
    begin
        variant_text := 'simplified';
    end;

    if m_dictionary is TncSqliteDictionary then
    begin
        sqlite_dict := TncSqliteDictionary(m_dictionary);
        provider_name := 'sqlite';
        ready_value := Ord(sqlite_dict.ready);
        base_ready_value := Ord(sqlite_dict.base_ready);
        user_ready_value := Ord(sqlite_dict.user_ready);
        path_value := sqlite_dict.db_path;
        user_path_value := sqlite_dict.user_db_path;
    end
    else if m_dictionary is TncInMemoryDictionary then
    begin
        provider_name := 'memory';
    end;

    if path_value = '' then
        path_value := active_path;
    if (path_value <> '') and FileExists(path_value) then
    begin
        path_exists := 1;
    end;

    sc_path_value := get_default_dictionary_path_simplified;
    if (sc_path_value <> '') and FileExists(sc_path_value) then
    begin
        sc_path_exists := 1;
    end;

    tc_path_value := get_default_dictionary_path_traditional;
    if (tc_path_value <> '') and FileExists(tc_path_value) then
    begin
        tc_path_exists := 1;
    end;

    if not (m_dictionary is TncSqliteDictionary) then
        user_path_value := get_default_user_dictionary_path;
    if (user_path_value <> '') and FileExists(user_path_value) then
    begin
        user_path_exists := 1;
    end;

    Result := Format('provider=%s ready=%d base_ready=%d user_ready=%d variant=%s dict_path=%s exists=%d dict_sc=%s sc_exists=%d dict_tc=%s tc_exists=%d user_path=%s user_exists=%d',
        [provider_name, ready_value, base_ready_value, user_ready_value, variant_text, path_value, path_exists,
        sc_path_value, sc_path_exists, tc_path_value, tc_path_exists, user_path_value, user_path_exists]);
end;

function TncEngine.should_handle_key(const key_code: Word; const key_state: TncKeyState): Boolean;
var
    key_char: Char;
    display_key_char: Char;
    punct_char: Char;
    has_candidates: Boolean;
    direct_commit_text: string;
begin
    Result := False;
    if nc_shortcut_matches(m_config.shortcuts.input_mode_toggle, key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if nc_shortcut_matches(m_config.shortcuts.full_width_toggle, key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if nc_shortcut_matches(m_config.shortcuts.punctuation_toggle, key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if key_state.ctrl_down or key_state.alt_down then
    begin
        Exit(False);
    end;

    if m_config.input_mode = im_english then
    begin
        Result := get_direct_ascii_commit_text(key_code, key_state, direct_commit_text);
        Exit;
    end;

    if is_alpha_key(key_code, key_state, key_char, display_key_char) then
    begin
        Result := True;
        Exit;
    end;

    if (key_code = VK_OEM_1) and (not key_state.shift_down) and
        nc_shuangpin_accepts_semicolon(m_config.pinyin_input_scheme,
        m_composition_display_text) then
    begin
        Result := True;
        Exit;
    end;

    if (m_one_key_completion.text <> '') and
        nc_one_key_completion_matches(m_config.one_key_completion_key,
        key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if (m_config.one_key_completion_key = ock_backtick) and
        (m_composition_text <> '') and
        nc_one_key_completion_matches(m_config.one_key_completion_key,
        key_code, key_state) then
    begin
        Result := True;
        Exit;
    end;

    if get_punctuation_char(key_code, key_state, punct_char) then
    begin
        if m_composition_text <> '' then
        begin
            Result := True;
        end
        else
        begin
            Result := get_effective_punctuation_full_width or m_config.full_width_mode;
        end;
        Exit;
    end;

    has_candidates := Length(m_candidates) > 0;
    if (m_composition_text = '') and (m_confirmed_text = '') and
        (not has_candidates) and (m_one_key_completion.text = '') and
        (not m_has_pending_commit) then
    begin
        Exit(False);
    end;

    if nc_candidate_page_key_matches_next(
        m_config.candidate_page_key_scheme, key_code, key_state) or
        nc_candidate_page_key_matches_previous(
        m_config.candidate_page_key_scheme, key_code, key_state) then
    begin
        if (m_composition_text <> '') or (m_confirmed_text <> '') or
            has_candidates then
        begin
            Result := True;
            Exit;
        end;
    end;

    if (m_composition_text <> '') and (not key_state.shift_down) and (not key_state.ctrl_down) and (not key_state.alt_down) then
    begin
        case key_code of
            VK_LEFT, VK_RIGHT, VK_UP, VK_DOWN:
                begin
                    Result := True;
                    Exit;
                end;
        end;
    end;

    case key_code of
        VK_BACK,
        VK_OEM_7,
        VK_ESCAPE,
        VK_SPACE,
        VK_RETURN,
        VK_PRIOR,
        VK_NEXT:
            Result := True;
        Ord('1')..Ord('9'):
            Result := True;
    end;
end;

function TncEngine.commit_text(out out_text: string): Boolean;
var
    normalized_pinyin: string;
    remaining_pinyin: string;
    remaining_input_code: string;
    full_pinyin: string;
    segment: TncConfirmedSegment;
    prev_left_context: string;
    commit_text: string;
    commit_segment_text: string;
    commit_segment_path: string;
    effective_segment_path: string;
    inferred_segment_path: string;
    allow_learning: Boolean;
    learning_locked: Boolean;
    path_segments: TArray<string>;
    path_idx: Integer;
    path_start: Integer;
    path_text: string;
    combined_segment_path: string;
    confirmed_pinyin_prefix: string;
    confirmed_segment_path_prefix: string;
    explicit_commit_choice: Boolean;
    literal_commit_choice: Boolean;
    pending_fuzzy_choice: Boolean;
    pending_fuzzy_choice_text: string;
    fuzzy_commit_choice: Boolean;
    prev_prev_committed_text: string;
    prev_prev_committed_pinyin: string;
    previous_committed_text: string;
    previous_committed_pinyin: string;
    literal_only_commit: Boolean;
    literal_word_to_record: Boolean;
    literal_full_pinyin: string;

    function is_boundary_learning_unit(const text_value: string): Boolean;
    begin
        Result := False;
        if get_candidate_text_unit_count(text_value) <> 1 then
        begin
            Exit;
        end;

        case Ord(text_value[1]) of
            $7684, $5730, $5F97, $4E86, $7740:
                Result := True;
        end;
    end;

    function is_trailing_boundary_learning_unit(const text_value: string): Boolean;
    begin
        Result := is_boundary_learning_unit(text_value);
        if Result then
        begin
            Exit;
        end;

        Result := (get_candidate_text_unit_count(text_value) = 1) and
            (Ord(text_value[1]) = $518D);
    end;

    function is_boundary_noise_learning_text(const text_value: string): Boolean;
    var
        text_units: TArray<string>;
    begin
        Result := False;
        text_units := split_text_units(Trim(text_value));
        if Length(text_units) < 2 then
        begin
            Exit;
        end;

        Result := is_boundary_learning_unit(text_units[0]) or
            is_trailing_boundary_learning_unit(text_units[High(text_units)]);
    end;

    function should_persist_adjacent_commit_learning(const left_text: string;
        const right_text: string): Boolean;
    var
        combined_text: string;
    begin
        combined_text := Trim(left_text) + Trim(right_text);
        Result := (combined_text <> '') and
            (not is_boundary_noise_learning_text(combined_text)) and
            (not is_boundary_learning_unit(Trim(left_text))) and
            (not is_trailing_boundary_learning_unit(Trim(right_text)));
    end;

    function is_generated_short_particle_tail_commit(const query_value: string;
        const text_value: string): Boolean;
    var
        query_key_local: string;
        text_key_local: string;
        tail_key_local: string;
        tail_text_local: string;
        head_key_local: string;
        head_text_local: string;
        text_units_local: TArray<string>;
        head_unit_count_local: Integer;
        unit_idx_local: Integer;

        function try_get_tail_local: Boolean;
        begin
            Result := try_get_short_particle_tail_query_parts(query_key_local,
                tail_key_local, tail_text_local, head_key_local);
        end;
    begin
        Result := False;
        if m_dictionary = nil then
        begin
            Exit;
        end;

        query_key_local := normalize_pinyin_text(query_value);
        text_key_local := Trim(text_value);
        if (query_key_local = '') or (text_key_local = '') or
            (not is_full_pinyin_key(query_key_local)) or
            m_dictionary.is_base_entry(query_key_local, text_key_local) or
            m_dictionary.is_user_entry(query_key_local, text_key_local) or
            (not try_get_tail_local) then
        begin
            Exit;
        end;

        head_unit_count_local :=
            get_effective_compact_pinyin_unit_count(head_key_local);
        if (head_key_local = '') or (head_unit_count_local < 2) or
            (head_unit_count_local > 3) then
        begin
            Exit;
        end;

        text_units_local := split_text_units(text_key_local);
        if (Length(text_units_local) <> head_unit_count_local + 1) or
            (not SameText(Trim(text_units_local[High(text_units_local)]),
            tail_text_local)) then
        begin
            Exit;
        end;

        head_text_local := '';
        for unit_idx_local := 0 to High(text_units_local) - 1 do
        begin
            head_text_local := head_text_local + text_units_local[unit_idx_local];
        end;

        Result := (head_text_local <> '') and
            (m_dictionary.is_base_entry(head_key_local, head_text_local) or
            m_dictionary.is_user_entry(head_key_local, head_text_local));
    end;

    function get_path_segment_count(const encoded_path: string): Integer;
    var
        idx: Integer;
        trimmed_path: string;
    begin
        trimmed_path := Trim(encoded_path);
        if trimmed_path = '' then
        begin
            Exit(0);
        end;

        Result := 1;
        for idx := 1 to Length(trimmed_path) do
        begin
            if trimmed_path[idx] = c_segment_path_separator then
            begin
                Inc(Result);
            end;
        end;
    end;

    function is_high_confidence_segment_path(const encoded_path: string): Boolean;
    var
        idx: Integer;
        segment_start: Integer;
        segment_text: string;
        has_multi_char_segment: Boolean;
    begin
        Result := False;
        if get_path_segment_count(encoded_path) <= 1 then
        begin
            Exit;
        end;

        has_multi_char_segment := False;
        segment_start := 1;
        for idx := 1 to Length(encoded_path) + 1 do
        begin
            if (idx <= Length(encoded_path)) and (encoded_path[idx] <> c_segment_path_separator) then
            begin
                Continue;
            end;

            segment_text := Trim(Copy(encoded_path, segment_start, idx - segment_start));
            if segment_text <> '' then
            begin
                if get_candidate_text_unit_count(segment_text) >= 2 then
                begin
                    has_multi_char_segment := True;
                    Break;
                end;
            end;
            segment_start := idx + 1;
        end;

        Result := has_multi_char_segment;
    end;

    function get_path_text_unit_count(const encoded_path: string): Integer;
    var
        idx: Integer;
        segment_start: Integer;
        segment_text: string;
    begin
        Result := 0;
        segment_start := 1;
        for idx := 1 to Length(encoded_path) + 1 do
        begin
            if (idx <= Length(encoded_path)) and
                (encoded_path[idx] <> c_segment_path_separator) then
            begin
                Continue;
            end;

            segment_text := Trim(Copy(encoded_path, segment_start, idx - segment_start));
            segment_start := idx + 1;
            if segment_text <> '' then
            begin
                Inc(Result, get_candidate_text_unit_count(segment_text));
            end;
        end;
    end;

    function should_persist_segment_path(const encoded_path: string): Boolean;
    const
        c_max_persistent_path_units = 10;
    begin
        Result := (get_path_segment_count(encoded_path) > 1) and
            (get_path_text_unit_count(encoded_path) <= c_max_persistent_path_units);
    end;

    function should_persist_path_prefixes(const encoded_path: string): Boolean;
    const
        c_max_persistent_prefix_segments = 4;
    begin
        Result := should_persist_segment_path(encoded_path) and
            (get_path_segment_count(encoded_path) <= c_max_persistent_prefix_segments);
    end;

    procedure append_path_segment(const segment_text: string);
    var
        segment_index: Integer;
    begin
        path_text := Trim(segment_text);
        if path_text = '' then
        begin
            Exit;
        end;
        segment_index := Length(path_segments);
        SetLength(path_segments, segment_index + 1);
        path_segments[segment_index] := path_text;
        if combined_segment_path <> '' then
        begin
            combined_segment_path := combined_segment_path + c_segment_path_separator;
        end;
        combined_segment_path := combined_segment_path + path_text;
    end;

    procedure record_query_path_prefixes(const base_query_prefix: string; const base_path_prefix: string;
        const tail_full_path: string; const final_query: string; const final_path: string);
    var
        idx: Integer;
        prefix_start: Integer;
        segment_piece: string;
        prefix_path: string;
        prefix_query: string;
        combined_query: string;
        combined_path: string;
    begin
        if (m_dictionary = nil) or (tail_full_path = '') then
        begin
            Exit;
        end;

        prefix_path := '';
        prefix_start := 1;
        for idx := 1 to Length(tail_full_path) + 1 do
        begin
            if (idx <= Length(tail_full_path)) and (tail_full_path[idx] <> c_segment_path_separator) then
            begin
                Continue;
            end;

            segment_piece := Trim(Copy(tail_full_path, prefix_start, idx - prefix_start));
            prefix_start := idx + 1;
            if segment_piece = '' then
            begin
                Continue;
            end;

            if prefix_path <> '' then
            begin
                prefix_path := prefix_path + c_segment_path_separator;
            end;
            prefix_path := prefix_path + segment_piece;

            if get_path_segment_count(prefix_path) <= 1 then
            begin
                Continue;
            end;

            prefix_query := get_query_prefix_for_segment_path(prefix_path);
            if prefix_query = '' then
            begin
                Continue;
            end;

            combined_query := base_query_prefix + prefix_query;
            combined_path := prefix_path;
            if base_path_prefix <> '' then
            begin
                combined_path := base_path_prefix + c_segment_path_separator + combined_path;
            end;

            if (combined_query = '') or (combined_path = '') or
                ((combined_query = final_query) and (combined_path = final_path)) then
            begin
                Continue;
            end;

            m_dictionary.record_query_segment_path(combined_query, combined_path);
        end;
    end;

    procedure note_session_query_path_prefixes(const base_query_prefix: string; const base_path_prefix: string;
        const tail_full_path: string; const final_query: string; const final_path: string);
    var
        idx: Integer;
        prefix_start: Integer;
        segment_piece: string;
        prefix_path: string;
        prefix_query: string;
        combined_query: string;
        combined_path: string;
    begin
        if tail_full_path = '' then
        begin
            Exit;
        end;

        prefix_path := '';
        prefix_start := 1;
        for idx := 1 to Length(tail_full_path) + 1 do
        begin
            if (idx <= Length(tail_full_path)) and (tail_full_path[idx] <> c_segment_path_separator) then
            begin
                Continue;
            end;

            segment_piece := Trim(Copy(tail_full_path, prefix_start, idx - prefix_start));
            prefix_start := idx + 1;
            if segment_piece = '' then
            begin
                Continue;
            end;

            if prefix_path <> '' then
            begin
                prefix_path := prefix_path + c_segment_path_separator;
            end;
            prefix_path := prefix_path + segment_piece;

            if get_path_segment_count(prefix_path) <= 1 then
            begin
                Continue;
            end;

            prefix_query := get_query_prefix_for_segment_path(prefix_path);
            if prefix_query = '' then
            begin
                Continue;
            end;

            combined_query := base_query_prefix + prefix_query;
            combined_path := prefix_path;
            if base_path_prefix <> '' then
            begin
                combined_path := base_path_prefix + c_segment_path_separator + combined_path;
            end;

            if (combined_query = '') or (combined_path = '') or
                ((combined_query = final_query) and (combined_path = final_path)) then
            begin
                Continue;
            end;

            note_session_query_path_choice(combined_query, combined_path);
        end;
    end;

    function prepare_literal_user_word(out canonical_full_pinyin: string): Boolean;
    var
        confirmed_segment: TncConfirmedSegment;
        current_canonical_pinyin: string;
        has_nonfull_input: Boolean;
        text_unit_count: Integer;

        procedure append_canonical_segment(const segment_pinyin: string);
        begin
            if segment_pinyin = '' then
            begin
                Exit;
            end;
            if canonical_full_pinyin <> '' then
            begin
                canonical_full_pinyin := canonical_full_pinyin + '''';
            end;
            canonical_full_pinyin := canonical_full_pinyin + segment_pinyin;
        end;
    begin
        Result := False;
        canonical_full_pinyin := '';
        if (m_dictionary = nil) or (m_confirmed_segments = nil) or
            (m_confirmed_segments.Count = 0) or
            (not literal_commit_choice) or (commit_segment_text = '') or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        has_nonfull_input := not is_full_pinyin_key(normalized_pinyin);
        for confirmed_segment in m_confirmed_segments do
        begin
            if (not confirmed_segment.literal_choice) or
                (confirmed_segment.canonical_pinyin = '') then
            begin
                canonical_full_pinyin := '';
                Exit;
            end;
            append_canonical_segment(confirmed_segment.canonical_pinyin);
            has_nonfull_input := has_nonfull_input or
                (not is_full_pinyin_key(confirmed_segment.pinyin));
        end;

        if (not has_nonfull_input) or
            (not m_dictionary.resolve_literal_user_word_pinyin(
            normalized_pinyin, commit_segment_text,
            current_canonical_pinyin)) then
        begin
            canonical_full_pinyin := '';
            Exit;
        end;
        append_canonical_segment(current_canonical_pinyin);

        text_unit_count := get_candidate_text_unit_count(commit_text);
        Result := (text_unit_count >= 2) and (text_unit_count <= 4) and
            is_full_pinyin_key(normalize_pinyin_text(canonical_full_pinyin));
        if not Result then
        begin
            canonical_full_pinyin := '';
        end;
    end;

begin
    out_text := '';
    if not m_has_pending_commit then
    begin
        Result := False;
        Exit;
    end;

    commit_segment_text := m_pending_commit_text;
    commit_segment_path := m_pending_commit_segment_path;
    remaining_pinyin := m_pending_commit_remaining;
    remaining_input_code := m_pending_commit_remaining_input_code;
    prev_prev_committed_text := m_prev_committed_text;
    prev_prev_committed_pinyin := m_prev_committed_pinyin;
    previous_committed_text := m_last_committed_text;
    previous_committed_pinyin := m_last_committed_pinyin;
    commit_text := commit_segment_text;
    if m_confirmed_text <> '' then
    begin
        commit_text := m_confirmed_text + commit_text;
    end;

    out_text := commit_text;
    allow_learning := m_pending_commit_allow_learning;
    learning_locked := m_pending_commit_learning_locked;
    explicit_commit_choice := m_pending_commit_explicit_choice;
    literal_commit_choice := m_pending_commit_literal_choice;
    pending_fuzzy_choice := m_pending_commit_fuzzy_choice;
    pending_fuzzy_choice_text := m_pending_commit_fuzzy_text;
    fuzzy_commit_choice := pending_fuzzy_choice;
    literal_only_commit := False;
    literal_full_pinyin := '';
    m_pending_commit_text := '';
    m_pending_commit_remaining := '';
    m_pending_commit_remaining_input_code := '';
    m_has_pending_commit := False;
    m_pending_commit_allow_learning := True;
    m_pending_commit_learning_locked := False;
    m_pending_commit_explicit_choice := False;
    m_pending_commit_literal_choice := False;
    m_pending_commit_fuzzy_choice := False;
    m_pending_commit_fuzzy_text := '';
    m_pending_commit_segment_path := '';
    normalized_pinyin := m_pending_commit_query_key;
    m_pending_commit_query_key := '';
    prev_left_context := m_left_context;
    if m_segment_left_context <> '' then
    begin
        prev_left_context := m_segment_left_context;
    end
    else if m_external_left_context <> '' then
    begin
        prev_left_context := m_external_left_context;
    end;
    update_left_context(out_text);
    if normalized_pinyin = '' then
    begin
        normalized_pinyin := normalize_pinyin_text(m_last_lookup_key);
    end;
    if normalized_pinyin = '' then
    begin
        normalized_pinyin := normalize_pinyin_text(m_composition_text);
    end;
    full_pinyin := '';
    effective_segment_path := commit_segment_path;
    if allow_learning and (commit_segment_text <> '') and (normalized_pinyin <> '') and
        ((effective_segment_path = '') or (get_path_segment_count(effective_segment_path) <= 1)) then
    begin
        inferred_segment_path := infer_segment_path_for_selected_text(commit_segment_text);
        if inferred_segment_path <> '' then
        begin
            if (effective_segment_path = '') or
                ((get_path_segment_count(inferred_segment_path) > 1) and
                ((get_path_segment_count(effective_segment_path) <= 1) or
                (get_path_segment_count(inferred_segment_path) < get_path_segment_count(effective_segment_path)))) then
            begin
                effective_segment_path := inferred_segment_path;
            end;
        end;
    end;
    if (not fuzzy_commit_choice) and (not allow_learning) and
        (not learning_locked) and
        (commit_segment_text <> '') and
        (get_candidate_text_unit_count(commit_segment_text) >= 4) and
        is_high_confidence_segment_path(effective_segment_path) and
        (not is_generated_short_particle_tail_commit(normalized_pinyin,
        commit_segment_text)) then
    begin
        // Segment-decoded multi-phrase commits should still participate in learning
        // when the inferred path contains at least one real multi-char chunk.
        allow_learning := True;
    end;
    if m_confirmed_segments <> nil then
    begin
        for segment in m_confirmed_segments do
        begin
            fuzzy_commit_choice := fuzzy_commit_choice or segment.fuzzy_choice;
            full_pinyin := full_pinyin + segment.pinyin;
            append_path_segment(segment.text);
        end;
    end;
    confirmed_pinyin_prefix := full_pinyin;
    confirmed_segment_path_prefix := combined_segment_path;
    full_pinyin := full_pinyin + normalized_pinyin;
    if effective_segment_path <> '' then
    begin
        path_start := 1;
        for path_idx := 1 to Length(effective_segment_path) + 1 do
        begin
            if (path_idx <= Length(effective_segment_path)) and
                (effective_segment_path[path_idx] <> c_segment_path_separator) then
            begin
                Continue;
            end;

            append_path_segment(Copy(effective_segment_path, path_start, path_idx - path_start));
            path_start := path_idx + 1;
        end;
    end
    else if commit_segment_text <> '' then
    begin
        append_path_segment(commit_segment_text);
    end;
    if fuzzy_commit_choice then
    begin
        clear_one_key_completion_feedback_target;
    end
    else
    begin
        record_one_key_completion_feedback_target(full_pinyin, commit_text);
    end;
    if m_dictionary <> nil then
    begin
        literal_only_commit := (m_confirmed_segments <> nil) and
            (m_confirmed_segments.Count = 0) and
            m_dictionary.is_literal_user_entry(normalized_pinyin,
            commit_segment_text);
        literal_word_to_record := (not literal_only_commit) and
            prepare_literal_user_word(literal_full_pinyin);
        if literal_word_to_record then
        begin
            literal_only_commit := True;
            m_dictionary.record_literal_user_word(literal_full_pinyin,
                commit_text);
        end;
        if literal_only_commit then
        begin
            allow_learning := False;
        end;
    end;
    if fuzzy_commit_choice then
    begin
        allow_learning := False;
        literal_only_commit := False;
        if m_dictionary <> nil then
        begin
            if m_confirmed_segments <> nil then
            begin
                for segment in m_confirmed_segments do
                begin
                    if segment.fuzzy_choice then
                    begin
                        m_dictionary.record_fuzzy_choice(segment.pinyin,
                            segment.text);
                    end;
                end;
            end;
            if pending_fuzzy_choice and
                (normalized_pinyin <> '') and (commit_segment_text <> '') then
            begin
                if pending_fuzzy_choice_text = '' then
                begin
                    pending_fuzzy_choice_text := commit_segment_text;
                end;
                m_dictionary.record_fuzzy_choice(normalized_pinyin,
                    pending_fuzzy_choice_text);
            end;
        end;
    end;
    if (m_dictionary <> nil) and (not literal_only_commit) and
        (not fuzzy_commit_choice) then
    begin
        m_dictionary.begin_learning_batch;
        try
            if not literal_only_commit then
            begin
                record_context_pair(prev_left_context, out_text);
            end;
            if allow_learning then
            begin
                if Length(path_segments) > 1 then
                begin
                    for path_idx := 1 to High(path_segments) do
                    begin
                        record_context_pair(path_segments[path_idx - 1], path_segments[path_idx]);
                    end;
                end;

                if (normalized_pinyin <> '') and (commit_segment_text <> '') then
                begin
                    m_dictionary.record_commit(normalized_pinyin, commit_segment_text,
                        explicit_commit_choice);
                    if should_persist_segment_path(effective_segment_path) then
                    begin
                        if should_persist_path_prefixes(effective_segment_path) then
                        begin
                            record_query_path_prefixes('', '', effective_segment_path,
                                normalized_pinyin, effective_segment_path);
                        end;
                        m_dictionary.record_query_segment_path(normalized_pinyin, effective_segment_path);
                    end;
                end;

                if commit_text <> '' then
                begin
                    if (full_pinyin <> '') and
                        ((full_pinyin <> normalized_pinyin) or (commit_text <> commit_segment_text)) then
                    begin
                        // The dictionary suppresses unsafe standalone user rows
                        // while still preserving query-level latest/stats.
                        m_dictionary.record_commit(full_pinyin, commit_text,
                            explicit_commit_choice or m_confirmed_explicit_choice);
                        if should_persist_segment_path(combined_segment_path) then
                        begin
                            if should_persist_path_prefixes(combined_segment_path) then
                            begin
                                record_query_path_prefixes(
                                    confirmed_pinyin_prefix,
                                    confirmed_segment_path_prefix,
                                    effective_segment_path,
                                    full_pinyin,
                                    combined_segment_path);
                            end;
                            m_dictionary.record_query_segment_path(full_pinyin, combined_segment_path);
                        end;
                    end;

                end;
            end;
            m_dictionary.commit_learning_batch;
        except
            m_dictionary.rollback_learning_batch;
            raise;
        end;
    end
    else if (m_dictionary = nil) and (not literal_only_commit) and
        (not fuzzy_commit_choice) then
    begin
        record_context_pair(prev_left_context, out_text);
    end;
    if (not literal_only_commit) and (not fuzzy_commit_choice) and
        (commit_segment_text <> '') then
    begin
        note_session_commit(commit_segment_text);
    end;
    if (not literal_only_commit) and (not fuzzy_commit_choice) and
        (commit_text <> '') and
        (commit_text <> commit_segment_text) then
    begin
        note_session_commit(commit_text);
    end;
    if allow_learning then
    begin
        if (normalized_pinyin <> '') and (commit_segment_text <> '') then
        begin
            note_session_query_choice(normalized_pinyin, commit_segment_text);
            note_session_context_query_choice(prev_left_context, normalized_pinyin, commit_segment_text);
            if get_path_segment_count(effective_segment_path) > 1 then
            begin
                note_session_query_path_prefixes('', '', effective_segment_path,
                    normalized_pinyin, effective_segment_path);
                note_session_query_path_choice(normalized_pinyin, effective_segment_path);
            end;
        end;
        if (full_pinyin <> '') and ((full_pinyin <> normalized_pinyin) or (commit_text <> commit_segment_text)) and
            (commit_text <> '') then
        begin
            note_session_query_choice(full_pinyin, commit_text);
            note_session_context_query_choice(prev_left_context, full_pinyin, commit_text);
            if get_path_segment_count(combined_segment_path) > 1 then
            begin
                note_session_query_path_prefixes(
                    confirmed_pinyin_prefix,
                    confirmed_segment_path_prefix,
                    effective_segment_path,
                    full_pinyin,
                    combined_segment_path);
                note_session_query_path_choice(full_pinyin, combined_segment_path);
            end;
        end;
        if (previous_committed_text <> '') and (previous_committed_pinyin <> '') and
            (m_confirmed_text = '') and (commit_text = commit_segment_text) and
            (normalized_pinyin <> '') and (commit_text <> '') and
            (get_candidate_text_unit_count(previous_committed_text) +
            get_candidate_text_unit_count(commit_text) <= 4) and
            should_persist_adjacent_commit_learning(previous_committed_text,
            commit_text) then
        begin
            note_session_query_choice(previous_committed_pinyin + normalized_pinyin,
                previous_committed_text + commit_text);
            if (prev_prev_committed_text <> '') and (prev_prev_committed_pinyin <> '') and
                (get_candidate_text_unit_count(prev_prev_committed_text) +
                get_candidate_text_unit_count(previous_committed_text) +
                get_candidate_text_unit_count(commit_text) <= 4) and
                should_persist_adjacent_commit_learning(
                prev_prev_committed_text + previous_committed_text,
                commit_text) then
            begin
                note_session_query_choice(prev_prev_committed_pinyin +
                    previous_committed_pinyin + normalized_pinyin,
                    prev_prev_committed_text + previous_committed_text + commit_text);
            end;
        end;
    end;
    if (not literal_only_commit) and (not fuzzy_commit_choice) and
        (commit_text <> '') then
    begin
        note_output_phrase_context(commit_text);
    end;
    if allow_learning and (Length(path_segments) > 1) then
    begin
        note_segment_path_context(combined_segment_path);
    end;
    m_last_debug_commit_segment_path := combined_segment_path;
    if (not literal_only_commit) and (not fuzzy_commit_choice) and
        (normalized_pinyin <> '') and
        (commit_text <> '') and
        (m_confirmed_text = '') and (commit_text = commit_segment_text) and
        (get_candidate_text_unit_count(commit_text) <= 4) and
        (not is_boundary_learning_unit(commit_text)) then
    begin
        m_prev_committed_text := m_last_committed_text;
        m_prev_committed_pinyin := m_last_committed_pinyin;
        m_last_committed_text := commit_text;
        m_last_committed_pinyin := normalized_pinyin;
    end
    else
    begin
        m_prev_committed_text := '';
        m_prev_committed_pinyin := '';
        m_last_committed_text := '';
        m_last_committed_pinyin := '';
    end;
    m_confirmed_text := '';
    m_confirmed_explicit_choice := False;
    m_recent_partial_prefix_text := '';
    m_segment_left_context := '';
    if m_confirmed_segments <> nil then
    begin
        m_confirmed_segments.Clear;
    end;
    reset;
    if remaining_pinyin <> '' then
    begin
        m_composition_text := remaining_pinyin;
        if remaining_input_code <> '' then
        begin
            m_composition_display_text := remaining_input_code;
        end
        else
        begin
            m_composition_display_text := remaining_pinyin;
        end;
        if is_shuangpin_input then
        begin
            rebuild_shuangpin_composition_from_input_code;
        end;
        m_page_index := 0;
        build_candidates;
    end;
    Result := True;
end;

function TncEngine.remove_user_candidate(const pinyin: string; const text: string): Boolean;
var
    empty_candidate: TncCandidate;
begin
    empty_candidate.text := '';
    empty_candidate.comment := '';
    empty_candidate.score := 0;
    empty_candidate.source := cs_rule;
    empty_candidate.has_dict_weight := False;
    empty_candidate.dict_weight := 0;
    Result := remove_user_candidate(pinyin, text, empty_candidate, False);
end;

function TncEngine.remove_user_candidate(const pinyin: string; const text: string;
    const preserve_candidate: TncCandidate; const has_preserve_candidate: Boolean): Boolean;
var
    pinyin_key: string;
    candidate_text: string;
    previous_visible_candidates: TncCandidateList;
    preserved_visible_top_candidate: TncCandidate;
    confirmed_pinyin: string;
    full_query: string;
    full_candidates: TncCandidateList;
    full_text: string;
    extension_text: string;
    idx: Integer;
    seg_idx: Integer;
    removed_confirmed_extension: Boolean;
    preserve_visible_top_candidate: Boolean;

    function same_candidate_identity(const left_candidate: TncCandidate;
        const right_candidate: TncCandidate): Boolean;
    begin
        Result := SameText(Trim(left_candidate.text), Trim(right_candidate.text)) and
            SameText(Trim(left_candidate.comment), Trim(right_candidate.comment));
    end;

    procedure preserve_visible_top_after_rebuild;
    var
        candidate_idx: Integer;
        preserved_idx: Integer;
        tmp_candidate: TncCandidate;
    begin
        if not preserve_visible_top_candidate then
        begin
            Exit;
        end;

        m_has_forced_visible_top_candidate := True;
        m_forced_visible_top_from_incremental_lm_prefix := False;
        m_forced_visible_top_candidate := preserved_visible_top_candidate;
        m_forced_visible_top_composition_text := m_composition_text;
        m_forced_visible_top_lookup_key := m_last_lookup_key;

        if (Length(m_candidates) > 0) and
            same_candidate_identity(m_candidates[0], preserved_visible_top_candidate) then
        begin
            Exit;
        end;

        preserved_idx := -1;
        for candidate_idx := 0 to High(m_candidates) do
        begin
            if same_candidate_identity(m_candidates[candidate_idx],
                preserved_visible_top_candidate) then
            begin
                preserved_idx := candidate_idx;
                Break;
            end;
        end;

        if preserved_idx > 0 then
        begin
            tmp_candidate := m_candidates[preserved_idx];
            for candidate_idx := preserved_idx downto 1 do
            begin
                m_candidates[candidate_idx] := m_candidates[candidate_idx - 1];
            end;
            m_candidates[0] := tmp_candidate;
        end
        else if preserved_idx < 0 then
        begin
            SetLength(m_candidates, Length(m_candidates) + 1);
            for candidate_idx := High(m_candidates) downto 1 do
            begin
                m_candidates[candidate_idx] := m_candidates[candidate_idx - 1];
            end;
            m_candidates[0] := preserved_visible_top_candidate;
        end;

        m_page_index := 0;
        m_selected_index := 0;
        SetLength(m_visible_candidates_cache, 0);
        SetLength(m_visible_candidate_source_indices_cache, 0);
        m_visible_candidates_cache_valid := False;
        refresh_candidate_segment_paths;
        note_ranked_top_candidate;
    end;
begin
    Result := False;
    candidate_text := Trim(text);
    pinyin_key := normalize_pinyin_text(pinyin);
    if pinyin_key = '' then
    begin
        pinyin_key := normalize_pinyin_text(m_last_lookup_key);
    end;
    if pinyin_key = '' then
    begin
        pinyin_key := normalize_pinyin_text(m_composition_text);
    end;

    if (m_dictionary = nil) or (candidate_text = '') then
    begin
        Exit;
    end;

    preserve_visible_top_candidate := False;
    SetLength(previous_visible_candidates, 0);
    m_has_forced_visible_top_candidate := False;
    m_forced_visible_top_from_incremental_lm_prefix := False;
    m_forced_visible_top_composition_text := '';
    m_forced_visible_top_lookup_key := '';
    if has_preserve_candidate and (Trim(preserve_candidate.text) <> '') and
        (not SameText(Trim(preserve_candidate.text), candidate_text)) then
    begin
        preserved_visible_top_candidate := preserve_candidate;
        preserve_visible_top_candidate := True;
    end
    else if m_composition_text <> '' then
    begin
        previous_visible_candidates := get_candidates;
        if Length(previous_visible_candidates) > 0 then
        begin
            preserved_visible_top_candidate := previous_visible_candidates[0];
            preserve_visible_top_candidate :=
                (Trim(preserved_visible_top_candidate.text) <> '') and
                (not SameText(Trim(preserved_visible_top_candidate.text),
                candidate_text));
        end;
    end;

    removed_confirmed_extension := False;
    if (m_confirmed_text <> '') and (m_confirmed_segments <> nil) and (m_confirmed_segments.Count > 0) and
        (m_composition_text <> '') then
    begin
        confirmed_pinyin := '';
        for seg_idx := 0 to m_confirmed_segments.Count - 1 do
        begin
            if m_confirmed_segments[seg_idx].pinyin <> '' then
            begin
                confirmed_pinyin := confirmed_pinyin + normalize_pinyin_text(m_confirmed_segments[seg_idx].pinyin);
            end;
        end;

        if confirmed_pinyin <> '' then
        begin
            full_query := confirmed_pinyin + normalize_pinyin_text(m_composition_text);
            if (full_query <> '') and m_dictionary.lookup(full_query, full_candidates) then
            begin
                for idx := 0 to High(full_candidates) do
                begin
                    if full_candidates[idx].source <> cs_user then
                    begin
                        Continue;
                    end;

                    full_text := Trim(full_candidates[idx].text);
                    if (full_text = '') or (Length(full_text) <= Length(m_confirmed_text)) then
                    begin
                        Continue;
                    end;
                    if Copy(full_text, 1, Length(m_confirmed_text)) <> m_confirmed_text then
                    begin
                        Continue;
                    end;

                    extension_text := Trim(Copy(full_text, Length(m_confirmed_text) + 1, MaxInt));
                    if not SameText(extension_text, candidate_text) then
                    begin
                        Continue;
                    end;

                    m_dictionary.remove_user_entry(full_query, full_text);
                    removed_confirmed_extension := True;
                end;
            end;
        end;
    end;

    if not removed_confirmed_extension then
    begin
        m_dictionary.remove_user_entry(pinyin_key, candidate_text);
    end;

    if m_build_lookup_cache <> nil then
    begin
        m_build_lookup_cache.Clear;
    end;
    SetLength(m_visible_candidates_cache, 0);
    SetLength(m_visible_candidate_source_indices_cache, 0);
    m_visible_candidates_cache_valid := False;
    clear_session_learning_after_user_removal;
    clear_lookup_bonus_caches;

    if m_composition_text <> '' then
    begin
        build_candidates;
        preserve_visible_top_after_rebuild;
    end;

    Result := True;
end;

function TncEngine.clear_user_dictionary: Boolean;
begin
    Result := (m_dictionary <> nil) and m_dictionary.clear_user_dictionary;
    if Result then
    begin
        notify_user_dictionary_cleared;
    end;
end;

procedure TncEngine.notify_user_dictionary_cleared;
begin
    clear_session_learning_after_user_removal;
    if m_build_lookup_cache <> nil then
    begin
        m_build_lookup_cache.Clear;
    end;
    SetLength(m_candidates, 0);
    SetLength(m_visible_candidates_cache, 0);
    SetLength(m_visible_candidate_source_indices_cache, 0);
    m_visible_candidates_cache_valid := False;
    m_long_local_rerank_generated_text := '';
    m_long_local_rerank_composition_text := '';
    m_long_local_rerank_lookup_key := '';
    m_has_forced_visible_top_candidate := False;
    m_forced_visible_top_from_incremental_lm_prefix := False;
    m_forced_visible_top_composition_text := '';
    m_forced_visible_top_lookup_key := '';
    clear_segment_path_tracking;
end;

end.
