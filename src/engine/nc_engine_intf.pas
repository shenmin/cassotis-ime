        procedure recover_attested_particle_phrase_local;
        var
            parsed: TncPinyinParseResult;
            keys: TArray<string>;
            tail_key, tail_text, head_key, context, text, path: string;
            candidate: TncCandidate;
            additions: TncCandidateList;
            idx, score, evidence: Integer;
        begin
            if (input_syllable_count <> 4) or is_fuzzy_pinyin_active or
                (m_config.pinyin_input_scheme <> pis_full_pinyin) or
                has_explicit_apostrophe_input or
                (not is_full_pinyin_key(lookup_text)) or
                (not try_get_short_particle_tail_query_parts(lookup_text,
                    tail_key, tail_text, head_key)) then Exit;
            parsed := get_effective_compact_pinyin_syllables(lookup_text);
            if Length(parsed) <> 4 then Exit;
            SetLength(keys, 4);
            for idx := 0 to 3 do keys[idx] := parsed[idx].text;
            context := Trim(m_segment_left_context);
            if context = '' then context := Trim(m_external_left_context);
            if context = '' then context := Trim(m_left_context);
            if not nc_recover_attested_particle_phrase(m_dictionary, keys,
                tail_text, context_model_tail(context), m_candidates, text, path,
                evidence) then Exit;
            attested_particle_text_local := text;
            // Carry the accepted boundary evidence through the same lookup and
            // display gate as word transitions; colour alone is not evidence.
            m_lookup_display_feature_cache.AddOrSetValue(
                'S43E' + #1 + lookup_text + #1 + text, evidence);
            m_lookup_query_latest_text_cache.AddOrSetValue(
                'S43P' + #1 + lookup_text + #1 + text, path);
            m_lookup_query_latest_text_cache.AddOrSetValue(
                'S43W' + #1 + lookup_text, text);
            score := 0;
            for candidate in m_candidates do score := Max(score, candidate.score);
            candidate := Default(TncCandidate);
            candidate.text := text;
            candidate.source := cs_rule;
            candidate.display_kind := cdk_lm_compound;
            candidate.score := Min(Int64(High(Integer)) - 128, score) + 128;
            additions := TncCandidateList.Create(candidate);
            m_candidates := merge_candidate_lists(additions, m_candidates, 0);
            remember_segment_path_for_candidate(text, '', path, candidate.score);
            remember_segment_path_query_prefix(path, lookup_text);
            if m_config.debug_mode then
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' particlechar=' + text;
        end;

        function skip_expensive_short_prefix_rerank_local: Boolean;
        begin
            Result := not allow_expensive_prefix_rerank;
        end;

        procedure note_prefix_phase_elapsed_local(const phase_name: string;
            const started_at: UInt64);
        var
            elapsed_local: UInt64;
        begin
            if not m_config.debug_mode then
            begin
                Exit;
            end;
            elapsed_local := GetTickCount64 - started_at;
            if elapsed_local > 0 then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' %s=%d', [phase_name, elapsed_local]);
            end;
        end;

        procedure ensure_short_particle_tail_from_prefix_partial_visible_local(
            var candidates: TncCandidateList);
        const
            c_particle_tail_min_head_score = 80;
            c_particle_tail_visible_bonus = 160;
            c_particle_tail_unit_bonus = 24;
            c_particle_tail_weak_bonus = 8;
        var
            normalized_query_local: string;
            head_key_local: string;
            tail_key_local: string;
            tail_text_local: string;
            head_syllables_local: TncPinyinParseResult;
            head_units_local: Integer;
        head_results_local: TncCandidateList;
        candidate_idx_local: Integer;
        head_idx_local: Integer;
        existing_idx_local: Integer;
        head_text_local: string;
            partial_tail_local: string;
            completion_local: TncCandidate;
            completion_candidates_local: TncCandidateList;
            score_local: Integer;
            completion_score_local: Integer;
        exact_head_matches_local: Boolean;
        changed_local: Boolean;

            function text_ends_with_tail_particle_local(
                const text_value: string; const tail_text_value: string): Boolean;
            var
                trimmed_text_local: string;
                last_char_local: string;
            begin
                Result := False;
                trimmed_text_local := Trim(text_value);
                if (trimmed_text_local = '') or (tail_text_value = '') then
                begin
                    Exit;
                end;
                last_char_local := Copy(trimmed_text_local,
                    Length(trimmed_text_local), 1);
                Result := SameText(last_char_local, tail_text_value);
            end;

            function derived_particle_tail_score_local(
                const base_score: Integer): Integer;
            begin
                Result := base_score;
                if Result < 0 then
                begin
                    Result := 0;
                end;
                if Result < c_particle_tail_min_head_score then
                begin
                    Inc(Result, c_particle_tail_weak_bonus);
                    Exit;
                end;

                Inc(Result, c_particle_tail_visible_bonus +
                    (head_units_local * c_particle_tail_unit_bonus));
            end;
        begin
            if (Length(candidates) = 0) or (m_dictionary = nil) then
            begin
                Exit;
            end;

            normalized_query_local := normalize_pinyin_text(lookup_text);
            if not try_get_short_particle_tail_query_parts(
                normalized_query_local, tail_key_local, tail_text_local,
                head_key_local) then
            begin
                Exit;
            end;
            if head_key_local = '' then
            begin
                Exit;
            end;

            head_syllables_local := get_effective_compact_pinyin_syllables(
                head_key_local);
            head_units_local := Length(head_syllables_local);
            if (head_units_local < 2) or (head_units_local > 3) then
            begin
                Exit;
            end;

            if not m_dictionary.lookup_exact_full_pinyin(head_key_local,
                head_results_local) then
            begin
                Exit;
            end;

            SetLength(completion_candidates_local, 0);
            changed_local := False;
            for candidate_idx_local := 0 to High(candidates) do
            begin
                partial_tail_local := normalize_pinyin_text(
                    Trim(candidates[candidate_idx_local].comment));
                if partial_tail_local <> tail_key_local then
                begin
                    Continue;
                end;

                head_text_local := Trim(candidates[candidate_idx_local].text);
                if (head_text_local = '') or
                    (get_candidate_text_unit_count(head_text_local) <>
                    head_units_local) or
                    text_ends_with_tail_particle_local(head_text_local,
                    tail_text_local) then
                begin
                    Continue;
                end;

                exact_head_matches_local := False;
                for head_idx_local := 0 to High(head_results_local) do
                begin
                    if (Trim(head_results_local[head_idx_local].comment) = '') and
                        SameText(Trim(head_results_local[head_idx_local].text),
                        head_text_local) then
                    begin
                        exact_head_matches_local := True;
                        Break;
                    end;
                end;
                if not exact_head_matches_local then
                begin
                    Continue;
                end;

                score_local := candidates[candidate_idx_local].score;
                if candidates[candidate_idx_local].has_dict_weight and
                    (candidates[candidate_idx_local].dict_weight > score_local) then
                begin
                    score_local := candidates[candidate_idx_local].dict_weight;
                end;
                completion_score_local :=
                    derived_particle_tail_score_local(score_local);

                for existing_idx_local := 0 to High(candidates) do
                begin
                    if (Trim(candidates[existing_idx_local].comment) = '') and
                        SameText(Trim(candidates[existing_idx_local].text),
                        head_text_local + tail_text_local) then
                    begin
                        if candidates[existing_idx_local].score <
                            completion_score_local then
                        begin
                            candidates[existing_idx_local].score :=
                                completion_score_local;
                            changed_local := True;
                        end;
                        if candidates[existing_idx_local].dict_weight <
                            score_local then
                        begin
                            candidates[existing_idx_local].dict_weight :=
                                score_local;
                            candidates[existing_idx_local].has_dict_weight := True;
                            changed_local := True;
                        end;
                        exact_head_matches_local := False;
                        Break;
                    end;
                end;
                if not exact_head_matches_local then
                begin
                    Continue;
                end;

                FillChar(completion_local, SizeOf(completion_local), 0);
                completion_local.text := head_text_local + tail_text_local;
                completion_local.comment := '';
                completion_local.source := cs_rule;
                completion_local.score := completion_score_local;
                completion_local.has_dict_weight := True;
                completion_local.dict_weight := score_local;

                SetLength(completion_candidates_local,
                    Length(completion_candidates_local) + 1);
                completion_candidates_local[High(completion_candidates_local)] :=
                    completion_local;
            end;

            if Length(completion_candidates_local) = 0 then
            begin
                if changed_local then
                begin
                    sort_candidates_lightweight(candidates);
                end;
                Exit;
            end;

            candidates := merge_candidate_lists(completion_candidates_local,
                candidates, 0);
            sort_candidates_lightweight(candidates);
        end;

        procedure filter_misaligned_complete_candidates_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            query_syllables_local: TncPinyinParseResult;

            function short_particle_tail_dictionary_matches_text_local(
                const text_value: string): Boolean;
            var
                particle_candidates_local: TncCandidateList;
                particle_idx_local: Integer;
            begin
                Result := False;
                if not build_short_particle_tail_dictionary_candidates(
                    lookup_text, particle_candidates_local) then
                begin
                    Exit;
                end;

                for particle_idx_local := 0 to High(particle_candidates_local) do
                begin
                    if (Trim(particle_candidates_local[
                        particle_idx_local].comment) = '') and
                        SameText(Trim(particle_candidates_local[
                        particle_idx_local].text), text_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function complete_candidate_matches_query_units_local(
                const candidate: TncCandidate; const text_value: string): Boolean;
            var
                candidate_units_local: TArray<string>;
                unit_idx_local: Integer;
                exact_results_local: TncCandidateList;
                transition_particle_path_local: string;
                transition_particle_evidence_local: Integer;

                function full_query_exact_matches_text_local: Boolean;
                var
                    local_idx: Integer;
                begin
                    Result := False;
                    if (m_dictionary = nil) or (Trim(text_value) = '') or
                        (not lookup_exact_full_pinyin_cached_local(lookup_text,
                        exact_results_local)) then
                    begin
                        Exit;
                    end;

                    for local_idx := 0 to High(exact_results_local) do
                    begin
                        if (Trim(exact_results_local[local_idx].comment) = '') and
                            SameText(Trim(exact_results_local[local_idx].text),
                            text_value) and
                            (get_candidate_text_unit_count(Trim(
                            exact_results_local[local_idx].text)) =
                            input_syllable_count) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

                function fixed_wo_tail_dictionary_matches_text_local: Boolean;
                var
                    head_pinyin_local: string;
                    head_text_local: string;
                    tail_key_local: string;
                    tail_units_local: Integer;
                    tail_text_local: string;
                begin
                    Result := False;
                    if not try_get_fixed_pronoun_tail_query_parts(lookup_text,
                        input_syllable_count, head_pinyin_local,
                        head_text_local, tail_key_local, tail_units_local) then
                    begin
                        Exit;
                    end;

                    if (get_candidate_text_unit_count(text_value) <>
                        input_syllable_count) or
                        (Copy(text_value, 1, 1) <> head_text_local) then
                    begin
                        Exit;
                    end;

                    tail_text_local := Copy(text_value, 2, MaxInt);
                    if (tail_key_local = '') or (tail_text_local = '') then
                    begin
                        Exit;
                    end;

                    Result := m_dictionary.is_base_entry(tail_key_local,
                        tail_text_local) or m_dictionary.is_user_entry(
                        tail_key_local, tail_text_local);
                end;

                function compact_interrogative_location_matches_text_local:
                    Boolean;
                var
                    normalized_query_local: string;
                begin
                    normalized_query_local := LowerCase(Trim(lookup_text));
                    Result := (((normalized_query_local = 'naer') or
                        (normalized_query_local = 'ner')) and
                        SameText(text_value, string(Char($54EA)) +
                        string(Char($513F)))) or
                        (((normalized_query_local = 'qunaer') or
                        (normalized_query_local = 'qner')) and
                        SameText(text_value, string(Char($53BB)) +
                        string(Char($54EA)) + string(Char($513F)))) or
                        ((normalized_query_local = 'nli') and
                        SameText(text_value, string(Char($54EA)) +
                        string(Char($91CC)))) or
                        ((normalized_query_local = 'qnli') and
                        SameText(text_value, string(Char($53BB)) +
                        string(Char($54EA)) + string(Char($91CC))));
                end;

            begin
                Result := True;
                if is_fuzzy_pinyin_active and
                    (candidate.fuzzy_cost > 0) then
                begin
                    Exit;
                end;
                if (m_dictionary = nil) or (candidate.source = cs_user) or
                    (Trim(candidate.comment) <> '') or
                    ((get_candidate_text_unit_count(text_value) <>
                    input_syllable_count) and
                    (not short_particle_tail_dictionary_matches_text_local(
                    text_value))) then
                begin
                    Exit;
                end;

                if Length(query_syllables_local) <> input_syllable_count then
                begin
                    Exit;
                end;

                if full_query_exact_matches_text_local then
                begin
                    Exit(True);
                end;

                if (input_syllable_count = 4) and
                    short_four_two_exact_path_is_supported_local(
                    query_syllables_local, text_value) then
                begin
                    Exit(True);
                end;

                if (input_syllable_count = 4) and
                    get_short_four_transition_particle_path_evidence(
                    lookup_text, text_value,
                    transition_particle_path_local,
                    transition_particle_evidence_local) then
                begin
                    Exit(True);
                end;

                if fixed_wo_tail_dictionary_matches_text_local then
                begin
                    Exit(True);
                end;

                if short_particle_tail_dictionary_matches_text_local(
                    text_value) then
                begin
                    Exit(True);
                end;

                if compact_interrogative_location_matches_text_local then
                begin
                    Exit(True);
                end;

                candidate_units_local := split_text_units(text_value);
                if Length(candidate_units_local) <> input_syllable_count then
                begin
                    Exit(False);
                end;

                for unit_idx_local := 0 to High(candidate_units_local) do
                begin
                    if (get_candidate_text_unit_count(
                        candidate_units_local[unit_idx_local]) <> 1) or
                        (not m_dictionary.single_char_matches_pinyin(
                        normalize_pinyin_text(
                        query_syllables_local[unit_idx_local].text),
                        candidate_units_local[unit_idx_local])) then
                    begin
                        Exit(False);
                    end;
                end;
            end;
        begin
            filtered_prefix_misaligned_count_local := 0;
            if (Length(candidates) = 0) or (input_syllable_count <= 0) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            query_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    input_syllable_count) and
                    (not short_particle_tail_dictionary_matches_text_local(
                    candidate_text_local)) then
                begin
                    Inc(filtered_prefix_misaligned_count_local);
                    Continue;
                end;
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (not complete_candidate_matches_query_units_local(
                    candidates[in_idx_local], candidate_text_local)) then
                begin
                    Inc(filtered_prefix_misaligned_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure filter_interior_predictive_prefix_candidates_local(
            var candidates: TncCandidateList);
        var
            query_syllables_local: TncPinyinParseResult;
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            exact_head_phrase_cache_local: TDictionary<string, TncCandidateList>;

            function fixed_pronoun_tail_dictionary_matches_text_local(
                const text_value: string): Boolean;
            var
                head_pinyin_local: string;
                head_text_local: string;
                tail_key_local: string;
                tail_units_local: Integer;
                tail_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or
                    (not try_get_fixed_pronoun_tail_query_parts(lookup_text,
                    input_syllable_count, head_pinyin_local,
                    head_text_local, tail_key_local, tail_units_local)) or
                    (head_pinyin_local = '') then
                begin
                    Exit;
                end;

                if (get_candidate_text_unit_count(text_value) <>
                    input_syllable_count) or
                    (Copy(text_value, 1, 1) <> head_text_local) then
                begin
                    Exit;
                end;

                tail_text_local := Copy(text_value, 2, MaxInt);
                if (tail_key_local = '') or (tail_text_local = '') or
                    (get_candidate_text_unit_count(tail_text_local) <>
                    tail_units_local) then
                begin
                    Exit;
                end;

                Result := m_dictionary.is_base_entry(tail_key_local,
                    tail_text_local) or m_dictionary.is_user_entry(
                    tail_key_local, tail_text_local);
            end;

            function lookup_exact_head_phrase_cached_local(
                const head_key: string; out out_results: TncCandidateList): Boolean;
            begin
                SetLength(out_results, 0);
                if (head_key = '') or (m_dictionary = nil) then
                begin
                    Exit(False);
                end;

                if (exact_head_phrase_cache_local <> nil) and
                    exact_head_phrase_cache_local.TryGetValue(head_key, out_results) then
                begin
                    Exit(Length(out_results) > 0);
                end;

                if not m_dictionary.lookup(head_key, out_results) then
                begin
                    SetLength(out_results, 0);
                end;

                if exact_head_phrase_cache_local <> nil then
                begin
                    exact_head_phrase_cache_local.AddOrSetValue(head_key,
                        out_results);
                end;
                Result := Length(out_results) > 0;
            end;

            function has_interior_alignment_mismatch_local(
                const candidate: TncCandidate; const text_value: string): Boolean;
            var
                candidate_units_local: TArray<string>;
                unit_idx_inner: Integer;
                syllable_key_local: string;
                matched_unit_count_local: Integer;
                last_required_exact_unit_local: Integer;
                transition_particle_path_local: string;
                transition_particle_evidence_local: Integer;

                function has_exact_head_phrase_match_local: Boolean;
                var
                    head_key_local: string;
                    head_idx_local: Integer;
                    head_results_local: TncCandidateList;
                begin
                    Result := False;
                    head_key_local := '';
                    for head_idx_local := 0 to matched_unit_count_local - 1 do
                    begin
                        head_key_local := head_key_local + normalize_pinyin_text(
                            query_syllables_local[head_idx_local].text);
                    end;
                    if (head_key_local = '') or
                        (not lookup_exact_head_phrase_cached_local(head_key_local,
                        head_results_local)) then
                    begin
                        Exit;
                    end;
                    for head_idx_local := 0 to High(head_results_local) do
                    begin
                        if Trim(head_results_local[head_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if SameText(Trim(head_results_local[head_idx_local].text),
                            text_value) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            begin
                Result := False;
                if is_fuzzy_pinyin_active and (candidate.fuzzy_cost > 0) then
                begin
                    Exit;
                end;
                candidate_units_local := split_text_units(text_value);
                matched_unit_count_local := Length(candidate_units_local);
                if (Length(query_syllables_local) <> input_syllable_count) or
                    (matched_unit_count_local <= 0) or
                    (matched_unit_count_local > input_syllable_count) then
                begin
                    Exit;
                end;

                if (input_syllable_count = 4) and
                    short_four_two_exact_path_is_supported_local(
                    query_syllables_local, text_value) then
                begin
                    Exit(False);
                end;

                if (input_syllable_count = 4) and
                    get_short_four_transition_particle_path_evidence(
                    lookup_text, text_value,
                    transition_particle_path_local,
                    transition_particle_evidence_local) then
                begin
                    Exit(False);
                end;

                if has_exact_head_phrase_match_local then
                begin
                    Exit;
                end;

                if fixed_pronoun_tail_dictionary_matches_text_local(
                    text_value) then
                begin
                    Exit;
                end;

                if Trim(candidate.comment) = '' then
                begin
                    last_required_exact_unit_local := matched_unit_count_local - 2;
                end
                else
                begin
                    last_required_exact_unit_local := matched_unit_count_local - 1;
                end;

                for unit_idx_inner := 0 to last_required_exact_unit_local do
                begin
                    syllable_key_local := normalize_pinyin_text(
                        query_syllables_local[unit_idx_inner].text);
                    if (syllable_key_local = '') or
                        (not m_dictionary.single_char_matches_pinyin(
                        syllable_key_local,
                        candidate_units_local[unit_idx_inner])) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (m_dictionary = nil) or (Length(candidates) = 0) or
                (input_syllable_count <= 1) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            query_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            if Length(query_syllables_local) <> input_syllable_count then
            begin
                Exit;
            end;

            exact_head_phrase_cache_local :=
                TDictionary<string, TncCandidateList>.Create;
            try
                out_idx_local := 0;
                for in_idx_local := 0 to High(candidates) do
                begin
                    candidate_text_local := Trim(candidates[in_idx_local].text);
                    if (candidates[in_idx_local].source <> cs_user) and
                        (candidate_text_local <> '') and
                        has_interior_alignment_mismatch_local(candidates[in_idx_local],
                        candidate_text_local) then
                    begin
                        Continue;
                    end;

                    if out_idx_local <> in_idx_local then
                    begin
                        candidates[out_idx_local] := candidates[in_idx_local];
                    end;
                    Inc(out_idx_local);
                end;
            finally
                exact_head_phrase_cache_local.Free;
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure finalize_lookup_timing_info_lightweight_local;
        var
            total_elapsed_ms_local: Int64;
        begin
            total_elapsed_ms_local := Int64(GetTickCount64 - total_start_tick);
            m_last_lookup_timing_info := Format(
                'perf=[lk=%d seg=%d path=%d rt=%d post=%d sort=%d cache=%d/%d total=%d]',
                [lookup_elapsed_ms, segment_elapsed_ms,
                path_search_elapsed_ms, runtime_elapsed_ms, post_elapsed_ms,
                sort_elapsed_ms, lookup_cache_hits, lookup_cache_misses,
                total_elapsed_ms_local]);
        end;

        function has_strong_complete_top_local: Boolean;
        var
            top_text_local: string;
        begin
            Result := False;
            if Length(m_candidates) = 0 then
            begin
                Exit;
            end;

            if Trim(m_candidates[0].comment) <> '' then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            if (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            Result := (m_candidates[0].source = cs_user) or
                m_candidates[0].has_dict_weight;
        end;

        procedure filter_unsupported_three_syllable_complete_candidates_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            exact_results_local: TncCandidateList;

            function has_exact_full_query_support_local(
                const text_value: string): Boolean;
            var
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (Trim(text_value) = '') or
                    (not lookup_exact_full_pinyin_cached_local(lookup_text,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(exact_text_local, Trim(text_value)) and
                        (get_candidate_text_unit_count(exact_text_local) =
                        input_syllable_count) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function has_fixed_pronoun_tail_support_local(
                const text_value: string): Boolean;
            var
                head_pinyin_local: string;
                head_text_local: string;
                tail_key_local: string;
                tail_units_local: Integer;
                tail_text_local: string;
                tail_results_local: TncCandidateList;
                tail_idx_local: Integer;
                tail_candidate_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or
                    (not try_get_fixed_pronoun_tail_query_parts(lookup_text,
                    input_syllable_count, head_pinyin_local,
                    head_text_local, tail_key_local, tail_units_local)) or
                    (head_pinyin_local = '') then
                begin
                    Exit;
                end;

                if (get_candidate_text_unit_count(text_value) <>
                    input_syllable_count) or
                    (Copy(text_value, 1, 1) <> head_text_local) then
                begin
                    Exit;
                end;

                tail_text_local := Copy(text_value, 2, MaxInt);
                if (tail_key_local = '') or (tail_text_local = '') or
                    (get_candidate_text_unit_count(tail_text_local) <>
                    tail_units_local) or
                    (not lookup_exact_full_pinyin_cached_local(tail_key_local,
                    tail_results_local)) then
                begin
                    Exit;
                end;

                for tail_idx_local := 0 to High(tail_results_local) do
                begin
                    if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    tail_candidate_text_local :=
                        Trim(tail_results_local[tail_idx_local].text);
                    if SameText(tail_candidate_text_local, tail_text_local) and
                        (get_candidate_text_unit_count(tail_candidate_text_local) =
                        tail_units_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (Length(candidates) = 0) or (input_syllable_count <> 3) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (candidates[in_idx_local].source <> cs_user) and
                    (not (is_fuzzy_pinyin_active and
                    (candidates[in_idx_local].fuzzy_cost > 0))) and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (not has_exact_full_query_support_local(
                    candidate_text_local)) and
                    (not has_fixed_pronoun_tail_support_local(
                    candidate_text_local)) and
                    (not is_short_three_exact_pair_candidate_supported_local(
                    candidate_text_local)) then
                begin
                    Inc(filtered_prefix_misaligned_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        function build_fixed_wo_tail_candidates_for_prefix_final_local(
            out out_candidates: TncCandidateList): Boolean;
        const
            c_tail_probe_limit = 8;
            c_fixed_wo_tail_base_bonus = 6400;
            c_fixed_wo_tail_unit_bonus = 920;
        var
            head_pinyin_local: string;
            head_text_local: string;
            normalized_query_local: string;
            tail_key_local: string;
            tail_units_local: Integer;
            tail_results_local: TncCandidateList;
            seen_local: TDictionary<string, Byte>;
            accepted_before_local: Integer;
            exact_accepted_local: Boolean;

            procedure append_tail_candidates_local(
                const candidates_local: TncCandidateList);
            var
                local_idx: Integer;
                candidate_local: TncCandidate;
                tail_text_local: string;
                tail_text_units_local: Integer;
                tail_score_local: Integer;
                seen_key_local: string;
            begin
                for local_idx := 0 to High(candidates_local) do
                begin
                    if local_idx >= c_tail_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(candidates_local[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    tail_text_local := Trim(candidates_local[local_idx].text);
                    tail_text_units_local :=
                        get_candidate_text_unit_count(tail_text_local);
                    if (tail_text_local = '') or (tail_text_units_local < 2) or
                        (tail_text_units_local > 3) then
                    begin
                        Continue;
                    end;
                    if (not m_dictionary.is_base_entry(tail_key_local,
                        tail_text_local)) and
                        (not m_dictionary.is_user_entry(tail_key_local,
                        tail_text_local)) then
                    begin
                        Continue;
                    end;

                    seen_key_local := tail_text_local;
                    if seen_local.ContainsKey(seen_key_local) then
                    begin
                        Continue;
                    end;

                    tail_score_local := candidates_local[local_idx].score;
                    if candidates_local[local_idx].has_dict_weight then
                    begin
                        tail_score_local := candidates_local[local_idx].dict_weight;
                    end;
                    if candidates_local[local_idx].source = cs_user then
                    begin
                        Inc(tail_score_local, c_user_score_bonus);
                    end;

                    FillChar(candidate_local, SizeOf(candidate_local), 0);
                    candidate_local.text := head_text_local + tail_text_local;
                    candidate_local.comment := '';
                    candidate_local.source := cs_rule;
                    candidate_local.score := tail_score_local +
                        c_fixed_wo_tail_base_bonus +
                        (tail_text_units_local * c_fixed_wo_tail_unit_bonus);
                    candidate_local.has_dict_weight := True;
                    candidate_local.dict_weight := candidate_local.score;
                    remember_segment_path_for_candidate(candidate_local.text, '',
                        head_text_local + c_segment_path_separator +
                        tail_text_local, candidate_local.score);

                    SetLength(out_candidates, Length(out_candidates) + 1);
                    out_candidates[High(out_candidates)] := candidate_local;
                    seen_local.AddOrSetValue(seen_key_local, 1);
                end;
            end;
        begin
            SetLength(out_candidates, 0);
            Result := False;
            if m_dictionary = nil then
            begin
                Exit;
            end;

            normalized_query_local := normalize_pinyin_text(lookup_text);
            if not try_get_fixed_pronoun_tail_query_parts(
                normalized_query_local, input_syllable_count,
                head_pinyin_local, head_text_local, tail_key_local,
                tail_units_local) then
            begin
                Exit;
            end;
            if tail_key_local = '' then
            begin
                Exit;
            end;

            seen_local := TDictionary<string, Byte>.Create;
            try
                exact_accepted_local := False;
                if lookup_exact_full_pinyin_cached_local(tail_key_local,
                    tail_results_local) then
                begin
                    accepted_before_local := Length(out_candidates);
                    append_tail_candidates_local(tail_results_local);
                    exact_accepted_local := Length(out_candidates) >
                        accepted_before_local;
                end;
                if (not (exact_accepted_local and
                    is_full_pinyin_key(tail_key_local))) and
                    m_dictionary.lookup(tail_key_local, tail_results_local) then
                begin
                    append_tail_candidates_local(tail_results_local);
                end;
            finally
                seen_local.Free;
            end;

            sort_candidates_lightweight(out_candidates);
            Result := Length(out_candidates) > 0;
        end;

        procedure suppress_non_fixed_wo_single_head_partials_for_prefix_final_local(
            var candidates: TncCandidateList);
        var
            has_fixed_wo_tail_candidate: Boolean;
            head_pinyin_local: string;
            head_text_local: string;
            tail_key_local: string;
            tail_units_local: Integer;
            idx: Integer;
            out_idx: Integer;
            candidate_text: string;
            candidate_units: TArray<string>;
        begin
            if (Length(candidates) = 0) or
                (not try_get_fixed_pronoun_tail_query_parts(lookup_text,
                input_syllable_count, head_pinyin_local, head_text_local,
                tail_key_local, tail_units_local)) then
            begin
                Exit;
            end;

            has_fixed_wo_tail_candidate := False;
            for idx := 0 to High(candidates) do
            begin
                candidate_text := Trim(candidates[idx].text);
                if (Trim(candidates[idx].comment) = '') and
                    (get_candidate_text_unit_count(candidate_text) >= 2) and
                    (Copy(candidate_text, 1, 1) = head_text_local) then
                begin
                    has_fixed_wo_tail_candidate := True;
                    Break;
                end;
            end;
            if not has_fixed_wo_tail_candidate then
            begin
                Exit;
            end;

            out_idx := 0;
            for idx := 0 to High(candidates) do
            begin
                candidate_text := Trim(candidates[idx].text);
                candidate_units := split_text_units(candidate_text);
                if (Trim(candidates[idx].comment) <> '') and
                    (Length(candidate_units) >= 2) and
                    (Trim(candidate_units[0]) <> head_text_local) and
                    (m_dictionary <> nil) and
                    m_dictionary.single_char_matches_pinyin(head_pinyin_local,
                    Trim(candidate_units[0])) then
                begin
                    Continue;
                end;

                if out_idx <> idx then
                begin
                    candidates[out_idx] := candidates[idx];
                end;
                Inc(out_idx);
            end;
            if out_idx <> Length(candidates) then
            begin
                SetLength(candidates, out_idx);
            end;
        end;

        procedure ensure_fixed_head_tail_complete_from_visible_partial_local(
            var candidates: TncCandidateList);
        const
            c_tail_probe_limit = 8;
            c_fixed_head_tail_base_bonus = 6400;
            c_fixed_head_tail_unit_bonus = 920;
        var
            head_pinyin_local: string;
            head_text_local: string;
            tail_key_local: string;
            tail_units_local: Integer;
            idx_local: Integer;
            tail_idx_local: Integer;
            tail_results_local: TncCandidateList;
            additions_local: TncCandidateList;
            candidate_local: TncCandidate;
            tail_text_local: string;
            complete_text_local: string;
            tail_text_units_local: Integer;
            tail_score_local: Integer;
            seen_local: TDictionary<string, Byte>;
        begin
            if (Length(candidates) = 0) or (m_dictionary = nil) or
                (not try_get_fixed_pronoun_tail_query_parts(lookup_text,
                input_syllable_count, head_pinyin_local, head_text_local,
                tail_key_local, tail_units_local)) or (head_text_local = '') or
                (tail_key_local = '') then
            begin
                Exit;
            end;

            if not lookup_exact_full_pinyin_cached_local(tail_key_local,
                tail_results_local) then
            begin
                Exit;
            end;

            SetLength(additions_local, 0);
            seen_local := TDictionary<string, Byte>.Create;
            try
                for idx_local := 0 to High(candidates) do
                begin
                    if Trim(candidates[idx_local].comment) = '' then
                    begin
                        seen_local.AddOrSetValue(Trim(candidates[idx_local].text),
                            1);
                    end;
                end;

                for idx_local := 0 to High(candidates) do
                begin
                    if (Trim(candidates[idx_local].text) <> head_text_local) or
                        (normalize_pinyin_text(Trim(candidates[idx_local].comment)) <>
                        tail_key_local) then
                    begin
                        Continue;
                    end;

                    for tail_idx_local := 0 to High(tail_results_local) do
                    begin
                        if tail_idx_local >= c_tail_probe_limit then
                        begin
                            Break;
                        end;
                        if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;

                        tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                        tail_text_units_local :=
                            get_candidate_text_unit_count(tail_text_local);
                        if (tail_text_local = '') or (tail_text_units_local < 2) or
                            (tail_text_units_local > 3) then
                        begin
                            Continue;
                        end;
                        if (not m_dictionary.is_base_entry(tail_key_local,
                            tail_text_local)) and
                            (not m_dictionary.is_user_entry(tail_key_local,
                            tail_text_local)) then
                        begin
                            Continue;
                        end;

                        complete_text_local := head_text_local + tail_text_local;
                        if seen_local.ContainsKey(complete_text_local) then
                        begin
                            Continue;
                        end;

                        tail_score_local := tail_results_local[tail_idx_local].score;
                        if tail_results_local[tail_idx_local].has_dict_weight then
                        begin
                            tail_score_local :=
                                tail_results_local[tail_idx_local].dict_weight;
                        end;
                        if tail_results_local[tail_idx_local].source = cs_user then
                        begin
                            Inc(tail_score_local, c_user_score_bonus);
                        end;

                        FillChar(candidate_local, SizeOf(candidate_local), 0);
                        candidate_local.text := complete_text_local;
                        candidate_local.comment := '';
                        candidate_local.source := cs_rule;
                        candidate_local.score := tail_score_local +
                            c_fixed_head_tail_base_bonus +
                            (tail_text_units_local * c_fixed_head_tail_unit_bonus);
                        candidate_local.has_dict_weight := True;
                        candidate_local.dict_weight := candidate_local.score;
                        remember_segment_path_for_candidate(candidate_local.text, '',
                            head_text_local + c_segment_path_separator +
                            tail_text_local, candidate_local.score);

                        SetLength(additions_local, Length(additions_local) + 1);
                        additions_local[High(additions_local)] := candidate_local;
                        seen_local.AddOrSetValue(complete_text_local, 1);
                    end;
                end;
            finally
                seen_local.Free;
            end;

            if Length(additions_local) = 0 then
            begin
                Exit;
            end;

            candidates := merge_candidate_lists(additions_local, candidates, 0);
            sort_candidates_lightweight(candidates);
            suppress_non_fixed_wo_single_head_partials_for_prefix_final_local(
                candidates);
        end;

        function should_use_fast_stable_prefix_partial_exit_local: Boolean;
        var
            top_text_local: string;
            top_comment_local: string;
            top_text_units_local: Integer;
            top_comment_units_local: Integer;
        begin
            Result := False;
            if allow_tail_resolution or (input_syllable_count <> 3) or
                (Length(m_candidates) = 0) then
            begin
                Exit;
            end;

            top_comment_local := normalize_pinyin_text(
                Trim(m_candidates[0].comment));
            if top_comment_local = '' then
            begin
                Exit;
            end;

            if not (has_short_extendable_tail_prefix_local or
                has_extendable_same_syllable_tail_local(lookup_text,
                input_syllable_count)) then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            top_text_units_local := get_candidate_text_unit_count(top_text_local);
            top_comment_units_local :=
                get_effective_compact_pinyin_unit_count(top_comment_local);
            if (top_text_units_local < 2) or (top_comment_units_local <= 0) or
                (top_text_units_local + top_comment_units_local <>
                input_syllable_count) then
            begin
                Exit;
            end;

            Result := (m_candidates[0].source = cs_user) or
                m_candidates[0].has_dict_weight;
        end;

        function candidate_has_fast_four_syllable_two_phrase_support_local(
            const candidate: TncCandidate): Boolean;
        var
            syllables_local: TncPinyinParseResult;
            units_local: TArray<string>;
            head_key_local: string;
            tail_key_local: string;
            head_text_local: string;
            tail_text_local: string;

            function build_key_local(const start_idx: Integer;
                const count_local: Integer): string;
            var
                local_idx: Integer;
            begin
                Result := '';
                if (start_idx < 0) or (count_local <= 0) or
                    (start_idx + count_local > Length(syllables_local)) then
                begin
                    Exit;
                end;
                for local_idx := start_idx to start_idx + count_local - 1 do
                begin
                    Result := Result + normalize_pinyin_text(
                        syllables_local[local_idx].text);
                end;
            end;

            function exact_phrase_text_exists_local(const key_value: string;
                const text_value: string): Boolean;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
            begin
                Result := False;
                if (key_value = '') or (text_value = '') or
                    (get_candidate_text_unit_count(text_value) <> 2) or
                    (m_dictionary = nil) then
                begin
                    Exit;
                end;

                if m_dictionary.is_base_entry(key_value, text_value) then
                begin
                    Exit(True);
                end;

                if not lookup_exact_full_pinyin_cached_local(key_value,
                    exact_results_local) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(Trim(exact_results_local[exact_idx_local].text),
                        text_value) and
                        (get_candidate_text_unit_count(Trim(
                        exact_results_local[exact_idx_local].text)) = 2) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (input_syllable_count <> 4) or
                (Trim(candidate.comment) <> '') then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(candidate.text));
            if Length(units_local) <> 4 then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(lookup_text));
            if Length(syllables_local) <> 4 then
            begin
                Exit;
            end;

            head_key_local := build_key_local(0, 2);
            tail_key_local := build_key_local(2, 2);
            head_text_local := units_local[0] + units_local[1];
            tail_text_local := units_local[2] + units_local[3];
            Result := exact_phrase_text_exists_local(head_key_local,
                head_text_local) and exact_phrase_text_exists_local(
                tail_key_local, tail_text_local);
        end;

        function should_use_fast_complete_short_split_exit_local: Boolean;
        var
            candidate_idx_local: Integer;
            move_idx_local: Integer;
            picked_local: TncCandidate;

            function candidate_has_fast_two_phrase_path_local(
                const candidate: TncCandidate): Boolean;
            var
                path_local: string;
                segments_local: TArray<string>;
            begin
                path_local := get_segment_path_for_candidate(candidate);
                if path_local = '' then
                begin
                    Exit(candidate_has_fast_four_syllable_two_phrase_support_local(
                        candidate));
                end;

                segments_local := path_local.Split([c_segment_path_separator]);
                if (Length(segments_local) = 2) and
                    (get_candidate_text_unit_count(Trim(segments_local[0])) = 2) and
                    (get_candidate_text_unit_count(Trim(segments_local[1])) = 2) then
                begin
                    Exit(True);
                end;

                // Session learning can remember a valid 2+2 phrase as a more
                // granular path (for example AB/C/D).  The fast exit should be
                // based on text support, not only on the stored path shape.
                Result := candidate_has_fast_four_syllable_two_phrase_support_local(
                    candidate);
            end;

            function candidate_can_use_fast_exit_local(
                const candidate: TncCandidate): Boolean;
            var
                text_local: string;
            begin
                Result := False;
                if Trim(candidate.comment) <> '' then
                begin
                    Exit;
                end;

                text_local := Trim(candidate.text);
                Result := (text_local <> '') and
                    (get_candidate_text_unit_count(text_local) =
                    input_syllable_count) and
                    candidate_has_fast_two_phrase_path_local(candidate);
            end;
        begin
            Result := False;
            if allow_tail_resolution or (input_syllable_count <> 4) or
                (Length(m_candidates) = 0) then
            begin
                Exit;
            end;

            if candidate_can_use_fast_exit_local(m_candidates[0]) then
            begin
                Exit(True);
            end;
            for candidate_idx_local := 1 to Min(High(m_candidates), 31) do
            begin
                if not candidate_can_use_fast_exit_local(
                    m_candidates[candidate_idx_local]) then
                begin
                    Continue;
                end;

                picked_local := m_candidates[candidate_idx_local];
                move_idx_local := candidate_idx_local;
                while move_idx_local > 0 do
                begin
                    m_candidates[move_idx_local] :=
                        m_candidates[move_idx_local - 1];
                    Dec(move_idx_local);
                end;
                m_candidates[0] := picked_local;
                Exit(True);
            end;
        end;

        procedure ensure_exact_prefix_phrase_partials_before_other_partials_local(
            var candidates: TncCandidateList);
        var
            target_idx_local: Integer;
            scan_idx_local: Integer;
            picked_local: TncCandidate;

            function is_exact_prefix_phrase_partial_local(
                const candidate: TncCandidate): Boolean;
            var
                prefix_key_local: string;
                prefix_text_local: string;
                prefix_units_count_local: Integer;
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                normalized_query_local: string;
                normalized_comment_local: string;
                comment_units_count_local: Integer;
            begin
                Result := False;
                if (m_dictionary = nil) or (Trim(candidate.comment) = '') then
                begin
                    Exit;
                end;
                if Pos(c_segment_path_separator,
                    get_segment_path_for_candidate(candidate)) > 0 then
                begin
                    Exit;
                end;

                prefix_text_local := Trim(candidate.text);
                prefix_units_count_local :=
                    get_candidate_text_unit_count(prefix_text_local);
                if prefix_units_count_local < 2 then
                begin
                    Exit;
                end;

                normalized_query_local := normalize_pinyin_text(lookup_text);
                normalized_comment_local :=
                    normalize_pinyin_text(candidate.comment);
                if (normalized_query_local = '') or
                    (normalized_comment_local = '') or
                    (Length(normalized_query_local) <=
                    Length(normalized_comment_local)) or
                    (Copy(normalized_query_local,
                    Length(normalized_query_local) -
                    Length(normalized_comment_local) + 1,
                    Length(normalized_comment_local)) <>
                    normalized_comment_local) then
                begin
                    Exit;
                end;

                prefix_key_local := Copy(normalized_query_local, 1,
                    Length(normalized_query_local) -
                    Length(normalized_comment_local));
                comment_units_count_local :=
                    input_syllable_count - prefix_units_count_local;
                if (prefix_key_local = '') or
                    (get_effective_compact_pinyin_unit_count(prefix_key_local) <>
                    prefix_units_count_local) or
                    (comment_units_count_local <= 0) then
                begin
                    Exit;
                end;

                if (input_syllable_count = 4) and
                    (prefix_units_count_local = 2) and
                    (comment_units_count_local = 2) and
                    (Length(normalized_comment_local) > 2) and
                    candidate.has_dict_weight then
                begin
                    Exit(True);
                end;

                if m_dictionary.is_base_entry(prefix_key_local,
                    prefix_text_local) then
                begin
                    Exit(True);
                end;

                if not lookup_exact_full_pinyin_cached_local(prefix_key_local,
                    exact_results_local) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(Trim(exact_results_local[exact_idx_local].text),
                        prefix_text_local) and
                        (get_candidate_text_unit_count(Trim(
                        exact_results_local[exact_idx_local].text)) =
                        prefix_units_count_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if Length(candidates) <= 1 then
            begin
                Exit;
            end;

            target_idx_local := 0;
            while (target_idx_local <= High(candidates)) and
                (Trim(candidates[target_idx_local].comment) = '') do
            begin
                Inc(target_idx_local);
            end;

            scan_idx_local := target_idx_local;
            while scan_idx_local <= High(candidates) do
            begin
                if not is_exact_prefix_phrase_partial_local(
                    candidates[scan_idx_local]) then
                begin
                    Inc(scan_idx_local);
                    Continue;
                end;

                picked_local := candidates[scan_idx_local];
                while scan_idx_local > target_idx_local do
                begin
                    candidates[scan_idx_local] := candidates[scan_idx_local - 1];
                    Dec(scan_idx_local);
                end;
                candidates[target_idx_local] := picked_local;
                Inc(target_idx_local);
                scan_idx_local := target_idx_local + 1;
            end;
        end;

        procedure ensure_balanced_prefix_phrase_partials_first_local(
            var candidates: TncCandidateList);
        var
            target_idx_local: Integer;
            scan_idx_local: Integer;
            picked_local: TncCandidate;

            function is_balanced_prefix_phrase_partial_local(
                const candidate: TncCandidate): Boolean;
            begin
                Result := (input_syllable_count = 4) and
                    (Trim(candidate.comment) <> '') and
                    candidate.has_dict_weight and
                    (Length(Trim(candidate.text)) > 1) and
                    (Length(normalize_pinyin_text(candidate.comment)) > 2) and
                    (get_candidate_text_unit_count(Trim(candidate.text)) <= 2);
            end;
        begin
            if Length(candidates) <= 1 then
            begin
                Exit;
            end;

            target_idx_local := 0;
            while (target_idx_local <= High(candidates)) and
                (Trim(candidates[target_idx_local].comment) = '') do
            begin
                Inc(target_idx_local);
            end;

            scan_idx_local := target_idx_local;
            while scan_idx_local <= High(candidates) do
            begin
                if not is_balanced_prefix_phrase_partial_local(
                    candidates[scan_idx_local]) then
                begin
                    Inc(scan_idx_local);
                    Continue;
                end;

                picked_local := candidates[scan_idx_local];
                while scan_idx_local > target_idx_local do
                begin
                    candidates[scan_idx_local] := candidates[scan_idx_local - 1];
                    Dec(scan_idx_local);
                end;
                candidates[target_idx_local] := picked_local;
                Inc(target_idx_local);
                scan_idx_local := target_idx_local + 1;
            end;
        end;

        procedure ensure_prefix_phrase_partials_before_single_partials_local(
            var candidates: TncCandidateList);
        var
            target_idx_local: Integer;
            scan_idx_local: Integer;
            first_single_idx_local: Integer;
            picked_local: TncCandidate;

            function is_partial_single_local(
                const candidate: TncCandidate): Boolean;
            begin
                Result := (Trim(candidate.comment) <> '') and
                    (get_candidate_text_unit_count(Trim(candidate.text)) = 1);
            end;

            function is_partial_phrase_local(
                const candidate: TncCandidate): Boolean;
            begin
                Result := (Trim(candidate.comment) <> '') and
                    (get_candidate_text_unit_count(Trim(candidate.text)) >= 2);
            end;
        begin
            if Length(candidates) <= 1 then
            begin
                Exit;
            end;

            first_single_idx_local := -1;
            for scan_idx_local := 0 to High(candidates) do
            begin
                if is_partial_single_local(candidates[scan_idx_local]) then
                begin
                    first_single_idx_local := scan_idx_local;
                    Break;
                end;
            end;
            if first_single_idx_local < 0 then
            begin
                Exit;
            end;

            target_idx_local := 0;
            while (target_idx_local <= High(candidates)) and
                (Trim(candidates[target_idx_local].comment) = '') do
            begin
                Inc(target_idx_local);
            end;

            scan_idx_local := target_idx_local;
            while scan_idx_local <= High(candidates) do
            begin
                if (scan_idx_local < first_single_idx_local) or
                    (not is_partial_phrase_local(candidates[scan_idx_local])) then
                begin
                    Inc(scan_idx_local);
                    Continue;
                end;

                picked_local := candidates[scan_idx_local];
                while scan_idx_local > target_idx_local do
                begin
                    candidates[scan_idx_local] := candidates[scan_idx_local - 1];
                    Dec(scan_idx_local);
                end;
                candidates[target_idx_local] := picked_local;
                Inc(target_idx_local);
                if target_idx_local > first_single_idx_local then
                begin
                    first_single_idx_local := target_idx_local;
                end;
                scan_idx_local := target_idx_local + 1;
            end;
        end;

        procedure stable_order_prefix_partials_by_matched_units_local(
            var candidates: TncCandidateList);
        var
            block_start_local: Integer;
            block_end_local: Integer;
            scan_idx_local: Integer;
            insert_idx_local: Integer;
            picked_local: TncCandidate;
            picked_units_local: Integer;

            function partial_prefix_units_local(
                const candidate: TncCandidate): Integer;
            var
                text_units_local: Integer;
                tail_units_local: Integer;
            begin
                text_units_local := get_candidate_text_unit_count(
                    Trim(candidate.text));
                tail_units_local := get_effective_compact_pinyin_unit_count(
                    candidate.comment);
                if (Trim(candidate.comment) = '') or
                    (text_units_local <= 0) or (tail_units_local <= 0) or
                    (text_units_local + tail_units_local <>
                    input_syllable_count) then
                begin
                    Exit(0);
                end;
                Result := text_units_local;
            end;
        begin
            if Length(candidates) <= 1 then
            begin
                Exit;
            end;

            // Keep complete candidates untouched, then order every aligned
            // prefix block by consumed syllables (3, 2, 1 for a four-syllable
            // query). Equal-length prefixes retain the established ranking.
            block_start_local := 0;
            while block_start_local <= High(candidates) do
            begin
                while (block_start_local <= High(candidates)) and
                    (partial_prefix_units_local(
                    candidates[block_start_local]) <= 0) do
                begin
                    Inc(block_start_local);
                end;
                if block_start_local > High(candidates) then
                begin
                    Break;
                end;

                block_end_local := block_start_local;
                while (block_end_local <= High(candidates)) and
                    (partial_prefix_units_local(
                    candidates[block_end_local]) > 0) do
                begin
                    Inc(block_end_local);
                end;
                Dec(block_end_local);

                scan_idx_local := block_start_local + 1;
                while scan_idx_local <= block_end_local do
                begin
                    picked_local := candidates[scan_idx_local];
                    picked_units_local := partial_prefix_units_local(
                        picked_local);
                    insert_idx_local := scan_idx_local;
                    while (insert_idx_local > block_start_local) and
                        (picked_units_local > partial_prefix_units_local(
                        candidates[insert_idx_local - 1])) do
                    begin
                        candidates[insert_idx_local] :=
                            candidates[insert_idx_local - 1];
                        Dec(insert_idx_local);
                    end;
                    candidates[insert_idx_local] := picked_local;
                    Inc(scan_idx_local);
                end;

                block_start_local := block_end_local + 1;
            end;
        end;

        procedure promote_supported_prefix_phrase_partial_over_unstable_complete_local(
            var candidates: TncCandidateList);
        var
            syllables_local: TncPinyinParseResult;
            top_text_local: string;
            best_idx_local: Integer;
            best_rank_local: Integer;
            idx_local: Integer;
            move_idx_local: Integer;
            picked_local: TncCandidate;

            function build_key_local(const start_idx: Integer;
                const count_local: Integer): string;
            var
                key_idx_local: Integer;
            begin
                Result := '';
                if (count_local <= 0) or (start_idx < 0) or
                    (start_idx + count_local > Length(syllables_local)) then
                begin
                    Exit;
                end;

                for key_idx_local := start_idx to start_idx + count_local - 1 do
                begin
                    Result := Result + normalize_pinyin_text(
                        syllables_local[key_idx_local].text);
                end;
            end;

            function exact_text_exists_local(const key_value: string;
                const text_value: string; const expected_units_local: Integer): Boolean;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or (key_value = '') or
                    (text_value = '') then
                begin
                    Exit;
                end;

                if m_dictionary.is_base_entry(key_value, text_value) or
                    m_dictionary.is_user_entry(key_value, text_value) then
                begin
                    Exit(True);
                end;

                if not lookup_exact_full_pinyin_cached_local(key_value,
                    exact_results_local) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(exact_text_local, text_value) and
                        (get_candidate_text_unit_count(exact_text_local) =
                        expected_units_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function is_supported_prefix_partial_local(
                const candidate: TncCandidate; out out_rank: Integer): Boolean;
            var
                prefix_text_local: string;
                tail_key_local: string;
                prefix_units_local: Integer;
                tail_units_local: Integer;
                prefix_key_local: string;
            begin
                Result := False;
                out_rank := Low(Integer);
                if Trim(candidate.comment) = '' then
                begin
                    Exit;
                end;

                prefix_text_local := Trim(candidate.text);
                tail_key_local := normalize_pinyin_text(Trim(candidate.comment));
                prefix_units_local := get_candidate_text_unit_count(
                    prefix_text_local);
                tail_units_local :=
                    get_effective_compact_pinyin_unit_count(tail_key_local);
                if (prefix_text_local = '') or (tail_key_local = '') or
                    (prefix_units_local < 2) or
                    (prefix_units_local >= input_syllable_count) or
                    (tail_units_local <= 0) or
                    (prefix_units_local + tail_units_local <>
                    input_syllable_count) then
                begin
                    Exit;
                end;

                prefix_key_local := build_key_local(0, prefix_units_local);
                if not exact_text_exists_local(prefix_key_local,
                    prefix_text_local, prefix_units_local) then
                begin
                    Exit;
                end;

                out_rank := prefix_units_local * 100000;
                if candidate.source = cs_user then
                begin
                    Inc(out_rank, 50000);
                end;
                if candidate.has_dict_weight then
                begin
                    Inc(out_rank, candidate.dict_weight);
                end
                else
                begin
                    Inc(out_rank, candidate.score);
                end;
                Result := True;
            end;
        var
            rank_local: Integer;
        begin
            if (Length(candidates) <= 1) or (m_dictionary = nil) or
                (input_syllable_count < 3) or (input_syllable_count > 5) or
                (not is_full_pinyin_key(lookup_text)) or
                (Trim(candidates[0].comment) <> '') then
            begin
                Exit;
            end;

            top_text_local := Trim(candidates[0].text);
            if (top_text_local = '') or
                (get_candidate_text_unit_count(top_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if exact_text_exists_local(lookup_text, top_text_local,
                input_syllable_count) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(lookup_text));
            if Length(syllables_local) <> input_syllable_count then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_rank_local := Low(Integer);
            for idx_local := 1 to High(candidates) do
            begin
                if is_supported_prefix_partial_local(candidates[idx_local],
                    rank_local) and (rank_local > best_rank_local) then
                begin
                    best_idx_local := idx_local;
                    best_rank_local := rank_local;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            picked_local := candidates[best_idx_local];
            if picked_local.score <= candidates[0].score then
            begin
                picked_local.score := candidates[0].score + 1;
            end;
            for move_idx_local := best_idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_local;
        end;

        procedure ensure_dangling_initial_prediction_visible_local(
            var candidates: TncCandidateList);
        var
            idx_local: Integer;
            target_idx_local: Integer;
            move_idx_local: Integer;
            seed_text_local: string;
            tail_key_local: string;
            predicted_text_local: string;
            predicted_candidate_local: TncCandidate;
            seed_units_local: Integer;

            function is_single_initial_fragment_local(
                const value: string): Boolean;
            begin
                Result := (Length(value) = 1) and
                    CharInSet(value[1], ['b', 'p', 'm', 'f', 'd', 't', 'n',
                    'l', 'g', 'k', 'h', 'j', 'q', 'x', 'z', 'c', 's', 'r',
                    'y', 'w']);
            end;

            function get_common_initial_prediction_local(
                const value: string): string;
            begin
                Result := '';
                if SameText(value, 'w') then
                begin
                    Result := string(Char($6211));
                end
                else if SameText(value, 'h') then
                begin
                    Result := string(Char($548C));
                end
                else if SameText(value, 'q') then
                begin
                    Result := string(Char($53BB));
                end
                else if SameText(value, 'y') then
                begin
                    Result := string(Char($4E00));
                end;
            end;

            function has_candidate_local(const candidate_text: string;
                const candidate_comment: string): Boolean;
            var
                local_idx: Integer;
            begin
                Result := False;
                for local_idx := 0 to High(candidates) do
                begin
                    if SameText(Trim(candidates[local_idx].text),
                        candidate_text) and
                        SameText(Trim(candidates[local_idx].comment),
                        candidate_comment) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (Length(candidates) = 0) or (input_syllable_count < 3) then
            begin
                Exit;
            end;

            for idx_local := 0 to Min(2, High(candidates)) do
            begin
                seed_text_local := Trim(candidates[idx_local].text);
                tail_key_local := normalize_pinyin_text(
                    Trim(candidates[idx_local].comment));
                seed_units_local := get_candidate_text_unit_count(seed_text_local);
                if (seed_text_local = '') or
                    (not is_single_initial_fragment_local(tail_key_local)) or
                    (seed_units_local + 1 <> input_syllable_count) or
                    (seed_units_local > 2) then
                begin
                    Continue;
                end;

                predicted_text_local :=
                    get_common_initial_prediction_local(tail_key_local);
                if (predicted_text_local = '') or
                    has_candidate_local(seed_text_local + predicted_text_local,
                    '') then
                begin
                    Exit;
                end;

                predicted_candidate_local := candidates[idx_local];
                predicted_candidate_local.text := seed_text_local +
                    predicted_text_local;
                predicted_candidate_local.comment := '';
                predicted_candidate_local.score := Max(1,
                    candidates[idx_local].score - 2);
                predicted_candidate_local.source := cs_rule;
                predicted_candidate_local.has_dict_weight := True;
                predicted_candidate_local.dict_weight :=
                    predicted_candidate_local.score;
                target_idx_local := Min(idx_local + 1, Length(candidates));
                SetLength(candidates, Length(candidates) + 1);
                for move_idx_local := High(candidates) downto
                    target_idx_local + 1 do
                begin
                    candidates[move_idx_local] :=
                        candidates[move_idx_local - 1];
                end;
                candidates[target_idx_local] := predicted_candidate_local;
                Exit;
            end;
        end;

        function has_complete_short_particle_tail_candidate_visible_local: Boolean;
        var
            tail_key_local: string;
            tail_text_local: string;
            head_key_local: string;
            candidate_idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            if not try_get_short_particle_tail_query_parts(lookup_text,
                tail_key_local, tail_text_local, head_key_local) then
            begin
                Exit;
            end;
            if tail_text_local = '' then
            begin
                Exit;
            end;
            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                candidate_text_local := Trim(m_candidates[candidate_idx_local].text);
                if (Trim(m_candidates[candidate_idx_local].comment) = '') and
