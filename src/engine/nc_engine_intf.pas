    function display_candidate_is_unsupported_short_four_ab_c_partial(
        const candidate_value: TncCandidate): Boolean;
    var
        candidate_text_local: string;
        units_local: TArray<string>;
        head_text_local: string;
        tail_text_local: string;
        tail_key_local: string;
        prefix_key_local: string;
        prefix_text_local: string;
        normalized_comment_local: string;
        comment_unit_count_local: Integer;
        unit_idx_local: Integer;

        function candidate_has_allowed_one_plus_two_prefix_support_local:
            Boolean;
        begin
            Result := False;
            if Length(units_local) <> 3 then
            begin
                Exit;
            end;

            head_text_local := Trim(units_local[0]);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            tail_key_local := build_display_query_key(1, 2);
            Result := (head_text_local <> '') and (tail_text_local <> '') and
                (tail_key_local <> '') and
                is_display_one_plus_two_supported_head_single(head_text_local) and
                display_exact_key_has_text(tail_key_local, tail_text_local);
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (expected_units <> 4) or
            (Length(syllables) <> 4) or
            (not is_full_pinyin_key(normalized_pinyin)) or
            (Trim(candidate_value.comment) = '') then
        begin
            Exit;
        end;

        normalized_comment_local := normalize_pinyin_text(
            Trim(candidate_value.comment));
        comment_unit_count_local := get_effective_compact_pinyin_unit_count(
            normalized_comment_local);
        if comment_unit_count_local <= 0 then
        begin
            Exit;
        end;

        candidate_text_local := Trim(candidate_value.text);
        units_local := split_text_units(candidate_text_local);
        if (Length(units_local) < 2) or (Length(units_local) > 3) then
        begin
            Exit;
        end;
        if Length(units_local) + comment_unit_count_local <> expected_units then
        begin
            Exit;
        end;

        prefix_text_local := '';
        for unit_idx_local := 0 to High(units_local) do
        begin
            prefix_text_local := prefix_text_local + units_local[unit_idx_local];
        end;
        prefix_key_local := build_display_query_key(0, Length(units_local));
        if display_exact_key_has_text(prefix_key_local, prefix_text_local) then
        begin
            Exit;
        end;

        if Length(units_local) <> 3 then
        begin
            Exit(True);
        end;

        if candidate_has_allowed_one_plus_two_prefix_support_local then
        begin
            Exit(False);
        end;

        Exit(True);
    end;

