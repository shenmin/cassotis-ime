            out_text_local := '';
            out_weight_local := Low(Integer);
            if count_local < 2 then
            begin
                Exit;
            end;

            segment_key_local := build_syllable_key_range_local(start_idx_local,
                count_local);
            if (segment_key_local = '') or
                (not dictionary_exact_lookup_cached(segment_key_local,
                segment_results_local)) then
            begin
                Exit;
            end;

            for segment_idx_local := 0 to High(segment_results_local) do
            begin
                if segment_idx_local >= c_tail_probe_limit then
                begin
                    Break;
                end;
                if Trim(segment_results_local[segment_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                segment_text_local := Trim(
                    segment_results_local[segment_idx_local].text);
                if (segment_text_local = '') or
                    (get_candidate_text_unit_count(segment_text_local) <>
                    count_local) then
                begin
                    Continue;
                end;

                segment_weight_local := get_candidate_weight_local(
                    segment_results_local[segment_idx_local]);
                if segment_weight_local > out_weight_local then
                begin
                    out_weight_local := segment_weight_local;
                    out_text_local := segment_text_local;
                    Result := True;
                end;
            end;
        end;

        function try_build_remainder_exact_chain_local(out out_text_local: string;
            out out_path_local: string; out out_weight_local: Integer): Boolean;
        var
            segment_count_local: Integer;
            first_segment_units_local: Integer;

            function is_structural_particle_remainder_text_local(
                const value_local: string): Boolean;
            begin
                Result := (value_local = string(Char($7684))) or
                    (value_local = string(Char($5F97))) or
                    (value_local = string(Char($5730)));
            end;

            function try_get_single_remainder_segment_local(
                const start_idx_local: Integer; out out_text: string;
                out out_weight: Integer): Boolean;
            var
                single_key_local: string;
                single_results_local: TncCandidateList;
                single_idx_local: Integer;
                single_text_local: string;
                single_weight_local: Integer;

                function is_copula_tail_text_local(
                    const key_value: string; const text_value: string): Boolean;
                begin
                    Result := SameText(normalize_pinyin_text(key_value), 'shi') and
                        SameText(text_value, string(Char($662F)));
                end;
            begin
                Result := False;
                out_text := '';
                out_weight := Low(Integer);
                if (start_idx_local < 0) or
                    (start_idx_local >= Length(syllables_local)) then
                begin
                    Exit;
                end;

                single_key_local := normalize_pinyin_text(
                    syllables_local[start_idx_local].text);
                if not dictionary_exact_lookup_cached(single_key_local,
                    single_results_local) then
                begin
                    Exit;
                end;

                for single_idx_local := 0 to High(single_results_local) do
                begin
                    if single_idx_local >= c_tail_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(single_results_local[single_idx_local].comment) <>
                        '' then
                    begin
                        Continue;
                    end;
                    single_text_local := Trim(
                        single_results_local[single_idx_local].text);
                    if (single_text_local = '') or
                        (get_candidate_text_unit_count(single_text_local) <> 1) then
                    begin
                        Continue;
                    end;

                    single_weight_local := get_candidate_weight_local(
                        single_results_local[single_idx_local]);
                    if is_structural_particle_remainder_text_local(
                        single_text_local) then
                    begin
                        Inc(single_weight_local, 1024);
                    end;
                    if is_copula_tail_text_local(single_key_local,
                        single_text_local) then
                    begin
                        Inc(single_weight_local, 4096);
                    end;
                    if (not Result) or (single_weight_local > out_weight) then
                    begin
                        Result := True;
                        out_text := single_text_local;
                        out_weight := single_weight_local;
                    end;
                end;
            end;

            function try_build_remainder_from_pos_local(
                const pos_value_local: Integer; out out_text_value_local: string;
                out out_path_value_local: string; out out_weight_value_local: Integer;
                out out_segment_count_local: Integer;
                out out_first_segment_units_local: Integer): Boolean;
            var
                local_span: Integer;
                local_remaining: Integer;
                local_segment_text: string;
                local_segment_weight: Integer;
                local_suffix_text: string;
                local_suffix_path: string;
                local_suffix_weight: Integer;
                local_suffix_segments: Integer;
                local_suffix_first_units: Integer;
                local_candidate_text: string;
                local_candidate_path: string;
                local_candidate_weight: Integer;
                local_candidate_segments: Integer;
                local_candidate_first_units: Integer;
                local_fixed_text: string;
                local_fixed_weight: Integer;

                procedure consider_candidate_local(const text_value_local: string;
                    const path_value_local: string; const weight_value_local: Integer;
                    const segments_value_local: Integer;
                    const first_units_value_local: Integer);
                begin
                    if (text_value_local = '') or (path_value_local = '') or
                        (segments_value_local <= 0) then
                    begin
                        Exit;
                    end;
                    if (not Result) or
                        (weight_value_local > out_weight_value_local) then
                    begin
                        Result := True;
                        out_text_value_local := text_value_local;
                        out_path_value_local := path_value_local;
                        out_weight_value_local := weight_value_local;
                        out_segment_count_local := segments_value_local;
                        out_first_segment_units_local := first_units_value_local;
                    end;
                end;
            begin
                Result := False;
                out_text_value_local := '';
                out_path_value_local := '';
                out_weight_value_local := Low(Integer);
                out_segment_count_local := 0;
                out_first_segment_units_local := 0;

                if (pos_value_local >= 0) and
                    (pos_value_local < Length(remainder_memo_state)) and
                    (remainder_memo_state[pos_value_local] <> 0) then
                begin
                    Result := remainder_memo_state[pos_value_local] = 2;
                    if Result then
                    begin
                        out_text_value_local :=
                            remainder_memo_text[pos_value_local];
                        out_path_value_local :=
                            remainder_memo_path[pos_value_local];
                        out_weight_value_local :=
                            remainder_memo_weight[pos_value_local];
                        out_segment_count_local :=
                            remainder_memo_segments[pos_value_local];
                        out_first_segment_units_local :=
                            remainder_memo_first_units[pos_value_local];
                    end;
                    Exit;
                end;

                if pos_value_local >= Length(syllables_local) then
                begin
                    Result := True;
                    out_weight_value_local := 0;
                    remainder_memo_state[pos_value_local] := 2;
                    remainder_memo_weight[pos_value_local] := 0;
                    Exit;
                end;

                if try_get_single_remainder_segment_local(pos_value_local,
                    local_fixed_text, local_fixed_weight) and
                    ((pos_value_local = Length(syllables_local) - 1) or
                    is_structural_particle_remainder_text_local(
                    local_fixed_text)) and
                    try_build_remainder_from_pos_local(pos_value_local + 1,
                    local_suffix_text, local_suffix_path, local_suffix_weight,
                    local_suffix_segments, local_suffix_first_units) then
                begin
                    local_candidate_text := local_fixed_text + local_suffix_text;
                    local_candidate_path := local_fixed_text;
                    if local_suffix_path <> '' then
                    begin
                        local_candidate_path := local_candidate_path +
                            c_segment_path_separator + local_suffix_path;
                    end;
                    local_candidate_weight := local_fixed_weight +
                        local_suffix_weight;
                    if (pos_value_local < Length(syllables_local) - 1) and
                        (local_suffix_segments > 0) then
                    begin
                        Inc(local_candidate_weight, 4096);
                    end;
                    local_candidate_segments := 1 + local_suffix_segments;
                    local_candidate_first_units := 1;
                    consider_candidate_local(local_candidate_text,
                        local_candidate_path, local_candidate_weight,
                        local_candidate_segments, local_candidate_first_units);
                end;

                local_remaining := Length(syllables_local) - pos_value_local;
                for local_span := Min(4, local_remaining) downto 2 do
                begin
                    if not try_get_best_exact_segment_local(pos_value_local,
                        local_span, local_segment_text,
                        local_segment_weight) then
                    begin
                        Continue;
                    end;
                    if local_segment_weight < c_tail_min_weight then
                    begin
                        Continue;
                    end;
                    if not try_build_remainder_from_pos_local(
                        pos_value_local + local_span, local_suffix_text,
                        local_suffix_path, local_suffix_weight,
                        local_suffix_segments, local_suffix_first_units) then
                    begin
                        Continue;
                    end;

                    local_candidate_text := local_segment_text +
                        local_suffix_text;
                    local_candidate_path := local_segment_text;
                    if local_suffix_path <> '' then
                    begin
                        local_candidate_path := local_candidate_path +
                            c_segment_path_separator + local_suffix_path;
                    end;
                    local_candidate_weight := local_segment_weight +
                        local_suffix_weight;
                    if local_span >= 3 then
                    begin
                        Inc(local_candidate_weight, 256);
                    end;
                    local_candidate_segments := 1 + local_suffix_segments;
                    local_candidate_first_units := local_span;
                    consider_candidate_local(local_candidate_text,
                        local_candidate_path, local_candidate_weight,
                        local_candidate_segments, local_candidate_first_units);
                end;

                if Result then
                begin
                    remainder_memo_state[pos_value_local] := 2;
                    remainder_memo_text[pos_value_local] :=
                        out_text_value_local;
                    remainder_memo_path[pos_value_local] :=
                        out_path_value_local;
                    remainder_memo_weight[pos_value_local] :=
                        out_weight_value_local;
                    remainder_memo_segments[pos_value_local] :=
                        out_segment_count_local;
                    remainder_memo_first_units[pos_value_local] :=
                        out_first_segment_units_local;
                end
                else
                begin
                    remainder_memo_state[pos_value_local] := 1;
                end;
            end;
        begin
            Result := False;
            out_text_local := '';
            out_path_local := '';
            out_weight_local := 0;
            remainder_segment_count := 0;
            segment_count_local := 0;
            first_segment_units_local := 0;
            if not try_build_remainder_from_pos_local(1, out_text_local,
                out_path_local, out_weight_local, segment_count_local,
                first_segment_units_local) then
            begin
                Exit;
            end;

            if segment_count_local <= 0 then
            begin
                Exit;
            end;
            if (segment_count_local = 1) and
                (first_segment_units_local < input_syllable_count - 1) then
            begin
                Exit;
            end;
            remainder_segment_count := segment_count_local;
            Result := get_candidate_text_unit_count(out_text_local) =
                input_syllable_count - 1;
        end;

        function try_build_function_head_remainder_candidate_local: Boolean;
        var
            first_idx_local: Integer;
            first_text_local: string;
            first_weight_local: Integer;
            best_first_text_local: string;
            best_first_weight_local: Integer;
        begin
            Result := False;
            if (first_key = '') or (remainder_key = '') or
                (not dictionary_exact_lookup_cached(first_key, head_results)) then
            begin
                Exit;
            end;

            best_first_text_local := '';
            best_first_weight_local := Low(Integer);
            for first_idx_local := 0 to High(head_results) do
            begin
                if first_idx_local >= c_tail_probe_limit then
                begin
                    Break;
                end;
                if Trim(head_results[first_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                first_text_local := Trim(head_results[first_idx_local].text);
                if is_function_head_text_local(first_text_local) then
                begin
                    first_weight_local := get_candidate_weight_local(
                        head_results[first_idx_local]);
                    if first_weight_local > best_first_weight_local then
                    begin
                        best_first_weight_local := first_weight_local;
                        best_first_text_local := first_text_local;
                    end;
                end;
            end;
            if best_first_text_local = '' then
            begin
                Exit;
            end;

            if not try_build_remainder_exact_chain_local(remainder_text,
                remainder_path, remainder_weight) then
            begin
                Exit;
            end;

            if (input_syllable_count <= 4) and (remainder_segment_count <> 1) then
            begin
                Exit;
            end;

            out_candidate.text := best_first_text_local + remainder_text;
            out_candidate.comment := '';
            out_candidate.score := c_complete_bonus + best_first_weight_local +
                remainder_weight;
            out_candidate.source := cs_rule;
            out_candidate.has_dict_weight := True;
            out_candidate.dict_weight := out_candidate.score;
            out_encoded_path := best_first_text_local +
                c_segment_path_separator + remainder_path;
            Result := True;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        if (m_dictionary = nil) or (not has_multi_syllable_input) or
            (input_syllable_count < 4) or (input_syllable_count > 6) or
            (not is_full_pinyin_key(lookup_text)) or all_initial_compact_query or
            has_internal_dangling_initial then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        SetLength(remainder_memo_state, Length(syllables_local) + 1);
        SetLength(remainder_memo_text, Length(syllables_local) + 1);
        SetLength(remainder_memo_path, Length(syllables_local) + 1);
        SetLength(remainder_memo_weight, Length(syllables_local) + 1);
        SetLength(remainder_memo_segments, Length(syllables_local) + 1);
        SetLength(remainder_memo_first_units, Length(syllables_local) + 1);

        first_key := normalize_pinyin_text(syllables_local[0].text);
        remainder_key := '';
        for syllable_idx := 1 to High(syllables_local) do
        begin
            remainder_key := remainder_key + normalize_pinyin_text(
                syllables_local[syllable_idx].text);
        end;
        has_function_head_candidate :=
            try_build_function_head_remainder_candidate_local;
        if has_function_head_candidate then
        begin
            // Keep the one-character function-head path as a fallback. A
            // longer exact head may still produce a better complete path.
            function_head_candidate := out_candidate;
            function_head_path := out_encoded_path;
        end;

        if input_syllable_count <= 4 then
        begin
            Exit(restore_function_head_candidate_local);
        end;

        head_key := normalize_pinyin_text(syllables_local[0].text) +
            normalize_pinyin_text(syllables_local[1].text);
        third_key := normalize_pinyin_text(syllables_local[2].text);
        tail_key := '';
        for syllable_idx := 3 to High(syllables_local) do
        begin
            tail_key := tail_key + normalize_pinyin_text(syllables_local[syllable_idx].text);
        end;
        tail_units := input_syllable_count - 3;
        if has_exact_combined_tail_phrase_local then
        begin
            Exit(restore_function_head_candidate_local);
        end;
        if (head_key = '') or (third_key = '') or (tail_key = '') or
            (not dictionary_exact_lookup_cached(head_key, head_results)) or
            (not dictionary_exact_lookup_cached(third_key, third_results)) or
            (not dictionary_exact_lookup_cached(tail_key, tail_results)) then
        begin
            Exit(restore_function_head_candidate_local);
        end;

        best_head_text := '';
        best_head_weight := Low(Integer);
        for result_idx := 0 to High(head_results) do
        begin
            if Trim(head_results[result_idx].comment) <> '' then
            begin
                Continue;
            end;
            head_text := Trim(head_results[result_idx].text);
            if (head_text = '') or
                (get_candidate_text_unit_count(head_text) <> 2) then
            begin
                Continue;
            end;
            head_weight := get_candidate_weight_local(head_results[result_idx]);
            if head_weight > best_head_weight then
            begin
                best_head_weight := head_weight;
                best_head_text := head_text;
            end;
        end;
        if (best_head_text = '') or (best_head_weight < c_head_min_weight) then
        begin
            Exit(restore_function_head_candidate_local);
        end;

        best_third_text := '';
        best_third_weight := Low(Integer);
        for result_idx := 0 to High(third_results) do
        begin
            if result_idx >= c_tail_probe_limit then
            begin
                Break;
            end;
            if Trim(third_results[result_idx].comment) <> '' then
            begin
                Continue;
            end;
            third_text := Trim(third_results[result_idx].text);
            if (third_text = '') or
                (get_candidate_text_unit_count(third_text) <> 1) or
                (not match_single_char_candidate_for_syllable(third_key, third_text,
                is_preferred_tail)) then
            begin
                Continue;
            end;
            third_weight := get_candidate_weight_local(third_results[result_idx]);
            if is_preferred_tail then
            begin
                Inc(third_weight, c_preferred_tail_bonus);
            end;
            if third_weight > best_third_weight then
            begin
                best_third_weight := third_weight;
                best_third_text := third_text;
            end;
        end;
        if best_third_text = '' then
        begin
            Exit(restore_function_head_candidate_local);
        end;
        if is_nonbase_two_plus_single_head_local(best_head_text,
            best_third_text) then
        begin
            Exit(restore_function_head_candidate_local);
        end;

        best_tail_text := '';
        best_tail_weight := Low(Integer);
        for result_idx := 0 to High(tail_results) do
        begin
            if result_idx >= c_tail_probe_limit then
            begin
                Break;
            end;
            if Trim(tail_results[result_idx].comment) <> '' then
            begin
                Continue;
            end;
            tail_text := Trim(tail_results[result_idx].text);
            if (tail_text = '') or
                (get_candidate_text_unit_count(tail_text) <> tail_units) then
            begin
                Continue;
            end;
            tail_weight := get_candidate_weight_local(tail_results[result_idx]);
            if tail_weight > best_tail_weight then
            begin
                best_tail_weight := tail_weight;
                best_tail_text := tail_text;
            end;
        end;
        if (best_tail_text = '') or (best_tail_weight < c_tail_min_weight) then
        begin
            Exit(restore_function_head_candidate_local);
        end;

        out_candidate.text := best_head_text + best_third_text + best_tail_text;
        out_candidate.comment := '';
        out_candidate.score := c_complete_bonus + best_head_weight +
            best_third_weight + best_tail_weight;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := True;
        out_candidate.dict_weight := out_candidate.score;
        out_encoded_path := best_head_text + c_segment_path_separator +
            best_third_text + c_segment_path_separator + best_tail_text;
        if has_function_head_candidate and
            (function_head_candidate.score > out_candidate.score) then
        begin
            out_candidate := function_head_candidate;
            out_encoded_path := function_head_path;
        end;
        remember_segment_path_for_candidate(out_candidate.text, '',
            out_encoded_path, out_candidate.score);
        Result := True;
    end;

    function try_build_five_syllable_strong_exact_partition_candidate_local(
        out out_candidate: TncCandidate;
        out out_encoded_path: string;
        out out_alternative: TncCandidate): Boolean;
    const
        c_segment_probe_limit = 8;
        c_min_pair_lm_weight = 420;
        c_pair_bonus_cap = 1560;
        c_complete_bonus = 300000;
        c_pair_scale = 8;
    var
        syllables_local: TncPinyinParseResult;
        best_score_local: Int64;

        function build_key_local(const start_idx_local,
            count_local: Integer): string;
        var
            idx_local: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(syllables_local)) then
            begin
                Exit;
            end;
            for idx_local := start_idx_local to
                start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[idx_local].text);
            end;
        end;

        function collect_exact_segments_local(const start_idx_local,
            count_local: Integer; out values_local: TncCandidateList): Boolean;
        var
            key_local: string;
            raw_local: TncCandidateList;
            idx_local: Integer;
            text_local: string;
        begin
            SetLength(values_local, 0);
            key_local := build_key_local(start_idx_local, count_local);
            if (key_local = '') or
                (not dictionary_exact_lookup_cached(key_local, raw_local)) then
            begin
                Exit(False);
            end;
            for idx_local := 0 to High(raw_local) do
            begin
                if Length(values_local) >= c_segment_probe_limit then
                begin
                    Break;
                end;
                if Trim(raw_local[idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                text_local := Trim(raw_local[idx_local].text);
                if (text_local = '') or
                    (get_candidate_text_unit_count(text_local) <> count_local) then
                begin
                    Continue;
                end;
                SetLength(values_local, Length(values_local) + 1);
                values_local[High(values_local)] := raw_local[idx_local];
            end;
            Result := Length(values_local) > 0;
        end;

        function segment_weight_local(const value_local: TncCandidate): Integer;
        begin
            Result := value_local.score;
            if value_local.has_dict_weight and
                (value_local.dict_weight > Result) then
            begin
                Result := value_local.dict_weight;
            end;
            Result := Min(Result, 4096);
        end;

        function pair_bonus_local(const evidence_local: TncPairPathEvidenceList;
            const encoded_path_local: string): Integer;
        var
            evidence_idx_local: Integer;
            lm_weight_local: Integer;
        begin
            Result := 0;
            for evidence_idx_local := 0 to High(evidence_local) do
            begin
                if not SameText(Trim(evidence_local[evidence_idx_local].encoded_path),
                    encoded_path_local) then
                begin
                    Continue;
                end;
                lm_weight_local := evidence_local[evidence_idx_local].lm_transition_weight;
                if lm_weight_local < c_min_pair_lm_weight then
                begin
                    Exit(0);
                end;
                Exit(Min(c_pair_bonus_cap, lm_weight_local * 3));
            end;
        end;

        procedure compare_complete_pair_paths_local;
        const
            c_min_pair_weight = 390;
            c_min_component_weight = 80;
            c_pool_limit = 8;
            c_min_char_margin = 256;
        var
            evidence: TncPairPathEvidenceList;
            parts, texts, paths: TArray<string>;
            weights, scores, context_scores: TArray<Integer>;
            exact_values: TncCandidateList;
            context, key, text, path: string;
            head_units, tail_units, idx, part_idx, found_idx, pool_idx,
                candidate_idx, insert_idx, best_idx, second_score: Integer;
            valid: Boolean;

            function exact_component(const key_value, text_value: string): Boolean;
            var values: TncCandidateList; value: TncCandidate;
            begin
                Result := False;
                if not dictionary_exact_lookup_cached(key_value, values) then Exit;
                for value in values do
                    if (value.text = text_value) and (Trim(value.comment) = '') and
                        (value.source <> cs_user) and
                        (segment_weight_local(value) >= c_min_component_weight) and
                        m_dictionary.is_base_entry(key_value, text_value) then
                        Exit(True);
            end;
        begin
            if is_fuzzy_pinyin_active or has_explicit_apostrophe_input or
                (m_config.pinyin_input_scheme <> pis_full_pinyin) then Exit;
            // This shortcut used to return after only 2+2+1 / 1+2+2 / 2+1+2.
            // Compare attested 2+3 / 3+2 paths before discarding those boundaries.
            if dictionary_exact_lookup_cached(lookup_text, exact_values) then
                for candidate_idx := 0 to High(exact_values) do
                    if (Trim(exact_values[candidate_idx].comment) = '') and
                        (get_candidate_text_unit_count(exact_values[candidate_idx].text) = 5) then Exit;
            if not m_dictionary.get_exact_pair_path_evidence(lookup_text,
                evidence) then Exit;
            texts := TArray<string>.Create(out_candidate.text);
            paths := TArray<string>.Create(out_encoded_path);
            weights := TArray<Integer>.Create(MaxInt);
            for idx := 0 to High(evidence) do
            begin
                if evidence[idx].lm_transition_weight < c_min_pair_weight then Continue;
                path := Trim(evidence[idx].encoded_path);
                parts := path.Split([c_segment_path_separator]);
                if Length(parts) <> 2 then Continue;
                head_units := get_candidate_text_unit_count(parts[0]);
                tail_units := get_candidate_text_unit_count(parts[1]);
                if not (((head_units = 2) and (tail_units = 3)) or
                    ((head_units = 3) and (tail_units = 2))) then Continue;
                valid := True;
                for part_idx := 0 to 1 do
                begin
                    if part_idx = 0 then key := build_key_local(0, head_units)
                    else key := build_key_local(head_units, tail_units);
                    if not exact_component(key, parts[part_idx]) then
                    begin
                        valid := False;
                        Break;
                    end;
                end;
                if not valid then Continue;
                text := parts[0] + parts[1];
                found_idx := -1;
                for pool_idx := 0 to High(texts) do
                    if texts[pool_idx] = text then found_idx := pool_idx;
                if found_idx >= 0 then Continue;
                insert_idx := Length(texts);
                while (insert_idx > 1) and
                    (weights[insert_idx - 1] < evidence[idx].lm_transition_weight) do Dec(insert_idx);
                if insert_idx >= c_pool_limit then Continue;
                SetLength(texts, Min(c_pool_limit, Length(texts) + 1));
                SetLength(paths, Length(texts));
                SetLength(weights, Length(texts));
                for pool_idx := High(texts) downto insert_idx + 1 do
                begin
                    texts[pool_idx] := texts[pool_idx - 1];
                    paths[pool_idx] := paths[pool_idx - 1];
                    weights[pool_idx] := weights[pool_idx - 1];
                end;
                texts[insert_idx] := text;
                paths[insert_idx] := path;
                weights[insert_idx] := evidence[idx].lm_transition_weight;
            end;
            if (Length(texts) < 2) or
                (not m_dictionary.get_char_lm_continuation_scores('', texts, scores)) or
                (Length(scores) <> Length(texts)) then Exit;
            best_idx := 0;
            for idx := 1 to High(scores) do
                if scores[idx] > scores[best_idx] then best_idx := idx;
            if best_idx = 0 then Exit;
            second_score := Low(Integer);
            for idx := 0 to High(scores) do
                if idx <> best_idx then second_score := Max(second_score, scores[idx]);
            if Int64(scores[best_idx]) - second_score < c_min_char_margin then Exit;
            context := Trim(m_segment_left_context);
            if context = '' then context := Trim(m_external_left_context);
            if context = '' then context := Trim(m_left_context);
            context := context_model_tail(context);
            if context <> '' then
            begin
                if (not m_dictionary.get_char_lm_continuation_scores(context,
                    texts, context_scores)) or (Length(context_scores) <> Length(texts)) then Exit;
                for idx := 0 to High(context_scores) do
                    if (idx <> best_idx) and
                        (context_scores[best_idx] <= context_scores[idx]) then Exit;
            end;
            out_alternative := out_candidate;
            remember_segment_path_for_candidate(out_alternative.text, '',
                out_encoded_path, out_alternative.score);
            out_candidate.text := texts[best_idx];
            out_candidate.score := Min(Int64(MaxInt) - 128, out_candidate.score) + 128;
            out_candidate.dict_weight := out_candidate.score;
            out_encoded_path := paths[best_idx];
            m_lookup_query_latest_text_cache.AddOrSetValue(
                'S5PW' + #1 + lookup_text, out_candidate.text);
            if m_config.debug_mode then
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' strongexact5pair=' + out_candidate.text;
        end;

        procedure consider_partition_local(const first_units_local,
            second_units_local, third_units_local: Integer);
        var
            first_values_local: TncCandidateList;
            second_values_local: TncCandidateList;
            third_values_local: TncCandidateList;
            first_idx_local: Integer;
            second_idx_local: Integer;
            third_idx_local: Integer;
            first_text_local: string;
            second_text_local: string;
            third_text_local: string;
            first_pair_key_local: string;
            second_pair_key_local: string;
            first_pair_evidence_local: TncPairPathEvidenceList;
            second_pair_evidence_local: TncPairPathEvidenceList;
            pair_first_local: Integer;
            pair_second_local: Integer;
            score_local: Int64;
        begin
            if (first_units_local + second_units_local +
                third_units_local <> 5) or
                (not collect_exact_segments_local(0, first_units_local,
                first_values_local)) or
                (not collect_exact_segments_local(first_units_local,
                second_units_local, second_values_local)) or
                (not collect_exact_segments_local(first_units_local +
                second_units_local, third_units_local, third_values_local)) then
            begin
                Exit;
            end;
            first_pair_key_local := build_key_local(0,
                first_units_local + second_units_local);
            second_pair_key_local := build_key_local(first_units_local,
                second_units_local + third_units_local);
            if (not m_dictionary.get_exact_pair_path_evidence(
                first_pair_key_local, first_pair_evidence_local)) or
                (not m_dictionary.get_exact_pair_path_evidence(
                second_pair_key_local, second_pair_evidence_local)) then
            begin
                Exit;
            end;

            for first_idx_local := 0 to High(first_values_local) do
            begin
                first_text_local := Trim(first_values_local[first_idx_local].text);
                for second_idx_local := 0 to High(second_values_local) do
                begin
                    second_text_local := Trim(
                        second_values_local[second_idx_local].text);
                    pair_first_local := pair_bonus_local(
                        first_pair_evidence_local, first_text_local +
                        c_segment_path_separator + second_text_local);
                    if pair_first_local <= 0 then
                    begin
                        Continue;
                    end;
                    for third_idx_local := 0 to High(third_values_local) do
                    begin
                        third_text_local := Trim(
                            third_values_local[third_idx_local].text);
                        pair_second_local := pair_bonus_local(
                            second_pair_evidence_local, second_text_local +
                            c_segment_path_separator + third_text_local);
                        if pair_second_local <= 0 then
                        begin
                            Continue;
                        end;
                        score_local := c_complete_bonus +
                            segment_weight_local(
                            first_values_local[first_idx_local]) +
                            segment_weight_local(
                            second_values_local[second_idx_local]) +
                            segment_weight_local(
                            third_values_local[third_idx_local]) +
                            (Int64(pair_first_local + pair_second_local) *
                            c_pair_scale);
                        if score_local <= best_score_local then
                        begin
                            Continue;
                        end;
                        best_score_local := score_local;
                        FillChar(out_candidate, SizeOf(out_candidate), 0);
                        out_candidate.text := first_text_local +
                            second_text_local + third_text_local;
                        out_candidate.comment := '';
                        out_candidate.score := Integer(Min(Int64(MaxInt),
                            score_local));
                        out_candidate.source := cs_rule;
                        out_candidate.display_kind := cdk_lm_compound;
                        out_candidate.has_dict_weight := True;
                        out_candidate.dict_weight := out_candidate.score;
                        out_encoded_path := first_text_local +
                            c_segment_path_separator + second_text_local +
                            c_segment_path_separator + third_text_local;
                    end;
                end;
            end;
        end;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        out_encoded_path := '';
        out_alternative := Default(TncCandidate);
        if (m_dictionary = nil) or (input_syllable_count <> 5) or
            all_initial_compact_query or has_internal_dangling_initial or
            (not is_full_pinyin_key(lookup_text)) or
            has_strong_exact_complete_lookup_weight_local(512) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <> 5 then
        begin
            Exit;
        end;
        best_score_local := Low(Int64);
        consider_partition_local(2, 2, 1);
        consider_partition_local(1, 2, 2);
        consider_partition_local(2, 1, 2);
        Result := (out_encoded_path <> '') and
            (Trim(out_candidate.text) <> '');
        if Result then
        begin
            compare_complete_pair_paths_local;
            remember_segment_path_for_candidate(out_candidate.text, '',
                out_encoded_path, out_candidate.score);
        end;
    end;

    function dictionary_prefix_lookup_cached(const pinyin_key: string;
        out out_results: TncCandidateList): Boolean;
    var
        cache_key: string;
        phase_start_tick: UInt64;
    begin
        SetLength(out_results, 0);
        if (m_dictionary = nil) or (pinyin_key = '') then
        begin
            Exit(False);
        end;

        cache_key := '#prefix#' + pinyin_key;
        if lookup_cache.TryGetValue(cache_key, out_results) then
        begin
            Inc(lookup_cache_hits);
            Exit(Length(out_results) > 0);
        end;

        Inc(lookup_cache_misses);
        if m_config.debug_mode and
            (Length(m_last_full_path_debug_info) < 768) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                ' pmiss=' + pinyin_key;
        end;
        phase_start_tick := GetTickCount64;
        if not m_dictionary.lookup_full_pinyin_prefix(pinyin_key, out_results) then
        begin
            SetLength(out_results, 0);
        end;
        Inc(lookup_elapsed_ms, Int64(GetTickCount64 - phase_start_tick));
        lookup_cache.AddOrSetValue(cache_key, out_results);
        Result := Length(out_results) > 0;
    end;

