            note_finalize_debug_elapsed_local('s2partial', phase_start_tick);
            phase_start_tick := GetTickCount64;
            filter_non_bmp_single_char_candidates(m_candidates);
            filter_user_completes_misaligned_with_relaxed_no_initial_tail_local(
