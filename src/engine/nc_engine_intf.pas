    procedure promote_pathful_complete_over_unbacked_generated_top;
    const
        c_probe_limit = 5;
        c_max_score_deficit = 150000;
        c_min_coverage_gain = 1800;
        c_max_function_unit_diffs = 2;
    var
        idx_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
        top_score_local: Integer;
        top_coverage_local: Integer;
        candidate_coverage_local: Integer;
        top_path_local: string;
        candidate_path_local: string;
        candidate_segments_local: Integer;
        top_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        candidate_function_diff_local: Boolean;

        function is_common_function_confusion_pair_local(const left_value: string;
            const right_value: string): Boolean;
        begin
            if SameText(left_value, right_value) then
            begin
                Exit(True);
            end;

            Result :=
                (((left_value = string(Char($7684))) or
                (left_value = string(Char($5730))) or
                (left_value = string(Char($5F97)))) and
                ((right_value = string(Char($7684))) or
                (right_value = string(Char($5730))) or
                (right_value = string(Char($5F97))))) or
                (((left_value = string(Char($4ED6))) or
                (left_value = string(Char($5979))) or
                (left_value = string(Char($5B83)))) and
                ((right_value = string(Char($4ED6))) or
                (right_value = string(Char($5979))) or
                (right_value = string(Char($5B83))))) or
                (((left_value = string(Char($4E00))) or
                (left_value = string(Char($4EE5))) or
                (left_value = string(Char($5DF2)))) and
                ((right_value = string(Char($4E00))) or
                (right_value = string(Char($4EE5))) or
                (right_value = string(Char($5DF2))))) or
                (((left_value = string(Char($5728))) or
                (left_value = string(Char($518D)))) and
                ((right_value = string(Char($5728))) or
                (right_value = string(Char($518D))))) or
                (((left_value = string(Char($662F))) or
                (left_value = string(Char($65F6)))) and
                ((right_value = string(Char($662F))) or
                (right_value = string(Char($65F6)))));
        end;

        function differs_only_in_common_function_units_local(
            const left_units: TArray<string>;
            const right_units: TArray<string>): Boolean;
        var
            unit_idx_local: Integer;
            diff_count_local: Integer;
        begin
            Result := False;
            if (Length(left_units) <> expected_units) or
                (Length(right_units) <> expected_units) then
            begin
                Exit;
            end;

            diff_count_local := 0;
            for unit_idx_local := 0 to expected_units - 1 do
            begin
                if SameText(left_units[unit_idx_local],
                    right_units[unit_idx_local]) then
                begin
                    Continue;
                end;

                if not is_common_function_confusion_pair_local(
                    left_units[unit_idx_local], right_units[unit_idx_local]) then
                begin
                    Exit;
                end;

                Inc(diff_count_local);
                if diff_count_local > c_max_function_unit_diffs then
                begin
                    Exit;
                end;
            end;

            Result := diff_count_local > 0;
        end;
    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 6) or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_path_local := get_display_candidate_path_for_index(m_candidates[0], 0);
        if get_encoded_path_segment_count_local(top_path_local) > 1 then
        begin
            Exit;
        end;
        if (normalized_pinyin <> '') and
            display_exact_key_has_text(normalized_pinyin, Trim(m_candidates[0].text)) then
        begin
            Exit;
        end;

        top_score_local := m_candidates[0].score;
        top_coverage_local :=
            get_display_complete_exact_span_coverage_score(m_candidates[0]);
        top_units_local := split_text_units(Trim(m_candidates[0].text));
        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx_local := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx_local].text)) <>
                expected_units) or
                (m_candidates[idx_local].score + c_max_score_deficit <
                top_score_local) then
            begin
                Continue;
            end;

            candidate_path_local := get_display_candidate_path_for_index(
                m_candidates[idx_local], idx_local);
            candidate_segments_local :=
                get_encoded_path_segment_count_local(candidate_path_local);
            candidate_units_local := split_text_units(
                Trim(m_candidates[idx_local].text));
            candidate_function_diff_local :=
                differs_only_in_common_function_units_local(top_units_local,
                candidate_units_local);
            if (candidate_segments_local < 3) and
                (not candidate_function_diff_local) then
            begin
                Continue;
            end;

            candidate_coverage_local :=
                get_display_complete_exact_span_coverage_score(
                m_candidates[idx_local]);
            if (candidate_coverage_local < top_coverage_local +
                c_min_coverage_gain) and
                (not candidate_function_diff_local) then
            begin
                Continue;
            end;

            candidate_rank_local := candidate_coverage_local +
                candidate_segments_local * 320 + m_candidates[idx_local].score div 32;
            if candidate_function_diff_local then
            begin
                Inc(candidate_rank_local, c_min_coverage_gain);
            end;
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' vunbacked=[idx=%d text=%s]',
                    [best_idx_local, Trim(m_candidates[0].text)]);
            end;
        end;
    end;

