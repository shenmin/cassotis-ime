    function display_candidate_has_exact_suffix_phrase_outer(
        const text_value: string; const min_suffix_units: Integer;
        const max_suffix_units: Integer): Boolean;
    var
        units_local: TArray<string>;
        suffix_units_local: Integer;
        start_idx_local: Integer;
        unit_idx_local: Integer;
        suffix_key_local: string;
        suffix_text_local: string;
    begin
        Result := False;
        units_local := split_text_units(Trim(text_value));
        if (Length(units_local) <> expected_units) or (expected_units < 2) then
        begin
            Exit;
        end;

        for suffix_units_local := Max(2, min_suffix_units) to
            Min(Max(2, max_suffix_units), expected_units - 1) do
        begin
            start_idx_local := expected_units - suffix_units_local;
            suffix_key_local := build_display_query_key(start_idx_local,
                suffix_units_local);
            suffix_text_local := '';
            for unit_idx_local := start_idx_local to expected_units - 1 do
            begin
                suffix_text_local := suffix_text_local +
                    Trim(units_local[unit_idx_local]);
            end;

            if (suffix_key_local <> '') and (suffix_text_local <> '') and
                display_exact_key_has_text(suffix_key_local,
                suffix_text_local) then
            begin
                Exit(True);
            end;
        end;
    end;

