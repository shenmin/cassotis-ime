        function score_segment_path_quality_local(
            const candidate_value: TncCandidate;
            const candidate_idx: Integer): Integer;
        var
            path_local: string;
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_text_local: string;
            segment_units_local: Integer;
            segment_start_local: Integer;
            query_key_local: string;
            exact_weight_local: Integer;
            prev_segment_text_local: string;
            prev_prev_segment_text_local: string;
            context_bonus_local: Integer;
        begin
            Result := 0;
            path_local := get_display_candidate_path_for_index(candidate_value,
                candidate_idx);
            if Trim(path_local) = '' then
            begin
                Exit;
            end;

            path_parts_local := path_local.Split([c_segment_path_separator]);
            segment_start_local := 0;
            prev_segment_text_local := '';
            prev_prev_segment_text_local := '';
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                if segment_text_local = '' then
                begin
                    Continue;
                end;

                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if segment_units_local <= 0 then
                begin
                    Continue;
                end;

                if segment_units_local = 1 then
                begin
                    if is_common_single_path_segment_local(segment_text_local) then
                    begin
                        Inc(Result, 500);
                    end
                    else
                    begin
                        Dec(Result, 900);
                    end;
                end
                else
                begin
                    Inc(Result, segment_units_local * segment_units_local * 1300);
                    query_key_local := build_display_query_key(
                        segment_start_local, segment_units_local);
                    if (query_key_local <> '') and
                        display_exact_key_has_text(query_key_local,
                        segment_text_local) then
                    begin
                        exact_weight_local := 0;
                        get_display_exact_text_weight(query_key_local,
                            segment_text_local, segment_units_local,
                            exact_weight_local);
                        Inc(Result, segment_units_local * 900 +
                            Min(7000, Max(0, exact_weight_local) * 5));
                    end
                    else
                    begin
                        Dec(Result, 9000);
                    end;
                end;

                if (m_dictionary <> nil) and (prev_segment_text_local <> '') then
                begin
                    context_bonus_local := m_dictionary.get_context_bonus(
                        prev_segment_text_local, segment_text_local);
                    if context_bonus_local > 0 then
                    begin
                        Inc(Result, Min(9000, context_bonus_local * 8));
                    end;
                    if prev_prev_segment_text_local <> '' then
                    begin
                        context_bonus_local :=
                            m_dictionary.get_context_trigram_bonus(
                            prev_prev_segment_text_local,
                            prev_segment_text_local, segment_text_local);
                        if context_bonus_local > 0 then
                        begin
                            Inc(Result, Min(12000, context_bonus_local * 10));
                        end;
                    end;
                end;

                Inc(segment_start_local, segment_units_local);
                prev_prev_segment_text_local := prev_segment_text_local;
                prev_segment_text_local := segment_text_local;
            end;

            if segment_start_local <> expected_units then
            begin
                Dec(Result, 24000);
            end;
        end;

        function score_candidate_quality_local(const candidate_value: TncCandidate;
            const candidate_idx: Integer): Integer;
        var
            candidate_units_local: TArray<string>;
        begin
            Result := Low(Integer) div 4;
            if not candidate_is_complete_local(candidate_value) then
            begin
                Exit;
            end;

            candidate_units_local := split_text_units(Trim(candidate_value.text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            Result := score_exact_span_coverage_local(candidate_units_local) +
                score_diff_local_exact_support_local(candidate_units_local) +
                score_context_preference_local(candidate_units_local);
            Dec(Result, candidate_idx * 512);
        end;

        function score_candidate_exact_span_quality_local(
            const candidate_value: TncCandidate): Integer;
        var
            candidate_units_local: TArray<string>;
        begin
            Result := Low(Integer) div 4;
            if not candidate_is_complete_local(candidate_value) then
            begin
                Exit;
            end;

            candidate_units_local := split_text_units(Trim(candidate_value.text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            Result := score_exact_span_coverage_local(candidate_units_local) +
                score_diff_local_exact_support_local(candidate_units_local);
        end;

        function count_exact_span_covered_units_local(
            const candidate_value: TncCandidate): Integer;
        const
            c_max_span_len = 4;
        var
            candidate_units_local: TArray<string>;
            occupied_local: TArray<Boolean>;
            span_len_local: Integer;
            start_idx_local: Integer;
            unit_idx_local: Integer;
            query_key_local: string;
            span_text_local: string;
            occupied_range_local: Boolean;
        begin
            Result := 0;
            if not candidate_is_complete_local(candidate_value) then
            begin
                Exit;
            end;

            candidate_units_local := split_text_units(Trim(candidate_value.text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            SetLength(occupied_local, expected_units);
            for span_len_local := Min(c_max_span_len, expected_units) downto 2 do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    occupied_range_local := False;
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        if occupied_local[unit_idx_local] then
                        begin
                            occupied_range_local := True;
                            Break;
                        end;
                    end;
                    if occupied_range_local then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(start_idx_local,
                        span_len_local);
                    span_text_local := build_units_range_text_local(
                        candidate_units_local, start_idx_local, span_len_local);
                    if (query_key_local = '') or (span_text_local = '') or
                        (not display_exact_key_has_text(query_key_local,
                        span_text_local)) then
                    begin
                        Continue;
                    end;

                    Inc(Result, span_len_local);
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        occupied_local[unit_idx_local] := True;
                    end;
                end;
            end;
        end;

    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 6) or (expected_units > 32) or
            (not candidate_is_complete_local(m_candidates[0])) then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;

        top_quality_local := score_candidate_quality_local(m_candidates[0], 0);
        best_quality_local := top_quality_local;
        best_idx_local := -1;
        promoted_local := False;
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_quality_local :=
                score_candidate_quality_local(m_candidates[idx], idx);
            if candidate_quality_local > best_quality_local then
            begin
                best_quality_local := candidate_quality_local;
                best_idx_local := idx;
            end;
        end;

        if (best_idx_local > 0) and
            (best_quality_local >= top_quality_local + c_min_quality_gain) then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
            promoted_local := True;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' vctxq=[idx=%d gain=%d text=%s]',
                    [best_idx_local, best_quality_local - top_quality_local,
                    Trim(m_candidates[0].text)]);
            end;
        end;

        if (not promoted_local) and (Length(m_candidates) >= 2) and
            candidate_is_complete_local(m_candidates[0]) and
            candidate_is_complete_local(m_candidates[1]) then
        begin
            top_units_local := split_text_units(Trim(m_candidates[0].text));
            if Length(top_units_local) = expected_units then
            begin
                top_exact_quality_local :=
                    score_candidate_exact_span_quality_local(m_candidates[0]);
                top2_exact_quality_local :=
                    score_candidate_exact_span_quality_local(m_candidates[1]);
                top_exact_covered_units_local :=
                    count_exact_span_covered_units_local(m_candidates[0]);
                top2_exact_covered_units_local :=
                    count_exact_span_covered_units_local(m_candidates[1]);
                top_path_support_local := Max(0,
                    get_segment_path_support_score(m_candidates[0]));
                top2_path_support_local := Max(0,
                    get_segment_path_support_score(m_candidates[1]));
                top_path_segments_local := get_encoded_path_segment_count_local(
                    get_display_candidate_path_for_index(m_candidates[0], 0));
                top2_path_segments_local := get_encoded_path_segment_count_local(
                    get_display_candidate_path_for_index(m_candidates[1], 1));
                if (top2_exact_covered_units_local >
                    top_exact_covered_units_local) and
                    (top2_exact_quality_local > top_exact_quality_local) and
                    (top_path_support_local <= top2_path_support_local + 1000) and
                    ((top_path_segments_local <= top2_path_segments_local) or
                    (top2_exact_quality_local >= top_exact_quality_local + 12000)) then
                begin
                    force_move_display_candidate_to_index(1, 0);
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' vexact2=[gain=%d path=%d/%d text=%s]',
                            [top2_exact_quality_local -
                            top_exact_quality_local, top_path_support_local,
                            top2_path_support_local, Trim(m_candidates[0].text)]);
                    end;
                end;
            end;
        end;
    end;

