    function display_exact_key_has_any_complete_text(const query_key: string;
        const expected_units_local: Integer): Boolean;
    const
        c_probe_limit = 12;
    var
        exact_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
    begin
        Result := False;
        if (query_key = '') or (expected_units_local <= 0) or
            (not lookup_display_exact_cached(query_key, exact_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(exact_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            candidate_text := Trim(exact_results[idx].text);
            if (Trim(exact_results[idx].comment) = '') and
                (candidate_text <> '') and
                (get_candidate_text_unit_count(candidate_text) =
                expected_units_local) then
            begin
                Exit(True);
            end;
        end;
    end;

    function display_exact_key_has_stronger_complete_text(
        const query_key: string; const current_text: string;
        const expected_units_local: Integer; const min_weight_gap: Integer): Boolean;
    const
        c_probe_limit = 12;
    var
        exact_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
        candidate_weight: Integer;
        current_weight: Integer;
        best_weight: Integer;
    begin
        Result := False;
        current_weight := Low(Integer);
        best_weight := Low(Integer);
        if (query_key = '') or (current_text = '') or
            (expected_units_local <= 0) or
            (not lookup_display_exact_cached(query_key, exact_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(exact_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            candidate_text := Trim(exact_results[idx].text);
            if (Trim(exact_results[idx].comment) <> '') or
                (candidate_text = '') or
                (get_candidate_text_unit_count(candidate_text) <>
                expected_units_local) then
            begin
                Continue;
            end;

            if exact_results[idx].has_dict_weight then
            begin
                candidate_weight := exact_results[idx].dict_weight;
            end
            else
            begin
                candidate_weight := exact_results[idx].score;
            end;
            if candidate_weight > best_weight then
            begin
                best_weight := candidate_weight;
            end;
            if SameText(candidate_text, current_text) and
                (candidate_weight > current_weight) then
            begin
                current_weight := candidate_weight;
            end;
        end;

        Result := (current_weight > Low(Integer)) and
            (best_weight > current_weight + min_weight_gap);
    end;

    function get_display_exact_text_weight(const query_key: string;
        const expected_text: string; const expected_units_local: Integer;
        out out_weight: Integer): Boolean;
    const
        c_probe_limit = 16;
    var
        exact_results: TncCandidateList;
        idx: Integer;
        candidate_text: string;
        candidate_weight: Integer;
    begin
        Result := False;
        out_weight := 0;
        if (query_key = '') or (expected_text = '') or
            (expected_units_local <= 0) or
            (not lookup_display_exact_cached(query_key, exact_results)) then
        begin
            Exit;
        end;

        for idx := 0 to High(exact_results) do
        begin
            if idx >= c_probe_limit then
            begin
                Break;
            end;
            candidate_text := Trim(exact_results[idx].text);
            if (Trim(exact_results[idx].comment) <> '') or
                (candidate_text = '') or
                (not SameText(candidate_text, expected_text)) or
                (get_candidate_text_unit_count(candidate_text) <>
                expected_units_local) then
            begin
                Continue;
            end;

            if exact_results[idx].has_dict_weight then
            begin
                candidate_weight := exact_results[idx].dict_weight;
            end
            else
            begin
                candidate_weight := exact_results[idx].score;
            end;
            if (not Result) or (candidate_weight > out_weight) then
            begin
                out_weight := candidate_weight;
                Result := True;
            end;
        end;
    end;

    function is_display_chinese_number_text(const text_value: string): Boolean;
    var
        units: TArray<string>;
        idx: Integer;
        ch: Char;
    begin
        Result := False;
        units := split_text_units(Trim(text_value));
        if Length(units) = 0 then
        begin
            Exit;
        end;

        for idx := 0 to High(units) do
        begin
            if Length(units[idx]) <> 1 then
            begin
                Exit(False);
            end;
            ch := units[idx][1];
            case Ord(ch) of
                $96F6, $4E00, $4E8C, $4E09, $56DB, $4E94, $516D, $4E03,
                $516B, $4E5D, $5341, $767E, $5343, $4E07, $4EBF,
                $5146, $4E24:
                    ;
            else
                Exit(False);
            end;
        end;
        Result := True;
    end;

    function is_display_repeated_unit_text(const text_value: string): Boolean;
    var
        units: TArray<string>;
        idx: Integer;
    begin
        Result := False;
        units := split_text_units(Trim(text_value));
        if Length(units) < 2 then
        begin
            Exit;
        end;

        for idx := 1 to High(units) do
        begin
            if not SameText(units[idx], units[0]) then
            begin
                Exit(False);
            end;
        end;
        Result := True;
    end;

    function display_candidate_effective_weight(
        const candidate_value: TncCandidate): Integer;
    begin
        Result := candidate_value.score;
        if ((not is_fuzzy_pinyin_active) or
            (candidate_value.fuzzy_cost <= 0)) and
            candidate_value.has_dict_weight and
            (candidate_value.dict_weight > Result) then
        begin
            Result := candidate_value.dict_weight;
        end;
        if candidate_value.source = cs_user then
        begin
            Inc(Result, c_user_score_bonus);
        end;
    end;

    procedure filter_display_constructed_multi_char_partial_candidates;
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_text_local: string;
        candidate_head_local: string;
        candidate_tail_local: string;
        candidate_units_local: Integer;
        single_multi_tail_candidate_count_local: Integer;
        kept_single_multi_tail_candidate_count_local: Integer;
        base_entry_cache_local: TDictionary<string, Boolean>;
        user_entry_cache_local: TDictionary<string, Boolean>;
        partial_filter_tick_local: UInt64;

        procedure note_partial_filter_phase_local(const phase_name: string);
        var
            elapsed_ms_local: UInt64;
        begin
            if not m_config.debug_mode then
            begin
                partial_filter_tick_local := GetTickCount64;
                Exit;
            end;

            elapsed_ms_local := GetTickCount64 - partial_filter_tick_local;
            partial_filter_tick_local := GetTickCount64;
            if elapsed_ms_local = 0 then
            begin
                Exit;
            end;
            if m_last_lookup_debug_extra <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
            end;
            m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                Format('gcf_%s=%d', [phase_name, elapsed_ms_local]);
        end;

        function is_ascii_letter_local(const value: Char): Boolean;
        begin
            Result := ((value >= 'a') and (value <= 'z')) or
                ((value >= 'A') and (value <= 'Z'));
        end;

        function split_trailing_ascii_candidate_local(
            const candidate_text: string; out head: string;
            out tail: string): Boolean;
        var
            idx: Integer;
            tail_len: Integer;
        begin
            Result := False;
            head := '';
            tail := '';
            idx := Length(candidate_text);
            while (idx > 0) and is_ascii_letter_local(candidate_text[idx]) do
            begin
                Dec(idx);
            end;

            if (idx = Length(candidate_text)) or (idx <= 0) then
            begin
                Exit;
            end;

            head := Copy(candidate_text, 1, idx);
            tail_len := Length(candidate_text) - idx;
            tail := Copy(candidate_text, idx + 1, tail_len);
            Result := (head <> '') and (tail <> '');
        end;

        function cached_base_entry_exists_local(const query_key: string;
            const text_value: string): Boolean;
        var
            cache_key_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (query_key = '') or (text_value = '') then
            begin
                Exit;
            end;

            cache_key_local := query_key + #1 + text_value;
            if base_entry_cache_local.TryGetValue(cache_key_local, Result) then
            begin
                Exit;
            end;

            Result := m_dictionary.is_base_entry(query_key, text_value);
            base_entry_cache_local.AddOrSetValue(cache_key_local, Result);
        end;

        function cached_user_entry_exists_local(const query_key: string;
            const text_value: string): Boolean;
        var
            cache_key_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (query_key = '') or (text_value = '') then
            begin
                Exit;
            end;

            cache_key_local := query_key + #1 + text_value;
            if user_entry_cache_local.TryGetValue(cache_key_local, Result) then
            begin
                Exit;
            end;

            Result := m_dictionary.is_user_entry(query_key, text_value);
            user_entry_cache_local.AddOrSetValue(cache_key_local, Result);
        end;

        function has_explicit_head_phrase_entry_local(
            const text_value: string; const unit_count: Integer): Boolean;
        var
            head_key_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (text_value = '') or
                (unit_count < 2) then
            begin
                Exit;
            end;

            head_key_local := build_display_query_key(0, unit_count);
            if head_key_local = '' then
            begin
                Exit;
            end;

            if display_exact_key_has_text(head_key_local, text_value) then
            begin
                Exit(True);
            end;

            if cached_base_entry_exists_local(head_key_local, text_value) then
            begin
                Exit(True);
            end;

            Result := cached_user_entry_exists_local(head_key_local, text_value);
        end;

        function is_unsupported_two_char_quantity_partial_local(
            const text_value: string): Boolean;
        var
            units_local: TArray<string>;
            quantity_unit_local: string;
        begin
            Result := False;
            units_local := split_text_units(Trim(text_value));
            if Length(units_local) <> 2 then
            begin
                Exit;
            end;

            quantity_unit_local := units_local[1];
            if quantity_unit_local = '' then
            begin
                Exit;
            end;

            case Ord(quantity_unit_local[1]) of
                $96F6, $4E00, $4E8C, $4E24, $4FE9, $4E09, $56DB, $4E94,
                $516D, $4E03, $516B, $4E5D, $5341, $767E, $5343, $4E07,
                $4EBF, $5146:
                    Result := True;
            end;
        end;

        function is_number_unit_for_quantity_prefix_local(
            const unit_value: string): Boolean;
        begin
            Result := False;
            if (unit_value = '') or (get_candidate_text_unit_count(unit_value) <> 1) then
            begin
                Exit;
            end;

            case Ord(unit_value[1]) of
                $4E00, $4E8C, $4E24, $4FE9, $4E09, $56DB, $4E94, $516D,
                $4E03, $516B, $4E5D, $5341, $51E0, $534A:
                    Result := True;
            end;
        end;

        function is_classifier_unit_for_quantity_prefix_local(
            const unit_value: string): Boolean;
        begin
            Result := False;
            if (unit_value = '') or (get_candidate_text_unit_count(unit_value) <> 1) then
            begin
                Exit;
            end;

            case Ord(unit_value[1]) of
                $4E2A, $6761, $53EA, $672C, $53F0, $90E8, $6279, $5339,
                $6839, $7247, $9875, $4EF6, $9879, $6B21, $6B65, $8F6E,
                $628A, $526F, $5BF9, $53CC, $74F6, $6876, $76D8, $6247,
                $95E8, $5B57, $884C, $5217, $5C42, $7AE0, $8282, $6BB5,
                $680B, $5E62:
                    Result := True;
            end;
        end;

        function is_non_nominal_tail_key_for_quantity_prefix_local(
            const tail_key_value: string): Boolean;
        var
            normalized_tail_local: string;
        begin
            normalized_tail_local := normalize_pinyin_text(tail_key_value);
            Result := (normalized_tail_local = 'dao') or
                (normalized_tail_local = 'da') or
                (normalized_tail_local = 'd') or
                (normalized_tail_local = 'le') or
                (normalized_tail_local = 'de') or
                (normalized_tail_local = 'guo') or
                (normalized_tail_local = 'zhe') or
                (normalized_tail_local = 'ma') or
                (normalized_tail_local = 'ba') or
                (normalized_tail_local = 'ne') or
                (normalized_tail_local = 'a') or
                (normalized_tail_local = 'ya') or
                (normalized_tail_local = 'la');
        end;

        function is_quantity_prefix_before_non_nominal_tail_local(
            const text_value: string; const tail_key_value: string): Boolean;
        var
            units_local: TArray<string>;
        begin
            Result := False;
            if not is_non_nominal_tail_key_for_quantity_prefix_local(
                tail_key_value) then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(text_value));
            Result := (Length(units_local) = 2) and
                is_number_unit_for_quantity_prefix_local(units_local[0]) and
                is_classifier_unit_for_quantity_prefix_local(units_local[1]);
        end;

        function is_single_prefix_before_multi_syllable_tail_local(
            const head_value: string; const tail_key_value: string): Boolean;
        begin
            Result := (expected_units >= 2) and (Length(tail_key_value) >= 2) and
                (get_candidate_text_unit_count(head_value) = 1);
        end;

        function partial_path_is_single_char_chain_local(
            const candidate_index: Integer; const expected_units: Integer): Boolean;
        var
            path_local: string;
            parts_local: TArray<string>;
            part_idx_local: Integer;
            part_text_local: string;
        begin
            Result := False;
            if (candidate_index < 0) or
                (candidate_index >= Length(m_candidate_segment_paths)) or
                (expected_units < 2) then
            begin
                Exit;
            end;

            path_local := Trim(m_candidate_segment_paths[candidate_index]);
            if path_local = '' then
            begin
                Exit;
            end;

            parts_local := path_local.Split([c_segment_path_separator]);
            if Length(parts_local) <> expected_units then
            begin
                Exit;
            end;

            for part_idx_local := 0 to High(parts_local) do
            begin
                part_text_local := Trim(parts_local[part_idx_local]);
                if get_candidate_text_unit_count(part_text_local) <> 1 then
                begin
                    Exit(False);
                end;
            end;

            Result := True;
        end;

        function complete_path_starts_with_ordinal_single_local(
            const candidate_index: Integer): Boolean;
        var
            path_local: string;
            parts_local: TArray<string>;
            first_part_local: string;
        begin
            Result := False;
            if (candidate_index < 0) or
                (candidate_index >= Length(m_candidate_segment_paths)) then
            begin
                Exit;
            end;

            path_local := Trim(m_candidate_segment_paths[candidate_index]);
            if path_local = '' then
            begin
                Exit;
            end;

            parts_local := path_local.Split([c_segment_path_separator]);
            if Length(parts_local) <= 1 then
            begin
                Exit;
            end;

            first_part_local := Trim(parts_local[0]);
            Result := (get_candidate_text_unit_count(first_part_local) = 1) and
                (Length(first_part_local) > 0) and (Ord(first_part_local[1]) = $7B2C);
        end;

    begin
        if Length(m_candidates) = 0 then
        begin
            Exit;
        end;

        base_entry_cache_local := TDictionary<string, Boolean>.Create;
        user_entry_cache_local := TDictionary<string, Boolean>.Create;
        try
            partial_filter_tick_local := GetTickCount64;
            single_multi_tail_candidate_count_local := 0;
            for in_idx_local := 0 to High(m_candidates) do
            begin
                candidate_text_local := Trim(m_candidates[in_idx_local].text);
                candidate_head_local := candidate_text_local;
                candidate_tail_local := Trim(m_candidates[in_idx_local].comment);
                if (candidate_tail_local = '') and
                    split_trailing_ascii_candidate_local(candidate_text_local,
                    candidate_head_local, candidate_tail_local) then
                begin
                    candidate_head_local := Trim(candidate_head_local);
                    candidate_tail_local := Trim(candidate_tail_local);
                end;
                if is_single_prefix_before_multi_syllable_tail_local(
                    candidate_head_local, candidate_tail_local) then
                begin
                    Inc(single_multi_tail_candidate_count_local);
                end;
            end;
            note_partial_filter_phase_local('count');

            out_idx_local := 0;
            kept_single_multi_tail_candidate_count_local := 0;
            for in_idx_local := 0 to High(m_candidates) do
            begin
                candidate_text_local := Trim(m_candidates[in_idx_local].text);
                candidate_head_local := candidate_text_local;
                candidate_tail_local := Trim(m_candidates[in_idx_local].comment);
                if (candidate_tail_local = '') and
                    split_trailing_ascii_candidate_local(candidate_text_local,
                    candidate_head_local, candidate_tail_local) then
                begin
                    candidate_head_local := Trim(candidate_head_local);
                    candidate_tail_local := Trim(candidate_tail_local);
                end;

                candidate_units_local := get_candidate_text_unit_count(
                    candidate_head_local);
                if is_single_prefix_before_multi_syllable_tail_local(
                    candidate_head_local, candidate_tail_local) then
                begin
                    Inc(kept_single_multi_tail_candidate_count_local);
                    if (single_multi_tail_candidate_count_local >
                        c_candidate_total_limit_max) and
                        (kept_single_multi_tail_candidate_count_local >
                        c_candidate_total_limit_max) then
                    begin
                        Continue;
                    end;
                end;

                if (candidate_tail_local <> '') and
                    is_quantity_prefix_before_non_nominal_tail_local(
                    candidate_head_local, candidate_tail_local) then
                begin
                    Continue;
                end;

                if (candidate_tail_local <> '') and
                    (not has_explicit_head_phrase_entry_local(candidate_head_local,
                    candidate_units_local)) and
                    (is_unsupported_two_char_quantity_partial_local(
                    candidate_head_local) or
                    partial_path_is_single_char_chain_local(in_idx_local,
                    candidate_units_local)) then
                begin
                    Continue;
                end;

                if (candidate_tail_local = '') and (expected_units <= 3) and
                    complete_path_starts_with_ordinal_single_local(in_idx_local) and
                    (m_dictionary <> nil) and
                    (not cached_base_entry_exists_local(normalized_pinyin,
                    candidate_text_local)) and
                    (not cached_user_entry_exists_local(normalized_pinyin,
                    candidate_text_local)) then
                begin
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    m_candidates[out_idx_local] := m_candidates[in_idx_local];
                    if out_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        if in_idx_local < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[out_idx_local] :=
                                m_candidate_segment_paths[in_idx_local];
                        end
                        else
                        begin
                            m_candidate_segment_paths[out_idx_local] := '';
                        end;
                    end;
                end;
                Inc(out_idx_local);
            end;
            note_partial_filter_phase_local('loop');

            if out_idx_local < Length(m_candidates) then
            begin
                SetLength(m_candidates, out_idx_local);
                if Length(m_candidate_segment_paths) > out_idx_local then
                begin
                    SetLength(m_candidate_segment_paths, out_idx_local);
                end;
            end;
        finally
            user_entry_cache_local.Free;
            base_entry_cache_local.Free;
        end;
    end;

    function apply_short_query_exact_display_ranking: Boolean;
    const
        c_max_base_exact_units = 5;
        c_max_user_exact_units = 6;
        c_low_frequency_medical_exact_weight = 520;
        c_decisive_transition_min_full_lm_lead = 1400;
        c_decisive_transition_min_suffix_lm_lead = 1000;
    type
        TShortExactRankItem = record
            candidate: TncCandidate;
            path: string;
            category: Integer;
            prefix_units: Integer;
            rank_score: Integer;
            original_index: Integer;
            text_length: Integer;
            actual_full_exact: Boolean;
            user_full_exact: Boolean;
            decisive_transition_override: Boolean;
            transition_evidence: Integer;
            low_frequency_medical_exact: Boolean;
            nocontext_exact_priority: Integer;
            context_exact_priority: Integer;
        end;
    var
        exact_results: TncCandidateList;
        fuzzy_exact_results: TncCandidateList;
        predictive_prefix_results: TncCandidateList;
        exact_weights: TDictionary<string, Integer>;
        exact_is_user: TDictionary<string, Boolean>;
        exact_candidates: TDictionary<string, TncCandidate>;
        prefix_candidate_keys: TDictionary<string, Boolean>;
        predictive_prefix_texts: TDictionary<string, Boolean>;
        particle_tail_texts: TDictionary<string, Boolean>;
        list: TList<TShortExactRankItem>;
        idx: Integer;
        exact_idx: Integer;
        exact_text: string;
        exact_weight: Integer;
        existing_weight: Integer;
        existing_is_user: Boolean;
        candidate_item: TncCandidate;
        closed_particle_candidate: TncCandidate;
        item: TShortExactRankItem;
        path_value: string;
        has_user_exact: Boolean;
        has_closed_particle_candidate: Boolean;
        has_exact_lookup: Boolean;
        has_fuzzy_exact_lookup: Boolean;
        has_predictive_prefix_lookup: Boolean;
        has_particle_tail_lookup: Boolean;
        has_query_prefix_lookup: Boolean;
        predictive_prefix_results_loaded: Boolean;
        pair_evidence_loaded: Boolean;
        pair_evidence_results: TncPairPathEvidenceList;
        max_base_exact_competing_weight: Integer;
        max_base_exact_competing_text: string;
        short_exact_phase_start: UInt64;

        procedure note_short_exact_phase_local(const phase_name: string);
        var
            elapsed_ms: UInt64;
        begin
            if not m_config.debug_mode then
            begin
                Exit;
            end;

            elapsed_ms := GetTickCount64 - short_exact_phase_start;
            if m_last_lookup_debug_extra <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
            end;
            m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                Format('se_%s=%d', [phase_name, elapsed_ms]);
            short_exact_phase_start := GetTickCount64;
        end;

        function text_has_low_frequency_medical_unit_local(
            const text_value: string): Boolean;
        var
            char_idx_local: Integer;
        begin
            Result := False;
            for char_idx_local := 1 to Length(text_value) do
            begin
                case Ord(text_value[char_idx_local]) of
                    $6C28, // 氨
                    $708E, // 炎
                    $75C9, // 痉
                    $7624, // 瘤
                    $764C, // 癌
                    $80BC, // 肼
                    $80FA, // 胺
                    $8148, // 腈
                    $817A, // 腺
                    $82C4, // 苄
                    $916E, // 酮
                    $916F, // 酯
                    $9176, // 酶
                    $9187, // 醇
                    $919B, // 醛
                    $94F5: // 铵
                        Exit(True);
                end;
            end;
        end;

        function query_choice_rank_bonus_local(const text_value: string): Integer;
        var
            query_bonus_local: Integer;
            context_bonus_local: Integer;
            latest_text_local: string;
        begin
            Result := 0;
            if text_value = '' then
            begin
                Exit;
            end;
            if not is_full_pinyin_key(normalized_pinyin) then
            begin
                Exit;
            end;

            if ((m_session_query_latest_text <> nil) and
                m_session_query_latest_text.TryGetValue(normalized_pinyin,
                latest_text_local) and SameText(Trim(latest_text_local),
                text_value)) or is_latest_session_query_choice(text_value) then
            begin
                Inc(Result, 200000000);
            end;

            context_bonus_local := get_context_query_latest_bonus(text_value);
            if context_bonus_local > 0 then
            begin
                Inc(Result, 100000000 + (context_bonus_local * 1000));
            end;

            if m_dictionary <> nil then
            begin
                query_bonus_local := m_dictionary.get_query_choice_bonus(
                    normalized_pinyin, text_value);
                if query_bonus_local > 0 then
                begin
                    Inc(Result, 50000000 + (query_bonus_local * 1000));
                end;
            end;
        end;

        function has_effective_short_context_local: Boolean;
        begin
            Result := (Trim(m_segment_left_context) <> '') or
                (Trim(m_external_left_context) <> '') or
                (Trim(m_left_context) <> '');
        end;

        function transition_path_has_supported_function_head_local(
            const encoded_path: string): Boolean;
        var
            parts_local: TArray<string>;
            head_text_local: string;
        begin
            Result := False;
            parts_local := Trim(encoded_path).Split(
                [c_segment_path_separator]);
            if Length(parts_local) <> 2 then
            begin
                Exit;
            end;

            head_text_local := Trim(parts_local[0]);
            if get_candidate_text_unit_count(head_text_local) <> 1 then
            begin
                Exit;
            end;
            { Limit exact overrides to productive grammar heads. The broader
              transition candidate remains visible, but nominal fragments such
              as "文+道" or "行+和" cannot displace a real dictionary word. }
            case Ord(head_text_local[1]) of
                $4E0D, $518D, $5728, $9AD8, $5F88, $592A, $6700, $66F4,
                $53C8, $4E5F, $5C06, $53EF, $4F1A, $80FD, $8981,
                $60F3, $6CA1, $65E0, $975E, $672A, $4ECD, $90FD, $8FD8,
                $624D, $5C31, $53EA, $522B, $591A, $5C11, $5168, $8D85,
                $771F, $633A, $8F83, $628A, $88AB, $8BA9, $7ED9, $5411,
                $5BF9, $4ECE, $4E8E, $662F,
                $7B2C, $5148, $6211, $4F60, $60A8,
                $8FD9, $90A3, $54EA, // 这、那、哪
                $4ED6, $5979, $5B83, $54B1: // 他、她、它、咱
                    Result := True;
            end;
        end;

        function transition_has_decisive_char_lm_lead_local(
            const transition_text, base_exact_text: string;
            out full_lm_lead, suffix_lm_lead: Integer): Boolean;
        var
            texts_local: TArray<string>;
            full_scores_local: TArray<Integer>;
            suffix_scores_local: TArray<Integer>;
        begin
            Result := False;
            full_lm_lead := 0;
            suffix_lm_lead := 0;
            if has_effective_short_context_local or
                (Trim(transition_text) = '') or
                (Trim(base_exact_text) = '') or (m_dictionary = nil) then
            begin
                Exit;
            end;

            SetLength(texts_local, 2);
            texts_local[0] := Trim(base_exact_text);
            texts_local[1] := Trim(transition_text);
            if (not get_cached_char_lm_scores(texts_local, full_scores_local,
                clsm_full, '')) or (Length(full_scores_local) <> 2) or
                (not get_cached_char_lm_scores(texts_local,
                suffix_scores_local, clsm_suffix, '')) or
                (Length(suffix_scores_local) <> 2) then
            begin
                Exit;
            end;

            full_lm_lead := full_scores_local[1] - full_scores_local[0];
            suffix_lm_lead := suffix_scores_local[1] - suffix_scores_local[0];
            Result := (full_lm_lead >=
                c_decisive_transition_min_full_lm_lead) and
                (suffix_lm_lead >=
                c_decisive_transition_min_suffix_lm_lead);
        end;

        function get_supported_pair_evidence_local(const text_value: string;
            out encoded_path: string): Integer;
        var
            evidence_idx_local: Integer;
            parts_local: TArray<string>;
            candidate_text_local: string;
            raw_evidence_local: Integer;
        begin
            Result := 0;
            encoded_path := '';
            if (text_value = '') or
                ((not is_current_short_two_single_pair_candidate_supported(
                normalized_pinyin, text_value)) and
                (not is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, text_value))) then
            begin
                Exit;
            end;

            if SameText(normalized_pinyin, m_short_three_exact_pair_query) and
                (m_short_three_char_pair_evidence > 0) then
            begin
                parts_local := m_short_three_char_pair_path.Split(
                    [c_segment_path_separator]);
                if (Length(parts_local) = 2) and
                    SameText(parts_local[0] + parts_local[1], text_value) then
                begin
                    encoded_path := m_short_three_char_pair_path;
                    Exit(m_short_three_char_pair_evidence);
                end;
            end;

            if not pair_evidence_loaded then
            begin
                pair_evidence_loaded := True;
                SetLength(pair_evidence_results, 0);
                m_dictionary.get_exact_pair_path_evidence(normalized_pinyin,
                    pair_evidence_results);
            end;

            for evidence_idx_local := 0 to High(pair_evidence_results) do
            begin
                parts_local := Trim(pair_evidence_results[
                    evidence_idx_local].encoded_path).Split(
                    [c_segment_path_separator]);
                if Length(parts_local) <> 2 then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(parts_local[0]) +
                    Trim(parts_local[1]);
                if not SameText(candidate_text_local, text_value) then
                begin
                    Continue;
                end;

                raw_evidence_local := Max(pair_evidence_results[
                    evidence_idx_local].lm_transition_weight,
                    pair_evidence_results[
                    evidence_idx_local].query_path_weight);
                if raw_evidence_local > Result then
                begin
                    Result := raw_evidence_local;
                    encoded_path := Trim(pair_evidence_results[
                        evidence_idx_local].encoded_path);
                end;
            end;
        end;

        function short_base_exact_dynamic_weight_local(
            const text_value: string): Integer;
        begin
            Result := get_base_exact_choice_weight_bonus(normalized_pinyin,
                text_value);
        end;

        function short_exact_effective_weight_local(
            const candidate_value: TncCandidate): Integer;
        begin
            Result := display_candidate_effective_weight(candidate_value);
            Inc(Result, query_choice_rank_bonus_local(Trim(candidate_value.text)));
        end;

        function ensure_predictive_prefix_results_local: Boolean;
        begin
            if not predictive_prefix_results_loaded then
            begin
                predictive_prefix_results_loaded := True;
                if SameText(normalized_pinyin,
                    m_short_exact_lexicon_completion_query) then
                    predictive_prefix_results :=
                        Copy(m_short_exact_lexicon_completion_candidates)
                else if (m_dictionary = nil) or
                    (not m_dictionary.lookup_full_pinyin_prefix(normalized_pinyin,
                    predictive_prefix_results)) then
                begin
                    SetLength(predictive_prefix_results, 0);
                end;
            end;

            Result := Length(predictive_prefix_results) > 0;
        end;

        function short_base_exact_choice_rank_bonus_local(
            const text_value: string; const exact_weight_value: Integer;
            const text_units_value: Integer): Integer;
        const
            c_multi_base_choice_bonus_cap = 240;
            c_multi_base_choice_bonus_floor = 48;
            c_rare_exact_phrase_weight = 300;
            c_rare_unit_weight = 80;
            c_multi_base_strong_choice_min = 520;
        var
            raw_bonus_local: Integer;
            capped_bonus_local: Integer;
            latest_text_local: string;

            function has_rare_low_weight_unit_local: Boolean;
            var
                units_local: TArray<string>;
                unit_idx_local: Integer;
                unit_key_local: string;
                unit_weight_local: Integer;
                unit_results_local: TncCandidateList;
                unit_result_idx_local: Integer;
                unit_candidate_text_local: string;
            begin
                Result := False;
                if (m_dictionary = nil) or
                    (exact_weight_value >= c_rare_exact_phrase_weight) then
                begin
                    Exit;
                end;

                units_local := split_text_units(text_value);
                if Length(units_local) <> text_units_value then
                begin
                    Exit;
                end;

                for unit_idx_local := 0 to High(units_local) do
                begin
                    unit_key_local := build_display_query_key(unit_idx_local, 1);
                    if (unit_key_local = '') or
                        (not lookup_display_exact_cached(unit_key_local,
                        unit_results_local)) then
                    begin
                        Continue;
                    end;

                    unit_weight_local := 0;
                    for unit_result_idx_local := 0 to High(unit_results_local) do
                    begin
                        unit_candidate_text_local := Trim(
                            unit_results_local[unit_result_idx_local].text);
                        if (Trim(unit_results_local[unit_result_idx_local].comment) <> '') or
                            (not SameText(unit_candidate_text_local,
                            units_local[unit_idx_local])) or
                            (get_candidate_text_unit_count(unit_candidate_text_local) <> 1) then
                        begin
                            Continue;
                        end;

                        if unit_results_local[unit_result_idx_local].has_dict_weight then
                        begin
                            unit_weight_local :=
                                unit_results_local[unit_result_idx_local].dict_weight;
                        end
                        else
                        begin
                            unit_weight_local :=
                                unit_results_local[unit_result_idx_local].score;
                        end;
                        Break;
                    end;

                    if (unit_weight_local > 0) and
                        (unit_weight_local < c_rare_unit_weight) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := 0;
            if text_value = '' then
            begin
                Exit;
            end;
            if (exact_weight_value <= c_low_frequency_medical_exact_weight) and
                text_has_low_frequency_medical_unit_local(text_value) then
            begin
                Exit;
            end;

            // Single-character query learning must stay strong and persistent.
            // For multi-character base exact entries, choice history is only a
            // tie-breaker; it must not let a low-frequency base word outrank
            // much stronger exact dictionary matches after an accidental pick.
            if text_units_value <= 1 then
            begin
                Exit(query_choice_rank_bonus_local(text_value));
            end;

            if not is_full_pinyin_key(normalized_pinyin) then
            begin
                Exit;
            end;

            if ((m_session_query_latest_text <> nil) and
                m_session_query_latest_text.TryGetValue(normalized_pinyin,
                latest_text_local) and SameText(Trim(latest_text_local),
                text_value)) or is_latest_session_query_choice(text_value) then
            begin
                if not has_rare_low_weight_unit_local then
                begin
                    Exit(query_choice_rank_bonus_local(text_value));
                end;
            end;

            if m_dictionary = nil then
            begin
                Exit;
            end;

            raw_bonus_local := m_dictionary.get_query_choice_bonus(
                normalized_pinyin, text_value);
            if raw_bonus_local <= 0 then
            begin
                Exit;
            end;

            capped_bonus_local := exact_weight_value div 2;
            if capped_bonus_local < c_multi_base_choice_bonus_floor then
            begin
                capped_bonus_local := c_multi_base_choice_bonus_floor;
            end;
            if capped_bonus_local > c_multi_base_choice_bonus_cap then
            begin
                capped_bonus_local := c_multi_base_choice_bonus_cap;
            end;

            if (raw_bonus_local >= c_multi_base_strong_choice_min) and
                (not has_rare_low_weight_unit_local) then
            begin
                Exit(50000000 + (raw_bonus_local * 1000));
            end;

            Result := Min(raw_bonus_local, capped_bonus_local);
        end;

        function exact_candidate_is_user_local(
            const candidate_value: TncCandidate; const text_value: string): Boolean;
        begin
            Result := False;
            if (m_dictionary = nil) or (normalized_pinyin = '') or
                (text_value = '') then
            begin
                Exit;
            end;

            Result := m_dictionary.is_user_entry(normalized_pinyin, text_value);
        end;

        function exact_candidate_is_reliable_complete_local(
            const candidate_value: TncCandidate; const text_value: string): Boolean;
        const
            c_min_supported_exact_dict_weight = 160;
        var
            latest_text_local: string;
        begin
            Result := exact_candidate_is_user_local(candidate_value, text_value);
            if Result then
            begin
                Exit;
            end;

            if (m_dictionary = nil) or (normalized_pinyin = '') or
                (text_value = '') then
            begin
                Exit(False);
            end;

            if (m_session_query_latest_text <> nil) and
                m_session_query_latest_text.TryGetValue(normalized_pinyin,
                latest_text_local) and SameText(Trim(latest_text_local),
                text_value) then
            begin
                Exit(True);
            end;

            if is_latest_session_query_choice(text_value) or
                (get_context_query_latest_bonus(text_value) > 0) or
                (m_dictionary.get_query_choice_bonus(normalized_pinyin,
                text_value) > 0) then
            begin
                Exit(True);
            end;

            Result := m_dictionary.is_base_entry(normalized_pinyin,
                text_value);
            if Result then
            begin
                Exit;
            end;

            Result := (candidate_value.source = cs_rule) and
                candidate_value.has_dict_weight and
                (candidate_value.dict_weight >= c_min_supported_exact_dict_weight);
        end;

        procedure apply_short_nocontext_reranker_local;
        const
            c_weak_residual_score_margin = 20000000;
            c_weak_residual_min_full_lm_gain = 600;
        var
            context_value_local: string;
            candidate_texts_local: TArray<string>;
            candidate_weights_local: TArray<Integer>;
            candidate_display_scores_local: TArray<Integer>;
            candidate_full_lm_scores_local: TArray<Integer>;
            candidate_suffix_lm_scores_local: TArray<Integer>;
            candidate_list_indices_local: TArray<Integer>;
            seen_texts_local: TDictionary<string, Boolean>;
            list_idx_local: Integer;
            candidate_idx_local: Integer;
            best_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            best_full_lm_local: Integer;
            best_suffix_lm_local: Integer;
            best_score_local: Int64;
            candidate_score_local: Int64;
            features_local: TncShortNoContextFeatures;
            rank_item_local: TShortExactRankItem;

            function effective_left_context_local: string;
            begin
                Result := Trim(m_left_context);
                if Trim(m_segment_left_context) <> '' then
                begin
                    Result := Trim(m_segment_left_context);
                end;
                if (Trim(m_segment_left_context) = '') and
                    (Trim(m_external_left_context) <> '') then
                begin
                    Result := Trim(m_external_left_context);
                end;
                Result := context_model_tail(Result);
            end;

            procedure build_features_local(const candidate_index_local: Integer;
                out output_local: TncShortNoContextFeatures);
            var
                candidate_units_local: TArray<string>;
                top_units_local: TArray<string>;
                compare_idx_local: Integer;
                compare_limit_local: Integer;
                different_local: Integer;
                same_prefix_local: Integer;
                same_suffix_local: Integer;
                candidate_log_weight_local: Double;
                candidate_log_display_local: Double;
                top_log_weight_local: Double;
                top_log_display_local: Double;
            begin
                FillChar(output_local, SizeOf(output_local), 0);
                candidate_units_local := split_text_units(
                    candidate_texts_local[candidate_index_local]);
                top_units_local := split_text_units(candidate_texts_local[0]);
                compare_limit_local := Min(Length(candidate_units_local),
                    Length(top_units_local));
                different_local := Abs(Length(candidate_units_local) -
                    Length(top_units_local));
                for compare_idx_local := 0 to compare_limit_local - 1 do
                begin
                    if candidate_units_local[compare_idx_local] <>
                        top_units_local[compare_idx_local] then
                    begin
                        Inc(different_local);
                    end;
                end;
                same_prefix_local := 0;
                while (same_prefix_local < compare_limit_local) and
                    (candidate_units_local[same_prefix_local] =
                    top_units_local[same_prefix_local]) do
                begin
                    Inc(same_prefix_local);
                end;
                same_suffix_local := 0;
                while (same_suffix_local <
                    compare_limit_local - same_prefix_local) and
                    (candidate_units_local[High(candidate_units_local) -
                    same_suffix_local] = top_units_local[High(top_units_local) -
                    same_suffix_local]) do
                begin
                    Inc(same_suffix_local);
                end;

                candidate_log_weight_local := Ln(1.0 + Max(0,
                    candidate_weights_local[candidate_index_local]));
                candidate_log_display_local := Ln(1.0 + Max(0,
                    candidate_display_scores_local[candidate_index_local]));
                top_log_weight_local := Ln(1.0 + Max(0,
                    candidate_weights_local[0]));
                top_log_display_local := Ln(1.0 + Max(0,
                    candidate_display_scores_local[0]));

                output_local.candidate_rank := candidate_index_local + 1;
                output_local.candidate_full_lm :=
                    candidate_full_lm_scores_local[candidate_index_local];
                output_local.candidate_suffix_lm :=
                    candidate_suffix_lm_scores_local[candidate_index_local];
                output_local.candidate_log_dict_weight :=
                    candidate_log_weight_local;
                output_local.candidate_log_display_score :=
                    candidate_log_display_local;
                output_local.candidate_text_units :=
                    Length(candidate_units_local);
                output_local.query_units := expected_units;
                output_local.candidate_count := Length(candidate_texts_local);
                output_local.delta_full_lm_from_top :=
                    candidate_full_lm_scores_local[candidate_index_local] -
                    candidate_full_lm_scores_local[0];
                output_local.delta_suffix_lm_from_top :=
                    candidate_suffix_lm_scores_local[candidate_index_local] -
                    candidate_suffix_lm_scores_local[0];
                output_local.delta_dict_weight_from_top :=
                    candidate_weights_local[candidate_index_local] -
                    candidate_weights_local[0];
                output_local.delta_display_score_from_top :=
                    candidate_display_scores_local[candidate_index_local] -
                    candidate_display_scores_local[0];
                output_local.delta_log_dict_weight_from_top :=
                    candidate_log_weight_local - top_log_weight_local;
                output_local.delta_log_display_score_from_top :=
                    candidate_log_display_local - top_log_display_local;
                output_local.delta_full_lm_from_best :=
                    candidate_full_lm_scores_local[candidate_index_local] -
                    best_full_lm_local;
                output_local.delta_suffix_lm_from_best :=
                    candidate_suffix_lm_scores_local[candidate_index_local] -
                    best_suffix_lm_local;
                output_local.candidate_is_full_lm_best := Ord(
                    candidate_full_lm_scores_local[candidate_index_local] =
                    best_full_lm_local);
                output_local.candidate_is_suffix_lm_best := Ord(
                    candidate_suffix_lm_scores_local[candidate_index_local] =
                    best_suffix_lm_local);
                output_local.different_units_from_top := different_local;
                output_local.same_prefix_units := same_prefix_local;
                output_local.same_suffix_units := same_suffix_local;
                output_local.top_full_lm := candidate_full_lm_scores_local[0];
                output_local.top_suffix_lm := candidate_suffix_lm_scores_local[0];
                output_local.top_log_dict_weight := top_log_weight_local;
                output_local.top_log_display_score := top_log_display_local;
            end;

            function baseline_has_protected_name_shape_local(
                const challenger_index_local: Integer): Boolean;
            var
                baseline_units_local: TArray<string>;
                challenger_units_local: TArray<string>;
            begin
                Result := False;
                if (challenger_index_local <= 0) or
                    (challenger_index_local > High(candidate_texts_local)) then
                begin
                    Exit;
                end;
                baseline_units_local := split_text_units(candidate_texts_local[0]);
                challenger_units_local := split_text_units(
                    candidate_texts_local[challenger_index_local]);
                Result := (Length(baseline_units_local) = 2) and
                    (Length(challenger_units_local) = 2) and
                    (baseline_units_local[0] = challenger_units_local[0]) and
                    is_common_surname_text(baseline_units_local[0]);
            end;

        begin
            short_nocontext_promoted_exact_text := '';
            short_nocontext_promoted_exact_lead := 0;
            if nc_long_ablated(la_short_nocontext) then Exit;
            if (m_dictionary = nil) or has_user_exact or
                (expected_units < 2) or (expected_units > 4) or
                (Length(syllables) <> expected_units) or
                (not is_full_pinyin_key(normalized_pinyin)) then
            begin
                Exit;
            end;
            context_value_local := effective_left_context_local;
            if context_value_local <> '' then
            begin
                Exit;
            end;

            seen_texts_local := TDictionary<string, Boolean>.Create;
            try
                SetLength(candidate_texts_local, 0);
                SetLength(candidate_weights_local, 0);
                SetLength(candidate_display_scores_local, 0);
                SetLength(candidate_list_indices_local, 0);
                for list_idx_local := 0 to list.Count - 1 do
                begin
                    rank_item_local := list[list_idx_local];
                    if rank_item_local.category <> 1 then
                    begin
                        Continue;
                    end;
                    if Length(candidate_texts_local) >=
                        c_short_nocontext_max_candidate_rank then
                    begin
                        Break;
                    end;
                    if rank_item_local.low_frequency_medical_exact then
                    begin
                        Continue;
                    end;
                    candidate_text_local := Trim(rank_item_local.candidate.text);
                    if (candidate_text_local = '') or
                        seen_texts_local.ContainsKey(candidate_text_local) or
                        (not exact_weights.TryGetValue(candidate_text_local,
                        candidate_weight_local)) then
                    begin
                        Continue;
                    end;
                    if not short_residual_exact_weight_is_eligible(
                        candidate_weight_local,
                        Length(candidate_texts_local) = 0) then
                    begin
                        Continue;
                    end;
                    if query_choice_rank_bonus_local(candidate_text_local) > 0 then
                    begin
                        Exit;
                    end;

                    seen_texts_local.Add(candidate_text_local, True);
                    candidate_idx_local := Length(candidate_texts_local);
                    SetLength(candidate_texts_local, candidate_idx_local + 1);
                    SetLength(candidate_weights_local, candidate_idx_local + 1);
                    SetLength(candidate_display_scores_local,
                        candidate_idx_local + 1);
                    SetLength(candidate_list_indices_local,
                        candidate_idx_local + 1);
                    candidate_texts_local[candidate_idx_local] :=
                        candidate_text_local;
                    candidate_weights_local[candidate_idx_local] :=
                        candidate_weight_local;
                    candidate_display_scores_local[candidate_idx_local] :=
                        rank_item_local.candidate.score;
                    candidate_list_indices_local[candidate_idx_local] :=
                        list_idx_local;
                end;
                if Length(candidate_texts_local) < 2 then
                begin
                    Exit;
                end;
                if (not get_cached_char_lm_scores(candidate_texts_local,
                    candidate_full_lm_scores_local, clsm_full, '')) or
                    (Length(candidate_full_lm_scores_local) <>
                    Length(candidate_texts_local)) then
                begin
                    Exit;
                end;
                if (not get_cached_char_lm_scores(candidate_texts_local,
                    candidate_suffix_lm_scores_local, clsm_suffix, '')) or
                    (Length(candidate_suffix_lm_scores_local) <>
                    Length(candidate_texts_local)) then
                begin
                    Exit;
                end;

                best_full_lm_local := candidate_full_lm_scores_local[0];
                best_suffix_lm_local := candidate_suffix_lm_scores_local[0];
                for candidate_idx_local := 1 to High(candidate_texts_local) do
                begin
                    best_full_lm_local := Max(best_full_lm_local,
                        candidate_full_lm_scores_local[candidate_idx_local]);
                    best_suffix_lm_local := Max(best_suffix_lm_local,
                        candidate_suffix_lm_scores_local[candidate_idx_local]);
                end;

                best_idx_local := 0;
                best_score_local := Low(Int64);
                for candidate_idx_local := 1 to High(candidate_texts_local) do
                begin
                    build_features_local(candidate_idx_local, features_local);
                    candidate_score_local := short_nocontext_residual_score(
                        features_local);
                    if candidate_score_local > best_score_local then
                    begin
                        best_score_local := candidate_score_local;
                        best_idx_local := candidate_idx_local;
                    end;
                end;
                if (best_idx_local <= 0) or (best_score_local <
                    c_short_nocontext_promotion_threshold) then
                begin
                    Exit;
                end;
                { Without user or context evidence, preserve a decisive
                  dictionary gap only when the baseline also has a same-surname
                  two-character name shape. Raw weights alone remain too noisy
                  to veto the residual model. }
                if short_nocontext_large_weight_gap_blocks_promotion(
                    candidate_weights_local[0],
                    candidate_weights_local[best_idx_local],
                    baseline_has_protected_name_shape_local(best_idx_local)) then
                begin
                    Exit;
                end;
                { A weak residual alone must not displace a high-confidence
                  base exact with a lower-weight candidate. Require an
                  independent full-text LM gain for that override. }
                if (candidate_weights_local[0] >=
                    c_short_nocontext_protected_baseline_min_weight) and
                    (candidate_weights_local[best_idx_local] <
                    candidate_weights_local[0]) and
                    (best_score_local - c_short_nocontext_promotion_threshold <
                    c_weak_residual_score_margin) and
                    (Int64(candidate_full_lm_scores_local[best_idx_local]) -
                    candidate_full_lm_scores_local[0] <
                    c_weak_residual_min_full_lm_gain) then
                begin
                    Exit;
                end;

                short_nocontext_promoted_exact_text :=
                    candidate_texts_local[best_idx_local];
                short_nocontext_promoted_exact_lead := EnsureRange(
                    (best_score_local - c_short_nocontext_promotion_threshold)
                    div 100000, Low(Integer), High(Integer));
                rank_item_local := list[
                    candidate_list_indices_local[best_idx_local]];
                rank_item_local.nocontext_exact_priority := 1;
                list[candidate_list_indices_local[best_idx_local]] :=
                    rank_item_local;
            finally
                seen_texts_local.Free;
            end;
        end;

        procedure apply_short_context_reranker_local;
        const
            c_max_context_candidates = 9;
        var
            context_value_local: string;
            candidate_texts_local: TArray<string>;
            candidate_weights_local: TArray<Integer>;
            candidate_display_scores_local: TArray<Integer>;
            candidate_lm_scores_local: TArray<Integer>;
            candidate_list_indices_local: TArray<Integer>;
            seen_texts_local: TDictionary<string, Boolean>;
            list_idx_local: Integer;
            candidate_idx_local: Integer;
            baseline_idx_local: Integer;
            best_idx_local: Integer;
            first_stage_idx_local: Integer;
            residual_best_idx_local: Integer;
            final_idx_local: Integer;
            best_lm_idx_local: Integer;
            candidate_text_local: string;
            candidate_weight_local: Integer;
            baseline_model_score_local: Double;
            candidate_model_score_local: Double;
            best_model_score_local: Double;
            model_lead_local: Double;
            residual_baseline_score_local: Double;
            residual_candidate_score_local: Double;
            residual_best_score_local: Double;
            residual_lead_local: Double;
            first_stage_promoted_local: Boolean;
            residual_promoted_local: Boolean;
            boundary_prefix_texts_local: TArray<string>;
            boundary_prefix_scores_local: TArray<Integer>;
            boundary_prefix1_scores_local: TArray<Integer>;
            boundary_prefix2_scores_local: TArray<Integer>;
            difference_features_local: TncShortContextDifferenceFeatures;
            difference_stage1_features_local:
                TncShortContextDifferenceFeatures;
            difference_top_idx_local: Integer;
            difference_second_idx_local: Integer;
            difference_stage1_top_idx_local: Integer;
            difference_stage1_second_idx_local: Integer;
            difference_best_idx_local: Integer;
            difference_idx_local: Integer;
            difference_rank_local: Integer;
            difference_score_local: Int64;
            difference_best_score_local: Int64;
            difference_runner_up_score_local: Int64;
            difference_best_probability_local: Double;
            difference_runner_up_probability_local: Double;
            difference_stage1_promoted_local: Boolean;
            difference_stage2_promoted_local: Boolean;
            difference_stage1_features_valid_local: Boolean;
            rank_item_local: TShortExactRankItem;

            function effective_left_context_local: string;
            begin
                Result := Trim(m_left_context);
                if Trim(m_segment_left_context) <> '' then
                begin
                    Result := Trim(m_segment_left_context);
                end;
                if (Trim(m_segment_left_context) = '') and
                    (Trim(m_external_left_context) <> '') then
                begin
                    Result := Trim(m_external_left_context);
                end;
                Result := context_model_tail(Result);
            end;

            function difference_pair_eligible_local(
                const top_index_local,
                challenger_index_local: Integer): Boolean;
            begin
                Result :=
                    (Length(candidate_texts_local[top_index_local]) =
                    Length(candidate_texts_local[challenger_index_local])) and
                    m_dictionary.is_base_entry(normalized_pinyin,
                    candidate_texts_local[top_index_local]) and
                    m_dictionary.is_base_entry(normalized_pinyin,
                    candidate_texts_local[challenger_index_local]);
            end;

            procedure build_difference_features_local(
                const top_index_local, challenger_index_local,
                challenger_rank_local: Integer;
                const use_stage2_evidence_local: Boolean;
                out features_local: TncShortContextDifferenceFeatures);
            var
                top_text_inner: string;
                challenger_text_inner: string;
                compare_index_inner: Integer;
                compare_limit_inner: Integer;
                different_inner: Integer;
                prefix_inner: Integer;
                suffix_inner: Integer;
            begin
                FillChar(features_local, SizeOf(features_local), 0);
                top_text_inner := candidate_texts_local[top_index_local];
                challenger_text_inner := candidate_texts_local[
                    challenger_index_local];
                compare_limit_inner := Min(Length(top_text_inner),
                    Length(challenger_text_inner));
                different_inner := Abs(Length(top_text_inner) -
                    Length(challenger_text_inner));
                for compare_index_inner := 1 to compare_limit_inner do
                begin
                    if top_text_inner[compare_index_inner] <>
                        challenger_text_inner[compare_index_inner] then
                    begin
                        Inc(different_inner);
                    end;
                end;
                prefix_inner := 0;
                while (prefix_inner < compare_limit_inner) and
                    (top_text_inner[prefix_inner + 1] =
                    challenger_text_inner[prefix_inner + 1]) do
                begin
                    Inc(prefix_inner);
                end;
                suffix_inner := 0;
                while (suffix_inner < compare_limit_inner - prefix_inner) and
                    (top_text_inner[Length(top_text_inner) - suffix_inner] =
                    challenger_text_inner[Length(challenger_text_inner) -
                    suffix_inner]) do
                begin
                    Inc(suffix_inner);
                end;

                features_local.challenger_rank := challenger_rank_local;
                features_local.delta_full_lm :=
                    candidate_lm_scores_local[challenger_index_local] -
                    candidate_lm_scores_local[top_index_local];
                features_local.delta_prefix1_lm :=
                    boundary_prefix1_scores_local[challenger_index_local] -
                    boundary_prefix1_scores_local[top_index_local];
                features_local.delta_prefix2_lm :=
                    boundary_prefix2_scores_local[challenger_index_local] -
                    boundary_prefix2_scores_local[top_index_local];
                features_local.delta_dict_weight :=
                    candidate_weights_local[challenger_index_local] -
                    candidate_weights_local[top_index_local];
                features_local.delta_display_score :=
                    candidate_display_scores_local[challenger_index_local] -
                    candidate_display_scores_local[top_index_local];
                features_local.top_full_lm :=
                    candidate_lm_scores_local[top_index_local];
                features_local.challenger_full_lm :=
                    candidate_lm_scores_local[challenger_index_local];
                features_local.top_prefix1_lm :=
                    boundary_prefix1_scores_local[top_index_local];
                features_local.challenger_prefix1_lm :=
                    boundary_prefix1_scores_local[challenger_index_local];
                features_local.top_prefix2_lm :=
                    boundary_prefix2_scores_local[top_index_local];
                features_local.challenger_prefix2_lm :=
                    boundary_prefix2_scores_local[challenger_index_local];
                features_local.top_log_dict_weight := Ln(1.0 + Max(0,
                    candidate_weights_local[top_index_local]));
                features_local.challenger_log_dict_weight := Ln(1.0 + Max(0,
                    candidate_weights_local[challenger_index_local]));
                features_local.context_units := Min(12,
                    Length(context_value_local));
                features_local.query_units := Length(normalized_pinyin);
                features_local.top_text_units := Length(top_text_inner);
                features_local.challenger_text_units :=
                    Length(challenger_text_inner);
                features_local.different_units := different_inner;
                features_local.same_prefix_units := prefix_inner;
                features_local.same_suffix_units := suffix_inner;
                features_local.candidate_count :=
                    Length(candidate_texts_local);
                if use_stage2_evidence_local then
                begin
                    short_context_difference_fill_stage2_evidence(
                        context_value_local, top_text_inner,
                        challenger_text_inner, features_local);
                end
                else
                begin
                    short_context_difference_fill_stage1_evidence(
                        context_value_local, top_text_inner,
                        challenger_text_inner, features_local);
                end;
            end;

            function difference_probability_local(
                const score_local: Int64): Double;
            var
                scaled_score_local: Double;
                exponential_local: Double;
            begin
                scaled_score_local := score_local /
                    c_short_context_difference_score_scale;
                if scaled_score_local >= 0.0 then
                begin
                    Result := 1.0 / (1.0 + Exp(-scaled_score_local));
                end
                else
                begin
                    exponential_local := Exp(scaled_score_local);
                    Result := exponential_local / (1.0 + exponential_local);
                end;
            end;

        begin
            short_context_promoted_exact_text := '';
            short_context_promoted_exact_lead := 0;
            context_value_local := effective_left_context_local;
            if (context_value_local = '') or (m_dictionary = nil) or
                has_user_exact or (list.Count < 2) then
            begin
                Exit;
            end;

            seen_texts_local := TDictionary<string, Boolean>.Create;
            try
                SetLength(candidate_texts_local, 0);
                SetLength(candidate_weights_local, 0);
                SetLength(candidate_display_scores_local, 0);
                SetLength(candidate_list_indices_local, 0);
                for list_idx_local := 0 to list.Count - 1 do
                begin
                    rank_item_local := list[list_idx_local];
                    if rank_item_local.category <> 1 then
                    begin
                        Continue;
                    end;
                    if Length(candidate_texts_local) >= c_max_context_candidates then
                    begin
                        Break;
                    end;

                    candidate_text_local := Trim(rank_item_local.candidate.text);
                    if (candidate_text_local = '') or
                        seen_texts_local.ContainsKey(candidate_text_local) or
                        (not exact_weights.TryGetValue(candidate_text_local,
                        candidate_weight_local)) then
                    begin
                        Continue;
                    end;

                    if not short_residual_exact_weight_is_eligible(
                        candidate_weight_local,
                        Length(candidate_texts_local) = 0) then
                    begin
                        Continue;
                    end;

                    if query_choice_rank_bonus_local(candidate_text_local) > 0 then
                    begin
                        Exit;
                    end;

                    seen_texts_local.Add(candidate_text_local, True);
                    candidate_idx_local := Length(candidate_texts_local);
                    SetLength(candidate_texts_local, candidate_idx_local + 1);
                    SetLength(candidate_weights_local, candidate_idx_local + 1);
                    SetLength(candidate_display_scores_local,
                        candidate_idx_local + 1);
                    SetLength(candidate_list_indices_local,
                        candidate_idx_local + 1);
                    candidate_texts_local[candidate_idx_local] :=
                        candidate_text_local;
                    candidate_weights_local[candidate_idx_local] :=
                        candidate_weight_local;
                    candidate_display_scores_local[candidate_idx_local] :=
                        rank_item_local.candidate.score;
                    candidate_list_indices_local[candidate_idx_local] :=
                        list_idx_local;
                end;

                if Length(candidate_texts_local) < 2 then
                begin
                    Exit;
                end;
                if (not get_cached_char_lm_scores(candidate_texts_local,
                    candidate_lm_scores_local, clsm_short_context,
                    context_value_local)) or
                    (Length(candidate_lm_scores_local) <>
                    Length(candidate_texts_local)) then
                begin
                    Exit;
                end;

                baseline_idx_local := 0;
                best_lm_idx_local := 0;
                for candidate_idx_local := 1 to High(candidate_texts_local) do
                begin
                    if candidate_lm_scores_local[candidate_idx_local] >
                        candidate_lm_scores_local[best_lm_idx_local] then
                    begin
                        best_lm_idx_local := candidate_idx_local;
                    end;
                end;

                best_idx_local := baseline_idx_local;
                baseline_model_score_local := short_context_reranker_score(
                    context_value_local,
                    candidate_texts_local[baseline_idx_local], 1,
                    candidate_lm_scores_local[baseline_idx_local],
                    candidate_weights_local[baseline_idx_local],
                    candidate_display_scores_local[baseline_idx_local], True, 0,
                    0, candidate_lm_scores_local[baseline_idx_local] -
                    candidate_lm_scores_local[best_lm_idx_local],
                    baseline_idx_local = best_lm_idx_local,
                    Length(candidate_texts_local), Length(context_value_local),
                    Length(candidate_texts_local[baseline_idx_local]));
                best_model_score_local := baseline_model_score_local;
                for candidate_idx_local := 1 to High(candidate_texts_local) do
                begin
                    candidate_model_score_local := short_context_reranker_score(
                        context_value_local,
                        candidate_texts_local[candidate_idx_local],
                        candidate_idx_local + 1,
                        candidate_lm_scores_local[candidate_idx_local],
                        candidate_weights_local[candidate_idx_local],
                        candidate_display_scores_local[candidate_idx_local], False,
                        candidate_lm_scores_local[candidate_idx_local] -
                        candidate_lm_scores_local[baseline_idx_local],
                        candidate_weights_local[candidate_idx_local] -
                        candidate_weights_local[baseline_idx_local],
                        candidate_lm_scores_local[candidate_idx_local] -
                        candidate_lm_scores_local[best_lm_idx_local],
                        candidate_idx_local = best_lm_idx_local,
                        Length(candidate_texts_local), Length(context_value_local),
                        Length(candidate_texts_local[candidate_idx_local]));
                    if candidate_model_score_local > best_model_score_local then
                    begin
                        best_idx_local := candidate_idx_local;
                        best_model_score_local := candidate_model_score_local;
                    end;
                end;

                model_lead_local := best_model_score_local -
                    baseline_model_score_local;
                first_stage_promoted_local :=
                    (best_idx_local <> baseline_idx_local) and
                    (model_lead_local >=
                    c_short_context_reranker_promotion_margin) and
                    not nc_long_ablated(la_short_reranker);
                first_stage_idx_local := baseline_idx_local;
                if first_stage_promoted_local then
                begin
                    first_stage_idx_local := best_idx_local;
                end;

                residual_baseline_score_local := short_context_residual_score(
                    context_value_local,
                    candidate_texts_local[first_stage_idx_local],
                    first_stage_idx_local + 1,
                    candidate_lm_scores_local[first_stage_idx_local],
                    candidate_weights_local[first_stage_idx_local],
                    candidate_display_scores_local[first_stage_idx_local], True,
                    0, 0, candidate_lm_scores_local[first_stage_idx_local] -
                    candidate_lm_scores_local[best_lm_idx_local],
                    first_stage_idx_local = best_lm_idx_local,
                    Length(candidate_texts_local), Length(context_value_local),
                    Length(candidate_texts_local[first_stage_idx_local]));
                residual_best_idx_local := first_stage_idx_local;
                residual_best_score_local := residual_baseline_score_local;
                for candidate_idx_local := 0 to High(candidate_texts_local) do
                begin
                    if candidate_idx_local = first_stage_idx_local then
                    begin
                        Continue;
                    end;
                    residual_candidate_score_local :=
                        short_context_residual_score(context_value_local,
                        candidate_texts_local[candidate_idx_local],
                        candidate_idx_local + 1,
                        candidate_lm_scores_local[candidate_idx_local],
                        candidate_weights_local[candidate_idx_local],
                        candidate_display_scores_local[candidate_idx_local], False,
                        candidate_lm_scores_local[candidate_idx_local] -
                        candidate_lm_scores_local[first_stage_idx_local],
                        candidate_weights_local[candidate_idx_local] -
                        candidate_weights_local[first_stage_idx_local],
                        candidate_lm_scores_local[candidate_idx_local] -
                        candidate_lm_scores_local[best_lm_idx_local],
                        candidate_idx_local = best_lm_idx_local,
                        Length(candidate_texts_local), Length(context_value_local),
                        Length(candidate_texts_local[candidate_idx_local]));
                    if residual_candidate_score_local >
                        residual_best_score_local then
                    begin
                        residual_best_idx_local := candidate_idx_local;
                        residual_best_score_local :=
                            residual_candidate_score_local;
                    end;
                end;

                residual_lead_local := residual_best_score_local -
                    residual_baseline_score_local;
                residual_promoted_local :=
                    (residual_best_idx_local <> first_stage_idx_local) and
                    (residual_lead_local >=
                    c_short_context_residual_promotion_margin) and
                    not nc_long_ablated(la_short_residual);
                final_idx_local := first_stage_idx_local;
                if residual_promoted_local then
                begin
                    final_idx_local := residual_best_idx_local;
                end;

                { The difference stages compare the first character and the
                  first two characters of existing exact candidates; they
                  never create candidates. }
                difference_stage1_promoted_local := False;
                difference_stage2_promoted_local := False;
                difference_stage1_features_valid_local := False;
                difference_top_idx_local := final_idx_local;
                SetLength(boundary_prefix_texts_local,
                    Length(candidate_texts_local) * 2);
                for candidate_idx_local := 0 to High(candidate_texts_local) do
                begin
                    boundary_prefix_texts_local[candidate_idx_local * 2] :=
                        Copy(candidate_texts_local[candidate_idx_local], 1, 1);
                    boundary_prefix_texts_local[candidate_idx_local * 2 + 1] :=
                        Copy(candidate_texts_local[candidate_idx_local], 1, 2);
                end;
                if get_cached_char_lm_scores(boundary_prefix_texts_local,
                    boundary_prefix_scores_local, clsm_short_context,
                    context_value_local) and
                    (Length(boundary_prefix_scores_local) =
                    Length(boundary_prefix_texts_local)) then
                begin
                    SetLength(boundary_prefix1_scores_local,
                        Length(candidate_texts_local));
                    SetLength(boundary_prefix2_scores_local,
                        Length(candidate_texts_local));
                    for candidate_idx_local := 0 to High(candidate_texts_local) do
                    begin
                        boundary_prefix1_scores_local[candidate_idx_local] :=
                            boundary_prefix_scores_local[
                            candidate_idx_local * 2];
                        boundary_prefix2_scores_local[candidate_idx_local] :=
                            boundary_prefix_scores_local[
                            candidate_idx_local * 2 + 1];
                    end;

                    { Compare the final current winner against existing exact
                      alternatives. The first pass only considers the logical
                      second candidate. A stricter second pass considers the
                      remaining candidates only when the first pass abstains. }
                    difference_top_idx_local := final_idx_local;
                    difference_second_idx_local := -1;
                    for difference_idx_local := 0 to
                        High(candidate_texts_local) do
                    begin
                        if difference_idx_local <>
                            difference_top_idx_local then
                        begin
                            difference_second_idx_local :=
                                difference_idx_local;
                            Break;
                        end;
                    end;
                    difference_score_local := Low(Int64);
                    if (difference_second_idx_local >= 0) and
                        difference_pair_eligible_local(
                        difference_top_idx_local,
                        difference_second_idx_local) and
                        short_context_difference_has_positive_signal(
                        context_value_local,
                        candidate_texts_local[difference_top_idx_local],
                        candidate_texts_local[
                        difference_second_idx_local]) then
                    begin
                        build_difference_features_local(
                            difference_top_idx_local,
                            difference_second_idx_local, 2, False,
                            difference_features_local);
                        difference_stage1_features_local :=
                            difference_features_local;
                        difference_stage1_top_idx_local :=
                            difference_top_idx_local;
                        difference_stage1_second_idx_local :=
                            difference_second_idx_local;
                        difference_stage1_features_valid_local := True;
                        difference_score_local :=
                            short_context_difference_stage1_score(
                            difference_features_local);
                        if (difference_score_local >=
                            c_short_context_difference_stage1_threshold) and
                            not nc_long_ablated(la_short_difference) then
                        begin
                            final_idx_local := difference_second_idx_local;
                            difference_stage1_promoted_local := True;
                        end;
                    end;

                    if (not difference_stage1_promoted_local) and
                        not nc_long_ablated(la_short_difference) then
                    begin
                        difference_best_idx_local := -1;
                        difference_best_score_local := Low(Int64);
                        difference_runner_up_score_local := Low(Int64);
                        difference_rank_local := 1;
                        for difference_idx_local := 0 to
                            High(candidate_texts_local) do
                        begin
                            if difference_idx_local =
                                difference_top_idx_local then
                            begin
                                Continue;
                            end;
                            Inc(difference_rank_local);
                            if difference_idx_local =
                                difference_second_idx_local then
                            begin
                                Continue;
                            end;
                            if not difference_pair_eligible_local(
                                difference_top_idx_local,
                                difference_idx_local) then
                            begin
                                Continue;
                            end;
                            if not
                                short_context_difference_has_positive_mined_evidence(
                                context_value_local,
                                candidate_texts_local[
                                difference_top_idx_local],
                                candidate_texts_local[difference_idx_local]) then
                            begin
                                Continue;
                            end;
                            build_difference_features_local(
                                difference_top_idx_local,
                                difference_idx_local,
                                difference_rank_local, True,
                                difference_features_local);
                            difference_score_local :=
                                short_context_difference_stage2_score(
                                difference_features_local);
                            if difference_score_local >
                                difference_best_score_local then
                            begin
                                difference_runner_up_score_local :=
                                    difference_best_score_local;
                                difference_best_score_local :=
                                    difference_score_local;
                                difference_best_idx_local :=
                                    difference_idx_local;
                            end
                            else if difference_score_local >
                                difference_runner_up_score_local then
                            begin
                                difference_runner_up_score_local :=
                                    difference_score_local;
                            end;
                        end;
                        if (difference_best_idx_local >= 0) and
                            (difference_best_score_local >=
                            c_short_context_difference_stage2_threshold) then
                        begin
                            difference_best_probability_local :=
                                difference_probability_local(
                                difference_best_score_local);
                            if difference_runner_up_score_local =
                                Low(Int64) then
                            begin
                                difference_runner_up_probability_local := 0.0;
                            end
                            else
                            begin
                                difference_runner_up_probability_local :=
                                    difference_probability_local(
                                    difference_runner_up_score_local);
                            end;
                            if difference_best_probability_local -
                                difference_runner_up_probability_local >=
                                c_short_context_difference_stage2_lead_threshold then
                            begin
                                final_idx_local := difference_best_idx_local;
                                difference_stage2_promoted_local := True;
                                difference_score_local :=
                                    difference_best_score_local;
                            end;
                        end;
                    end;

                end;

                if final_idx_local <> baseline_idx_local then
                begin
                    short_context_promoted_exact_text :=
                        candidate_texts_local[final_idx_local];
                    if difference_stage1_promoted_local then
                    begin
                        short_context_promoted_exact_lead := EnsureRange(
                            (difference_score_local -
                            c_short_context_difference_stage1_threshold) div
                            100000, Low(Integer), High(Integer));
                    end
                    else if difference_stage2_promoted_local then
                    begin
                        short_context_promoted_exact_lead := EnsureRange(
                            (difference_score_local -
                            c_short_context_difference_stage2_threshold) div
                            100000, Low(Integer), High(Integer));
                    end
                    else if residual_promoted_local then
                    begin
                        short_context_promoted_exact_lead := Round(
                            residual_lead_local * 1000.0);
                    end
                    else
                    begin
                        short_context_promoted_exact_lead := Round(
                            model_lead_local * 1000.0);
                    end;
                    rank_item_local := list[
                        candidate_list_indices_local[final_idx_local]];
                    rank_item_local.context_exact_priority := 1;
                    list[candidate_list_indices_local[final_idx_local]] :=
                        rank_item_local;
                end;

                if m_config.debug_mode then
                begin
                    if first_stage_promoted_local then
                    begin
                        if m_last_lookup_debug_extra <> '' then
                        begin
                            m_last_lookup_debug_extra :=
                                m_last_lookup_debug_extra + ' ';
                        end;
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('shortctxrr=%s:%.3f>%s:%.3f',
                            [candidate_texts_local[baseline_idx_local],
                            baseline_model_score_local,
                            candidate_texts_local[first_stage_idx_local],
                            best_model_score_local]);
                    end;
                    if residual_promoted_local then
                    begin
                        if m_last_lookup_debug_extra <> '' then
                        begin
                            m_last_lookup_debug_extra :=
                                m_last_lookup_debug_extra + ' ';
                        end;
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('shortctxres=%s:%.3f>%s:%.3f',
                            [candidate_texts_local[first_stage_idx_local],
                            residual_baseline_score_local,
                            candidate_texts_local[residual_best_idx_local],
                            residual_best_score_local]);
                    end;
                    if difference_stage1_promoted_local or
                        difference_stage2_promoted_local then
                    begin
                        if m_last_lookup_debug_extra <> '' then
                        begin
                            m_last_lookup_debug_extra :=
                                m_last_lookup_debug_extra + ' ';
                        end;
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('shortctxdiff%d=%s:%d',
                            [1 + Ord(difference_stage2_promoted_local),
                            candidate_texts_local[final_idx_local],
                            short_context_promoted_exact_lead]);
                    end;
                end;
            finally
                seen_texts_local.Free;
            end;
        end;

        function try_get_closed_particle_combo_candidate_local(
            out out_candidate: TncCandidate): Boolean;
        var
            de_text: string;
            dehao_text: string;
            le_text: string;
            ba_text: string;
            ma_text: string;
            candidate_text_local: string;
            candidate_weight_local: Integer;
        begin
            Result := False;
            FillChar(out_candidate, SizeOf(out_candidate), 0);
            if (expected_units <> 2) or (Length(syllables) <> 2) or
                (not is_full_pinyin_key(normalized_pinyin)) then
            begin
                Exit;
            end;

            de_text := string(Char($7684));
            dehao_text := string(Char($5F97)) + string(Char($597D));
            le_text := string(Char($4E86));
            ba_text := string(Char($5427));
            if m_config.dictionary_variant = dv_traditional then
            begin
                ma_text := string(Char($55CE));
            end
            else
            begin
                ma_text := string(Char($5417));
            end;

            candidate_text_local := '';
            candidate_weight_local := 760;
            if SameText(normalized_pinyin, 'dema') then
            begin
                candidate_text_local := de_text + ma_text;
                candidate_weight_local := 860;
            end
            else if SameText(normalized_pinyin, 'deba') then
            begin
                candidate_text_local := de_text + ba_text;
                candidate_weight_local := 760;
            end
            else if SameText(normalized_pinyin, 'dele') then
            begin
                candidate_text_local := de_text + le_text;
                candidate_weight_local := 240;
            end
            else if SameText(normalized_pinyin, 'dehao') then
            begin
                candidate_text_local := dehao_text;
                candidate_weight_local := 760;
            end
            else if SameText(normalized_pinyin, 'leba') then
            begin
                candidate_text_local := le_text + ba_text;
                candidate_weight_local := 760;
            end
            else if SameText(normalized_pinyin, 'lema') then
            begin
                candidate_text_local := le_text + ma_text;
                candidate_weight_local := 860;
            end;

            if candidate_text_local = '' then
            begin
                Exit;
            end;

            out_candidate.text := candidate_text_local;
            out_candidate.comment := '';
            out_candidate.score := candidate_weight_local;
            out_candidate.source := cs_rule;
            out_candidate.has_dict_weight := True;
            out_candidate.dict_weight := candidate_weight_local;
            Result := True;
        end;

        function short_complete_rank_score_local(
            const candidate_value: TncCandidate; const text_value: string;
            const persistent_user: Boolean): Integer;
        begin
            Result := candidate_value.score;
            if is_full_pinyin_key(normalized_pinyin) and
                candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;

            if persistent_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
            Inc(Result, query_choice_rank_bonus_local(text_value));
        end;

        function prefix_candidate_cache_key_local(const text_value: string;
            const tail_key: string): string;
        begin
            Result := Trim(text_value) + #9 +
                normalize_pinyin_text(Trim(tail_key));
        end;

        function prefix_candidate_matches_query_local(
            const text_value: string; const text_units: Integer;
            const tail_key: string): Boolean;
        var
            prefix_key: string;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_text_local: string;
        begin
            Result := False;
            if (text_value = '') or (text_units <= 0) or
                (text_units >= expected_units) or (tail_key = '') or
                (text_units + get_effective_compact_pinyin_unit_count(tail_key) <>
                expected_units) then
            begin
                Exit;
            end;

            prefix_key := build_display_query_key(0, text_units);
            if prefix_key = '' then
            begin
                Exit;
            end;

            if text_units = 1 then
            begin
                if lookup_display_complete_cached(prefix_key,
                    prefix_results_local) then
                begin
                    for prefix_idx_local := 0 to High(prefix_results_local) do
                    begin
                        prefix_text_local := Trim(
                            prefix_results_local[prefix_idx_local].text);
                        if (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                            (get_candidate_text_unit_count(prefix_text_local) = 1) and
                            SameText(prefix_text_local, text_value) then
                        begin
                            Exit(True);
                        end;
                    end;
                    Exit(False);
                end;

                if m_dictionary.single_char_matches_pinyin(prefix_key,
                    text_value) then
                begin
                    Exit(True);
                end;

                Exit(False);
            end;

            Result := display_exact_key_has_text(prefix_key, text_value);
        end;

        function find_existing_display_candidate_local(
            const text_value: string; const comment_value: string): Integer;
        var
            find_idx: Integer;
        begin
            Result := -1;
            for find_idx := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[find_idx].text), text_value) and
                    SameText(Trim(m_candidates[find_idx].comment), comment_value) then
                begin
                    Exit(find_idx);
                end;
            end;
        end;

        function predictive_prefix_units_allowed_local(
            const units_value: Integer): Boolean;
        begin
            Result := False;
            if (units_value <= 0) or (expected_units <= 0) then
            begin
                Exit;
            end;

            if (expected_units <= 3) and (units_value = expected_units) then
            begin
                Exit(True);
            end;

            if (expected_units = 4) and (units_value = 3) then
            begin
                Exit(True);
            end;
        end;

        procedure append_missing_exact_candidates_local;
        var
            map_pair: TPair<string, TncCandidate>;
            existing_idx_local: Integer;
            append_idx_local: Integer;
            exact_candidate_local: TncCandidate;
        begin
            for map_pair in exact_candidates do
            begin
                existing_idx_local := find_existing_display_candidate_local(
                    map_pair.Key, '');
                if existing_idx_local >= 0 then
                begin
                    if exact_is_user.ContainsKey(map_pair.Key) and
                        exact_is_user[map_pair.Key] then
                    begin
                        m_candidates[existing_idx_local].source := cs_user;
                        m_candidates[existing_idx_local].has_dict_weight := False;
                        m_candidates[existing_idx_local].dict_weight := 0;
                    end;
                    Continue;
                end;

                exact_candidate_local := map_pair.Value;
                append_idx_local := Length(m_candidates);
                SetLength(m_candidates, append_idx_local + 1);
                m_candidates[append_idx_local] := exact_candidate_local;
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths, Length(m_candidates));
                end;
                m_candidate_segment_paths[append_idx_local] := '';
            end;
        end;

        procedure append_query_prefix_candidates_local;
        const
            c_prefix_phrase_probe_limit = 12;
            c_prefix_single_probe_limit = c_candidate_total_limit_max;
        var
            prefix_units_local: Integer;
            prefix_idx_local: Integer;
            prefix_probe_limit_local: Integer;
            append_idx_local: Integer;
            existing_idx_local: Integer;
            prefix_key_local: string;
            tail_key_local: string;
            prefix_text_local: string;
            prefix_results_local: TncCandidateList;
            prefix_candidate_local: TncCandidate;
        begin
            for prefix_units_local := 1 to expected_units - 1 do
            begin
                prefix_key_local := build_display_query_key(0,
                    prefix_units_local);
                tail_key_local := build_display_query_key(prefix_units_local,
                    expected_units - prefix_units_local);
                if (prefix_key_local = '') or (tail_key_local = '') then
                begin
                    Continue;
                end;

                if prefix_units_local = 1 then
                begin
                    if not lookup_display_complete_cached(prefix_key_local,
                        prefix_results_local) then
                    begin
                        Continue;
                    end;
                end
                else if not lookup_display_complete_cached(prefix_key_local,
                    prefix_results_local) then
                begin
                    Continue;
                end;

                if (prefix_units_local = 1) and (expected_units = 2) then
                begin
                    prefix_probe_limit_local := c_prefix_single_probe_limit;
                end
                else
                begin
                    prefix_probe_limit_local := c_prefix_phrase_probe_limit;
                end;
                for prefix_idx_local := 0 to High(prefix_results_local) do
                begin
                    if prefix_idx_local >= prefix_probe_limit_local then
                    begin
                        Break;
                    end;

                    prefix_text_local := Trim(
                        prefix_results_local[prefix_idx_local].text);
                    if (prefix_text_local = '') or
                        (Trim(prefix_results_local[prefix_idx_local].comment) <> '') or
                        (get_candidate_text_unit_count(prefix_text_local) <>
                        prefix_units_local) then
                    begin
                        Continue;
                    end;

                    existing_idx_local := find_existing_display_candidate_local(
                        prefix_text_local, tail_key_local);
                    if existing_idx_local >= 0 then
                    begin
                        Continue;
                    end;

                    prefix_candidate_keys.AddOrSetValue(
                        prefix_candidate_cache_key_local(prefix_text_local,
                        tail_key_local), True);

                    prefix_candidate_local :=
                        prefix_results_local[prefix_idx_local];
                    prefix_candidate_local.text := prefix_text_local;
                    prefix_candidate_local.comment := tail_key_local;
                    append_idx_local := Length(m_candidates);
                    SetLength(m_candidates, append_idx_local + 1);
                    m_candidates[append_idx_local] := prefix_candidate_local;
                    if Length(m_candidate_segment_paths) < Length(m_candidates) then
                    begin
                        SetLength(m_candidate_segment_paths,
                            Length(m_candidates));
                    end;
                    m_candidate_segment_paths[append_idx_local] := '';
                end;
            end;
        end;

        procedure append_predictive_pinyin_prefix_candidates_local;
        const
            c_predictive_probe_limit = 12;
        var
            prefix_idx_local: Integer;
            accepted_count_local: Integer;
            append_idx_local: Integer;
            existing_idx_local: Integer;
            prefix_text_local: string;
            prefix_units_local: Integer;
            prefix_candidate_local: TncCandidate;
        begin
            if not ensure_predictive_prefix_results_local then
            begin
                Exit;
            end;

            accepted_count_local := 0;
            for prefix_idx_local := 0 to High(predictive_prefix_results) do
            begin
                if accepted_count_local >= c_predictive_probe_limit then
                begin
                    Break;
                end;

                prefix_text_local := Trim(
                    predictive_prefix_results[prefix_idx_local].text);
                if (prefix_text_local = '') or
                    (Trim(predictive_prefix_results[prefix_idx_local].comment) <> '') or
                    exact_weights.ContainsKey(prefix_text_local) then
                begin
                    Continue;
                end;

                prefix_units_local :=
                    get_candidate_text_unit_count(prefix_text_local);
                if not predictive_prefix_units_allowed_local(prefix_units_local) then
                begin
                    Continue;
                end;

                predictive_prefix_texts.AddOrSetValue(prefix_text_local, True);
                existing_idx_local := find_existing_display_candidate_local(
                    prefix_text_local, '');
                if existing_idx_local >= 0 then
                begin
                    Continue;
                end;

                prefix_candidate_local := predictive_prefix_results[prefix_idx_local];
                prefix_candidate_local.text := prefix_text_local;
                prefix_candidate_local.comment := '';
                append_idx_local := Length(m_candidates);
                SetLength(m_candidates, append_idx_local + 1);
                m_candidates[append_idx_local] := prefix_candidate_local;
                Inc(accepted_count_local);
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths,
                        Length(m_candidates));
                end;
                m_candidate_segment_paths[append_idx_local] := '';
            end;
        end;

        procedure append_particle_tail_completion_candidates_local;
        const
            c_head_probe_limit = 8;
            c_particle_tail_min_head_score = 80;
            c_particle_tail_visible_bonus = 160;
            c_particle_tail_unit_bonus = 24;
            c_particle_tail_weak_bonus = 8;
        var
            head_key_local: string;
            tail_key_local: string;
            tail_text_local: string;
            head_units_local: Integer;
            head_results_local: TncCandidateList;
            head_idx_local: Integer;
            append_idx_local: Integer;
            existing_idx_local: Integer;
            generated_text_local: string;
            head_text_local: string;
            head_score_local: Integer;
            head_dict_weight_local: Integer;
            generated_candidate_local: TncCandidate;

            function derived_particle_tail_score_local(
                const base_score: Integer): Integer;
            begin
                Result := base_score;
                if Result < 0 then
                begin
                    Result := 0;
                end;
                if Result < c_particle_tail_min_head_score then
                begin
                    Inc(Result, c_particle_tail_weak_bonus);
                    Exit;
                end;

                Inc(Result, c_particle_tail_visible_bonus +
                    (head_units_local * c_particle_tail_unit_bonus));
            end;
        begin
            if (not try_get_short_particle_tail_query_parts(normalized_pinyin,
                tail_key_local, tail_text_local, head_key_local)) or
                (not SameText(tail_key_local, 'a')) then
            begin
                Exit;
            end;

            if head_key_local = '' then
            begin
                Exit;
            end;

            head_units_local :=
                get_effective_compact_pinyin_unit_count(head_key_local);
            if (head_units_local < 2) or (head_units_local > 3) or
                (not lookup_display_exact_cached(head_key_local,
                head_results_local)) then
            begin
                Exit;
            end;

            for head_idx_local := 0 to High(head_results_local) do
            begin
                if head_idx_local >= c_head_probe_limit then
                begin
                    Break;
                end;
                if Trim(head_results_local[head_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                head_text_local := Trim(head_results_local[head_idx_local].text);
                if (head_text_local = '') or
                    (get_candidate_text_unit_count(head_text_local) <>
                    head_units_local) or
                    SameText(Copy(head_text_local, Length(head_text_local), 1),
                    tail_text_local) then
                begin
                    Continue;
                end;

                generated_text_local := head_text_local + tail_text_local;
                if exact_weights.ContainsKey(generated_text_local) then
                begin
                    Continue;
                end;
                particle_tail_texts.AddOrSetValue(generated_text_local, True);
                existing_idx_local := find_existing_display_candidate_local(
                    generated_text_local, '');
                if existing_idx_local >= 0 then
                begin
                    Continue;
                end;

                head_score_local := head_results_local[head_idx_local].score;
                head_dict_weight_local := head_score_local;
                if head_results_local[head_idx_local].has_dict_weight and
                    (head_results_local[head_idx_local].dict_weight >
                    head_score_local) then
                begin
                    head_score_local :=
                        head_results_local[head_idx_local].dict_weight;
                    head_dict_weight_local :=
                        head_results_local[head_idx_local].dict_weight;
                end;
                if head_results_local[head_idx_local].source = cs_user then
                begin
                    Inc(head_score_local, c_user_score_bonus);
                end;

                FillChar(generated_candidate_local,
                    SizeOf(generated_candidate_local), 0);
                generated_candidate_local.text := generated_text_local;
                generated_candidate_local.comment := '';
                generated_candidate_local.source := cs_rule;
                generated_candidate_local.score :=
                    derived_particle_tail_score_local(head_score_local);
                generated_candidate_local.has_dict_weight := True;
                generated_candidate_local.dict_weight :=
                    head_dict_weight_local;

                append_idx_local := Length(m_candidates);
                SetLength(m_candidates, append_idx_local + 1);
                m_candidates[append_idx_local] := generated_candidate_local;
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths,
                        Length(m_candidates));
                end;
                m_candidate_segment_paths[append_idx_local] := '';
            end;
        end;

        function has_predictive_pinyin_prefix_candidate_local: Boolean;
        var
            prefix_idx_local: Integer;
            prefix_text_local: string;
        begin
            Result := False;
            if expected_units > 3 then
            begin
                Exit;
            end;

            if not ensure_predictive_prefix_results_local then
            begin
                Exit;
            end;

            for prefix_idx_local := 0 to High(predictive_prefix_results) do
            begin
                prefix_text_local := Trim(
                    predictive_prefix_results[prefix_idx_local].text);
                if (prefix_text_local <> '') and
                    (Trim(predictive_prefix_results[prefix_idx_local].comment) = '') and
                    predictive_prefix_units_allowed_local(
                    get_candidate_text_unit_count(prefix_text_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_query_prefix_exact_candidate_local: Boolean;
        var
            prefix_units_local: Integer;
            prefix_key_local: string;
            prefix_idx_local: Integer;
            prefix_text_local: string;
            prefix_results_local: TncCandidateList;
            fixed_head_pinyin_local: string;
            fixed_head_text_local: string;
            fixed_tail_key_local: string;
            fixed_tail_units_local: Integer;
        begin
            Result := False;
            // This is only a visibility fallback for a complete three-syllable
            // query such as nianqing/shi. Existing fixed-head and particle-tail
            // routes already provide stronger, purpose-built completions.
            if (expected_units <> 3) or
                (not is_full_pinyin_key(normalized_pinyin)) or
                has_particle_tail_lookup or
                ((Length(normalized_pinyin) > Length('dehao')) and
                SameText(Copy(normalized_pinyin,
                Length(normalized_pinyin) - Length('dehao') + 1,
                Length('dehao')), 'dehao')) or
                try_get_fixed_pronoun_tail_query_parts(normalized_pinyin,
                expected_units, fixed_head_pinyin_local,
                fixed_head_text_local, fixed_tail_key_local,
                fixed_tail_units_local) then
            begin
                Exit;
            end;

            for prefix_units_local := expected_units - 1 downto 2 do
            begin
                prefix_key_local := build_display_query_key(0,
                    prefix_units_local);
                if (prefix_key_local = '') or
                    (not lookup_display_complete_cached(prefix_key_local,
                    prefix_results_local)) then
                begin
                    Continue;
                end;

                for prefix_idx_local := 0 to High(prefix_results_local) do
                begin
                    prefix_text_local := Trim(
                        prefix_results_local[prefix_idx_local].text);
                    if (prefix_text_local <> '') and
                        (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                        (get_candidate_text_unit_count(prefix_text_local) =
                        prefix_units_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function has_particle_tail_completion_candidate_local: Boolean;
        const
            c_head_probe_limit = 8;
        var
            head_key_local: string;
            tail_key_local: string;
            tail_text_local: string;
            head_units_local: Integer;
            head_results_local: TncCandidateList;
            head_idx_local: Integer;
            head_text_local: string;
        begin
            Result := False;
            if (not try_get_short_particle_tail_query_parts(normalized_pinyin,
                tail_key_local, tail_text_local, head_key_local)) or
                (not SameText(tail_key_local, 'a')) then
            begin
                Exit;
            end;

            if head_key_local = '' then
            begin
                Exit;
            end;

            head_units_local :=
                get_effective_compact_pinyin_unit_count(head_key_local);
            if (head_units_local < 2) or (head_units_local > 3) or
                (not lookup_display_exact_cached(head_key_local,
                head_results_local)) then
            begin
                Exit;
            end;

            for head_idx_local := 0 to High(head_results_local) do
            begin
                if head_idx_local >= c_head_probe_limit then
                begin
                    Break;
                end;
                if Trim(head_results_local[head_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                head_text_local := Trim(head_results_local[head_idx_local].text);
                if (head_text_local <> '') and
                    (get_candidate_text_unit_count(head_text_local) =
                    head_units_local) and
                    (not SameText(Copy(head_text_local,
                    Length(head_text_local), 1), tail_text_local)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function candidate_is_actual_full_exact_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_value: string;
        begin
            Result := False;
            text_value := Trim(candidate_value.text);
            if (text_value = '') or (Trim(candidate_value.comment) <> '') or
                (get_candidate_text_unit_count(text_value) <> expected_units) or
                (m_dictionary = nil) then
            begin
                Exit;
            end;

            Result := m_dictionary.is_base_entry(normalized_pinyin, text_value) or
                m_dictionary.is_user_entry(normalized_pinyin, text_value);
        end;

        procedure add_rank_item_local(const candidate_value: TncCandidate;
            const path_text: string; const original_idx: Integer);
        var
            local_text: string;
            local_comment: string;
            local_units: Integer;
            local_comment_units: Integer;
            local_exact_weight: Integer;
            local_exact_user: Boolean;
            local_tail_key: string;
            local_full_complete: Boolean;
            local_direct_exact: Boolean;
            local_supported_exact_pair: Boolean;
            local_preserved_lm_prefix: Boolean;
            local_predictive_prefix: Boolean;
            local_lexicon_completion: Boolean;
            local_particle_tail_rule: Boolean;
            local_fuzzy_exact: Boolean;
            local_direct_exact_rank: Integer;
            local_transition_path: string;
            local_transition_evidence: Integer;
            local_transition_full_lm_lead: Integer;
            local_transition_suffix_lm_lead: Integer;

            function is_number_unit_local(const unit_value: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(unit_value) <> 1 then
                begin
                    Exit;
                end;

                case Ord(unit_value[1]) of
                    $4E00, $4E8C, $4E24, $4E09, $56DB, $4E94, $516D,
                    $4E03, $516B, $4E5D, $5341:
                        Result := True;
                end;
            end;

            function is_quantity_or_unit_tail_local(
                const unit_value: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(unit_value) <> 1 then
                begin
                    Exit;
                end;

                case Ord(unit_value[1]) of
                    $4E2A, $500B, $6B21, $6761, $689D, $5F20, $5F35,
                    $672C, $7247, $6B65, $8F6E, $8F2A, $56DE, $4E0B,
                    $9879, $9805, $5B57, $53F0, $81FA, $95F4, $9593,
                    $5957, $623F, $5385, $5EF3, $536B, $885B, $95E8,
                    $9580, $5B54, $5F00, $958B, $80A1, $9875, $9801,
                    $5E45, $526F, $5757, $584A, $6BDB, $5143, $4E07,
                    $680B, $68DF:
                        Result := True;
                end;
            end;

            function is_numeric_quantity_partial_noise_local: Boolean;
            var
                units_local: TArray<string>;
            begin
                Result := False;
                if (local_comment = '') or (local_units <> 2) or
                    (local_comment_units <> 1) or
                    is_full_pinyin_key(local_tail_key) then
                begin
                    Exit;
                end;

                units_local := split_text_units(local_text);
                if Length(units_local) <> 2 then
                begin
                    Exit;
                end;

                Result := is_number_unit_local(units_local[0]) and
                    is_quantity_or_unit_tail_local(units_local[1]);
            end;
        begin
            local_text := Trim(candidate_value.text);
            local_comment := Trim(candidate_value.comment);
            if local_text = '' then
            begin
                Exit;
            end;

            local_units := get_candidate_text_unit_count(local_text);
            local_tail_key := normalize_pinyin_text(local_comment);
            local_comment_units := 0;
            if local_tail_key <> '' then
            begin
                local_comment_units :=
                    get_effective_compact_pinyin_unit_count(local_tail_key);
            end;

            item.candidate := candidate_value;
            item.candidate.text := local_text;
            item.candidate.comment := local_comment;
            item.path := path_text;
            item.original_index := original_idx;
            item.text_length := Length(local_text);
            item.actual_full_exact := candidate_is_actual_full_exact_local(
                candidate_value);
            item.user_full_exact := False;
            item.decisive_transition_override := False;
            item.transition_evidence := 0;
            item.low_frequency_medical_exact := False;
            item.nocontext_exact_priority := 0;
            item.context_exact_priority := 0;
            item.prefix_units := 0;
            item.rank_score := display_candidate_effective_weight(
                candidate_value);
            item.category := 6;

            local_predictive_prefix :=
                predictive_prefix_texts.ContainsKey(local_text);
            local_lexicon_completion :=
                is_current_short_exact_lexicon_completion(normalized_pinyin,
                local_text);
            local_particle_tail_rule :=
                particle_tail_texts.ContainsKey(local_text);
            local_fuzzy_exact := is_fuzzy_pinyin_active and
                (candidate_value.fuzzy_cost > 0) and
                (local_comment = '') and (local_units = expected_units);
            local_full_complete := (local_comment = '') and
                ((local_units = expected_units) or
                local_particle_tail_rule or
                local_lexicon_completion or
                (local_predictive_prefix and
                predictive_prefix_units_allowed_local(local_units)));
            local_preserved_lm_prefix := (local_comment <> '') and
                m_last_lookup_incremental_partial_reuse and
                (candidate_value.source = cs_rule) and
                (candidate_value.display_kind = cdk_lm_compound) and
                (local_units >= 3) and
                (local_units + local_comment_units = expected_units);
            if local_full_complete then
            begin
                local_direct_exact := exact_weights.ContainsKey(local_text);
                local_supported_exact_pair :=
                    is_current_short_two_single_pair_candidate_supported(
                    normalized_pinyin, local_text) or
                    is_current_short_three_exact_pair_candidate_supported(
                    normalized_pinyin, local_text);
                local_exact_user := False;
                exact_is_user.TryGetValue(local_text, local_exact_user);
                if not local_exact_user then
                begin
                    local_exact_user := exact_candidate_is_user_local(
                        candidate_value, local_text);
                end;
                if local_exact_user then
                begin
                    item.low_frequency_medical_exact := False;
                end;
                item.user_full_exact := local_direct_exact and local_exact_user;

                if local_fuzzy_exact then
                begin
                    item.category := 2;
                    item.rank_score := display_candidate_effective_weight(
                        candidate_value);
                end
                else if local_supported_exact_pair then
                begin
                    local_transition_evidence :=
                        get_supported_pair_evidence_local(local_text,
                        local_transition_path);
                    item.transition_evidence := local_transition_evidence;
                    local_transition_full_lm_lead := 0;
                    local_transition_suffix_lm_lead := 0;
                    item.decisive_transition_override :=
                        (not has_user_exact) and
                        (local_transition_evidence >= 410) and
                        ((max_base_exact_competing_weight < 0) or
                        ((local_transition_evidence >=
                        max_base_exact_competing_weight + 96) and
                        transition_path_has_supported_function_head_local(
                        local_transition_path) and
                        transition_has_decisive_char_lm_lead_local(local_text,
                        max_base_exact_competing_text,
                        local_transition_full_lm_lead,
                        local_transition_suffix_lm_lead)));
                    if m_config.debug_mode then
                    begin
                        if m_last_lookup_debug_extra <> '' then
                        begin
                            m_last_lookup_debug_extra :=
                                m_last_lookup_debug_extra + ' ';
                        end;
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('sepair=%s:%d/%d/%d/%d/%d', [local_text,
                            local_transition_evidence,
                            max_base_exact_competing_weight,
                            local_transition_full_lm_lead,
                            local_transition_suffix_lm_lead,
                            Ord(item.decisive_transition_override)]);
                    end;
                    if item.decisive_transition_override then
                    begin
                        item.category := 1;
                        item.rank_score := local_transition_evidence;
                    end
                    else
                    begin
                        item.category := 2;
                        item.rank_score := display_candidate_effective_weight(
                            candidate_value);
                    end;
                end
                else if (local_predictive_prefix or local_lexicon_completion) and
                    (not local_direct_exact) then
                begin
                    item.category := 4;
                    item.prefix_units := local_units;
                    item.rank_score := short_exact_effective_weight_local(
                        candidate_value);
                end
                else if local_particle_tail_rule and (not local_direct_exact) then
                begin
                    item.category := 2;
                    item.rank_score := short_exact_effective_weight_local(
                        candidate_value);
                end
                else if (candidate_value.source = cs_user) and
                    (not local_exact_user) then
                begin
                    Exit;
                end;

                if (not local_predictive_prefix) and
                    (not local_lexicon_completion) and
                    (not local_particle_tail_rule) and
                    (not local_direct_exact) and
                    (not local_supported_exact_pair) and
                    (not local_fuzzy_exact) then
                begin
                    Exit;
                end;

                if local_direct_exact then
                begin
                    if (not local_exact_user) and
                        has_effective_short_context_local and
                        (m_dictionary <> nil) and
                        is_low_evidence_admin_place_alias_cached(
                        normalized_pinyin, local_text) then
                    begin
                        item.category := 4;
                        item.prefix_units := local_units;
                        item.rank_score := short_exact_effective_weight_local(
                            candidate_value);
                        local_direct_exact := False;
                    end;
                end;

                if local_direct_exact then
                begin
                    item.rank_score := short_complete_rank_score_local(
                        candidate_value, local_text, local_exact_user);
                    if exact_weights.TryGetValue(local_text, local_exact_weight) then
                    begin
                        item.low_frequency_medical_exact :=
                            has_effective_short_context_local and
                            (not local_exact_user) and
                            (local_exact_weight <=
                            c_low_frequency_medical_exact_weight) and
                            text_has_low_frequency_medical_unit_local(
                            local_text);
                        { Without context, base exact candidates retain raw
                          dictionary-weight order unless this exact pinyin/text
                          pair has durable user-choice evidence. }
                        local_direct_exact_rank := local_exact_weight;
                        if local_exact_user then
                        begin
                            Inc(local_direct_exact_rank,
                                query_choice_rank_bonus_local(local_text));
                            Inc(local_direct_exact_rank, c_user_score_bonus);
                        end;
                        if not local_exact_user then
                        begin
                            Inc(local_direct_exact_rank,
                                short_base_exact_dynamic_weight_local(
                                local_text));
                        end;
                        item.rank_score := local_direct_exact_rank;
                    end;

                    if local_exact_user then
                    begin
                        item.category := 0;
                        item.candidate.source := cs_user;
                        item.candidate.has_dict_weight := False;
                        item.candidate.dict_weight := 0;
                        Inc(item.rank_score, c_user_score_bonus);
                    end
                    else if candidate_value.source = cs_user then
                    begin
                        item.category := 2;
                    end
                    else
                    begin
                        item.category := 1;
                    end;
                end;
            end
            else if (local_comment <> '') and
                (local_units + local_comment_units = expected_units) and
                (local_preserved_lm_prefix or (local_units = 1) or
                prefix_candidate_keys.ContainsKey(
                prefix_candidate_cache_key_local(local_text, local_tail_key)) or
                prefix_candidate_matches_query_local(local_text, local_units,
                local_tail_key)) then
            begin
                if is_numeric_quantity_partial_noise_local then
                begin
                    Exit;
                end;

                if local_units >= 2 then
                begin
                    item.category := 3;
                end
                else
                begin
                    item.category := 5;
                end;
                item.prefix_units := local_units;
            end
            else if local_comment = '' then
            begin
                Exit;
            end
            else
            begin
                Exit;
            end;

            list.Add(item);
        end;

        procedure sort_short_exact_rank_items_local;
        begin
            list.Sort(TComparer<TShortExactRankItem>.Construct(
                function(const left, right: TShortExactRankItem): Integer
                begin
                    if left.user_full_exact <> right.user_full_exact then
                    begin
                        if left.user_full_exact then
                        begin
                            Exit(-1);
                        end;
                        Exit(1);
                    end;

                    if left.decisive_transition_override and
                        right.actual_full_exact then
                    begin
                        Exit(-1);
                    end;
                    if right.decisive_transition_override and
                        left.actual_full_exact then
                    begin
                        Exit(1);
                    end;

                    if left.actual_full_exact <> right.actual_full_exact then
                    begin
                        if left.actual_full_exact then
                        begin
                            Exit(-1);
                        end;
                        Exit(1);
                    end;

                    if (left.category >= 3) and (left.category <= 5) and
                        (right.category >= 3) and (right.category <= 5) then
                    begin
                        Result := right.prefix_units - left.prefix_units;
                        if Result <> 0 then
                        begin
                            Exit;
                        end;
                    end;

                    Result := left.category - right.category;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    if (left.low_frequency_medical_exact <>
                        right.low_frequency_medical_exact) then
                    begin
                        if left.low_frequency_medical_exact then
                        begin
                            Exit(1);
                        end;
                        Exit(-1);
                    end;

                    Result := right.context_exact_priority -
                        left.context_exact_priority;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    Result := right.nocontext_exact_priority -
                        left.nocontext_exact_priority;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    Result := right.rank_score - left.rank_score;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    Result := left.original_index - right.original_index;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    Result := left.text_length - right.text_length;
                    if Result <> 0 then
                    begin
                        Exit;
                    end;

                    Result := CompareText(left.candidate.text,
                        right.candidate.text);
                end));
        end;

        function apply_context_supported_pair_ranking_local: Boolean;
        const
            c_min_exact_competitors = 2;
            c_max_exact_competitors = 9;
            c_max_pair_competitors = 2;
            c_min_context_score = -6000;
        var
            context_local: string;
            context_units_local: TArray<string>;
            base_units_local, pair_units_local: TArray<string>;
            texts_local, ngrams_local: TArray<string>;
            indices_local, ngram_owners_local: TArray<Integer>;
            context_scores_local, neutral_scores_local: TArray<Integer>;
            attested_scores_local: TArray<Integer>;
            prefix_scores_local: TArray<Integer>;
            observed_local: TArray<Boolean>;
            list_idx_local, idx_local, pair_count_local, exact_count_local: Integer;
            best_idx_local, runner_score_local, ngram_idx_local: Integer;
            lead_local, context_gain_local: Int64;
            rank_item_local: TShortExactRankItem;
            pair_local: Boolean;
            base_prefix_local, pair_prefix_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or has_user_exact or
                (expected_units < 2) or (expected_units > 3) or
                (Length(syllables) <> expected_units) or
                (not is_full_pinyin_key(normalized_pinyin)) or
                is_fuzzy_pinyin_active or (list.Count < 2) or
                (not list[0].actual_full_exact) or
                (list[0].context_exact_priority > 0) then Exit;

            context_local := Trim(m_left_context);
            if Trim(m_segment_left_context) <> '' then
                context_local := Trim(m_segment_left_context)
            else if Trim(m_external_left_context) <> '' then
                context_local := Trim(m_external_left_context);
            context_local := context_model_tail(context_local);
            if context_local = '' then Exit;
            context_units_local := split_text_units(context_local);
            if Length(context_units_local) = 0 then Exit;

            pair_count_local := 0;
            exact_count_local := 0;
            for list_idx_local := 0 to list.Count - 1 do
            begin
                rank_item_local := list[list_idx_local];
                if (rank_item_local.candidate.comment <> '') or
                    (get_candidate_text_unit_count(rank_item_local.candidate.text) <>
                    expected_units) then Continue;
                pair_local := (rank_item_local.transition_evidence > 0) and
                    (rank_item_local.candidate.display_kind = cdk_lm_compound) and
                    (not rank_item_local.actual_full_exact);
                if not pair_local and not rank_item_local.actual_full_exact then
                    Continue;
                if query_choice_rank_bonus_local(rank_item_local.candidate.text) > 0 then
                    Exit;
                if pair_local then Inc(pair_count_local)
                else Inc(exact_count_local);
                if (pair_count_local > c_max_pair_competitors) or
                    (exact_count_local > c_max_exact_competitors) then Exit;

                idx_local := Length(texts_local);
                SetLength(texts_local, idx_local + 1);
                SetLength(indices_local, idx_local + 1);
                texts_local[idx_local] := rank_item_local.candidate.text;
                indices_local[idx_local] := list_idx_local;
                if pair_local then
                begin
                    ngram_idx_local := Length(ngrams_local);
                    SetLength(ngrams_local, ngram_idx_local + 1);
                    SetLength(ngram_owners_local, ngram_idx_local + 1);
                    ngrams_local[ngram_idx_local] :=
                        context_units_local[High(context_units_local)] +
                        rank_item_local.candidate.text;
                    ngram_owners_local[ngram_idx_local] := idx_local;
                    if (expected_units = 2) and (Length(context_units_local) > 1) then
                    begin
                        ngrams_local[ngram_idx_local] :=
                            context_units_local[High(context_units_local) - 1] +
                            ngrams_local[ngram_idx_local];
                    end;
                end;
            end;
            // A unique dictionary exact is not an ambiguous exact group. Leave
            // that decision to the trained rankers instead of a local LM margin.
            if (pair_count_local = 0) or
                (exact_count_local < c_min_exact_competitors) or
                (Length(indices_local) < 2) or (indices_local[0] <> 0) then Exit;

            // Admission is unchanged. A backoff guess or a blue display marker
            // alone cannot override an exact. Use the longest available context
            // window, not a shorter common function-word fragment as fallback.
            if (not m_dictionary.get_char_lm_attested_scores(ngrams_local,
                attested_scores_local)) or
                (Length(attested_scores_local) <> Length(ngrams_local)) then Exit;
            SetLength(observed_local, Length(texts_local));
            for idx_local := 0 to High(attested_scores_local) do
                if attested_scores_local[idx_local] >= c_min_context_score then
                    observed_local[ngram_owners_local[idx_local]] := True;
            if (not get_cached_char_lm_scores(texts_local, context_scores_local,
                clsm_short_context, context_local)) or
                (Length(context_scores_local) <> Length(texts_local)) then Exit;

            best_idx_local := 0;
            for idx_local := 0 to High(context_scores_local) do
            begin
                if context_scores_local[idx_local] = Low(Integer) then Exit;
                if context_scores_local[idx_local] > context_scores_local[best_idx_local] then
                    best_idx_local := idx_local;
            end;
            if (best_idx_local = 0) or (not observed_local[best_idx_local]) or
                (context_scores_local[best_idx_local] < c_min_context_score) then Exit;
            runner_score_local := Low(Integer);
            for idx_local := 0 to High(context_scores_local) do
                if idx_local <> best_idx_local then
                    runner_score_local := Max(runner_score_local, context_scores_local[idx_local]);
            lead_local := Int64(context_scores_local[best_idx_local]) - runner_score_local;
            if lead_local < c_decisive_transition_min_full_lm_lead then Exit;

            // A frequent tail must not compensate for making the first changed
            // prefix less compatible with the actual left context.
            base_units_local := split_text_units(texts_local[0]);
            pair_units_local := split_text_units(texts_local[best_idx_local]);
            base_prefix_local := '';
            pair_prefix_local := '';
            for idx_local := 0 to expected_units - 2 do
            begin
                base_prefix_local := base_prefix_local + base_units_local[idx_local];
                pair_prefix_local := pair_prefix_local + pair_units_local[idx_local];
                if base_units_local[idx_local] = pair_units_local[idx_local] then Continue;
                if (not get_cached_char_lm_scores(TArray<string>.Create(
                    base_prefix_local, pair_prefix_local), prefix_scores_local,
                    clsm_short_context, context_local)) or
                    (Length(prefix_scores_local) <> 2) or
                    (prefix_scores_local[0] = Low(Integer)) or
                    (prefix_scores_local[1] < prefix_scores_local[0]) then Exit;
                Break;
            end;

            // Context must add discriminating evidence, not just preserve a
            // phrase's context-free advantage. Reuse the ordinary scoring cache.
            if (not get_cached_char_lm_scores(TArray<string>.Create(texts_local[0],
                texts_local[best_idx_local]), neutral_scores_local,
                clsm_short_context, '')) or (Length(neutral_scores_local) <> 2) or
                (neutral_scores_local[0] = Low(Integer)) or
                (neutral_scores_local[1] = Low(Integer)) then Exit;
            context_gain_local := Int64(context_scores_local[best_idx_local]) -
                context_scores_local[0] -
                (Int64(neutral_scores_local[1]) - neutral_scores_local[0]);
            if context_gain_local < c_decisive_transition_min_suffix_lm_lead then Exit;

            rank_item_local := list[indices_local[best_idx_local]];
            rank_item_local.decisive_transition_override := True;
            rank_item_local.category := 1;
            list[indices_local[best_idx_local]] := rank_item_local;
            if m_config.debug_mode then
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format(' shortctxpair=%s:lead=%d/gain=%d',
                    [texts_local[best_idx_local], lead_local, context_gain_local]);
            Result := True;
        end;

        function apply_document_context_exact_reranker_local: Boolean;
        const
            c_document_exact_min_score = 280;
            c_document_exact_min_baseline_lead = 240;
            c_document_exact_min_runner_up_lead = 96;
            c_document_exact_max_candidates = 9;
        var
            candidate_idx_local: Integer;
            candidate_limit_local: Integer;
            candidate_score_local: Integer;
            baseline_score_local: Integer;
            best_idx_local: Integer;
            best_score_local: Integer;
            runner_up_score_local: Integer;
            rank_item_local: TShortExactRankItem;
        begin
            Result := False;
            if (m_document_context_model = nil) or
                (not m_document_context_model.has_context) or
                (list.Count < 2) or list[0].user_full_exact then
            begin
                Exit;
            end;

            baseline_score_local := m_document_context_model.score_text(
                list[0].candidate.text);
            best_idx_local := 0;
            best_score_local := baseline_score_local;
            runner_up_score_local := Low(Integer);
            candidate_limit_local := Min(list.Count,
                c_document_exact_max_candidates);
            for candidate_idx_local := 1 to candidate_limit_local - 1 do
            begin
                rank_item_local := list[candidate_idx_local];
                if (rank_item_local.category <> 1) or
                    (not rank_item_local.actual_full_exact) or
                    rank_item_local.user_full_exact or
                    rank_item_local.low_frequency_medical_exact then
                begin
                    Continue;
                end;
                candidate_score_local :=
                    m_document_context_model.score_text(
                    rank_item_local.candidate.text);
                if candidate_score_local > best_score_local then
                begin
                    runner_up_score_local := best_score_local;
                    best_score_local := candidate_score_local;
                    best_idx_local := candidate_idx_local;
                end
                else if candidate_score_local > runner_up_score_local then
                begin
                    runner_up_score_local := candidate_score_local;
                end;
            end;

            if (best_idx_local <= 0) or
                (best_score_local < c_document_exact_min_score) or
                (best_score_local - baseline_score_local <
                c_document_exact_min_baseline_lead) or
                ((runner_up_score_local <> Low(Integer)) and
                (best_score_local - runner_up_score_local <
                c_document_exact_min_runner_up_lead)) then
            begin
                Exit;
            end;

            rank_item_local := list[best_idx_local];
            rank_item_local.context_exact_priority := Max(
                rank_item_local.context_exact_priority, 4);
            list[best_idx_local] := rank_item_local;
            Result := True;
        end;

        procedure mix_single_syllable_fuzzy_exacts_local;
        var
            raw_items, fuzzy_items, tail_items: TList<TShortExactRankItem>;
            rank_item: TShortExactRankItem;
            item_idx, raw_idx, fuzzy_idx: Integer;
        begin
            if (expected_units <> 1) or (not is_fuzzy_pinyin_active) or
                (not has_fuzzy_exact_lookup) then Exit;

            raw_items := TList<TShortExactRankItem>.Create;
            fuzzy_items := TList<TShortExactRankItem>.Create;
            tail_items := TList<TShortExactRankItem>.Create;
            try
                for item_idx := 0 to list.Count - 1 do
                begin
                    rank_item := list[item_idx];
                    if rank_item.actual_full_exact and
                        (rank_item.candidate.fuzzy_cost = 0) then
                        raw_items.Add(rank_item)
                    else if (rank_item.candidate.fuzzy_cost > 0) and
                        (Trim(rank_item.candidate.comment) = '') and
                        (get_candidate_text_unit_count(rank_item.candidate.text) = 1) then
                    begin
                        { Rescale only the display penalty; keep the independent
                          fuzzy-choice bonus and the lattice score unchanged. }
                        rank_item.rank_score := rank_item.candidate.score +
                            rank_item.candidate.fuzzy_cost *
                            (c_fuzzy_lookup_penalty_per_cost -
                            c_fuzzy_single_display_penalty_per_cost);
                        fuzzy_items.Add(rank_item);
                    end
                    else
                        tail_items.Add(rank_item);
                end;
                if fuzzy_items.Count = 0 then Exit;

                fuzzy_items.Sort(TComparer<TShortExactRankItem>.Construct(
                    function(const left, right: TShortExactRankItem): Integer
                    begin
                        Result := CompareValue(right.rank_score, left.rank_score);
                        if Result = 0 then
                            Result := left.original_index - right.original_index;
                    end));

                list.Clear;
                raw_idx := 0;
                { User exacts and the leading raw base exact remain protected.
                  Merge the rest without changing their relative order. }
                while (raw_idx < raw_items.Count) and
                    raw_items[raw_idx].user_full_exact do
                begin
                    list.Add(raw_items[raw_idx]);
                    Inc(raw_idx);
                end;
                if raw_idx < raw_items.Count then
                begin
                    list.Add(raw_items[raw_idx]);
                    Inc(raw_idx);
                end;
                fuzzy_idx := 0;
                while (raw_idx < raw_items.Count) or
                    (fuzzy_idx < fuzzy_items.Count) do
                begin
                    if (raw_idx < raw_items.Count) and
                        ((fuzzy_idx >= fuzzy_items.Count) or
                        (raw_items[raw_idx].rank_score >=
                        fuzzy_items[fuzzy_idx].rank_score)) then
                    begin
                        list.Add(raw_items[raw_idx]);
                        Inc(raw_idx);
                    end
                    else
                    begin
                        list.Add(fuzzy_items[fuzzy_idx]);
                        Inc(fuzzy_idx);
                    end;
                end;
                list.AddRange(tail_items);
            finally
                tail_items.Free;
                fuzzy_items.Free;
                raw_items.Free;
            end;
        end;

        procedure ensure_prefix_visible_on_first_page_local;
        var
            visible_limit_local: Integer;
            visible_idx_local: Integer;
            insert_idx_local: Integer;
            exact_count_local: Integer;
            prefix_item_local: TShortExactRankItem;
        begin
            visible_limit_local := get_candidate_limit;
            if (visible_limit_local <= 0) or (list.Count <= visible_limit_local) then
            begin
                Exit;
            end;

            exact_count_local := 0;
            while (exact_count_local < list.Count) and
                (list[exact_count_local].category <= 2) do
            begin
                Inc(exact_count_local);
            end;
            if exact_count_local >= visible_limit_local then
            begin
                Exit;
            end;

            for visible_idx_local := 0 to visible_limit_local - 1 do
            begin
                if (list[visible_idx_local].category = 3) or
                    (list[visible_idx_local].category = 4) or
                    (list[visible_idx_local].category = 5) then
                begin
                    Exit;
                end;
            end;

            for visible_idx_local := visible_limit_local to list.Count - 1 do
            begin
                if (list[visible_idx_local].category <> 3) and
                    (list[visible_idx_local].category <> 4) and
                    (list[visible_idx_local].category <> 5) then
                begin
                    Continue;
                end;

                prefix_item_local := list[visible_idx_local];
                list.Delete(visible_idx_local);
                insert_idx_local := visible_limit_local - 1;
                if insert_idx_local < exact_count_local then
                begin
                    insert_idx_local := exact_count_local;
                end;
                if insert_idx_local < 0 then
                begin
                    insert_idx_local := 0;
                end;
                list.Insert(insert_idx_local, prefix_item_local);
                Exit;
            end;
        end;

        procedure append_missing_supported_pair_candidates_local;
        var
            pair_texts_local: TArray<string>;
            pair_idx_local: Integer;
            candidate_idx_local: Integer;
            append_idx_local: Integer;
            pair_text_local: string;
            pair_path_local: string;
            pair_evidence_local: Integer;
            already_present_local: Boolean;
        begin
            SetLength(pair_texts_local, 0);
            if SameText(normalized_pinyin, m_short_two_single_pair_query) then
            begin
                pair_texts_local := Copy(m_short_two_single_pair_texts, 0,
                    Length(m_short_two_single_pair_texts));
            end;
            if SameText(normalized_pinyin, m_short_three_exact_pair_query) then
            begin
                pair_texts_local := Copy(m_short_three_exact_pair_texts, 0,
                    Length(m_short_three_exact_pair_texts));
            end;

            for pair_idx_local := 0 to High(pair_texts_local) do
            begin
                pair_text_local := Trim(pair_texts_local[pair_idx_local]);
                if pair_text_local = '' then
                begin
                    Continue;
                end;

                already_present_local := False;
                for candidate_idx_local := 0 to High(m_candidates) do
                begin
                    if (Trim(m_candidates[candidate_idx_local].comment) = '') and
                        SameText(Trim(m_candidates[candidate_idx_local].text),
                        pair_text_local) then
                    begin
                        already_present_local := True;
                        Break;
                    end;
                end;
                if already_present_local then
                begin
                    Continue;
                end;

                pair_evidence_local := get_supported_pair_evidence_local(
                    pair_text_local, pair_path_local);
                if (pair_evidence_local <= 0) or (pair_path_local = '') then
                begin
                    Continue;
                end;

                append_idx_local := Length(m_candidates);
                SetLength(m_candidates, append_idx_local + 1);
                SetLength(m_candidate_segment_paths, append_idx_local + 1);
                m_candidates[append_idx_local] := Default(TncCandidate);
                m_candidates[append_idx_local].text := pair_text_local;
                m_candidates[append_idx_local].comment := '';
                m_candidates[append_idx_local].score := 16000 +
                    pair_evidence_local;
                m_candidates[append_idx_local].source := cs_rule;
                m_candidates[append_idx_local].has_dict_weight := False;
                m_candidates[append_idx_local].dict_weight := 0;
                m_candidates[append_idx_local].display_kind := cdk_lm_compound;
                m_candidate_segment_paths[append_idx_local] := pair_path_local;
            end;
        end;

        function confirmed_prefix_allows_short_exact_local: Boolean;
        const
            c_min_confirmed_tail_single_count = 12;
        var
            first_key_local: string;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            single_count_local: Integer;
            prefix_text_local: string;
        begin
            Result := True;
            if (Trim(m_confirmed_text) = '') and
                ((m_confirmed_segments = nil) or (m_confirmed_segments.Count = 0)) then
            begin
                Exit;
            end;

            if is_fuzzy_pinyin_active and (expected_units = 1) and
                (m_last_lookup_syllable_count = 1) then
            begin
                Exit(True);
            end;

            Result := False;
            if expected_units <> 2 then
            begin
                Exit;
            end;

            first_key_local := build_display_query_key(0, 1);
            if (first_key_local = '') or
                (not lookup_display_complete_cached(first_key_local,
                prefix_results_local)) then
            begin
                Exit;
            end;

            single_count_local := 0;
            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                prefix_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                if (prefix_text_local <> '') and
                    (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(prefix_text_local) = 1) then
                begin
                    Inc(single_count_local);
                    if single_count_local >= c_min_confirmed_tail_single_count then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (expected_units < 1) or (expected_units > c_max_user_exact_units) or
            (not confirmed_prefix_allows_short_exact_local) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_key) > 0) or
            (Pos('''', m_last_lookup_normalized_from) > 0) then
        begin
            Exit;
        end;

        short_exact_phase_start := GetTickCount64;
        predictive_prefix_results_loaded := False;
        pair_evidence_loaded := False;
        SetLength(pair_evidence_results, 0);
        max_base_exact_competing_weight := -1;
        max_base_exact_competing_text := '';
        SetLength(predictive_prefix_results, 0);
        has_closed_particle_candidate :=
            try_get_closed_particle_combo_candidate_local(
            closed_particle_candidate);
        note_short_exact_phase_local('closed');
        has_exact_lookup := lookup_display_exact_cached(normalized_pinyin,
            exact_results);
        if not has_exact_lookup then
        begin
            SetLength(exact_results, 0);
        end;
        has_fuzzy_exact_lookup := False;
        SetLength(fuzzy_exact_results, 0);
        if m_config.fuzzy_pinyin_enabled and
            (m_config.fuzzy_pinyin_rules <> []) and (m_dictionary <> nil) then
        begin
            if is_shuangpin_input then
            begin
                has_fuzzy_exact_lookup :=
                    m_dictionary.lookup_fuzzy_full_pinyin(normalized_pinyin,
                    fuzzy_exact_results);
            end
            else
            begin
                has_fuzzy_exact_lookup :=
                    m_dictionary.lookup_fuzzy_full_pinyin(
                    get_display_raw_query_text_local, fuzzy_exact_results);
            end;
            if has_fuzzy_exact_lookup then
            begin
                m_candidates := merge_candidate_lists(m_candidates,
                    fuzzy_exact_results, 0);
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths, Length(m_candidates));
                end;
            end;
        end;
        note_short_exact_phase_local('exact');
        has_predictive_prefix_lookup :=
            has_predictive_pinyin_prefix_candidate_local;
        note_short_exact_phase_local('pred');
        has_particle_tail_lookup :=
            has_particle_tail_completion_candidate_local;
        note_short_exact_phase_local('tail');
        has_query_prefix_lookup := has_query_prefix_exact_candidate_local;
        short_exact_predictive_prefix_only_mode := False;
        if (not has_exact_lookup) and (not has_fuzzy_exact_lookup) and
            (not has_closed_particle_candidate) and
            (not has_predictive_prefix_lookup) and
            (not has_particle_tail_lookup) and
            (not has_query_prefix_lookup) then
        begin
            Exit;
        end;

            exact_weights := TDictionary<string, Integer>.Create;
            exact_is_user := TDictionary<string, Boolean>.Create;
            exact_candidates := TDictionary<string, TncCandidate>.Create;
            prefix_candidate_keys := TDictionary<string, Boolean>.Create;
            predictive_prefix_texts := TDictionary<string, Boolean>.Create;
            particle_tail_texts := TDictionary<string, Boolean>.Create;
            list := TList<TShortExactRankItem>.Create;
            try
                has_user_exact := False;
                if has_closed_particle_candidate then
                begin
                    exact_text := Trim(closed_particle_candidate.text);
                    exact_weight := closed_particle_candidate.dict_weight;
                    exact_weights.AddOrSetValue(exact_text, exact_weight);
                    exact_candidates.AddOrSetValue(exact_text,
                        closed_particle_candidate);
                    exact_is_user.AddOrSetValue(exact_text, False);
                end;
                for exact_idx := 0 to High(exact_results) do
            begin
                exact_text := Trim(exact_results[exact_idx].text);
                if (exact_text = '') or (Trim(exact_results[exact_idx].comment) <> '') or
                    (get_candidate_text_unit_count(exact_text) <>
                    expected_units) then
                begin
                    Continue;
                end;

                if not exact_candidate_is_reliable_complete_local(
                    exact_results[exact_idx], exact_text) then
                begin
                    Continue;
                end;

                exact_weight := exact_results[exact_idx].score;
                if is_full_pinyin_key(normalized_pinyin) and
                    exact_results[exact_idx].has_dict_weight then
                begin
                    exact_weight := exact_results[exact_idx].dict_weight;
                end;
                if not exact_candidate_is_user_local(exact_results[exact_idx],
                    exact_text) then
                begin
                    existing_weight := exact_weight +
                        short_base_exact_dynamic_weight_local(exact_text);
                    if existing_weight > max_base_exact_competing_weight then
                    begin
                        max_base_exact_competing_weight := existing_weight;
                        max_base_exact_competing_text := exact_text;
                    end;
                end;
                existing_weight := Low(Integer);
                exact_weights.TryGetValue(exact_text, existing_weight);
                if (not exact_weights.ContainsKey(exact_text)) or
                    (exact_weight > existing_weight) then
                begin
                    exact_weights.AddOrSetValue(exact_text, exact_weight);
                    candidate_item := exact_results[exact_idx];
                    candidate_item.text := exact_text;
                    candidate_item.comment := '';
                    exact_candidates.AddOrSetValue(exact_text, candidate_item);
                end;

                existing_is_user := False;
                exact_is_user.TryGetValue(exact_text, existing_is_user);
                if exact_candidate_is_user_local(exact_results[exact_idx],
                    exact_text) then
                begin
                    exact_is_user.AddOrSetValue(exact_text, True);
                    has_user_exact := True;
                end
                else if not existing_is_user then
                begin
                    exact_is_user.AddOrSetValue(exact_text, False);
                end;
            end;
            note_short_exact_phase_local('collect');
            short_exact_predictive_prefix_only_mode :=
                (not is_full_pinyin_key(normalized_pinyin)) and
                has_predictive_prefix_lookup and
                (not has_closed_particle_candidate) and
                (not has_particle_tail_lookup);

            if ((exact_weights.Count = 0) and
                (not has_fuzzy_exact_lookup) and
                (not has_predictive_prefix_lookup) and
                (not has_particle_tail_lookup) and
                (not has_query_prefix_lookup)) or
                ((expected_units > c_max_base_exact_units) and
                (not has_user_exact)) then
            begin
                Exit;
            end;

            append_missing_exact_candidates_local;
            append_particle_tail_completion_candidates_local;
            append_query_prefix_candidates_local;
            append_predictive_pinyin_prefix_candidates_local;
            append_missing_supported_pair_candidates_local;
            note_short_exact_phase_local('append');

            for idx := 0 to High(m_candidates) do
            begin
                if short_exact_predictive_prefix_only_mode and
                    (idx >= c_default_page_size * 10) and
                    (not predictive_prefix_texts.ContainsKey(
                    Trim(m_candidates[idx].text))) then
                begin
                    Continue;
                end;

                path_value := '';
                if idx < Length(m_candidate_segment_paths) then
                begin
                    path_value := m_candidate_segment_paths[idx];
                end;
                add_rank_item_local(m_candidates[idx], path_value, idx);
            end;
            note_short_exact_phase_local('rank');

            sort_short_exact_rank_items_local;
            note_short_exact_phase_local('sort');
            { Keep dictionary weight as the baseline, then allow the dedicated
              residual model to correct high-confidence no-context errors. }
            apply_short_nocontext_reranker_local;
            if short_nocontext_promoted_exact_text <> '' then
            begin
                sort_short_exact_rank_items_local;
            end;
            note_short_exact_phase_local('nocontext');
            apply_short_context_reranker_local;
            if short_context_promoted_exact_text <> '' then
            begin
                sort_short_exact_rank_items_local;
            end;
            note_short_exact_phase_local('context');
            if apply_document_context_exact_reranker_local then
            begin
                sort_short_exact_rank_items_local;
            end;
            note_short_exact_phase_local('document');
            if apply_context_supported_pair_ranking_local then
            begin
                sort_short_exact_rank_items_local;
            end;
            note_short_exact_phase_local('contextpair');
            mix_single_syllable_fuzzy_exacts_local;
            ensure_prefix_visible_on_first_page_local;
            note_short_exact_phase_local('visible');
            if short_exact_predictive_prefix_only_mode then
            begin
                while list.Count > c_default_page_size * 10 do
                begin
                    list.Delete(list.Count - 1);
                end;
            end;

            SetLength(m_candidates, list.Count);
            SetLength(m_candidate_segment_paths, list.Count);
            for idx := 0 to list.Count - 1 do
            begin
                m_candidates[idx] := list[idx].candidate;
                m_candidate_segment_paths[idx] := list[idx].path;
            end;

            if m_config.debug_mode and (list.Count > 0) then
            begin
                if m_last_lookup_debug_extra <> '' then
                begin
                    m_last_lookup_debug_extra :=
                        m_last_lookup_debug_extra + ' ';
                end;
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    Format('seranktop=%s/%d/%d/%d',
                    [Trim(list[0].candidate.text), list[0].category,
                    Ord(list[0].actual_full_exact),
                    Ord(list[0].decisive_transition_override)]);
            end;

            if m_config.debug_mode then
            begin
                if m_last_lookup_debug_extra <> '' then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
                end;
                m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                    'shortexact=1';
                if short_nocontext_promoted_exact_text <> '' then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                        Format(' shortnoctx=%s:%d',
                        [short_nocontext_promoted_exact_text,
                        short_nocontext_promoted_exact_lead]);
                end;
                if short_context_promoted_exact_text <> '' then
                begin
                    m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                        Format(' shortctx=%s:%d',
                        [short_context_promoted_exact_text,
                        short_context_promoted_exact_lead]);
                end;
            end;

            Result := True;
        finally
            particle_tail_texts.Free;
            predictive_prefix_texts.Free;
            prefix_candidate_keys.Free;
            list.Free;
            exact_candidates.Free;
            exact_is_user.Free;
            exact_weights.Free;
        end;
    end;

    function should_keep_display_top_before_candidate(
        const candidate_value: TncCandidate): Boolean;
    const
        c_pathful_top_min_gap = 2400;
    var
        top_text_local: string;
        top_path_local: string;
        top_weight_local: Integer;
        candidate_weight_local: Integer;
        candidate_text_local: string;
        top_exact_weight_local: Integer;
        candidate_exact_weight_local: Integer;
        top_query_choice_bonus_local: Integer;
        candidate_query_choice_bonus_local: Integer;

        function fixed_tail_alignment_score_local(
            const candidate_local: TncCandidate): Integer;
        var
            candidate_units_local: TArray<string>;
            tail_key_local: string;
            expected_tail_text_local: string;
        begin
            Result := 0;
            if (expected_units < 3) or (Length(syllables) <> expected_units) or
                (Trim(candidate_local.comment) <> '') or
                (get_candidate_text_unit_count(Trim(candidate_local.text)) <>
                expected_units) then
            begin
                Exit;
            end;

            tail_key_local := normalize_pinyin_text(
                syllables[expected_units - 1].text);
            expected_tail_text_local := '';
            if tail_key_local = 'yi' then
            begin
                expected_tail_text_local := string(Char($4E00));
            end
            else if tail_key_local = 'ba' then
            begin
                expected_tail_text_local := string(Char($5427));
            end
            else if tail_key_local = 'ma' then
            begin
                expected_tail_text_local := string(Char($5417));
            end
            else if tail_key_local = 'le' then
            begin
                expected_tail_text_local := string(Char($4E86));
            end
            else if tail_key_local = 'zhe' then
            begin
                expected_tail_text_local := string(Char($7740));
            end
            else if tail_key_local = 'de' then
            begin
                expected_tail_text_local := string(Char($7684));
            end
            else if tail_key_local = 'he' then
            begin
                expected_tail_text_local := string(Char($548C));
            end
            else if tail_key_local = 'wo' then
            begin
                expected_tail_text_local := string(Char($6211));
            end;
            if expected_tail_text_local = '' then
            begin
                Exit;
            end;

            candidate_units_local := split_text_units(Trim(candidate_local.text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;
            if SameText(Trim(candidate_units_local[expected_units - 1]),
                expected_tail_text_local) then
            begin
                Result := 1;
            end
            else
            begin
                Result := -1;
            end;
        end;
    begin
        Result := False;
        if (Length(m_candidates) = 0) or (expected_units < 2) then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        if (top_text_local = '') or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) or
            SameText(top_text_local, Trim(candidate_value.text)) then
        begin
            Exit;
        end;

        candidate_text_local := Trim(candidate_value.text);
        if (candidate_value.source = cs_user) or
            is_latest_session_query_choice(candidate_text_local) or
            (get_context_query_latest_bonus(candidate_text_local) > 0) then
        begin
            Exit;
        end;

        top_path_local := '';
        if Length(m_candidate_segment_paths) > 0 then
        begin
            top_path_local := m_candidate_segment_paths[0];
        end;
        if top_path_local = '' then
        begin
            top_path_local := get_segment_path_for_candidate(m_candidates[0], 0);
        end;
        if get_candidate_text_unit_count(candidate_text_local) = expected_units then
        begin
            if (m_dictionary <> nil) and (normalized_pinyin <> '') then
            begin
                candidate_query_choice_bonus_local :=
                    m_dictionary.get_query_choice_bonus(normalized_pinyin,
                    candidate_text_local);
                top_query_choice_bonus_local :=
                    m_dictionary.get_query_choice_bonus(normalized_pinyin,
                    top_text_local);
                if candidate_query_choice_bonus_local >
                    top_query_choice_bonus_local then
                begin
                    Exit(False);
                end;
            end;
            if (normalized_pinyin <> '') and
                display_exact_key_has_text(normalized_pinyin,
                candidate_text_local) and
                display_exact_key_has_text(normalized_pinyin,
                top_text_local) and
                get_display_exact_text_weight(normalized_pinyin,
                candidate_text_local, expected_units,
                candidate_exact_weight_local) and
                get_display_exact_text_weight(normalized_pinyin,
                top_text_local, expected_units, top_exact_weight_local) then
            begin
                Exit(top_exact_weight_local > candidate_exact_weight_local);
            end;
            if (fixed_tail_alignment_score_local(candidate_value) > 0) and
                (fixed_tail_alignment_score_local(m_candidates[0]) < 0) then
            begin
                Exit(False);
            end;
            if (normalized_pinyin <> '') and
                display_candidate_has_supported_full_entry(normalized_pinyin,
                candidate_value) and
                (not display_candidate_has_supported_full_entry(
                normalized_pinyin, m_candidates[0])) then
            begin
                Exit(False);
            end;
            if (normalized_pinyin <> '') and
                display_exact_key_has_text(normalized_pinyin,
                candidate_text_local) and
                (not display_exact_key_has_text(normalized_pinyin,
                top_text_local)) then
            begin
                Exit(False);
            end;
            Exit(True);
        end;

        if get_encoded_path_segment_count_local(top_path_local) <= 1 then
        begin
            Exit;
        end;

        top_weight_local := display_candidate_effective_weight(m_candidates[0]);
        candidate_weight_local := display_candidate_effective_weight(
            candidate_value);
        Result := top_weight_local >= candidate_weight_local +
            c_pathful_top_min_gap;
    end;

    procedure normalize_display_full_query_exact_candidate_order;
    const
        c_visible_probe_limit = 24;
        c_latest_session_exact_rank_bonus = 200000000;
        c_context_exact_rank_bonus = 100000000;
        c_query_choice_exact_rank_bonus = 50000000;
        c_query_choice_exact_rank_scale = 1000;
    type
        TExactDisplayItem = record
            candidate: TncCandidate;
            path: string;
            rank: Integer;
        end;
    var
        slot_indices: TArray<Integer>;
        items: TArray<TExactDisplayItem>;
        probe_idx: Integer;
        item_count: Integer;
        insert_idx: Integer;
        temp_item: TExactDisplayItem;

        function try_get_full_query_exact_display_rank(
            const candidate_value: TncCandidate; out out_rank: Integer): Boolean;
        var
            candidate_text_local: string;
            exact_weight_local: Integer;
            query_choice_bonus_local: Integer;
            context_bonus_local: Integer;
        begin
            Result := False;
            out_rank := Low(Integer);

            candidate_text_local := Trim(candidate_value.text);
            if (normalized_pinyin = '') or (candidate_text_local = '') or
                (Trim(candidate_value.comment) <> '') or
                (expected_units < 2) or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units) or
                (not get_display_exact_text_weight(normalized_pinyin,
                candidate_text_local, expected_units, exact_weight_local)) then
            begin
                Exit;
            end;

            // Use the exact-query dictionary weight as the baseline.  A weak
            // user/runtime exact entry must not inherit the generic user source
            // bonus here; only explicit query-choice learning may lift it.
            out_rank := exact_weight_local;

            if is_latest_session_query_choice(candidate_text_local) then
            begin
                Inc(out_rank, c_latest_session_exact_rank_bonus);
            end;

            context_bonus_local := get_context_query_latest_bonus(
                candidate_text_local);
            if context_bonus_local > 0 then
            begin
                Inc(out_rank, c_context_exact_rank_bonus +
                    (context_bonus_local * c_query_choice_exact_rank_scale));
            end;

            if m_dictionary <> nil then
            begin
                query_choice_bonus_local := m_dictionary.get_query_choice_bonus(
                    normalized_pinyin, candidate_text_local);
                if query_choice_bonus_local > 0 then
                begin
                    Inc(out_rank, c_query_choice_exact_rank_bonus +
                        (query_choice_bonus_local *
                        c_query_choice_exact_rank_scale));
                end;
            end;

            Result := True;
        end;
    begin
        if (Length(m_candidates) < 2) or (normalized_pinyin = '') or
            (expected_units < 2) then
        begin
            Exit;
        end;

        item_count := 0;
        for probe_idx := 0 to Min(c_visible_probe_limit - 1,
            High(m_candidates)) do
        begin
            SetLength(slot_indices, item_count + 1);
            SetLength(items, item_count + 1);
            if not try_get_full_query_exact_display_rank(m_candidates[probe_idx],
                items[item_count].rank) then
            begin
                SetLength(slot_indices, item_count);
                SetLength(items, item_count);
                Continue;
            end;

            slot_indices[item_count] := probe_idx;
            items[item_count].candidate := m_candidates[probe_idx];
            if probe_idx < Length(m_candidate_segment_paths) then
            begin
                items[item_count].path := m_candidate_segment_paths[probe_idx];
            end
            else
            begin
                items[item_count].path := '';
            end;
            Inc(item_count);
        end;

        if item_count < 2 then
        begin
            Exit;
        end;

        // The display pipeline has many local promote/restore steps.  This
        // final stable pass makes full-query exact dictionary entries obey the
        // same quality order regardless of which local step inserted them.
        for probe_idx := 1 to item_count - 1 do
        begin
            temp_item := items[probe_idx];
            insert_idx := probe_idx - 1;
            while (insert_idx >= 0) and
                (items[insert_idx].rank < temp_item.rank) do
            begin
                items[insert_idx + 1] := items[insert_idx];
                Dec(insert_idx);
            end;
            items[insert_idx + 1] := temp_item;
        end;

        for probe_idx := 0 to item_count - 1 do
        begin
            m_candidates[slot_indices[probe_idx]] := items[probe_idx].candidate;
            if slot_indices[probe_idx] < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[slot_indices[probe_idx]] :=
                    items[probe_idx].path;
            end;
        end;
    end;

    procedure insert_display_candidate(const candidate_value: TncCandidate;
        const path_value: string; const target_idx: Integer);
    var
        idx: Integer;
        insert_idx: Integer;
        candidate_count: Integer;
    begin
        if (umlaut_raw_prefix_units(candidate_value) = 0) and
            display_candidate_is_unsupported_short_four_ab_cd_complete(candidate_value) then
        begin
            Exit;
        end;
        if (umlaut_raw_prefix_units(candidate_value) = 0) and
            display_candidate_is_unsupported_short_four_ab_c_partial(candidate_value) then
        begin
            Exit;
        end;

        candidate_count := Length(m_candidates);
        insert_idx := Max(0, Min(target_idx, candidate_count));
        if (insert_idx = 0) and
            should_keep_display_top_before_candidate(candidate_value) then
        begin
            insert_idx := Min(1, candidate_count);
        end;
        SetLength(m_candidates, candidate_count + 1);
        if Length(m_candidate_segment_paths) < candidate_count + 1 then
        begin
            SetLength(m_candidate_segment_paths, candidate_count + 1);
        end;
        for idx := candidate_count downto insert_idx + 1 do
        begin
            m_candidates[idx] := m_candidates[idx - 1];
            if idx < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[idx] := m_candidate_segment_paths[idx - 1];
            end;
        end;
        m_candidates[insert_idx] := candidate_value;
        if insert_idx < Length(m_candidate_segment_paths) then
        begin
            m_candidate_segment_paths[insert_idx] := path_value;
        end;
    end;

    function find_display_candidate(const text_value: string;
        const comment_value: string): Integer;
    var
        idx: Integer;
    begin
        Result := -1;
        for idx := 0 to High(m_candidates) do
        begin
            if SameText(Trim(m_candidates[idx].text), text_value) and
                SameText(Trim(m_candidates[idx].comment), comment_value) then
            begin
                Exit(idx);
            end;
        end;
    end;

