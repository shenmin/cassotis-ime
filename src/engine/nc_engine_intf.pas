procedure TncEngine.reset_debug_target_recall_metrics;
begin
    m_debug_target_final_state_found := False;
    m_debug_target_final_state_rank := 0;
    m_debug_target_final_state_count := 0;
    m_debug_target_max_generated_syllable := 0;
