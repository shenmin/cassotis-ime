procedure TncEngine.refresh_candidate_segment_paths;
var
    idx: Integer;
    key: string;
    in_idx: Integer;
    out_idx: Integer;
    normalized_query: string;
    candidate_text: string;
    query_unit_count: Integer;
    candidate_paths: TArray<string>;

    function candidate_has_backed_complete_segment_path_local(
        const candidate_value: TncCandidate;
        const path_text: string): Boolean;
    var
        path_parts: TArray<string>;
        path_idx: Integer;
        joined_text: string;
        segment_text: string;
    begin
        Result := False;
        if (candidate_value.source <> cs_rule) or
            (Trim(candidate_value.comment) <> '') or
            (query_unit_count <= 0) or
            (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
            query_unit_count) then
        begin
            Exit;
        end;

        if get_encoded_path_segment_count_local(path_text) <= 1 then
        begin
            Exit;
        end;

        path_parts := path_text.Split([c_segment_path_separator]);
        joined_text := '';
        for path_idx := 0 to High(path_parts) do
        begin
            segment_text := Trim(path_parts[path_idx]);
            if segment_text = '' then
            begin
                Exit;
            end;
            joined_text := joined_text + segment_text;
        end;

        Result := SameText(joined_text, Trim(candidate_value.text));
    end;
begin
    normalized_query := normalize_pinyin_text(m_last_lookup_key);
    if (m_dictionary <> nil) and (normalized_query <> '') and
        (Length(m_candidates) > 0) then
    begin
        SetLength(candidate_paths, Length(m_candidates));
        for idx := 0 to High(m_candidates) do
        begin
            if idx < Length(m_candidate_segment_paths) then
            begin
                candidate_paths[idx] := m_candidate_segment_paths[idx];
            end
            else
            begin
                candidate_paths[idx] := '';
            end;
        end;

        query_unit_count := get_effective_compact_pinyin_unit_count(
            normalized_query);
        out_idx := 0;
        for in_idx := 0 to High(m_candidates) do
        begin
            candidate_text := Trim(m_candidates[in_idx].text);
            if (candidate_text <> '') and
                (Trim(m_candidates[in_idx].comment) = '') and
                (not is_current_short_exact_lexicon_completion(
                normalized_query, candidate_text)) and
                (m_dictionary.get_candidate_penalty(normalized_query,
                candidate_text) > 0) and
                (not m_dictionary.is_base_entry(normalized_query,
                candidate_text)) and
                (not candidate_has_backed_complete_segment_path_local(
                m_candidates[in_idx], candidate_paths[in_idx])) then
            begin
                Continue;
            end;

            if out_idx <> in_idx then
            begin
                m_candidates[out_idx] := m_candidates[in_idx];
                candidate_paths[out_idx] := candidate_paths[in_idx];
            end;
            Inc(out_idx);
        end;
        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            SetLength(candidate_paths, out_idx);
        end;
        m_candidate_segment_paths := Copy(candidate_paths);
    end;

    if Length(m_candidate_segment_paths) <> Length(m_candidates) then
    begin
        SetLength(m_candidate_segment_paths, Length(m_candidates));
    end;
    if (Length(m_candidates) = 0) or (m_current_segment_path_map = nil) or
        (m_current_segment_path_map.Count <= 0) then
    begin
        Exit;
    end;

    for idx := 0 to High(m_candidates) do
    begin
        key := build_candidate_identity_key(m_candidates[idx].text, m_candidates[idx].comment);
        if (key <> '') and m_current_segment_path_map.TryGetValue(key, m_candidate_segment_paths[idx]) then
        begin
            Continue;
        end;
    end;
end;

procedure TncEngine.note_ranked_top_candidate;
var
    path_confidence_score: Integer;
    previous_query: string;
    normalized_query: string;
    top_path: string;
begin
    previous_query := normalize_pinyin_text(m_last_ranked_query_key);
    normalized_query := normalize_pinyin_text(m_last_lookup_key);

    if normalized_query = '' then
    begin
        m_last_ranked_query_key := '';
        m_last_ranked_top_path := '';
        Exit;
    end;

    if Length(m_candidates) = 0 then
    begin
        if (previous_query = '') or
            (Copy(normalized_query, 1, Length(previous_query)) <> previous_query) then
        begin
            m_last_ranked_query_key := '';
            m_last_ranked_top_path := '';
        end;
        Exit;
    end;

    top_path := '';
    if m_candidates[0].comment = '' then
    begin
        top_path := get_segment_path_for_candidate(m_candidates[0], 0);
    end;

    if get_encoded_path_segment_count_local(top_path) <= 1 then
    begin
        if (previous_query = '') or
            (Copy(normalized_query, 1, Length(previous_query)) <> previous_query) then
        begin
            m_last_ranked_query_key := '';
            m_last_ranked_top_path := '';
        end;
        Exit;
    end;

    // Keep the query and its path together when an unfinished tail has no path.
    m_last_ranked_query_key := normalized_query;
    m_last_ranked_top_path := top_path;
    path_confidence_score := get_candidate_path_confidence_score(m_candidates[0]);
    if path_confidence_score >= 180 then
    begin
        note_session_ranked_query_path(normalized_query, top_path, path_confidence_score);
    end;
end;

