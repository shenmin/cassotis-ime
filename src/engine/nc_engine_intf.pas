                function has_place_context_before_fast_chunk_inner: Boolean;
                const
                    c_context_probe_limit = 8;
                var
                    back_len_inner: Integer;
                    context_key_inner: string;
                    context_results_inner: TncCandidateList;
                    context_idx_inner: Integer;
                    context_text_inner: string;
                    context_units_inner: TArray<string>;
                begin
                    Result := False;
                    if start_idx_local <= 0 then
                    begin
                        Exit;
                    end;

                    for back_len_inner := 1 to Min(4, start_idx_local) do
                    begin
                        context_key_inner := build_query_key_local(start_idx_local -
                            back_len_inner, back_len_inner);
                        if (context_key_inner = '') or
                            (not lookup_exact_full_pinyin_cached_local(
                            context_key_inner, context_results_inner)) then
                        begin
                            Continue;
                        end;

                        for context_idx_inner := 0 to High(context_results_inner) do
                        begin
                            if context_idx_inner >= c_context_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(context_results_inner[context_idx_inner].comment) <>
                                '' then
                            begin
                                Continue;
                            end;

                            context_text_inner := Trim(
                                context_results_inner[context_idx_inner].text);
                            context_units_inner := split_text_units(
                                context_text_inner);
                            if (Length(context_units_inner) > 0) and
                                is_place_noun_unit_for_fast_context_inner(
                                context_units_inner[High(context_units_inner)]) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                function has_directional_locative_fast_context_inner: Boolean;
                var
                    next_key_inner: string;
                begin
                    Result := False;
                    if (chunk_len_inner <> 2) or
                        (not has_place_context_before_fast_chunk_inner) then
                    begin
                        Exit;
                    end;

                    if start_idx_local + chunk_len_inner >= syllable_count_local then
                    begin
                        Exit(True);
                    end;

                    next_key_inner := normalize_pinyin_text(
                        effective_syllables[start_idx_local +
                        chunk_len_inner].text);
                    Result := SameText(next_key_inner, 'de');
                end;

                function get_directional_locative_fast_bonus_inner(
                    const text_value_inner: string): Integer;
                const
                    c_fast_directional_context_bonus = 12000;
                begin
                    Result := 0;
                    if (get_directional_locative_span_bonus_local(
                        text_value_inner) > 0) and
                        has_directional_locative_fast_context_inner then
                    begin
                        Result := c_fast_directional_context_bonus;
                    end;
                end;

                function try_get_stable_bridge_single_text_inner(
                    const syllable_text_inner: string;
                    out out_text_inner: string): Boolean;
                begin
                    Result := try_get_modifier_prefix_single_text_local(
                        syllable_text_inner, out_text_inner);
                    if Result and (out_text_inner <> '') then
                    begin
                        Exit;
                    end;

                    out_text_inner :=
                        get_fixed_boundary_single_char_for_standalone_local(
                        syllable_text_inner);
                    Result := out_text_inner <> '';
                end;

                function get_function_single_pair_exact_penalty_inner(
                    const candidate_text_inner: string): Integer;
                var
                    first_single_inner: string;
                    second_single_inner: string;
                    stable_pair_inner: string;

                    function is_number_single_text_inner(
                        const text_value_inner: string): Boolean;
                    begin
                        Result := False;
                        if get_candidate_text_unit_count(text_value_inner) <> 1 then
                        begin
                            Exit;
                        end;

                        case Ord(text_value_inner[1]) of
                            $4E00, $4E8C, $4E24, $4E09, $56DB, $4E94, $516D,
                            $4E03, $516B, $4E5D, $5341:
                                Result := True;
                        end;
                    end;

                    function is_quantity_tail_single_text_inner(
                        const text_value_inner: string): Boolean;
                    begin
                        Result := False;
                        if get_candidate_text_unit_count(text_value_inner) <> 1 then
                        begin
                            Exit;
                        end;

                        case Ord(text_value_inner[1]) of
                            $5B57, $9879, $6761, $4E2A, $70B9, $79CD, $7C7B,
                            $6B21, $6B65, $8F6E, $7AE0, $8282, $9875, $6BB5,
                            $884C, $5217, $5C42:
                                Result := True;
                        end;
                    end;

                begin
                    Result := 0;
                    if (chunk_len_inner <> 2) or
                        (candidate_text_inner = '') or
                        (start_idx_local + 1 >= syllable_count_local) then
                    begin
                        Exit;
                    end;

                    if (not try_get_stable_bridge_single_text_inner(
                        effective_syllables[start_idx_local].text,
                        first_single_inner)) or
                        (not try_get_stable_bridge_single_text_inner(
                        effective_syllables[start_idx_local + 1].text,
                        second_single_inner)) then
                    begin
                        Exit;
                    end;

                    if (not ((is_modifier_prefix_bridge_exempt_local(
                        first_single_inner) and
                        is_modifier_prefix_bridge_exempt_local(second_single_inner)) or
                        (is_number_single_text_inner(first_single_inner) and
                        is_quantity_tail_single_text_inner(second_single_inner)))) then
                    begin
                        Exit;
                    end;

                    stable_pair_inner := first_single_inner + second_single_inner;
                    if (stable_pair_inner <> '') and
                        (not SameText(candidate_text_inner, stable_pair_inner)) then
                    begin
                        Result := 42000;
                    end;
                end;

                function get_ranked_lookup_score_for_text_inner(
                    const text_value_inner: string): Integer;
                var
                    ranked_idx_inner: Integer;
                    ranked_text_inner: string;
                begin
                    Result := Low(Integer);
                    if (text_value_inner = '') or
                        (Length(ranked_lookup_results_inner) = 0) then
                    begin
                        Exit;
                    end;

                    for ranked_idx_inner := 0 to
                        Min(High(ranked_lookup_results_inner),
                        get_chain_probe_limit_local - 1) do
                    begin
                        if Trim(ranked_lookup_results_inner[ranked_idx_inner].comment) <> '' then
                        begin
                            Continue;
                        end;
                        ranked_text_inner := Trim(
                            ranked_lookup_results_inner[ranked_idx_inner].text);
                        if (ranked_text_inner = '') or
                            (get_candidate_text_unit_count(ranked_text_inner) <>
                            chunk_len_inner) or
                            (not SameText(ranked_text_inner, text_value_inner)) then
                        begin
                            Continue;
                        end;

                        Result := get_exact_chunk_effective_weight_local(
                            ranked_lookup_results_inner[ranked_idx_inner]) +
                            ((get_chain_probe_limit_local - ranked_idx_inner) * 384);
                        Exit;
                    end;
                end;

                function get_best_direct_raw_weight_inner: Integer;
                var
                    scan_idx_inner: Integer;
                    scan_text_inner: string;
                    scan_raw_inner: Integer;
                begin
                    if best_direct_raw_weight_inner <> Low(Integer) then
                    begin
                        Exit(best_direct_raw_weight_inner);
                    end;

                    best_direct_raw_weight_inner := 0;
                    for scan_idx_inner := 0 to High(lookup_results_inner) do
                    begin
                        if scan_idx_inner >= get_chain_probe_limit_local then
                        begin
                            Break;
                        end;
                        if Trim(lookup_results_inner[scan_idx_inner].comment) <> '' then
                        begin
                            Continue;
                        end;

                        scan_text_inner := Trim(
                            lookup_results_inner[scan_idx_inner].text);
                        if (scan_text_inner = '') or
                            (get_candidate_text_unit_count(scan_text_inner) <>
                            chunk_len_inner) or
                            (not is_valid_standalone_cjk_phrase_text_local(
                            scan_text_inner, chunk_len_inner)) then
                        begin
                            Continue;
                        end;

                        scan_raw_inner := get_exact_chunk_raw_weight_local(
                            lookup_results_inner[scan_idx_inner]);
                        if scan_raw_inner > best_direct_raw_weight_inner then
                        begin
                            best_direct_raw_weight_inner := scan_raw_inner;
                        end;
                    end;
                    Result := best_direct_raw_weight_inner;
                end;

                function get_final_compound_tail_support_bonus_inner(
                    const text_value_inner: string;
                    const raw_weight_value_inner: Integer): Integer;
                const
                    c_strong_direct_tail_weight = 900;
                    c_tail_support_candidate_window = 1400;
                    c_tail_support_bonus_cap = 1800;
                var
                    best_raw_inner: Integer;
                    support_inner: Integer;
                begin
                    Result := 0;
                    if (chunk_len_inner <> 2) or (start_idx_local <= 0) or
                        (start_idx_local + chunk_len_inner <>
                        syllable_count_local) or (m_dictionary = nil) or
                        (text_value_inner = '') or (raw_weight_value_inner <= 0) then
                    begin
                        Exit;
                    end;

                    best_raw_inner := get_best_direct_raw_weight_inner;
                    if (best_raw_inner <= 0) or
                        (raw_weight_value_inner >= best_raw_inner) or
                        ((raw_weight_value_inner +
                        c_tail_support_candidate_window) < best_raw_inner) then
                    begin
                        Exit;
                    end;

                    support_inner :=
                        m_dictionary.get_compound_tail_support(text_value_inner);
                    if (support_inner <= 0) or
                        ((best_raw_inner >= c_strong_direct_tail_weight) and
                        (support_inner < 2000)) then
                    begin
                        Exit;
                    end;

                    Result := Min(c_tail_support_bonus_cap, support_inner);
                end;

