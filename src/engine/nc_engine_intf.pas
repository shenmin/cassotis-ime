    function display_candidate_crosses_protected_exact_pair(
        const candidate_value: TncCandidate; const candidate_idx: Integer): Boolean;
    const
        c_min_protected_pair_weight = 700;
        c_pair_weight_margin = 400;
    var
        candidate_text_local: string;
        candidate_units_local: TArray<string>;
        path_local: string;
        path_parts_local: TArray<string>;
        part_idx_local: Integer;
        pair_pos_local: Integer;
        syllable_pos_local: Integer;
        part_units_local: Integer;
        next_part_units_local: Integer;
        pair_key_local: string;
        pair_text_local: string;
        pair_weight_local: Integer;
        best_pair_text_local: string;
        best_pair_weight_local: Integer;
        following_text_local: string;
        following_weight_local: Integer;

        function path_has_supported_tail_after_single_local(
            const single_pos_local: Integer;
            const competing_pair_weight_local: Integer): Boolean;
        var
            local_path: string;
            local_parts: TArray<string>;
            local_part_idx: Integer;
            local_syllable_pos: Integer;
            local_part_text: string;
            local_part_units: Integer;
            local_tail_key: string;
            local_tail_weight: Integer;
        begin
            Result := False;
            local_path := get_display_candidate_path_for_index(candidate_value,
                candidate_idx);
            if get_encoded_path_segment_count_local(local_path) <= 1 then
            begin
                Exit;
            end;

            local_parts := local_path.Split([c_segment_path_separator]);
            local_syllable_pos := 0;
            for local_part_idx := 0 to High(local_parts) do
            begin
                local_part_text := Trim(local_parts[local_part_idx]);
                local_part_units := get_candidate_text_unit_count(local_part_text);
                if local_part_units <= 0 then
                begin
                    Exit;
                end;

                if local_syllable_pos = single_pos_local + 1 then
                begin
                    if local_part_units < 2 then
                    begin
                        Exit;
                    end;
                    local_tail_key := build_display_query_key(local_syllable_pos,
                        local_part_units);
                    local_tail_weight := 0;
                    if (local_tail_key <> '') and
                        get_display_exact_text_weight(local_tail_key,
                        local_part_text, local_part_units, local_tail_weight) and
                        (local_tail_weight >= competing_pair_weight_local +
                        c_pair_weight_margin) then
                    begin
                        Exit(True);
                    end;
                    Exit;
                end;

                Inc(local_syllable_pos, local_part_units);
                if local_syllable_pos > single_pos_local + 1 then
                begin
                    Exit;
                end;
            end;
        end;

        function path_starts_segment_at_syllable_local(
            const syllable_pos_value: Integer): Boolean;
        var
            local_path: string;
            local_parts: TArray<string>;
            local_part_idx: Integer;
            local_syllable_pos: Integer;
            local_part_units: Integer;
        begin
            Result := True;
            local_path := get_display_candidate_path_for_index(candidate_value,
                candidate_idx);
            if get_encoded_path_segment_count_local(local_path) <= 1 then
            begin
                Exit;
            end;

            local_parts := local_path.Split([c_segment_path_separator]);
            local_syllable_pos := 0;
            for local_part_idx := 0 to High(local_parts) do
            begin
                if local_syllable_pos = syllable_pos_value then
                begin
                    Exit(True);
                end;
                local_part_units := get_candidate_text_unit_count(
                    Trim(local_parts[local_part_idx]));
                if local_part_units <= 0 then
                begin
                    Exit(True);
                end;
                Inc(local_syllable_pos, local_part_units);
                if local_syllable_pos > syllable_pos_value then
                begin
                    Exit(False);
                end;
            end;
        end;
    begin
        Result := False;
        candidate_text_local := Trim(candidate_value.text);
        if (candidate_text_local = '') or (Trim(candidate_value.comment) <> '') or
            (expected_units < 3) or
            (get_candidate_text_unit_count(candidate_text_local) <> expected_units) then
        begin
            Exit;
        end;

        candidate_units_local := split_text_units(candidate_text_local);
        if Length(candidate_units_local) <> expected_units then
        begin
            Exit;
        end;

        for pair_pos_local := 0 to expected_units - 2 do
        begin
            if not is_display_function_or_modifier_single(
                Trim(candidate_units_local[pair_pos_local])) then
            begin
                Continue;
            end;
            if not path_starts_segment_at_syllable_local(pair_pos_local) then
            begin
                Continue;
            end;
            if not try_get_display_exact_phrase(pair_pos_local, 2,
                best_pair_text_local, best_pair_weight_local) then
            begin
                Continue;
            end;
            if best_pair_weight_local < c_min_protected_pair_weight then
            begin
                Continue;
            end;

            pair_text_local := Trim(candidate_units_local[pair_pos_local]) +
                Trim(candidate_units_local[pair_pos_local + 1]);
            if SameText(pair_text_local, best_pair_text_local) then
            begin
                Continue;
            end;

            pair_weight_local := 0;
            pair_key_local := build_display_query_key(pair_pos_local, 2);
            get_display_exact_text_weight(pair_key_local, pair_text_local, 2,
                pair_weight_local);
            if (pair_weight_local <= 0) or
                (best_pair_weight_local >= pair_weight_local +
                c_pair_weight_margin) then
            begin
                if path_has_supported_tail_after_single_local(pair_pos_local,
                    best_pair_weight_local) then
                begin
                    Continue;
                end;
                Exit(True);
            end;
        end;

        path_local := get_display_candidate_path_for_index(candidate_value,
            candidate_idx);
        if get_encoded_path_segment_count_local(path_local) <= 1 then
        begin
            Exit;
        end;

        path_parts_local := path_local.Split([c_segment_path_separator]);
        syllable_pos_local := 0;
        for part_idx_local := 0 to High(path_parts_local) - 1 do
        begin
            part_units_local := get_candidate_text_unit_count(
                Trim(path_parts_local[part_idx_local]));
            next_part_units_local := get_candidate_text_unit_count(
                Trim(path_parts_local[part_idx_local + 1]));
            if part_units_local <= 0 then
            begin
                Exit;
            end;

            if (part_units_local = 1) and (next_part_units_local >= 2) and
                (syllable_pos_local + 1 < expected_units) and
                try_get_display_exact_phrase(syllable_pos_local, 2,
                best_pair_text_local, best_pair_weight_local) and
                (best_pair_weight_local >= c_min_protected_pair_weight) then
            begin
                pair_text_local := Trim(candidate_units_local[syllable_pos_local]) +
                    Trim(candidate_units_local[syllable_pos_local + 1]);
                if not SameText(pair_text_local, best_pair_text_local) then
                begin
                    following_weight_local := 0;
                    following_text_local := '';
                    try_get_display_exact_phrase(syllable_pos_local + 1,
                        next_part_units_local, following_text_local,
                        following_weight_local);
                    if (following_weight_local <= 0) or
                        (best_pair_weight_local >= following_weight_local +
                        c_pair_weight_margin) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            Inc(syllable_pos_local, part_units_local);
            if syllable_pos_local >= expected_units then
            begin
                Break;
            end;
        end;
    end;

    function display_path_has_one_plus_two_function_head(
        const path_value: string): Boolean;
    var
        parts_local: TArray<string>;
        head_text_local: string;
        tail_text_local: string;
        tail_key_local: string;
        tail_weight_local: Integer;
    begin
        Result := False;
        if get_encoded_path_segment_count_local(path_value) <> 2 then
        begin
            Exit;
        end;

        parts_local := path_value.Split([c_segment_path_separator]);
        if Length(parts_local) <> 2 then
        begin
            Exit;
        end;

        head_text_local := Trim(parts_local[0]);
        tail_text_local := Trim(parts_local[1]);
        Result :=
            (get_candidate_text_unit_count(head_text_local) = 1) and
            is_display_one_plus_two_supported_head_single(head_text_local) and
            (get_candidate_text_unit_count(tail_text_local) = 2);
        if Result and is_display_one_plus_two_pronoun_head_single(
            head_text_local) then
        begin
            tail_key_local := build_display_query_key(1, 2);
            Result := get_display_exact_text_weight(tail_key_local,
                tail_text_local, 2, tail_weight_local) and
                (tail_weight_local >= 500);
        end;
    end;

    function display_path_has_two_plus_one_non_particle_tail(
        const path_value: string): Boolean;
    var
        parts_local: TArray<string>;
        tail_text_local: string;
    begin
        Result := False;
        if get_encoded_path_segment_count_local(path_value) <> 2 then
        begin
            Exit;
        end;

        parts_local := path_value.Split([c_segment_path_separator]);
        if Length(parts_local) <> 2 then
        begin
            Exit;
        end;

        tail_text_local := Trim(parts_local[1]);
        if (get_candidate_text_unit_count(tail_text_local) = 1) then
        begin
            case Ord(tail_text_local[1]) of
                $4E86, $7740, $8FC7, $5417, $561B, $5427, $5462,
                $554A, $5440, $5566, $7684, $5730, $5F97:
                    Exit(False);
            end;
        end;
        Result :=
            (get_candidate_text_unit_count(Trim(parts_local[0])) = 2) and
            (get_candidate_text_unit_count(tail_text_local) = 1);
    end;

