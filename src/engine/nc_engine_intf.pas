        function try_find_tail_candidate(
            const candidates: TncCandidateList): Boolean;
        var
            tail_idx: Integer;
            candidate_tail_text: string;
            candidate_tail_score: Integer;
            candidate_tail_dict_weight: Integer;
            best_tail_score: Integer;
        begin
            Result := False;
            best_tail_score := Low(Integer);
            for tail_idx := 0 to High(candidates) do
            begin
                if tail_idx >= c_tail_probe_limit then
                begin
                    Break;
                end;
                if Trim(candidates[tail_idx].comment) <> '' then
                begin
                    Continue;
                end;

                candidate_tail_text := Trim(candidates[tail_idx].text);
                if (candidate_tail_text = '') or
                    (get_candidate_text_unit_count(candidate_tail_text) <> tail_units) then
                begin
                    Continue;
                end;
                if (not m_dictionary.is_base_entry(tail_key, candidate_tail_text)) and
                    (not m_dictionary.is_user_entry(tail_key, candidate_tail_text)) then
                begin
                    Continue;
                end;

                candidate_tail_score := candidates[tail_idx].score;
                candidate_tail_dict_weight := candidate_tail_score;
                if candidates[tail_idx].has_dict_weight then
                begin
                    candidate_tail_dict_weight := candidates[tail_idx].dict_weight;
                    candidate_tail_score := candidates[tail_idx].dict_weight;
                end;
                if candidates[tail_idx].source = cs_user then
                begin
                    Inc(candidate_tail_score, c_user_score_bonus);
                end;
                if Result and (candidate_tail_score <= best_tail_score) then
                begin
                    Continue;
                end;

                best_tail_score := candidate_tail_score;
                tail_text := candidate_tail_text;
                tail_score := candidate_tail_score;
                tail_dict_weight := candidate_tail_dict_weight;
                FillChar(fixed_candidate, SizeOf(fixed_candidate), 0);
                fixed_candidate.text := head_text + tail_text;
                fixed_candidate.comment := '';
                fixed_candidate.source := cs_rule;
                fixed_candidate.score := tail_score + c_fixed_wo_tail_base_bonus +
                    (tail_units * c_fixed_wo_tail_unit_bonus);
                fixed_candidate.has_dict_weight := True;
                fixed_candidate.dict_weight := tail_dict_weight;
                Result := True;
            end;
        end;

        function is_same_head_fixed_tail_complete_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
            tail_text_local: string;
        begin
            Result := False;
            if Trim(candidate_value.comment) <> '' then
            begin
                Exit;
            end;

            text_local := Trim(candidate_value.text);
            if (text_local = '') or (Length(text_local) <= Length(head_text)) or
                (not SameText(Copy(text_local, 1, Length(head_text)),
                head_text)) or
                (get_candidate_text_unit_count(text_local) <> expected_units) then
            begin
                Exit;
            end;

            tail_text_local := Copy(text_local, Length(head_text) + 1, MaxInt);
            Result := (tail_text_local <> '') and
                (get_candidate_text_unit_count(tail_text_local) = tail_units);
        end;

        procedure keep_fixed_tail_completes_before_partials_local;
        var
            insert_idx_local: Integer;
            scan_idx_local: Integer;
        begin
            insert_idx_local := 0;
            while (insert_idx_local <= High(m_candidates)) and
                is_same_head_fixed_tail_complete_local(
                m_candidates[insert_idx_local]) do
            begin
                Inc(insert_idx_local);
            end;

            scan_idx_local := insert_idx_local + 1;
            while scan_idx_local <= High(m_candidates) do
            begin
                if is_same_head_fixed_tail_complete_local(
                    m_candidates[scan_idx_local]) then
                begin
                    force_move_display_candidate_to_index(scan_idx_local,
                        insert_idx_local);
                    Inc(insert_idx_local);
                    scan_idx_local := insert_idx_local + 1;
                    Continue;
                end;
                Inc(scan_idx_local);
            end;
        end;
    begin
        if (m_dictionary = nil) or
            (not try_get_fixed_pronoun_tail_query_parts(normalized_pinyin,
            expected_units, head_pinyin, head_text, tail_key, tail_units)) then
        begin
            Exit;
        end;

        if tail_key = '' then
        begin
            Exit;
        end;
        if tail_units < 2 then
        begin
            Exit;
        end;

        user_exact_idx := find_first_full_query_user_exact_candidate_local;
        if (not lookup_display_exact_cached(tail_key, tail_results)) or
            (not try_find_tail_candidate(tail_results)) then
        begin
            if (not m_dictionary.lookup(tail_key, tail_results)) or
                (not try_find_tail_candidate(tail_results)) then
            begin
                Exit;
            end;
        end;

        target_idx := count_leading_full_query_exact_candidates_local;
        if user_exact_idx > 0 then
        begin
            force_move_display_candidate_to_index(user_exact_idx, 0);
        end;
        if user_exact_idx >= 0 then
        begin
            target_idx := count_leading_full_query_user_exact_candidates_local;
        end;
        if target_idx > 0 then
        begin
            fixed_candidate.score := Min(fixed_candidate.score,
                Max(0, fixed_candidate.dict_weight) + 160 +
                (tail_units * 24));
        end;

        for candidate_idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[candidate_idx].comment) = '') and
                SameText(Trim(m_candidates[candidate_idx].text),
                fixed_candidate.text) then
            begin
                if is_full_query_user_exact_candidate_local(
                    m_candidates[candidate_idx]) then
                begin
                    Exit;
                end;
                if candidate_idx <> target_idx then
                begin
                    force_move_display_candidate_to_index(candidate_idx,
                        target_idx);
                end;
                Break;
            end;
        end;
        if (Length(m_candidates) = 0) or
            (target_idx > High(m_candidates)) or
            (not SameText(Trim(m_candidates[target_idx].text),
            fixed_candidate.text)) or
            (Trim(m_candidates[target_idx].comment) <> '') then
        begin
            insert_final_fixed_top_candidate(fixed_candidate);
            if target_idx > 0 then
            begin
                force_move_display_candidate_to_index(0, target_idx);
            end;
        end;
        keep_fixed_tail_completes_before_partials_local;

        out_idx := 0;
        for candidate_idx := 0 to High(m_candidates) do
        begin
            candidate_text := Trim(m_candidates[candidate_idx].text);
            candidate_units := split_text_units(candidate_text);
            if (Trim(m_candidates[candidate_idx].comment) <> '') and
                (Length(candidate_units) >= 2) and
                (Trim(candidate_units[0]) <> head_text) and
                m_dictionary.single_char_matches_pinyin(head_pinyin,
                Trim(candidate_units[0])) then
            begin
                Continue;
            end;

            if out_idx <> candidate_idx then
            begin
                m_candidates[out_idx] := m_candidates[candidate_idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if candidate_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[candidate_idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;
        if out_idx < Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
    end;

    procedure ensure_display_short_particle_tail_candidate_visible;
    const
        c_head_probe_limit = 8;
        c_particle_tail_min_head_score = 80;
        c_particle_tail_visible_bonus = 160;
        c_particle_tail_unit_bonus = 24;
        c_particle_tail_weak_bonus = 8;
    var
        syllables_local: TncPinyinParseResult;
        head_units: Integer;
        tail_units: Integer;
        part_idx: Integer;
        head_key: string;
        tail_key: string;
        tail_text: string;
        head_results: TncCandidateList;
        candidate_idx: Integer;
        user_exact_idx: Integer;
        target_idx: Integer;
        fixed_candidate: TncCandidate;
        fixed_candidates: TncCandidateList;
        fixed_idx: Integer;
        head_text: string;
        head_score: Integer;
        head_dict_weight: Integer;
        candidate_found: Boolean;
        candidate_is_full_query_exact: Boolean;
        require_dehao_head: Boolean;

        function derived_particle_tail_score_local(
            const base_score: Integer): Integer;
        begin
            Result := base_score;
            if Result < 0 then
            begin
                Result := 0;
            end;
            if Result < c_particle_tail_min_head_score then
            begin
                Inc(Result, c_particle_tail_weak_bonus);
                Exit;
            end;

            Inc(Result, c_particle_tail_visible_bonus +
                (head_units * c_particle_tail_unit_bonus));
        end;

        function text_ends_with_tail_particle_local(
            const text_value: string; const tail_text_value: string): Boolean;
        var
            trimmed_text_local: string;
            tail_start_local: Integer;
        begin
            Result := False;
            trimmed_text_local := Trim(text_value);
            if (trimmed_text_local = '') or (tail_text_value = '') then
            begin
                Exit;
            end;
            if Length(trimmed_text_local) < Length(tail_text_value) then
            begin
                Exit;
            end;

            tail_start_local := Length(trimmed_text_local) -
                Length(tail_text_value) + 1;
            Result := SameText(Copy(trimmed_text_local, tail_start_local,
                Length(tail_text_value)), tail_text_value);
        end;

        function is_full_query_user_exact_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (normalized_pinyin = '') or
                (Trim(candidate_value.comment) <> '') then
            begin
                Exit;
            end;

            text_local := Trim(candidate_value.text);
            Result := (text_local <> '') and
                (get_candidate_text_unit_count(text_local) = expected_units) and
                m_dictionary.is_user_entry(normalized_pinyin, text_local);
        end;

        function is_full_query_exact_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
        begin
            Result := False;
            if (m_dictionary = nil) or (normalized_pinyin = '') or
                (Trim(candidate_value.comment) <> '') then
            begin
                Exit;
            end;

            text_local := Trim(candidate_value.text);
            if (text_local = '') or
                (get_candidate_text_unit_count(text_local) <> expected_units) then
            begin
                Exit;
            end;

            if m_dictionary.is_base_entry(normalized_pinyin, text_local) or
                m_dictionary.is_user_entry(normalized_pinyin, text_local) then
            begin
                Exit(True);
            end;

            if lookup_display_exact_cached(normalized_pinyin,
                exact_results_local) then
            begin
                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[exact_idx_local].comment) =
                        '') and SameText(Trim(exact_results_local[
                        exact_idx_local].text), text_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        end;

        function find_first_full_query_user_exact_candidate_local: Integer;
        var
            candidate_idx_local: Integer;
        begin
            Result := -1;
            if (m_dictionary = nil) or (normalized_pinyin = '') then
            begin
                Exit;
            end;

            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                if is_full_query_user_exact_candidate_local(
                    m_candidates[candidate_idx_local]) then
                begin
                    Exit(candidate_idx_local);
                end;
            end;
        end;

        function count_leading_full_query_user_exact_candidates_local: Integer;
        begin
            Result := 0;
            while (Result <= High(m_candidates)) and
                is_full_query_user_exact_candidate_local(m_candidates[Result]) do
            begin
                Inc(Result);
            end;
        end;

        function count_leading_full_query_exact_candidates_local: Integer;
        begin
            Result := 0;
            while (Result <= High(m_candidates)) and
                is_full_query_exact_candidate_local(m_candidates[Result]) do
            begin
                Inc(Result);
            end;
        end;

        function has_full_query_exact_candidate_local: Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
        begin
            Result := False;
            if (normalized_pinyin = '') or
                (not lookup_display_exact_cached(normalized_pinyin,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (exact_text_local <> '') and
                    (get_candidate_text_unit_count(exact_text_local) =
                    expected_units) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function fixed_candidate_text_exists_local(
            const candidate_text_value: string): Boolean;
        var
            fixed_idx_local: Integer;
        begin
            Result := False;
            for fixed_idx_local := 0 to High(fixed_candidates) do
            begin
                if SameText(Trim(fixed_candidates[fixed_idx_local].text),
                    candidate_text_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function should_keep_supported_pair_before_particle_local(
            const candidate_value: TncCandidate;
            const particle_candidate_value: TncCandidate): Boolean;
        begin
            Result := (Trim(candidate_value.comment) = '') and
                is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, Trim(candidate_value.text)) and
                (display_candidate_effective_weight(candidate_value) >=
                display_candidate_effective_weight(particle_candidate_value));
        end;

        function append_head_candidates(
            const candidates: TncCandidateList): Boolean;
        var
            head_idx: Integer;
            candidate_local: TncCandidate;
            candidate_text_local: string;
        begin
            Result := False;
            for head_idx := 0 to High(candidates) do
            begin
                if head_idx >= c_head_probe_limit then
                begin
                    Break;
                end;
                if Trim(candidates[head_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(candidates[head_idx]) or
                    is_runtime_common_pattern_candidate(candidates[head_idx]) or
                    is_runtime_redup_candidate(candidates[head_idx]) then
                begin
                    Continue;
                end;

                head_text := Trim(candidates[head_idx].text);
                if (head_text = '') or
                    (get_candidate_text_unit_count(head_text) <> head_units) or
                    text_ends_with_tail_particle_local(head_text, tail_text) then
                begin
                    Continue;
                end;
                if require_dehao_head and
                    (not text_ends_with_tail_particle_local(head_text,
                    string(Char($5F97)))) then
                begin
                    Continue;
                end;

                head_score := candidates[head_idx].score;
                head_dict_weight := head_score;
                if candidates[head_idx].has_dict_weight and
                    (candidates[head_idx].dict_weight > head_score) then
                begin
                    head_score := candidates[head_idx].dict_weight;
                    head_dict_weight := candidates[head_idx].dict_weight;
                end;
                if candidates[head_idx].source = cs_user then
                begin
                    Inc(head_score, c_user_score_bonus);
                end;

                candidate_text_local := head_text + tail_text;
                if fixed_candidate_text_exists_local(candidate_text_local) then
                begin
                    Continue;
                end;

                FillChar(candidate_local, SizeOf(candidate_local), 0);
                candidate_local.text := candidate_text_local;
                candidate_local.comment := '';
                candidate_local.source := cs_rule;
                candidate_local.score :=
                    derived_particle_tail_score_local(head_score);
                candidate_local.has_dict_weight := True;
                candidate_local.dict_weight := head_dict_weight;

                SetLength(fixed_candidates, Length(fixed_candidates) + 1);
                fixed_candidates[High(fixed_candidates)] := candidate_local;
                Result := True;
            end;
        end;
    begin
        if (m_page_index <> 0) or (normalized_pinyin = '') or
            (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            Exit;
        end;

        if (expected_units = 2) and SameText(normalized_pinyin, 'dehao') then
        begin
            for candidate_idx := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[candidate_idx].comment) = '') and
                    SameText(Trim(m_candidates[candidate_idx].text),
                    string(Char($5F97)) + string(Char($597D))) then
                begin
                    if candidate_idx <> 0 then
                    begin
                        force_move_display_candidate_to_index(candidate_idx, 0);
                    end;
                    Exit;
                end;
            end;

            FillChar(fixed_candidate, SizeOf(fixed_candidate), 0);
            fixed_candidate.text := string(Char($5F97)) + string(Char($597D));
            fixed_candidate.comment := '';
            fixed_candidate.score := 760;
            fixed_candidate.source := cs_rule;
            fixed_candidate.has_dict_weight := True;
            fixed_candidate.dict_weight := 760;
            insert_final_fixed_top_candidate(fixed_candidate);
            Exit;
        end;

        if (m_dictionary = nil) or (expected_units < 3) or
            (expected_units > 4) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            normalized_pinyin);
        if Length(syllables_local) <> expected_units then
        begin
            Exit;
        end;

        tail_units := 1;
        require_dehao_head := False;
        tail_key := normalize_pinyin_text(syllables_local[High(syllables_local)].text);
        if (expected_units >= 3) and SameText(normalize_pinyin_text(
            syllables_local[High(syllables_local) - 1].text), 'de') and
            SameText(tail_key, 'hao') then
        begin
            tail_text := string(Char($597D));
            require_dehao_head := True;
        end
        else if SameText(tail_key, 'de') then
        begin
            tail_text := string(Char($7684));
        end
        else if SameText(tail_key, 'le') then
        begin
            tail_text := string(Char($4E86));
        end
        else if SameText(tail_key, 'zhe') then
        begin
            tail_text := string(Char($7740));
        end
        else if SameText(tail_key, 'la') then
        begin
            tail_text := string(Char($5566));
        end
        else if SameText(tail_key, 'ba') then
        begin
            tail_text := string(Char($5427));
        end
        else if SameText(tail_key, 'ma') then
        begin
            tail_text := string(Char($5417));
        end
        else if SameText(tail_key, 'a') then
        begin
            tail_text := string(Char($554A));
        end
        else
        begin
            Exit;
        end;

        if has_full_query_exact_candidate_local and
            (not SameText(tail_key, 'a')) then
        begin
            Exit;
        end;

        head_units := expected_units - tail_units;
        if (head_units > 3) or
            ((tail_units = 1) and (head_units < 2)) or
            ((tail_units = 2) and (head_units < 1)) then
        begin
            Exit;
        end;

        head_key := '';
        for part_idx := 0 to head_units - 1 do
        begin
            head_key := head_key + normalize_pinyin_text(
                syllables_local[part_idx].text);
        end;
        if head_key = '' then
        begin
            Exit;
        end;

        SetLength(fixed_candidates, 0);
        if (not lookup_display_exact_cached(head_key, head_results)) or
            (not append_head_candidates(head_results)) then
        begin
            Exit;
        end;

        user_exact_idx := find_first_full_query_user_exact_candidate_local;
        if user_exact_idx > 0 then
        begin
            force_move_display_candidate_to_index(user_exact_idx, 0);
        end;
        target_idx := count_leading_full_query_exact_candidates_local;
        if user_exact_idx >= 0 then
        begin
            target_idx := Max(target_idx,
                count_leading_full_query_user_exact_candidates_local);
        end;

        for fixed_idx := 0 to High(fixed_candidates) do
        begin
            fixed_candidate := fixed_candidates[fixed_idx];
            while (target_idx <= High(m_candidates)) and
                should_keep_supported_pair_before_particle_local(
                m_candidates[target_idx], fixed_candidate) do
            begin
                Inc(target_idx);
            end;
            candidate_found := False;
            candidate_is_full_query_exact := False;
            for candidate_idx := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[candidate_idx].comment) = '') and
                    SameText(Trim(m_candidates[candidate_idx].text),
                    fixed_candidate.text) then
                begin
                    candidate_found := True;
                    if is_full_query_exact_candidate_local(
                        m_candidates[candidate_idx]) then
                    begin
                        candidate_is_full_query_exact := True;
                        Break;
                    end;
                    if candidate_idx <> target_idx then
                    begin
                        force_move_display_candidate_to_index(candidate_idx,
                            target_idx);
                    end;
                    Break;
                end;
            end;

            if candidate_is_full_query_exact then
            begin
                Continue;
            end;

            if (not candidate_found) or (target_idx > High(m_candidates)) or
                (not ((target_idx >= 0) and
                (Trim(m_candidates[target_idx].comment) = '') and
                SameText(Trim(m_candidates[target_idx].text),
                fixed_candidate.text))) then
            begin
                insert_final_fixed_top_candidate(fixed_candidate);
                if target_idx > 0 then
                begin
                    force_move_display_candidate_to_index(0, target_idx);
                end;
            end;
            Inc(target_idx);
        end;
    end;

    procedure enforce_final_fixed_top_candidate;
    var
        expected_text: string;
        idx: Integer;
        exact_idx: Integer;
        exact_results: TncCandidateList;
        fixed_candidate: TncCandidate;
        found_candidate: Boolean;
    begin
        expected_text := get_final_fixed_top_text;
        if expected_text = '' then
        begin
            Exit;
        end;

        for idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[idx].comment) = '') and
                SameText(Trim(m_candidates[idx].text), expected_text) then
            begin
                if idx > 0 then
                begin
                    force_move_display_candidate_to_index(idx, 0);
                end;
                Exit;
            end;
        end;

        found_candidate := False;
        if lookup_display_exact_cached(normalized_pinyin, exact_results) then
        begin
            for exact_idx := 0 to High(exact_results) do
            begin
                if (Trim(exact_results[exact_idx].comment) = '') and
                    SameText(Trim(exact_results[exact_idx].text), expected_text) then
                begin
                    fixed_candidate := exact_results[exact_idx];
                    found_candidate := True;
                    Break;
                end;
            end;
        end;
        if not found_candidate then
        begin
            Exit;
        end;

        if Length(m_candidates) > 0 then
        begin
            fixed_candidate.score := Max(fixed_candidate.score,
                m_candidates[0].score + 512);
        end;
        fixed_candidate.has_dict_weight := True;
        fixed_candidate.dict_weight := Max(fixed_candidate.dict_weight,
            fixed_candidate.score);
        insert_final_fixed_top_candidate(fixed_candidate);
    end;

    procedure promote_complete_long_candidate_over_partial_top(
        const require_structural_signal: Boolean);
    const
        c_probe_limit = 8;
        c_min_long_units = 8;
        c_complete_over_complete_margin = 128;
        c_complete_over_partial_margin = -2200;
    var
        idx: Integer;
        probe_limit: Integer;
        best_idx: Integer;
        best_score: Integer;
        top_score: Integer;
        top_is_complete: Boolean;
        candidate_text: string;
        candidate_score: Integer;
        particle_exact_weight_cache: TDictionary<string, Integer>;

        function complete_candidate_rank_score(const candidate_value: TncCandidate): Integer;
        var
            raw_score: Integer;
        begin
            raw_score := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > raw_score) then
            begin
                raw_score := candidate_value.dict_weight;
            end;

            Result := raw_score;
            if (expected_units >= c_min_long_units) and (Result > 24000) then
            begin
                Result := 24000 + ((Result - 24000) div 32);
                if Result > 36000 then
                begin
                    Result := 36000;
                end;
            end;
        end;

        function is_complete_display_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        begin
            Result := (Trim(candidate_value.comment) = '') and
                (Trim(candidate_value.text) <> '') and
                (get_candidate_text_unit_count(Trim(candidate_value.text)) =
                expected_units);
        end;

        function is_likely_verbal_unit_local(const unit_text: string): Boolean;
