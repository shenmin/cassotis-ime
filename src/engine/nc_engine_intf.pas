function TncEngine.get_debug_candidate_segment_path(const candidate_index: Integer): string;
var
    source_index: Integer;
begin
    Result := '';
    source_index := candidate_index;
    if (candidate_index >= 0) and
        (candidate_index < Length(m_visible_candidate_source_indices_cache)) then
    begin
        source_index := m_visible_candidate_source_indices_cache[candidate_index];
    end;

    if (source_index >= 0) and (source_index < Length(m_candidates)) then
    begin
        // Match the runtime guard: restored/generated candidates can keep their
        // path in the text-keyed cache rather than the parallel source array.
        Result := get_segment_path_for_candidate(m_candidates[source_index], source_index);
    end;
end;

function TncEngine.get_debug_target_recall(
    const target_text: string): TncTargetRecallDebug;
var
    idx: Integer;
    complete_rank: Integer;
    normalized_target: string;
begin
    Result.found := False;
    Result.raw_rank := 0;
    Result.complete_rank := 0;
    Result.raw_candidate_count := Length(m_candidates);
    Result.complete_candidate_count := 0;
    Result.score := 0;
    Result.segment_path := '';
    Result.final_state_found := m_debug_target_final_state_found;
    Result.final_state_rank := m_debug_target_final_state_rank;
    Result.final_state_count := m_debug_target_final_state_count;
    Result.max_generated_syllable := m_debug_target_max_generated_syllable;
    Result.max_retained_syllable := m_debug_target_max_retained_syllable;
    Result.chain_generated_syllable :=
        m_debug_target_chain_generated_syllable;
    Result.chain_prebeam_syllable :=
        m_debug_target_chain_prebeam_syllable;
    Result.chain_beam_syllable := m_debug_target_chain_beam_syllable;
    Result.full_path_generated_syllable :=
        m_debug_target_full_path_generated_syllable;
    Result.full_path_retained_syllable :=
        m_debug_target_full_path_retained_syllable;
    Result.final_state_source_mask := m_debug_target_final_state_source_mask;
    Result.chain_final_state_rank := m_debug_target_chain_final_state_rank;
    Result.light_final_state_rank := m_debug_target_light_final_state_rank;
    Result.lattice_final_state_rank := m_debug_target_lattice_final_state_rank;
    Result.oracle_final_state_rank := m_debug_target_oracle_final_state_rank;
    Result.full_final_state_rank := m_debug_target_full_final_state_rank;
    Result.chain_build_attempted := m_debug_target_chain_build_attempted;
    Result.chain_build_accepted := m_debug_target_chain_build_accepted;
    Result.chain_top_score := m_debug_target_chain_top_score;
    Result.chain_min_score := m_debug_target_chain_min_score;
    Result.chain_search_status := m_debug_target_chain_search_status;
    Result.candidate_stage_mask := m_debug_target_candidate_stage_mask;
    Result.input_syllable_count := m_last_lookup_syllable_count;
    Result.full_path_budget_exhausted :=
        m_debug_target_full_path_budget_exhausted;

    normalized_target := Trim(target_text);
    complete_rank := 0;
    for idx := 0 to High(m_candidates) do
    begin
        if (Trim(m_candidates[idx].text) = '') or
            (Trim(m_candidates[idx].comment) <> '') then
        begin
            Continue;
        end;

        Inc(complete_rank);
        if (not Result.found) and SameText(
            Trim(m_candidates[idx].text), normalized_target) then
        begin
            Result.found := True;
            Result.raw_rank := idx + 1;
            Result.complete_rank := complete_rank;
            Result.score := m_candidates[idx].score;
            Result.segment_path := get_segment_path_for_candidate(
                m_candidates[idx], idx);
        end;
    end;
    Result.complete_candidate_count := complete_rank;
end;

