    function is_demonstrative_head_friendly_remaining_local(
        const parsed_syllables: TncPinyinParseResult; const start_idx: Integer
    ): Boolean;
    var
        dummy_text: string;
    begin
        Result := False;
        if (start_idx < 0) or (start_idx > High(parsed_syllables)) then
        begin
            Exit;
        end;

        if try_get_demonstrative_tail_expected_text_local(
            parsed_syllables[start_idx].text, dummy_text) then
        begin
            Exit(True);
        end;

        if (start_idx < High(parsed_syllables)) and
            SameText(parsed_syllables[start_idx].text, 'yi') and
            try_get_demonstrative_tail_expected_text_local(
            parsed_syllables[start_idx + 1].text, dummy_text) then
        begin
            Exit(True);
        end;
    end;

    function try_get_preferred_demonstrative_head_single_char_local(
        const parsed_syllables: TncPinyinParseResult; const start_idx: Integer;
        out out_candidate: TncCandidate; out out_strength: Integer
    ): Boolean;
    var
        expected_head_text: string;
    begin
        Result := False;
        out_candidate.text := '';
        out_candidate.comment := '';
        out_candidate.score := 0;
        out_candidate.source := cs_rule;
        out_candidate.has_dict_weight := False;
        out_candidate.dict_weight := 0;
        out_strength := 0;

        if (Length(parsed_syllables) <= 0) or
            (start_idx <= 0) or (start_idx > High(parsed_syllables)) or
            (not is_demonstrative_function_head_syllable_local(parsed_syllables[0].text)) or
            (not is_demonstrative_head_friendly_remaining_local(parsed_syllables, start_idx)) or
            (not try_get_demonstrative_head_expected_text_local(
            parsed_syllables[0].text, expected_head_text)) then
        begin
            Exit;
        end;

        Result := try_get_single_char_candidate_for_pinyin_key_local(
            parsed_syllables[0].text, expected_head_text, out_candidate, out_strength);
    end;

    function get_demonstrative_head_partial_score_adjustment_local(
        const parsed_syllables: TncPinyinParseResult; const candidate_text: string;
        const start_idx: Integer
    ): Integer;
    const
        c_demonstrative_head_partial_bonus_single_tail_local = 760;
        c_demonstrative_head_partial_bonus_yi_bridge_local = 680;
        c_demonstrative_wrong_head_partial_penalty_local = 160;
    var
        expected_head_text: string;
        normalized_candidate_text: string;
    begin
        Result := 0;
        normalized_candidate_text := Trim(candidate_text);
        if (Length(parsed_syllables) <= 0) or
            (start_idx <= 0) or (start_idx > High(parsed_syllables)) or
            (normalized_candidate_text = '') or
            (not is_demonstrative_function_head_syllable_local(parsed_syllables[0].text)) or
            (not is_demonstrative_head_friendly_remaining_local(parsed_syllables, start_idx)) or
            (not try_get_demonstrative_head_expected_text_local(
            parsed_syllables[0].text, expected_head_text)) then
        begin
            Exit;
        end;

        if normalized_candidate_text = expected_head_text then
        begin
            if (start_idx < High(parsed_syllables)) and
                SameText(parsed_syllables[start_idx].text, 'yi') then
            begin
                Result := c_demonstrative_head_partial_bonus_yi_bridge_local;
            end
            else
            begin
                Result := c_demonstrative_head_partial_bonus_single_tail_local;
            end;
        end
        else if is_single_text_unit(normalized_candidate_text) then
        begin
            Result := -c_demonstrative_wrong_head_partial_penalty_local;
        end;
    end;

    procedure ensure_forced_single_char_partial(var candidates: TncCandidateList);
    const
        c_forced_partial_penalty_per_syllable = 120;
        c_forced_partial_prefix_bonus = 80;
        // Keep a broader single-char fallback pool so medium-rank common chars
        // (e.g. "锟? under "shi") are not dropped too early.
        c_forced_partial_max_candidates = c_candidate_total_limit_max;
    var
        syllables: TncPinyinParseResult;
        first_syllable: string;
        remaining_pinyin: string;
        fallback_lookup: TncCandidateList;
        forced_list: TncCandidateList;
        forced_count: Integer;
        idx: Integer;
        pass_idx: Integer;
        source_item: TncCandidate;
        forced_item: TncCandidate;
        trailing_count: Integer;
        prefer_common_single_char: Boolean;

        function try_build_syllables_from_comment_local(
            const comment_text: string; out out_syllables: TncPinyinParseResult): Boolean;
        var
            scan_idx: Integer;
            token_start: Integer;
            token_text: string;
            item_count: Integer;

            procedure append_token_local(const value: string);
            begin
                if value = '' then
                begin
                    Exit;
                end;
                SetLength(out_syllables, item_count + 1);
                out_syllables[item_count].text := normalize_pinyin_text(value);
                out_syllables[item_count].start_index := 0;
                out_syllables[item_count].length := Length(value);
                Inc(item_count);
            end;
        begin
            SetLength(out_syllables, 0);
            Result := False;
            if Trim(comment_text) = '' then
            begin
                Exit;
            end;

            item_count := 0;
            token_start := 1;
            for scan_idx := 1 to Length(comment_text) + 1 do
            begin
                if (scan_idx > Length(comment_text)) or
                    (comment_text[scan_idx] = ' ') then
                begin
                    token_text := Trim(Copy(comment_text, token_start,
                        scan_idx - token_start));
                    append_token_local(token_text);
                    token_start := scan_idx + 1;
                end;
            end;

            Result := Length(out_syllables) > 1;
        end;
    begin
        if m_dictionary = nil then
        begin
            Exit;
        end;

        if fallback_comment <> '' then
        begin
            try_build_syllables_from_comment_local(fallback_comment, syllables);
        end;
        if Length(syllables) <= 1 then
        begin
            syllables := get_effective_compact_pinyin_syllables(m_composition_text,
                allow_relaxed_missing_apostrophe);
        end;

        if Length(syllables) <= 1 then
        begin
            Exit;
        end;

        first_syllable := normalize_pinyin_text(syllables[0].text);
        if first_syllable = '' then
        begin
            Exit;
        end;

        remaining_pinyin := '';
        for idx := 1 to High(syllables) do
        begin
            remaining_pinyin := remaining_pinyin + syllables[idx].text;
        end;
        if remaining_pinyin = '' then
        begin
            Exit;
        end;

        if not dictionary_lookup_cached(first_syllable, fallback_lookup) then
        begin
            Exit;
        end;

        trailing_count := Length(syllables) - 1;
        SetLength(forced_list, 0);
        forced_count := 0;
        for pass_idx := 0 to 1 do
        begin
            prefer_common_single_char := pass_idx = 0;
            for idx := 0 to High(fallback_lookup) do
            begin
                source_item := fallback_lookup[idx];
                if not is_single_text_unit(Trim(source_item.text)) then
                begin
                    Continue;
                end;
                if not is_bmp_cjk_single_char_candidate(source_item) then
                begin
                    Continue;
                end;
                if prefer_common_single_char then
                begin
                    if not is_preferred_partial_single_char_candidate(source_item) then
                    begin
                        Continue;
                    end;
                end
                else if is_preferred_partial_single_char_candidate(source_item) then
                begin
                    Continue;
                end;

                forced_item := source_item;
                forced_item.comment := remaining_pinyin;
                forced_item.score := source_item.score + c_forced_partial_prefix_bonus -
                    (trailing_count * c_forced_partial_penalty_per_syllable);
                Inc(forced_item.score, get_demonstrative_head_partial_score_adjustment_local(
                    syllables, forced_item.text, 1));

                SetLength(forced_list, forced_count + 1);
                forced_list[forced_count] := forced_item;
                Inc(forced_count);
                if forced_count >= c_forced_partial_max_candidates then
                begin
                    Break;
                end;
            end;

            if forced_count >= c_forced_partial_max_candidates then
            begin
                Break;
            end;
        end;

        if forced_count <= 0 then
        begin
            Exit;
        end;

        candidates := merge_candidate_lists(candidates, forced_list, 0);
    end;

    procedure ensure_fast_prefix_single_char_partials_visible(
        var candidates: TncCandidateList; const max_count: Integer);
    const
        c_fast_partial_penalty_per_syllable = 120;
        c_fast_partial_prefix_bonus = 80;
    var
        syllables: TncPinyinParseResult;
        first_syllable: string;
        remaining_pinyin: string;
        fallback_lookup: TncCandidateList;
        forced_list: TncCandidateList;
        forced_count: Integer;
        idx: Integer;
        pass_idx: Integer;
        source_item: TncCandidate;
        forced_item: TncCandidate;
        trailing_count: Integer;
        prefer_common_single_char: Boolean;

        function try_build_syllables_from_comment_local(
            const comment_text: string; out out_syllables: TncPinyinParseResult): Boolean;
        var
            scan_idx: Integer;
            token_start: Integer;
            token_text: string;
            item_count: Integer;

            procedure append_token_local(const value: string);
            begin
                if value = '' then
                begin
                    Exit;
                end;
                SetLength(out_syllables, item_count + 1);
                out_syllables[item_count].text := normalize_pinyin_text(value);
                out_syllables[item_count].start_index := 0;
                out_syllables[item_count].length := Length(value);
                Inc(item_count);
            end;
        begin
            SetLength(out_syllables, 0);
            Result := False;
            if Trim(comment_text) = '' then
            begin
                Exit;
            end;

            item_count := 0;
            token_start := 1;
            for scan_idx := 1 to Length(comment_text) + 1 do
            begin
                if (scan_idx > Length(comment_text)) or
                    (comment_text[scan_idx] = ' ') then
                begin
                    token_text := Trim(Copy(comment_text, token_start,
                        scan_idx - token_start));
                    append_token_local(token_text);
                    token_start := scan_idx + 1;
                end;
            end;

            Result := Length(out_syllables) > 1;
        end;
    begin
        if (m_dictionary = nil) or (max_count < 0) then
        begin
            Exit;
        end;

        if fallback_comment <> '' then
        begin
            try_build_syllables_from_comment_local(fallback_comment, syllables);
        end;
        if Length(syllables) <= 1 then
        begin
            syllables := get_effective_compact_pinyin_syllables(m_composition_text,
                allow_relaxed_missing_apostrophe);
        end;
        if Length(syllables) <= 1 then
        begin
            Exit;
        end;

        first_syllable := syllables[0].text;
        if first_syllable = '' then
        begin
            Exit;
        end;

        remaining_pinyin := '';
        for idx := 1 to High(syllables) do
        begin
            remaining_pinyin := remaining_pinyin + syllables[idx].text;
        end;
        if remaining_pinyin = '' then
        begin
            Exit;
        end;

        if not dictionary_lookup_cached(first_syllable, fallback_lookup) then
        begin
            Exit;
        end;

        trailing_count := Length(syllables) - 1;
        SetLength(forced_list, 0);
        forced_count := 0;
        for pass_idx := 0 to 1 do
        begin
            prefer_common_single_char := pass_idx = 0;
            for idx := 0 to High(fallback_lookup) do
            begin
                source_item := fallback_lookup[idx];
                if not is_single_text_unit(Trim(source_item.text)) then
                begin
                    Continue;
                end;
                if not is_bmp_cjk_single_char_candidate(source_item) then
                begin
                    Continue;
                end;
                if prefer_common_single_char then
                begin
                    if not is_preferred_partial_single_char_candidate(source_item) then
                    begin
                        Continue;
                    end;
                end
                else if is_preferred_partial_single_char_candidate(source_item) then
                begin
                    Continue;
                end;

                forced_item := source_item;
                forced_item.comment := remaining_pinyin;
                forced_item.score := source_item.score + c_fast_partial_prefix_bonus -
                    (trailing_count * c_fast_partial_penalty_per_syllable);
                SetLength(forced_list, forced_count + 1);
                forced_list[forced_count] := forced_item;
                Inc(forced_count);
                if (max_count > 0) and (forced_count >= max_count) then
                begin
                    Break;
                end;
            end;

            if (max_count > 0) and (forced_count >= max_count) then
            begin
                Break;
            end;
        end;

        if forced_count > 0 then
        begin
            candidates := merge_candidate_lists(candidates, forced_list, 0);
        end;
    end;

    procedure ensure_best_first_syllable_single_partial_visible(
        var candidates: TncCandidateList; const requested_target_index: Integer);
    const
        c_fast_partial_penalty_per_syllable = 120;
        c_fast_partial_prefix_bonus = 80;
    var
        syllables: TncPinyinParseResult;
        first_syllable: string;
        remaining_pinyin: string;
        fallback_lookup: TncCandidateList;
        best_candidate: TncCandidate;
        source_item: TncCandidate;
        partial_candidate: TncCandidate;
        idx: Integer;
        best_weight: Integer;
        source_weight: Integer;
        partial_index: Integer;
        target_index: Integer;
        trailing_count: Integer;
        preferred_strength: Integer;
        is_demonstrative_preferred: Boolean;

        function try_build_syllables_from_comment_local(
            const comment_text: string; out out_syllables: TncPinyinParseResult): Boolean;
        var
            scan_idx: Integer;
            token_start: Integer;
            token_text: string;
            item_count: Integer;

            procedure append_token_local(const value: string);
            begin
                if value = '' then
                begin
                    Exit;
                end;
                SetLength(out_syllables, item_count + 1);
                out_syllables[item_count].text := normalize_pinyin_text(value);
                out_syllables[item_count].start_index := 0;
                out_syllables[item_count].length := Length(value);
                Inc(item_count);
            end;
        begin
            SetLength(out_syllables, 0);
            Result := False;
            if Trim(comment_text) = '' then
            begin
                Exit;
            end;

            item_count := 0;
            token_start := 1;
            for scan_idx := 1 to Length(comment_text) + 1 do
            begin
                if (scan_idx > Length(comment_text)) or
                    (comment_text[scan_idx] = ' ') then
                begin
                    token_text := Trim(Copy(comment_text, token_start,
                        scan_idx - token_start));
                    append_token_local(token_text);
                    token_start := scan_idx + 1;
                end;
            end;

            Result := Length(out_syllables) > 1;
        end;
    begin
        if (m_dictionary = nil) or (Length(candidates) = 0) then
        begin
            Exit;
        end;

        if fallback_comment <> '' then
        begin
            try_build_syllables_from_comment_local(fallback_comment, syllables);
        end;
        if Length(syllables) <= 1 then
        begin
            syllables := get_effective_compact_pinyin_syllables(m_composition_text,
                allow_relaxed_missing_apostrophe);
        end;
        if Length(syllables) <= 1 then
        begin
            Exit;
        end;

        first_syllable := normalize_pinyin_text(syllables[0].text);
        if first_syllable = '' then
        begin
            Exit;
        end;

        remaining_pinyin := '';
        for idx := 1 to High(syllables) do
        begin
            remaining_pinyin := remaining_pinyin + normalize_pinyin_text(
                syllables[idx].text);
        end;
        if remaining_pinyin = '' then
        begin
            Exit;
        end;

        is_demonstrative_preferred :=
            try_get_preferred_demonstrative_head_single_char_local(
            syllables, 1, best_candidate, preferred_strength);
        if is_demonstrative_preferred then
        begin
            best_weight := preferred_strength;
        end
        else
        begin
            if not dictionary_lookup_cached(first_syllable, fallback_lookup) then
            begin
                Exit;
            end;

            best_weight := Low(Integer);
            FillChar(best_candidate, SizeOf(best_candidate), 0);
            for idx := 0 to High(fallback_lookup) do
            begin
                source_item := fallback_lookup[idx];
                if (Trim(source_item.comment) <> '') or
                    (not is_single_text_unit(Trim(source_item.text))) then
                begin
                    Continue;
                end;

                source_weight := source_item.score;
                if source_item.has_dict_weight and
                    (source_item.dict_weight > source_weight) then
                begin
                    source_weight := source_item.dict_weight;
                end;
                if source_weight > best_weight then
                begin
                    best_weight := source_weight;
                    best_candidate := source_item;
                end;
            end;
        end;

        if (best_weight = Low(Integer)) or (Trim(best_candidate.text) = '') then
        begin
            Exit;
        end;

        partial_index := -1;
        for idx := 0 to High(candidates) do
        begin
            if SameText(Trim(candidates[idx].text), Trim(best_candidate.text)) and
                SameText(Trim(candidates[idx].comment), remaining_pinyin) then
            begin
                partial_index := idx;
                Break;
            end;
        end;

        if partial_index < 0 then
        begin
            partial_candidate := best_candidate;
            partial_candidate.comment := remaining_pinyin;
            trailing_count := Length(syllables) - 1;
            partial_candidate.score := best_candidate.score +
                c_fast_partial_prefix_bonus -
                (trailing_count * c_fast_partial_penalty_per_syllable);
            if best_candidate.has_dict_weight then
            begin
                partial_candidate.dict_weight := best_candidate.dict_weight;
            end;
            SetLength(candidates, Length(candidates) + 1);
            partial_index := High(candidates);
            candidates[partial_index] := partial_candidate;
        end;

        if is_demonstrative_preferred then
        begin
            target_index := 0;
        end
        else
        begin
            target_index := requested_target_index;
        end;
        if target_index < 0 then
        begin
            target_index := 0;
        end;
        if target_index >= get_candidate_limit then
        begin
            target_index := get_candidate_limit - 1;
        end;
        if target_index >= Length(candidates) then
        begin
            target_index := Length(candidates) - 1;
        end;
        if (target_index < 0) or (partial_index <= target_index) then
        begin
            Exit;
        end;

        partial_candidate := candidates[partial_index];
        for idx := partial_index downto target_index + 1 do
        begin
            candidates[idx] := candidates[idx - 1];
        end;
        candidates[target_index] := partial_candidate;
    end;

    procedure promote_short_unsupported_complete_prefix_partial(
        var candidates: TncCandidateList);
    const
        c_max_short_complete_syllables = 5;
    var
        top_candidate: TncCandidate;
        top_text: string;
        top_path: string;
        path_parts: TArray<string>;
        syllables: TncPinyinParseResult;
        exact_results: TncCandidateList;
        prefix_results: TncCandidateList;
        tail_results: TncCandidateList;
        prefix_text: string;
        last_segment_text: string;
        prefix_key: string;
        tail_key: string;
        last_segment_units: Integer;
        prefix_units: Integer;
        idx: Integer;
        part_idx: Integer;
        target_idx: Integer;
        exact_idx: Integer;
        moved_candidate: TncCandidate;

        function build_query_key_local(const start_idx: Integer;
            const unit_count: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (unit_count <= 0) or
                (start_idx + unit_count > Length(syllables)) then
            begin
                Exit;
            end;

            for local_idx := start_idx to start_idx + unit_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables[local_idx].text);
            end;
        end;

        function exact_full_query_has_complete_support_local: Boolean;
        var
            local_idx: Integer;
            exact_text: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (top_text = '') then
            begin
                Exit;
            end;

            if (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results)) and
                (not dictionary_lookup_cached(lookup_text, exact_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(exact_results) do
            begin
                exact_text := Trim(exact_results[local_idx].text);
                if (Trim(exact_results[local_idx].comment) = '') and
                    (get_candidate_text_unit_count(exact_text) =
                    input_syllable_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function prefix_text_has_exact_support_local: Boolean;
        var
            local_idx: Integer;
            exact_text: string;
        begin
            Result := False;
            if prefix_key = '' then
            begin
                Exit;
            end;

            if (not dictionary_exact_lookup_cached(prefix_key,
                prefix_results)) and
                (not dictionary_lookup_cached(prefix_key, prefix_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(prefix_results) do
            begin
                exact_text := Trim(prefix_results[local_idx].text);
                if (Trim(prefix_results[local_idx].comment) = '') and
                    SameText(exact_text, prefix_text) and
                    (get_candidate_text_unit_count(exact_text) =
                    prefix_units) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function tail_segment_has_weighted_support_local: Boolean;
        var
            local_idx: Integer;
            candidate_text: string;
        begin
            Result := False;
            if (tail_key = '') or (last_segment_text = '') then
            begin
                Exit;
            end;

            if (not dictionary_exact_lookup_cached(tail_key, tail_results)) and
                (not dictionary_lookup_cached(tail_key, tail_results)) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(tail_results) do
            begin
                candidate_text := Trim(tail_results[local_idx].text);
                if (Trim(tail_results[local_idx].comment) = '') and
                    SameText(candidate_text, last_segment_text) and
                    (get_candidate_text_unit_count(candidate_text) =
                    last_segment_units) and
                    tail_results[local_idx].has_dict_weight then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (Length(candidates) = 0) or (m_dictionary = nil) or
            (input_syllable_count < 4) or
            (input_syllable_count > c_max_short_complete_syllables) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        top_candidate := candidates[0];
        top_text := Trim(top_candidate.text);
        if (Trim(top_candidate.comment) <> '') or (top_text = '') or
            (top_candidate.source = cs_user) or
            (get_candidate_text_unit_count(top_text) <>
            input_syllable_count) then
        begin
            Exit;
        end;

        if exact_full_query_has_complete_support_local then
        begin
            Exit;
        end;

        top_path := get_segment_path_for_candidate(top_candidate);
        if (top_path = '') or (Pos(c_segment_path_separator, top_path) <= 0) then
        begin
            Exit;
        end;

        path_parts := top_path.Split([c_segment_path_separator]);
        if Length(path_parts) < 2 then
        begin
            Exit;
        end;

        last_segment_text := Trim(path_parts[High(path_parts)]);
        last_segment_units := get_candidate_text_unit_count(last_segment_text);
        if last_segment_units < 2 then
        begin
            Exit;
        end;

        prefix_units := input_syllable_count - last_segment_units;
        if prefix_units < 2 then
        begin
            Exit;
        end;

        syllables := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables) <> input_syllable_count then
        begin
            Exit;
        end;

        prefix_text := '';
        for part_idx := 0 to High(path_parts) - 1 do
        begin
            prefix_text := prefix_text + Trim(path_parts[part_idx]);
        end;
        if (prefix_text = '') or
            (get_candidate_text_unit_count(prefix_text) <> prefix_units) then
        begin
            Exit;
        end;

        prefix_key := build_query_key_local(0, prefix_units);
        tail_key := build_query_key_local(prefix_units, last_segment_units);
        if (tail_key = '') or (not prefix_text_has_exact_support_local) then
        begin
            Exit;
        end;
        if tail_segment_has_weighted_support_local then
        begin
            Exit;
        end;

        target_idx := -1;
        for idx := 1 to High(candidates) do
        begin
            if SameText(Trim(candidates[idx].text), prefix_text) and
                SameText(Trim(candidates[idx].comment), tail_key) then
            begin
                target_idx := idx;
                Break;
            end;
        end;
        if target_idx <= 0 then
        begin
            Exit;
        end;

        moved_candidate := candidates[target_idx];
        for exact_idx := target_idx downto 1 do
        begin
            candidates[exact_idx] := candidates[exact_idx - 1];
        end;
        candidates[0] := moved_candidate;
    end;

    procedure ensure_bounded_single_char_partial_pool(
        var candidates: TncCandidateList);
    var
        max_single_partials: Integer;
    begin
        if input_syllable_count >= 2 then
        begin
            if input_syllable_count <= 3 then
            begin
                max_single_partials := 0;
            end
            else if input_syllable_count <= 6 then
            begin
                max_single_partials := get_candidate_limit * 2;
            end
            else
            begin
                max_single_partials := get_candidate_limit + 3;
            end;
            ensure_fast_prefix_single_char_partials_visible(candidates,
                max_single_partials);
            Exit;
        end;

        ensure_forced_single_char_partial(candidates);
    end;

    procedure ensure_top_complete_candidate_prefix_partials_visible(
        var candidates: TncCandidateList);
    const
        c_max_query_syllables = 8;
        c_max_added_partials = 3;
        c_score_penalty_per_remaining_syllable = 80;
    var
        syllables_local: TncPinyinParseResult;
        anchor_idx: Integer;
        prefix_len: Integer;
        added_count: Integer;
        out_idx: Integer;
        source_idx: Integer;
        partial_idx: Integer;
        compressed_anchor_idx: Integer;
        units: TArray<string>;
        prefix_text: string;
        tail_comment: string;
        partials: TncCandidateList;

        function candidate_text_unit_count_local(const candidate: TncCandidate): Integer;
        begin
            Result := get_candidate_text_unit_count(Trim(candidate.text));
        end;

        function build_prefix_text_local(const local_prefix_len: Integer): string;
        var
            unit_idx: Integer;
        begin
            Result := '';
            for unit_idx := 0 to local_prefix_len - 1 do
            begin
                Result := Result + units[unit_idx];
            end;
        end;

        function build_tail_comment_local(const local_prefix_len: Integer): string;
        var
            syllable_idx: Integer;
        begin
            Result := '';
            for syllable_idx := local_prefix_len to High(syllables_local) do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[syllable_idx].text);
            end;
        end;

        function find_candidate_index_local(const local_text: string;
            const local_comment: string): Integer;
        var
            local_idx: Integer;
        begin
            Result := -1;
            for local_idx := 0 to High(candidates) do
            begin
                if SameText(Trim(candidates[local_idx].text), local_text) and
                    SameText(Trim(candidates[local_idx].comment),
                    local_comment) then
                begin
                    Exit(local_idx);
                end;
            end;
        end;

        function has_partial_local(const local_text: string;
            const local_comment: string): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            for local_idx := 0 to High(partials) do
            begin
                if SameText(Trim(partials[local_idx].text), local_text) and
                    SameText(Trim(partials[local_idx].comment),
                    local_comment) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure append_partial_local(const anchor_candidate: TncCandidate;
            const local_prefix_len: Integer);
        var
            local_partial: TncCandidate;
            local_remaining_count: Integer;
            existing_idx: Integer;
        begin
            if added_count >= c_max_added_partials then
            begin
                Exit;
            end;

            prefix_text := build_prefix_text_local(local_prefix_len);
            tail_comment := build_tail_comment_local(local_prefix_len);
            if (prefix_text = '') or (tail_comment = '') or
                has_partial_local(prefix_text, tail_comment) then
            begin
                Exit;
            end;

            local_remaining_count := Length(syllables_local) - local_prefix_len;
            existing_idx := find_candidate_index_local(prefix_text, tail_comment);
            if existing_idx >= 0 then
            begin
                local_partial := candidates[existing_idx];
            end
            else
            begin
                local_partial := anchor_candidate;
                local_partial.text := prefix_text;
                local_partial.comment := tail_comment;
                local_partial.score := Max(1, anchor_candidate.score -
                    (local_remaining_count *
                    c_score_penalty_per_remaining_syllable));
                if local_partial.has_dict_weight then
                begin
                    local_partial.dict_weight := Max(1,
                        local_partial.dict_weight -
                        (local_remaining_count *
                        c_score_penalty_per_remaining_syllable));
                end;
            end;

            SetLength(partials, Length(partials) + 1);
            partials[High(partials)] := local_partial;
            Inc(added_count);
        end;

        function is_promoted_partial_local(const candidate: TncCandidate): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            for local_idx := 0 to High(partials) do
            begin
                if SameText(Trim(partials[local_idx].text),
                    Trim(candidate.text)) and
                    SameText(Trim(partials[local_idx].comment),
                    Trim(candidate.comment)) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (Length(candidates) = 0) or (input_syllable_count < 2) or
            (input_syllable_count > c_max_query_syllables) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            m_composition_text, allow_relaxed_missing_apostrophe);
        if Length(syllables_local) <> input_syllable_count then
        begin
            Exit;
        end;

        anchor_idx := -1;
        for source_idx := 0 to Min(High(candidates), 2) do
        begin
            if (Trim(candidates[source_idx].comment) = '') and
                (candidate_text_unit_count_local(candidates[source_idx]) =
                input_syllable_count) then
            begin
                anchor_idx := source_idx;
                Break;
            end;
        end;
        if anchor_idx < 0 then
        begin
            Exit;
        end;

        units := split_text_units(Trim(candidates[anchor_idx].text));
        if Length(units) <> input_syllable_count then
        begin
            Exit;
        end;

        SetLength(partials, 0);
        added_count := 0;
        for prefix_len := Length(units) - 1 downto 1 do
        begin
            append_partial_local(candidates[anchor_idx], prefix_len);
            if added_count >= c_max_added_partials then
            begin
                Break;
            end;
        end;
        if added_count <= 0 then
        begin
            Exit;
        end;

        SetLength(partials, added_count);
        out_idx := 0;
        compressed_anchor_idx := -1;
        for source_idx := 0 to High(candidates) do
        begin
            if (source_idx <> anchor_idx) and
                is_promoted_partial_local(candidates[source_idx]) then
            begin
                Continue;
            end;
            if source_idx = anchor_idx then
            begin
                compressed_anchor_idx := out_idx;
            end;
            candidates[out_idx] := candidates[source_idx];
            Inc(out_idx);
        end;
        if compressed_anchor_idx < 0 then
        begin
            Exit;
        end;
        SetLength(candidates, out_idx + added_count);
        for source_idx := High(candidates) - added_count downto
            compressed_anchor_idx + 1 do
        begin
            candidates[source_idx + added_count] := candidates[source_idx];
        end;
        out_idx := compressed_anchor_idx + 1;
        for partial_idx := 0 to High(partials) do
        begin
            candidates[out_idx] := partials[partial_idx];
            Inc(out_idx);
        end;
    end;

