                begin
                    Exit;
                end;

                if is_de_adverbial_left_unit_context_local(left_last_unit_local) and
                    is_de_adverbial_predicate_head_unit_context_local(
                    next_unit_local) then
                begin
                    replacement_text_local := string(Char($5730));
                    out_adjustment_local := 22000;
                end
                else if is_predicate_head_unit_context_local(left_last_unit_local) and
                    is_result_complement_head_unit_context_local(next_unit_local) then
                begin
                    replacement_text_local := string(Char($5F97));
                    out_adjustment_local := 18000;
                end;
            end
            else if (normalized_key_local = 'yu') and
                (is_text_unit_code_context_local(particle_unit_local, $4E0E) or
                is_text_unit_code_context_local(particle_unit_local, $4E8E)) then
            begin
                if is_text_unit_code_context_local(particle_unit_local, $4E0E) and
                    is_text_unit_code_context_local(next_unit_local, $662F) then
                begin
                    replacement_text_local := string(Char($4E8E));
                    out_adjustment_local := 52000;
                end
                else if is_bound_yu_preposition_left_unit_context_local(
                    left_last_unit_local) and
                    (not is_text_unit_code_context_local(particle_unit_local,
                    $4E8E)) then
                begin
                    replacement_text_local := string(Char($4E8E));
                    out_adjustment_local := 42000;
                end
                else if (not is_bound_yu_preposition_left_unit_context_local(
                    left_last_unit_local)) and
                    is_text_unit_code_context_local(particle_unit_local,
                    $4E8E) and
                    is_nominal_or_pronoun_head_unit_context_local(
                    next_unit_local) then
                begin
                    replacement_text_local := string(Char($4E0E));
                    out_adjustment_local := 16000;
                end;
            end
            else if (normalized_key_local = 'wei') and
                (is_text_unit_code_context_local(particle_unit_local, $4E3A) or
                is_text_unit_code_context_local(particle_unit_local, $672A)) then
            begin
                if is_wei_degree_left_unit_context_local(left_last_unit_local) and
                    is_de_adverbial_left_unit_context_local(next_unit_local) and
                    is_text_unit_code_context_local(particle_unit_local, $672A) then
                begin
                    replacement_text_local := string(Char($4E3A));
                    out_adjustment_local := 36000;
                end;
            end
            else
            begin
                Exit;
            end;

            if replacement_text_local = '' then
            begin
                if m_config.debug_mode and (ctxalt_miss_debug_count < 8) then
                begin
                    Inc(ctxalt_miss_debug_count);
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' ctxalt_miss=[left=%s next=%s key=%s suffix=%s]',
                        [left_last_unit_local, next_unit_local,
                        normalized_key_local, suffix_text_local]);
                end;
                Exit;
            end;

            out_suffix_text_local := replacement_text_local;
            for unit_idx_local := 1 to High(suffix_units_local) do
            begin
                out_suffix_text_local := out_suffix_text_local +
                    suffix_units_local[unit_idx_local];
            end;

            out_suffix_path_local := replacement_text_local;
            separator_pos_local := Pos(c_segment_path_separator, suffix_path_local);
            if separator_pos_local > 0 then
            begin
                out_suffix_path_local := out_suffix_path_local +
                    Copy(suffix_path_local, separator_pos_local, MaxInt);
            end;

            Result := out_suffix_text_local <> '';
        end;

        function has_particle_tail_mismatch_local(const query_key_local: string;
            const text_local: string; const raw_weight_local: Integer): Boolean;
        var
            syllables_local: TncPinyinParseResult;
            last_syllable_local: string;
            last_unit_local: string;
        begin
            Result := False;
            syllables_local := get_effective_compact_pinyin_syllables(
                query_key_local);
            if Length(syllables_local) = 0 then
            begin
                Exit;
            end;

            last_syllable_local := normalize_pinyin_text(
                syllables_local[High(syllables_local)].text);
            if (last_syllable_local <> 'de') and (last_syllable_local <> 'le') then
            begin
                Exit;
            end;

            last_unit_local := get_last_text_unit_local(text_local);
            if last_syllable_local = 'de' then
            begin
                Result := (last_unit_local <> string(Char($7684))) and
                    (last_unit_local <> string(Char($5730))) and
                    (last_unit_local <> string(Char($5F97))) and
                    (raw_weight_local < 900);
            end
            else if last_syllable_local = 'le' then
            begin
                Result := (last_unit_local <> string(Char($4E86))) and
                    (last_unit_local <> string(Char($4E50))) and
                    (raw_weight_local < 900);
            end;
        end;

        function is_nonbase_two_plus_single_exact_chunk_local(
            const query_key_local: string; const chunk_len_local: Integer;
            const text_local: string): Boolean;
        var
            syllables_local: TncPinyinParseResult;
            units_local: TArray<string>;
            head_key_local: string;
            tail_key_local: string;
            tail_syllable_local: string;
            head_text_local: string;
            tail_text_local: string;
        begin
            Result := False;
            if (m_dictionary = nil) or (chunk_len_local <> 3) then
            begin
                Exit;
            end;
            if m_dictionary.is_base_entry(query_key_local, text_local) or
                m_dictionary.is_user_entry(query_key_local, text_local) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                query_key_local);
            units_local := split_text_units(Trim(text_local));
            if (Length(syllables_local) <> 3) or (Length(units_local) <> 3) then
            begin
                Exit;
            end;

            tail_syllable_local := normalize_pinyin_text(
                syllables_local[2].text);
            if (tail_syllable_local = 'de') or (tail_syllable_local = 'le') or
                (tail_syllable_local = 'la') or (tail_syllable_local = 'ba') or
                (tail_syllable_local = 'ma') then
            begin
                Exit;
            end;

            head_key_local := normalize_pinyin_text(syllables_local[0].text) +
                normalize_pinyin_text(syllables_local[1].text);
            tail_key_local := tail_syllable_local;
            head_text_local := units_local[0] + units_local[1];
            tail_text_local := units_local[2];

            Result := direct_exact_lookup_has_text_local(head_key_local,
                head_text_local, 2) and
                (direct_exact_lookup_has_text_local(tail_key_local,
                tail_text_local, 1) or
                m_dictionary.single_char_matches_pinyin(tail_key_local,
                tail_text_local));
        end;

        function is_reliable_fast_exact_chunk_local(
            const query_key_local: string; const chunk_len_local: Integer;
            const text_local: string; const candidate_local: TncCandidate): Boolean;
        var
            raw_weight_local: Integer;
            preferred_bonus_local: Integer;
            min_weight_local: Integer;
        begin
            Result := True;
            if not long_exact_chunk_weight_is_eligible(
                candidate_local.dict_weight, candidate_local.has_dict_weight) then
            begin
                Exit(False);
            end;
            if chunk_len_local <= 1 then
            begin
                Exit;
            end;

            if is_nonbase_two_plus_single_exact_chunk_local(query_key_local,
                chunk_len_local, text_local) then
            begin
                Exit(False);
            end;

            raw_weight_local := get_exact_chunk_raw_weight_local(candidate_local);
            if has_particle_tail_mismatch_local(query_key_local, text_local,
                raw_weight_local) then
            begin
                Exit(False);
            end;

            preferred_bonus_local := get_preferred_query_phrase_bonus_local(
                query_key_local, text_local);
            case chunk_len_local of
                2:
                    min_weight_local := 240;
                3:
                    min_weight_local := 260;
                4:
                    min_weight_local := 220;
            else
                min_weight_local := 200;
            end;

            if (raw_weight_local < min_weight_local) and
                (preferred_bonus_local <= 0) then
            begin
                Result := False;
            end;
        end;

        function has_high_quality_exact_phrase_for_key_local(
            const query_key_local: string; const expected_units_local: Integer;
            const min_weight_local: Integer): Boolean;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
        begin
            Result := False;
            if (query_key_local = '') or (m_dictionary = nil) then
            begin
                Exit;
            end;
            if not lookup_exact_full_pinyin_cached_local(query_key_local,
                local_results) then
            begin
                Exit;
            end;
            for local_idx := 0 to Min(High(local_results), c_chain_probe_limit - 1) do
            begin
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                local_text := Trim(local_results[local_idx].text);
                if (get_candidate_text_unit_count(local_text) = expected_units_local) and
                    (get_exact_chunk_raw_weight_local(local_results[local_idx]) >=
                    min_weight_local) and
                    is_reliable_fast_exact_chunk_local(query_key_local,
                    expected_units_local, local_text, local_results[local_idx]) then
                begin
                    Exit(True);
                end;
            end;
        end;

