    procedure swap_items(const left_index: Integer; const right_index: Integer);
    var
        tmp: TncCandidateSortItem;
    begin
        tmp := list[left_index];
        list[left_index] := list[right_index];
        list[right_index] := tmp;
    end;

    procedure apply_front_row_conservative_guard;
    var
        top_item: TncCandidateSortItem;
        alt_item: TncCandidateSortItem;
        alt_idx: Integer;
        margin: Integer;
        score_gap: Integer;
        path_gap: Integer;
        function is_nonlex_full_complete_item(const sort_item: TncCandidateSortItem): Boolean;
        begin
            Result := (sort_item.candidate.comment = '') and
                (sort_item.text_units = m_last_lookup_syllable_count) and
                (sort_item.candidate.source <> cs_user) and
                (not sort_item.candidate.has_dict_weight);
        end;
    begin
        if list.Count < 2 then
        begin
            Exit;
        end;

        top_item := list[0];
        if is_nonlex_full_complete_item(top_item) then
        begin
            Exit;
        end;
        if top_item.is_prioritized_user_phrase or
            (top_item.candidate.source = cs_user) or
            top_item.is_latest_context_query_choice or top_item.is_latest_query_choice or
            (top_item.candidate.comment <> '') or
            (top_item.confidence_rank <= 1) then
        begin
            Exit;
        end;

        for alt_idx := 1 to Min(list.Count - 1, 4) do
        begin
            alt_item := list[alt_idx];
            if is_nonlex_full_complete_item(alt_item) then
            begin
                Continue;
            end;
            if alt_item.candidate.comment <> '' then
            begin
                Continue;
            end;
            if top_item.is_full_query_exact_dict_text and
                (alt_item.segment_path_count > 1) and
                (not (alt_item.is_sentence_particle_tail_split and
                (top_item.candidate.dict_weight < 1600))) then
            begin
                Continue;
            end;
            if alt_item.confidence_rank > top_item.confidence_rank then
            begin
                Continue;
            end;
            if (alt_item.confidence_rank = top_item.confidence_rank) and
                (alt_item.path_confidence_score <= top_item.path_confidence_score + 160) then
            begin
                Continue;
            end;
            if use_intent_layers and (alt_item.layer > top_item.layer + 1) then
            begin
                Continue;
            end;

            score_gap := top_item.rank_score - alt_item.rank_score;
            margin := Max(top_item.conservative_margin, alt_item.conservative_margin);
            path_gap := alt_item.path_confidence_score - top_item.path_confidence_score;
            if path_gap > 0 then
            begin
                Inc(margin, Min(96, path_gap div 3));
            end;
            if score_gap <= margin then
            begin
                swap_items(0, alt_idx);
                Break;
            end;
        end;
    end;

    procedure promote_short_exact_complete_score_leader;
    const
        c_short_exact_score_margin = 96;
    var
        idx: Integer;
        best_idx: Integer;
        best_score: Integer;
        item_score: Integer;
        top_score: Integer;
        picked: TncCandidateSortItem;

        function is_short_exact_complete_item(
            const sort_item: TncCandidateSortItem): Boolean;
        begin
            Result := (m_last_lookup_syllable_count >= 2) and
                (m_last_lookup_syllable_count <= 3) and
                (sort_item.candidate.comment = '') and
                (sort_item.text_units = m_last_lookup_syllable_count) and
                (sort_item.candidate.has_dict_weight or
                (sort_item.candidate.source = cs_user));
        end;

        function get_short_exact_order_score(
            const sort_item: TncCandidateSortItem): Integer;
        begin
            Result := sort_item.candidate.score;
            if sort_item.candidate.has_dict_weight then
            begin
                Result := sort_item.candidate.dict_weight;
            end;
            if sort_item.candidate.source = cs_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
        end;
    begin
        if (list.Count < 2) or (m_last_lookup_syllable_count < 2) or
            (m_last_lookup_syllable_count > 3) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_score := Low(Integer);
        for idx := 0 to list.Count - 1 do
        begin
            if not is_short_exact_complete_item(list[idx]) then
            begin
                Continue;
            end;

            item_score := get_short_exact_order_score(list[idx]);
            if (best_idx < 0) or (item_score > best_score) or
                ((item_score = best_score) and
                (list[idx].rank_score > list[best_idx].rank_score)) then
            begin
                best_idx := idx;
                best_score := item_score;
            end;
        end;

        if best_idx <= 0 then
        begin
            Exit;
        end;

        if (list[0].candidate.source = cs_user) and
            (list[best_idx].candidate.source <> cs_user) then
        begin
            Exit;
        end;

        top_score := get_short_exact_order_score(list[0]);
        if is_short_exact_complete_item(list[0]) and
            (best_score <= top_score + c_short_exact_score_margin) then
        begin
            Exit;
        end;

        picked := list[best_idx];
        for idx := best_idx downto 1 do
        begin
            list[idx] := list[idx - 1];
        end;
        list[0] := picked;
    end;
begin
    if Length(candidates) <= 1 then
    begin
        Exit;
    end;

    use_intent_layers := m_last_lookup_syllable_count >= 3;
    has_strong_complete_phrase := False;
    has_competing_exact_phrase := False;
    has_weighted_complete_phrase := False;
    weak_chain_query_prepared := False;
    SetLength(weak_chain_query_syllables, 0);
    SetLength(weak_chain_preference_maps, 0);
    partial_comment_syllable_cache := TDictionary<string, Integer>.Create;
    best_one_plus_two_partial_score := Low(Integer);
    best_two_plus_one_partial_score := Low(Integer);
    has_boundary_anchor_one_plus_two := False;
    has_boundary_anchor_two_plus_one := False;
    preferred_three_syllable_partial_kind := m_last_three_syllable_partial_preference_kind;
    fixed_top_single_char_text := get_fixed_top_single_char_for_query_local;
    full_query_exact_text_weights := nil;

    list := TList<TncCandidateSortItem>.Create;
    try
        list.Capacity := Length(candidates);
        for i := 0 to High(candidates) do
        begin
            item.candidate := candidates[i];
            item.rank_score := get_rank_score(candidates[i]);
            if use_intent_layers then
            begin
                item.layer := get_multi_syllable_intent_layer(candidates[i]);
            end
            else
            begin
                item.layer := 0;
            end;
            item.confidence_rank := get_candidate_confidence_rank(candidates[i]);
            item.path_confidence_score := get_candidate_path_confidence_score(candidates[i]);
            if is_runtime_chain_candidate(candidates[i]) then
            begin
                item.conservative_margin := 280;
            end
            else if is_runtime_common_pattern_candidate(candidates[i]) then
