                end;

                if unit_matches_local(candidate_units_local[local_idx], $662F) and
                    (unit_matches_local(top_units_local[local_idx], $89C6) or
                    unit_matches_local(top_units_local[local_idx], $5B9E)) and
                    (local_idx + 1 <= High(candidate_units_local)) and
                    unit_matches_local(candidate_units_local[local_idx + 1],
                    $4E3A) then
                begin
                    local_supported := True;
                    Continue;
                end;

                Exit(False);
            end;

            Result := local_supported;
        end;

    begin
        if short_exact_query_mode or (Length(m_candidates) < 2) or
            (expected_units < 6) or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;

        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_units_local := split_text_units(Trim(m_candidates[idx].text));
            if (Length(candidate_units_local) = expected_units) and
                candidate_has_supported_function_context_local then
            begin
                force_move_display_candidate_to_index(idx, 0);
                Exit;
            end;
        end;
    end;

