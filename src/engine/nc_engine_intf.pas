    procedure promote_long_full_query_exact_over_chain_candidate_local(
        var candidates: TncCandidateList; const chain_score_value: Integer);
    const
        c_exact_probe_limit = 12;
        c_exact_over_chain_bonus = 30000;
    var
        exact_results_local: TncCandidateList;
        exact_idx_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_text_local: string;
        candidate_rank_local: Integer;
        existing_idx_local: Integer;
        move_idx_local: Integer;
        picked_candidate_local: TncCandidate;
    begin
        if (m_dictionary = nil) or (Length(candidates) = 0) or
            (input_syllable_count < 5) or (not is_full_pinyin_key(lookup_text)) or
            (not lookup_exact_full_pinyin_cached_local(lookup_text,
            exact_results_local)) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for exact_idx_local := 0 to High(exact_results_local) do
        begin
            if exact_idx_local >= c_exact_probe_limit then
            begin
                Break;
            end;
            if Trim(exact_results_local[exact_idx_local].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(exact_results_local[exact_idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;

            if exact_results_local[exact_idx_local].has_dict_weight then
            begin
                candidate_rank_local := exact_results_local[exact_idx_local].dict_weight;
            end
            else
            begin
                candidate_rank_local := exact_results_local[exact_idx_local].score;
            end;
            Inc(candidate_rank_local, get_session_query_bonus(candidate_text_local));
            Inc(candidate_rank_local, m_dictionary.get_query_choice_bonus(
                lookup_text, candidate_text_local) * 20);
            if is_latest_session_query_choice(candidate_text_local) then
            begin
                Inc(candidate_rank_local, 200000);
            end;
            if exact_results_local[exact_idx_local].source = cs_user then
            begin
                Inc(candidate_rank_local, 2048);
            end;

            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := exact_idx_local;
            end;
        end;

        if best_idx_local < 0 then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' lfq=[none n=%d]', [Length(exact_results_local)]);
            end;
            Exit;
        end;

        picked_candidate_local := exact_results_local[best_idx_local];
        picked_candidate_local.text := Trim(picked_candidate_local.text);
        picked_candidate_local.comment := '';
        picked_candidate_local.score := Max(picked_candidate_local.score,
            chain_score_value + c_exact_over_chain_bonus);

        existing_idx_local := -1;
        for move_idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[move_idx_local].comment) = '') and
                SameText(Trim(candidates[move_idx_local].text),
                picked_candidate_local.text) then
            begin
                existing_idx_local := move_idx_local;
                Break;
            end;
        end;

        if existing_idx_local > 0 then
        begin
            candidates[existing_idx_local].score := Max(
                candidates[existing_idx_local].score,
                picked_candidate_local.score);
            picked_candidate_local := candidates[existing_idx_local];
            for move_idx_local := existing_idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_candidate_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' lfq=[move idx=%d rank=%d]', [existing_idx_local,
                    best_rank_local]);
            end;
        end
        else if existing_idx_local < 0 then
        begin
            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_candidate_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' lfq=[insert rank=%d]', [best_rank_local]);
            end;
        end
        else
        begin
            candidates[0].score := Max(candidates[0].score,
                picked_candidate_local.score);
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' lfq=[top rank=%d]', [best_rank_local]);
            end;
        end;
    end;

