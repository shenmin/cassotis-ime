            function has_quantity_modal_tail_mismatch_fast_visible_local(
                const text_value_local: string): Boolean;
            var
                local_units: TArray<string>;
                local_syllables: TncPinyinParseResult;
                local_idx: Integer;
                key0: string;
                key1: string;
                key2: string;
                expected_text: string;
            begin
                Result := False;
                local_units := split_text_units(Trim(text_value_local));
                local_syllables := get_effective_compact_pinyin_syllables(
                    lookup_text);
                if (Length(local_units) <> input_syllable_count) or
                    (Length(local_syllables) <> input_syllable_count) then
                begin
                    Exit;
                end;

                for local_idx := 0 to input_syllable_count - 2 do
                begin
                    key0 := normalize_pinyin_text(local_syllables[local_idx].text);
                    key1 := normalize_pinyin_text(local_syllables[local_idx + 1].text);
                    if (not SameText(key0, 'yi')) or
                        (not is_quantity_tail_key_fast_visible_local(key1)) then
                    begin
                        Continue;
                    end;

                    expected_text := get_fixed_quantity_text_fast_visible_local(key0) +
                        get_fixed_quantity_text_fast_visible_local(key1);
                    if (expected_text <> '') and (not SameText(local_units[local_idx] +
                        local_units[local_idx + 1], expected_text)) then
                    begin
                        Exit(True);
                    end;

                    if local_idx + 2 >= input_syllable_count then
                    begin
                        Continue;
                    end;
                    key2 := normalize_pinyin_text(
                        local_syllables[local_idx + 2].text);
                    if not SameText(key2, 'ba') then
                    begin
                        Continue;
                    end;
                    expected_text := expected_text +
                        get_fixed_quantity_text_fast_visible_local(key2);
                    if (expected_text <> '') and (not SameText(local_units[local_idx] +
                        local_units[local_idx + 1] + local_units[local_idx + 2],
                        expected_text)) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            if input_syllable_count < 6 then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_metric_local := Low(Integer);
            best_path_local := '';
            for local_idx := 0 to Min(c_fast_visible_probe_limit - 1,
                High(candidates)) do
            begin
                if Trim(candidates[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                local_candidate_text := Trim(candidates[local_idx].text);
                if (local_candidate_text = '') or
                    (get_candidate_text_unit_count(local_candidate_text) <>
                    input_syllable_count) then
                begin
                    Continue;
                end;

                local_path_preference := 0;
                local_support_path := infer_segment_path_for_query_text_with_score(
                    lookup_text, local_candidate_text, local_support_score,
                    local_path_preference);
                if local_support_path = '' then
                begin
                    Continue;
                end;

                current_metric_local := local_support_score +
                    get_preferred_query_phrase_bonus_local(lookup_text,
                    local_candidate_text);
                Inc(current_metric_local,
                    get_directional_context_metric_bonus_local(
                    local_candidate_text));
                FillChar(local_problematic_candidate,
                    SizeOf(local_problematic_candidate), 0);
                local_problematic_candidate.text := local_candidate_text;
                local_problematic_candidate.comment := '';
                if is_problematic_single_char_chain_candidate_for_query(
                    lookup_text, local_problematic_candidate) then
                begin
                    Dec(current_metric_local, 1536);
                end;

                if current_metric_local > best_metric_local then
                begin
                    best_metric_local := current_metric_local;
                    best_idx_local := local_idx;
                    best_path_local := local_support_path;
                end;
            end;

            if (best_idx_local < 0) or
                (best_metric_local < c_fast_visible_metric_threshold) then
            begin
                Exit;
            end;

            top_is_complete_local := (Trim(candidates[0].comment) = '') and
                (get_candidate_text_unit_count(Trim(candidates[0].text)) =
                input_syllable_count);
            if top_is_complete_local then
            begin
                local_path_preference := 0;
                top_metric_local := get_preferred_query_phrase_bonus_local(
                    lookup_text, Trim(candidates[0].text));
                local_support_path := infer_segment_path_for_query_text_with_score(
                    lookup_text, Trim(candidates[0].text), local_support_score,
                    local_path_preference);
                if local_support_path <> '' then
                begin
                    Inc(top_metric_local, local_support_score);
                    Inc(top_metric_local,
                        get_directional_context_metric_bonus_local(
                        Trim(candidates[0].text)));
                end
                else
                begin
                    top_metric_local := Low(Integer);
                end;
            end
            else
            begin
                top_metric_local := Low(Integer);
            end;

            if (best_idx_local = 0) and
                (top_metric_local >= c_fast_visible_metric_threshold) and
                (not has_quantity_modal_tail_mismatch_fast_visible_local(
                Trim(candidates[0].text))) then
            begin
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xchain=[fast-visible keep text=%s metric=%d]',
                        [Trim(candidates[0].text), top_metric_local]);
                end;
                Exit(True);
            end;

            if (best_idx_local > 0) and
                (not has_quantity_modal_tail_mismatch_fast_visible_local(
                Trim(candidates[best_idx_local].text))) and
                ((not top_is_complete_local) or
                (best_metric_local > top_metric_local + 1024)) then
            begin
                picked_local := candidates[best_idx_local];
                for local_idx := best_idx_local downto 1 do
                begin
                    candidates[local_idx] := candidates[local_idx - 1];
                end;
                candidates[0] := picked_local;
                if best_path_local <> '' then
                begin
                    remember_segment_path_for_candidate(
                        Trim(candidates[0].text), '', best_path_local,
                        candidates[0].score);
                end;
                if m_config.debug_mode then
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' xchain=[fast-visible promote text=%s metric=%d]',
                        [Trim(candidates[0].text), best_metric_local]);
                end;
                Exit(True);
            end;
        end;

        function get_path_segment_count_local(const encoded_path: string): Integer;
        var
            local_parts: TArray<string>;
            local_idx: Integer;
        begin
            Result := 0;
            if Trim(encoded_path) = '' then
            begin
                Exit;
            end;

            local_parts := encoded_path.Split([c_segment_path_separator]);
            for local_idx := 0 to High(local_parts) do
            begin
                if Trim(local_parts[local_idx]) <> '' then
                begin
                    Inc(Result);
                end;
            end;
        end;

        function is_trusted_top_complete_candidate_local(
            const local_candidates: TncCandidateList): Boolean;
        const
            c_min_support_score_local = 8192;
        var
            local_candidate: TncCandidate;
            local_candidate_text: string;
            local_support_score: Integer;
            local_path_preference: Integer;
            local_support_path: string;
        begin
            Result := False;
            if (Length(local_candidates) = 0) or
                (input_syllable_count < 4) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            local_candidate := local_candidates[0];
            if Trim(local_candidate.comment) <> '' then
            begin
                Exit;
            end;

            local_candidate_text := Trim(local_candidate.text);
            if (local_candidate_text = '') or
                (get_candidate_text_unit_count(local_candidate_text) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if local_candidate.source = cs_user then
            begin
                Exit(True);
            end;
            if local_candidate.has_dict_weight and
                (input_syllable_count <= 4) then
            begin
                Exit(True);
            end;

            if is_problematic_single_char_chain_candidate_for_query(
                lookup_text, local_candidate) then
            begin
                Exit;
            end;

            local_support_path := infer_segment_path_for_query_text_with_score(
                lookup_text, local_candidate_text, local_support_score,
                local_path_preference);
            Result := (local_support_path <> '') and
                (local_support_score >= c_min_support_score_local);
        end;

        function build_query_key_local(const start_idx: Integer;
            const syllable_count_part: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx < 0) or (syllable_count_part <= 0) or
                (start_idx + syllable_count_part - 1 > High(effective_syllables)) then
            begin
                Exit;
            end;

            for local_idx := start_idx to start_idx + syllable_count_part - 1 do
            begin
                Result := Result + normalize_pinyin_text(effective_syllables[local_idx].text);
            end;
        end;

        function get_exact_chunk_length_bonus_local(
            const syllable_count_part: Integer): Integer;
        begin
            if syllable_count_part <= c_chain_max_chunk_syllables then
            begin
                Exit(syllable_count_part * syllable_count_part *
                    c_chain_length_bonus);
            end;

            Result := (c_chain_max_chunk_syllables * c_chain_max_chunk_syllables *
                c_chain_length_bonus) +
                ((syllable_count_part - c_chain_max_chunk_syllables) * 900);
        end;

        function get_exact_chunk_effective_weight_local(
            const local_candidate: TncCandidate): Integer;
        var
            local_units: Integer;
        begin
            if local_candidate.has_dict_weight then
            begin
                Result := local_candidate.dict_weight;
            end
            else
            begin
                Result := local_candidate.score;
            end;

            local_units := get_candidate_text_unit_count(Trim(local_candidate.text));
            case local_units of
                1:
                    if Result > 180 then
                    begin
                        Result := 180 + ((Result - 180) div 12);
                    end;
                2:
                    if Result > 240 then
                    begin
                        Result := 240 + ((Result - 240) div 10);
                    end;
                3:
                    if Result > 300 then
                    begin
                        Result := 300 + ((Result - 300) div 24);
                    end;
                4:
                    if Result > 360 then
                    begin
                        Result := 360 + ((Result - 360) div 32);
                    end;
            else
                if Result > 420 then
                begin
                    Result := 420 + ((Result - 420) div 40);
                end;
            end;
        end;

