                        local_text_value := Trim(
                            local_results_value[local_idx_value].text);
                        if get_candidate_text_unit_count(local_text_value) <>
                            local_span_len_value then
                        begin
                            Continue;
                        end;
                        Result :=
                            get_generic_first_text_unit_local(local_text_value);
