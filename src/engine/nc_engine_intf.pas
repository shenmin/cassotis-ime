            insert_fixed_quantity_tail_candidate_from_partial;
            insert_fixed_leading_tail_exact_completion_from_partial;
            promote_and_filter_display_fixed_quantity_tail_candidate;
            insert_fixed_quantity_tail_candidate_from_partial;
            remove_bad_fixed_tail_candidates;
