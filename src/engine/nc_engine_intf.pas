        begin
            Result := (Length(unit_value) = 1) and
                (Ord(unit_value[1]) = code_value);
        end;

        function unit_pair_matches_local(const units_value: TArray<string>;
            const first_idx: Integer; const first_code: Word;
            const second_code: Word): Boolean;
        begin
            Result := (first_idx >= 0) and
                (first_idx + 1 <= High(units_value)) and
                unit_matches_local(units_value[first_idx], first_code) and
                unit_matches_local(units_value[first_idx + 1], second_code);
        end;

        function is_display_nominal_de_left_unit_local(
            const unit_value: string): Boolean;
        begin
            Result := False;
            if Length(unit_value) <> 1 then
            begin
                Exit;
            end;

            case Ord(unit_value[1]) of
                $6027, $7EED, $5927, $5B9A, $6548, $5165, $529F, $6709,
                $63A5, $7136:
                    Result := True;
            end;
        end;

        function has_display_nominal_de_suffix_local(
            const units_value: TArray<string>; const de_idx: Integer): Boolean;
        begin
            Result := False;
            if (de_idx <= 0) or (de_idx + 1 > High(units_value)) or
                (not is_display_nominal_de_left_unit_local(
                units_value[de_idx - 1])) then
            begin
                Exit;
            end;

            Result :=
                unit_pair_matches_local(units_value, de_idx + 1, $63D0, $95EE) or
                unit_pair_matches_local(units_value, de_idx + 1, $76F4, $64AD) or
                unit_pair_matches_local(units_value, de_idx + 1, $7ADE, $4E89) or
                unit_pair_matches_local(units_value, de_idx + 1, $6253, $51FB) or
                unit_pair_matches_local(units_value, de_idx + 1, $5E2E, $52A9) or
                unit_pair_matches_local(units_value, de_idx + 1, $6210, $679C) or
                unit_pair_matches_local(units_value, de_idx + 1, $5F00, $53D1) or
                unit_pair_matches_local(units_value, de_idx + 1, $653B, $51FB) or
                unit_pair_matches_local(units_value, de_idx + 1, $5206, $6790) or
                unit_pair_matches_local(units_value, de_idx + 1, $63A2, $7D22) or
                unit_pair_matches_local(units_value, de_idx + 1, $8BDD, $9898) or
                unit_pair_matches_local(units_value, de_idx + 1, $80FD, $529B) or
                unit_pair_matches_local(units_value, de_idx + 1, $89C6, $9891) or
                unit_pair_matches_local(units_value, de_idx + 1, $98CE, $683C) or
