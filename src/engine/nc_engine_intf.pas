                $7528, $770B, $7740, $7814, $79BB, $7EE7, $7ED9, $80E1,
                $89C1, $8BA9, $8BB2, $8BB0, $8BF4, $8D70, $8DD1, $8F93,
                $8F6C, $8FC7, $9001, $9009, $95EE, $5199, $5C06, $964D,
                $9610, $9996, $6572, $653B, $878D, $642C, $4FEE, $963B,
                $8054, $88AB, $5FD0, $76B1, $8D62, $9501, $5229, $7A33,
