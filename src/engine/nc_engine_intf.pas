            (preferred_three_syllable_partial_kind <> 0) then
        begin
            for i := 0 to list.Count - 1 do
            begin
                item := list[i];
                if (preferred_three_syllable_partial_kind = 1) and item.is_two_plus_one_partial then
                begin
                    if item.is_complete_phrase_prefix_partial then
