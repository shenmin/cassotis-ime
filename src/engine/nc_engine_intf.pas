                sort_and_trim_exact_chunk_options_local(out_options,
                    c_chain_standalone_option_limit);
                Exit(Length(out_options) > 0);
            end;

            if standalone_chunk_states.TryGetValue(query_key_local, cached_state) then
            begin
                if cached_state = 1 then
                begin
                    if standalone_chunk_options.TryGetValue(query_key_local,
                        cached_options_local) then
                    begin
                        out_options := Copy(cached_options_local);
                        Exit(Length(out_options) > 0);
                    end;
                    standalone_chunk_texts.TryGetValue(query_key_local,
                        candidate_text_local);
                    standalone_chunk_scores.TryGetValue(query_key_local,
                        candidate_score_local);
                    if candidate_text_local <> '' then
                    begin
                        SetLength(out_options, 1);
                        out_options[0] := Default(TExactChunkChainOption);
                        out_options[0].text := candidate_text_local;
                        out_options[0].path := candidate_text_local;
                        out_options[0].query_key := query_key_local;
                        out_options[0].score := candidate_score_local;
                        out_options[0].segments := 1;
                        out_options[0].has_anchor :=
                            expected_syllables >= c_chain_min_anchor_syllables;
                        if out_options[0].has_anchor then
                        begin
                            out_options[0].anchor_units := expected_syllables;
                        end
                        else
                        begin
                            out_options[0].anchor_units := 0;
                        end;
                        Exit(True);
                    end;
                    Exit(False);
                end;
                Exit(False);
            end;

            if standalone_chunk_budget_remaining <= 0 then
            begin
                Exit;
            end;
            Dec(standalone_chunk_budget_remaining);

            if standalone_chunk_engine = nil then
            begin
                standalone_chunk_config := m_config;
                standalone_chunk_config.debug_mode := False;
                standalone_chunk_engine := TncEngine.Create(
                    standalone_chunk_config, False, False);
                inherit_search_budget_policy_to(standalone_chunk_engine);
            end;

            standalone_chunk_states.AddOrSetValue(query_key_local, 3);
            standalone_chunk_engine.m_disable_subspan_standalone_oracle :=
                m_disable_subspan_standalone_oracle + 1;
            standalone_chunk_engine.m_composition_text := query_key_local;
            standalone_chunk_engine.build_candidates;
            SetLength(snapshot_candidates_local,
                Length(standalone_chunk_engine.m_candidates));
            SetLength(snapshot_scores_local,
                Length(standalone_chunk_engine.m_candidates));
            for candidate_idx_local := 0 to High(standalone_chunk_engine.m_candidates) do
            begin
                snapshot_candidates_local[candidate_idx_local] :=
                    standalone_chunk_engine.m_candidates[candidate_idx_local];
                snapshot_scores_local[candidate_idx_local] :=
                    standalone_chunk_engine.get_rank_score(
                    standalone_chunk_engine.m_candidates[candidate_idx_local]);
            end;

            best_complete_text_local := '';
            best_complete_score_local := Low(Integer);
            best_partial_text_local := '';
            best_partial_score_local := Low(Integer);
            best_partial_comment_local := '';
            best_split_text_local := '';
            best_split_score_local := Low(Integer);
            has_best_partial_option_local := False;
            has_best_split_option_local := False;

            if lookup_exact_full_pinyin_cached_local(query_key_local,
                local_results) then
            begin
                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_chain_probe_limit * 3 then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results[local_idx].dict_weight,
                        local_results[local_idx].has_dict_weight) then
                    begin
                        Continue;
                    end;

                    candidate_text_local := Trim(local_results[local_idx].text);
                    if (get_candidate_text_unit_count(candidate_text_local) <>
                        expected_syllables) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        candidate_text_local, expected_syllables)) then
                    begin
                        Continue;
                    end;

                    candidate_score_local := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight >
                        candidate_score_local) then
                    begin
                        candidate_score_local := local_results[local_idx].dict_weight;
                    end;
                    Inc(candidate_score_local,
                        get_preferred_query_phrase_bonus_local(query_key_local,
                        candidate_text_local));
                    Inc(candidate_score_local,
                        get_exact_query_text_bonus_local(query_key_local,
                        candidate_text_local));
                    Inc(candidate_score_local,
                        get_exact_chunk_semantic_bonus_local(candidate_text_local));

                    if candidate_score_local > best_complete_score_local then
                    begin
                        best_complete_text_local := candidate_text_local;
                        best_complete_score_local := candidate_score_local;
                    end;

                    local_option := Default(TExactChunkChainOption);
                    local_option.text := candidate_text_local;
                    local_option.path := candidate_text_local;
                    local_option.query_key := query_key_local;
                    local_option.score := candidate_score_local;
                    local_option.segments := 1;
                    local_option.has_anchor :=
                        expected_syllables >= c_chain_min_anchor_syllables;
                    if local_option.has_anchor then
                    begin
                        local_option.anchor_units := expected_syllables;
                    end
                    else
                    begin
                        local_option.anchor_units := 0;
                    end;
                    add_standalone_option_local(local_option);
                end;
            end;

            for candidate_idx_local := 0 to High(snapshot_candidates_local) do
            begin
                if candidate_idx_local >= c_chain_probe_limit then
                begin
                    Break;
                end;

                candidate_local := snapshot_candidates_local[candidate_idx_local];
                candidate_text_local := Trim(candidate_local.text);
                if candidate_text_local = '' then
                begin
                    Continue;
                end;

                if Trim(candidate_local.comment) = '' then
                begin
                    if not long_exact_chunk_weight_is_eligible(
                        candidate_local.dict_weight,
                        candidate_local.has_dict_weight) then
                    begin
                        Continue;
                    end;
                    candidate_score_local :=
                        get_exact_chunk_effective_weight_local(candidate_local);
                end
                else
                begin
                    candidate_score_local := snapshot_scores_local[
                        candidate_idx_local];
                end;
                Inc(candidate_score_local, get_preferred_query_phrase_bonus_local(
                    query_key_local, candidate_text_local));
                candidate_units_local :=
                    get_candidate_text_unit_count(candidate_text_local);

                if Trim(candidate_local.comment) = '' then
                begin
                    if (candidate_units_local <> expected_syllables) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        candidate_text_local, expected_syllables)) then
                    begin
                        Continue;
                    end;

                    inferred_path_local :=
                        infer_segment_path_for_query_text_with_score(
                        query_key_local, candidate_text_local, infer_score_local,
                        infer_segments_local);
                    if inferred_path_local <> '' then
                    begin
                        Inc(candidate_score_local, infer_score_local);
                        if infer_segments_local > 1 then
                        begin
                            Inc(candidate_score_local,
                                infer_segments_local * 160);
                        end;
                    end
                    else if expected_syllables >= 3 then
                    begin
                        Dec(candidate_score_local, 1536);
                    end;

                    if candidate_score_local > best_complete_score_local then
                    begin
                        best_complete_text_local := candidate_text_local;
                        best_complete_score_local := candidate_score_local;
                    end;
                    local_option := Default(TExactChunkChainOption);
                    local_option.text := candidate_text_local;
                    local_option.path := candidate_text_local;
                    local_option.query_key := query_key_local;
                    local_option.score := candidate_score_local;
                    local_option.segments := 1;
                    local_option.has_anchor :=
                        expected_syllables >= c_chain_min_anchor_syllables;
                    if local_option.has_anchor then
                    begin
                        local_option.anchor_units := expected_syllables;
                    end
                    else
                    begin
                        local_option.anchor_units := 0;
                    end;
                    add_standalone_option_local(local_option);
                    Continue;
                end;

                comment_key_local := normalize_pinyin_text(candidate_local.comment);
                if (comment_key_local = '') or
                    (not is_full_pinyin_key(comment_key_local)) or
                    (not is_boundary_tail_comment_local(comment_key_local)) then
                begin
                    Continue;
                end;

                comment_syllables_local := get_effective_compact_pinyin_syllables(
                    comment_key_local);
                if (Length(comment_syllables_local) = 0) or
                    (candidate_units_local + Length(comment_syllables_local) <>
                    expected_syllables) then
                begin
                    Continue;
                end;

                if not try_collect_standalone_query_candidates_local(comment_key_local,
                    Length(comment_syllables_local), right_options_local) or
                    (Length(right_options_local) = 0) then
                begin
                    Continue;
                end;
                tail_text_local := right_options_local[0].text;
                tail_score_local := right_options_local[0].score;

                combined_text_local := candidate_text_local + tail_text_local;
                if not is_valid_standalone_cjk_phrase_text_local(
                    combined_text_local, expected_syllables) then
                begin
                    Continue;
                end;

                combined_score_local := candidate_score_local + tail_score_local;
                if m_dictionary <> nil then
                begin
                    context_bonus_local := m_dictionary.get_context_bonus(
                        candidate_text_local, tail_text_local);
                    Inc(combined_score_local, context_bonus_local);
                end;
                Inc(combined_score_local,
                    get_preferred_query_phrase_bonus_local(query_key_local,
                    combined_text_local));
                Inc(combined_score_local,
                    get_exact_query_text_bonus_local(query_key_local,
                    combined_text_local));
                Inc(combined_score_local, 1024);

                if combined_score_local > best_partial_score_local then
                begin
                    best_partial_text_local := combined_text_local;
                    best_partial_score_local := combined_score_local;
                    best_partial_comment_local := comment_key_local;
                end;
                local_option := Default(TExactChunkChainOption);
                local_option.text := combined_text_local;
                local_option.path := combined_text_local;
                local_option.query_key := query_key_local;
                local_option.score := combined_score_local;
                local_option.segments := 1;
                local_option.has_anchor :=
                    expected_syllables >= c_chain_min_anchor_syllables;
                if local_option.has_anchor then
                begin
                    local_option.anchor_units := expected_syllables;
                end
                else
                begin
                    local_option.anchor_units := 0;
                end;
                if (not has_best_partial_option_local) or
                    is_exact_chunk_option_better_local(local_option,
                    best_partial_option_local) then
                begin
                    best_partial_option_local := local_option;
                    has_best_partial_option_local := True;
                end;
            end;

            query_syllables_local := get_effective_compact_pinyin_syllables(
                query_key_local);
            if Length(query_syllables_local) = expected_syllables then
            begin
                for split_idx_local := 1 to expected_syllables - 1 do
                begin
                    left_key_local := '';
                    for local_idx := 0 to split_idx_local - 1 do
                    begin
                        left_key_local := left_key_local + normalize_pinyin_text(
                            query_syllables_local[local_idx].text);
                    end;

                    right_key_local := '';
                    for local_idx := split_idx_local to High(query_syllables_local) do
                    begin
                        right_key_local := right_key_local + normalize_pinyin_text(
                            query_syllables_local[local_idx].text);
                    end;

                    if (left_key_local = '') or (right_key_local = '') then
                    begin
                        Continue;
                    end;

                    if not try_collect_standalone_query_candidates_local(
                        left_key_local, split_idx_local, left_options_local) or
                        (Length(left_options_local) = 0) then
                    begin
                        Continue;
                    end;
                    if not try_collect_standalone_query_candidates_local(
                        right_key_local, expected_syllables - split_idx_local,
                        right_options_local) or
                        (Length(right_options_local) = 0) then
                    begin
                        Continue;
                    end;
                    for left_option_idx_local := 0 to
                        Min(High(left_options_local),
                        c_standalone_split_option_probe_limit - 1) do
                    begin
                        left_text_local := left_options_local[left_option_idx_local].text;
                        left_score_local :=
                            left_options_local[left_option_idx_local].score;
                        for right_option_idx_local := 0 to
                            Min(High(right_options_local),
                            c_standalone_split_option_probe_limit - 1) do
                        begin
                            right_text_local :=
                                right_options_local[right_option_idx_local].text;
                            right_score_local :=
                                right_options_local[right_option_idx_local].score;

                            if (expected_syllables >= 4) and
                                (not ((split_idx_local = 1) and
                                (expected_syllables - split_idx_local = 3) and
                                (get_modifier_prefix_phrase_bonus_local(3,
                                right_text_local) > 0))) then
                            begin
                                Continue;
                            end;

                            combined_text_local := left_text_local + right_text_local;
                            if not is_valid_standalone_cjk_phrase_text_local(
                                combined_text_local, expected_syllables) then
                            begin
                                Continue;
                            end;

                            combined_score_local := left_score_local +
                                right_score_local - 96;
                            if m_dictionary <> nil then
                            begin
                                context_bonus_local := m_dictionary.get_context_bonus(
                                    left_text_local, right_text_local);
                                Inc(combined_score_local, context_bonus_local);
                            end;
                            Inc(combined_score_local,
                                get_preferred_query_phrase_bonus_local(
                                query_key_local, combined_text_local));
                            Inc(combined_score_local,
                                get_exact_query_text_bonus_local(
                                query_key_local, combined_text_local));
                            inferred_path_local :=
                                infer_segment_path_for_query_text_with_score(
                                query_key_local, combined_text_local,
                                infer_score_local, infer_segments_local);
                            if inferred_path_local <> '' then
                            begin
                                Inc(combined_score_local, infer_score_local);
                                if infer_segments_local > 1 then
                                begin
                                    Inc(combined_score_local,
                                        infer_segments_local * 160);
                                end;
                            end;

                            if combined_score_local > best_split_score_local then
                            begin
                                best_split_text_local := combined_text_local;
                                best_split_score_local := combined_score_local;
                            end;
                            local_option := Default(TExactChunkChainOption);
                            local_option.text := combined_text_local;
                            local_option.path :=
                                left_options_local[left_option_idx_local].path;
                            if right_options_local[right_option_idx_local].path <> '' then
                            begin
                                if local_option.path <> '' then
                                begin
                                    local_option.path := local_option.path +
                                        c_segment_path_separator;
                                end;
                                local_option.path := local_option.path +
                                    right_options_local[right_option_idx_local].path;
                            end;
                            local_option.query_key := query_key_local;
                            local_option.score := combined_score_local;
                            local_option.segments :=
                                left_options_local[left_option_idx_local].segments +
                                right_options_local[right_option_idx_local].segments;
                            local_option.has_anchor :=
                                left_options_local[left_option_idx_local].has_anchor or
                                right_options_local[right_option_idx_local].has_anchor;
                            local_option.anchor_units :=
                                left_options_local[left_option_idx_local].anchor_units;
                            if right_options_local[right_option_idx_local].anchor_units >
                                local_option.anchor_units then
                            begin
                                local_option.anchor_units :=
                                    right_options_local[right_option_idx_local].anchor_units;
                            end;
                            if (not has_best_split_option_local) or
                                is_exact_chunk_option_better_local(local_option,
                                best_split_option_local) then
                            begin
                                best_split_option_local := local_option;
                                has_best_split_option_local := True;
                            end;
                        end;
                    end;
                end;
            end;

            if has_best_partial_option_local then
            begin
                if (best_complete_text_local <> '') and
                    is_boundary_tail_comment_local(best_partial_comment_local) and
                    (best_partial_score_local > best_complete_score_local - 256) then
                begin
                    add_standalone_option_local(best_partial_option_local);
                end
                else if best_complete_text_local = '' then
                begin
                    add_standalone_option_local(best_partial_option_local);
                end;
            end;

            if has_best_split_option_local then
            begin
                add_standalone_option_local(best_split_option_local);
            end;

            sort_and_trim_exact_chunk_options_local(out_options,
                c_chain_standalone_option_limit);

            if Length(out_options) > 0 then
            begin
                standalone_chunk_states.AddOrSetValue(query_key_local, 1);
                standalone_chunk_options.AddOrSetValue(query_key_local,
                    Copy(out_options));
                standalone_chunk_texts.AddOrSetValue(query_key_local,
                    out_options[0].text);
                standalone_chunk_scores.AddOrSetValue(query_key_local,
                    out_options[0].score);
                Exit(True);
            end;

            standalone_chunk_states.AddOrSetValue(query_key_local, 2);
        end;

        function try_get_best_standalone_query_candidate_local(
            const query_key_local: string; const expected_syllables: Integer;
            out out_text: string; out out_score: Integer): Boolean;
        var
            local_options: TExactChunkChainOptionArray;
        begin
            Result := try_collect_standalone_query_candidates_local(query_key_local,
                expected_syllables, local_options) and (Length(local_options) > 0);
            if Result then
            begin
                out_text := local_options[0].text;
                out_score := local_options[0].score;
            end
            else
            begin
                out_text := '';
                out_score := 0;
            end;
        end;

        function try_get_standalone_chunk_candidate_local(const start_idx: Integer;
            const syllable_count_part: Integer; out out_text: string;
            out out_score: Integer): Boolean;
        begin
            out_text := '';
            out_score := 0;
            // Arbitrary recursive standalone chunks are intentionally disabled.
            // Sentence paths should be assembled from exact lexicon/user chunks,
            // explicit function-word bridges, and single-character fallbacks.
            Result := False;
        end;

        procedure try_update_best_from_position(const start_idx: Integer);
        var
            chunk_syllables: Integer;
            next_idx: Integer;
            resolved_text: string;
            resolved_path: string;
            resolved_score: Integer;
            resolved_segments: Integer;
            resolved_anchor_units: Integer;
            resolved_has_anchor: Boolean;
            total_score: Integer;
            total_segments: Integer;
            total_anchor_units: Integer;
            total_has_anchor: Boolean;
            combined_text: string;
            combined_path: string;
            better_candidate: Boolean;
            standalone_text: string;
            standalone_score: Integer;
            standalone_min_score: Integer;
        begin
            for chunk_syllables := 1 to Min(c_chain_max_chunk_syllables,
                syllable_count_local - start_idx) do
            begin
                next_idx := start_idx + chunk_syllables;
                if (next_idx < syllable_count_local) and
                    (best_scores[next_idx] = Low(Integer)) then
                begin
                    Continue;
                end;

                resolved_text := '';
                resolved_path := '';
                resolved_score := 0;
                resolved_segments := 0;
                resolved_anchor_units := -1;
                resolved_has_anchor := False;

                if (chunk_syllables >= 2) and
                    try_get_standalone_chunk_candidate_local(start_idx,
                    chunk_syllables, standalone_text, standalone_score) and
                    (standalone_text <> '') then
                begin
                    resolved_text := standalone_text;
                    resolved_path := standalone_text;
                    resolved_segments := 1;
                    resolved_has_anchor := chunk_syllables >= c_chain_min_anchor_syllables;
                    if resolved_has_anchor then
                    begin
                        resolved_anchor_units := chunk_syllables;
                    end
                    else
                    begin
                        resolved_anchor_units := 0;
                    end;
                    resolved_score := standalone_score +
                        (chunk_syllables * chunk_syllables * c_chain_length_bonus);
                    if resolved_has_anchor then
                    begin
                        Inc(resolved_score, c_chain_anchor_bonus);
                    end;
                end
                else if not try_resolve_best_exact_subspan_local(start_idx,
                    chunk_syllables, resolved_text, resolved_score,
                    resolved_segments, resolved_path, resolved_has_anchor,
                    resolved_anchor_units) then
                begin
                    Continue;
                end;

                if (chunk_syllables >= 2) and
                    (resolved_segments > 1) and
                    try_get_standalone_chunk_candidate_local(start_idx,
                    chunk_syllables, standalone_text, standalone_score) and
                    (standalone_text <> '') then
                begin
                    standalone_min_score := standalone_score +
                        (chunk_syllables * chunk_syllables * c_chain_length_bonus);
                    if chunk_syllables >= c_chain_min_anchor_syllables then
                    begin
                        Inc(standalone_min_score, c_chain_anchor_bonus);
                    end;
                    resolved_text := standalone_text;
                    resolved_score := Max(resolved_score + 2048, standalone_min_score);
                    resolved_segments := 1;
                    resolved_path := standalone_text;
                    resolved_has_anchor := chunk_syllables >= c_chain_min_anchor_syllables;
                    if resolved_has_anchor then
                    begin
                        resolved_anchor_units := chunk_syllables;
                    end
                    else
                    begin
                        resolved_anchor_units := 0;
                    end;
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info := m_last_full_path_debug_info +
                            Format(' xoracle=[key=%s text=%s score=%d]',
                            [build_query_key_local(start_idx, chunk_syllables),
                            standalone_text, standalone_min_score]);
                    end;
                end;

                total_score := resolved_score;
                total_segments := resolved_segments;
                total_has_anchor := resolved_has_anchor;
                total_anchor_units := resolved_anchor_units;
                combined_text := resolved_text;
                combined_path := resolved_path;

                if next_idx < syllable_count_local then
                begin
                    Inc(total_score, best_scores[next_idx]);
                    Inc(total_segments, best_segments[next_idx]);
                    if best_has_anchor[next_idx] then
                    begin
                        total_has_anchor := True;
                        if best_anchor_units[next_idx] > total_anchor_units then
                        begin
                            total_anchor_units := best_anchor_units[next_idx];
                        end;
                    end;
                    combined_text := combined_text + best_texts[next_idx];
                    if best_paths[next_idx] <> '' then
                    begin
                        if combined_path <> '' then
                        begin
                            combined_path := combined_path + c_segment_path_separator;
                        end;
                        combined_path := combined_path + best_paths[next_idx];
                    end;
                end;

                better_candidate := False;
                if total_score > best_scores[start_idx] then
                begin
                    better_candidate := True;
                end
                else if total_score = best_scores[start_idx] then
                begin
                    if total_has_anchor and (not best_has_anchor[start_idx]) then
                    begin
                        better_candidate := True;
                    end
                    else if total_has_anchor = best_has_anchor[start_idx] then
                    begin
                        if total_anchor_units > best_anchor_units[start_idx] then
                        begin
                            better_candidate := True;
                        end
                        else if total_anchor_units = best_anchor_units[start_idx] then
                        begin
                            if total_segments < best_segments[start_idx] then
                            begin
                                better_candidate := True;
                            end
                            else if (total_segments = best_segments[start_idx]) and
                                (combined_text <> '') and
                                ((best_texts[start_idx] = '') or
                                (CompareText(combined_text, best_texts[start_idx]) < 0)) then
                            begin
                                better_candidate := True;
                            end;
                        end;
                    end;
                end;

                if better_candidate then
                begin
                    best_scores[start_idx] := total_score;
                    best_texts[start_idx] := combined_text;
                    best_paths[start_idx] := combined_path;
                    best_segments[start_idx] := total_segments;
                    best_has_anchor[start_idx] := total_has_anchor;
                    best_anchor_units[start_idx] := total_anchor_units;
                end;
            end;
        end;

        function is_exact_chunk_chain_state_better_local(
            const left_state: TExactChunkChainState;
            const right_state: TExactChunkChainState): Boolean;
        begin
            Result := False;
            if left_state.score > right_state.score then
            begin
                Exit(True);
            end;
            if left_state.score < right_state.score then
            begin
                Exit(False);
            end;
            if left_state.has_anchor and (not right_state.has_anchor) then
            begin
                Exit(True);
            end;
            if (not left_state.has_anchor) and right_state.has_anchor then
            begin
                Exit(False);
            end;
            if left_state.anchor_units > right_state.anchor_units then
            begin
                Exit(True);
            end;
            if left_state.anchor_units < right_state.anchor_units then
            begin
                Exit(False);
            end;
            if left_state.segments < right_state.segments then
            begin
                Exit(True);
            end;
            if left_state.segments > right_state.segments then
            begin
                Exit(False);
            end;
            if (left_state.text <> '') and
                ((right_state.text = '') or
                (CompareText(left_state.text, right_state.text) < 0)) then
            begin
                Exit(True);
            end;
        end;

        function get_exact_chunk_chain_state_lm_bonus_local(
            const state_inner: TExactChunkChainState;
            const state_start_pos: Integer;
            out stats_inner: TLongWordLmBoundaryStats): Integer;
        var
            path_segments_inner: TArray<string>;
            segment_idx_inner: Integer;
            query_offset_inner: Integer;
            current_text_inner: string;
            next_text_inner: string;
            previous_text_inner: string;
            current_units_inner: Integer;
            next_units_inner: Integer;
            previous_units_inner: Integer;
            transition_query_inner: string;
            bigram_bonus_inner: Integer;
            trigram_bonus_inner: Integer;
            boundary_bonus_inner: Integer;
            boundary_count_inner: Integer;
            total_bonus_inner: Integer;
        begin
            Result := 0;
            stats_inner := Default(TLongWordLmBoundaryStats);
            stats_inner.min_bonus := MaxInt;
            if (m_dictionary = nil) or (syllable_count_local <= 5) or
                (state_start_pos < 0) or (state_inner.path = '') then
            begin
                Exit;
            end;

            path_segments_inner := state_inner.path.Split(
                [c_segment_path_separator]);
            if Length(path_segments_inner) < 2 then
            begin
                Exit;
            end;

            query_offset_inner := state_start_pos;
            previous_text_inner := '';
            previous_units_inner := 0;
            boundary_count_inner := 0;
            total_bonus_inner := 0;
            for segment_idx_inner := 0 to High(path_segments_inner) - 1 do
            begin
                current_text_inner := Trim(path_segments_inner[segment_idx_inner]);
                next_text_inner := Trim(path_segments_inner[segment_idx_inner + 1]);
                current_units_inner := get_candidate_text_unit_count(
                    current_text_inner);
                next_units_inner := get_candidate_text_unit_count(next_text_inner);
                if (current_text_inner = '') or (next_text_inner = '') or
                    (current_units_inner <= 0) or (next_units_inner <= 0) or
                    (query_offset_inner + current_units_inner + next_units_inner >
                    syllable_count_local) then
                begin
                    Exit(0);
                end;

                transition_query_inner := build_query_key_local(
                    query_offset_inner, current_units_inner + next_units_inner);
                bigram_bonus_inner := m_dictionary.get_lm_transition_bonus(
                    transition_query_inner, current_text_inner +
                    c_segment_path_separator + next_text_inner);
                trigram_bonus_inner := 0;
                if (segment_idx_inner > 0) and
                    (previous_text_inner <> '') and (previous_units_inner > 0) then
                begin
                    transition_query_inner := build_query_key_local(
                        query_offset_inner - previous_units_inner,
                        previous_units_inner + current_units_inner +
                        next_units_inner);
                    trigram_bonus_inner := m_dictionary.get_lm_transition_bonus(
                        transition_query_inner, previous_text_inner +
                        c_segment_path_separator + current_text_inner +
                        c_segment_path_separator + next_text_inner);
                end;

                boundary_bonus_inner := Max(bigram_bonus_inner,
                    trigram_bonus_inner);
                if boundary_count_inner = 0 then
                begin
                    stats_inner.first_bonus := boundary_bonus_inner;
                end;
                stats_inner.last_bonus := boundary_bonus_inner;
                stats_inner.min_bonus := Min(stats_inner.min_bonus,
                    boundary_bonus_inner);
                stats_inner.max_bonus := Max(stats_inner.max_bonus,
                    boundary_bonus_inner);
                if boundary_bonus_inner > 0 then
                begin
                    Inc(stats_inner.supported_count);
                end
                else
                begin
                    Inc(stats_inner.zero_count);
                end;
                if boundary_bonus_inner >= c_chain_lattice_lm_min_bonus then
                begin
                    Inc(stats_inner.strong_count);
                end;
                if trigram_bonus_inner > 0 then
                begin
                    Inc(stats_inner.trigram_count);
                end;
                Inc(total_bonus_inner, boundary_bonus_inner);
                Inc(boundary_count_inner);
                previous_text_inner := current_text_inner;
                previous_units_inner := current_units_inner;
                Inc(query_offset_inner, current_units_inner);
            end;

            if boundary_count_inner > 0 then
            begin
                stats_inner.boundary_count := boundary_count_inner;
                Result := total_bonus_inner div boundary_count_inner;
            end;
            if stats_inner.min_bonus = MaxInt then
            begin
                stats_inner.min_bonus := 0;
            end;
        end;

        function get_exact_chunk_chain_state_head_lm_bonus_local(
            const state_inner: TExactChunkChainState;
            const state_start_pos: Integer): Integer;
        var
            path_segments_inner: TArray<string>;
            first_text_inner: string;
            second_text_inner: string;
            third_text_inner: string;
            first_units_inner: Integer;
            second_units_inner: Integer;
            third_units_inner: Integer;
            transition_query_inner: string;
            bigram_bonus_inner: Integer;
            trigram_bonus_inner: Integer;
        begin
            Result := 0;
            if (m_dictionary = nil) or (syllable_count_local <= 5) or
                (state_start_pos < 0) or (state_inner.path = '') then
            begin
                Exit;
            end;

            path_segments_inner := state_inner.path.Split(
                [c_segment_path_separator]);
            if Length(path_segments_inner) < 2 then
            begin
                Exit;
            end;

            first_text_inner := Trim(path_segments_inner[0]);
            second_text_inner := Trim(path_segments_inner[1]);
            first_units_inner := get_candidate_text_unit_count(first_text_inner);
            second_units_inner := get_candidate_text_unit_count(second_text_inner);
            if (first_text_inner = '') or (second_text_inner = '') or
                (first_units_inner <= 0) or (second_units_inner <= 0) or
                (state_start_pos + first_units_inner + second_units_inner >
                syllable_count_local) then
            begin
                Exit;
            end;

            transition_query_inner := build_query_key_local(state_start_pos,
                first_units_inner + second_units_inner);
            bigram_bonus_inner := m_dictionary.get_lm_transition_bonus(
                transition_query_inner, first_text_inner +
                c_segment_path_separator + second_text_inner);
            trigram_bonus_inner := 0;
            if Length(path_segments_inner) >= 3 then
            begin
                third_text_inner := Trim(path_segments_inner[2]);
                third_units_inner := get_candidate_text_unit_count(third_text_inner);
                if (third_text_inner <> '') and (third_units_inner > 0) and
                    (state_start_pos + first_units_inner + second_units_inner +
                    third_units_inner <= syllable_count_local) then
                begin
                    transition_query_inner := build_query_key_local(
                        state_start_pos, first_units_inner + second_units_inner +
                        third_units_inner);
                    trigram_bonus_inner := m_dictionary.get_lm_transition_bonus(
                        transition_query_inner, first_text_inner +
                        c_segment_path_separator + second_text_inner +
                        c_segment_path_separator + third_text_inner);
                end;
            end;
            Result := Max(bigram_bonus_inner, trigram_bonus_inner);
        end;

        procedure consider_exact_chunk_chain_state_local(
            var states: TExactChunkChainStateArray;
            const candidate_state: TExactChunkChainState;
            const state_start_pos: Integer;
            const state_limit: Integer = 0);
        var
            state_idx: Integer;
            insert_idx: Integer;
            existing_state: TExactChunkChainState;
            target_suffix: string;
            target_suffix_units: Integer;
            candidate_is_target_suffix: Boolean;
            lm_idx: Integer;
            lm_best_idx: Integer;
            lm_tail_idx: Integer;
            lm_best_bonus: Integer;
            lm_tail_bonus: Integer;
            lm_current_bonus: Integer;
            lm_base_gap: Integer;
            effective_state_limit: Integer;
            beam_width_local: Integer;
            prebeam_width_local: Integer;
            baseline_prebeam_width_local: Integer;
            baseline_count_local: Integer;
            removal_idx_local: Integer;
            shift_idx_local: Integer;
            reposition_replaced_state_local: Boolean;
        begin
            if candidate_state.text = '' then
            begin
                Exit;
            end;

            candidate_is_target_suffix := False;
            target_suffix_units := 0;
            beam_width_local := get_chain_beam_width_local;
            prebeam_width_local := get_chain_prebeam_width_local;
            effective_state_limit := state_limit;
            if effective_state_limit <= 0 then
            begin
                effective_state_limit := beam_width_local;
            end;
            if (m_debug_target_recall_text <> '') and
                (state_start_pos >= 0) then
            begin
                target_suffix := Copy(m_debug_target_recall_text,
                    state_start_pos + 1, MaxInt);
                candidate_is_target_suffix := SameText(
                    Trim(candidate_state.text), target_suffix);
                if candidate_is_target_suffix then
                begin
                    target_suffix_units := get_candidate_text_unit_count(
                        target_suffix);
                    m_debug_target_max_generated_syllable := Max(
                        m_debug_target_max_generated_syllable,
                        target_suffix_units);
                    m_debug_target_chain_generated_syllable := Max(
                        m_debug_target_chain_generated_syllable,
                        target_suffix_units);
                end;
            end;

            for state_idx := 0 to High(states) do
            begin
                if SameText(states[state_idx].text, candidate_state.text) then
                begin
                    reposition_replaced_state_local := False;
                    if candidate_state.baseline_lineage and
                        (not states[state_idx].baseline_lineage) then
                    begin
                        states[state_idx] := candidate_state;
                        reposition_replaced_state_local := True;
                    end
                    else if states[state_idx].baseline_lineage and
                        (not candidate_state.baseline_lineage) then
                    begin
                        { Preserve the exact baseline continuation. }
                    end
                    else if is_exact_chunk_chain_state_better_local(
                        candidate_state, states[state_idx]) then
                    begin
                        states[state_idx] := candidate_state;
                    end;
                    if reposition_replaced_state_local then
                    begin
                        insert_idx := state_idx;
                        while (insert_idx > 0) and
                            is_exact_chunk_chain_state_better_local(
                            states[insert_idx], states[insert_idx - 1]) do
                        begin
                            existing_state := states[insert_idx - 1];
                            states[insert_idx - 1] := states[insert_idx];
                            states[insert_idx] := existing_state;
                            Dec(insert_idx);
                        end;
                        while (insert_idx < High(states)) and
                            is_exact_chunk_chain_state_better_local(
                            states[insert_idx + 1], states[insert_idx]) do
                        begin
                            existing_state := states[insert_idx + 1];
                            states[insert_idx + 1] := states[insert_idx];
                            states[insert_idx] := existing_state;
                            Inc(insert_idx);
                        end;
                    end;
                    if candidate_is_target_suffix then
                    begin
                        m_debug_target_max_retained_syllable := Max(
                            m_debug_target_max_retained_syllable,
                            get_candidate_text_unit_count(target_suffix));
                        if effective_state_limit = prebeam_width_local then
                        begin
                            m_debug_target_chain_prebeam_syllable := Max(
                                m_debug_target_chain_prebeam_syllable,
                                target_suffix_units);
                        end
                        else if effective_state_limit = beam_width_local then
                        begin
                            m_debug_target_chain_beam_syllable := Max(
                                m_debug_target_chain_beam_syllable,
                                target_suffix_units);
                        end;
                    end;
                    Exit;
                end;
            end;

            SetLength(states, Length(states) + 1);
            states[High(states)] := candidate_state;
            for insert_idx := High(states) downto 1 do
            begin
                if not is_exact_chunk_chain_state_better_local(states[insert_idx],
                    states[insert_idx - 1]) then
                begin
                    Break;
                end;
                existing_state := states[insert_idx - 1];
                states[insert_idx - 1] := states[insert_idx];
                states[insert_idx] := existing_state;
            end;

            if Length(states) > effective_state_limit then
            begin
                if (effective_state_limit = beam_width_local) and
                    (state_start_pos > 0) then
                begin
                    lm_best_idx := -1;
                    lm_best_bonus := 0;
                    lm_tail_idx := beam_width_local -
                        c_chain_lattice_lm_reserved_slots;
                    lm_tail_bonus :=
                        get_exact_chunk_chain_state_head_lm_bonus_local(
                        states[lm_tail_idx], state_start_pos);
                    for lm_idx := beam_width_local to High(states) do
                    begin
                        lm_current_bonus :=
                            get_exact_chunk_chain_state_head_lm_bonus_local(
                            states[lm_idx], state_start_pos);
                        if lm_current_bonus > lm_best_bonus then
                        begin
                            lm_best_bonus := lm_current_bonus;
                            lm_best_idx := lm_idx;
                        end;
                    end;

                    if (lm_best_idx >= beam_width_local) and
                        (lm_best_bonus >= c_chain_lattice_lm_min_bonus) and
                        (lm_best_bonus >= lm_tail_bonus +
                        c_chain_lattice_lm_min_gain) then
                    begin
                        lm_base_gap := states[lm_tail_idx].score -
                            states[lm_best_idx].score;
                        if lm_base_gap <= c_chain_lattice_lm_max_base_gap then
                        begin
                            states[lm_tail_idx] := states[lm_best_idx];
                        end;
                    end;
                end;
                removal_idx_local := High(states);
                if (effective_state_limit = prebeam_width_local) and
                    (prebeam_width_local >
                    get_chain_baseline_prebeam_width_local) then
                begin
                    baseline_prebeam_width_local :=
                        get_chain_baseline_prebeam_width_local;
                    baseline_count_local := 0;
                    for state_idx := 0 to High(states) do
                    begin
                        if states[state_idx].baseline_lineage then
                        begin
                            Inc(baseline_count_local);
                        end;
                    end;
                    if baseline_count_local <= baseline_prebeam_width_local then
                    begin
                        removal_idx_local := -1;
                        for state_idx := High(states) downto 0 do
                        begin
                            if not states[state_idx].baseline_lineage then
                            begin
                                removal_idx_local := state_idx;
                                Break;
                            end;
                        end;
                        if removal_idx_local < 0 then
                        begin
                            removal_idx_local := High(states);
                        end;
                    end;
                end;
                for shift_idx_local := removal_idx_local to
                    High(states) - 1 do
                begin
                    states[shift_idx_local] := states[shift_idx_local + 1];
                end;
                SetLength(states, Length(states) - 1);
            end;

            if candidate_is_target_suffix then
            begin
                for state_idx := 0 to High(states) do
                begin
                    if SameText(Trim(states[state_idx].text), target_suffix) then
                    begin
                        m_debug_target_max_retained_syllable := Max(
                            m_debug_target_max_retained_syllable,
                            get_candidate_text_unit_count(target_suffix));
                        if effective_state_limit = prebeam_width_local then
                        begin
                            m_debug_target_chain_prebeam_syllable := Max(
                                m_debug_target_chain_prebeam_syllable,
                                target_suffix_units);
                        end
                        else if effective_state_limit = beam_width_local then
                        begin
                            m_debug_target_chain_beam_syllable := Max(
                                m_debug_target_chain_beam_syllable,
                                target_suffix_units);
                        end;
                        Break;
                    end;
                end;
            end;
        end;

        procedure consider_exact_chunk_option_local(
            var options: TExactChunkChainOptionArray;
            const candidate_option: TExactChunkChainOption);
        var
            option_idx: Integer;
        begin
            if candidate_option.text = '' then
            begin
                Exit;
            end;

            for option_idx := 0 to High(options) do
            begin
                if SameText(options[option_idx].text, candidate_option.text) then
                begin
                    if candidate_option.score > options[option_idx].score then
                    begin
                        options[option_idx] := candidate_option;
                    end;
                    Exit;
                end;
            end;

            SetLength(options, Length(options) + 1);
            options[High(options)] := candidate_option;
        end;

        function has_exact_chunk_merge_bonus_local(const left_query_key: string;
            const right_query_key: string; const combined_text: string;
            const expected_units: Integer): Boolean;
        var
            local_results: TncCandidateList;
            local_idx: Integer;
            local_text: string;
        begin
            Result := False;
            if (left_query_key = '') or (right_query_key = '') or
                (combined_text = '') or (expected_units <= 0) then
            begin
                Exit;
            end;

            if not lookup_exact_full_pinyin_cached_local(left_query_key +
                right_query_key, local_results) then
            begin
                Exit;
            end;

            for local_idx := 0 to High(local_results) do
            begin
                if local_idx >= c_chain_lattice_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if not long_exact_chunk_weight_is_eligible(
                    local_results[local_idx].dict_weight,
                    local_results[local_idx].has_dict_weight) then
                begin
                    Continue;
                end;

                local_text := Trim(local_results[local_idx].text);
                if (local_text = '') or
                    (get_candidate_text_unit_count(local_text) <> expected_units) then
                begin
                    Continue;
                end;

                if SameText(local_text, combined_text) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function try_collect_exact_chunk_options_local(const start_idx: Integer;
            const syllable_count_part: Integer;
            out options: TExactChunkChainOptionArray): Boolean;
        var
            query_key_local: string;
            local_results: TncCandidateList;
            ranked_lookup_results_local: TncCandidateList;
            local_idx: Integer;
            local_text: string;
            local_score: Integer;
            ranked_score_local: Integer;
            local_option: TExactChunkChainOption;
            fixed_single_text_local: string;

                function is_place_noun_unit_for_chunk_context_local(
                    const unit_value: string): Boolean;
                begin
                    Result := (unit_value = string(Char($5BB6))) or
                        (unit_value = string(Char($5E97))) or
                        (unit_value = string(Char($5C4B))) or
                        (unit_value = string(Char($697C))) or
                        (unit_value = string(Char($57CE))) or
                        (unit_value = string(Char($6751))) or
                        (unit_value = string(Char($53BF))) or
                        (unit_value = string(Char($5E02))) or
                        (unit_value = string(Char($6821))) or
                        (unit_value = string(Char($9662))) or
                        (unit_value = string(Char($5382))) or
                        (unit_value = string(Char($9986))) or
                        (unit_value = string(Char($7AD9))) or
                        (unit_value = string(Char($5C40))) or
                        (unit_value = string(Char($6240))) or
                        (unit_value = string(Char($56ED))) or
                        (unit_value = string(Char($533A))) or
                        (unit_value = string(Char($5708))) or
                        (unit_value = string(Char($8DEF))) or
                        (unit_value = string(Char($8857))) or
                        (unit_value = string(Char($95E8))) or
                        (unit_value = string(Char($5BA4))) or
                        (unit_value = string(Char($623F))) or
                        (unit_value = string(Char($5385))) or
                        (unit_value = string(Char($573A))) or
                        (unit_value = string(Char($53F8)));
                end;

                function has_place_context_before_chunk_local: Boolean;
                const
                    c_context_probe_limit = 8;
                var
                    back_len_local: Integer;
                    context_key_local: string;
                    context_results_local: TncCandidateList;
                    result_idx_local: Integer;
                    context_text_local: string;
                    context_units_local: TArray<string>;
                begin
                    Result := False;
                    if start_idx <= 0 then
                    begin
                        Exit;
                    end;

                    for back_len_local := 1 to Min(4, start_idx) do
                    begin
                        context_key_local := build_query_key_local(start_idx -
                            back_len_local, back_len_local);
                        if (context_key_local = '') or
                            (not lookup_exact_full_pinyin_cached_local(
                            context_key_local, context_results_local)) then
                        begin
                            Continue;
                        end;

                        for result_idx_local := 0 to High(context_results_local) do
                        begin
                            if result_idx_local >= c_context_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(context_results_local[result_idx_local].comment) <>
                                '' then
                            begin
                                Continue;
                            end;

                            context_text_local := Trim(
                                context_results_local[result_idx_local].text);
                            context_units_local := split_text_units(
                                context_text_local);
                            if (Length(context_units_local) > 0) and
                                is_place_noun_unit_for_chunk_context_local(
                                context_units_local[High(context_units_local)]) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                function has_directional_locative_chunk_context_local: Boolean;
                var
                    next_key_local: string;
                begin
                    Result := False;
                    if (syllable_count_part <> 2) or
                        (not has_place_context_before_chunk_local) then
                    begin
                        Exit;
                    end;

                    if start_idx + syllable_count_part >= syllable_count_local then
                    begin
                        Exit(True);
                    end;

                    next_key_local := normalize_pinyin_text(
                        effective_syllables[start_idx +
                        syllable_count_part].text);
                    Result := SameText(next_key_local, 'de');
                end;

                function get_directional_locative_chunk_bonus_local(
                    const text_value_local: string): Integer;
                const
                    c_chunk_directional_context_bonus = 12000;
                begin
                    Result := 0;
                    if (get_directional_locative_span_bonus_local(
                        text_value_local) > 0) and
                        has_directional_locative_chunk_context_local then
                    begin
                        Result := c_chunk_directional_context_bonus;
                    end;
                end;

                function should_defer_pair_to_modifier_tail_exact_local(
                    const pair_text_local: string): Boolean;
                var
                    prefix_text_local: string;
                    tail_key_local: string;
                    pair_units_local: TArray<string>;
                begin
                    Result := False;
                    if (syllable_count_part <> 2) or
                        (start_idx + 2 >= syllable_count_local) or
                        (pair_text_local = '') then
                    begin
                        Exit;
                    end;

                    if not try_get_modifier_prefix_single_text_local(
                        effective_syllables[start_idx].text, prefix_text_local) then
                    begin
                        Exit;
                    end;

                    pair_units_local := split_text_units(Trim(pair_text_local));
                    if (Length(pair_units_local) <> 2) or
                        SameText(pair_units_local[0], prefix_text_local) then
                    begin
                        Exit;
                    end;

                    tail_key_local := build_query_key_local(start_idx + 1, 2);
                    Result := has_high_quality_exact_phrase_for_key_local(
                        tail_key_local, 2, 700);
                end;

            function is_deferable_function_tail_single_local(
                const text_value_local: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(text_value_local) <> 1 then
                begin
                    Exit;
                end;

                case Ord(text_value_local[1]) of
                    $7684, $5730, $5F97, $4E86, $7740, $8FC7:
                        Result := True;
                end;
            end;

            function should_defer_chunk_to_head_plus_function_tail_local(
                const chunk_text_local: string): Boolean;
            var
                chunk_units_local: TArray<string>;
                tail_text_local: string;
                head_key_local: string;
            begin
                Result := False;
                if (syllable_count_part < 3) or
                    (syllable_count_part > 4) or (chunk_text_local = '') then
                begin
                    Exit;
                end;

                chunk_units_local := split_text_units(Trim(chunk_text_local));
                if Length(chunk_units_local) <> syllable_count_part then
                begin
                    Exit;
                end;

                if not try_get_modifier_prefix_single_text_local(
                    effective_syllables[start_idx + syllable_count_part - 1].text,
                    tail_text_local) then
                begin
                    tail_text_local :=
                        get_fixed_boundary_single_char_for_standalone_local(
                        effective_syllables[start_idx + syllable_count_part - 1].text);
                end;

                if (tail_text_local = '') or
                    (not is_deferable_function_tail_single_local(tail_text_local)) or
                    (not SameText(chunk_units_local[High(chunk_units_local)],
                    tail_text_local)) then
                begin
                    Exit;
                end;

                head_key_local := build_query_key_local(start_idx,
                    syllable_count_part - 1);
                Result := has_high_quality_exact_phrase_for_key_local(
                    head_key_local, syllable_count_part - 1, 700);
            end;

            function should_defer_pair_started_inside_previous_exact_local(
                const pair_text_local: string): Boolean;
            var
                previous_key_local: string;
                expected_text_local: string;
                pair_units_local: TArray<string>;
            begin
                Result := False;
                if (syllable_count_part <> 2) or (start_idx <= 0) or
                    (start_idx + 1 >= syllable_count_local) or
                    (pair_text_local = '') then
                begin
                    Exit;
                end;

                if not try_get_modifier_prefix_single_text_local(
                    effective_syllables[start_idx + 1].text,
                    expected_text_local) then
                begin
                    Exit;
                end;

                pair_units_local := split_text_units(Trim(pair_text_local));
                if (Length(pair_units_local) <> 2) or
                    SameText(pair_units_local[1], expected_text_local) then
                begin
                    Exit;
                end;

                previous_key_local := build_query_key_local(start_idx - 1, 2);
                Result := has_high_quality_exact_phrase_for_key_local(
                    previous_key_local, 2, 700);
            end;

            function get_ranked_lookup_score_for_text_local(
                const text_value_local: string): Integer;
            var
                ranked_idx_local: Integer;
                ranked_text_local: string;
            begin
                Result := Low(Integer);
                if (text_value_local = '') or
                    (Length(ranked_lookup_results_local) = 0) then
                begin
                    Exit;
                end;

                for ranked_idx_local := 0 to Min(High(ranked_lookup_results_local),
                    c_chain_probe_limit * 4 - 1) do
                begin
                    if Trim(ranked_lookup_results_local[ranked_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    ranked_text_local := Trim(
                        ranked_lookup_results_local[ranked_idx_local].text);
                    if (ranked_text_local = '') or
                        (get_candidate_text_unit_count(ranked_text_local) <>
                        syllable_count_part) or
                        (not SameText(ranked_text_local, text_value_local)) then
                    begin
                        Continue;
                    end;

                    Result := get_exact_chunk_effective_weight_local(
                        ranked_lookup_results_local[ranked_idx_local]) +
                        ((c_chain_probe_limit * 4 - ranked_idx_local) * 512);
                    Exit;
                end;
            end;

            procedure add_fixed_single_option_local(const single_text_local: string;
                const score_penalty_local: Integer);
            var
                scan_idx_local: Integer;
                single_score_local: Integer;
                single_option_local: TExactChunkChainOption;
            begin
                if single_text_local = '' then
                begin
                    Exit;
                end;

                single_score_local := 1200;
                if lookup_exact_full_pinyin_cached_local(query_key_local,
                    local_results) then
                begin
                    for scan_idx_local := 0 to High(local_results) do
                    begin
                        if scan_idx_local >= c_chain_probe_limit then
                        begin
                            Break;
                        end;
                        if SameText(Trim(local_results[scan_idx_local].text),
                            single_text_local) then
                        begin
                            single_score_local :=
                                get_exact_chunk_effective_weight_local(
                                local_results[scan_idx_local]);
                            Break;
                        end;
                    end;
                end;

                Inc(single_score_local, get_preferred_query_phrase_bonus_local(
                    query_key_local, single_text_local));
                Inc(single_score_local, get_exact_query_text_bonus_local(
                    query_key_local, single_text_local));
                Dec(single_score_local, score_penalty_local);

                single_option_local := Default(TExactChunkChainOption);
                single_option_local.text := single_text_local;
                single_option_local.path := single_text_local;
                single_option_local.query_key := query_key_local;
                single_option_local.score := single_score_local +
                    c_chain_lattice_fixed_single_bonus;
                single_option_local.segments := 1;
                single_option_local.has_anchor := True;
                single_option_local.anchor_units := 1;
                consider_exact_chunk_option_local(options, single_option_local);
            end;
        begin
            Result := False;
            SetLength(options, 0);
            query_key_local := build_query_key_local(start_idx, syllable_count_part);
            if query_key_local = '' then
            begin
                Exit;
            end;

            if syllable_count_part = 1 then
            begin
                fixed_single_text_local :=
                    get_fixed_boundary_single_char_for_standalone_local(
                    effective_syllables[start_idx].text);
                if fixed_single_text_local <> '' then
                begin
                    add_fixed_single_option_local(fixed_single_text_local, 0);
                end;
                Exit(Length(options) > 0);
            end;

            if (input_syllable_count <= 6) and (m_dictionary <> nil) and
                (not m_dictionary.lookup(query_key_local,
                ranked_lookup_results_local)) then
            begin
                ranked_lookup_results_local := nil;
            end;

            if lookup_exact_full_pinyin_cached_local(query_key_local, local_results) then
            begin
                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_chain_probe_limit * 4 then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if not long_exact_chunk_weight_is_eligible(
                        local_results[local_idx].dict_weight,
                        local_results[local_idx].has_dict_weight) then
                    begin
                        Continue;
                    end;

                    local_text := Trim(local_results[local_idx].text);
                    if (local_text = '') or
                        (get_candidate_text_unit_count(local_text) <>
                        syllable_count_part) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        local_text, syllable_count_part)) then
                    begin
                        Continue;
                    end;

                    if should_defer_pair_to_modifier_tail_exact_local(local_text) then
                    begin
                        Continue;
                    end;
                    if should_defer_chunk_to_head_plus_function_tail_local(
                        local_text) then
                    begin
                        Continue;
                    end;
                    if should_defer_pair_started_inside_previous_exact_local(
                        local_text) then
                    begin
                        Continue;
                    end;

                    local_score := local_results[local_idx].score;
                    if local_results[local_idx].has_dict_weight and
                        (local_results[local_idx].dict_weight > local_score) then
                    begin
                        local_score := local_results[local_idx].dict_weight;
                    end;
                    if syllable_count_part <= 2 then
                    begin
                        case local_idx of
                            0:
                                Inc(local_score, 4096);
                            1:
                                Inc(local_score, 1536);
                            2, 3:
                                Dec(local_score, 1024);
                        else
                            Dec(local_score, 2048);
                        end;
                    end
                    else
                    begin
                        if local_idx = 0 then
                        begin
                            Inc(local_score, 7200);
                        end;
                        case local_idx of
                            0:
                                Inc(local_score, 6144);
                            1:
                                Inc(local_score, 3072);
                            2, 3:
                                Inc(local_score, 1536);
                        else
                            Inc(local_score, 768);
                        end;
                    end;
                    ranked_score_local :=
                        get_ranked_lookup_score_for_text_local(local_text);
                    if ranked_score_local > local_score then
                    begin
                        local_score := ranked_score_local;
                    end;
                    Inc(local_score, get_preferred_query_phrase_bonus_local(
                        query_key_local, local_text));
                    Inc(local_score, get_exact_chunk_length_bonus_local(
                        syllable_count_part));
                    Inc(local_score, get_long_exact_phrase_cohesion_bonus_local(
                        syllable_count_part));
                    Inc(local_score, get_modifier_prefix_phrase_bonus_local(
                        syllable_count_part, local_text));
                    Inc(local_score, get_exact_chunk_boundary_adjustment_local(
                        start_idx, syllable_count_part, local_text));
                    Inc(local_score, get_exact_chunk_semantic_bonus_local(local_text));
                    Inc(local_score, get_directional_locative_chunk_bonus_local(
                        local_text));
                    if syllable_count_part >= c_chain_min_anchor_syllables then
                    begin
                        Inc(local_score, c_chain_anchor_bonus);
                    end;
                    local_option := Default(TExactChunkChainOption);
                    local_option.text := local_text;
                    local_option.path := local_text;
                    local_option.query_key := query_key_local;
                    local_option.score := local_score;
                    local_option.segments := 1;
                    local_option.has_anchor :=
                        syllable_count_part >= c_chain_min_anchor_syllables;
                    if local_option.has_anchor then
                    begin
                        local_option.anchor_units := syllable_count_part;
                    end
                    else
                    begin
                        local_option.anchor_units := 0;
                    end;
                    consider_exact_chunk_option_local(options, local_option);
                end;
            end;

            if (Length(options) = 0) and (syllable_count_part = 3) and
                try_resolve_three_syllable_split_option_local(start_idx,
                local_option) then
            begin
                consider_exact_chunk_option_local(options, local_option);
            end;

            // Do not synthesize arbitrary 3-4 syllable chunks here. The exact
            // chain may combine lexicon/user words and intentional 3-syllable
            // AB/C or A/BC splits, but recursive standalone chunks create
            // invalid phrases such as "鐨勪細鎺ヨ" and dominate real paths.

            if m_config.debug_mode and (Length(options) > 0) then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' xopt=[key=%s n=%d', [query_key_local, Length(options)]);
                for local_idx := 0 to Min(High(options), 2) do
                begin
                    m_last_full_path_debug_info := m_last_full_path_debug_info +
                        Format(' {%d:%s s=%d seg=%d}',
                        [local_idx, options[local_idx].text, options[local_idx].score,
                        options[local_idx].segments]);
                end;
                m_last_full_path_debug_info := m_last_full_path_debug_info + ']';
            end;

            Result := Length(options) > 0;
        end;

        function try_build_exact_chunk_lattice_local(out out_text: string;
            out out_path: string; out out_score: Integer;
            out out_segments: Integer; out out_has_anchor: Boolean;
            out out_anchor_units: Integer): Boolean;
        var
            start_idx: Integer;
            next_idx: Integer;
            chunk_syllables: Integer;
            option_idx: Integer;
            state_idx: Integer;
            options: TExactChunkChainOptionArray;
            suffix_states: TExactChunkChainStateArray;
            candidate_state: TExactChunkChainState;
            combined_score: Integer;
            combined_text: string;
            combined_path: string;
            combined_anchor_units: Integer;
            combined_has_anchor: Boolean;
            combined_segments: Integer;
            option_units_local: TArray<string>;
            option_raw_local: Integer;
            option_last_syllable_local: string;
            suffix_first_units_local: Integer;
            function_context_adjust_local: Integer;
            prefix_context_adjust_local: Integer;
            alternative_text_local: string;
            alternative_suffix_path_local: string;
            alternative_adjust_local: Integer;
            alternative_score_local: Integer;
            alternative_state_local: TExactChunkChainState;
            function get_lattice_exact_phrase_raw_weight_local(
                const query_key_local: string; const expected_units_local: Integer;
                const text_local: string): Integer;
            var
                local_results: TncCandidateList;
                local_idx: Integer;
                local_text: string;
            begin
                Result := 0;
                if (query_key_local = '') or (text_local = '') then
                begin
                    Exit;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_local,
                    local_results) then
                begin
                    Exit;
                end;

                for local_idx := 0 to High(local_results) do
                begin
                    if local_idx >= c_chain_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(local_results[local_idx].comment) <> '' then
                    begin
                        Continue;
                    end;

                    local_text := Trim(local_results[local_idx].text);
                    if (get_candidate_text_unit_count(local_text) =
                        expected_units_local) and SameText(local_text, text_local) then
                    begin
                        Exit(get_exact_chunk_raw_weight_local(
                            local_results[local_idx]));
                    end;
                end;
            end;
        begin
            Result := False;
            out_text := '';
            out_path := '';
            out_score := Low(Integer);
            out_segments := MaxInt;
            out_has_anchor := False;
            out_anchor_units := -1;

            SetLength(lattice_state_map, syllable_count_local + 1);
            SetLength(lattice_state_map[syllable_count_local], 1);
            lattice_state_map[syllable_count_local][0] :=
                Default(TExactChunkChainState);
            lattice_state_map[syllable_count_local][0].score := 0;
            lattice_state_map[syllable_count_local][0].segments := 0;
            lattice_state_map[syllable_count_local][0].anchor_units := -1;

            for start_idx := syllable_count_local - 1 downto 0 do
            begin
                SetLength(lattice_state_map[start_idx], 0);
                for chunk_syllables := 1 to Min(c_chain_lattice_max_chunk_syllables,
                    syllable_count_local - start_idx) do
                begin
                    next_idx := start_idx + chunk_syllables;
                    if (next_idx < syllable_count_local) and
                        (Length(lattice_state_map[next_idx]) = 0) then
                    begin
                        Continue;
                    end;

                    if not try_collect_exact_chunk_options_local(start_idx,
                        chunk_syllables, options) then
                    begin
                        Continue;
                    end;

                    if next_idx < syllable_count_local then
                    begin
                        suffix_states := lattice_state_map[next_idx];
                    end
                    else
                    begin
                        suffix_states := lattice_state_map[syllable_count_local];
                    end;

                    for option_idx := 0 to High(options) do
                    begin
                        for state_idx := 0 to High(suffix_states) do
                        begin
                            combined_score := options[option_idx].score +
                                suffix_states[state_idx].score;
                            if (suffix_states[state_idx].first_chunk_text <> '') and
                                (m_dictionary <> nil) then
                            begin
                                Inc(combined_score, m_dictionary.get_context_bonus(
                                    options[option_idx].text,
                                    suffix_states[state_idx].first_chunk_text));
                                Inc(combined_score,
                                    get_adjacent_exact_chunk_context_bonus_local(
                                    options[option_idx].text,
                                    suffix_states[state_idx].first_chunk_text));
                                if has_exact_chunk_merge_bonus_local(
                                    options[option_idx].query_key,
                                    suffix_states[state_idx].first_chunk_query_key,
                                    options[option_idx].text +
                                    suffix_states[state_idx].first_chunk_text,
                                    get_candidate_text_unit_count(
                                    options[option_idx].text) +
                                    get_candidate_text_unit_count(
                                    suffix_states[state_idx].first_chunk_text)) then
                                begin
                                    Inc(combined_score, c_chain_lattice_merge_bonus);
                                end;
                            end;
                            function_context_adjust_local := 0;
                            if suffix_states[state_idx].first_chunk_text <> '' then
                            begin
                                function_context_adjust_local :=
                                    get_function_particle_suffix_context_adjustment_local(
                                    effective_syllables[start_idx + chunk_syllables -
                                    1].text,
                                    options[option_idx].text,
                                    suffix_states[state_idx].first_chunk_text);
                                Inc(combined_score, function_context_adjust_local);
                                if starts_with_context_text_unit_local(
                                    suffix_states[state_idx].text, $5730) or
                                    starts_with_context_text_unit_local(
                                    suffix_states[state_idx].text, $5F97) or
                                    starts_with_context_text_unit_local(
                                    suffix_states[state_idx].text, $4E3A) or
                                    starts_with_context_text_unit_local(
                                    suffix_states[state_idx].text, $672A) then
                                begin
                                    prefix_context_adjust_local :=
                                        get_function_particle_prefix_context_adjustment_local(
                                        options[option_idx].text,
                                        suffix_states[state_idx].text);
                                    if prefix_context_adjust_local <= -90000 then
                                    begin
                                        Continue;
                                    end;
                                    Inc(combined_score, prefix_context_adjust_local);
                                end;
                            end;

                            suffix_first_units_local := get_candidate_text_unit_count(
                                Trim(suffix_states[state_idx].first_chunk_text));
                            option_units_local := split_text_units(
                                Trim(options[option_idx].text));
                            if (Length(option_units_local) = chunk_syllables) and
                                (chunk_syllables >= 2) and
                                (suffix_first_units_local >= 2) and
                                ((SameText(option_units_local[
                                High(option_units_local)], string(Char($5730)))) or
                                (SameText(option_units_local[
                                High(option_units_local)], string(Char($5F97))))) then
                            begin
                                option_last_syllable_local := normalize_pinyin_text(
                                    effective_syllables[start_idx + chunk_syllables -
                                    1].text);
                                option_raw_local := get_lattice_exact_phrase_raw_weight_local(
                                    options[option_idx].query_key, chunk_syllables,
                                    options[option_idx].text);
                                if (option_last_syllable_local = 'de') and
                                    ((option_raw_local <= 0) or
                                    (option_raw_local < 700)) then
                                begin
                                    Dec(combined_score, 30000);
                                end;
                            end;

                            combined_text := options[option_idx].text +
                                suffix_states[state_idx].text;
                            combined_path := options[option_idx].path;
                            if suffix_states[state_idx].path <> '' then
                            begin
                                if combined_path <> '' then
                                begin
                                    combined_path := combined_path +
                                        c_segment_path_separator;
                                end;
                                combined_path := combined_path +
                                    suffix_states[state_idx].path;
                            end;
                            combined_segments := options[option_idx].segments +
                                suffix_states[state_idx].segments;
                            combined_has_anchor := options[option_idx].has_anchor or
                                suffix_states[state_idx].has_anchor;
                            combined_anchor_units := options[option_idx].anchor_units;
                            if suffix_states[state_idx].anchor_units >
                                combined_anchor_units then
                            begin
                                combined_anchor_units :=
                                    suffix_states[state_idx].anchor_units;
                            end;

                            candidate_state := Default(TExactChunkChainState);
                            candidate_state.text := combined_text;
                            candidate_state.path := combined_path;
                            candidate_state.first_chunk_text :=
                                options[option_idx].text;
                            candidate_state.first_chunk_query_key :=
                                options[option_idx].query_key;
                            candidate_state.score := combined_score;
                            candidate_state.segments := combined_segments;
                            candidate_state.has_anchor := combined_has_anchor;
                            candidate_state.anchor_units := combined_anchor_units;
                            consider_exact_chunk_chain_state_local(
                                lattice_state_map[start_idx], candidate_state,
                                start_idx);

                            if try_get_function_particle_suffix_head_alternative_local(
                                options[option_idx].text,
                                suffix_states[state_idx].text,
                                suffix_states[state_idx].path,
                                suffix_states[state_idx].first_chunk_text,
                                suffix_states[state_idx].first_chunk_query_key,
                                alternative_text_local,
                                alternative_suffix_path_local,
                                alternative_adjust_local) then
                            begin
                                alternative_state_local := candidate_state;
                                alternative_state_local.text :=
                                    options[option_idx].text +
                                    alternative_text_local;
                                alternative_state_local.path :=
                                    options[option_idx].path;
                                if alternative_suffix_path_local <> '' then
                                begin
                                    if alternative_state_local.path <> '' then
                                    begin
                                        alternative_state_local.path :=
                                            alternative_state_local.path +
                                            c_segment_path_separator;
                                    end;
                                    alternative_state_local.path :=
                                        alternative_state_local.path +
                                        alternative_suffix_path_local;
                                end;
                                alternative_state_local.score :=
                                    combined_score + alternative_adjust_local;
                                consider_exact_chunk_chain_state_local(
                                    lattice_state_map[start_idx],
                                    alternative_state_local, start_idx);
                            end;

                            if (options[option_idx].segments = 1) and
                                (suffix_states[state_idx].first_chunk_text <> '') and
                                try_get_function_particle_boundary_alternative_local(
                                effective_syllables[start_idx + chunk_syllables -
                                1].text,
                                options[option_idx].text,
                                suffix_states[state_idx].first_chunk_text,
                                alternative_text_local, alternative_adjust_local) then
                            begin
                                alternative_score_local := combined_score -
                                    function_context_adjust_local +
                                    alternative_adjust_local;
                                alternative_state_local := candidate_state;
                                alternative_state_local.text := alternative_text_local +
                                    suffix_states[state_idx].text;
                                alternative_state_local.path := alternative_text_local;
                                if suffix_states[state_idx].path <> '' then
                                begin
                                    alternative_state_local.path :=
                                        alternative_state_local.path +
                                        c_segment_path_separator +
                                        suffix_states[state_idx].path;
                                end;
                                alternative_state_local.first_chunk_text :=
                                    alternative_text_local;
                                alternative_state_local.score :=
                                    alternative_score_local;
                                consider_exact_chunk_chain_state_local(
                                    lattice_state_map[start_idx],
                                    alternative_state_local, start_idx);
                            end;
                        end;
                    end;
                end;
            end;

            if Length(lattice_state_map[0]) = 0 then
            begin
                Exit;
            end;

            out_text := lattice_state_map[0][0].text;
            out_path := lattice_state_map[0][0].path;
            out_score := lattice_state_map[0][0].score;
            out_segments := lattice_state_map[0][0].segments;
            out_has_anchor := lattice_state_map[0][0].has_anchor;
            out_anchor_units := lattice_state_map[0][0].anchor_units;
            Result := out_text <> '';
        end;

        function try_build_fast_dictionary_sentence_candidate_local(
            out out_text: string; out out_path: string; out out_score: Integer;
            out out_segments: Integer;
            out out_states: TExactChunkChainStateArray): Boolean;
        const
            c_fast_max_chunk_syllables = 5;
            c_fast_split_probe_limit = 6;
            c_fast_length_bonus = 2300;
            c_fast_fixed_single_bonus = 1200;
            c_fast_segment_penalty = 720;
            c_fast_completion_bonus = 2200;
        var
            state_map_local: array of TExactChunkChainStateArray;
            retained_state_map_local: array of TExactChunkChainStateArray;
            baseline_candidates_local: TExactChunkChainStateArray;
            legacy_candidates_local: TExactChunkChainStateArray;
            edge_probe_candidates_local: TExactChunkChainStateArray;
            exact_edge_model_candidates_local:
                TExactChunkChainStateArray;
            pos_local: Integer;
            chunk_len_local: Integer;
            next_pos_local: Integer;
            options_local: TExactChunkChainOptionArray;
            probe_options_local: TExactChunkChainOptionArray;
            option_idx_local: Integer;
            suffix_idx_local: Integer;
            suffix_count_local: Integer;
            debug_state_idx_local: Integer;
            candidate_state_local: TExactChunkChainState;
            suffix_state_local: TExactChunkChainState;
            base_state_local: TExactChunkChainState;
            head_two_key_local: string;
            head_two_text_local: string;
            head_two_raw_local: Integer;
            suffix_first_raw_local: Integer;
            suffix_first_units_local: Integer;
            current_pair_text_local: string;
            natural_modifier_phrase_boundary_local: Boolean;
            state_debug_text_local: string;
            function_context_adjust_local: Integer;
            prefix_context_adjust_local: Integer;
            alternative_text_local: string;
            alternative_suffix_path_local: string;
            alternative_adjust_local: Integer;
            alternative_score_local: Integer;
            alternative_state_local: TExactChunkChainState;
            greedy_state_local: TExactChunkChainState;
            greedy_state_found_local: Boolean;
            greedy_state_present_local: Boolean;
            prefix_state_local: TExactChunkChainState;
            prefix_state_found_local: Boolean;
            prefix_state_present_local: Boolean;
            retained_slot_states_local: TExactChunkChainStateArray;
            fast_seed_requires_dp_local: Boolean;
            minimum_score_local: Integer;
            baseline_acceptance_score_local: Integer;
            baseline_acceptance_found_local: Boolean;
            exact_edge_reserved_slots_local: Integer;

            function try_get_sentence_final_modal_particle_text_fast_local(
                const syllable_key_local: string; out out_text_local: string): Boolean;
            var
                normalized_key_local: string;
            begin
                out_text_local := '';
                normalized_key_local := normalize_pinyin_text(syllable_key_local);
                if normalized_key_local = 'ba' then
                begin
                    out_text_local := string(Char($5427));
                end
                else if normalized_key_local = 'ma' then
                begin
                    out_text_local := string(Char($5417));
                end
                else if normalized_key_local = 'ne' then
                begin
                    out_text_local := string(Char($5462));
                end
                else if normalized_key_local = 'a' then
                begin
                    out_text_local := string(Char($554A));
                end
                else if normalized_key_local = 'ya' then
                begin
                    out_text_local := string(Char($5440));
                end
                else if normalized_key_local = 'la' then
                begin
                    out_text_local := string(Char($5566));
                end
                else if normalized_key_local = 'le' then
                begin
                    out_text_local := string(Char($4E86));
                end
                else if normalized_key_local = 'wa' then
                begin
                    out_text_local := string(Char($54C7));
                end;
                Result := out_text_local <> '';
            end;

            function try_build_prefix_exact_plus_short_tail_local(
                out out_state_local: TExactChunkChainState): Boolean;
            const
                c_tail_max_syllables = 4;
                c_min_prefix_syllables = 2;
                c_prefix_probe_limit = 6;
                c_tail_probe_limit = 8;
            var
                tail_len_local: Integer;
                prefix_len_local: Integer;
                prefix_key_local: string;
                tail_key_local: string;
                prefix_results_local: TncCandidateList;
                tail_results_local: TncCandidateList;
                tail_len_iter_local: Integer;
                prefix_idx_iter_local: Integer;
                tail_idx_iter_local: Integer;
                prefix_idx_local: Integer;
                tail_idx_local: Integer;
                prefix_candidate_local: TncCandidate;
                prefix_text_local: string;
                tail_text_local: string;
                prefix_score_local: Integer;
                tail_score_local: Integer;
                combined_text_local: string;
                combined_path_local: string;
                best_state_local: TExactChunkChainState;
                has_best_local: Boolean;
                resolved_prefix_text_local: string;
                resolved_prefix_path_local: string;
                resolved_prefix_score_local: Integer;
                resolved_prefix_segments_local: Integer;
                resolved_prefix_anchor_units_local: Integer;
                resolved_prefix_has_anchor_local: Boolean;
                resolved_tail_text_local: string;
                resolved_tail_path_local: string;
                resolved_tail_score_local: Integer;
                resolved_tail_segments_local: Integer;
                resolved_tail_anchor_units_local: Integer;
                resolved_tail_has_anchor_local: Boolean;
                tail_path_local: string;
                tail_segments_local: Integer;
                tail_anchor_units_local: Integer;
                tail_has_anchor_local: Boolean;

                function candidate_effective_score_local(
                    const candidate_local: TncCandidate): Integer;
                begin
                    Result := candidate_local.score;
                    if candidate_local.has_dict_weight and
                        (candidate_local.dict_weight > Result) then
                    begin
                        Result := candidate_local.dict_weight;
                    end;
                end;

                function resolved_path_has_multi_exact_chunk_local(
                    const span_start_local: Integer;
                    const span_units_local: Integer;
                    const path_value_local: string): Boolean;
                var
                    parts_local: TArray<string>;
                    part_idx_local: Integer;
                    segment_text_local: string;
                    segment_units_local: Integer;
                    segment_pos_local: Integer;
                    segment_key_local: string;
                    segment_results_local: TncCandidateList;
                    segment_idx_local: Integer;
                    has_multi_exact_local: Boolean;
                begin
                    Result := False;
                    has_multi_exact_local := False;
                    segment_pos_local := span_start_local;
                    if (Trim(path_value_local) = '') or
                        (span_start_local < 0) or (span_units_local <= 0) then
                    begin
                        Exit;
                    end;

                    parts_local := path_value_local.Split(
                        [c_segment_path_separator]);
                    for part_idx_local := 0 to High(parts_local) do
                    begin
                        segment_text_local := Trim(parts_local[part_idx_local]);
                        segment_units_local := get_candidate_text_unit_count(
                            segment_text_local);
                        if (segment_text_local = '') or
                            (segment_units_local <= 0) or
                            (segment_pos_local + segment_units_local >
                            span_start_local + span_units_local) then
                        begin
                            Exit(False);
                        end;

                        if segment_units_local >= 2 then
                        begin
                            segment_key_local := build_query_key_local(
                                segment_pos_local, segment_units_local);
                            if (segment_key_local <> '') and
                                lookup_exact_full_pinyin_cached_local(
                                segment_key_local, segment_results_local) then
                            begin
                                for segment_idx_local := 0 to Min(
                                    c_tail_probe_limit - 1,
                                    High(segment_results_local)) do
                                begin
                                    if SameText(Trim(segment_results_local[
                                        segment_idx_local].text),
                                        segment_text_local) then
                                    begin
                                        has_multi_exact_local := True;
                                        Break;
                                    end;
                                end;
                            end;
                        end;
                        Inc(segment_pos_local, segment_units_local);
                    end;
                    Result := has_multi_exact_local and
                        (segment_pos_local = span_start_local + span_units_local);
                end;

                function try_get_tail_text_local(const tail_units_local: Integer;
                    out out_text_local: string; out out_score_local: Integer): Boolean;
                var
                    fixed_text_local: string;
                begin
                    Result := False;
                    out_text_local := '';
                    out_score_local := 0;
                    tail_path_local := '';
                    tail_segments_local := 0;
                    tail_anchor_units_local := 0;
                    tail_has_anchor_local := False;
                    tail_key_local := build_query_key_local(prefix_len_local,
                        tail_units_local);
                    if tail_key_local = '' then
                    begin
                        Exit;
                    end;

                    if tail_units_local = 1 then
                    begin
                        if (prefix_len_local + tail_units_local =
                            syllable_count_local) and
                            try_get_sentence_final_modal_particle_text_fast_local(
                            effective_syllables[prefix_len_local].text,
                            fixed_text_local) then
                        begin
                            { Sentence-final particles should use their modal
                              form instead of the ordinary object/preposition
                              single for the same pinyin, e.g. ba -> 鍚? }
                        end
                        else
                        begin
                            fixed_text_local :=
                                get_fixed_boundary_single_char_for_standalone_local(
                                effective_syllables[prefix_len_local].text);
                        end;
                        if fixed_text_local <> '' then
                        begin
                            out_text_local := fixed_text_local;
                            tail_path_local := fixed_text_local;
                            tail_segments_local := 1;
                            out_score_local := 1200 + c_fast_fixed_single_bonus;
                            if lookup_exact_full_pinyin_cached_local(tail_key_local,
                                tail_results_local) then
                            begin
                                tail_idx_iter_local := 0;
                                while tail_idx_iter_local <= High(tail_results_local) do
                                begin
                                    tail_idx_local := tail_idx_iter_local;
                                    if tail_idx_local >= c_tail_probe_limit then
                                    begin
                                        Break;
                                    end;
                                    if SameText(Trim(tail_results_local[
                                        tail_idx_local].text), fixed_text_local) then
                                    begin
                                        out_score_local := Max(out_score_local,
                                            candidate_effective_score_local(
                                            tail_results_local[tail_idx_local]) +
                                            c_fast_fixed_single_bonus);
                                        Break;
                                    end;
                                    Inc(tail_idx_iter_local);
                                end;
                            end;
                            Exit(True);
                        end;
                        if try_get_best_single_char_for_query_key_local(tail_key_local,
                            out_text_local, out_score_local) then
                        begin
                            tail_path_local := out_text_local;
                            tail_segments_local := 1;
                            Inc(out_score_local, c_fast_fixed_single_bonus);
                            Exit(True);
                        end;
                        Exit;
                    end;

                    if lookup_exact_full_pinyin_cached_local(tail_key_local,
                        tail_results_local) then
                    begin
                        tail_idx_iter_local := 0;
                        while tail_idx_iter_local <= High(tail_results_local) do
                        begin
                            tail_idx_local := tail_idx_iter_local;
                            if tail_idx_local >= c_tail_probe_limit then
                            begin
                                Break;
                            end;
                            if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                            begin
                                Inc(tail_idx_iter_local);
                                Continue;
                            end;
                            tail_text_local := Trim(
                                tail_results_local[tail_idx_local].text);
                            if (get_candidate_text_unit_count(tail_text_local) <>
                                tail_units_local) or
                                (not is_valid_standalone_cjk_phrase_text_local(
                                tail_text_local, tail_units_local)) or
                                (not is_reliable_fast_exact_chunk_local(
                                tail_key_local, tail_units_local,
                                tail_text_local,
                                tail_results_local[tail_idx_local])) then
                            begin
                                Inc(tail_idx_iter_local);
                                Continue;
                            end;
                            out_text_local := tail_text_local;
                            tail_path_local := tail_text_local;
                            tail_segments_local := 1;
                            tail_has_anchor_local := tail_units_local >= 3;
                            if tail_has_anchor_local then
                            begin
                                tail_anchor_units_local := tail_units_local;
                            end;
                            out_score_local := candidate_effective_score_local(
                                tail_results_local[tail_idx_local]) +
                                get_exact_chunk_length_bonus_local(
                                tail_units_local);
                            Exit(True);
                        end;
                    end;

                    if (tail_units_local >= 2) and
                        try_resolve_best_exact_subspan_local(prefix_len_local,
                        tail_units_local, resolved_tail_text_local,
                        resolved_tail_score_local, resolved_tail_segments_local,
                        resolved_tail_path_local, resolved_tail_has_anchor_local,
                        resolved_tail_anchor_units_local) and
                        (resolved_tail_segments_local > 1) and
                        (get_candidate_text_unit_count(resolved_tail_text_local) =
                        tail_units_local) and
                        is_valid_standalone_cjk_phrase_text_local(
                        resolved_tail_text_local, tail_units_local) and
                        resolved_path_has_multi_exact_chunk_local(prefix_len_local,
                        tail_units_local, resolved_tail_path_local) then
                    begin
                        out_text_local := resolved_tail_text_local;
                        out_score_local := resolved_tail_score_local;
                        tail_path_local := resolved_tail_path_local;
                        tail_segments_local := resolved_tail_segments_local;
                        tail_has_anchor_local := resolved_tail_has_anchor_local;
                        tail_anchor_units_local :=
                            resolved_tail_anchor_units_local;
                        Exit(True);
                    end;
                end;

                procedure consider_prefix_candidate_local(
                    const candidate_local: TncCandidate);
                begin
                    prefix_text_local := Trim(candidate_local.text);
                    if (prefix_text_local = '') or
                        (Trim(candidate_local.comment) <> '') or
                        (get_candidate_text_unit_count(prefix_text_local) <>
                        prefix_len_local) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        prefix_text_local, prefix_len_local)) then
                    begin
                        Exit;
                    end;

                    prefix_score_local := candidate_effective_score_local(
                        candidate_local);
                    if prefix_score_local < 600 then
                    begin
                        Exit;
                    end;

                    if not try_get_tail_text_local(tail_len_local, tail_text_local,
                        tail_score_local) then
                    begin
                        Exit;
                    end;

                    combined_text_local := prefix_text_local + tail_text_local;
                    if get_candidate_text_unit_count(combined_text_local) <>
                        syllable_count_local then
                    begin
                        Exit;
                    end;

                    combined_path_local := prefix_text_local +
                        c_segment_path_separator + tail_path_local;
                    best_state_local := Default(TExactChunkChainState);
                    best_state_local.text := combined_text_local;
                    best_state_local.path := combined_path_local;
                    best_state_local.first_chunk_text := prefix_text_local;
                    best_state_local.first_chunk_query_key := prefix_key_local;
                    best_state_local.score := prefix_score_local + tail_score_local +
                        c_fast_completion_bonus + (prefix_len_local *
                        prefix_len_local * c_fast_length_bonus);
                    best_state_local.segments := 1 + tail_segments_local;
                    best_state_local.has_anchor := True;
                    best_state_local.anchor_units := Max(prefix_len_local,
                        tail_anchor_units_local);
                    has_best_local := True;
                end;

                procedure consider_resolved_prefix_candidate_local;
                begin
                    if (tail_len_local <> 1) or (prefix_len_local < 4) then
                    begin
                        Exit;
                    end;

                    if not try_resolve_best_exact_subspan_local(0,
                        prefix_len_local, resolved_prefix_text_local,
                        resolved_prefix_score_local,
                        resolved_prefix_segments_local,
                        resolved_prefix_path_local,
                        resolved_prefix_has_anchor_local,
                        resolved_prefix_anchor_units_local) then
                    begin
                        Exit;
                    end;

                    resolved_prefix_text_local := Trim(resolved_prefix_text_local);
                    if (resolved_prefix_text_local = '') or
                        (resolved_prefix_segments_local <= 1) or
                        (get_candidate_text_unit_count(resolved_prefix_text_local) <>
                        prefix_len_local) or
                        (not is_valid_standalone_cjk_phrase_text_local(
                        resolved_prefix_text_local, prefix_len_local)) or
                        (not resolved_path_has_multi_exact_chunk_local(0,
                        prefix_len_local, resolved_prefix_path_local)) then
                    begin
                        Exit;
                    end;

                    if not try_get_tail_text_local(tail_len_local, tail_text_local,
                        tail_score_local) then
                    begin
                        Exit;
                    end;

                    combined_text_local := resolved_prefix_text_local +
                        tail_text_local;
                    if get_candidate_text_unit_count(combined_text_local) <>
                        syllable_count_local then
                    begin
                        Exit;
                    end;

                    combined_path_local := resolved_prefix_path_local +
                        c_segment_path_separator + tail_path_local;
                    best_state_local := Default(TExactChunkChainState);
                    best_state_local.text := combined_text_local;
                    best_state_local.path := combined_path_local;
                    best_state_local.first_chunk_text := resolved_prefix_text_local;
                    best_state_local.first_chunk_query_key := prefix_key_local;
                    best_state_local.score := resolved_prefix_score_local +
                        tail_score_local + c_fast_completion_bonus +
                        (prefix_len_local * prefix_len_local *
                        c_fast_length_bonus);
                    best_state_local.segments := resolved_prefix_segments_local +
                        tail_segments_local;
                    best_state_local.has_anchor := True;
                    best_state_local.anchor_units := Max(prefix_len_local,
                        resolved_prefix_anchor_units_local);
                    has_best_local := True;
                end;
            begin
                Result := False;
                out_state_local := Default(TExactChunkChainState);
                if (syllable_count_local < c_min_prefix_syllables + 1) or
                    (m_dictionary = nil) then
                begin
                    Exit;
                end;

                tail_len_iter_local := 1;
                while tail_len_iter_local <= Min(c_tail_max_syllables,
                    syllable_count_local - c_min_prefix_syllables) do
                begin
                    tail_len_local := tail_len_iter_local;
                    prefix_len_local := syllable_count_local - tail_len_local;
                    if prefix_len_local < c_min_prefix_syllables then
                    begin
                        Inc(tail_len_iter_local);
                        Continue;
                    end;
                    prefix_key_local := build_query_key_local(0, prefix_len_local);
                    if prefix_key_local = '' then
                    begin
                        Inc(tail_len_iter_local);
                        Continue;
                    end;

                    has_best_local := False;
                    if lookup_exact_full_pinyin_cached_local(prefix_key_local,
                        prefix_results_local) then
                    begin
                        prefix_idx_iter_local := 0;
                        while prefix_idx_iter_local <= High(prefix_results_local) do
                        begin
                            prefix_idx_local := prefix_idx_iter_local;
                            if prefix_idx_local >= c_prefix_probe_limit then
                            begin
                                Break;
                            end;
                            prefix_candidate_local :=
                                prefix_results_local[prefix_idx_local];
                            consider_prefix_candidate_local(prefix_candidate_local);
                            if has_best_local then
                            begin
                                out_state_local := best_state_local;
                                Exit(True);
                            end;
                            Inc(prefix_idx_iter_local);
                        end;
                    end;
                    Inc(tail_len_iter_local);
                end;

                tail_len_local := 1;
                prefix_len_local := syllable_count_local - tail_len_local;
                prefix_key_local := build_query_key_local(0, prefix_len_local);
                has_best_local := False;
                consider_resolved_prefix_candidate_local;
                if has_best_local then
                begin
                    out_state_local := best_state_local;
                    Exit(True);
                end;
            end;

            function try_build_unambiguous_multi_exact_chain_local(
                out out_state_local: TExactChunkChainState): Boolean;
            const
                c_min_chunk_raw_weight = 500;
                c_min_unambiguous_chunk_raw_weight = 180;
                c_strong_chunk_raw_weight = 50000;
                c_clear_short_chunk_raw_floor = 700;
                c_clear_short_chunk_raw_gap = 96;
                c_clear_short_chunk_score_gap = 64;
                c_ambiguous_raw_gap = 700;
                c_short_ambiguous_raw_ratio_pct = 150;
                c_ambiguous_score_gap = 1600;
            var
                local_pos: Integer;
                local_chunk_len: Integer;
                local_key: string;
                local_results: TncCandidateList;
                local_idx: Integer;
                local_text: string;
                local_raw_weight: Integer;
                local_min_raw_weight: Integer;
                local_score: Integer;
                local_path_bonus: Integer;
                local_candidate_path: string;
                local_expanded_candidate_path: string;
                scan_idx: Integer;
                scan_text: string;
                scan_raw_weight: Integer;
                best_direct_raw_weight: Integer;
                tail_support_bonus: Integer;
                best_text: string;
                best_key: string;
                best_raw_weight: Integer;
                best_score: Integer;
                second_raw_weight: Integer;
                second_score: Integer;
                fixed_single_text: string;
                fixed_single_count: Integer;
                picked: Boolean;
                first_chunk: string;
                first_key: string;

                function is_unambiguous_splittable_tail_local(
                    const text_value_local: string): Boolean;
                begin
                    Result := (text_value_local = string(Char($53BB))) or
                        (text_value_local = string(Char($7684))) or
                        (text_value_local = string(Char($4E86))) or
                        (text_value_local = string(Char($5427))) or
                        (text_value_local = string(Char($5417)));
                end;

                function expand_unambiguous_function_tail_path_local(
                    const path_value_local: string): string;
                var
                    parts_local: TArray<string>;
                    units_local: TArray<string>;
                    part_idx_local: Integer;
                    unit_idx_local: Integer;
                    segment_text_local: string;
                    head_text_local: string;
                    tail_text_local: string;
                begin
                    Result := '';
                    if Trim(path_value_local) = '' then
                    begin
                        Exit;
                    end;

                    parts_local := path_value_local.Split(
                        [c_segment_path_separator]);
                    for part_idx_local := 0 to High(parts_local) do
                    begin
                        segment_text_local := Trim(parts_local[part_idx_local]);
                        if segment_text_local = '' then
                        begin
                            Continue;
                        end;

                        units_local := split_text_units(segment_text_local);
                        if (Length(units_local) >= 3) and
                            is_unambiguous_splittable_tail_local(
                            units_local[High(units_local)]) then
                        begin
                            head_text_local := '';
                            for unit_idx_local := 0 to High(units_local) - 1 do
                            begin
                                head_text_local := head_text_local +
                                    units_local[unit_idx_local];
                            end;
                            tail_text_local := units_local[High(units_local)];
                            if Result <> '' then
                            begin
                                Result := Result + c_segment_path_separator;
                            end;
                            Result := Result + head_text_local +
                                c_segment_path_separator + tail_text_local;
                        end
                        else
                        begin
                            if Result <> '' then
                            begin
                                Result := Result + c_segment_path_separator;
                            end;
                            Result := Result + segment_text_local;
                        end;
                    end;
                end;

                function has_reliable_following_exact_chunk_local(
                    const from_pos: Integer): Boolean;
                var
                    probe_len: Integer;
                    probe_key: string;
                    probe_results: TncCandidateList;
                    probe_idx: Integer;
                    probe_text: string;
                begin
                    Result := False;
                    if from_pos >= syllable_count_local then
                    begin
                        Exit(True);
                    end;
                    if from_pos < 0 then
                    begin
                        Exit;
                    end;

                    for probe_len := Min(3, syllable_count_local - from_pos) downto 2 do
                    begin
                        probe_key := build_query_key_local(from_pos, probe_len);
                        if (probe_key = '') or
                            (not lookup_exact_full_pinyin_cached_local(probe_key,
                            probe_results)) then
                        begin
                            Continue;
                        end;

                        for probe_idx := 0 to High(probe_results) do
                        begin
                            if probe_idx >= get_chain_probe_limit_local then
                            begin
                                Break;
                            end;
                            if Trim(probe_results[probe_idx].comment) <> '' then
                            begin
                                Continue;
                            end;
                            probe_text := Trim(probe_results[probe_idx].text);
                            if (get_candidate_text_unit_count(probe_text) =
                                probe_len) and
                                is_valid_standalone_cjk_phrase_text_local(
                                probe_text, probe_len) and
                                is_reliable_fast_exact_chunk_local(probe_key,
                                probe_len, probe_text, probe_results[probe_idx]) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;

                function should_allow_long_fixed_single_bridge_local(
                    const syllable_text_local: string;
                    const fixed_text_local: string): Boolean;
                var
                    normalized_syllable_local: string;
                begin
                    Result := False;
                    normalized_syllable_local :=
                        normalize_pinyin_text(syllable_text_local);
                    if (fixed_text_local = '') or (normalized_syllable_local = '') then
                    begin
                        Exit;
                    end;

                    if normalized_syllable_local = 'yi' then
                    begin
                        // Avoid restoring the old "涓€/宕庡矕" style split.
                        Exit;
                    end;

                    Result := (local_pos > 0) and (fixed_single_count < 2) and
                        has_reliable_following_exact_chunk_local(local_pos + 1);
                end;

                function should_allow_long_tail_single_completion_local: Boolean;
                begin
                    Result := (local_pos > 0) and
                        (syllable_count_local - local_pos <= 3);
                end;

                function should_defer_pair_to_modifier_tail_exact_local(
                    const pair_text_local: string): Boolean;
                var
                    prefix_text_local: string;
                    tail_key_local: string;
                    pair_units_local: TArray<string>;
                begin
                    Result := False;
                    if (local_chunk_len <> 2) or
                        (local_pos + 2 >= syllable_count_local) or
                        (pair_text_local = '') then
                    begin
                        Exit;
                    end;

                    if not try_get_modifier_prefix_single_text_local(
                        effective_syllables[local_pos].text, prefix_text_local) then
                    begin
                        Exit;
                    end;

                    pair_units_local := split_text_units(Trim(pair_text_local));
                    if (Length(pair_units_local) <> 2) or
                        SameText(pair_units_local[0], prefix_text_local) then
                    begin
                        Exit;
                    end;

                    tail_key_local := build_query_key_local(local_pos + 1, 2);
                    Result := has_high_quality_exact_phrase_for_key_local(
                        tail_key_local, 2, 700);
                end;
            begin
                Result := False;
                out_state_local := Default(TExactChunkChainState);
                if (syllable_count_local < 6) or (m_dictionary = nil) then
                begin
                    Exit;
                end;

                local_pos := 0;
                first_chunk := '';
                first_key := '';
                fixed_single_count := 0;
                while local_pos < syllable_count_local do
                begin
                    picked := False;
                    best_text := '';
                    best_key := '';
                    best_score := Low(Integer);

                    for local_chunk_len := Min(c_fast_max_chunk_syllables,
                        syllable_count_local - local_pos) downto 2 do
                    begin
                        local_key := build_query_key_local(local_pos,
                            local_chunk_len);
                        if (local_key = '') or
                            (not lookup_exact_full_pinyin_cached_local(local_key,
                            local_results)) then
                        begin
                            Continue;
                        end;

                        best_text := '';
                        best_key := '';
                        best_raw_weight := Low(Integer);
                        best_score := Low(Integer);
                        second_raw_weight := Low(Integer);
                        second_score := Low(Integer);
                        best_direct_raw_weight := 0;

                        if (local_chunk_len = 2) and (local_pos > 0) and
                            (local_pos + local_chunk_len = syllable_count_local) then
                        begin
                            for scan_idx := 0 to High(local_results) do
                            begin
                                if scan_idx >= get_chain_probe_limit_local then
                                begin
                                    Break;
                                end;
                                if Trim(local_results[scan_idx].comment) <> '' then
                                begin
                                    Continue;
                                end;

                                scan_text := Trim(local_results[scan_idx].text);
                                if (scan_text = '') or
                                    (get_candidate_text_unit_count(scan_text) <>
                                    local_chunk_len) or
                                    (not is_valid_standalone_cjk_phrase_text_local(
                                    scan_text, local_chunk_len)) then
                                begin
                                    Continue;
                                end;

                                scan_raw_weight := get_exact_chunk_raw_weight_local(
                                    local_results[scan_idx]);
                                if scan_raw_weight > best_direct_raw_weight then
                                begin
                                    best_direct_raw_weight := scan_raw_weight;
                                end;
                            end;
                        end;

                        for local_idx := 0 to High(local_results) do
                        begin
                            if local_idx >= get_chain_probe_limit_local then
                            begin
                                Break;
                            end;
                            if Trim(local_results[local_idx].comment) <> '' then
                            begin
                                Continue;
                            end;

                            local_text := Trim(local_results[local_idx].text);
                            if (local_text = '') or
                                (get_candidate_text_unit_count(local_text) <>
                                local_chunk_len) or
                                (not is_valid_standalone_cjk_phrase_text_local(
                                local_text, local_chunk_len)) or
                                (not is_reliable_fast_exact_chunk_local(local_key,
                                local_chunk_len, local_text,
                                local_results[local_idx])) then
                            begin
                                Continue;
                            end;

                            local_raw_weight := get_exact_chunk_raw_weight_local(
                                local_results[local_idx]);
                            if get_exact_chunk_boundary_adjustment_local(
                                local_pos, local_chunk_len, local_text) <= -12000 then
                            begin
                                Continue;
                            end;
                            if should_defer_pair_to_modifier_tail_exact_local(
                                local_text) then
                            begin
                                Continue;
                            end;
                            tail_support_bonus := 0;
                            if (local_chunk_len = 2) and (local_pos > 0) and
                                (local_pos + local_chunk_len =
                                syllable_count_local) and
                                (best_direct_raw_weight > 0) and
                                (local_raw_weight < best_direct_raw_weight) and
                                ((local_raw_weight + 1400) >=
                                best_direct_raw_weight) then
                            begin
                                tail_support_bonus :=
                                    m_dictionary.get_compound_tail_support(
                                    local_text);
                                if (tail_support_bonus <= 0) or
                                    ((best_direct_raw_weight >= 900) and
                                    (tail_support_bonus < 2000)) then
                                begin
                                    tail_support_bonus := 0;
                                end
                                else
                                begin
                                    tail_support_bonus := Min(1800,
                                        tail_support_bonus);
                                end;
                            end;
                            local_min_raw_weight := c_min_chunk_raw_weight;
                            if syllable_count_local <= 6 then
                            begin
                                local_min_raw_weight := 450;
                            end;
                            if local_chunk_len >= 4 then
                            begin
                                local_min_raw_weight := 220;
                            end;
                            if Length(local_results) = 1 then
                            begin
                                local_min_raw_weight := Min(local_min_raw_weight,
                                    c_min_unambiguous_chunk_raw_weight);
                            end;
                            if (local_raw_weight < local_min_raw_weight) and
                                (tail_support_bonus <= 0) then
                            begin
                                Continue;
                            end;
                            local_score := get_exact_chunk_effective_weight_local(
                                local_results[local_idx]) +
                                get_exact_chunk_length_bonus_local(
                                local_chunk_len) +
                                (get_chain_probe_limit_local - local_idx) * 96;
                            Inc(local_score, get_exact_chunk_boundary_adjustment_local(
                                local_pos, local_chunk_len, local_text));
                            if tail_support_bonus > 0 then
                            begin
                                Inc(local_score, tail_support_bonus);
                            end;
                            if (local_pos + local_chunk_len =
                                syllable_count_local) and
                                (out_state_local.path <> '') then
                            begin
                                local_candidate_path := out_state_local.path +
                                    c_segment_path_separator + local_text;
                                local_path_bonus := Max(0,
                                    get_cached_query_segment_path_bonus(
                                    lookup_text, local_candidate_path));
                                local_expanded_candidate_path :=
                                    expand_unambiguous_function_tail_path_local(
                                    local_candidate_path);
                                if (local_expanded_candidate_path <> '') and
                                    (not SameText(local_expanded_candidate_path,
                                    local_candidate_path)) then
                                begin
                                    local_path_bonus := Max(local_path_bonus,
                                        Max(0,
                                        get_cached_query_segment_path_bonus(
                                        lookup_text,
                                        local_expanded_candidate_path)));
                                end;
                                Inc(local_path_bonus, Max(0,
                                    get_session_query_path_bonus(lookup_text,
                                    local_candidate_path)));
                                Inc(local_path_bonus, Max(0,
                                    get_session_ranked_query_path_bonus(
                                    local_candidate_path)));
                                if local_path_bonus > 0 then
                                begin
                                    Inc(local_score, Min(1600,
                                        local_path_bonus * 2));
                                end;
                            end;

                            if local_score > best_score then
                            begin
                                second_raw_weight := best_raw_weight;
                                second_score := best_score;
                                best_text := local_text;
                                best_key := local_key;
                                best_raw_weight := local_raw_weight;
                                best_score := local_score;
                            end
                            else if local_score > second_score then
                            begin
                                second_raw_weight := local_raw_weight;
                                second_score := local_score;
                            end;
                        end;

                        if (best_text <> '') and
                            ((best_raw_weight >= c_strong_chunk_raw_weight) or
                            ((local_chunk_len <= 3) and
                            (best_raw_weight >= c_clear_short_chunk_raw_floor) and
                            (best_raw_weight >= second_raw_weight +
                            c_clear_short_chunk_raw_gap) and
                            (best_score >= second_score +
                            c_clear_short_chunk_score_gap)) or
                            (second_score = Low(Integer)) or
                            (best_raw_weight >= second_raw_weight +
                            c_ambiguous_raw_gap) or
                            ((syllable_count_local <= 6) and
                            (best_raw_weight > 0) and
                            (second_raw_weight > 0) and
                            (best_raw_weight * 100 >= second_raw_weight *
                            c_short_ambiguous_raw_ratio_pct)) or
                            (best_score >= second_score +
                            c_ambiguous_score_gap)) then
                        begin
                            picked := True;
                            Break;
                        end;
                    end;

                    if (not picked) and (syllable_count_local <= 6) then
                    begin
                        local_chunk_len := 1;
                        local_key := build_query_key_local(local_pos, 1);
                        if (local_pos + 1 = syllable_count_local) and
                            try_get_sentence_final_modal_particle_text_fast_local(
                            effective_syllables[local_pos].text,
                            fixed_single_text) then
                        begin
                        end
                        else if not try_get_modifier_prefix_single_text_local(
                            effective_syllables[local_pos].text,
                            fixed_single_text) then
                        begin
                            fixed_single_text :=
                                get_fixed_boundary_single_char_for_standalone_local(
                                effective_syllables[local_pos].text);
                        end;
                        if fixed_single_text <> '' then
                        begin
                            best_text := fixed_single_text;
                            best_key := local_key;
                            best_score := 1200 + c_fast_fixed_single_bonus;
                            if lookup_exact_full_pinyin_cached_local(local_key,
                                local_results) then
                            begin
                                for local_idx := 0 to High(local_results) do
                                begin
                                    if local_idx >= get_chain_probe_limit_local then
                                    begin
                                        Break;
                                    end;
                                    if SameText(Trim(local_results[local_idx].text),
                                        fixed_single_text) then
                                    begin
                                        best_score := Max(best_score,
                                            get_exact_chunk_effective_weight_local(
                                            local_results[local_idx]) +
                                            c_fast_fixed_single_bonus);
                                        Break;
                                    end;
                                end;
                            end;
                            picked := True;
                        end
                        else if try_get_best_single_char_for_query_key_local(
                            local_key, best_text, best_score) then
                        begin
                            best_key := local_key;
                            Dec(best_score, 900);
                            picked := True;
                        end;
                    end;

                    if (not picked) and (syllable_count_local > 6) then
                    begin
                        local_chunk_len := 1;
                        local_key := build_query_key_local(local_pos, 1);
                        if (local_pos + 1 = syllable_count_local) and
                            try_get_sentence_final_modal_particle_text_fast_local(
                            effective_syllables[local_pos].text,
                            fixed_single_text) then
                        begin
                        end
                        else if not try_get_modifier_prefix_single_text_local(
                            effective_syllables[local_pos].text,
                            fixed_single_text) then
                        begin
                            fixed_single_text :=
                                get_fixed_boundary_single_char_for_standalone_local(
                                effective_syllables[local_pos].text);
                        end;
                        if should_allow_long_fixed_single_bridge_local(
                            effective_syllables[local_pos].text,
                            fixed_single_text) then
                        begin
                            best_text := fixed_single_text;
                            best_key := local_key;
                            best_score := 900 + c_fast_fixed_single_bonus;
                            if lookup_exact_full_pinyin_cached_local(local_key,
                                local_results) then
                            begin
                                for local_idx := 0 to High(local_results) do
                                begin
                                    if local_idx >= get_chain_probe_limit_local then
                                    begin
                                        Break;
                                    end;
                                    if SameText(Trim(local_results[local_idx].text),
                                        fixed_single_text) then
                                    begin
                                        best_score := Max(best_score,
                                            get_exact_chunk_effective_weight_local(
                                            local_results[local_idx]) +
                                            c_fast_fixed_single_bonus);
                                        Break;
                                    end;
                                end;
                            end;
                            Inc(fixed_single_count);
                            picked := True;
                        end;
                        if (not picked) and
                            should_allow_long_tail_single_completion_local then
                        begin
                            if fixed_single_text <> '' then
                            begin
                                best_text := fixed_single_text;
                                best_key := local_key;
                                best_score := 600 + c_fast_fixed_single_bonus;
                                picked := True;
                            end
                            else if try_get_best_single_char_for_query_key_local(
                                local_key, best_text, best_score) then
                            begin
                                best_key := local_key;
                                Dec(best_score, 500);
                                picked := True;
                            end;
                            if picked then
                            begin
                                Inc(fixed_single_count);
                            end;
                        end;
                    end;

                    if not picked then
                    begin
                        Exit(False);
                    end;

                    if first_chunk = '' then
                    begin
                        first_chunk := best_text;
                        first_key := best_key;
                    end;
                    out_state_local.text := out_state_local.text + best_text;
                    if out_state_local.path <> '' then
                    begin
                        out_state_local.path := out_state_local.path +
                            c_segment_path_separator;
                    end;
                    out_state_local.path := out_state_local.path + best_text;
                    Inc(out_state_local.score, best_score -
                        c_fast_segment_penalty);
                    Inc(out_state_local.segments);
                    if local_chunk_len > out_state_local.anchor_units then
                    begin
                        out_state_local.anchor_units := local_chunk_len;
                    end;
                    Inc(local_pos, local_chunk_len);
                end;

                if (out_state_local.text = '') or
                    (out_state_local.segments < 2) or
                    (get_candidate_text_unit_count(out_state_local.text) <>
                    syllable_count_local) then
                begin
                    Exit(False);
                end;

                out_state_local.first_chunk_text := first_chunk;
                out_state_local.first_chunk_query_key := first_key;
                out_state_local.has_anchor := True;
                Inc(out_state_local.score, c_fast_completion_bonus);
                Result := True;
            end;

            procedure add_fast_option_local(
                var local_options: TExactChunkChainOptionArray;
                var legacy_options: TExactChunkChainOptionArray;
                const local_option: TExactChunkChainOption);
            var
                candidate_option_local: TExactChunkChainOption;
                rebuilt_options_local: TExactChunkChainOptionArray;
                insert_idx_local: Integer;
                option_idx_local: Integer;
                existing_idx_local: Integer;
                existing_option_local: TExactChunkChainOption;
                duplicate_found_local: Boolean;
            begin
                if local_option.text = '' then
                begin
                    Exit;
                end;

                if not use_exact_edge_ranker_expansion_local then
                begin
                    candidate_option_local := local_option;
                    candidate_option_local.baseline_option := True;
                    SetLength(local_options, Length(local_options) + 1);
                    local_options[High(local_options)] :=
                        candidate_option_local;
                    for insert_idx_local := High(local_options) downto 1 do
                    begin
                        if not is_exact_chunk_option_better_local(
                            local_options[insert_idx_local],
                            local_options[insert_idx_local - 1]) then
                        begin
                            Break;
                        end;
                        existing_option_local :=
                            local_options[insert_idx_local - 1];
                        local_options[insert_idx_local - 1] :=
                            local_options[insert_idx_local];
                        local_options[insert_idx_local] :=
                            existing_option_local;
                    end;
                    if Length(local_options) >
                        get_chain_option_limit_local then
                    begin
                        SetLength(local_options,
                            get_chain_option_limit_local);
                    end;
                    Exit;
                end;

                if not local_option.edge_expanded_only then
                begin
                    candidate_option_local := local_option;
                    candidate_option_local.baseline_option := True;
                    SetLength(legacy_options, Length(legacy_options) + 1);
                    legacy_options[High(legacy_options)] :=
                        candidate_option_local;
                    for insert_idx_local := High(legacy_options) downto 1 do
                    begin
                        if not is_exact_chunk_option_better_local(
                            legacy_options[insert_idx_local],
                            legacy_options[insert_idx_local - 1]) then
                        begin
                            Break;
                        end;
                        existing_option_local :=
                            legacy_options[insert_idx_local - 1];
                        legacy_options[insert_idx_local - 1] :=
                            legacy_options[insert_idx_local];
                        legacy_options[insert_idx_local] :=
                            existing_option_local;
                    end;
                    if Length(legacy_options) >
                        get_chain_option_limit_local then
                    begin
                        SetLength(legacy_options,
                            get_chain_option_limit_local);
                    end;
                end;

                candidate_option_local := local_option;
                candidate_option_local.baseline_option := False;
                if candidate_option_local.direct_exact and
                    (candidate_option_local.exact_rank > 0) then
                begin
                    candidate_option_local.edge_retention_score :=
                        long_edge_retention_score(
                        candidate_option_local.exact_rank,
                        candidate_option_local.raw_weight,
                        candidate_option_local.top_weight,
                        candidate_option_local.score,
                        get_candidate_text_unit_count(
                        candidate_option_local.text),
                        pos_local, syllable_count_local,
                        candidate_option_local.source_user);
                    build_long_edge_retention_features(
                        candidate_option_local.exact_rank,
                        candidate_option_local.raw_weight,
                        candidate_option_local.top_weight,
                        candidate_option_local.score,
                        get_candidate_text_unit_count(
                        candidate_option_local.text),
                        pos_local, syllable_count_local,
                        candidate_option_local.source_user,
                        candidate_option_local.edge_retention_features);
                end;

                duplicate_found_local := False;
                for existing_idx_local := 0 to High(local_options) do
                begin
                    if SameText(local_options[existing_idx_local].text,
                        candidate_option_local.text) and
                        SameText(local_options[existing_idx_local].path,
                        candidate_option_local.path) then
                    begin
                        duplicate_found_local := True;
                        if is_exact_chunk_option_better_local(
                            candidate_option_local,
                            local_options[existing_idx_local]) then
                        begin
                            local_options[existing_idx_local] :=
                                candidate_option_local;
                        end;
                        Break;
                    end;
                end;
                if not duplicate_found_local then
                begin
                    SetLength(local_options, Length(local_options) + 1);
                    local_options[High(local_options)] := candidate_option_local;
                end;
                for option_idx_local := 1 to High(local_options) do
                begin
                    insert_idx_local := option_idx_local;
                    while (insert_idx_local > 0) and
                        is_exact_chunk_option_better_local(
                        local_options[insert_idx_local],
                        local_options[insert_idx_local - 1]) do
                    begin
                        existing_option_local :=
                            local_options[insert_idx_local - 1];
                        local_options[insert_idx_local - 1] :=
                            local_options[insert_idx_local];
                        local_options[insert_idx_local] :=
                            existing_option_local;
                        Dec(insert_idx_local);
                    end;
                end;

                rebuilt_options_local := Copy(legacy_options, 0,
                    Length(legacy_options));
                for option_idx_local := 0 to
                    High(rebuilt_options_local) do
                begin
                    existing_option_local :=
                        rebuilt_options_local[option_idx_local];
                    existing_option_local.baseline_option := True;
                    rebuilt_options_local[option_idx_local] :=
                        existing_option_local;
                end;

                if use_exact_edge_ranker_expansion_local then
                begin
                    { Training capture needs every probed exact edge. Normal
                      search deliberately keeps the legacy option set until an
                      independently validated edge model can retain extra
                      states without displacing existing paths. }
                    for option_idx_local := 0 to High(local_options) do
                    begin
                        if not local_options[option_idx_local].direct_exact then
                        begin
                            Continue;
                        end;
                        duplicate_found_local := False;
                        for existing_idx_local := 0 to
                            High(rebuilt_options_local) do
                        begin
                            if SameText(rebuilt_options_local[
                                existing_idx_local].text,
                                local_options[option_idx_local].text) and
                                SameText(rebuilt_options_local[
                                existing_idx_local].path,
                                local_options[option_idx_local].path) then
                            begin
                                duplicate_found_local := True;
                                Break;
                            end;
                        end;
                        if duplicate_found_local then
                        begin
                            Continue;
                        end;
                        existing_option_local :=
                            local_options[option_idx_local];
                        existing_option_local.baseline_option := False;
                        SetLength(rebuilt_options_local,
                            Length(rebuilt_options_local) + 1);
                        rebuilt_options_local[
                            High(rebuilt_options_local)] :=
                            existing_option_local;
                    end;
                end;
                local_options := rebuilt_options_local;
            end;

            procedure score_fast_options_local(
                var local_options: TExactChunkChainOptionArray);
            var
                option_idx_local: Integer;
                option_value_local: TExactChunkChainOption;
                exact_edge_features_local:
                    TncLongExactEdgeLatticeFeatures;
                exact_edge_score_local: Integer;
            begin
                for option_idx_local := 0 to High(local_options) do
                begin
                    option_value_local := local_options[option_idx_local];
                    if option_value_local.direct_exact and
                        (option_value_local.exact_rank > 0) and
                        (not option_value_local.source_user) and
                        (get_candidate_text_unit_count(
                        option_value_local.text) >=
                        c_chain_lattice_exact_edge_min_units) then
                    begin
                        option_value_local.edge_retention_score :=
                            long_edge_retention_score(
                            option_value_local.exact_rank,
                            option_value_local.raw_weight,
                            option_value_local.top_weight,
                            option_value_local.score,
                            get_candidate_text_unit_count(
                            option_value_local.text),
                            pos_local, syllable_count_local, False);
                        if option_value_local.edge_retention_score >
                            High(Integer) then
                        begin
                            exact_edge_score_local := High(Integer);
                        end
                        else if option_value_local.edge_retention_score <
                            Low(Integer) then
                        begin
                            exact_edge_score_local := Low(Integer);
                        end
                        else
                        begin
                            exact_edge_score_local :=
                                option_value_local.edge_retention_score;
                        end;
                        build_long_exact_edge_lattice_features(
                            option_value_local.query_key,
                            option_value_local.text,
                            get_candidate_text_unit_count(
                            option_value_local.text),
                            option_value_local.exact_rank,
                            option_value_local.raw_weight,
                            option_value_local.top_weight,
                            option_value_local.score,
                            exact_edge_score_local,
                            pos_local, syllable_count_local,
                            option_value_local.baseline_option,
                            exact_edge_features_local);
                        option_value_local.exact_edge_model_score :=
                            long_exact_edge_lattice_ranker_score(
                            exact_edge_features_local);
                        local_options[option_idx_local] := option_value_local;
                    end;
                end;
            end;

            function is_splittable_function_tail_fast_local(
                const text_value_local: string): Boolean;
            begin
                Result := (text_value_local = string(Char($53BB))) or
                    (text_value_local = string(Char($7684))) or
                    (text_value_local = string(Char($4E86))) or
                    (text_value_local = string(Char($5427))) or
                    (text_value_local = string(Char($5417)));
            end;

            function expand_function_tail_path_fast_local(
                const path_value_local: string): string;
            var
                parts_local: TArray<string>;
                units_local: TArray<string>;
                part_idx_local: Integer;
                unit_idx_local: Integer;
                segment_text_local: string;
                head_text_local: string;
                tail_text_local: string;
            begin
                Result := '';
                if Trim(path_value_local) = '' then
                begin
                    Exit;
                end;

                parts_local := path_value_local.Split(
                    [c_segment_path_separator]);
                for part_idx_local := 0 to High(parts_local) do
                begin
                    segment_text_local := Trim(parts_local[part_idx_local]);
                    if segment_text_local = '' then
                    begin
                        Continue;
                    end;

                    units_local := split_text_units(segment_text_local);
                    if (Length(units_local) >= 3) and
                        is_splittable_function_tail_fast_local(
                        units_local[High(units_local)]) then
                    begin
                        head_text_local := '';
                        for unit_idx_local := 0 to High(units_local) - 1 do
                        begin
                            head_text_local := head_text_local +
                                units_local[unit_idx_local];
                        end;
                        tail_text_local := units_local[High(units_local)];
                        if Result <> '' then
                        begin
                            Result := Result + c_segment_path_separator;
                        end;
                        Result := Result + head_text_local +
                            c_segment_path_separator + tail_text_local;
                    end
                    else
                    begin
                        if Result <> '' then
                        begin
                            Result := Result + c_segment_path_separator;
                        end;
                        Result := Result + segment_text_local;
                    end;
                end;
            end;

            function get_fast_full_path_adjustment_local(
                const path_value_local: string): Integer;
            const
                c_fast_path_bonus_cap = 1600;
                c_fast_path_bonus_scale = 2;
                c_fast_path_penalty_cap = 240;
            var
                bonus_local: Integer;
                expanded_bonus_local: Integer;
                penalty_local: Integer;
                expanded_path_local: string;
            begin
                Result := 0;
                if (m_dictionary = nil) or (lookup_text = '') or
                    (path_value_local = '') then
                begin
                    Exit;
                end;

                bonus_local := Max(0,
                    get_cached_query_segment_path_bonus(lookup_text,
                    path_value_local));
                Inc(bonus_local, Max(0, get_session_query_path_bonus(
                    lookup_text, path_value_local)));
                Inc(bonus_local, Max(0,
                    get_session_ranked_query_path_bonus(path_value_local)));

                expanded_path_local := expand_function_tail_path_fast_local(
                    path_value_local);
                if (expanded_path_local <> '') and
                    (not SameText(expanded_path_local, path_value_local)) then
                begin
                    expanded_bonus_local := Max(0,
                        get_cached_query_segment_path_bonus(lookup_text,
                        expanded_path_local));
                    Inc(expanded_bonus_local, Max(0,
                        get_session_query_path_bonus(lookup_text,
                        expanded_path_local)));
                    Inc(expanded_bonus_local, Max(0,
                        get_session_ranked_query_path_bonus(
                        expanded_path_local)));
                    if expanded_bonus_local > bonus_local then
                    begin
                        bonus_local := expanded_bonus_local;
                    end;
                end;

                penalty_local := Max(0,
                    get_cached_query_segment_path_penalty(lookup_text,
                    path_value_local));
                Inc(penalty_local, Max(0, get_session_query_path_penalty(
                    lookup_text, path_value_local)));

                Result := Min(c_fast_path_bonus_cap,
                    bonus_local * c_fast_path_bonus_scale) -
                    Min(c_fast_path_penalty_cap, penalty_local);
            end;

            function try_get_strong_fast_exact_phrase_text_local(
                const query_key_inner: string; const expected_units_inner: Integer;
                const min_raw_weight_inner: Integer; out out_text_inner: string): Boolean;
            var
                lookup_results_inner: TncCandidateList;
                lookup_idx_inner: Integer;
                text_inner: string;
                raw_weight_inner: Integer;
                score_inner: Integer;
                best_score_inner: Integer;
            begin
                Result := False;
                out_text_inner := '';
                best_score_inner := Low(Integer);
                if (query_key_inner = '') or (expected_units_inner < 2) or
                    (expected_units_inner > 5) then
                begin
                    Exit;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_inner,
                    lookup_results_inner) then
                begin
                    Exit;
                end;

                for lookup_idx_inner := 0 to High(lookup_results_inner) do
                begin
                    if lookup_idx_inner >= get_chain_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results_inner[lookup_idx_inner].comment) <> '' then
                    begin
                        Continue;
                    end;

                    text_inner := Trim(lookup_results_inner[lookup_idx_inner].text);
                    if (text_inner = '') or
                        (get_candidate_text_unit_count(text_inner) <>
                        expected_units_inner) or
                        (not is_valid_standalone_cjk_phrase_text_local(text_inner,
                        expected_units_inner)) then
                    begin
                        Continue;
                    end;

                    raw_weight_inner := get_exact_chunk_raw_weight_local(
                        lookup_results_inner[lookup_idx_inner]);
                    if raw_weight_inner < min_raw_weight_inner then
                    begin
                        Continue;
                    end;
                    if not is_reliable_fast_exact_chunk_local(query_key_inner,
                        expected_units_inner, text_inner,
                        lookup_results_inner[lookup_idx_inner]) then
                    begin
                        Continue;
                    end;

                    score_inner := get_exact_chunk_effective_weight_local(
                        lookup_results_inner[lookup_idx_inner]);
                    if (not Result) or (score_inner > best_score_inner) then
                    begin
                        Result := True;
                        best_score_inner := score_inner;
                        out_text_inner := text_inner;
                    end;
                end;
            end;

            function is_natural_modifier_phrase_boundary_fast_local(
                const prefix_text_inner: string; const tail_offset_inner: Integer;
                const tail_units_inner: Integer; const tail_text_inner: string;
                const min_tail_raw_weight_inner: Integer): Boolean;
            var
                tail_key_inner: string;
                strong_tail_text_inner: string;
            begin
                Result := False;
                if (prefix_text_inner = '') or (tail_text_inner = '') or
                    (tail_units_inner < 2) or
                    (not is_modifier_prefix_bridge_exempt_local(
                    prefix_text_inner)) then
                begin
                    Exit;
                end;

                tail_key_inner := build_query_key_local(tail_offset_inner,
                    tail_units_inner);
                Result := try_get_strong_fast_exact_phrase_text_local(
                    tail_key_inner, tail_units_inner,
                    min_tail_raw_weight_inner, strong_tail_text_inner) and
                    SameText(strong_tail_text_inner, Trim(tail_text_inner));
            end;

            function get_fast_exact_phrase_raw_weight_local(
                const query_key_inner: string; const expected_units_inner: Integer;
                const text_inner_value: string): Integer;
            var
                lookup_results_inner: TncCandidateList;
                lookup_idx_inner: Integer;
                lookup_text_inner: string;
                raw_weight_inner: Integer;
            begin
                Result := 0;
                if (query_key_inner = '') or (text_inner_value = '') or
                    (expected_units_inner < 2) then
                begin
                    Exit;
                end;

                if not lookup_exact_full_pinyin_cached_local(query_key_inner,
                    lookup_results_inner) then
                begin
                    Exit;
                end;

                for lookup_idx_inner := 0 to High(lookup_results_inner) do
                begin
                    if lookup_idx_inner >= get_chain_probe_limit_local then
                    begin
                        Break;
                    end;
                    if Trim(lookup_results_inner[lookup_idx_inner].comment) <> '' then
                    begin
                        Continue;
                    end;

                    lookup_text_inner := Trim(lookup_results_inner[lookup_idx_inner].text);
                    if (get_candidate_text_unit_count(lookup_text_inner) <>
                        expected_units_inner) or
                        (not SameText(lookup_text_inner, text_inner_value)) then
                    begin
                        Continue;
                    end;

                    raw_weight_inner := get_exact_chunk_raw_weight_local(
                        lookup_results_inner[lookup_idx_inner]);
                    if raw_weight_inner > Result then
                    begin
                        Result := raw_weight_inner;
                    end;
                end;
            end;

            function get_first_text_unit_fast_local(const value_inner: string): string;
            var
                units_inner: TArray<string>;
            begin
                Result := '';
                units_inner := split_text_units(Trim(value_inner));
                if Length(units_inner) > 0 then
                begin
                    Result := units_inner[0];
                end;
            end;

            function build_leading_span_text_fast_local(const value_inner: string;
                const unit_count_inner: Integer): string;
            var
                units_inner: TArray<string>;
                unit_idx_inner: Integer;
            begin
                Result := '';
                if unit_count_inner <= 0 then
                begin
                    Exit;
                end;

                units_inner := split_text_units(Trim(value_inner));
                if Length(units_inner) < unit_count_inner then
                begin
                    Exit;
                end;

                for unit_idx_inner := 0 to unit_count_inner - 1 do
                begin
                    Result := Result + units_inner[unit_idx_inner];
                end;
            end;

            function build_span_text_fast_local(const value_inner: string;
                const start_idx_inner: Integer; const unit_count_inner: Integer): string;
            var
                units_inner: TArray<string>;
                unit_idx_inner: Integer;
            begin
                Result := '';
                if (start_idx_inner < 0) or (unit_count_inner <= 0) then
                begin
                    Exit;
                end;

                units_inner := split_text_units(Trim(value_inner));
                if start_idx_inner + unit_count_inner > Length(units_inner) then
                begin
                    Exit;
                end;

                for unit_idx_inner := start_idx_inner to
                    start_idx_inner + unit_count_inner - 1 do
                begin
                    Result := Result + units_inner[unit_idx_inner];
                end;
            end;

            function text_starts_with_fast_local(const value_inner: string;
                const prefix_inner: string): Boolean;
            begin
                Result := (prefix_inner <> '') and
                    SameText(Copy(value_inner, 1, Length(prefix_inner)),
                    prefix_inner);
            end;

            function should_accept_greedy_exact_chain_state_local(
                const state_inner: TExactChunkChainState): Boolean;
            const
                c_best_exact_raw_margin = 420;
            var
                path_segments_inner: TArray<string>;
                segment_idx_inner: Integer;
                query_offset_inner: Integer;
                segment_text_inner: string;
                segment_units_inner: Integer;
                query_key_inner: string;
                lookup_results_inner: TncCandidateList;
                lookup_idx_inner: Integer;
                lookup_text_inner: string;
                lookup_raw_inner: Integer;
                selected_raw_inner: Integer;
                best_raw_inner: Integer;
                best_text_inner: string;
                prefix_text_inner: string;
                tail_key_inner: string;
                tail_text_inner: string;
                candidate_span_inner: string;
                preferred_span_inner: string;
                next_segment_text_inner: string;
                next_segment_units_inner: Integer;
                next_key_inner: string;
                next_raw_inner: Integer;
            begin
                Result := False;
                if (state_inner.path = '') or (m_dictionary = nil) then
                begin
                    Exit;
                end;

                path_segments_inner := state_inner.path.Split(
                    [c_segment_path_separator]);
                query_offset_inner := 0;
                for segment_idx_inner := 0 to High(path_segments_inner) do
                begin
                    segment_text_inner := Trim(path_segments_inner[segment_idx_inner]);
                    segment_units_inner := get_candidate_text_unit_count(
                        segment_text_inner);
                    if (segment_text_inner = '') or (segment_units_inner <= 0) or
                        (query_offset_inner + segment_units_inner >
                        syllable_count_local) then
                    begin
                        Exit;
                    end;

                    if segment_units_inner > 1 then
                    begin
                        query_key_inner := build_query_key_local(query_offset_inner,
                            segment_units_inner);
                        if (query_key_inner = '') or
                            (not lookup_exact_full_pinyin_cached_local(query_key_inner,
                            lookup_results_inner)) then
                        begin
                            Exit;
                        end;

                        selected_raw_inner := 0;
                        best_raw_inner := 0;
                        best_text_inner := '';
                        for lookup_idx_inner := 0 to High(lookup_results_inner) do
                        begin
                            if lookup_idx_inner >= get_chain_probe_limit_local then
                            begin
                                Break;
                            end;
                            if Trim(lookup_results_inner[lookup_idx_inner].comment) <> '' then
                            begin
                                Continue;
                            end;
                            lookup_text_inner := Trim(
                                lookup_results_inner[lookup_idx_inner].text);
                            if (get_candidate_text_unit_count(lookup_text_inner) <>
                                segment_units_inner) or
                                (not is_valid_standalone_cjk_phrase_text_local(
                                lookup_text_inner, segment_units_inner)) then
                            begin
                                Continue;
                            end;
                            lookup_raw_inner := get_exact_chunk_raw_weight_local(
                                lookup_results_inner[lookup_idx_inner]);
                            if lookup_raw_inner > best_raw_inner then
                            begin
                                best_raw_inner := lookup_raw_inner;
                                best_text_inner := lookup_text_inner;
                            end;
                            if SameText(lookup_text_inner, segment_text_inner) then
                            begin
                                selected_raw_inner := lookup_raw_inner;
                            end;
                        end;

                        if selected_raw_inner <= 0 then
                        begin
                            Exit;
                        end;
                        if (best_raw_inner >= selected_raw_inner +
                            c_best_exact_raw_margin) and
                            (best_text_inner <> '') and
                            (not SameText(best_text_inner, segment_text_inner)) then
                        begin
                            Exit;
                        end;
                    end;

                    if (segment_units_inner = 1) and
                        (segment_idx_inner < High(path_segments_inner)) and
                        (query_offset_inner + 2 <= syllable_count_local) then
                    begin
                        query_key_inner := build_query_key_local(query_offset_inner,
                            2);
                        if try_get_strong_fast_exact_phrase_text_local(
                            query_key_inner, 2, 700, best_text_inner) then
                        begin
                            next_segment_text_inner := Trim(
                                path_segments_inner[segment_idx_inner + 1]);
                            next_segment_units_inner :=
                                get_candidate_text_unit_count(
                                next_segment_text_inner);
                            candidate_span_inner := segment_text_inner +
                                get_first_text_unit_fast_local(
                                next_segment_text_inner);
                            if (candidate_span_inner <> '') and
                                (not SameText(candidate_span_inner,
                                best_text_inner)) then
                            begin
                                best_raw_inner :=
                                    get_fast_exact_phrase_raw_weight_local(
                                    query_key_inner, 2, best_text_inner);
                                next_raw_inner := 0;
                                if next_segment_units_inner >= 2 then
                                begin
                                    next_key_inner := build_query_key_local(
                                        query_offset_inner + 1,
                                        next_segment_units_inner);
                                    next_raw_inner :=
                                        get_fast_exact_phrase_raw_weight_local(
                                        next_key_inner, next_segment_units_inner,
                                        next_segment_text_inner);
                                end;
                                if next_raw_inner < best_raw_inner + 700 then
                                begin
                                    Exit;
                                end;
                            end;
                        end;
                    end;

                    if (segment_units_inner = 2) and
                        (segment_idx_inner < High(path_segments_inner)) then
                    begin
                        prefix_text_inner := '';
                        if (not try_get_modifier_prefix_single_text_local(
                            effective_syllables[query_offset_inner].text,
                            prefix_text_inner)) or (prefix_text_inner = '') then
                        begin
                            prefix_text_inner :=
                                get_fixed_boundary_single_char_for_standalone_local(
                                effective_syllables[query_offset_inner].text);
                        end;

                        if (prefix_text_inner <> '') and
                            SameText(get_first_text_unit_fast_local(segment_text_inner),
                            prefix_text_inner) and
                            (query_offset_inner + 3 <= syllable_count_local) then
                        begin
                            tail_key_inner := build_query_key_local(
                                query_offset_inner + 1, 2);
                            if try_get_strong_fast_exact_phrase_text_local(
                                tail_key_inner, 2, 800, tail_text_inner) then
                            begin
                                candidate_span_inner := build_span_text_fast_local(
                                    state_inner.text, query_offset_inner, 3);
                                preferred_span_inner := prefix_text_inner +
                                    tail_text_inner;
                                if (candidate_span_inner <> '') and
                                    (not SameText(candidate_span_inner,
                                    preferred_span_inner)) then
                                begin
                                    Exit;
                                end;
                            end;
                        end;
                    end;

                    Inc(query_offset_inner, segment_units_inner);
                end;

                Result := query_offset_inner = syllable_count_local;
            end;

            function fast_seed_lacks_lm_support_local(
                const state_inner: TExactChunkChainState): Boolean;
            var
                lm_stats_inner: TLongWordLmBoundaryStats;
                lm_bonus_inner: Integer;
            begin
                Result := False;
                if (input_syllable_count < 7) or
                    (input_syllable_count > 8) or
                    (state_inner.segments < 2) then
                begin
                    Exit;
                end;

                lm_bonus_inner := get_exact_chunk_chain_state_lm_bonus_local(
                    state_inner, 0, lm_stats_inner);
                Result := (lm_bonus_inner = 0) and
                    (lm_stats_inner.boundary_count > 0) and
                    (lm_stats_inner.supported_count = 0);
            end;

            function get_competing_boundary_penalty_fast_local(
                const candidate_text_from_pos_inner: string; const pos_inner: Integer;
                const chunk_len_inner: Integer;
                const option_inner: TExactChunkChainOption;
                const suffix_state_inner: TExactChunkChainState): Integer;
            const
                c_bad_two_plus_tail_penalty = 72000;
                c_cut_head_exact_penalty = 96000;
                c_strong_exact_span_penalty = 128000;
                c_strong_exact_span_min_weight = 900;
                c_strong_exact_span_margin = 180;
            var
                prefix_text_inner: string;
                tail_units_inner: Integer;
                tail_key_inner: string;
                tail_text_inner: string;
                preferred_text_inner: string;
                current_span_inner: string;
                head_text_inner: string;
                head_key_inner: string;
                head_raw_inner: Integer;
                current_raw_inner: Integer;
                suffix_first_units_inner: Integer;
                span_units_inner: Integer;
                left_units_inner: Integer;
                right_units_inner: Integer;
                span_start_abs_inner: Integer;
                span_left_text_inner: string;
                option_units_inner: TArray<string>;
                option_raw_inner: Integer;
                option_last_syllable_inner: string;
            begin
                Result := 0;
                if (candidate_text_from_pos_inner = '') or
                    (suffix_state_inner.first_chunk_text = '') then
                begin
                    Exit;
                end;

                // Prefer strong exact spans over cross-boundary homophone paths.
                // This keeps long-sentence DP from selecting a sequence of weak
                // exact chunks that cuts through an available high-quality phrase.
                for span_units_inner := 3 to Min(5,
                    syllable_count_local - pos_inner) do
                begin
                    if span_units_inner <= chunk_len_inner then
                    begin
                        Continue;
                    end;
                    head_key_inner := build_query_key_local(pos_inner,
                        span_units_inner);
                    if not try_get_strong_fast_exact_phrase_text_local(
                        head_key_inner, span_units_inner,
                        c_strong_exact_span_min_weight, head_text_inner) then
                    begin
                        Continue;
                    end;

                    current_span_inner := build_leading_span_text_fast_local(
                        candidate_text_from_pos_inner, span_units_inner);
                    if (current_span_inner = '') or
                        SameText(current_span_inner, head_text_inner) then
                    begin
                        Continue;
                    end;

                    head_raw_inner := get_fast_exact_phrase_raw_weight_local(
                        head_key_inner, span_units_inner, head_text_inner);
                    current_raw_inner := get_fast_exact_phrase_raw_weight_local(
                        head_key_inner, span_units_inner, current_span_inner);
                    if (head_raw_inner >= c_strong_exact_span_min_weight) and
                        ((current_raw_inner <= 0) or
                        (head_raw_inner >= current_raw_inner +
                        c_strong_exact_span_margin)) then
                    begin
                        Inc(Result, c_strong_exact_span_penalty);
                    end;
                end;
                if (option_inner.segments > 1) and
                    (chunk_len_inner > 2) and
                    (pos_inner + 2 <= syllable_count_local) and
                    try_get_strong_fast_exact_phrase_text_local(
                    build_query_key_local(pos_inner, 2), 2, 900,
                    head_text_inner) then
                begin
                    current_span_inner := build_leading_span_text_fast_local(
                        candidate_text_from_pos_inner, 2);
                    if (current_span_inner <> '') and
                        (not SameText(current_span_inner, head_text_inner)) then
                    begin
                        Inc(Result, c_cut_head_exact_penalty);
                    end;
                end;

                if chunk_len_inner = 2 then
                begin
                    prefix_text_inner := '';
                    if (not try_get_modifier_prefix_single_text_local(
                        effective_syllables[pos_inner].text, prefix_text_inner)) or
                        (prefix_text_inner = '') then
                    begin
                        prefix_text_inner :=
                            get_fixed_boundary_single_char_for_standalone_local(
                            effective_syllables[pos_inner].text);
                    end;

                    if (prefix_text_inner <> '') and
                        (not ((option_inner.segments = 1) and
                        try_get_strong_fast_exact_phrase_text_local(
                        option_inner.query_key, 2, 900, head_text_inner) and
                        SameText(head_text_inner, option_inner.text))) then
                    begin
                        if not SameText(get_first_text_unit_fast_local(
                            option_inner.text), prefix_text_inner) then
                        begin
                            for tail_units_inner := 2 to 3 do
                            begin
                                if pos_inner + 1 + tail_units_inner >
                                    syllable_count_local then
                                begin
                                    Continue;
                                end;
                                tail_key_inner := build_query_key_local(pos_inner + 1,
                                    tail_units_inner);
                                if try_get_strong_fast_exact_phrase_text_local(
                                    tail_key_inner, tail_units_inner, 800,
                                    tail_text_inner) then
                                begin
                                    preferred_text_inner := prefix_text_inner +
                                        tail_text_inner;
                                    current_span_inner :=
                                        build_leading_span_text_fast_local(
                                        candidate_text_from_pos_inner,
                                        1 + tail_units_inner);
                                    if (current_span_inner <> '') and
                                        (not SameText(current_span_inner,
                                        preferred_text_inner)) then
                                    begin
                                        Inc(Result, c_bad_two_plus_tail_penalty);
                                    end;
                                end;
                            end;
                        end
                        else
                        begin
                            tail_key_inner := build_query_key_local(pos_inner + 1, 2);
                            if try_get_strong_fast_exact_phrase_text_local(
                                tail_key_inner, 2, 800, tail_text_inner) then
                            begin
                                preferred_text_inner := prefix_text_inner +
                                    tail_text_inner;
                                current_span_inner :=
                                    build_leading_span_text_fast_local(
                                    candidate_text_from_pos_inner, 3);
                                if (current_span_inner <> '') and
                                    (not SameText(current_span_inner,
                                    preferred_text_inner)) then
                                begin
                                    Inc(Result, c_bad_two_plus_tail_penalty);
                                end;
                            end;
                        end;
                    end;

                    if (pos_inner + 3 <= syllable_count_local) and
                        try_get_strong_fast_exact_phrase_text_local(
                        build_query_key_local(pos_inner, 3), 3, 900,
                        head_text_inner) and
                        text_starts_with_fast_local(head_text_inner,
                        option_inner.text) then
                    begin
                        current_span_inner := build_leading_span_text_fast_local(
                            candidate_text_from_pos_inner, 3);
                        if (current_span_inner <> '') and
                            (not SameText(current_span_inner, head_text_inner)) then
                        begin
                            Inc(Result, c_cut_head_exact_penalty);
                        end;
                    end;
                end
                else if chunk_len_inner = 1 then
                begin
                    suffix_first_units_inner := get_candidate_text_unit_count(
                        Trim(suffix_state_inner.first_chunk_text));
                    if (suffix_first_units_inner >= 1) and
                        (pos_inner + 2 <= syllable_count_local) and
                        try_get_strong_fast_exact_phrase_text_local(
                        build_query_key_local(pos_inner, 2), 2, 700,
                        head_text_inner) and
                        text_starts_with_fast_local(head_text_inner,
                        option_inner.text) then
                    begin
                        current_span_inner := build_leading_span_text_fast_local(
                            candidate_text_from_pos_inner, 2);
                        if (current_span_inner <> '') and
                            (not SameText(current_span_inner, head_text_inner)) then
                        begin
                            tail_text_inner := '';
                            if (suffix_first_units_inner >= 2) and
                                is_modifier_prefix_bridge_exempt_local(
                                option_inner.text) and
                                try_get_strong_fast_exact_phrase_text_local(
                                build_query_key_local(pos_inner + 1,
                                suffix_first_units_inner),
                                suffix_first_units_inner, 700,
                                tail_text_inner) and
                                SameText(tail_text_inner,
                                Trim(suffix_state_inner.first_chunk_text)) then
                            begin
                                { A function single followed by a strong phrase
                                  is a natural boundary; do not let a weak
                                  cross-boundary exact pair suppress it. }
                            end
                            else
                            begin
                                Inc(Result, c_cut_head_exact_penalty);
                            end;
                        end;
                    end;
                end;

                if chunk_len_inner >= 2 then
                begin
                    suffix_first_units_inner := get_candidate_text_unit_count(
                        Trim(suffix_state_inner.first_chunk_text));
                    option_units_inner := split_text_units(Trim(option_inner.text));
                    if (Length(option_units_inner) = chunk_len_inner) and
                        (suffix_first_units_inner >= 2) and
                        ((SameText(option_units_inner[High(option_units_inner)],
                        string(Char($5730)))) or
                        (SameText(option_units_inner[High(option_units_inner)],
                        string(Char($5F97))))) then
                    begin
                        option_last_syllable_inner := normalize_pinyin_text(
                            effective_syllables[pos_inner + chunk_len_inner - 1].text);
                        option_raw_inner := get_fast_exact_phrase_raw_weight_local(
                            option_inner.query_key, chunk_len_inner,
                            option_inner.text);
                        if (option_last_syllable_inner = 'de') and
                            ((option_raw_inner <= 0) or (option_raw_inner < 700)) then
                        begin
                            Inc(Result, 30000);
                        end;
                    end;

                    suffix_first_units_inner := get_candidate_text_unit_count(
                        Trim(suffix_state_inner.first_chunk_text));
                    for span_units_inner := 3 to 4 do
                    begin
                        for left_units_inner := 2 to
                            Min(chunk_len_inner, span_units_inner - 1) do
                        begin
                            right_units_inner := span_units_inner - left_units_inner;
                            if (right_units_inner <= 0) or
                                (right_units_inner > suffix_first_units_inner) then
                            begin
                                Continue;
                            end;
                            span_start_abs_inner := pos_inner + chunk_len_inner -
                                left_units_inner;
                            if (span_start_abs_inner < pos_inner) or
                                (span_start_abs_inner + span_units_inner >
                                syllable_count_local) then
                            begin
                                Continue;
                            end;

                            if not try_get_strong_fast_exact_phrase_text_local(
                                build_query_key_local(span_start_abs_inner,
                                span_units_inner), span_units_inner, 900,
                                head_text_inner) then
                            begin
                                Continue;
                            end;

                            current_span_inner := build_span_text_fast_local(
                                candidate_text_from_pos_inner,
                                chunk_len_inner - left_units_inner,
                                span_units_inner);
                            span_left_text_inner := build_span_text_fast_local(
                                candidate_text_from_pos_inner,
                                chunk_len_inner - left_units_inner,
                                left_units_inner);
                            if (current_span_inner <> '') and
                                (span_left_text_inner <> '') and
                                text_starts_with_fast_local(head_text_inner,
                                span_left_text_inner) and
                                (not SameText(current_span_inner,
                                head_text_inner)) then
                            begin
                                Inc(Result, c_cut_head_exact_penalty);
                            end;
                        end;
                    end;
                end;
            end;

            function get_fast_state_order_score_local(
                const state_inner: TExactChunkChainState;
                out word_lm_bonus_inner: Integer;
                out word_lm_stats_inner: TLongWordLmBoundaryStats): Integer;
            const
                c_cross_boundary_exact_head_penalty = 90000;
                c_single_segment_penalty = 1600;
                c_multi_segment_bonus = 1200;
            var
                path_segments_inner: TArray<string>;
                segment_idx_inner: Integer;
                query_offset_inner: Integer;
                current_text_inner: string;
                next_text_inner: string;
                current_units_inner: Integer;
                next_units_inner: Integer;
                exact_head_text_inner: string;
                pair_key_inner: string;
                current_pair_text_inner: string;
            begin
                word_lm_bonus_inner := 0;
                word_lm_stats_inner := Default(TLongWordLmBoundaryStats);
                Result := state_inner.score;
                if state_inner.path = '' then
                begin
                    Exit;
                end;

                path_segments_inner := state_inner.path.Split(
                    [c_segment_path_separator]);
                query_offset_inner := 0;
                for segment_idx_inner := 0 to High(path_segments_inner) do
                begin
                    current_text_inner := Trim(path_segments_inner[segment_idx_inner]);
                    current_units_inner := get_candidate_text_unit_count(
                        current_text_inner);
                    if (current_text_inner = '') or (current_units_inner <= 0) or
                        (query_offset_inner + current_units_inner >
                        syllable_count_local) then
                    begin
                        Exit;
                    end;

                    if current_units_inner = 1 then
                    begin
                        Dec(Result, c_single_segment_penalty);
                    end
                    else
                    begin
                        Inc(Result, current_units_inner * c_multi_segment_bonus);
                    end;

                    if (segment_idx_inner < High(path_segments_inner)) and
                        (current_units_inner = 1) and
                        (query_offset_inner + 2 <= syllable_count_local) then
                    begin
                        next_text_inner := Trim(
                            path_segments_inner[segment_idx_inner + 1]);
                        next_units_inner := get_candidate_text_unit_count(
                            next_text_inner);
                        if (next_text_inner <> '') and (next_units_inner = 1) and
                            is_modifier_prefix_bridge_exempt_local(
                            current_text_inner) and
                            is_modifier_prefix_bridge_exempt_local(
                            next_text_inner) then
                        begin
                            current_pair_text_inner := current_text_inner +
                                get_first_text_unit_fast_local(next_text_inner);
                            pair_key_inner := build_query_key_local(
                                query_offset_inner, 2);
                            if (pair_key_inner = '') or
                                (not try_get_strong_fast_exact_phrase_text_local(
                                pair_key_inner, 2, 700, exact_head_text_inner)) or
                                SameText(current_pair_text_inner,
                                exact_head_text_inner) then
                            begin
                                Inc(Result, 90000);
                            end
                            else
                            begin
                                Dec(Result, c_cross_boundary_exact_head_penalty);
                            end;
                        end;
                        if (next_text_inner <> '') and (next_units_inner > 0) and
                            try_get_strong_fast_exact_phrase_text_local(
                            build_query_key_local(query_offset_inner, 2), 2, 700,
                            exact_head_text_inner) and
                            text_starts_with_fast_local(exact_head_text_inner,
                            current_text_inner) then
                        begin
                            current_pair_text_inner := current_text_inner +
                                get_first_text_unit_fast_local(next_text_inner);
                            if (current_pair_text_inner <> '') and
                                (not SameText(current_pair_text_inner,
                                exact_head_text_inner)) then
                            begin
                                if is_natural_modifier_phrase_boundary_fast_local(
                                    current_text_inner, query_offset_inner + 1,
                                    next_units_inner, next_text_inner, 400) then
                                begin
                                    { A function/adverb single followed by a
                                      strong exact phrase is a valid boundary,
                                      e.g. 鍏?鎻愪氦; do not let a competing
                                      cross-boundary two-syllable word erase it. }
                                end
                                else
                                begin
                                    Dec(Result,
                                        c_cross_boundary_exact_head_penalty);
                                end;
                            end
                            else if next_units_inner > 1 then
                            begin
                                Dec(Result,
                                    c_cross_boundary_exact_head_penalty div 2);
                            end;
                        end;
                    end;

                    Inc(query_offset_inner, current_units_inner);
                end;

                word_lm_bonus_inner :=
                    get_exact_chunk_chain_state_lm_bonus_local(state_inner, 0,
                    word_lm_stats_inner);
                Inc(Result, word_lm_bonus_inner);
            end;

            function get_long_chain_ranker_profile_local: Integer;
            const
                c_default_long_chain_ranker_profile = 2;
            begin
                if m_debug_long_chain_ranker_profile >= 0 then
                begin
                    Exit(m_debug_long_chain_ranker_profile);
                end;
                Result := c_default_long_chain_ranker_profile;
            end;

            procedure get_long_chain_structure_stats_local(
                const state_inner: TExactChunkChainState;
                out single_segments_inner: Integer;
                out max_segment_units_inner: Integer);
            var
                structure_inner: TncLongPathStructureCacheValue;
            begin
                single_segments_inner := 0;
                max_segment_units_inner := 0;
                if get_cached_long_path_structure(state_inner.path,
                    structure_inner) then
                begin
                    single_segments_inner :=
                        structure_inner.single_segment_count;
                    max_segment_units_inner :=
                        structure_inner.max_segment_units;
                end;
            end;

            procedure get_long_ranker_char_scores_local(
                const state_texts_inner: TArray<string>;
                out full_scores_inner: TArray<Integer>;
                out suffix_scores_inner: TArray<Integer>;
                out context_scores_inner: TArray<Integer>;
                out full_scores_ok_inner: Boolean;
                out has_left_context_inner: Boolean;
                out left_context_inner: string);
            var
                idx_inner: Integer;
                previous_previous_text_inner: string;
                previous_text_inner: string;
            begin
                SetLength(full_scores_inner, Length(state_texts_inner));
                SetLength(suffix_scores_inner, Length(state_texts_inner));
                SetLength(context_scores_inner, Length(state_texts_inner));
                full_scores_ok_inner := False;
                has_left_context_inner := False;
                left_context_inner := '';
                if (m_dictionary = nil) or (Length(state_texts_inner) = 0) then
                begin
                    Exit;
                end;

                full_scores_ok_inner :=
                    get_cached_char_lm_scores(state_texts_inner,
                    full_scores_inner, clsm_full, '') and
                    (Length(full_scores_inner) = Length(state_texts_inner));
                if not full_scores_ok_inner then
                begin
                    SetLength(full_scores_inner, Length(state_texts_inner));
                    Exit;
                end;

                if (not get_cached_char_lm_scores(state_texts_inner,
                    suffix_scores_inner, clsm_suffix, '')) or
                    (Length(suffix_scores_inner) <> Length(state_texts_inner)) then
                begin
                    suffix_scores_inner := Copy(full_scores_inner);
                end;

                get_recent_path_context_seed(previous_previous_text_inner,
                    previous_text_inner);
                left_context_inner := Trim(previous_previous_text_inner) +
                    Trim(previous_text_inner);
                has_left_context_inner := left_context_inner <> '';
                if has_left_context_inner and
                    get_cached_char_lm_scores(state_texts_inner,
                    context_scores_inner, clsm_context,
                    left_context_inner) and
                    (Length(context_scores_inner) = Length(state_texts_inner)) then
                begin
                    Exit;
                end;

                context_scores_inner := Copy(suffix_scores_inner);
                if not has_left_context_inner then
                begin
                    for idx_inner := 0 to High(context_scores_inner) do
                    begin
                        context_scores_inner[idx_inner] :=
                            suffix_scores_inner[idx_inner];
                    end;
                end;
            end;

            procedure build_long_second_stage_features_local(
                const state_inner: TExactChunkChainState;
                const original_rank_inner: Integer;
                const first_stage_score_inner: Integer;
                const char_lm_score_inner: Integer;
                const char_lm_suffix_score_inner: Integer;
                const char_lm_context_score_inner: Integer;
                const has_left_context_inner: Boolean;
                const word_lm_bonus_inner: Integer;
                const word_lm_stats_inner: TLongWordLmBoundaryStats;
                const single_segments_inner: Integer;
                const max_segment_units_inner: Integer;
                out features_inner: TncLongSecondStageFeatures);
            const
                c_unknown_lexical_rank = 65;
            var
                parts_inner: TArray<string>;
                part_inner: string;
                part_text_inner: string;
                part_units_inner: Integer;
                part_idx_inner: Integer;
                query_offset_inner: Integer;
                query_key_inner: string;
                lookup_results_inner: TncCandidateList;
                lookup_idx_inner: Integer;
                eligible_rank_inner: Integer;
                selected_rank_inner: Integer;
                selected_weight_inner: Integer;
                top_weight_inner: Integer;
                raw_weight_inner: Integer;
                lookup_text_inner: string;
                known_segments_inner: Integer;
                top_segments_inner: Integer;
                margin_inner: Integer;
                path_structure_inner: TncLongPathStructureCacheValue;
                path_structure_cached_inner: Boolean;
                lexical_cache_key_inner: string;
                lexical_cache_value_inner: TncExactLexicalFeatureCacheValue;
                lexical_cache_hit_inner: Boolean;
            begin
                FillChar(features_inner, SizeOf(features_inner), 0);
                features_inner.first_stage_score := first_stage_score_inner;
                features_inner.base_score := state_inner.score;
                features_inner.char_lm_score := char_lm_score_inner;
                features_inner.char_lm_suffix_score :=
                    char_lm_suffix_score_inner;
                features_inner.char_lm_context_score :=
                    char_lm_context_score_inner;
                features_inner.char_lm_context_gain :=
                    char_lm_context_score_inner - char_lm_suffix_score_inner;
                if syllable_count_local > 0 then
                begin
                    features_inner.char_lm_per_unit :=
                        char_lm_score_inner div syllable_count_local;
                end;
                features_inner.word_lm_bonus := word_lm_bonus_inner;
                if state_inner.segments > 1 then
                begin
                    features_inner.word_lm_per_boundary :=
                        word_lm_bonus_inner div (state_inner.segments - 1);
                end;
                features_inner.word_lm_boundary_count :=
                    word_lm_stats_inner.boundary_count;
                features_inner.word_lm_boundary_min :=
                    word_lm_stats_inner.min_bonus;
                features_inner.word_lm_boundary_max :=
                    word_lm_stats_inner.max_bonus;
                features_inner.word_lm_boundary_first :=
                    word_lm_stats_inner.first_bonus;
                features_inner.word_lm_boundary_last :=
                    word_lm_stats_inner.last_bonus;
                features_inner.word_lm_zero_count :=
                    word_lm_stats_inner.zero_count;
                if word_lm_stats_inner.boundary_count > 0 then
                begin
                    features_inner.word_lm_supported_ratio :=
                        word_lm_stats_inner.supported_count * 1000 div
                        word_lm_stats_inner.boundary_count;
                    features_inner.word_lm_strong_ratio :=
                        word_lm_stats_inner.strong_count * 1000 div
                        word_lm_stats_inner.boundary_count;
                    features_inner.word_lm_trigram_ratio :=
                        word_lm_stats_inner.trigram_count * 1000 div
                        word_lm_stats_inner.boundary_count;
                end;
                features_inner.segments := state_inner.segments;
                features_inner.single_segments := single_segments_inner;
                features_inner.multi_segments := Max(0,
                    state_inner.segments - single_segments_inner);
                features_inner.max_segment_units := max_segment_units_inner;
                features_inner.min_segment_units := MaxInt;
                features_inner.anchor_units := state_inner.anchor_units;
                features_inner.has_anchor := state_inner.has_anchor;
                features_inner.baseline_lineage :=
                    state_inner.baseline_lineage;
                features_inner.original_rank := original_rank_inner;
                features_inner.input_syllable_count := syllable_count_local;
                features_inner.has_left_context := has_left_context_inner;
                if state_inner.segments > 0 then
                begin
                    features_inner.score_per_segment :=
                        state_inner.score div state_inner.segments;
                end;
                if (m_dictionary <> nil) and (lookup_text <> '') and
                    (state_inner.path <> '') then
                begin
                    features_inner.query_path_bonus :=
                        get_cached_query_segment_path_bonus(
                        lookup_text, state_inner.path);
                    features_inner.query_path_penalty :=
                        get_cached_query_segment_path_penalty(
                        lookup_text, state_inner.path);
                end;

                features_inner.lexical_weight_min := MaxInt;
                features_inner.lexical_margin_min := MaxInt;
                features_inner.min_segment_units := MaxInt;
                path_structure_cached_inner :=
                    get_cached_long_path_structure(state_inner.path,
                    path_structure_inner);
                if path_structure_cached_inner then
                begin
                    features_inner.min_segment_units :=
                        path_structure_inner.min_segment_units;
                    features_inner.segment_units_square_sum :=
                        path_structure_inner.segment_units_square_sum;
                    features_inner.first_segment_units :=
                        path_structure_inner.first_segment_units;
                    features_inner.last_segment_units :=
                        path_structure_inner.last_segment_units;
                end;
                parts_inner := state_inner.path.Split(
                    [c_segment_path_separator]);
                query_offset_inner := 0;
                known_segments_inner := 0;
                top_segments_inner := 0;
                for part_idx_inner := 0 to High(parts_inner) do
                begin
                    part_inner := parts_inner[part_idx_inner];
                    part_text_inner := Trim(part_inner);
                    part_units_inner := get_candidate_text_unit_count(
                        part_text_inner);
                    if part_units_inner <= 0 then
                    begin
                        Continue;
                    end;

                    if (not path_structure_cached_inner) and
                        (features_inner.first_segment_units = 0) then
                    begin
                        features_inner.first_segment_units := part_units_inner;
                    end;
                    if not path_structure_cached_inner then
                    begin
                        features_inner.last_segment_units := part_units_inner;
                        features_inner.min_segment_units := Min(
                            features_inner.min_segment_units, part_units_inner);
                        Inc(features_inner.segment_units_square_sum,
                            part_units_inner * part_units_inner);
                    end;

                    selected_weight_inner := 0;
                    selected_rank_inner := 0;
                    top_weight_inner := 0;
                    eligible_rank_inner := 0;
                    query_key_inner := build_query_key_local(
                        query_offset_inner, part_units_inner);
                    lexical_cache_key_inner := query_key_inner + #1 +
                        part_text_inner;
                    lexical_cache_hit_inner :=
                        (m_lookup_exact_lexical_feature_cache <> nil) and
                        m_lookup_exact_lexical_feature_cache.TryGetValue(
                        lexical_cache_key_inner, lexical_cache_value_inner);
                    if lexical_cache_hit_inner then
                    begin
                        selected_rank_inner :=
                            lexical_cache_value_inner.selected_rank;
                        selected_weight_inner :=
                            lexical_cache_value_inner.selected_weight;
                        top_weight_inner := lexical_cache_value_inner.top_weight;
                    end
                    else
                    begin
                        if (query_key_inner <> '') and
                            lookup_exact_full_pinyin_cached_local(query_key_inner,
                            lookup_results_inner) then
                        begin
                            for lookup_idx_inner := 0 to
                                High(lookup_results_inner) do
                            begin
                                if eligible_rank_inner >=
                                    c_unknown_lexical_rank - 1 then
                                begin
                                    Break;
                                end;
                                if Trim(lookup_results_inner[
                                    lookup_idx_inner].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                lookup_text_inner := Trim(lookup_results_inner[
                                    lookup_idx_inner].text);
                                if get_candidate_text_unit_count(
                                    lookup_text_inner) <> part_units_inner then
                                begin
                                    Continue;
                                end;
                                Inc(eligible_rank_inner);
                                raw_weight_inner :=
                                    get_exact_chunk_raw_weight_local(
                                    lookup_results_inner[lookup_idx_inner]);
                                top_weight_inner := Max(top_weight_inner,
                                    raw_weight_inner);
                                if (selected_rank_inner = 0) and
                                    SameText(lookup_text_inner,
                                    part_text_inner) then
                                begin
                                    selected_rank_inner := eligible_rank_inner;
                                    selected_weight_inner := raw_weight_inner;
                                end;
                            end;
                        end;
                        if m_lookup_exact_lexical_feature_cache <> nil then
                        begin
                            lexical_cache_value_inner.selected_rank :=
                                selected_rank_inner;
                            lexical_cache_value_inner.selected_weight :=
                                selected_weight_inner;
                            lexical_cache_value_inner.top_weight :=
                                top_weight_inner;
                            m_lookup_exact_lexical_feature_cache.AddOrSetValue(
                                lexical_cache_key_inner,
                                lexical_cache_value_inner);
                        end;
                    end;

                    if selected_rank_inner = 0 then
                    begin
                        selected_rank_inner := c_unknown_lexical_rank;
                    end
                    else
                    begin
                        Inc(known_segments_inner);
                        if selected_weight_inner >= top_weight_inner then
                        begin
                            Inc(top_segments_inner);
                        end;
                    end;
                    margin_inner := selected_weight_inner - top_weight_inner;
                    Inc(features_inner.lexical_weight_sum,
                        selected_weight_inner);
                    if selected_weight_inner <
                        features_inner.lexical_weight_min then
                    begin
                        features_inner.lexical_weight_min :=
                            selected_weight_inner;
                    end;
                    features_inner.lexical_weight_max := Max(
                        features_inner.lexical_weight_max,
                        selected_weight_inner);
                    Inc(features_inner.lexical_rank_sum,
                        selected_rank_inner);
                    features_inner.lexical_rank_max := Max(
                        features_inner.lexical_rank_max,
                        selected_rank_inner);
                    Inc(features_inner.lexical_margin_sum, margin_inner);
                    features_inner.lexical_margin_min := Min(
                        features_inner.lexical_margin_min, margin_inner);
                    if part_idx_inner = 0 then
                    begin
                        features_inner.first_segment_weight :=
                            selected_weight_inner;
                    end;
                    features_inner.last_segment_weight :=
                        selected_weight_inner;
                    Inc(query_offset_inner, part_units_inner);
                end;

                if features_inner.min_segment_units = MaxInt then
                begin
                    features_inner.min_segment_units := 0;
                end;
                if features_inner.lexical_weight_min = MaxInt then
                begin
                    features_inner.lexical_weight_min := 0;
                end;
                if features_inner.lexical_margin_min = MaxInt then
                begin
                    features_inner.lexical_margin_min := 0;
                end;
                if state_inner.segments > 0 then
                begin
                    features_inner.lexical_weight_mean :=
                        features_inner.lexical_weight_sum div
                        state_inner.segments;
                    features_inner.lexical_known_ratio :=
                        known_segments_inner * 1000 div state_inner.segments;
                    features_inner.lexical_top_ratio :=
                        top_segments_inner * 1000 div state_inner.segments;
                end;
                if syllable_count_local > 0 then
                begin
                    features_inner.lexical_weight_per_unit :=
                        features_inner.lexical_weight_sum div
                        syllable_count_local;
                end;
            end;

            function get_long_chain_ranker_correction_local(
                const state_inner: TExactChunkChainState;
                const char_lm_score_inner: Integer;
                const word_lm_bonus_inner: Integer;
                const profile_inner: Integer;
                const single_segments_inner: Integer;
                const max_segment_units_inner: Integer): Integer;
            var
                correction_inner: Int64;
                correction_cap_inner: Integer;
            begin
                Result := 0;
                if (profile_inner <= 0) or (syllable_count_local <= 5) then
                begin
                    Exit;
                end;

                { Keep the first-stage feature contract identical for every
                  learned second-stage profile. The LambdaRank training rows
                  use this bounded baseline; applying the retired profile-2
                  linear coefficients here would shift both first_stage_score
                  and original_rank before the tree model sees them. }
                correction_inner := Int64(char_lm_score_inner) * 15 +
                    Int64(word_lm_bonus_inner) * 44 -
                    Int64(state_inner.score) * 202 div 1000 +
                    Int64(state_inner.segments) * 1097 +
                    Int64(single_segments_inner) * 2564 +
                    Int64(max_segment_units_inner) * 8698 +
                    Int64(state_inner.anchor_units) * 8634;
                correction_cap_inner := 15000;

                if correction_inner > correction_cap_inner then
                begin
                    correction_inner := correction_cap_inner;
                end
                else if correction_inner < -correction_cap_inner then
                begin
                    correction_inner := -correction_cap_inner;
                end;
                Result := Integer(correction_inner);
            end;

            function get_long_second_stage_score_local(
                const profile_inner: Integer;
                const features_inner: TncLongSecondStageFeatures): Int64;
            begin
                Result := features_inner.first_stage_score;
                if (profile_inner < 2) or (syllable_count_local <= 5) or
                    nc_long_ablated(la_second_stage) then
                begin
                    Exit;
                end;
                Result := long_second_stage_ranker_score(features_inner);
            end;

            procedure sort_fast_states_by_order_score_local(
                var states_inner: TExactChunkChainStateArray);
            var
                idx_inner: Integer;
                insert_idx_inner: Integer;
                baseline_count_inner: Integer;
                extra_count_inner: Integer;
                ordered_count_inner: Integer;
                baseline_indices_inner: TArray<Integer>;
                extra_indices_inner: TArray<Integer>;
                ordered_states_inner: TExactChunkChainStateArray;
                swap_state_inner: TExactChunkChainState;
                current_index_inner: Integer;
                first_stage_score_inner: Integer;
                first_stage_scores_inner: TArray<Integer>;
                first_stage_ranks_inner: TArray<Integer>;
                second_stage_scores_inner: TArray<Int64>;
                word_lm_bonuses_inner: TArray<Integer>;
                word_lm_stats_values_inner: TArray<TLongWordLmBoundaryStats>;
                single_segment_counts_inner: TArray<Integer>;
                max_segment_units_values_inner: TArray<Integer>;
                feature_values_inner: TArray<TncLongSecondStageFeatures>;
                state_texts_inner: TArray<string>;
                char_scores_inner: TArray<Integer>;
                char_suffix_scores_inner: TArray<Integer>;
                char_context_scores_inner: TArray<Integer>;
                ranker_profile_inner: Integer;
                char_scores_ok_inner: Boolean;
                has_left_context_inner: Boolean;
                left_context_inner: string;
                compare_idx_inner: Integer;

                function is_extra_index_better_inner(
                    const left_inner: Integer;
                    const right_inner: Integer): Boolean;
                begin
                    Result := second_stage_scores_inner[left_inner] >
                        second_stage_scores_inner[right_inner];
                    if second_stage_scores_inner[left_inner] =
                        second_stage_scores_inner[right_inner] then
                    begin
                        Result := first_stage_scores_inner[left_inner] >
                            first_stage_scores_inner[right_inner];
                    end;
                end;

                function is_model_state_better_inner(
                    const left_inner: TExactChunkChainState;
                    const right_inner: TExactChunkChainState): Boolean;
                begin
                    Result := left_inner.ranker_second_stage_score >
                        right_inner.ranker_second_stage_score;
                    if left_inner.ranker_second_stage_score =
                        right_inner.ranker_second_stage_score then
                    begin
                        Result := left_inner.ranker_original_rank <
                            right_inner.ranker_original_rank;
                    end;
                    if (left_inner.ranker_second_stage_score =
                        right_inner.ranker_second_stage_score) and
                        (left_inner.ranker_original_rank =
                        right_inner.ranker_original_rank) then
                    begin
                        Result := CompareText(left_inner.text,
                            right_inner.text) < 0;
                    end;
                end;
            begin
                if Length(states_inner) = 0 then
                begin
                    Exit;
                end;
                SetLength(first_stage_scores_inner, Length(states_inner));
                SetLength(first_stage_ranks_inner, Length(states_inner));
                SetLength(second_stage_scores_inner, Length(states_inner));
                SetLength(word_lm_bonuses_inner, Length(states_inner));
                SetLength(word_lm_stats_values_inner, Length(states_inner));
                SetLength(single_segment_counts_inner, Length(states_inner));
                SetLength(max_segment_units_values_inner,
                    Length(states_inner));
                SetLength(feature_values_inner, Length(states_inner));
                ranker_profile_inner := get_long_chain_ranker_profile_local;
                char_scores_ok_inner := False;
                has_left_context_inner := False;
                if (ranker_profile_inner > 0) and
                    (syllable_count_local > 5) and (m_dictionary <> nil) then
                begin
                    SetLength(state_texts_inner, Length(states_inner));
                    for idx_inner := 0 to High(states_inner) do
                    begin
                        state_texts_inner[idx_inner] :=
                            Trim(states_inner[idx_inner].text);
                    end;
                    get_long_ranker_char_scores_local(state_texts_inner,
                        char_scores_inner, char_suffix_scores_inner,
                        char_context_scores_inner, char_scores_ok_inner,
                        has_left_context_inner, left_context_inner);
                end;
                for idx_inner := 0 to High(states_inner) do
                begin
                    states_inner[idx_inner].ranker_model_ordered := False;
                    states_inner[idx_inner].ranker_features_valid := False;
                    states_inner[idx_inner].ranker_feature_context_key := '';
                    get_long_chain_structure_stats_local(
                        states_inner[idx_inner],
                        single_segment_counts_inner[idx_inner],
                        max_segment_units_values_inner[idx_inner]);
                    first_stage_score_inner :=
                        get_fast_state_order_score_local(states_inner[idx_inner],
                        word_lm_bonuses_inner[idx_inner],
                        word_lm_stats_values_inner[idx_inner]);
                    if char_scores_ok_inner then
                    begin
                        Inc(first_stage_score_inner,
                            get_long_chain_ranker_correction_local(
                            states_inner[idx_inner],
                            char_scores_inner[idx_inner],
                            word_lm_bonuses_inner[idx_inner],
                            ranker_profile_inner,
                            single_segment_counts_inner[idx_inner],
                            max_segment_units_values_inner[idx_inner]));
                    end;

                    first_stage_scores_inner[idx_inner] :=
                        first_stage_score_inner;
                end;

                for idx_inner := 0 to High(states_inner) do
                begin
                    first_stage_ranks_inner[idx_inner] := 1;
                    for compare_idx_inner := 0 to High(states_inner) do
                    begin
                        if (first_stage_scores_inner[compare_idx_inner] >
                            first_stage_scores_inner[idx_inner]) or
                            ((first_stage_scores_inner[compare_idx_inner] =
                            first_stage_scores_inner[idx_inner]) and
                            (compare_idx_inner < idx_inner)) then
                        begin
                            Inc(first_stage_ranks_inner[idx_inner]);
                        end;
                    end;
                end;

                for idx_inner := 0 to High(states_inner) do
                begin
                    if char_scores_ok_inner then
                    begin
                        build_long_second_stage_features_local(
                            states_inner[idx_inner],
                            first_stage_ranks_inner[idx_inner],
                            first_stage_scores_inner[idx_inner],
                            char_scores_inner[idx_inner],
                            char_suffix_scores_inner[idx_inner],
                            char_context_scores_inner[idx_inner],
                            has_left_context_inner,
                            word_lm_bonuses_inner[idx_inner],
                            word_lm_stats_values_inner[idx_inner],
                            single_segment_counts_inner[idx_inner],
                            max_segment_units_values_inner[idx_inner],
                            feature_values_inner[idx_inner]);
                        second_stage_scores_inner[idx_inner] :=
                            get_long_second_stage_score_local(
                            ranker_profile_inner,
                            feature_values_inner[idx_inner]);
                        states_inner[idx_inner].ranker_features :=
                            feature_values_inner[idx_inner];
                        states_inner[idx_inner].ranker_features_valid := True;
                        states_inner[idx_inner].ranker_feature_context_key :=
                            left_context_inner;
                    end
                    else
                    begin
                        second_stage_scores_inner[idx_inner] :=
                            first_stage_scores_inner[idx_inner];
                    end;
                    states_inner[idx_inner].ranker_original_rank :=
                        first_stage_ranks_inner[idx_inner];
                    states_inner[idx_inner].ranker_first_stage_score :=
                        first_stage_scores_inner[idx_inner];
                    states_inner[idx_inner].ranker_second_stage_score :=
                        second_stage_scores_inner[idx_inner];
                end;

                if char_scores_ok_inner and (ranker_profile_inner >= 2) then
                begin
                    ordered_states_inner := Copy(states_inner);
                    for idx_inner := 1 to High(ordered_states_inner) do
                    begin
                        current_index_inner := idx_inner;
                        while (current_index_inner > 0) and
                            is_model_state_better_inner(
                            ordered_states_inner[current_index_inner],
                            ordered_states_inner[current_index_inner - 1]) do
                        begin
                            swap_state_inner :=
                                ordered_states_inner[current_index_inner - 1];
                            ordered_states_inner[current_index_inner - 1] :=
                                ordered_states_inner[current_index_inner];
                            ordered_states_inner[current_index_inner] :=
                                swap_state_inner;
                            Dec(current_index_inner);
                        end;
                    end;

                    for idx_inner := 0 to High(ordered_states_inner) do
                    begin
                        ordered_states_inner[idx_inner].ranker_model_ordered :=
                            True;
                    end;
                    states_inner := ordered_states_inner;
                    Exit;
                end;

                baseline_count_inner := 0;
                extra_count_inner := 0;
                for idx_inner := 0 to High(states_inner) do
                begin
                    if states_inner[idx_inner].baseline_lineage then
                    begin
                        Inc(baseline_count_inner);
                    end;
                    if not states_inner[idx_inner].baseline_lineage then
                    begin
                        Inc(extra_count_inner);
                    end;
                end;
                SetLength(baseline_indices_inner, baseline_count_inner);
                SetLength(extra_indices_inner, extra_count_inner);
                baseline_count_inner := 0;
                extra_count_inner := 0;
                for idx_inner := 0 to High(states_inner) do
                begin
                    if states_inner[idx_inner].baseline_lineage then
                    begin
                        baseline_indices_inner[baseline_count_inner] := idx_inner;
                        Inc(baseline_count_inner);
                    end;
                    if not states_inner[idx_inner].baseline_lineage then
                    begin
                        extra_indices_inner[extra_count_inner] := idx_inner;
                        Inc(extra_count_inner);
                    end;
                end;

                { The baseline pool is the exact legacy six-state beam. Keep
                  its first-stage order byte-for-byte unless a separately
                  calibrated promotion gate accepts one expanded state. }
                for idx_inner := 1 to High(baseline_indices_inner) do
                begin
                    current_index_inner := baseline_indices_inner[idx_inner];
                    insert_idx_inner := idx_inner - 1;
                    while (insert_idx_inner >= 0) and
                        (first_stage_scores_inner[
                        baseline_indices_inner[insert_idx_inner]] <
                        first_stage_scores_inner[current_index_inner]) do
                    begin
                        baseline_indices_inner[insert_idx_inner + 1] :=
                            baseline_indices_inner[insert_idx_inner];
                        Dec(insert_idx_inner);
                    end;
                    baseline_indices_inner[insert_idx_inner + 1] :=
                        current_index_inner;
                end;
                for idx_inner := 1 to High(extra_indices_inner) do
                begin
                    current_index_inner := extra_indices_inner[idx_inner];
                    insert_idx_inner := idx_inner - 1;
                    while (insert_idx_inner >= 0) and
                        is_extra_index_better_inner(current_index_inner,
                        extra_indices_inner[insert_idx_inner]) do
                    begin
                        extra_indices_inner[insert_idx_inner + 1] :=
                            extra_indices_inner[insert_idx_inner];
                        Dec(insert_idx_inner);
                    end;
                    extra_indices_inner[insert_idx_inner + 1] :=
                        current_index_inner;
                end;

                SetLength(ordered_states_inner, Length(states_inner));
                ordered_count_inner := 0;
                for idx_inner := 0 to High(baseline_indices_inner) do
                begin
                    ordered_states_inner[ordered_count_inner] :=
                        states_inner[baseline_indices_inner[idx_inner]];
                    Inc(ordered_count_inner);
                end;
                for idx_inner := 0 to High(extra_indices_inner) do
                begin
                    ordered_states_inner[ordered_count_inner] :=
                        states_inner[extra_indices_inner[idx_inner]];
                    Inc(ordered_count_inner);
                end;
                SetLength(ordered_states_inner, ordered_count_inner);
                states_inner := ordered_states_inner;
            end;

            procedure capture_final_chain_candidates_local(
