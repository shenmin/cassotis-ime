    function lookup_exact_full_pinyin_cached_local(const pinyin_key: string;
        out out_results: TncCandidateList): Boolean;
    var
        cache_key: string;
        cached_results: TncCandidateList;
        phase_tick: UInt64;

        procedure filter_visibility_only_path_entries_local;
        var
            read_idx: Integer;
            write_idx: Integer;
        begin
            if long_path_exact_lookup_filter_depth <= 0 then
            begin
                Exit;
            end;

            write_idx := 0;
            for read_idx := 0 to High(out_results) do
            begin
                if not long_exact_chunk_weight_is_eligible(
                    out_results[read_idx].dict_weight,
                    out_results[read_idx].has_dict_weight) then
                begin
                    Continue;
                end;
                if write_idx <> read_idx then
                begin
                    out_results[write_idx] := out_results[read_idx];
                end;
                Inc(write_idx);
            end;
            SetLength(out_results, write_idx);
        end;

    begin
        SetLength(out_results, 0);
        if (m_dictionary = nil) or (pinyin_key = '') then
        begin
            Exit(False);
        end;

        cache_key := '#exact#' + pinyin_key;
        if (lookup_cache <> nil) and lookup_cache.TryGetValue(cache_key,
            cached_results) then
        begin
            Inc(lookup_cache_hits);
            out_results := Copy(cached_results, 0, Length(cached_results));
            filter_visibility_only_path_entries_local;
            Exit(Length(out_results) > 0);
        end;
        if (m_build_lookup_cache <> nil) and
            m_build_lookup_cache.TryGetValue(cache_key, cached_results) then
        begin
            Inc(lookup_cache_hits);
            out_results := Copy(cached_results, 0, Length(cached_results));
            filter_visibility_only_path_entries_local;
            if lookup_cache <> nil then
            begin
                lookup_cache.AddOrSetValue(cache_key,
                    Copy(cached_results, 0, Length(cached_results)));
            end;
            Exit(Length(out_results) > 0);
        end;

        Inc(lookup_cache_misses);
        phase_tick := GetTickCount64;
        if not m_dictionary.lookup_exact_full_pinyin(pinyin_key,
            out_results) then
        begin
            SetLength(out_results, 0);
        end;
        Inc(lookup_elapsed_ms, Int64(GetTickCount64 - phase_tick));
        if lookup_cache <> nil then
        begin
            lookup_cache.AddOrSetValue(cache_key,
                Copy(out_results, 0, Length(out_results)));
        end;
        if m_build_lookup_cache <> nil then
        begin
            m_build_lookup_cache.AddOrSetValue(cache_key,
                Copy(out_results, 0, Length(out_results)));
        end;
        filter_visibility_only_path_entries_local;
        Result := Length(out_results) > 0;
    end;

    function direct_exact_lookup_has_text_local(const pinyin_key: string;
        const target_text: string; const target_units: Integer): Boolean;
    var
        exact_results_local: TncCandidateList;
        exact_idx_local: Integer;
        exact_text_local: string;
    begin
        Result := False;
        if (m_dictionary = nil) or (pinyin_key = '') or
            (target_text = '') or
            (not lookup_exact_full_pinyin_cached_local(pinyin_key,
            exact_results_local)) then
        begin
            Exit;
        end;

        for exact_idx_local := 0 to High(exact_results_local) do
        begin
            if not long_exact_chunk_weight_is_eligible(
                exact_results_local[exact_idx_local].dict_weight,
                exact_results_local[exact_idx_local].has_dict_weight) then
            begin
                Continue;
            end;
            exact_text_local := Trim(exact_results_local[exact_idx_local].text);
            if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                SameText(exact_text_local, target_text) and
                (get_candidate_text_unit_count(exact_text_local) =
                target_units) then
            begin
                Exit(True);
            end;
        end;
    end;

