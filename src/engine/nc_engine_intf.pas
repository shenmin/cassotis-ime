        end;

        function build_replaced_text_local(const units_value: TArray<string>;
            const replacement_idx: Integer; const replacement_text: string): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := 0 to High(units_value) do
            begin
                if local_idx = replacement_idx then
                begin
                    Result := Result + replacement_text;
                end
                else
                begin
                    Result := Result + units_value[local_idx];
                end;
            end;
        end;

        function right_context_has_long_exact_phrase_local(
            const start_idx_value: Integer): Boolean;
        var
            span_len_local: Integer;
            local_idx: Integer;
            query_key_local: string;
            text_local: string;

            function exact_units_local(const exact_start_idx: Integer;
                const exact_span_len: Integer): Boolean;
            var
                exact_idx: Integer;
                exact_key_local: string;
                exact_text_local: string;
            begin
                Result := False;
                if (exact_start_idx < 0) or (exact_span_len <= 1) or
                    (exact_start_idx + exact_span_len > expected_units) then
                begin
                    Exit;
                end;
                exact_key_local := build_display_query_key(exact_start_idx,
                    exact_span_len);
                exact_text_local := '';
                for exact_idx := exact_start_idx to
                    exact_start_idx + exact_span_len - 1 do
                begin
                    exact_text_local := exact_text_local +
                        candidate_units_local[exact_idx];
                end;
                Result := (exact_key_local <> '') and
                    (exact_text_local <> '') and
                    display_exact_key_has_text(exact_key_local,
                    exact_text_local);
            end;
        begin
            Result := False;
            if (start_idx_value < 0) or
                (start_idx_value >= expected_units) then
            begin
                Exit;
            end;

            if exact_units_local(start_idx_value, 2) and
                exact_units_local(start_idx_value + 2, 2) then
            begin
                Exit(True);
            end;

            for span_len_local := Min(4, expected_units - start_idx_value)
                downto 3 do
            begin
                query_key_local := build_display_query_key(start_idx_value,
                    span_len_local);
                text_local := '';
                for local_idx := start_idx_value to
                    start_idx_value + span_len_local - 1 do
                begin
                    text_local := text_local + candidate_units_local[local_idx];
                end;
                if (query_key_local <> '') and (text_local <> '') and
                    display_exact_key_has_text(query_key_local, text_local) then
                begin
                    Exit(True);
                end;
            end;
        end;

    begin
        if (Length(m_candidates) = 0) or (expected_units < 5) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        best_rank_local := Low(Integer);
        best_replacement_text_local := '';
        best_replacement_candidate_local := Default(TncCandidate);

        for idx := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_units_local := split_text_units(Trim(m_candidates[idx].text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Continue;
            end;

            for unit_idx := 1 to High(candidate_units_local) - 1 do
            begin
                if (normalize_pinyin_text(syllables[unit_idx].text) = 'de') and
                    SameText(candidate_units_local[unit_idx], string(Char($7684))) and
                    is_display_de_adverbial_left_unit_local(
                    candidate_units_local[unit_idx - 1]) and
                    is_display_de_adverbial_predicate_head_unit_local(
                    candidate_units_local[unit_idx + 1]) and
                    ((not right_context_has_long_exact_phrase_local(unit_idx + 1)) or
                    is_display_de_strong_adverbial_predicate_head_unit_local(
                    candidate_units_local[unit_idx + 1])) then
                begin
                    replacement_text_local := build_replaced_text_local(
                        candidate_units_local, unit_idx, string(Char($5730)));
                    candidate_rank_local := m_candidates[idx].score;
                    if (idx < Length(m_candidate_segment_paths)) and
                        (Trim(m_candidate_segment_paths[idx]) <> '') then
                    begin
                        Inc(candidate_rank_local, 80000);
                    end;
                    Dec(candidate_rank_local, idx * 256);
                    if candidate_rank_local > best_rank_local then
                    begin
                        best_rank_local := candidate_rank_local;
                        best_replacement_text_local := replacement_text_local;
                        best_replacement_candidate_local := m_candidates[idx];
                        best_replacement_candidate_local.text :=
                            replacement_text_local;
                        best_replacement_candidate_local.comment := '';
                        Inc(best_replacement_candidate_local.score, 42000);
                        best_replacement_candidate_local.has_dict_weight := False;
                        best_replacement_candidate_local.dict_weight := 0;
                    end;
                end;
            end;
        end;

        if best_replacement_text_local = '' then
        begin
            Exit;
        end;

        existing_idx_local := find_display_candidate(best_replacement_text_local,
            '');
        if existing_idx_local < 0 then
        begin
            replacement_candidate_local := best_replacement_candidate_local;
            insert_display_candidate(replacement_candidate_local,
                best_replacement_text_local, 0);
            existing_idx_local := find_display_candidate(best_replacement_text_local,
                '');
        end;
        if existing_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(existing_idx_local, 0);
        end;
    end;

    procedure promote_display_nominal_de_particle_candidate;
    const
