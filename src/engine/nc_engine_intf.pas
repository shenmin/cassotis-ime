            end;
        end;

        function build_units_range_text_local(const units_value: TArray<string>;
            const range_start: Integer; const range_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (range_start < 0) or (range_len <= 0) or
                (range_start + range_len > Length(units_value)) then
            begin
                Exit;
            end;

            for local_idx := range_start to range_start + range_len - 1 do
            begin
                Result := Result + units_value[local_idx];
            end;
        end;

        function range_is_occupied_local(const range_start: Integer;
            const range_len: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := True;
            if (range_start < 0) or (range_len <= 0) or
                (range_start + range_len > Length(occupied_local)) then
            begin
                Exit;
            end;

            for local_idx := range_start to range_start + range_len - 1 do
            begin
                if occupied_local[local_idx] then
                begin
                    Exit;
                end;
            end;
            Result := False;
        end;

        function range_crosses_final_fixed_tail_local(const range_start: Integer;
            const range_len: Integer): Boolean;
        var
            fixed_tail_text_local: string;
        begin
            Result := False;
            if (Length(syllables) <> expected_units) or
                (range_start < 0) or (range_len <= 0) or
                (range_start + range_len <> expected_units) or
                (expected_units <= 0) then
            begin
                Exit;
            end;

            fixed_tail_text_local := get_display_fixed_tail_text_outer(
                syllables[expected_units - 1].text);
            Result := (fixed_tail_text_local <> '') and
                SameText(Trim(repaired_units_local[expected_units - 1]),
                fixed_tail_text_local);
        end;

        procedure mark_range_occupied_local(const range_start: Integer;
            const range_len: Integer);
        var
            local_idx: Integer;
        begin
            if (range_start < 0) or (range_len <= 0) or
                (range_start + range_len > Length(occupied_local)) then
            begin
                Exit;
            end;

            for local_idx := range_start to range_start + range_len - 1 do
            begin
                occupied_local[local_idx] := True;
            end;
        end;

        procedure protect_existing_path_exact_spans_local;
        const
            c_min_protected_two_char_weight = 20000;
            c_min_protected_multi_char_weight = 420;
        var
            path_idx_local: Integer;
            segment_start_local: Integer;
            segment_units_local: Integer;
            segment_weight_local: Integer;
            segment_key_local: string;
            segment_text_local: string;
        begin
            top_path_local := get_display_candidate_path_for_index(
                m_candidates[0], 0);
            if (top_path_local = '') or
                (Pos(c_segment_path_separator, top_path_local) <= 0) then
            begin
                Exit;
            end;

            path_parts_local := top_path_local.Split([c_segment_path_separator]);
            segment_start_local := 0;
            for path_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[path_idx_local]);
                segment_units_local := get_candidate_text_unit_count(
                    segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) or
                    (segment_start_local + segment_units_local > expected_units) then
                begin
                    Exit;
                end;

                if segment_units_local >= 2 then
                begin
                    segment_key_local := build_display_query_key(
                        segment_start_local, segment_units_local);
                    segment_weight_local := 0;
                    if (segment_key_local <> '') and
                        get_display_exact_text_weight(segment_key_local,
                        segment_text_local, segment_units_local,
                        segment_weight_local) then
                    begin
                        if ((segment_units_local = 2) and
                            (segment_weight_local >=
                            c_min_protected_two_char_weight)) or
                            ((segment_units_local > 2) and
                            (segment_weight_local >=
                            c_min_protected_multi_char_weight)) then
                        begin
                            mark_range_occupied_local(segment_start_local,
                                segment_units_local);
                        end;
                    end;
                end;

                Inc(segment_start_local, segment_units_local);
            end;
        end;

        function min_replacement_weight_local(const span_len_value: Integer):
            Integer;
        begin
            if span_len_value <= 2 then
            begin
                Exit(c_two_char_min_weight);
            end;
            if span_len_value = 3 then
            begin
                Exit(c_three_char_min_weight);
            end;
            Result := c_longer_char_min_weight;
        end;

        function current_exact_delta_margin_local(const span_len_value: Integer):
            Integer;
        begin
            if span_len_value <= 2 then
            begin
                Exit(360);
            end;
            if span_len_value = 3 then
            begin
                Exit(220);
            end;
            Result := 120;
        end;

        function candidate_effective_exact_weight_local(
            const candidate_value: TncCandidate): Integer;
        begin
            if candidate_value.has_dict_weight then
            begin
                Result := candidate_value.dict_weight;
            end
            else
            begin
                Result := candidate_value.score;
            end;
            if candidate_value.source = cs_user then
            begin
                Inc(Result, 2400);
            end;
        end;

        function try_pick_exact_replacement_local(const range_start: Integer;
            const range_len: Integer; const current_text_value: string;
            out out_text: string; out out_weight: Integer;
            out out_current_weight: Integer): Boolean;
        var
            query_key_local: string;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            candidate_text_local: string;
            candidate_units_local: TArray<string>;
            candidate_weight_local: Integer;
            best_rank_local: Integer;
            candidate_rank_local: Integer;
        begin
            Result := False;
            out_text := '';
            out_weight := 0;
            out_current_weight := 0;

            query_key_local := build_display_query_key(range_start, range_len);
            if (query_key_local = '') or
                (not lookup_display_exact_cached(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            get_display_exact_text_weight(query_key_local, current_text_value,
                range_len, out_current_weight);
            best_rank_local := Low(Integer);
            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if exact_idx_local >= c_exact_probe_limit then
                begin
                    Break;
                end;

                candidate_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (candidate_text_local = '') or
                    (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    SameText(candidate_text_local, current_text_value) then
                begin
                    Continue;
                end;

                candidate_units_local := split_text_units(candidate_text_local);
                if Length(candidate_units_local) <> range_len then
                begin
                    Continue;
                end;

                candidate_weight_local := candidate_effective_exact_weight_local(
                    exact_results_local[exact_idx_local]);
                if candidate_weight_local < min_replacement_weight_local(range_len) then
                begin
                    Continue;
                end;

                if (out_current_weight > 0) and
                    (candidate_weight_local < out_current_weight +
                    current_exact_delta_margin_local(range_len)) then
                begin
                    Continue;
                end;

                candidate_rank_local := candidate_weight_local +
                    range_len * range_len * 200;
                if candidate_rank_local > best_rank_local then
                begin
                    best_rank_local := candidate_rank_local;
                    out_text := candidate_text_local;
                    out_weight := candidate_weight_local;
                    Result := True;
                end;
            end;
        end;

    begin
        if short_exact_query_mode or (m_dictionary = nil) or
            (Length(m_candidates) = 0) or (expected_units < 6) or
            (expected_units > 40) or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;

        SetLength(repaired_units_local, Length(top_units_local));
        for unit_idx_local := 0 to High(top_units_local) do
        begin
            repaired_units_local[unit_idx_local] := top_units_local[unit_idx_local];
        end;
        SetLength(occupied_local, expected_units);
        protect_existing_path_exact_spans_local;

        total_gain_local := 0;
        replaced_units_local := 0;
        replacement_count_local := 0;
        strongest_span_local := 0;
        for span_len_local := Min(c_max_span_len, expected_units) downto
            c_min_span_len do
        begin
            for start_idx_local := 0 to expected_units - span_len_local do
            begin
                if range_is_occupied_local(start_idx_local, span_len_local) then
                begin
                    Continue;
                end;
                if range_crosses_final_fixed_tail_local(start_idx_local,
                    span_len_local) then
                begin
                    Continue;
                end;
                current_text_local := build_units_range_text_local(
                    repaired_units_local, start_idx_local, span_len_local);
                if (current_text_local = '') or
                    (not try_pick_exact_replacement_local(start_idx_local,
                    span_len_local, current_text_local, replacement_text_local,
                    replacement_weight_local, current_weight_local)) then
                begin
                    Continue;
                end;

                replacement_units_local := split_text_units(replacement_text_local);
                if Length(replacement_units_local) <> span_len_local then
                begin
                    Continue;
                end;

                for unit_idx_local := 0 to span_len_local - 1 do
                begin
                    repaired_units_local[start_idx_local + unit_idx_local] :=
                        replacement_units_local[unit_idx_local];
                end;
                mark_range_occupied_local(start_idx_local, span_len_local);

                repair_gain_local := span_len_local * span_len_local * 3000 +
                    Min(12000, replacement_weight_local * span_len_local);
                if current_weight_local > 0 then
                begin
                    Inc(repair_gain_local,
                        Min(8000, (replacement_weight_local -
                        current_weight_local) * 2));
                end;
                Inc(total_gain_local, repair_gain_local);
                Inc(replaced_units_local, span_len_local);
                Inc(replacement_count_local);
                if span_len_local > strongest_span_local then
                begin
                    strongest_span_local := span_len_local;
                end;
            end;
        end;

        if replacement_count_local = 0 then
        begin
            Exit;
        end;
        if (replacement_count_local = 1) and (strongest_span_local = 2) and
            (total_gain_local < c_min_single_repair_gain) then
        begin
            Exit;
        end;

        repaired_text_local := build_units_text_local(repaired_units_local);
        if (repaired_text_local = '') or
            SameText(repaired_text_local, Trim(m_candidates[0].text)) then
        begin
            Exit;
        end;

        target_idx_local := 1;
        if (strongest_span_local > 2) and
            ((replacement_count_local >= 2) or (strongest_span_local >= 4) or
            ((strongest_span_local >= 3) and (total_gain_local >= 24000)) or
            (total_gain_local >= 36000)) then
        begin
            target_idx_local := 0;
        end;
        existing_idx_local := find_display_candidate(repaired_text_local, '');
        if existing_idx_local >= 0 then
        begin
            if existing_idx_local <> target_idx_local then
            begin
                force_move_display_candidate_to_index(existing_idx_local,
                    target_idx_local);
            end;
            Exit;
        end;

        repaired_candidate_local := m_candidates[0];
        repaired_candidate_local.text := repaired_text_local;
        repaired_candidate_local.comment := '';
        repaired_candidate_local.source := cs_rule;
        repaired_candidate_local.has_dict_weight := False;
        repaired_candidate_local.dict_weight := 0;
        if strongest_span_local = 2 then
        begin
            repaired_candidate_local.score := m_candidates[0].score - 1;
        end
        else
        begin
            repaired_candidate_local.score := m_candidates[0].score +
                Min(90000, total_gain_local);
        end;
        insert_display_candidate(repaired_candidate_local, repaired_text_local,
            target_idx_local);

        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' spanrepair=[target=%d reps=%d units=%d gain=%d text=%s]',
                [target_idx_local, replacement_count_local,
                replaced_units_local, total_gain_local, repaired_text_local]);
        end;
    end;

    procedure promote_display_pathful_candidate_over_weak_user_top;
    const
        c_probe_limit = 10;
    var
        idx: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
        candidate_path_local: string;
        top_text_local: string;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Trim(m_candidates[0].comment) <> '') or
            (m_candidates[0].source <> cs_user) then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        if (top_text_local = '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) or
            is_latest_session_query_choice(top_text_local) or
            display_candidate_is_persistent_latest_choice(normalized_pinyin,
            top_text_local) or
            (get_context_query_latest_bonus(top_text_local) > 0) then
        begin
            Exit;
        end;
        if m_candidates[0].has_dict_weight and
            (m_candidates[0].dict_weight > 32) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_path_local := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            if get_encoded_path_segment_count_local(candidate_path_local) <= 1 then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]) + Max(0,
                get_segment_path_support_score(m_candidates[idx]));
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure promote_display_supported_head_partial_candidate;
    const
        c_probe_limit = 8;
    var
        idx: Integer;
        best_idx: Integer;
        probe_limit: Integer;
        top_path_local: string;
        candidate_text_local: string;
        candidate_comment_local: string;
        candidate_text_units_local: Integer;
        candidate_comment_units_local: Integer;
        head_key_local: string;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units <> 3) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        if (Trim(m_candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) =
            expected_units) and
            display_exact_key_has_text(normalized_pinyin,
            Trim(m_candidates[0].text)) then
        begin
            Exit;
        end;

        top_path_local := get_display_candidate_path_for_index(
            m_candidates[0], 0);
        if display_path_has_one_plus_two_function_head(top_path_local) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank_local := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_comment_local := Trim(m_candidates[idx].comment);
            if (candidate_text_local = '') or (candidate_comment_local = '') then
            begin
                Continue;
            end;

            candidate_text_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            candidate_comment_units_local :=
                get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(candidate_comment_local));
            if (candidate_text_units_local < 2) or
                (candidate_text_units_local + candidate_comment_units_local <>
                expected_units) then
            begin
                Continue;
            end;

            head_key_local := build_display_query_key(0,
                candidate_text_units_local);
            if (head_key_local = '') or
                (not display_exact_key_has_text(head_key_local,
                candidate_text_local)) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]) + candidate_text_units_local * 2048;
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx := idx;
            end;
        end;

        if best_idx > 0 then
        begin
            move_display_candidate_to_index(best_idx, 0);
        end;
    end;

    procedure filter_display_invalid_partial_tail_alignment;
    var
        idx: Integer;
        out_idx: Integer;
        removed_count: Integer;
        candidate_text_local: string;
        candidate_comment_local: string;
        candidate_text_units_local: Integer;
        candidate_comment_units_local: Integer;
        head_key_local: string;
        tail_key_local: string;

        function text_matches_head_key_local(const head_key_value: string;
            const text_value: string; const text_units_value: Integer): Boolean;
        begin
            Result := False;
            if (head_key_value = '') or (text_value = '') then
            begin
                Exit;
            end;

            if display_exact_key_has_text(head_key_value, text_value) then
            begin
                Exit(True);
            end;

            Result := (text_units_value = 1) and (m_dictionary <> nil) and
                m_dictionary.single_char_matches_pinyin(head_key_value,
                text_value);
        end;
    begin
        if (Length(m_candidates) = 0) or (expected_units < 2) or
            (normalized_pinyin = '') or (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            Exit;
        end;

        out_idx := 0;
        removed_count := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_comment_local := normalize_pinyin_text(
                Trim(m_candidates[idx].comment));
            if candidate_comment_local <> '' then
            begin
                candidate_text_local := Trim(m_candidates[idx].text);
                candidate_text_units_local := get_candidate_text_unit_count(
                    candidate_text_local);
                candidate_comment_units_local :=
                    get_effective_compact_pinyin_unit_count(
                    candidate_comment_local);
                if (candidate_text_units_local > 0) and
                    (candidate_comment_units_local > 0) and
                    (candidate_text_units_local + candidate_comment_units_local =
                    expected_units) then
                begin
                    head_key_local := build_display_query_key(0,
                        candidate_text_units_local);
                    tail_key_local := build_display_query_key(
                        candidate_text_units_local,
                        candidate_comment_units_local);
                    if text_matches_head_key_local(head_key_local,
                        candidate_text_local, candidate_text_units_local) and
                        (tail_key_local <> '') and
                        (not SameText(candidate_comment_local,
                        tail_key_local)) and
                        (alternative_exact_prefix_units(m_candidates[idx]) = 0) then
                    begin
                        Inc(removed_count);
                        Continue;
                    end;
                end;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if removed_count > 0 then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
    end;

    procedure filter_display_nonbase_complete_when_base_exact_exists;
    const
        c_min_filtering_base_exact_weight = 500;
    var
        idx: Integer;
        out_idx: Integer;
        has_base_complete_local: Boolean;
        candidate_text_local: string;
        candidate_is_complete_local: Boolean;
        exact_weight_local: Integer;

        function candidate_has_non_function_one_plus_two_path_local(
            const candidate_idx: Integer): Boolean;
        var
            path_local: string;
            path_parts_local: TArray<string>;
            head_text_local: string;
        begin
            Result := False;
            path_local := get_display_candidate_path_for_index(
                m_candidates[candidate_idx], candidate_idx);
            if path_local = '' then
            begin
                Exit;
            end;

            path_parts_local := path_local.Split([c_segment_path_separator]);
            if Length(path_parts_local) <> 2 then
            begin
                Exit;
            end;

            head_text_local := Trim(path_parts_local[0]);
            Result := (get_candidate_text_unit_count(head_text_local) = 1) and
                (get_candidate_text_unit_count(Trim(path_parts_local[1])) = 2) and
                (not is_display_function_or_modifier_single(head_text_local));
        end;

        function candidate_has_non_function_one_plus_two_text_local(
            const candidate_text_value: string): Boolean;
        var
            units_local: TArray<string>;
            tail_key_local: string;
            tail_text_local: string;
            tail_results_local: TncCandidateList;
            tail_idx_local: Integer;
            tail_candidate_text_local: string;
        begin
            Result := False;
            if expected_units <> 3 then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(candidate_text_value));
            if (Length(units_local) <> 3) or
                is_display_function_or_modifier_single(Trim(units_local[0])) then
            begin
                Exit;
            end;

            tail_key_local := build_display_query_key(1, 2);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            if (tail_key_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;

            if m_dictionary.is_base_entry(tail_key_local, tail_text_local) then
            begin
                Exit(True);
            end;

            if not lookup_display_exact_cached(tail_key_local,
                tail_results_local) then
            begin
                Exit;
            end;

            for tail_idx_local := 0 to High(tail_results_local) do
            begin
                tail_candidate_text_local := Trim(
                    tail_results_local[tail_idx_local].text);
                if (Trim(tail_results_local[tail_idx_local].comment) = '') and
                    SameText(tail_candidate_text_local, tail_text_local) and
                    (tail_results_local[tail_idx_local].source = cs_rule) and
                    tail_results_local[tail_idx_local].has_dict_weight and
                    (tail_results_local[tail_idx_local].dict_weight >= 300) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function candidate_has_multi_segment_path_local(
            const candidate_idx: Integer): Boolean;
        begin
            Result := get_encoded_path_segment_count_local(
                get_display_candidate_path_for_index(
                m_candidates[candidate_idx], candidate_idx)) > 1;
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 2) or
            (expected_units > 5) or (normalized_pinyin = '') then
        begin
            Exit;
        end;

        has_base_complete_local := False;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                display_candidate_has_base_full_entry(normalized_pinyin,
                m_candidates[idx]) and
                get_display_exact_text_weight(normalized_pinyin,
                candidate_text_local, expected_units, exact_weight_local) and
                (exact_weight_local >= c_min_filtering_base_exact_weight) then
            begin
                has_base_complete_local := True;
                Break;
            end;
        end;
        if not has_base_complete_local then
        begin
            Exit;
        end;

        out_idx := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_is_complete_local := (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units);
            if candidate_is_complete_local and
                (not display_candidate_has_base_full_entry(normalized_pinyin,
                m_candidates[idx])) and
                (not display_candidate_is_exact_full_dictionary_entry(
                normalized_pinyin, m_candidates[idx])) and
                ((not display_candidate_is_persistent_latest_choice(
                normalized_pinyin, candidate_text_local)) or
                candidate_has_non_function_one_plus_two_text_local(
                candidate_text_local) or
                candidate_has_multi_segment_path_local(idx)) and
                (not ((m_confirmed_text <> '') and
                (m_candidates[idx].source = cs_user))) then
            begin
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
    end;

    procedure filter_display_short_one_plus_two_self_composed_complete_candidates;
    var
        idx: Integer;
        out_idx: Integer;
        removed_count: Integer;
        candidate_text_local: string;
        candidate_units_local: TArray<string>;
        path_local: string;

        function candidate_has_one_plus_two_path_local(
            const path_value: string): Boolean;
        var
            path_parts_local: TArray<string>;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(path_value) <> 2 then
            begin
                Exit;
            end;

            path_parts_local := path_value.Split([c_segment_path_separator]);
            if Length(path_parts_local) <> 2 then
            begin
                Exit;
            end;

            Result :=
                (get_candidate_text_unit_count(Trim(path_parts_local[0])) = 1) and
                (get_candidate_text_unit_count(Trim(path_parts_local[1])) = 2);
        end;

        function complete_candidate_path_matches_text_local(
            const candidate_text_value: string; const path_value: string): Boolean;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            joined_text_local: string;
            segment_text_local: string;
        begin
            Result := True;
            if (Trim(path_value) = '') or
                (get_encoded_path_segment_count_local(path_value) <= 1) then
            begin
                Exit;
            end;

            path_parts_local := path_value.Split([c_segment_path_separator]);
            joined_text_local := '';
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                if segment_text_local = '' then
                begin
                    Exit(False);
                end;
                joined_text_local := joined_text_local + segment_text_local;
            end;

            Result := SameText(joined_text_local, Trim(candidate_text_value));
        end;

        function candidate_has_one_plus_two_tail_text_support_local(
            const candidate_text_value: string): Boolean;
        var
            tail_key_local: string;
            tail_text_local: string;
        begin
            Result := False;
            candidate_units_local := split_text_units(
                Trim(candidate_text_value));
            if Length(candidate_units_local) <> expected_units then
            begin
                Exit;
            end;

            tail_key_local := build_display_query_key(1, 2);
            tail_text_local := Trim(candidate_units_local[1]) +
                Trim(candidate_units_local[2]);
            if (tail_key_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;

            Result := display_exact_key_has_text(tail_key_local,
                tail_text_local);
        end;

        function candidate_has_function_head_one_plus_two_support_local(
            const candidate_text_value: string): Boolean;
        var
            units_local: TArray<string>;
            head_text_local: string;
            tail_key_local: string;
            tail_text_local: string;
            tail_weight_local: Integer;
        begin
            Result := False;
            units_local := split_text_units(Trim(candidate_text_value));
            if Length(units_local) <> expected_units then
            begin
                Exit;
            end;

            head_text_local := Trim(units_local[0]);
            if not is_display_one_plus_two_supported_head_single(
                head_text_local) then
            begin
                Exit;
            end;

            tail_key_local := build_display_query_key(1, 2);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            if (tail_key_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;

            if is_display_one_plus_two_direct_complete_head_single(
                head_text_local) then
            begin
                Result := get_display_exact_text_weight(tail_key_local,
                    tail_text_local, 2, tail_weight_local) and
                    (tail_weight_local >= 500);
            end
            else
            begin
                Result := display_exact_key_has_text(tail_key_local,
                    tail_text_local);
            end;
        end;

        function candidate_has_direct_complete_one_plus_two_support_local(
            const candidate_text_value: string): Boolean;
        var
            units_local: TArray<string>;
            head_text_local: string;
            tail_key_local: string;
            tail_text_local: string;
            tail_weight_local: Integer;
        begin
            Result := False;
            if is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, candidate_text_value) then
            begin
                Exit(True);
            end;
            units_local := split_text_units(Trim(candidate_text_value));
            if Length(units_local) <> expected_units then
            begin
                Exit;
            end;

            head_text_local := Trim(units_local[0]);
            if not is_display_one_plus_two_direct_complete_head_single(
                head_text_local) then
            begin
                Exit;
            end;

            tail_key_local := build_display_query_key(1, 2);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            if (tail_key_local = '') or (tail_text_local = '') then
            begin
                Exit;
            end;

            Result := get_display_exact_text_weight(tail_key_local,
                tail_text_local, 2, tail_weight_local) and
                (tail_weight_local >= 500);
        end;

        function candidate_has_allowed_two_plus_one_tail_local(
            const path_value: string): Boolean;
        var
            path_parts_local: TArray<string>;
            tail_text_local: string;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(path_value) <> 2 then
            begin
                Exit;
            end;

            path_parts_local := path_value.Split([c_segment_path_separator]);
            if Length(path_parts_local) <> 2 then
            begin
                Exit;
            end;

            tail_text_local := Trim(path_parts_local[1]);
            Result := (get_candidate_text_unit_count(tail_text_local) = 1) and
                is_display_function_or_modifier_single(tail_text_local);
        end;

        function candidate_has_strict_full_entry_local(
            const candidate_value: TncCandidate;
            const candidate_text_value: string): Boolean;
        begin
            Result := (m_dictionary <> nil) and
                (normalized_pinyin <> '') and
                (candidate_text_value <> '') and
                (m_dictionary.is_base_entry(normalized_pinyin,
                candidate_text_value) or
                ((candidate_value.source = cs_user) and
                m_dictionary.is_user_entry(normalized_pinyin,
                candidate_text_value)));
        end;

        function try_get_two_unit_head_weight_local(const candidate_text_value: string;
            out out_weight: Integer): Boolean;
        var
            units_local: TArray<string>;
            head_key_local: string;
            head_text_local: string;
        begin
            Result := False;
            out_weight := 0;
            units_local := split_text_units(Trim(candidate_text_value));
            if Length(units_local) <> 3 then
            begin
                Exit;
            end;

            head_key_local := build_display_query_key(0, 2);
            head_text_local := Trim(units_local[0]) + Trim(units_local[1]);
            if (head_key_local = '') or (head_text_local = '') then
            begin
                Exit;
            end;

            Result := get_display_exact_text_weight(head_key_local,
                head_text_local, 2, out_weight);
        end;

        function candidate_has_stronger_same_tail_head_local(
            const candidate_index_value: Integer;
            const candidate_text_value: string): Boolean;
        const
            c_stronger_head_weight_margin = 240;
        var
            candidate_units_local: TArray<string>;
            candidate_head_local: string;
            candidate_tail_local: string;
            head_key_local: string;
            candidate_head_weight_local: Integer;
            other_idx_local: Integer;
            other_text_local: string;
            other_units_local: TArray<string>;
            other_head_weight_local: Integer;

            function head_key_has_stronger_exact_local(
                const local_head_key: string;
                const local_head_text: string;
                const local_head_weight: Integer): Boolean;
            const
                c_probe_limit = 16;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
                exact_weight_local: Integer;
            begin
                Result := False;
                if (local_head_key = '') or (local_head_text = '') or
                    (not lookup_display_exact_cached(local_head_key,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                        (exact_text_local = '') or
                        SameText(exact_text_local, local_head_text) or
                        (get_candidate_text_unit_count(exact_text_local) <> 2) then
                    begin
                        Continue;
                    end;

                    if exact_results_local[exact_idx_local].has_dict_weight then
                    begin
                        exact_weight_local :=
                            exact_results_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        exact_weight_local := exact_results_local[exact_idx_local].score;
                    end;

                    if exact_weight_local >= local_head_weight +
                        c_stronger_head_weight_margin then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            candidate_units_local := split_text_units(Trim(candidate_text_value));
            if Length(candidate_units_local) <> 3 then
            begin
                Exit;
            end;

            candidate_head_local := Trim(candidate_units_local[0]) +
                Trim(candidate_units_local[1]);
            candidate_tail_local := Trim(candidate_units_local[2]);
            if (candidate_head_local = '') or (candidate_tail_local = '') then
            begin
                Exit;
            end;
            if not try_get_two_unit_head_weight_local(candidate_text_value,
                candidate_head_weight_local) then
            begin
                candidate_head_weight_local := 0;
            end;

            head_key_local := build_display_query_key(0, 2);
            if is_display_function_or_modifier_single(candidate_tail_local) and
                head_key_has_stronger_exact_local(head_key_local,
                candidate_head_local, candidate_head_weight_local) then
            begin
                Exit(True);
            end;

            for other_idx_local := 0 to High(m_candidates) do
            begin
                if other_idx_local = candidate_index_value then
                begin
                    Continue;
                end;

                other_text_local := Trim(m_candidates[other_idx_local].text);
                if (other_text_local = '') or
                    SameText(other_text_local, candidate_text_value) or
                    (Trim(m_candidates[other_idx_local].comment) <> '') or
                    (display_candidate_has_supported_full_entry(normalized_pinyin,
                    m_candidates[other_idx_local])) or
                    (display_candidate_is_exact_full_dictionary_entry(
                    normalized_pinyin, m_candidates[other_idx_local])) or
                    display_candidate_is_persistent_latest_choice(
                    normalized_pinyin, other_text_local) or
                    ((m_candidates[other_idx_local].source = cs_user) and
                    m_dictionary.is_user_entry(normalized_pinyin,
                    other_text_local)) then
                begin
                    Continue;
                end;

                other_units_local := split_text_units(other_text_local);
                if (Length(other_units_local) <> 3) or
                    (not SameText(Trim(other_units_local[2]),
                    candidate_tail_local)) or
                    (not try_get_two_unit_head_weight_local(other_text_local,
                    other_head_weight_local)) then
                begin
                    Continue;
                end;

                if other_head_weight_local >= candidate_head_weight_local +
                    c_stronger_head_weight_margin then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units <> 3) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        out_idx := 0;
        removed_count := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                (not (is_fuzzy_pinyin_active and
                (m_candidates[idx].fuzzy_cost > 0) and
                ((m_candidates[idx].source = cs_user) or
                ((m_candidates[idx].source = cs_rule) and
                m_candidates[idx].has_dict_weight)))) and
                (not display_candidate_is_persistent_latest_choice(
                normalized_pinyin, candidate_text_local)) and
                (not ((m_confirmed_text <> '') and
                (m_candidates[idx].source = cs_user))) then
            begin
                path_local := get_display_candidate_path_for_index(
                    m_candidates[idx], idx);
                if not complete_candidate_path_matches_text_local(
                    candidate_text_local, path_local) then
                begin
                    Inc(removed_count);
                    Continue;
                end;
                if (not candidate_has_strict_full_entry_local(m_candidates[idx],
                    candidate_text_local)) and
                    candidate_has_one_plus_two_path_local(path_local) and
                    (not candidate_has_direct_complete_one_plus_two_support_local(
                    candidate_text_local)) then
                begin
                    Inc(removed_count);
                    Continue;
                end;

                if not candidate_has_strict_full_entry_local(m_candidates[idx],
                    candidate_text_local) then
                begin
                    if not candidate_has_direct_complete_one_plus_two_support_local(
                        candidate_text_local) then
                    begin
                        if candidate_has_stronger_same_tail_head_local(idx,
                            candidate_text_local) then
                        begin
                            Inc(removed_count);
                            Continue;
                        end;

                        if display_path_has_two_plus_one_non_particle_tail(path_local) and
                            (not candidate_has_allowed_two_plus_one_tail_local(
                            path_local)) then
                        begin
                            Inc(removed_count);
                            Continue;
                        end;
                        if candidate_has_one_plus_two_tail_text_support_local(
                            candidate_text_local) then
                        begin
                            Inc(removed_count);
                            Continue;
                        end;
                    end;
                end;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;

        if m_config.debug_mode and (removed_count > 0) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' disp_selfdrop=[n=%d]', [removed_count]);
        end;
    end;

    procedure filter_display_complete_single_char_chain_noise_candidates;
    var
        idx: Integer;
        out_idx: Integer;
        removed_count: Integer;
        candidate_text_local: string;

        function complete_candidate_is_unsupported_single_char_chain_local(
            const candidate_value: TncCandidate; const candidate_index: Integer): Boolean;

            function candidate_is_number_quantity_phrase_local: Boolean;
            var
                number_text_local: string;
                quantity_text_local: string;
                units_local: TArray<string>;
            begin
                Result := False;
                if (expected_units <> 2) or (Length(syllables) <> expected_units) then
                begin
                    Exit;
                end;

                number_text_local := get_display_number_text_outer(
                    syllables[0].text);
                quantity_text_local := get_display_quantity_tail_text_outer(
                    syllables[1].text);
                if quantity_text_local = '' then
                begin
                    quantity_text_local :=
                        get_display_structured_quantity_tail_text_outer(
                        syllables[1].text);
                end;
                if (number_text_local = '') or (quantity_text_local = '') then
                begin
                    Exit;
                end;

                units_local := split_text_units(Trim(candidate_value.text));
                Result := (Length(units_local) = 2) and
                    SameText(Trim(units_local[0]), number_text_local) and
                    SameText(Trim(units_local[1]), quantity_text_local);
            end;

            function has_supported_complete_competitor_local: Boolean;
            const
                c_probe_limit = 16;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := False;
                if not lookup_display_exact_cached(normalized_pinyin,
                    exact_results_local) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;

                    exact_text_local := Trim(
                        exact_results_local[exact_idx_local].text);
                    if (exact_text_local = '') or
                        SameText(exact_text_local, Trim(candidate_value.text)) or
                        (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        expected_units) then
                    begin
                        Continue;
                    end;

                    if m_dictionary.is_base_entry(normalized_pinyin,
                        exact_text_local) or
                        ((exact_results_local[exact_idx_local].source = cs_rule) and
                        exact_results_local[exact_idx_local].has_dict_weight and
                        (exact_results_local[exact_idx_local].dict_weight >= 160)) or
                        ((exact_results_local[exact_idx_local].source = cs_user) and
                        m_dictionary.is_user_entry(normalized_pinyin,
                        exact_text_local)) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function candidate_is_complete_single_char_chain_local: Boolean;
            var
                chain_units_local: TArray<string>;
                chain_path_local: string;
                chain_path_parts_local: TArray<string>;
                chain_unit_idx_local: Integer;
                chain_syllable_key_local: string;
                chain_path_part_local: string;
            begin
                Result := False;
                chain_path_local := get_display_candidate_path_for_index(candidate_value,
                    candidate_index);
                if chain_path_local <> '' then
                begin
                    if get_encoded_path_segment_count_local(chain_path_local) <>
                        expected_units then
                    begin
                        Exit;
                    end;

                    chain_path_parts_local := chain_path_local.Split([c_segment_path_separator]);
                    if Length(chain_path_parts_local) <> expected_units then
                    begin
                        Exit;
                    end;

                    for chain_unit_idx_local := 0 to High(chain_path_parts_local) do
                    begin
                        chain_path_part_local := Trim(chain_path_parts_local[chain_unit_idx_local]);
                        chain_syllable_key_local := normalize_pinyin_text(
                            syllables[chain_unit_idx_local].text);
                        if (chain_path_part_local = '') or (chain_syllable_key_local = '') or
                            (get_candidate_text_unit_count(chain_path_part_local) <> 1) or
                            (not m_dictionary.single_char_matches_pinyin(
                            chain_syllable_key_local, chain_path_part_local)) then
                        begin
                            Exit(False);
                        end;
                    end;
                    Exit(True);
                end;

                chain_units_local := split_text_units(
                    Trim(candidate_value.text));
                if Length(chain_units_local) <> expected_units then
                begin
                    Exit;
                end;

                for chain_unit_idx_local := 0 to High(chain_units_local) do
                begin
                    chain_syllable_key_local := normalize_pinyin_text(
                        syllables[chain_unit_idx_local].text);
                    if (chain_syllable_key_local = '') or
                        (get_candidate_text_unit_count(
                        chain_units_local[chain_unit_idx_local]) <> 1) or
                        (not m_dictionary.single_char_matches_pinyin(
                        chain_syllable_key_local,
                        chain_units_local[chain_unit_idx_local])) then
                    begin
                        Exit(False);
                    end;
                end;

                Result := True;
            end;

            function is_low_weight_supported_competitor_chain_local: Boolean;
            begin
                Result := (expected_units >= 3) and
                    (candidate_value.source = cs_rule) and
                    candidate_value.has_dict_weight and
                    (candidate_value.dict_weight < 160) and
                    has_supported_complete_competitor_local and
                    candidate_is_complete_single_char_chain_local;
            end;
        begin
            Result := False;
            if (normalized_pinyin = '') or (expected_units < 2) or
                (expected_units > 5) or (m_dictionary = nil) or
                (Trim(candidate_value.comment) <> '') or
                (Trim(candidate_value.text) = '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <>
                expected_units) or
                is_runtime_common_pattern_candidate(candidate_value) or
                candidate_is_number_quantity_phrase_local or
                (get_display_fixed_quantity_alignment_score_outer(
                candidate_value) > 0) or
                ((not is_low_weight_supported_competitor_chain_local) and
                m_dictionary.is_base_entry(normalized_pinyin,
                Trim(candidate_value.text))) or
                ((candidate_value.source = cs_rule) and
                candidate_value.has_dict_weight and
                (candidate_value.dict_weight >= 160) and
                display_candidate_has_supported_full_entry(normalized_pinyin,
                candidate_value)) or
                display_candidate_is_persistent_latest_choice(normalized_pinyin,
                Trim(candidate_value.text)) or
                is_latest_session_query_choice(Trim(candidate_value.text)) or
                ((candidate_value.source = cs_user) and
                m_dictionary.is_user_entry(normalized_pinyin,
                Trim(candidate_value.text))) then
            begin
                Exit;
            end;

            if is_low_weight_supported_competitor_chain_local then
            begin
                Exit(True);
            end;

            Result := candidate_is_complete_single_char_chain_local;
        end;
    begin
        if (Length(m_candidates) <= 1) or (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        out_idx := 0;
        removed_count := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                complete_candidate_is_unsupported_single_char_chain_local(
                m_candidates[idx], idx) then
            begin
                Inc(removed_count);
                Continue;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;

        if m_config.debug_mode and (removed_count > 0) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' disp_schaindrop=[n=%d]', [removed_count]);
        end;
    end;

    procedure ensure_display_head_single_partials_for_keys(
        const head_key_value: string; const tail_key_value: string);
    var
        head_key_local: string;
        tail_key_local: string;
        head_results_local: TncCandidateList;
        result_idx_local: Integer;
        append_idx_local: Integer;
        head_text_local: string;
        head_candidate_local: TncCandidate;
        existing_keys_local: TDictionary<string, Boolean>;

        function visible_key_local(const text_value: string;
            const comment_value: string): string;
        begin
            Result := LowerCase(Trim(text_value)) + #1 +
                LowerCase(Trim(comment_value));
        end;

        function head_single_partial_total_limit_local: Integer;
        begin
            Result := c_candidate_total_limit_max;
        end;
    begin
        if (m_dictionary = nil) or (normalized_pinyin = '') then
        begin
            Exit;
        end;

        head_key_local := normalize_pinyin_text(head_key_value);
        tail_key_local := normalize_pinyin_text(tail_key_value);
        if (head_key_local = '') or (tail_key_local = '') or
            (not m_dictionary.lookup(head_key_local, head_results_local)) then
        begin
            Exit;
        end;

        existing_keys_local := TDictionary<string, Boolean>.Create;
        try
            for append_idx_local := 0 to High(m_candidates) do
            begin
                existing_keys_local.AddOrSetValue(visible_key_local(
                    m_candidates[append_idx_local].text,
                    m_candidates[append_idx_local].comment), True);
            end;

            for result_idx_local := 0 to High(head_results_local) do
            begin
                if Length(m_candidates) >=
                    head_single_partial_total_limit_local then
                begin
                    Break;
                end;

                head_text_local := Trim(head_results_local[result_idx_local].text);
                if (head_text_local = '') or
                    (Trim(head_results_local[result_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(head_text_local) <> 1) then
                begin
                    Continue;
                end;

                if existing_keys_local.ContainsKey(visible_key_local(
                    head_text_local, tail_key_local)) then
                begin
                    Continue;
                end;

                head_candidate_local := head_results_local[result_idx_local];
                head_candidate_local.text := head_text_local;
                head_candidate_local.comment := tail_key_local;
                append_idx_local := Length(m_candidates);
                SetLength(m_candidates, append_idx_local + 1);
                m_candidates[append_idx_local] := head_candidate_local;
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths, Length(m_candidates));
                end;
                m_candidate_segment_paths[append_idx_local] := '';
                existing_keys_local.AddOrSetValue(visible_key_local(
                    head_text_local, tail_key_local), True);
            end;
        finally
            existing_keys_local.Free;
        end;
    end;

    procedure ensure_display_short_exact_head_single_partials_complete;
    begin
        if expected_units < 2 then
        begin
            Exit;
        end;

        ensure_display_head_single_partials_for_keys(
            build_display_query_key(0, 1),
            build_display_query_key(1, expected_units - 1));
    end;

    procedure filter_display_cross_boundary_single_noise_candidates;
    var
        idx: Integer;
        out_idx: Integer;
        candidate_text_local: string;
        path_local: string;

        function path_has_single_crossing_exact_boundary_local(
            const path_value: string): Boolean;
        var
            parts_local: TArray<string>;
            part_idx_local: Integer;
            part_text_local: string;
            next_text_local: string;
            part_units_list_local: TArray<string>;
            next_units_local: TArray<string>;
            part_units_local: Integer;
            syllable_pos_local: Integer;
            bridge_key_local: string;
            bridge_text_local: string;
        begin
            Result := False;
            if get_encoded_path_segment_count_local(path_value) < 2 then
            begin
                Exit;
            end;

            parts_local := path_value.Split([c_segment_path_separator]);
            syllable_pos_local := 0;
            for part_idx_local := 0 to High(parts_local) do
            begin
                part_text_local := Trim(parts_local[part_idx_local]);
                part_units_local := get_candidate_text_unit_count(
                    part_text_local);
                if (part_text_local = '') or (part_units_local <= 0) or
                    (syllable_pos_local + part_units_local > expected_units) then
                begin
                    Exit(False);
                end;

                if (part_idx_local < High(parts_local)) and
                    (part_units_local >= 1) then
                begin
                    next_text_local := Trim(parts_local[part_idx_local + 1]);
                    part_units_list_local := split_text_units(part_text_local);
                    next_units_local := split_text_units(next_text_local);
                    if (Length(part_units_list_local) >= part_units_local) and
                        (Length(next_units_local) >= 1) and
                        (not is_display_function_or_modifier_single(
                        Trim(part_units_list_local[part_units_local - 1]))) then
                    begin
                        bridge_key_local := build_display_query_key(
                            syllable_pos_local + part_units_local - 1, 2);
                        bridge_text_local :=
                            Trim(part_units_list_local[part_units_local - 1]) +
                            Trim(next_units_local[0]);
                        if (bridge_key_local <> '') and
                            display_exact_key_has_any_complete_text(
                            bridge_key_local, 2) and
                            (not display_exact_key_has_text(bridge_key_local,
                            bridge_text_local)) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

                Inc(syllable_pos_local, part_units_local);
            end;
        end;

        function candidate_ends_with_expected_fixed_tail_local(
            const candidate_text_value: string): Boolean;
        var
            expected_tail_text_local: string;
            units_local: TArray<string>;
        begin
            Result := False;
            expected_tail_text_local := get_display_fixed_tail_text_outer(
                syllables[expected_units - 1].text);
            if expected_tail_text_local = '' then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(candidate_text_value));
            Result := (Length(units_local) = expected_units) and
                SameText(Trim(units_local[expected_units - 1]),
                expected_tail_text_local);
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 4) or
            (expected_units > 5) or (normalized_pinyin = '') then
        begin
            Exit;
        end;

        out_idx := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                (m_candidates[idx].source <> cs_user) and
                (not display_candidate_has_supported_full_entry(
                normalized_pinyin, m_candidates[idx])) and
                (not display_candidate_is_exact_full_dictionary_entry(
                normalized_pinyin, m_candidates[idx])) and
                (not display_candidate_is_persistent_latest_choice(
                normalized_pinyin, candidate_text_local)) and
                (not candidate_ends_with_expected_fixed_tail_local(
                candidate_text_local)) and
                (get_display_fixed_quantity_alignment_score_outer(
                m_candidates[idx]) <= 0) then
            begin
                path_local := get_display_candidate_path_for_index(
                    m_candidates[idx], idx);
                if path_has_single_crossing_exact_boundary_local(path_local) then
                begin
                    Continue;
                end;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;
    end;

    procedure promote_display_primary_path_complete_candidate;
    const
        c_probe_limit = 12;
    var
        idx: Integer;
        probe_limit: Integer;
        best_idx: Integer;
        best_rank: Integer;
        candidate_rank: Integer;
        top_text_local: string;
        top_path_local: string;
        candidate_text_local: string;
        candidate_path_local: string;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        if (top_text_local = '') or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) or
            ((m_candidates[0].source = cs_user) and
            (normalized_pinyin <> '') and
            (m_dictionary <> nil) and
            m_dictionary.is_user_entry(normalized_pinyin, top_text_local)) or
            is_latest_session_query_choice(top_text_local) or
            ((normalized_pinyin <> '') and
            display_candidate_is_persistent_latest_choice(normalized_pinyin,
            top_text_local)) then
        begin
            Exit;
        end;

        top_path_local := get_display_candidate_path_for_index(m_candidates[0], 0);
        if (get_encoded_path_segment_count_local(top_path_local) > 1) and
            (not display_path_has_nonprimary_multi_char_segment_outer(
            top_path_local)) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local = '') or
                (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_path_local := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            if (get_encoded_path_segment_count_local(candidate_path_local) <= 1) or
                display_path_has_nonprimary_multi_char_segment_outer(
                candidate_path_local) then
            begin
                Continue;
            end;

            candidate_rank := display_candidate_effective_weight(
                m_candidates[idx]) + Max(0,
                get_segment_path_support_score(m_candidates[idx]));
            if candidate_rank > best_rank then
            begin
                best_rank := candidate_rank;
                best_idx := idx;
            end;
        end;

        if best_idx > 0 then
        begin
            force_move_display_candidate_to_index(best_idx, 0);
        end;
    end;

    procedure promote_display_richer_pathful_dict_complete_candidate;
    const
        c_probe_limit = 12;
        c_min_expected_units = 6;
        c_min_multi_char_segments = 3;
        c_min_rank_gap_when_top_has_dict = 512;
    var
        idx: Integer;
        probe_limit: Integer;
        best_idx: Integer;
        best_rank: Integer;
        candidate_rank: Integer;
        top_rank: Integer;
        top_text_local: string;
        top_path_local: string;
        top_multi_segments: Integer;
        candidate_text_local: string;
        candidate_path_local: string;
        candidate_multi_segments: Integer;
        entry_idx_local: Integer;
        top_is_entry_path_local: Boolean;
        candidate_has_stored_path_local: Boolean;
    begin
        if (Length(m_candidates) <= 1) or
            (expected_units < c_min_expected_units) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        if (top_text_local = '') or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) or
            ((m_candidates[0].source = cs_user) and
            (normalized_pinyin <> '') and
            (m_dictionary <> nil) and
            m_dictionary.is_user_entry(normalized_pinyin, top_text_local)) or
            is_latest_session_query_choice(top_text_local) or
            ((normalized_pinyin <> '') and
            display_candidate_is_persistent_latest_choice(normalized_pinyin,
            top_text_local)) then
        begin
            Exit;
        end;

        top_is_entry_path_local := has_entry_pathful_complete_top and
            SameText(top_text_local, Trim(entry_top_candidate.text));
        top_path_local := get_display_candidate_path_for_index(m_candidates[0], 0);
        if top_is_entry_path_local and (entry_top_path <> '') then
        begin
            top_path_local := entry_top_path;
        end;
        top_multi_segments := display_path_multi_char_segment_count_outer(
            top_path_local);
        top_rank := display_candidate_effective_weight(m_candidates[0]) +
            Max(0, get_segment_path_support_score(m_candidates[0])) +
            top_multi_segments * 800;

        if has_entry_pathful_complete_top and
            (Trim(entry_top_candidate.text) <> '') and
            (not SameText(top_text_local, Trim(entry_top_candidate.text))) and
            (not display_candidate_has_supported_full_entry(normalized_pinyin,
            m_candidates[0])) then
        begin
            entry_idx_local := find_display_candidate(
                Trim(entry_top_candidate.text), Trim(entry_top_candidate.comment));
            if entry_idx_local > 0 then
            begin
                force_move_display_candidate_to_index(entry_idx_local, 0);
                Exit;
            end;
        end;
        best_idx := -1;
        best_rank := Low(Integer);
        probe_limit := Min(c_probe_limit - 1, High(m_candidates));
        for idx := 1 to probe_limit do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local = '') or
                (Trim(m_candidates[idx].comment) <> '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                expected_units) or
                (not m_candidates[idx].has_dict_weight) then
            begin
                Continue;
            end;

            candidate_path_local := get_display_candidate_path_for_index(
                m_candidates[idx], idx);
            candidate_has_stored_path_local := (idx < Length(
                m_candidate_segment_paths)) and
                (Trim(m_candidate_segment_paths[idx]) <> '');
            if top_is_entry_path_local and (not candidate_has_stored_path_local) then
            begin
                Continue;
            end;
            if get_encoded_path_segment_count_local(candidate_path_local) <= 1 then
            begin
                Continue;
            end;

            candidate_multi_segments :=
                display_path_multi_char_segment_count_outer(candidate_path_local);
            if (candidate_multi_segments < c_min_multi_char_segments) or
                (candidate_multi_segments <= top_multi_segments) then
            begin
                Continue;
            end;

            candidate_rank := display_candidate_effective_weight(
                m_candidates[idx]) + Max(0,
                get_segment_path_support_score(m_candidates[idx])) +
                candidate_multi_segments * 800;
            if candidate_rank > best_rank then
            begin
                best_rank := candidate_rank;
                best_idx := idx;
            end;
        end;

        if best_idx <= 0 then
        begin
            Exit;
        end;

        if (not m_candidates[0].has_dict_weight) or
            (best_rank >= top_rank + c_min_rank_gap_when_top_has_dict) then
        begin
            force_move_display_candidate_to_index(best_idx, 0);
        end;
    end;

    procedure trim_display_long_complete_candidates_to_top2;
    var
        idx: Integer;
        out_idx: Integer;
        complete_count: Integer;
        removed_count: Integer;
        candidate_text_local: string;
    begin
        if (Length(m_candidates) <= c_long_sentence_complete_candidate_display_limit) or
            (expected_units < c_long_sentence_full_path_min_syllables) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        out_idx := 0;
        complete_count := 0;
        removed_count := 0;
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local <> '') and
                (Trim(m_candidates[idx].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) then
            begin
                Inc(complete_count);
                if complete_count > c_long_sentence_complete_candidate_display_limit then
                begin
                    Inc(removed_count);
                    Continue;
                end;
            end;

            if out_idx <> idx then
            begin
                m_candidates[out_idx] := m_candidates[idx];
                if out_idx < Length(m_candidate_segment_paths) then
                begin
                    if idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx] :=
                            m_candidate_segment_paths[idx];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx] := '';
                    end;
                end;
            end;
            Inc(out_idx);
        end;

        if out_idx <> Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx);
            if Length(m_candidate_segment_paths) > out_idx then
            begin
                SetLength(m_candidate_segment_paths, out_idx);
            end;
        end;

        if m_config.debug_mode and (removed_count > 0) then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' disp_fulltrim=[n=%d]', [removed_count]);
        end;
    end;

    procedure promote_display_exact_over_unstable_complete_top_candidate;
    const
        c_probe_limit = 12;
        c_min_strong_base_exact_weight = 5000;
    var
        top_text_local: string;
        top_path_local: string;
        exact_idx_local: Integer;
        exact_text_local: string;

        function try_find_strong_base_exact_candidate_local(
            out out_idx: Integer): Boolean;
        var
            local_idx: Integer;
            local_text: string;
            local_weight: Integer;
            best_weight: Integer;
        begin
            Result := False;
            out_idx := -1;
            best_weight := Low(Integer);
            for local_idx := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
            begin
                local_text := Trim(m_candidates[local_idx].text);
                if (local_text = '') or
                    (Trim(m_candidates[local_idx].comment) <> '') or
                    (get_candidate_text_unit_count(local_text) <>
                    expected_units) or
                    (not display_candidate_has_base_full_entry(
                    normalized_pinyin, m_candidates[local_idx])) or
                    (not get_display_exact_text_weight(normalized_pinyin,
                    local_text, expected_units, local_weight)) or
                    (local_weight < c_min_strong_base_exact_weight) then
                begin
                    Continue;
                end;

                if (out_idx < 0) or (local_weight > best_weight) then
                begin
                    out_idx := local_idx;
                    best_weight := local_weight;
                    Result := True;
                end;
            end;
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 2) or
            (normalized_pinyin = '') then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        if (top_text_local = '') or (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) then
        begin
            Exit;
        end;
        if display_candidate_has_base_full_entry(normalized_pinyin,
            m_candidates[0]) then
        begin
            Exit;
        end;

        if (m_candidates[0].source = cs_user) and
            (not is_latest_session_query_choice(top_text_local)) and
            (get_context_query_latest_bonus(top_text_local) <= 0) and
            try_find_strong_base_exact_candidate_local(exact_idx_local) and
            (exact_idx_local > 0) then
        begin
            force_move_display_candidate_to_index(exact_idx_local, 0);
            Exit;
        end;

        if display_candidate_has_supported_full_entry(normalized_pinyin,
            m_candidates[0]) then
        begin
            Exit;
        end;

        top_path_local := get_display_candidate_path_for_index(
            m_candidates[0], 0);
        if (not display_path_has_nonprimary_multi_char_segment_outer(
            top_path_local)) and
            (not is_problematic_single_char_chain_candidate_for_query(
            normalized_pinyin, m_candidates[0])) and
            display_exact_key_has_text(normalized_pinyin, top_text_local) then
        begin
            Exit;
        end;

        for exact_idx_local := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            exact_text_local := Trim(m_candidates[exact_idx_local].text);
            if (exact_text_local = '') or
                (Trim(m_candidates[exact_idx_local].comment) <> '') or
                (get_candidate_text_unit_count(exact_text_local) <>
                expected_units) or
                (not display_exact_key_has_text(normalized_pinyin,
                exact_text_local)) or
                (not display_candidate_has_supported_full_entry(
                normalized_pinyin, m_candidates[exact_idx_local])) then
            begin
                Continue;
            end;

            force_move_display_candidate_to_index(exact_idx_local, 0);
            Exit;
        end;
    end;

    procedure ensure_display_confirmed_prefix_user_extensions;
    const
        c_confirmed_user_extension_display_bonus = 480;
    var
        normalized_current_local: string;
        confirmed_pinyin_local: string;
        full_query_local: string;
        confirmed_prefix_text_local: string;
        full_candidates_local: TncCandidateList;
        seg_idx_local: Integer;
        cand_idx_local: Integer;
        existing_idx_local: Integer;
        extension_text_local: string;
        candidate_local: TncCandidate;
    begin
        if (m_dictionary = nil) or (m_composition_text = '') or
            (m_confirmed_text = '') or (m_confirmed_segments = nil) or
            (m_confirmed_segments.Count = 0) then
        begin
            Exit;
        end;

        normalized_current_local := normalize_pinyin_text(m_composition_text);
        if normalized_current_local = '' then
        begin
            Exit;
        end;

        confirmed_pinyin_local := '';
        for seg_idx_local := 0 to m_confirmed_segments.Count - 1 do
        begin
            if m_confirmed_segments[seg_idx_local].pinyin <> '' then
            begin
                confirmed_pinyin_local := confirmed_pinyin_local +
                    normalize_pinyin_text(m_confirmed_segments[seg_idx_local].pinyin);
            end;
        end;
        if confirmed_pinyin_local = '' then
        begin
            Exit;
        end;

        full_query_local := confirmed_pinyin_local + normalized_current_local;
        if (not m_dictionary.lookup(full_query_local, full_candidates_local)) or
            (Length(full_candidates_local) = 0) then
        begin
            Exit;
        end;

        confirmed_prefix_text_local := m_confirmed_text;
        for cand_idx_local := 0 to High(full_candidates_local) do
        begin
            candidate_local := full_candidates_local[cand_idx_local];
            if (candidate_local.source <> cs_user) or
                (candidate_local.text = '') or
                (Length(candidate_local.text) <= Length(confirmed_prefix_text_local)) or
                (Copy(candidate_local.text, 1,
                Length(confirmed_prefix_text_local)) <> confirmed_prefix_text_local) then
            begin
                Continue;
            end;

            extension_text_local := Trim(Copy(candidate_local.text,
                Length(confirmed_prefix_text_local) + 1,
                Length(candidate_local.text)));
            if extension_text_local = '' then
            begin
                Continue;
            end;

            existing_idx_local := find_display_candidate(extension_text_local, '');
            if existing_idx_local >= 0 then
            begin
                m_candidates[existing_idx_local].source := cs_user;
                m_candidates[existing_idx_local].has_dict_weight := False;
                m_candidates[existing_idx_local].dict_weight := 0;
                if m_candidates[existing_idx_local].score <
                    candidate_local.score + c_confirmed_user_extension_display_bonus then
                begin
                    m_candidates[existing_idx_local].score := candidate_local.score +
                        c_confirmed_user_extension_display_bonus;
                end;
                Continue;
            end;

            candidate_local.text := extension_text_local;
            candidate_local.comment := '';
            candidate_local.source := cs_user;
            candidate_local.has_dict_weight := False;
            candidate_local.dict_weight := 0;
            Inc(candidate_local.score, c_confirmed_user_extension_display_bonus);
            insert_display_candidate(candidate_local, '', Min(1, Length(m_candidates)));
        end;
    end;

    procedure promote_dangling_fast_best_partial_candidate;
    var
        idx: Integer;
        best_idx: Integer;
        candidate_text_local: string;
        candidate_comment_local: string;
        candidate_units_local: Integer;
        comment_units_local: Integer;
        candidate_rank_local: Integer;
        best_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Pos('danglingprefixfast=1', m_last_lookup_debug_extra) <= 0) then
        begin
            Exit;
        end;

        best_idx := -1;
        best_rank_local := Low(Integer);
        for idx := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[idx].text);
            candidate_comment_local := normalize_pinyin_text(
                Trim(m_candidates[idx].comment));
            if (candidate_text_local = '') or (candidate_comment_local = '') then
            begin
                Continue;
            end;

            candidate_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            comment_units_local := get_effective_compact_pinyin_unit_count(
                candidate_comment_local);
            if (candidate_units_local <= 0) or (comment_units_local <= 0) or
                (candidate_units_local + comment_units_local <> expected_units) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]) + (candidate_units_local * 512);
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx := idx;
            end;
        end;

        if best_idx > 0 then
        begin
            move_display_candidate_to_index(best_idx, 0);
        end;
    end;

    procedure promote_final_top2_exact_coverage_candidate;
    const
        c_max_span_len = 4;
        c_min_score_gap = 6000;
        c_min_equal_coverage_raw_score_gap = 24000;
    var
        top_units_local: TArray<string>;
        top2_units_local: TArray<string>;
        candidate_units_local: TArray<string>;
        top_score_local: Integer;
        top2_score_local: Integer;
        candidate_score_local: Integer;
        best_score_local: Integer;
        top_covered_local: Integer;
        top2_covered_local: Integer;
        candidate_covered_local: Integer;
        best_covered_local: Integer;
        idx_local: Integer;
        best_idx_local: Integer;
        top_raw_score_local: Integer;
        candidate_raw_score_local: Integer;
        best_raw_score_local: Integer;

        function differs_only_in_final_two_units_local: Boolean;
        var
            unit_idx_local: Integer;
            diff_count_local: Integer;

            function tail_unit_matches_local(const unit_value: string;
                const code_value: Word): Boolean;
            begin
                Result := (Length(unit_value) = 1) and
                    SameText(unit_value, string(WideChar(code_value)));
            end;
        begin
            Result := False;
            if (Length(top_units_local) <> expected_units) or
                (Length(top2_units_local) <> expected_units) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to expected_units - 3 do
            begin
                if not SameText(top_units_local[unit_idx_local],
                    top2_units_local[unit_idx_local]) then
                begin
                    Exit;
                end;
            end;

            diff_count_local := 0;
            if not SameText(top_units_local[expected_units - 2],
                top2_units_local[expected_units - 2]) then
            begin
                Inc(diff_count_local);
            end;
            if not SameText(top_units_local[expected_units - 1],
                top2_units_local[expected_units - 1]) then
            begin
                Inc(diff_count_local);
            end;
            if diff_count_local <= 0 then
            begin
                Exit;
            end;

            if (diff_count_local = 1) and
                (not SameText(top_units_local[expected_units - 1],
                top2_units_local[expected_units - 1])) and
                ((tail_unit_matches_local(top_units_local[expected_units - 1], $7684) and
                (tail_unit_matches_local(top2_units_local[expected_units - 1], $5730) or
                tail_unit_matches_local(top2_units_local[expected_units - 1], $5F97))) or
                (tail_unit_matches_local(top_units_local[expected_units - 1], $5730) and
                (tail_unit_matches_local(top2_units_local[expected_units - 1], $7684) or
                tail_unit_matches_local(top2_units_local[expected_units - 1], $5F97))) or
                (tail_unit_matches_local(top_units_local[expected_units - 1], $5F97) and
                (tail_unit_matches_local(top2_units_local[expected_units - 1], $7684) or
                tail_unit_matches_local(top2_units_local[expected_units - 1], $5730)))) then
            begin
                Exit;
            end;

            if tail_unit_matches_local(top_units_local[expected_units - 1], $5417) and
                tail_unit_matches_local(top2_units_local[expected_units - 1], $5988) then
            begin
                Exit;
            end;

            if SameText(top_units_local[expected_units - 1],
                top2_units_local[expected_units - 1]) and
                (tail_unit_matches_local(top_units_local[expected_units - 1], $4E86) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $7684) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $5730) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $5F97) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $5417) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $5427) or
                tail_unit_matches_local(top_units_local[expected_units - 1], $5566)) then
            begin
                Exit;
            end;

            Result := True;
        end;

        function build_units_range_text_for_score_local(
            const units_value: TArray<string>; const range_start: Integer;
            const range_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (range_start < 0) or (range_len <= 0) or
                (range_start + range_len > Length(units_value)) then
            begin
                Exit;
            end;

            for local_idx := range_start to range_start + range_len - 1 do
            begin
                Result := Result + units_value[local_idx];
            end;
        end;

        function score_non_overlapping_exact_spans_local(
            const units_value: TArray<string>; out covered_units: Integer):
            Integer;
        var
            occupied_local: TArray<Boolean>;
            span_len_local: Integer;
            start_idx_local: Integer;
            unit_idx_local: Integer;
            query_key_local: string;
            span_text_local: string;
            span_weight_local: Integer;
            range_occupied_local: Boolean;
        begin
            Result := 0;
            covered_units := 0;
            if Length(units_value) <> expected_units then
            begin
                Exit;
            end;

            SetLength(occupied_local, expected_units);
            for span_len_local := Min(c_max_span_len, expected_units) downto 2 do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    range_occupied_local := False;
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        if occupied_local[unit_idx_local] then
                        begin
                            range_occupied_local := True;
                            Break;
                        end;
                    end;
                    if range_occupied_local then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(start_idx_local,
                        span_len_local);
                    span_text_local := build_units_range_text_for_score_local(
                        units_value, start_idx_local, span_len_local);
                    if (query_key_local = '') or (span_text_local = '') or
                        (not display_exact_key_has_text(query_key_local,
                        span_text_local)) then
                    begin
                        Continue;
                    end;

                    span_weight_local := 0;
                    get_display_exact_text_weight(query_key_local, span_text_local,
                        span_len_local, span_weight_local);
                    Inc(Result, span_len_local * span_len_local * 2500 +
                        Min(12000, Max(0, span_weight_local) * 4));
                    Inc(covered_units, span_len_local);
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        occupied_local[unit_idx_local] := True;
                    end;
                end;
            end;
        end;

    begin
        if short_exact_query_mode or (expected_units < 6) or
            (Length(m_candidates) < 2) or
            (Trim(m_candidates[0].comment) <> '') or
            (get_candidate_text_unit_count(Trim(m_candidates[0].text)) <>
            expected_units) then
        begin
            Exit;
        end;

        top_units_local := split_text_units(Trim(m_candidates[0].text));
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;
        top_score_local := score_non_overlapping_exact_spans_local(
            top_units_local, top_covered_local);
        top_raw_score_local := m_candidates[0].score;

        best_idx_local := -1;
        best_score_local := top_score_local;
        best_covered_local := top_covered_local;
        best_raw_score_local := top_raw_score_local;
        for idx_local := 1 to Min(5, High(m_candidates)) do
        begin
            if (Trim(m_candidates[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(Trim(m_candidates[idx_local].text)) <>
                expected_units) then
            begin
                Continue;
            end;

            candidate_units_local := split_text_units(Trim(m_candidates[idx_local].text));
            if Length(candidate_units_local) <> expected_units then
            begin
                Continue;
            end;

            candidate_score_local := score_non_overlapping_exact_spans_local(
                candidate_units_local, candidate_covered_local);
            candidate_raw_score_local := m_candidates[idx_local].score;
            if ((candidate_covered_local <= top_covered_local) and
                (not ((candidate_covered_local = top_covered_local) and
                (((candidate_score_local >= top_score_local -
                c_min_score_gap) and
                (candidate_raw_score_local >= top_raw_score_local +
                c_min_equal_coverage_raw_score_gap)) or
                (candidate_score_local >= top_score_local +
                c_min_score_gap * 2))))) or
                ((candidate_covered_local > top_covered_local) and
                (candidate_score_local < top_score_local + c_min_score_gap)) then
            begin
                Continue;
            end;

            if (candidate_covered_local > best_covered_local) or
                ((candidate_covered_local = best_covered_local) and
                ((candidate_score_local > best_score_local) or
                ((candidate_score_local >= best_score_local - c_min_score_gap) and
                (candidate_raw_score_local > best_raw_score_local)))) then
            begin
                best_idx_local := idx_local;
                best_score_local := candidate_score_local;
                best_covered_local := candidate_covered_local;
                best_raw_score_local := candidate_raw_score_local;
            end;
        end;

        if best_idx_local <= 0 then
        begin
            Exit;
        end;

        top2_units_local := split_text_units(Trim(m_candidates[best_idx_local].text));
        top2_covered_local := best_covered_local;
        top2_score_local := best_score_local;

        if differs_only_in_final_two_units_local or
            (top2_covered_local >= top_covered_local + 2) or
            (top2_score_local >= top_score_local + c_min_score_gap * 2) or
            ((top2_covered_local = top_covered_local) and
            (top2_score_local >= top_score_local - c_min_score_gap) and
            (best_raw_score_local >= top_raw_score_local +
            c_min_equal_coverage_raw_score_gap)) then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure keep_long_complete_candidates_before_partial_display;
    const
        c_probe_limit = 10;
    var
        first_partial_idx_local: Integer;
        next_complete_idx_local: Integer;
        complete_before_partial_local: Integer;
        scan_idx_local: Integer;

        function is_complete_long_display_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
        begin
            text_local := Trim(candidate_value.text);
            Result := (text_local <> '') and
                (Trim(candidate_value.comment) = '') and
                (get_candidate_text_unit_count(text_local) = expected_units);
        end;

        function is_partial_long_display_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_units_local: Integer;
            tail_units_local: Integer;
        begin
            Result := False;
            if Trim(candidate_value.comment) = '' then
            begin
                Exit;
            end;

            text_units_local := get_candidate_text_unit_count(
                Trim(candidate_value.text));
            tail_units_local := get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(Trim(candidate_value.comment)));
            Result := (text_units_local > 0) and (tail_units_local > 0) and
                (text_units_local + tail_units_local = expected_units);
        end;

        function find_first_partial_local: Integer;
        var
            find_idx_local: Integer;
        begin
            Result := -1;
            for find_idx_local := 0 to Min(c_probe_limit - 1,
                High(m_candidates)) do
            begin
                if is_partial_long_display_candidate_local(
                    m_candidates[find_idx_local]) then
                begin
                    Exit(find_idx_local);
                end;
            end;
        end;

        function count_complete_before_local(
            const boundary_idx_local: Integer): Integer;
        var
            count_idx_local: Integer;
        begin
            Result := 0;
            for count_idx_local := 0 to boundary_idx_local - 1 do
            begin
                if is_complete_long_display_candidate_local(
                    m_candidates[count_idx_local]) then
                begin
                    Inc(Result);
                end;
            end;
        end;

        function find_next_complete_after_local(
            const boundary_idx_local: Integer): Integer;
        var
            find_idx_local: Integer;
        begin
            Result := -1;
            for find_idx_local := boundary_idx_local + 1 to
                Min(c_probe_limit - 1, High(m_candidates)) do
            begin
                if is_complete_long_display_candidate_local(
                    m_candidates[find_idx_local]) then
                begin
                    Exit(find_idx_local);
                end;
            end;
        end;
    begin
        if short_exact_query_mode or
            (expected_units < c_long_sentence_full_path_min_syllables) or
            (Length(m_candidates) <= 1) then
        begin
            Exit;
        end;

        for scan_idx_local := 1 to c_long_sentence_complete_candidate_display_limit do
        begin
            first_partial_idx_local := find_first_partial_local;
            if first_partial_idx_local < 0 then
            begin
                Exit;
            end;

            complete_before_partial_local := count_complete_before_local(
                first_partial_idx_local);
            if complete_before_partial_local >=
                c_long_sentence_complete_candidate_display_limit then
            begin
                Exit;
            end;

            next_complete_idx_local := find_next_complete_after_local(
                first_partial_idx_local);
            if next_complete_idx_local < 0 then
            begin
                Exit;
            end;

            force_move_display_candidate_to_index(next_complete_idx_local,
                first_partial_idx_local);
        end;
    end;

    procedure promote_best_second_complete_long_candidate;
    const
        c_probe_limit = 8;
        c_max_span_len = 5;
        c_min_second_score_gain = 6000;
    var
        first_second_idx_local: Integer;
        best_idx_local: Integer;
        best_support_local: Integer;
        first_support_local: Integer;
        candidate_support_local: Integer;
        candidate_idx_local: Integer;

        function is_complete_long_display_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
        begin
            text_local := Trim(candidate_value.text);
            Result := (text_local <> '') and
                (Trim(candidate_value.comment) = '') and
                (get_candidate_text_unit_count(text_local) = expected_units);
        end;

        function build_units_range_text_local(const units_value: TArray<string>;
            const start_idx_local: Integer; const span_len_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (span_len_local <= 0) or
                (start_idx_local + span_len_local > Length(units_value)) then
            begin
                Exit;
            end;

            for local_idx := start_idx_local to
                start_idx_local + span_len_local - 1 do
            begin
                Result := Result + units_value[local_idx];
            end;
        end;

        function score_candidate_exact_support_local(
            const candidate_value: TncCandidate): Integer;
        var
            units_local: TArray<string>;
            occupied_local: TArray<Boolean>;
            span_len_local: Integer;
            start_idx_local: Integer;
            unit_idx_local: Integer;
            query_key_local: string;
            span_text_local: string;
            span_weight_local: Integer;
            range_occupied_local: Boolean;
        begin
            Result := 0;
            units_local := split_text_units(Trim(candidate_value.text));
            if Length(units_local) <> expected_units then
            begin
                Exit;
            end;

            SetLength(occupied_local, expected_units);
            for span_len_local := Min(c_max_span_len, expected_units) downto 2 do
            begin
                for start_idx_local := 0 to expected_units - span_len_local do
                begin
                    range_occupied_local := False;
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        if occupied_local[unit_idx_local] then
                        begin
                            range_occupied_local := True;
                            Break;
                        end;
                    end;
                    if range_occupied_local then
                    begin
                        Continue;
                    end;

                    query_key_local := build_display_query_key(start_idx_local,
                        span_len_local);
                    span_text_local := build_units_range_text_local(units_local,
                        start_idx_local, span_len_local);
                    if (query_key_local = '') or (span_text_local = '') or
                        (not display_exact_key_has_text(query_key_local,
                        span_text_local)) then
                    begin
                        Continue;
                    end;

                    span_weight_local := 0;
                    get_display_exact_text_weight(query_key_local,
                        span_text_local, span_len_local, span_weight_local);
                    Inc(Result, span_len_local * span_len_local * 2200 +
                        Min(18000, Max(0, span_weight_local) * span_len_local *
                        4));
                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        occupied_local[unit_idx_local] := True;
                    end;
                end;
            end;
        end;
    begin
        if short_exact_query_mode or
            (expected_units < c_long_sentence_full_path_min_syllables) or
            (Length(m_candidates) < 3) or
            (not is_complete_long_display_candidate_local(m_candidates[0])) then
        begin
            Exit;
        end;

        first_second_idx_local := -1;
        for candidate_idx_local := 1 to Min(c_probe_limit - 1,
            High(m_candidates)) do
        begin
            if is_complete_long_display_candidate_local(
                m_candidates[candidate_idx_local]) then
            begin
                first_second_idx_local := candidate_idx_local;
                Break;
            end;
        end;
        if first_second_idx_local < 0 then
        begin
            Exit;
        end;

        first_support_local := score_candidate_exact_support_local(
            m_candidates[first_second_idx_local]);
        best_support_local := first_support_local;
        best_idx_local := first_second_idx_local;

        for candidate_idx_local := first_second_idx_local + 1 to
            Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if not is_complete_long_display_candidate_local(
                m_candidates[candidate_idx_local]) then
            begin
                Continue;
            end;

            candidate_support_local := score_candidate_exact_support_local(
                m_candidates[candidate_idx_local]);
            if candidate_support_local > best_support_local then
            begin
                best_support_local := candidate_support_local;
                best_idx_local := candidate_idx_local;
            end;
        end;

        if (best_idx_local > first_second_idx_local) and
            (best_support_local >= first_support_local + c_min_second_score_gain) then
        begin
            force_move_display_candidate_to_index(best_idx_local,
                first_second_idx_local);
        end;
    end;

    procedure promote_higher_scored_complete_long_display_candidate;
    const
        c_probe_limit = 6;
        c_min_score_gain = 12000;
        c_min_pathless_over_pathful_score_gain = 40000;
        c_min_pathless_over_pathful_coverage_gain = 8000;
    var
        best_idx_local: Integer;
        best_score_local: Integer;
        candidate_idx_local: Integer;
        candidate_score_local: Integer;
        top_path_segments_local: Integer;
        candidate_path_segments_local: Integer;
        top_coverage_local: Integer;
        candidate_coverage_local: Integer;
        candidate_text_local: string;
        weak_pathless_over_pathful_local: Boolean;

        function is_complete_long_candidate_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_local: string;
        begin
            text_local := Trim(candidate_value.text);
            Result := (text_local <> '') and
                (Trim(candidate_value.comment) = '') and
                (get_candidate_text_unit_count(text_local) = expected_units);
        end;

        function effective_score_local(
            const candidate_value: TncCandidate): Integer;
        begin
            Result := candidate_value.score;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > Result) then
            begin
                Result := candidate_value.dict_weight;
            end;
            if candidate_value.source = cs_user then
            begin
                Inc(Result, c_user_score_bonus);
            end;
        end;

        function actual_path_segment_count_local(const candidate_value:
            TncCandidate; const candidate_idx_value: Integer): Integer;
        var
            path_local: string;
        begin
            path_local := '';
            if (candidate_idx_value >= 0) and
                (candidate_idx_value < Length(m_candidate_segment_paths)) then
            begin
                path_local := m_candidate_segment_paths[candidate_idx_value];
            end;
            if path_local = '' then
            begin
                path_local := get_segment_path_for_candidate(candidate_value,
                    candidate_idx_value);
            end;
            Result := get_encoded_path_segment_count_local(path_local);
        end;
    begin
        if short_exact_query_mode or
            (expected_units < c_long_sentence_full_path_min_syllables) or
            (Length(m_candidates) < 2) or (m_candidates[0].source = cs_user) or
            (not is_complete_long_candidate_local(m_candidates[0])) then
        begin
            Exit;
        end;

        best_idx_local := 0;
        best_score_local := effective_score_local(m_candidates[0]);
        top_path_segments_local := actual_path_segment_count_local(
            m_candidates[0], 0);
        top_coverage_local :=
            get_display_complete_exact_span_coverage_score(m_candidates[0]);
        for candidate_idx_local := 1 to Min(c_probe_limit - 1,
            High(m_candidates)) do
        begin
            if not is_complete_long_candidate_local(
                m_candidates[candidate_idx_local]) then
            begin
                Continue;
            end;

            candidate_score_local := effective_score_local(
                m_candidates[candidate_idx_local]);
            candidate_text_local := Trim(m_candidates[candidate_idx_local].text);
            candidate_path_segments_local := actual_path_segment_count_local(
                m_candidates[candidate_idx_local], candidate_idx_local);
            weak_pathless_over_pathful_local :=
                (top_path_segments_local > 1) and
                (candidate_path_segments_local <= 1) and
                ((normalized_pinyin = '') or
                (not display_exact_key_has_text(normalized_pinyin,
                candidate_text_local))) and
                (candidate_score_local < best_score_local +
                c_min_pathless_over_pathful_score_gain);
            if weak_pathless_over_pathful_local then
            begin
                candidate_coverage_local :=
                    get_display_complete_exact_span_coverage_score(
                    m_candidates[candidate_idx_local]);
                if candidate_coverage_local < top_coverage_local +
                    c_min_pathless_over_pathful_coverage_gain then
                begin
                    Continue;
                end;
            end;
            if candidate_score_local > best_score_local then
            begin
                best_score_local := candidate_score_local;
                best_idx_local := candidate_idx_local;
            end;
        end;

        if (best_idx_local <= 0) or
            (best_score_local < effective_score_local(m_candidates[0]) +
            c_min_score_gain) then
        begin
            Exit;
        end;

        force_move_display_candidate_to_index(best_idx_local, 0);
        if m_config.debug_mode then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' vhscore=[idx=%d gain=%d text=%s]',
                [best_idx_local,
                best_score_local - effective_score_local(m_candidates[1]),
                Trim(m_candidates[0].text)]);
        end;
    end;

    procedure note_display_phase(const phase_name: string);
    var
        elapsed_ms: UInt64;
    begin
        if not m_config.debug_mode then
        begin
            display_phase_tick := GetTickCount64;
            Exit;
        end;

        elapsed_ms := GetTickCount64 - display_phase_tick;
        display_phase_tick := GetTickCount64;
        if elapsed_ms = 0 then
        begin
            Exit;
        end;

        if m_last_lookup_debug_extra <> '' then
        begin
            m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
        end;
        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
            Format('gc_%s=%d', [phase_name, elapsed_ms]);
    end;

    function can_use_display_typo_short_prefix_fast_path: Boolean;
    const
        c_min_supported_prefix_weight = 300;
        c_probe_limit = 8;
    var
        idx_local: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        split_head_local: string;
        split_tail_local: string;
        prefix_units_local: Integer;
        tail_units_local: Integer;
        prefix_key_local: string;
    begin
        Result := False;
        if (Pos('typoshortprefixfast=1', m_last_lookup_debug_extra) <= 0) or
            (expected_units < 3) or (expected_units > 4) or
            (Length(m_candidates) = 0) or (m_dictionary = nil) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_key) > 0) then
        begin
            Exit;
        end;

        for idx_local := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_text_local := Trim(m_candidates[idx_local].text);
            candidate_tail_local := Trim(m_candidates[idx_local].comment);
            if (candidate_tail_local = '') and
                split_trailing_ascii_candidate(candidate_text_local,
                split_head_local, split_tail_local) then
            begin
                candidate_text_local := Trim(split_head_local);
                candidate_tail_local := Trim(split_tail_local);
            end;

            candidate_tail_local := normalize_pinyin_text(candidate_tail_local);
            if (candidate_text_local = '') or (candidate_tail_local = '') or
                (Length(candidate_tail_local) > 10) then
            begin
                Continue;
            end;

            prefix_units_local :=
                get_candidate_text_unit_count(candidate_text_local);
            tail_units_local :=
                get_effective_compact_pinyin_unit_count(candidate_tail_local);
            if (prefix_units_local <= 0) or
                (prefix_units_local >= expected_units) or
                (tail_units_local <= 0) or
                (prefix_units_local + tail_units_local <> expected_units) then
            begin
                Continue;
            end;

            prefix_key_local := build_display_query_key(0,
                prefix_units_local);
            if prefix_key_local = '' then
            begin
                Continue;
            end;

            if prefix_units_local = 1 then
            begin
                if m_dictionary.single_char_matches_pinyin(prefix_key_local,
                    candidate_text_local) then
                begin
                    Exit(True);
                end;
            end
            else if display_exact_key_has_text(prefix_key_local,
                candidate_text_local) or
                m_dictionary.is_base_entry(prefix_key_local,
                candidate_text_local) or
                m_dictionary.is_user_entry(prefix_key_local,
                candidate_text_local) or
                (m_candidates[idx_local].dict_weight >=
                c_min_supported_prefix_weight) then
            begin
                Exit(True);
            end;
        end;
    end;

    procedure insert_typo_short_prefix_tail_completion_from_partial;
    const
        c_probe_limit = 8;
        c_tail_probe_limit = 8;
        c_min_supported_prefix_weight = 300;
    var
        idx_local: Integer;
        tail_idx_local: Integer;
        duplicate_idx_local: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        split_head_local: string;
        split_tail_local: string;
        prefix_units_local: Integer;
        tail_units_local: Integer;
        prefix_key_local: string;
        tail_results_local: TncCandidateList;
        tail_text_local: string;
        repaired_text_local: string;
        repaired_candidate_local: TncCandidate;
        repaired_path_local: string;
        prefix_supported_local: Boolean;
    begin
        if not can_use_display_typo_short_prefix_fast_path then
        begin
            Exit;
        end;

        for idx_local := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_text_local := Trim(m_candidates[idx_local].text);
            candidate_tail_local := Trim(m_candidates[idx_local].comment);
            if (candidate_tail_local = '') and
                split_trailing_ascii_candidate(candidate_text_local,
                split_head_local, split_tail_local) then
            begin
                candidate_text_local := Trim(split_head_local);
                candidate_tail_local := Trim(split_tail_local);
            end;

            candidate_tail_local := normalize_pinyin_text(candidate_tail_local);
            prefix_units_local :=
                get_candidate_text_unit_count(candidate_text_local);
            tail_units_local :=
                get_effective_compact_pinyin_unit_count(candidate_tail_local);
            if (candidate_text_local = '') or (candidate_tail_local = '') or
                (prefix_units_local <= 0) or (tail_units_local < 2) or
                (tail_units_local > 3) or
                (prefix_units_local + tail_units_local <> expected_units) then
            begin
                Continue;
            end;

            prefix_key_local := build_display_query_key(0,
                prefix_units_local);
            if prefix_key_local = '' then
            begin
                Continue;
            end;

            if prefix_units_local = 1 then
            begin
                prefix_supported_local :=
                    m_dictionary.single_char_matches_pinyin(prefix_key_local,
                    candidate_text_local);
            end
            else
            begin
                prefix_supported_local :=
                    display_exact_key_has_text(prefix_key_local,
                    candidate_text_local) or
                    m_dictionary.is_base_entry(prefix_key_local,
                    candidate_text_local) or
                    m_dictionary.is_user_entry(prefix_key_local,
                    candidate_text_local) or
                    (m_candidates[idx_local].dict_weight >=
                    c_min_supported_prefix_weight);
            end;
            if not prefix_supported_local then
            begin
                Continue;
            end;

            if not lookup_display_complete_cached(candidate_tail_local,
                tail_results_local) then
            begin
                Continue;
            end;

            for tail_idx_local := 0 to High(tail_results_local) do
            begin
                if tail_idx_local >= c_tail_probe_limit then
                begin
                    Break;
                end;

                tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                if (Trim(tail_results_local[tail_idx_local].comment) <> '') or
                    (tail_text_local = '') or
                    (get_candidate_text_unit_count(tail_text_local) <>
                    tail_units_local) then
                begin
                    Continue;
                end;

                repaired_text_local := candidate_text_local + tail_text_local;
                duplicate_idx_local :=
                    find_display_candidate(repaired_text_local, '');
                if duplicate_idx_local >= 0 then
                begin
                    move_display_candidate_to_index(duplicate_idx_local, 0);
                    Exit;
                end;

                repaired_candidate_local := m_candidates[idx_local];
                repaired_candidate_local.text := repaired_text_local;
                repaired_candidate_local.comment := '';
                repaired_candidate_local.source := cs_rule;
                repaired_candidate_local.has_dict_weight :=
                    tail_results_local[tail_idx_local].has_dict_weight;
                repaired_candidate_local.dict_weight :=
                    tail_results_local[tail_idx_local].dict_weight;
                repaired_candidate_local.score := Max(
                    m_candidates[idx_local].score,
                    tail_results_local[tail_idx_local].score) + 16000;
                repaired_path_local := candidate_text_local +
                    c_segment_path_separator + tail_text_local;
                insert_display_candidate(repaired_candidate_local,
                    repaired_path_local, 0);
                Exit;
            end;
        end;
    end;

    function top_display_candidate_is_stable_complete_local: Boolean;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
        top_path_local: string;
        support_score_local: Integer;
        support_segments_local: Integer;
    begin
        Result := False;
        if (expected_units < 12) or
            (Length(m_candidates) = 0) or
            (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        if Trim(top_candidate_local.comment) <> '' then
        begin
            Exit;
        end;

        top_text_local := Trim(top_candidate_local.text);
        if (top_text_local = '') or
            (get_candidate_text_unit_count(top_text_local) <> expected_units) or
            is_problematic_single_char_chain_candidate_for_query(
            normalized_pinyin, top_candidate_local) then
        begin
            Exit;
        end;

        top_path_local := get_segment_path_for_candidate(top_candidate_local, 0);
        if top_path_local = '' then
        begin
            top_path_local := infer_segment_path_for_query_text_with_score(
                normalized_pinyin, top_text_local, support_score_local,
                support_segments_local);
        end;
        Result := top_path_local <> '';
    end;

    function can_use_display_short_complete_fast_path: Boolean;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
        short4_prefix_complete_local: Boolean;
        supported_pronoun_connector_complete_local: Boolean;
    begin
        Result := False;
        short4_prefix_complete_local :=
            Pos('short4prefixraw=1', m_last_lookup_debug_extra) > 0;
        if (expected_units < 4) or (expected_units > 6) or
            (Length(m_candidates) = 0) then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        supported_pronoun_connector_complete_local :=
            display_candidate_is_supported_pronoun_connector_tail_complete_local(
            top_candidate_local);
        if (Pos('shortcompletefast=1', m_last_lookup_debug_extra) <= 0) and
            (Pos('short321tailfast=1', m_last_lookup_debug_extra) <= 0) and
            (not short4_prefix_complete_local) and
            (not supported_pronoun_connector_complete_local) then
        begin
            Exit;
        end;
        if Trim(top_candidate_local.comment) <> '' then
        begin
            Exit;
        end;

        top_text_local := Trim(top_candidate_local.text);
        Result := (top_text_local <> '') and
            (get_candidate_text_unit_count(top_text_local) = expected_units) and
            ((not short4_prefix_complete_local) or
            (top_candidate_local.score >= 15000)) and
            ((not is_problematic_single_char_chain_candidate_for_query(
            normalized_pinyin, top_candidate_local)) or
            supported_pronoun_connector_complete_local);
    end;

    function can_use_display_fixed_head_tail_complete_fast_path: Boolean;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
    begin
        Result := False;
        if (expected_units < 3) or (expected_units > 6) or
            (Length(m_candidates) = 0) or
            (Pos('fixedheadtail=1', m_last_lookup_debug_extra) <= 0) or
            (not is_full_pinyin_key(normalized_pinyin)) then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        if Trim(top_candidate_local.comment) <> '' then
        begin
            Exit;
        end;

        top_text_local := Trim(top_candidate_local.text);
        Result := (top_text_local <> '') and
            (get_candidate_text_unit_count(top_text_local) = expected_units) and
            (not is_problematic_single_char_chain_candidate_for_query(
            normalized_pinyin, top_candidate_local));
    end;

    procedure promote_display_supported_partial_with_same_tail_local;
    const
        c_probe_limit = 8;
    var
        top_text_local: string;
        top_tail_local: string;
        top_units_local: Integer;
        head_key_local: string;
        idx: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_rank_local: Integer;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 3) or
            (Length(syllables) <> expected_units) then
        begin
            Exit;
        end;

        top_tail_local := normalize_pinyin_text(Trim(m_candidates[0].comment));
        if top_tail_local = '' then
        begin
            Exit;
        end;

        top_text_local := Trim(m_candidates[0].text);
        top_units_local := get_candidate_text_unit_count(top_text_local);
        if (top_units_local <= 0) or (top_units_local >= expected_units) then
        begin
            Exit;
        end;

        head_key_local := build_display_query_key(0, top_units_local);
        if head_key_local = '' then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_tail_local := normalize_pinyin_text(
                Trim(m_candidates[idx].comment));
            if candidate_tail_local <> top_tail_local then
            begin
                Continue;
            end;

            candidate_text_local := Trim(m_candidates[idx].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                top_units_local) or
                (not display_exact_key_has_text(head_key_local,
                candidate_text_local)) then
            begin
                Continue;
            end;

            candidate_rank_local := display_candidate_effective_weight(
                m_candidates[idx]);
            if candidate_rank_local > best_rank_local then
            begin
                best_rank_local := candidate_rank_local;
                best_idx_local := idx;
            end;
        end;

        if best_idx_local > 0 then
        begin
            force_move_display_candidate_to_index(best_idx_local, 0);
        end;
    end;

    procedure normalize_display_partial_prefix_order;
    const
        c_max_partial_order_candidates = 32;
    var
        block_start: Integer;
        block_end: Integer;
        original_block_end: Integer;
        local_idx: Integer;
        probe_idx: Integer;
        insert_idx: Integer;
        has_multi_char_partial: Boolean;
        picked_candidate: TncCandidate;
        picked_path: string;

        function partial_prefix_units_local(
            const candidate_value: TncCandidate): Integer;
        var
            tail_units_local: Integer;
        begin
            Result := 0;
            if Trim(candidate_value.comment) = '' then
            begin
                Exit;
            end;

            Result := get_candidate_text_unit_count(Trim(candidate_value.text));
            tail_units_local := get_effective_compact_pinyin_unit_count(
                candidate_value.comment);
            if (Result <= 0) or (tail_units_local <= 0) or
                (Result + tail_units_local <> expected_units) then
            begin
                Result := 0;
            end;
        end;

        function partial_prefix_weight_local(
            const candidate_value: TncCandidate): Integer;
        var
            prefix_key: string;
        begin
            if candidate_value.has_dict_weight then
            begin
                Result := candidate_value.dict_weight;
            end
            else
            begin
                Result := candidate_value.score;
            end;
            if candidate_value.has_dict_weight and
                (candidate_value.source = cs_rule) then
            begin
                prefix_key := build_display_query_key(0,
                    get_candidate_text_unit_count(candidate_value.text));
                Inc(Result, get_base_exact_choice_weight_bonus(prefix_key,
                    candidate_value.text));
            end;
        end;

        function partial_prefix_is_exact_entry_local(
            const candidate_value: TncCandidate;
            const prefix_units: Integer): Boolean;
        var
            prefix_key_local: string;
        begin
            Result := False;
            if prefix_units <= 0 then
            begin
                Exit;
            end;

            prefix_key_local := build_display_query_key(0, prefix_units);
            Result := (prefix_key_local <> '') and
                display_exact_key_has_text(prefix_key_local,
                Trim(candidate_value.text));
        end;

        function partial_prefix_order_before_local(
            const left: TncCandidate; const right: TncCandidate): Boolean;
        var
            left_units: Integer;
            right_units: Integer;
            left_exact: Boolean;
            right_exact: Boolean;
            left_weight: Integer;
            right_weight: Integer;
        begin
            left_units := partial_prefix_units_local(left);
            right_units := partial_prefix_units_local(right);
            if (left_units <= 0) or (right_units <= 0) then
            begin
                Exit(False);
            end;

            if left_units <> right_units then
            begin
                Exit(left_units > right_units);
            end;
            if left_units = 1 then
            begin
                Exit(False);
            end;

            left_exact := partial_prefix_is_exact_entry_local(left, left_units);
            right_exact := partial_prefix_is_exact_entry_local(right, right_units);
            if left_exact <> right_exact then
            begin
                Exit(left_exact);
            end;

            if left.source <> right.source then
            begin
                if left.source = cs_user then
                begin
                    Exit(True);
                end;
                if right.source = cs_user then
                begin
                    Exit(False);
                end;
            end;

            left_weight := partial_prefix_weight_local(left);
            right_weight := partial_prefix_weight_local(right);
            if left_weight <> right_weight then
            begin
                Exit(left_weight > right_weight);
            end;

            Result := left.score > right.score;
        end;
    begin
        if (Length(m_candidates) <= 1) or (expected_units < 2) then
        begin
            Exit;
        end;

        has_multi_char_partial := False;
        for probe_idx := 0 to High(m_candidates) do
        begin
            if (Trim(m_candidates[probe_idx].comment) <> '') and
                (get_candidate_text_unit_count(
                Trim(m_candidates[probe_idx].text)) > 1) then
            begin
                has_multi_char_partial := True;
                Break;
            end;
        end;
        if not has_multi_char_partial then
        begin
            Exit;
        end;

        block_start := 0;
        while block_start <= High(m_candidates) do
        begin
            while (block_start <= High(m_candidates)) and
                (partial_prefix_units_local(m_candidates[block_start]) <= 0) do
            begin
                Inc(block_start);
            end;
            if block_start > High(m_candidates) then
            begin
                Break;
            end;

            block_end := block_start;
            while (block_end <= High(m_candidates)) and
                (partial_prefix_units_local(m_candidates[block_end]) > 0) do
            begin
                Inc(block_end);
            end;
            Dec(block_end);
            original_block_end := block_end;
            if block_end - block_start + 1 > c_max_partial_order_candidates then
            begin
                block_end := block_start + c_max_partial_order_candidates - 1;
            end;

            for local_idx := block_start + 1 to block_end do
            begin
                picked_candidate := m_candidates[local_idx];
                picked_path := '';
                if local_idx < Length(m_candidate_segment_paths) then
                begin
                    picked_path := m_candidate_segment_paths[local_idx];
                end;

                insert_idx := local_idx;
                while (insert_idx > block_start) and
                    partial_prefix_order_before_local(picked_candidate,
                    m_candidates[insert_idx - 1]) do
                begin
                    m_candidates[insert_idx] := m_candidates[insert_idx - 1];
                    if insert_idx < Length(m_candidate_segment_paths) then
                    begin
                        if insert_idx - 1 < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[insert_idx] :=
                                m_candidate_segment_paths[insert_idx - 1];
                        end
                        else
                        begin
                            m_candidate_segment_paths[insert_idx] := '';
                        end;
                    end;
                    Dec(insert_idx);
                end;

                m_candidates[insert_idx] := picked_candidate;
                if insert_idx < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[insert_idx] := picked_path;
                end;
            end;

            block_start := original_block_end + 1;
        end;
    end;

    procedure ensure_display_top_complete_prefix_partial_visible;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
        top_units_local: TArray<string>;
        syllables_local: TncPinyinParseResult;
        prefix_text_local: string;
        tail_key_local: string;
        unit_idx_local: Integer;
        candidate_idx_local: Integer;
        existing_idx_local: Integer;
        insert_idx_local: Integer;
        move_idx_local: Integer;
        best_anchor_idx_local: Integer;
        best_anchor_score_local: Integer;
        anchor_score_local: Integer;
        suffix_text_local: string;
        suffix_key_local: string;
        partial_candidate_local: TncCandidate;

        function build_syllable_key_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(syllables_local)) then
            begin
                Exit;
            end;

            for local_idx := start_idx_local to start_idx_local + count_local - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function build_unit_text_local(const start_idx_local: Integer;
            const count_local: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            if (start_idx_local < 0) or (count_local <= 0) or
                (start_idx_local + count_local > Length(top_units_local)) then
            begin
                Exit;
            end;

            for local_idx := start_idx_local to start_idx_local + count_local - 1 do
            begin
                Result := Result + top_units_local[local_idx];
            end;
        end;

        function derived_prefix_has_exact_tail_support_local: Boolean;
        var
            local_suffix_len: Integer;
            local_suffix_start: Integer;
        begin
            Result := False;
            for local_suffix_len := Min(4, expected_units - 1) downto 2 do
            begin
                local_suffix_start := expected_units - 1 - local_suffix_len;
                suffix_text_local := build_unit_text_local(local_suffix_start,
                    local_suffix_len);
                suffix_key_local := build_syllable_key_local(local_suffix_start,
                    local_suffix_len);
                if (suffix_text_local <> '') and (suffix_key_local <> '') and
                    (display_exact_key_has_text(suffix_key_local,
                    suffix_text_local) or
                    ((m_dictionary <> nil) and
                    m_dictionary.is_base_entry(suffix_key_local,
                    suffix_text_local))) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function find_existing_prefix_partial_local: Integer;
        var
            find_idx_local: Integer;
        begin
            Result := -1;
            for find_idx_local := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[find_idx_local].text),
                    prefix_text_local) and
                    SameText(normalize_pinyin_text(Trim(
                    m_candidates[find_idx_local].comment)), tail_key_local) then
                begin
                    Exit(find_idx_local);
                end;
            end;
        end;

        function get_prefix_partial_insert_index_local: Integer;
        var
            scan_idx_local: Integer;
            complete_seen_local: Integer;
        begin
            Result := 1;
            complete_seen_local := 0;
            for scan_idx_local := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[scan_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(Trim(
                    m_candidates[scan_idx_local].text)) = expected_units) then
                begin
                    Inc(complete_seen_local);
                    Result := scan_idx_local + 1;
                    if complete_seen_local >=
                        c_long_sentence_complete_candidate_display_limit then
                    begin
                        Break;
                    end;
                end;
            end;
            if Result < 1 then
            begin
                Result := 1;
            end;
        end;

        procedure move_prefix_partial_to_index_local(
            const candidate_idx_local: Integer; const target_idx_local: Integer);
        var
            local_move_idx: Integer;
            moved_candidate_local: TncCandidate;
            moved_path_local: string;
            normalized_target_idx_local: Integer;
        begin
            if (candidate_idx_local < 0) or
                (candidate_idx_local > High(m_candidates)) then
            begin
                Exit;
            end;

            normalized_target_idx_local := Max(1,
                Min(target_idx_local, High(m_candidates)));
            if candidate_idx_local < normalized_target_idx_local then
            begin
                Dec(normalized_target_idx_local);
            end;
            if candidate_idx_local = normalized_target_idx_local then
            begin
                Exit;
            end;

            moved_candidate_local := m_candidates[candidate_idx_local];
            moved_path_local := '';
            if candidate_idx_local < Length(m_candidate_segment_paths) then
            begin
                moved_path_local := m_candidate_segment_paths[candidate_idx_local];
            end;

            if candidate_idx_local > normalized_target_idx_local then
            begin
                for local_move_idx := candidate_idx_local downto
                    normalized_target_idx_local + 1 do
                begin
                    m_candidates[local_move_idx] := m_candidates[local_move_idx - 1];
                    if local_move_idx < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[local_move_idx] :=
                            m_candidate_segment_paths[local_move_idx - 1];
                    end;
                end;
            end
            else
            begin
                for local_move_idx := candidate_idx_local to
                    normalized_target_idx_local - 1 do
                begin
                    m_candidates[local_move_idx] := m_candidates[local_move_idx + 1];
                    if local_move_idx < Length(m_candidate_segment_paths) then
                    begin
                        if local_move_idx + 1 < Length(m_candidate_segment_paths) then
                        begin
                            m_candidate_segment_paths[local_move_idx] :=
                                m_candidate_segment_paths[local_move_idx + 1];
                        end
                        else
                        begin
                            m_candidate_segment_paths[local_move_idx] := '';
                        end;
                    end;
                end;
            end;
            m_candidates[normalized_target_idx_local] := moved_candidate_local;
            if normalized_target_idx_local < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[normalized_target_idx_local] :=
                    moved_path_local;
            end;
            m_visible_candidates_cache_valid := False;
        end;
    begin
        if (expected_units < 6) or (Length(m_candidates) = 0) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(
            normalized_pinyin);
        if Length(syllables_local) <> expected_units then
        begin
            Exit;
        end;

        best_anchor_idx_local := -1;
        best_anchor_score_local := Low(Integer);
        for candidate_idx_local := 0 to Min(High(m_candidates), 5) do
        begin
            top_candidate_local := m_candidates[candidate_idx_local];
            top_text_local := Trim(top_candidate_local.text);
            if (top_text_local = '') or
                (Trim(top_candidate_local.comment) <> '') or
                (get_candidate_text_unit_count(top_text_local) <>
                expected_units) then
            begin
                Continue;
            end;

            top_units_local := split_text_units(top_text_local);
            if Length(top_units_local) <> expected_units then
            begin
                Continue;
            end;

            anchor_score_local := top_candidate_local.score;
            if derived_prefix_has_exact_tail_support_local then
            begin
                Inc(anchor_score_local, 100000);
            end;
            if anchor_score_local > best_anchor_score_local then
            begin
                best_anchor_score_local := anchor_score_local;
                best_anchor_idx_local := candidate_idx_local;
            end;
        end;

        if best_anchor_idx_local < 0 then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[best_anchor_idx_local];
        top_text_local := Trim(top_candidate_local.text);
        top_units_local := split_text_units(top_text_local);
        if Length(top_units_local) <> expected_units then
        begin
            Exit;
        end;

        prefix_text_local := '';
        for unit_idx_local := 0 to High(top_units_local) - 1 do
        begin
            prefix_text_local := prefix_text_local + top_units_local[unit_idx_local];
        end;
        tail_key_local := normalize_pinyin_text(Trim(
            syllables_local[High(syllables_local)].text));
        if (prefix_text_local = '') or (tail_key_local = '') then
        begin
            Exit;
        end;

        existing_idx_local := find_existing_prefix_partial_local;
        insert_idx_local := get_prefix_partial_insert_index_local;
        if existing_idx_local = insert_idx_local then
        begin
            Exit;
        end;
        if existing_idx_local >= 0 then
        begin
            move_prefix_partial_to_index_local(existing_idx_local, insert_idx_local);
            Exit;
        end;

        partial_candidate_local := top_candidate_local;
        partial_candidate_local.text := prefix_text_local;
        partial_candidate_local.comment := tail_key_local;
        partial_candidate_local.score := Max(0, top_candidate_local.score - 80);
        partial_candidate_local.has_dict_weight := False;
        partial_candidate_local.dict_weight := 0;

        SetLength(m_candidates, Length(m_candidates) + 1);
        if Length(m_candidate_segment_paths) < Length(m_candidates) then
        begin
            SetLength(m_candidate_segment_paths, Length(m_candidates));
        end;
        for move_idx_local := High(m_candidates) downto insert_idx_local + 1 do
        begin
            m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
            if move_idx_local < Length(m_candidate_segment_paths) then
            begin
                m_candidate_segment_paths[move_idx_local] :=
                    m_candidate_segment_paths[move_idx_local - 1];
            end;
        end;
        m_candidates[insert_idx_local] := partial_candidate_local;
        if insert_idx_local < Length(m_candidate_segment_paths) then
        begin
            m_candidate_segment_paths[insert_idx_local] := '';
        end;
    end;

    procedure append_long_display_first_syllable_partials_to_fill_page;
    const
        c_partial_penalty_per_tail_syllable = 120;
        c_append_order_penalty = 4;
    var
        local_syllables: TncPinyinParseResult;
        first_key_local: string;
        tail_key_local: string;
        lookup_results_local: TncCandidateList;
        source_candidate_local: TncCandidate;
        partial_candidate_local: TncCandidate;
        lookup_idx_local: Integer;
        syllable_idx_local: Integer;
        appended_count_local: Integer;
        source_weight_local: Integer;

        function is_bmp_cjk_single_text_local(const text_value: string): Boolean;
        var
            normalized_text_local: string;
            codepoint_local: Integer;
        begin
            Result := False;
            normalized_text_local := Trim(text_value);
            if Length(normalized_text_local) <> 1 then
            begin
                Exit;
            end;

            codepoint_local := Ord(normalized_text_local[1]);
            Result := (codepoint_local >= $4E00) and (codepoint_local <= $9FFF);
        end;

        function display_candidate_exists_local(const text_value: string;
            const comment_value: string): Boolean;
        var
            scan_idx_local: Integer;
        begin
            Result := False;
            for scan_idx_local := 0 to High(m_candidates) do
            begin
                if SameText(Trim(m_candidates[scan_idx_local].text),
                    text_value) and
                    SameText(normalize_pinyin_text(Trim(
                    m_candidates[scan_idx_local].comment)), comment_value) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_long_display_anchor_local: Boolean;
        var
            scan_idx_local: Integer;
            text_units_local: Integer;
            comment_units_local: Integer;
            comment_key_local: string;
        begin
            Result := False;
            for scan_idx_local := 0 to Min(High(m_candidates), 3) do
            begin
                text_units_local := get_candidate_text_unit_count(
                    Trim(m_candidates[scan_idx_local].text));
                comment_key_local := normalize_pinyin_text(Trim(
                    m_candidates[scan_idx_local].comment));
                comment_units_local :=
                    get_effective_compact_pinyin_unit_count(comment_key_local);
                if (text_units_local > 0) and
                    (text_units_local + comment_units_local >= expected_units - 1)
                then
                begin
                    Exit(True);
                end;
            end;
        end;

        function first_syllable_partial_total_limit_local: Integer;
        begin
            Result := c_candidate_total_limit_max;
        end;
    begin
        if (m_dictionary = nil) or (expected_units < 6) or
            (not is_full_pinyin_key(normalized_pinyin)) or
            (not has_long_display_anchor_local) then
        begin
            Exit;
        end;

        local_syllables := syllables;
        if Length(local_syllables) <> expected_units then
        begin
            local_syllables :=
                get_effective_compact_pinyin_syllables(normalized_pinyin);
        end;
        if Length(local_syllables) <> expected_units then
        begin
            Exit;
        end;

        first_key_local := normalize_pinyin_text(local_syllables[0].text);
        tail_key_local := '';
        for syllable_idx_local := 1 to High(local_syllables) do
        begin
            tail_key_local := tail_key_local + normalize_pinyin_text(
                local_syllables[syllable_idx_local].text);
        end;
        if (first_key_local = '') or (tail_key_local = '') or
            (not lookup_display_exact_cached(first_key_local,
            lookup_results_local)) then
        begin
            Exit;
        end;

        appended_count_local := 0;
        for lookup_idx_local := 0 to High(lookup_results_local) do
        begin
            if Length(m_candidates) >=
                first_syllable_partial_total_limit_local then
            begin
                Break;
            end;

            source_candidate_local := lookup_results_local[lookup_idx_local];
            if (Trim(source_candidate_local.comment) <> '') or
                (not is_bmp_cjk_single_text_local(source_candidate_local.text)) or
                display_candidate_exists_local(Trim(source_candidate_local.text),
                tail_key_local) then
            begin
                Continue;
            end;

            partial_candidate_local := source_candidate_local;
            partial_candidate_local.comment := tail_key_local;
            partial_candidate_local.has_dict_weight := False;
            partial_candidate_local.dict_weight := 0;
            source_weight_local :=
                display_candidate_effective_weight(source_candidate_local);
            partial_candidate_local.score := Max(1,
                source_weight_local -
                ((expected_units - 1) * c_partial_penalty_per_tail_syllable) -
                (appended_count_local * c_append_order_penalty));
            insert_display_candidate(partial_candidate_local, '',
                Length(m_candidates));
            Inc(appended_count_local);
        end;
    end;

    function top_display_candidate_can_use_long_fast_display_local: Boolean;
    var
        top_candidate_local: TncCandidate;
        top_text_local: string;
        top_path_local: string;
        tail_comment_local: string;
        tail_key_local: string;
        support_score_local: Integer;
        support_segments_local: Integer;
        text_units_local: Integer;
    begin
        Result := False;
        if (expected_units < 5) or
            (Length(m_candidates) = 0) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_key) > 0) then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        top_text_local := Trim(top_candidate_local.text);
        if top_text_local = '' then
        begin
            Exit;
        end;

        text_units_local := get_candidate_text_unit_count(top_text_local);
        if (text_units_local < expected_units - 2) or
            (text_units_local > expected_units) then
        begin
            Exit;
        end;

        if (Trim(top_candidate_local.comment) = '') and
            (text_units_local = expected_units) and
            is_problematic_single_char_chain_candidate_for_query(
            normalized_pinyin, top_candidate_local) then
        begin
            Exit;
        end;

        tail_comment_local := Trim(top_candidate_local.comment);
        tail_key_local := normalize_pinyin_text(tail_comment_local);
        if (tail_key_local <> '') and
            ((Length(tail_key_local) > 8) or
            (tail_key_local <> tail_comment_local)) then
        begin
            Exit;
        end;
        if tail_key_local <> '' then
        begin
            Exit(True);
        end;

        if (text_units_local = expected_units) and
            is_full_pinyin_key(normalized_pinyin) and
            (top_candidate_local.has_dict_weight or
            (top_candidate_local.score >= 20000)) then
        begin
            Exit(True);
        end;

        top_path_local := get_segment_path_for_candidate(top_candidate_local, 0);
        if top_path_local = '' then
        begin
            top_path_local := infer_segment_path_for_query_text_with_score(
                normalized_pinyin, top_text_local, support_score_local,
                support_segments_local);
        end;
        Result := top_path_local <> '';
    end;

    function has_admitted_short_complete_model_path_local: Boolean;
    var
        idx_local: Integer;
        text_local: string;
    begin
        Result := False;
        if (expected_units < 2) or (expected_units > 4) then Exit;
        for idx_local := 0 to Min(31, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx_local].comment) <> '' then Continue;
            text_local := Trim(m_candidates[idx_local].text);
            if get_candidate_text_unit_count(text_local) <> expected_units then
                Continue;
            case expected_units of
                2: Result := is_current_short_two_single_pair_candidate_supported(
                    normalized_pinyin, text_local);
                3: Result := is_current_short_three_exact_pair_candidate_supported(
                    normalized_pinyin, text_local);
                4: Result := (m_candidates[idx_local].display_kind = cdk_lm_compound) and
                    display_short_four_two_exact_path_is_supported_local(
                    m_candidates[idx_local]);
            end;
            if Result then Exit;
        end;
    end;

    function top_display_candidate_can_use_short_prefix_fast_display_local:
        Boolean;
    const
        c_min_short_prefix_fast_dict_weight = 300;
        c_probe_limit = 8;
    var
        idx_local: Integer;
        probe_candidate_local: TncCandidate;
        top_text_local: string;
        split_head_local: string;
        split_tail_local: string;
        tail_comment_local: string;
        tail_key_local: string;
        text_units_local: Integer;
        head_key_local: string;
        standalone_tail_key_local: string;
        saw_tail_candidate_local: Boolean;
        allow_lower_tail_probe_local: Boolean;

        procedure note_short_prefix_fast_reject_local(const reason: string);
        begin
            if not m_config.debug_mode then
            begin
                Exit;
            end;
            if m_last_lookup_debug_extra <> '' then
            begin
                m_last_lookup_debug_extra := m_last_lookup_debug_extra + ' ';
            end;
            m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                'spf=' + reason;
        end;

        function candidate_can_use_short_prefix_fast_local(
            const candidate_value: TncCandidate): Boolean;
        begin
            Result := False;
            top_text_local := Trim(candidate_value.text);
            tail_comment_local := Trim(candidate_value.comment);
            if (tail_comment_local = '') and
                split_trailing_ascii_candidate(top_text_local, split_head_local,
                split_tail_local) then
            begin
                top_text_local := Trim(split_head_local);
                tail_comment_local := Trim(split_tail_local);
            end;
            if (top_text_local = '') or (tail_comment_local = '') then
            begin
                Exit;
            end;
            saw_tail_candidate_local := True;

            tail_key_local := normalize_pinyin_text(tail_comment_local);
            if (tail_key_local = '') or (tail_key_local <> tail_comment_local) or
                (Length(tail_key_local) > 8) then
            begin
                Exit;
            end;

            text_units_local := get_candidate_text_unit_count(top_text_local);
            if (text_units_local <= 0) or (text_units_local >= expected_units) then
            begin
                Exit;
            end;

            head_key_local := build_display_query_key(0, text_units_local);
            if head_key_local = '' then
            begin
                Exit;
            end;

            if text_units_local = 1 then
            begin
                Result := m_dictionary.single_char_matches_pinyin(head_key_local,
                    top_text_local);
            end
            else
            begin
                Result := display_exact_key_has_text(head_key_local, top_text_local) or
                    m_dictionary.is_base_entry(head_key_local, top_text_local) or
                    m_dictionary.is_user_entry(head_key_local, top_text_local);
                if (not Result) and
                    (candidate_value.dict_weight >=
                    c_min_short_prefix_fast_dict_weight) then
                begin
                    Result := True;
                end;
            end;
        end;
    begin
        Result := False;
        if (expected_units < 2) or (expected_units > 4) or
            (Length(m_candidates) = 0) or (m_dictionary = nil) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_key) > 0) then
        begin
            note_short_prefix_fast_reject_local('guard');
            Exit;
        end;
        // A prefix-only display shortcut must not reinterpret an admitted model
        // path as untrusted composition, even if its seed used a prefix shortcut.
        if has_admitted_short_complete_model_path_local then
        begin
            note_short_prefix_fast_reject_local('modelpath');
            Exit;
        end;
        if (normalized_pinyin = 'naer') or (normalized_pinyin = 'ner') or
            (normalized_pinyin = 'qunaer') or (normalized_pinyin = 'qner') or
            (normalized_pinyin = 'nli') or (normalized_pinyin = 'qnli') then
        begin
            note_short_prefix_fast_reject_local('location');
            Exit;
        end;
        if (expected_units = 4) and (Length(syllables) = expected_units) then
        begin
            standalone_tail_key_local := normalize_pinyin_text(
                syllables[High(syllables)].text);
            if (standalone_tail_key_local = 'de') or
                (standalone_tail_key_local = 'le') or
                (standalone_tail_key_local = 'zhe') or
                (standalone_tail_key_local = 'la') or
                (standalone_tail_key_local = 'ba') or
                (standalone_tail_key_local = 'ma') or
                (standalone_tail_key_local = 'a') then
            begin
                note_short_prefix_fast_reject_local('particle');
                Exit;
            end;
        end;

        saw_tail_candidate_local := False;
        probe_candidate_local := m_candidates[0];
        if candidate_can_use_short_prefix_fast_local(probe_candidate_local) then
        begin
            Result := True;
            Exit;
        end;

        allow_lower_tail_probe_local := False;
        if (not saw_tail_candidate_local) and
            (m_last_lookup_prefix_partial_fast or
            (Pos('shortprefixraw=1', m_last_lookup_debug_extra) > 0) or
            (Pos('short4prefixraw=1', m_last_lookup_debug_extra) > 0) or
            (Pos('prefixpartialfast=1', m_last_lookup_debug_extra) > 0)) then
        begin
            top_text_local := Trim(probe_candidate_local.text);
            tail_comment_local := Trim(probe_candidate_local.comment);
            if (tail_comment_local = '') and
                (top_text_local <> '') and
                (get_candidate_text_unit_count(top_text_local) >=
                expected_units) then
            begin
                allow_lower_tail_probe_local := True;
            end;
        end;

        if allow_lower_tail_probe_local then
        begin
            for idx_local := 1 to Min(c_probe_limit - 1, High(m_candidates)) do
            begin
                probe_candidate_local := m_candidates[idx_local];
                if candidate_can_use_short_prefix_fast_local(
                    probe_candidate_local) then
                begin
                    Result := True;
                    Exit;
                end;
            end;
        end;

        if saw_tail_candidate_local then
        begin
            note_short_prefix_fast_reject_local('exact');
        end
        else
        begin
            note_short_prefix_fast_reject_local('notail');
        end;
    end;

    procedure promote_best_short_prefix_fast_candidate_local;
    var
        idx_local: Integer;
        best_idx_local: Integer;
        best_rank_local: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        split_head_local: string;
        split_tail_local: string;
        candidate_units_local: Integer;
        head_key_local: string;
        tail_key_local: string;
        rank_local: Integer;
        moved_candidate_local: TncCandidate;
        moved_path_local: string;
        move_idx_local: Integer;
    begin
        if (expected_units < 2) or (expected_units > 4) or
            (Length(m_candidates) <= 1) or (m_dictionary = nil) or
            (Pos('''', m_composition_text) > 0) or
            (Pos('''', m_last_lookup_key) > 0) then
        begin
            Exit;
        end;

        if has_admitted_short_complete_model_path_local then Exit;

        best_idx_local := -1;
        best_rank_local := Low(Integer);
        for idx_local := 0 to Min(31, High(m_candidates)) do
        begin
            candidate_text_local := Trim(m_candidates[idx_local].text);
            candidate_tail_local := Trim(m_candidates[idx_local].comment);
            if (candidate_tail_local = '') and
                split_trailing_ascii_candidate(candidate_text_local,
                split_head_local, split_tail_local) then
            begin
                candidate_text_local := Trim(split_head_local);
                candidate_tail_local := Trim(split_tail_local);
            end;
            if (candidate_text_local = '') or (candidate_tail_local = '') then
            begin
                Continue;
            end;

            tail_key_local := normalize_pinyin_text(candidate_tail_local);
            if (tail_key_local = '') or (tail_key_local <> candidate_tail_local) or
                (Length(tail_key_local) > 8) then
            begin
                Continue;
            end;

            candidate_units_local := get_candidate_text_unit_count(candidate_text_local);
            if (candidate_units_local < 2) or
                (candidate_units_local >= expected_units) then
            begin
                Continue;
            end;

            head_key_local := build_display_query_key(0, candidate_units_local);
            if (head_key_local = '') or
                (not (display_exact_key_has_text(head_key_local,
                candidate_text_local) or m_dictionary.is_base_entry(
                head_key_local, candidate_text_local) or
                m_dictionary.is_user_entry(head_key_local,
                candidate_text_local))) then
            begin
                Continue;
            end;

            rank_local := m_candidates[idx_local].dict_weight;
            if m_candidates[idx_local].source = cs_user then
            begin
                Inc(rank_local, 100000);
            end;
            if rank_local > best_rank_local then
            begin
                best_rank_local := rank_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local <= 0 then
        begin
            Exit;
        end;

        moved_candidate_local := m_candidates[best_idx_local];
        moved_path_local := '';
        if best_idx_local < Length(m_candidate_segment_paths) then
        begin
            moved_path_local := m_candidate_segment_paths[best_idx_local];
        end;

        for move_idx_local := best_idx_local downto 1 do
        begin
            m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
            if move_idx_local < Length(m_candidate_segment_paths) then
            begin
                if move_idx_local - 1 < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx_local] :=
                        m_candidate_segment_paths[move_idx_local - 1];
                end
                else
                begin
                    m_candidate_segment_paths[move_idx_local] := '';
                end;
            end;
        end;
        m_candidates[0] := moved_candidate_local;
        if Length(m_candidate_segment_paths) > 0 then
        begin
            m_candidate_segment_paths[0] := moved_path_local;
        end;
    end;

    function has_strong_short_complete_candidate_for_prefix_fast_local: Boolean;
    const
        c_probe_limit = 8;
        c_min_complete_score = 15000;
        c_min_override_prefix_rank = 1200;
    var
        idx_local: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        split_head_local: string;
        split_tail_local: string;
        candidate_units_local: Integer;
        head_key_local: string;
        tail_key_local: string;
        prefix_rank_local: Integer;
    begin
        Result := False;
        if (expected_units < 2) or (expected_units > 3) or
            (m_dictionary = nil) then
        begin
            Exit;
        end;

        for idx_local := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            candidate_text_local := Trim(m_candidates[idx_local].text);
            candidate_tail_local := Trim(m_candidates[idx_local].comment);
            if (candidate_tail_local = '') and
                split_trailing_ascii_candidate(candidate_text_local,
                split_head_local, split_tail_local) then
            begin
                candidate_text_local := Trim(split_head_local);
                candidate_tail_local := Trim(split_tail_local);
            end;

            if (candidate_text_local = '') or (candidate_tail_local = '') then
            begin
                Continue;
            end;

            tail_key_local := normalize_pinyin_text(candidate_tail_local);
            if (tail_key_local = '') or (tail_key_local <> candidate_tail_local) or
                (Length(tail_key_local) > 8) then
            begin
                Continue;
            end;

            candidate_units_local := get_candidate_text_unit_count(
                candidate_text_local);
            if (candidate_units_local < 2) or
                (candidate_units_local >= expected_units) then
            begin
                Continue;
            end;

            head_key_local := build_display_query_key(0, candidate_units_local);
            if (head_key_local = '') or
                (not (display_exact_key_has_text(head_key_local,
                candidate_text_local) or m_dictionary.is_base_entry(
                head_key_local, candidate_text_local) or
                m_dictionary.is_user_entry(head_key_local,
                candidate_text_local))) then
            begin
                Continue;
            end;

            prefix_rank_local := m_candidates[idx_local].dict_weight;
            if m_candidates[idx_local].source = cs_user then
            begin
                Inc(prefix_rank_local, 100000);
            end;
            if (prefix_rank_local >= c_min_override_prefix_rank) and
                ((tail_key_local = 'g') or (tail_key_local = 'gu') or
                (tail_key_local = 'guo')) then
            begin
                Exit(False);
            end;
        end;

        for idx_local := 0 to Min(c_probe_limit - 1, High(m_candidates)) do
        begin
            if Trim(m_candidates[idx_local].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(m_candidates[idx_local].text);
            if (candidate_text_local <> '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                (m_candidates[idx_local].score >= c_min_complete_score) then
            begin
                Exit(True);
            end;
        end;
    end;

    procedure filter_short_prefix_fast_constructed_candidates_local;
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_text_local: string;
        candidate_tail_local: string;
        split_head_local: string;
        split_tail_local: string;
        candidate_units_local: Integer;
        head_key_local: string;
        keep_candidate_local: Boolean;
    begin
        if (m_dictionary = nil) or (Length(m_candidates) = 0) then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[in_idx_local].text);
            candidate_tail_local := Trim(m_candidates[in_idx_local].comment);
            if (candidate_tail_local = '') and
                split_trailing_ascii_candidate(candidate_text_local,
                split_head_local, split_tail_local) then
            begin
                candidate_text_local := Trim(split_head_local);
                candidate_tail_local := Trim(split_tail_local);
            end;

            keep_candidate_local := True;
            candidate_units_local :=
                get_candidate_text_unit_count(candidate_text_local);
            if (candidate_tail_local <> '') and (candidate_units_local >= 2) and
                (candidate_units_local < expected_units) and
                (not (is_fuzzy_pinyin_active and
                (m_candidates[in_idx_local].fuzzy_cost > 0))) then
            begin
                head_key_local := build_display_query_key(0,
                    candidate_units_local);
                keep_candidate_local :=
                    (alternative_exact_prefix_units(m_candidates[in_idx_local]) > 0) or
                    display_exact_key_has_text(head_key_local,
                    candidate_text_local) or
                    m_dictionary.is_base_entry(head_key_local,
                    candidate_text_local) or
                    m_dictionary.is_user_entry(head_key_local,
                    candidate_text_local);

            end;

            if not keep_candidate_local then
            begin
                Continue;
            end;

            if out_idx_local <> in_idx_local then
            begin
                m_candidates[out_idx_local] := m_candidates[in_idx_local];
                if out_idx_local < Length(m_candidate_segment_paths) then
                begin
                    if in_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[out_idx_local] :=
                            m_candidate_segment_paths[in_idx_local];
                    end
                    else
                    begin
                        m_candidate_segment_paths[out_idx_local] := '';
                    end;
                end;
            end;
            Inc(out_idx_local);
        end;

        if out_idx_local < Length(m_candidates) then
        begin
            SetLength(m_candidates, out_idx_local);
        end;
        if Length(m_candidate_segment_paths) > out_idx_local then
        begin
            SetLength(m_candidate_segment_paths, out_idx_local);
        end;
    end;

    procedure ensure_fuzzy_short_single_prefixes_visible_local;
    const
        c_max_fuzzy_single_prefix_reserve = 3;
    var
        page_limit_local: Integer;
        reserve_limit_local: Integer;
        fuzzy_in_page_local: Integer;
        missing_local: Integer;
        source_idx_local: Integer;
        target_idx_local: Integer;
        scan_idx_local: Integer;
        candidate_tmp_local: TncCandidate;
        path_tmp_local: string;

        function is_fuzzy_single_prefix_local(
            const candidate_value: TncCandidate): Boolean;
        var
            tail_units_local: Integer;
        begin
            Result := False;
            if (candidate_value.fuzzy_cost <= 0) or
                (Trim(candidate_value.comment) = '') or
                (get_candidate_text_unit_count(Trim(candidate_value.text)) <> 1) then
            begin
                Exit;
            end;

            tail_units_local := get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(Trim(candidate_value.comment)));
            Result := tail_units_local > 0;
            if Result and (expected_units > 0) then
            begin
                Result := 1 + tail_units_local = expected_units;
            end;
        end;

        function should_keep_page_slot_local(
            const candidate_value: TncCandidate): Boolean;
        begin
            Result := is_fuzzy_single_prefix_local(candidate_value) or
                ((candidate_value.fuzzy_cost > 0) and
                (Trim(candidate_value.comment) = ''));
        end;
    begin
        if (not is_fuzzy_pinyin_active) or (expected_units < 2) or
            (Length(m_candidates) <= 1) then
        begin
            Exit;
        end;

        page_limit_local := Min(get_candidate_page_size,
            Length(m_candidates));
        if page_limit_local <= 1 then
        begin
            Exit;
        end;
        reserve_limit_local := Min(c_max_fuzzy_single_prefix_reserve,
            page_limit_local - 1);

        fuzzy_in_page_local := 0;
        for scan_idx_local := 0 to page_limit_local - 1 do
        begin
            if is_fuzzy_single_prefix_local(m_candidates[scan_idx_local]) then
            begin
                Inc(fuzzy_in_page_local);
            end;
        end;
        missing_local := reserve_limit_local - fuzzy_in_page_local;
        if missing_local <= 0 then
        begin
            Exit;
        end;

        target_idx_local := page_limit_local - missing_local;
        while missing_local > 0 do
        begin
            while (target_idx_local < page_limit_local) and
                should_keep_page_slot_local(m_candidates[target_idx_local]) do
            begin
                Inc(target_idx_local);
            end;
            if target_idx_local >= page_limit_local then
            begin
                Break;
            end;

            source_idx_local := -1;
            for scan_idx_local := page_limit_local to High(m_candidates) do
            begin
                if is_fuzzy_single_prefix_local(m_candidates[scan_idx_local]) then
                begin
                    source_idx_local := scan_idx_local;
                    Break;
                end;
            end;
            if source_idx_local < 0 then
            begin
                Break;
            end;

            candidate_tmp_local := m_candidates[target_idx_local];
            m_candidates[target_idx_local] := m_candidates[source_idx_local];
            m_candidates[source_idx_local] := candidate_tmp_local;
            if (target_idx_local < Length(m_candidate_segment_paths)) and
                (source_idx_local < Length(m_candidate_segment_paths)) then
            begin
                path_tmp_local := m_candidate_segment_paths[target_idx_local];
                m_candidate_segment_paths[target_idx_local] :=
                    m_candidate_segment_paths[source_idx_local];
                m_candidate_segment_paths[source_idx_local] := path_tmp_local;
            end;
            Inc(target_idx_local);
            Dec(missing_local);
        end;
    end;

    procedure normalize_first_syllable_single_partial_order_local;
    var
        first_key_local: string;
        remaining_key_local: string;
        syllable_idx_local: Integer;
        candidate_idx_local: Integer;
        first_single_idx_local: Integer;
        best_single_idx_local: Integer;
        candidate_text_local: string;
        candidate_comment_local: string;
        candidate_weight_local: Integer;
        best_weight_local: Integer;
        moved_candidate_local: TncCandidate;
        moved_path_local: string;
        move_idx_local: Integer;
    begin
        if (m_page_index <> 0) or (m_dictionary = nil) or
            (expected_units < 2) or
            (expected_units > 3) or
            (Length(syllables) <> expected_units) or
            (Length(m_candidates) <= 1) then
        begin
            Exit;
        end;

        first_key_local := normalize_pinyin_text(syllables[0].text);
        if first_key_local = '' then
        begin
            Exit;
        end;

        remaining_key_local := '';
        for syllable_idx_local := 1 to High(syllables) do
        begin
            remaining_key_local := remaining_key_local +
                normalize_pinyin_text(syllables[syllable_idx_local].text);
        end;
        if remaining_key_local = '' then
        begin
            Exit;
        end;

        first_single_idx_local := -1;
        best_single_idx_local := -1;
        best_weight_local := Low(Integer);
        for candidate_idx_local := 0 to High(m_candidates) do
        begin
            candidate_text_local := Trim(m_candidates[candidate_idx_local].text);
            candidate_comment_local := normalize_pinyin_text(
                Trim(m_candidates[candidate_idx_local].comment));
            if (candidate_comment_local <> remaining_key_local) or
                (get_candidate_text_unit_count(candidate_text_local) <> 1) or
                (not m_dictionary.single_char_matches_pinyin(first_key_local,
                candidate_text_local)) then
            begin
                Continue;
            end;

            if first_single_idx_local < 0 then
            begin
                first_single_idx_local := candidate_idx_local;
            end;

            candidate_weight_local := m_candidates[candidate_idx_local].score;
            if m_candidates[candidate_idx_local].has_dict_weight and
                (m_candidates[candidate_idx_local].dict_weight >
                candidate_weight_local) then
            begin
                candidate_weight_local :=
                    m_candidates[candidate_idx_local].dict_weight;
            end;
            if m_candidates[candidate_idx_local].source = cs_user then
            begin
                Inc(candidate_weight_local, c_user_score_bonus);
            end;

            if candidate_weight_local > best_weight_local then
            begin
                best_weight_local := candidate_weight_local;
                best_single_idx_local := candidate_idx_local;
            end;
        end;

        if (first_single_idx_local < 0) or
            (best_single_idx_local <= first_single_idx_local) then
        begin
            Exit;
        end;

        moved_candidate_local := m_candidates[best_single_idx_local];
        moved_path_local := '';
        if best_single_idx_local < Length(m_candidate_segment_paths) then
        begin
            moved_path_local := m_candidate_segment_paths[best_single_idx_local];
        end;
        for move_idx_local := best_single_idx_local downto
            first_single_idx_local + 1 do
        begin
            m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
            if move_idx_local < Length(m_candidate_segment_paths) then
            begin
                if move_idx_local - 1 < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[move_idx_local] :=
                        m_candidate_segment_paths[move_idx_local - 1];
                end
                else
                begin
                    m_candidate_segment_paths[move_idx_local] := '';
                end;
            end;
        end;
        m_candidates[first_single_idx_local] := moved_candidate_local;
        if first_single_idx_local < Length(m_candidate_segment_paths) then
        begin
            m_candidate_segment_paths[first_single_idx_local] := moved_path_local;
        end;
    end;

    function display_short_complete_has_full_query_support(
        const candidate_value: TncCandidate; const text_value: string): Boolean;
    var
        prefix_results_local: TncCandidateList;
        prefix_idx_local: Integer;
        text_units_local: Integer;
        transition_particle_path_local: string;
        transition_particle_evidence_local: Integer;

        function predictive_prefix_units_allowed_local: Boolean;
        begin
            Result := False;
            if (text_units_local <= 0) or (expected_units <= 0) then
            begin
                Exit;
            end;

            if (expected_units <= 3) and (text_units_local = expected_units) then
            begin
                Exit(True);
            end;

            if (expected_units = 4) and (text_units_local = 3) then
            begin
                Exit(True);
            end;
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (normalized_pinyin = '') or
            (text_value = '') then
        begin
            Exit;
        end;

        if display_exact_key_has_text(normalized_pinyin, text_value) then
        begin
            Exit(True);
        end;

        if m_dictionary.is_user_entry(normalized_pinyin, text_value) then
        begin
            Exit(True);
        end;

        // Four-syllable short queries may have a reliable two-word path even
        // when the complete text is not itself a dictionary entry. Reuse the
        // same exact-pair gate as the candidate filter so paging cannot hide a
        // path that lookup already accepted.
        if (expected_units = 4) and (Length(syllables) = 4) and
            (Trim(candidate_value.comment) = '') and
            (get_candidate_text_unit_count(text_value) = expected_units) and
            display_short_four_two_exact_path_is_supported_local(
            candidate_value) then
        begin
            Exit(True);
        end;

        if (expected_units = 4) and (Length(syllables) = 4) and
            (Trim(candidate_value.comment) = '') and
            (get_candidate_text_unit_count(text_value) = expected_units) and
            get_short_four_transition_particle_path_evidence(
            normalized_pinyin, text_value, transition_particle_path_local,
            transition_particle_evidence_local) then
        begin
            Exit(True);
        end;

        text_units_local := get_candidate_text_unit_count(text_value);
        if (Trim(candidate_value.comment) <> '') or
            (not predictive_prefix_units_allowed_local) or
            (not m_dictionary.lookup_full_pinyin_prefix(normalized_pinyin,
            prefix_results_local)) then
        begin
            Exit;
        end;

        for prefix_idx_local := 0 to High(prefix_results_local) do
        begin
            if (Trim(prefix_results_local[prefix_idx_local].comment) = '') and
                SameText(Trim(prefix_results_local[prefix_idx_local].text),
                text_value) then
            begin
                Exit(True);
            end;
        end;
    end;

    function join_display_units_local(const units_value: TArray<string>;
        const start_idx: Integer; const end_idx: Integer): string;
    var
        unit_idx: Integer;
    begin
        Result := '';
        if (start_idx < 0) or (end_idx < start_idx) or
            (end_idx >= Length(units_value)) then
        begin
            Exit;
        end;
        for unit_idx := start_idx to end_idx do
        begin
            Result := Result + units_value[unit_idx];
        end;
    end;

    function display_short_complete_matches_fixed_prefix_rule(
        const query_prefix: string; const text_prefix: string;
        const text_value: string): Boolean;
    var
        text_units: TArray<string>;
        tail_key: string;
        tail_text: string;
    begin
        Result := False;
        if (normalized_pinyin = '') or
            (Length(normalized_pinyin) <= Length(query_prefix)) or
            (Copy(normalized_pinyin, 1, Length(query_prefix)) <>
            query_prefix) then
        begin
            Exit;
        end;

        text_units := split_text_units(text_value);
        if (Length(text_units) < 2) or
            (not SameText(text_units[0], text_prefix)) then
        begin
            Exit;
        end;

        tail_key := Copy(normalized_pinyin, Length(query_prefix) + 1, MaxInt);
        tail_text := join_display_units_local(text_units, 1, High(text_units));
        Result := display_exact_key_has_text(tail_key, tail_text) or
            ((m_dictionary <> nil) and
            m_dictionary.is_user_entry(tail_key, tail_text));
    end;

    function display_short_complete_matches_particle_suffix_rule(
        const query_suffix: string; const text_suffix: string;
        const text_value: string): Boolean;
    var
        text_units: TArray<string>;
        suffix_units: Integer;
        head_key: string;
        head_text: string;
    begin
        Result := False;
        if (normalized_pinyin = '') or
            (Length(normalized_pinyin) <= Length(query_suffix)) or
            (Copy(normalized_pinyin,
            Length(normalized_pinyin) - Length(query_suffix) + 1,
            Length(query_suffix)) <> query_suffix) then
        begin
            Exit;
        end;

        text_units := split_text_units(text_value);
        suffix_units := get_candidate_text_unit_count(text_suffix);
        if (suffix_units <= 0) or (Length(text_units) <= suffix_units) or
            (not SameText(join_display_units_local(text_units,
            Length(text_units) - suffix_units, High(text_units)), text_suffix)) then
        begin
            Exit;
        end;

        head_key := Copy(normalized_pinyin, 1,
            Length(normalized_pinyin) - Length(query_suffix));
        head_text := join_display_units_local(text_units, 0,
            High(text_units) - suffix_units);
        Result := display_exact_key_has_text(head_key, head_text) or
            ((m_dictionary <> nil) and
            m_dictionary.is_user_entry(head_key, head_text));
    end;

    function display_short_complete_matches_dehao_rule_text(
        const text_value: string): Boolean;
    var
        text_units: TArray<string>;
        head_key: string;
        head_text: string;
    begin
        Result := False;
        if (normalized_pinyin = '') or
            (Length(normalized_pinyin) <= Length('dehao')) or
            (not SameText(Copy(normalized_pinyin,
            Length(normalized_pinyin) - Length('dehao') + 1,
            Length('dehao')), 'dehao')) then
        begin
            Exit;
        end;

        text_units := split_text_units(text_value);
        if (Length(text_units) < 3) or
            (not SameText(text_units[High(text_units) - 1],
            string(Char($5F97)))) or
            (not SameText(text_units[High(text_units)],
            string(Char($597D)))) then
        begin
            Exit;
        end;

        head_key := Copy(normalized_pinyin, 1,
            Length(normalized_pinyin) - Length('hao'));
        head_text := join_display_units_local(text_units, 0,
            High(text_units) - 1);
        Result := display_exact_key_has_text(head_key, head_text) or
            ((m_dictionary <> nil) and
            m_dictionary.is_user_entry(head_key, head_text));
    end;

    function display_short_complete_is_allowed_rule_text(
        const text_value: string): Boolean;
    begin
        Result :=
            display_short_complete_matches_fixed_prefix_rule('wo',
            string(Char($6211)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('ni',
            string(Char($4F60)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('zui',
            string(Char($6700)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('bu',
            string(Char($4E0D)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('hen',
            string(Char($5F88)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('jiu',
            string(Char($5C31)), text_value) or
            display_short_complete_matches_fixed_prefix_rule('qing',
            string(Char($8BF7)), text_value) or
            display_short_complete_matches_particle_suffix_rule('de',
            string(Char($7684)), text_value) or
            display_short_complete_matches_particle_suffix_rule('le',
            string(Char($4E86)), text_value) or
            display_short_complete_matches_particle_suffix_rule('zhe',
            string(Char($7740)), text_value) or
            display_short_complete_matches_particle_suffix_rule('la',
            string(Char($5566)), text_value) or
            display_short_complete_matches_particle_suffix_rule('ma',
            string(Char($5417)), text_value) or
            display_short_complete_matches_particle_suffix_rule('ba',
            string(Char($5427)), text_value) or
            display_short_complete_matches_particle_suffix_rule('a',
            string(Char($554A)), text_value) or
            display_short_complete_matches_dehao_rule_text(text_value) or
            ((normalized_pinyin = 'dema') and SameText(text_value,
            string(Char($7684)) + string(Char($5417)))) or
            ((normalized_pinyin = 'deba') and SameText(text_value,
            string(Char($7684)) + string(Char($5427)))) or
            ((normalized_pinyin = 'dele') and SameText(text_value,
            string(Char($7684)) + string(Char($4E86)))) or
            ((normalized_pinyin = 'dehao') and SameText(text_value,
            string(Char($5F97)) + string(Char($597D)))) or
            ((normalized_pinyin = 'leba') and SameText(text_value,
            string(Char($4E86)) + string(Char($5427)))) or
            ((normalized_pinyin = 'lema') and SameText(text_value,
            string(Char($4E86)) + string(Char($5417)))) or
            (((normalized_pinyin = 'naer') or
            (normalized_pinyin = 'ner')) and SameText(text_value,
            string(Char($54EA)) + string(Char($513F)))) or
            (((normalized_pinyin = 'qunaer') or
            (normalized_pinyin = 'qner')) and SameText(text_value,
            string(Char($53BB)) + string(Char($54EA)) +
            string(Char($513F)))) or
            ((normalized_pinyin = 'nli') and SameText(text_value,
            string(Char($54EA)) + string(Char($91CC)))) or
            ((normalized_pinyin = 'qnli') and SameText(text_value,
            string(Char($53BB)) + string(Char($54EA)) +
            string(Char($91CC))));
    end;

    function display_short_complete_matches_tail_phrase_rule(
        const query_suffix: string; const text_suffix: string;
        const text_value: string): Boolean;
    var
        text_units: TArray<string>;
        head_key: string;
        head_text: string;
        suffix_units: Integer;
    begin
        Result := False;
        if (normalized_pinyin = '') or
            (Length(normalized_pinyin) <= Length(query_suffix)) or
            (Copy(normalized_pinyin,
            Length(normalized_pinyin) - Length(query_suffix) + 1,
            Length(query_suffix)) <> query_suffix) then
        begin
            Exit;
        end;

        text_units := split_text_units(text_value);
        suffix_units := get_candidate_text_unit_count(text_suffix);
        if (Length(text_units) <= suffix_units) or
            (not SameText(join_display_units_local(text_units,
            Length(text_units) - suffix_units, High(text_units)),
            text_suffix)) then
        begin
            Exit;
        end;

        head_key := Copy(normalized_pinyin, 1,
            Length(normalized_pinyin) - Length(query_suffix));
        head_text := join_display_units_local(text_units, 0,
            High(text_units) - suffix_units);
        Result := display_exact_key_has_text(head_key, head_text) or
            ((m_dictionary <> nil) and
            m_dictionary.is_user_entry(head_key, head_text));
    end;

    function display_candidate_should_drop_short_nonlexicon_complete(
        const candidate_value: TncCandidate; const source_index: Integer): Boolean;
    var
        text_value: string;
        text_units: Integer;
    begin
        Result := False;
        if (expected_units < 3) or (expected_units > 4) or
            (m_dictionary = nil) or (normalized_pinyin = '') or
            (not is_full_pinyin_key(normalized_pinyin)) or
            (Trim(candidate_value.comment) <> '') then
        begin
            Exit;
        end;

        text_value := Trim(candidate_value.text);
        text_units := get_candidate_text_unit_count(text_value);
        if text_value = '' then
        begin
            Exit;
        end;
        if is_current_short_exact_lexicon_completion(normalized_pinyin,
            text_value) then
        begin
            Exit;
        end;

        // This candidate was admitted from two exact dictionary segments by
        // the short three-syllable transition gate. Reuse that single verdict
        // instead of treating the same path as an arbitrary composition here.
        if is_current_short_three_exact_pair_candidate_supported(
            normalized_pinyin, text_value) then
        begin
            Exit;
        end;

        if display_short_complete_has_full_query_support(candidate_value,
            text_value) or
            display_short_complete_is_allowed_rule_text(text_value) or
            display_candidate_is_supported_pronoun_connector_tail_complete_local(
            candidate_value) then
        begin
            Exit;
        end;

        if text_units <> expected_units then
        begin
            Result := True;
            Exit;
        end;

        if display_short_complete_matches_tail_phrase_rule('dema',
            string(Char($7684)) + string(Char($5417)), text_value) or
            display_short_complete_matches_tail_phrase_rule('deba',
            string(Char($7684)) + string(Char($5427)), text_value) or
            display_short_complete_matches_tail_phrase_rule('dele',
            string(Char($7684)) + string(Char($4E86)), text_value) or
            display_short_complete_matches_tail_phrase_rule('dehao',
            string(Char($5F97)) + string(Char($597D)), text_value) or
            display_short_complete_matches_tail_phrase_rule('leba',
            string(Char($4E86)) + string(Char($5427)), text_value) or
            display_short_complete_matches_tail_phrase_rule('lema',
            string(Char($4E86)) + string(Char($5417)), text_value) then
        begin
            Exit;
        end;

        Result := True;
    end;

    function display_candidate_should_drop_short_invalid_partial(
        const candidate_value: TncCandidate): Boolean;
    var
        tail_syllables: TncPinyinParseResult;
        consumed_units: Integer;
        text_units: Integer;
    begin
        Result := False;
        if umlaut_raw_prefix_units(candidate_value) > 0 then Exit;
        if (expected_units < 3) or (expected_units > 6) or
            (normalized_pinyin = '') or
            (not is_full_pinyin_key(normalized_pinyin)) or
            (Trim(candidate_value.comment) = '') then
        begin
            Exit;
        end;

        tail_syllables := get_effective_compact_pinyin_syllables(
            normalize_pinyin_text(candidate_value.comment));
        if Length(tail_syllables) <= 0 then
        begin
            Exit;
        end;

        consumed_units := expected_units - Length(tail_syllables);
        text_units := get_candidate_text_unit_count(Trim(candidate_value.text));
        Result := (consumed_units <= 0) or (text_units > consumed_units);
    end;

    procedure promote_strong_short_four_two_exact_path_visible_local(
        var candidates_value: TncCandidateList;
        var source_indices_value: TArray<Integer>);
    const
        c_strong_path_top_evidence = 1000;
    var
        idx_local: Integer;
        move_idx_local: Integer;
        best_idx_local: Integer;
        best_evidence_local: Integer;
        evidence_local: Integer;
        encoded_path_local: string;
        picked_candidate_local: TncCandidate;
        picked_source_idx_local: Integer;
        exact_results_local: TncCandidateList;

        function is_full_query_exact_text_local(
            const text_value: string): Boolean;
        var
            exact_candidate_idx_local: Integer;
        begin
            Result := False;
            for exact_candidate_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_candidate_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_candidate_idx_local].text),
                    Trim(text_value)) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (expected_units <> 4) or (Length(candidates_value) <= 1) or
            (Length(source_indices_value) <> Length(candidates_value)) then
        begin
            Exit;
        end;

        // With full-query exacts, the model may only reorder another exact.
        // A composed non-exact path never crosses the exact boundary.
        SetLength(exact_results_local, 0);
        lookup_display_exact_cached(normalized_pinyin, exact_results_local);
        for idx_local := 0 to High(exact_results_local) do
        begin
            if (exact_results_local[idx_local].source = cs_user) and
                (Trim(exact_results_local[idx_local].comment) = '') then
            begin
                Exit;
            end;
        end;

        best_idx_local := -1;
        best_evidence_local := 0;
        for idx_local := 0 to High(candidates_value) do
        begin
            if (Trim(candidates_value[idx_local].comment) <> '') or
                (get_candidate_text_unit_count(
                Trim(candidates_value[idx_local].text)) <> 4) or
                ((Length(exact_results_local) > 0) and
                (not is_full_query_exact_text_local(
                Trim(candidates_value[idx_local].text)))) or
                (not get_short_four_two_exact_path_evidence(
                normalized_pinyin, Trim(candidates_value[idx_local].text),
                encoded_path_local, evidence_local)) then
            begin
                Continue;
            end;
            if (best_idx_local < 0) or
                (evidence_local > best_evidence_local) or
                ((evidence_local = best_evidence_local) and
                (candidates_value[idx_local].score >
                candidates_value[best_idx_local].score)) then
            begin
                best_idx_local := idx_local;
                best_evidence_local := evidence_local;
            end;
        end;
        if (best_idx_local <= 0) or
            ((Length(exact_results_local) > 0) and
            (best_evidence_local < c_strong_path_top_evidence)) then
        begin
            Exit;
        end;

        picked_candidate_local := candidates_value[best_idx_local];
        picked_source_idx_local := source_indices_value[best_idx_local];
        for move_idx_local := best_idx_local downto 1 do
        begin
            candidates_value[move_idx_local] :=
                candidates_value[move_idx_local - 1];
            source_indices_value[move_idx_local] :=
                source_indices_value[move_idx_local - 1];
        end;
        candidates_value[0] := picked_candidate_local;
        source_indices_value[0] := picked_source_idx_local;
    end;

    procedure build_current_page_result;
    var
        page_idx: Integer;
        source_idx: Integer;
        complete_visible_texts: TDictionary<string, Boolean>;
        emitted_visible_texts: TDictionary<string, Boolean>;
        candidate_key: string;
        visible_source_indices: TArray<Integer>;
        keep_explicit_prefix_partial: Boolean;
        keep_protected_full_exact: Boolean;
        protected_full_query_exacts: TncCandidateList;
        short_exact_ranked_texts: TArray<string>;
        has_supported_transition_top_local: Boolean;
        supported_transition_top_candidate_local: TncCandidate;
        supported_transition_top_path_local: string;

        procedure insert_umlaut_raw_prefixes_local;
        var
            idx: Integer;
            insert_idx: Integer;
            prefix_units: Integer;
            existing_units: Integer;
        begin
            prepare_umlaut_raw_prefixes;
            for idx := 0 to High(umlaut_raw_prefixes) do
            begin
                if find_display_candidate(umlaut_raw_prefixes[idx].text,
                    umlaut_raw_prefixes[idx].comment) >= 0 then Continue;
                prefix_units := get_candidate_text_unit_count(umlaut_raw_prefixes[idx].text);
                insert_idx := 0;
                while insert_idx < Length(m_candidates) do
                begin
                    if Trim(m_candidates[insert_idx].comment) <> '' then
                    begin
                        existing_units := get_candidate_text_unit_count(m_candidates[insert_idx].text);
                        if existing_units < prefix_units then Break;
                        if (existing_units = prefix_units) and
                            (umlaut_raw_prefixes[idx].source = m_candidates[insert_idx].source) and
                            (umlaut_raw_prefixes[idx].score > m_candidates[insert_idx].score) then Break;
                    end;
                    Inc(insert_idx);
                end;
                // Preserve complete candidates and the source-index/page mapping.
                insert_display_candidate(umlaut_raw_prefixes[idx], '', insert_idx);
            end;
        end;

        procedure insert_short_exact_lexicon_completion_local;
        var
            candidate_idx_local: Integer;
            completion_idx_local: Integer;
            insert_idx_local: Integer;
            move_idx_local: Integer;
            old_count_local: Integer;
            insert_count_local: Integer;
            total_limit_local: Integer;
            candidate_text_local: string;
            insert_candidates_local: TncCandidateList;

            function candidate_already_present_local(
                const text_value_local: string): Boolean;
            var
                existing_idx_local: Integer;
            begin
                Result := False;
                for existing_idx_local := 0 to High(m_candidates) do
                begin
                    if (Trim(m_candidates[existing_idx_local].comment) = '') and
                        SameText(Trim(m_candidates[existing_idx_local].text),
                        text_value_local) then
                    begin
                        Exit(True);
                    end;
                end;
                for existing_idx_local := 0 to High(insert_candidates_local) do
                begin
                    if SameText(Trim(insert_candidates_local[
                        existing_idx_local].text), text_value_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (not SameText(normalized_pinyin,
                m_short_exact_lexicon_completion_query)) or
                (Length(m_short_exact_lexicon_completion_candidates) = 0) then
            begin
                Exit;
            end;

            SetLength(insert_candidates_local, 0);
            for completion_idx_local := 0 to
                High(m_short_exact_lexicon_completion_candidates) do
            begin
                candidate_text_local := Trim(
                    m_short_exact_lexicon_completion_candidates[
                    completion_idx_local].text);
                if (candidate_text_local = '') or
                    (not is_current_short_exact_lexicon_completion(
                    normalized_pinyin, candidate_text_local)) or
                    candidate_already_present_local(candidate_text_local) then
                begin
                    Continue;
                end;
                candidate_idx_local := Length(insert_candidates_local);
                SetLength(insert_candidates_local, candidate_idx_local + 1);
                insert_candidates_local[candidate_idx_local] :=
                    m_short_exact_lexicon_completion_candidates[
                    completion_idx_local];
            end;
            insert_count_local := Length(insert_candidates_local);
            if insert_count_local = 0 then
            begin
                Exit;
            end;

            insert_idx_local := 0;
            // Predictive extensions follow every full exact match and precede
            // shorter partials, so they cannot alter the existing exact order.
            while (insert_idx_local < Length(m_candidates)) and
                (Trim(m_candidates[insert_idx_local].comment) = '') and
                (get_candidate_text_unit_count(
                Trim(m_candidates[insert_idx_local].text)) = expected_units) do
            begin
                Inc(insert_idx_local);
            end;

            old_count_local := Length(m_candidates);
            if Length(m_candidate_segment_paths) < old_count_local then
            begin
                SetLength(m_candidate_segment_paths, old_count_local);
            end;
            SetLength(m_candidates, old_count_local + insert_count_local);
            SetLength(m_candidate_segment_paths,
                old_count_local + insert_count_local);
            for move_idx_local := old_count_local - 1 downto insert_idx_local do
            begin
                m_candidates[move_idx_local + insert_count_local] :=
                    m_candidates[move_idx_local];
                m_candidate_segment_paths[
                    move_idx_local + insert_count_local] :=
                    m_candidate_segment_paths[move_idx_local];
            end;
            for completion_idx_local := 0 to insert_count_local - 1 do
            begin
                m_candidates[insert_idx_local + completion_idx_local] :=
                    insert_candidates_local[completion_idx_local];
                m_candidate_segment_paths[
                    insert_idx_local + completion_idx_local] := '';
            end;
            total_limit_local := get_total_candidate_limit;
            if (total_limit_local > 0) and
                (Length(m_candidates) > total_limit_local) then
            begin
                SetLength(m_candidates, total_limit_local);
                SetLength(m_candidate_segment_paths, total_limit_local);
            end;
        end;

        procedure capture_supported_transition_top_local;
        begin
            has_supported_transition_top_local := False;
            supported_transition_top_path_local := '';
            if (m_page_index <> 0) or (Length(m_candidates) <= 0) or
                (Trim(m_candidates[0].comment) <> '') or
                ((not is_current_short_two_single_pair_candidate_supported(
                normalized_pinyin, Trim(m_candidates[0].text))) and
                (not is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, Trim(m_candidates[0].text)))) then
            begin
                Exit;
            end;

            has_supported_transition_top_local := True;
            supported_transition_top_candidate_local := m_candidates[0];
            if Length(m_candidate_segment_paths) > 0 then
            begin
                supported_transition_top_path_local :=
                    m_candidate_segment_paths[0];
            end;
        end;

        procedure restore_supported_transition_top_local;
        var
            candidate_idx_local: Integer;
            move_idx_local: Integer;
        begin
            if not has_supported_transition_top_local then
            begin
                Exit;
            end;

            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                if (Trim(m_candidates[candidate_idx_local].comment) = '') and
                    SameText(Trim(m_candidates[candidate_idx_local].text),
                    Trim(supported_transition_top_candidate_local.text)) then
                begin
                    if candidate_idx_local > 0 then
                    begin
                        force_move_display_candidate_to_index(
                            candidate_idx_local, 0);
                    end;
                    m_candidates[0].display_kind := cdk_lm_compound;
                    Exit;
                end;
            end;

            SetLength(m_candidates, Length(m_candidates) + 1);
            SetLength(m_candidate_segment_paths, Length(m_candidates));
            for move_idx_local := High(m_candidates) downto 1 do
            begin
                m_candidates[move_idx_local] :=
                    m_candidates[move_idx_local - 1];
                m_candidate_segment_paths[move_idx_local] :=
                    m_candidate_segment_paths[move_idx_local - 1];
            end;
            m_candidates[0] := supported_transition_top_candidate_local;
            m_candidates[0].display_kind := cdk_lm_compound;
            m_candidate_segment_paths[0] :=
                supported_transition_top_path_local;
        end;

        procedure restore_visible_supported_transition_top_local;
        var
            candidate_idx_local: Integer;
            move_idx_local: Integer;
            source_idx_local: Integer;
        begin
            if (not has_supported_transition_top_local) or
                (m_page_index <> 0) then
            begin
                Exit;
            end;

            candidate_idx_local := -1;
            for move_idx_local := 0 to High(Result) do
            begin
                if (Trim(Result[move_idx_local].comment) = '') and
                    SameText(Trim(Result[move_idx_local].text),
                    Trim(supported_transition_top_candidate_local.text)) then
                begin
                    candidate_idx_local := move_idx_local;
                    Break;
                end;
            end;

            source_idx_local := -1;
            if (candidate_idx_local >= 0) and
                (candidate_idx_local < Length(visible_source_indices)) then
            begin
                source_idx_local := visible_source_indices[candidate_idx_local];
            end;
            if candidate_idx_local < 0 then
            begin
                for move_idx_local := 0 to High(m_candidates) do
                begin
                    if (Trim(m_candidates[move_idx_local].comment) = '') and
                        SameText(Trim(m_candidates[move_idx_local].text),
                        Trim(supported_transition_top_candidate_local.text)) then
                    begin
                        source_idx_local := move_idx_local;
                        Break;
                    end;
                end;
                if Length(Result) < visible_page_size then
                begin
                    SetLength(Result, Length(Result) + 1);
                    SetLength(visible_source_indices, Length(Result));
                end;
                candidate_idx_local := High(Result);
            end;

            for move_idx_local := candidate_idx_local downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[0] := supported_transition_top_candidate_local;
            Result[0].display_kind := cdk_lm_compound;
            visible_source_indices[0] := source_idx_local;
        end;

        procedure capture_short_exact_ranked_order_local;
        var
            candidate_idx_local: Integer;
            exact_idx_local: Integer;
            seen_idx_local: Integer;
            candidate_text_local: string;
            already_seen_local: Boolean;
            is_exact_local: Boolean;
            exact_results_local: TncCandidateList;
        begin
            SetLength(short_exact_ranked_texts, 0);
            if (not short_exact_query_mode) or (m_dictionary = nil) or
                (normalized_pinyin = '') or
                (not lookup_display_exact_cached(normalized_pinyin,
                exact_results_local)) then
            begin
                Exit;
            end;

            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                candidate_text_local := Trim(
                    m_candidates[candidate_idx_local].text);
                if (candidate_text_local = '') or
                    (Trim(m_candidates[candidate_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    expected_units) then
                begin
                    Continue;
                end;

                { Preserve the complete order already decided by the short
                  ranker. Accepted LM compounds participate in that order even
                  though they are not base-dictionary exact rows. }
                is_exact_local :=
                    is_current_short_two_single_pair_candidate_supported(
                    normalized_pinyin, candidate_text_local) or
                    is_current_short_three_exact_pair_candidate_supported(
                    normalized_pinyin, candidate_text_local);
                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(Trim(exact_results_local[exact_idx_local].text),
                        candidate_text_local) then
                    begin
                        is_exact_local := True;
                        Break;
                    end;
                end;
                if not is_exact_local then
                begin
                    Continue;
                end;

                already_seen_local := False;
                for seen_idx_local := 0 to High(short_exact_ranked_texts) do
                begin
                    if SameText(short_exact_ranked_texts[seen_idx_local],
                        candidate_text_local) then
                    begin
                        already_seen_local := True;
                        Break;
                    end;
                end;
                if already_seen_local then
                begin
                    Continue;
                end;

                SetLength(short_exact_ranked_texts,
                    Length(short_exact_ranked_texts) + 1);
                short_exact_ranked_texts[High(short_exact_ranked_texts)] :=
                    candidate_text_local;
            end;
        end;

        procedure restore_short_exact_ranked_order_local;
        var
            ranked_candidates_local: TncCandidateList;
            ranked_paths_local: TArray<string>;
            slot_indices_local: TArray<Integer>;
            ranked_idx_local: Integer;
            candidate_idx_local: Integer;
            found_idx_local: Integer;
            slot_idx_local: Integer;
            insert_idx_local: Integer;
            temp_slot_local: Integer;
        begin
            if Length(short_exact_ranked_texts) < 2 then
            begin
                Exit;
            end;

            SetLength(ranked_candidates_local,
                Length(short_exact_ranked_texts));
            SetLength(ranked_paths_local, Length(short_exact_ranked_texts));
            SetLength(slot_indices_local, Length(short_exact_ranked_texts));
            ranked_idx_local := 0;
            for slot_idx_local := 0 to High(short_exact_ranked_texts) do
            begin
                found_idx_local := -1;
                for candidate_idx_local := 0 to High(m_candidates) do
                begin
                    if (Trim(m_candidates[candidate_idx_local].comment) = '') and
                        SameText(Trim(m_candidates[candidate_idx_local].text),
                        short_exact_ranked_texts[slot_idx_local]) then
                    begin
                        found_idx_local := candidate_idx_local;
                        Break;
                    end;
                end;
                if found_idx_local < 0 then
                begin
                    Continue;
                end;

                ranked_candidates_local[ranked_idx_local] :=
                    m_candidates[found_idx_local];
                if found_idx_local < Length(m_candidate_segment_paths) then
                begin
                    ranked_paths_local[ranked_idx_local] :=
                        m_candidate_segment_paths[found_idx_local];
                end
                else
                begin
                    ranked_paths_local[ranked_idx_local] := '';
                end;
                slot_indices_local[ranked_idx_local] := found_idx_local;
                Inc(ranked_idx_local);
            end;

            if ranked_idx_local < 2 then
            begin
                Exit;
            end;
            SetLength(ranked_candidates_local, ranked_idx_local);
            SetLength(ranked_paths_local, ranked_idx_local);
            SetLength(slot_indices_local, ranked_idx_local);

            for slot_idx_local := 1 to High(slot_indices_local) do
            begin
                temp_slot_local := slot_indices_local[slot_idx_local];
                insert_idx_local := slot_idx_local - 1;
                while (insert_idx_local >= 0) and
                    (slot_indices_local[insert_idx_local] > temp_slot_local) do
                begin
                    slot_indices_local[insert_idx_local + 1] :=
                        slot_indices_local[insert_idx_local];
                    Dec(insert_idx_local);
                end;
                slot_indices_local[insert_idx_local + 1] := temp_slot_local;
            end;

            for ranked_idx_local := 0 to High(ranked_candidates_local) do
            begin
                candidate_idx_local := slot_indices_local[ranked_idx_local];
                m_candidates[candidate_idx_local] :=
                    ranked_candidates_local[ranked_idx_local];
                if candidate_idx_local < Length(m_candidate_segment_paths) then
                begin
                    m_candidate_segment_paths[candidate_idx_local] :=
                        ranked_paths_local[ranked_idx_local];
                end;
            end;
        end;

        function is_protected_full_query_exact_local(
            const candidate_value: TncCandidate): Boolean;
        var
            exact_idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := False;
            if Trim(candidate_value.comment) <> '' then
            begin
                Exit;
            end;

            candidate_text_local := Trim(candidate_value.text);
            if candidate_text_local = '' then
            begin
                Exit;
            end;

            // Literal entries arrive through a separate lookup, but belong
            // to the same leading exact cluster as base dictionary words.
            if m_last_lookup_literal_user_fast and
                (candidate_value.source = cs_user) and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and (m_dictionary <> nil) and
                m_dictionary.is_user_entry(normalized_pinyin,
                candidate_text_local) then
            begin
                Exit(True);
            end;

            if is_fuzzy_pinyin_active and
                (candidate_value.fuzzy_cost > 0) and
                (get_candidate_text_unit_count(candidate_text_local) =
                expected_units) and
                ((candidate_value.source = cs_user) or
                ((candidate_value.source = cs_rule) and
                candidate_value.has_dict_weight)) then
            begin
                Exit(True);
            end;

            for exact_idx_local := 0 to High(protected_full_query_exacts) do
            begin
                if SameText(candidate_text_local,
                    Trim(protected_full_query_exacts[exact_idx_local].text)) then
                begin
                    Exit(True);
                end;
            end;
        end;

        procedure retain_all_full_query_exact_candidates_local;
        var
            exact_results_local: TncCandidateList;
            rebuilt_candidates_local: TncCandidateList;
            rebuilt_paths_local: TArray<string>;
            query_key_local: string;
            raw_query_local: string;
            candidate_text_local: string;
            idx_local: Integer;
            exact_idx_local: Integer;
            write_idx_local: Integer;

            function protected_text_already_collected_local(
                const text_value: string): Boolean;
            var
                probe_idx_local: Integer;
            begin
                Result := False;
                for probe_idx_local := 0 to High(
                    protected_full_query_exacts) do
                begin
                    if SameText(Trim(
                        protected_full_query_exacts[probe_idx_local].text),
                        text_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function contains_non_ascii_candidate_text_local(
                const text_value: string): Boolean;
            var
                char_idx_local: Integer;
            begin
                Result := False;
                for char_idx_local := 1 to Length(text_value) do
                begin
                    if Ord(text_value[char_idx_local]) > 127 then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function rebuilt_exact_already_emitted_local(
                const text_value: string): Boolean;
            var
                probe_idx_local: Integer;
            begin
                Result := False;
                for probe_idx_local := 0 to write_idx_local - 1 do
                begin
                    if (Trim(rebuilt_candidates_local[probe_idx_local].comment) = '') and
                        SameText(Trim(
                        rebuilt_candidates_local[probe_idx_local].text),
                        text_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            procedure append_rebuilt_candidate_local(
                const candidate_value: TncCandidate;
                const path_value: string);
            begin
                rebuilt_candidates_local[write_idx_local] := candidate_value;
                rebuilt_paths_local[write_idx_local] := path_value;
                Inc(write_idx_local);
            end;
        begin
            SetLength(protected_full_query_exacts, 0);
            // Single-syllable candidates use their own complete paging and
            // learned-character ordering path. This guard is for multi-unit
            // exact words that can otherwise be lost in segmentation caps.
            if (m_dictionary = nil) or (expected_units < 2) then
            begin
                Exit;
            end;

            query_key_local := normalized_pinyin;
            raw_query_local := get_display_raw_query_text_local;
            if Pos('''', raw_query_local) > 0 then
            begin
                query_key_local := raw_query_local;
            end;
            if (query_key_local = '') or
                (not lookup_display_exact_cached(query_key_local,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                candidate_text_local := Trim(
                    exact_results_local[exact_idx_local].text);
                if (candidate_text_local = '') or
                    (not contains_non_ascii_candidate_text_local(
                    candidate_text_local)) or
                    (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    expected_units) or
                    // Compact-key recovery must not undo explicit boundaries.
                    ((Pos('''', m_composition_text) > 0) and
                    (not display_complete_text_matches_explicit_apostrophe_boundary(
                    candidate_text_local))) or
                    (((exact_results_local[exact_idx_local].source = cs_user) and
                    (not m_dictionary.is_user_entry(query_key_local,
                    candidate_text_local))) or
                    ((exact_results_local[exact_idx_local].source <> cs_user) and
                    (not m_dictionary.is_base_entry(query_key_local,
                    candidate_text_local)))) or
                    protected_text_already_collected_local(
                    candidate_text_local) then
                begin
                    Continue;
                end;

                SetLength(protected_full_query_exacts,
                    Length(protected_full_query_exacts) + 1);
                protected_full_query_exacts[High(
                    protected_full_query_exacts)] :=
                    exact_results_local[exact_idx_local];
                protected_full_query_exacts[High(
                    protected_full_query_exacts)].text :=
                    candidate_text_local;
                protected_full_query_exacts[High(
                    protected_full_query_exacts)].comment := '';
            end;

            if Length(protected_full_query_exacts) = 0 then
            begin
                Exit;
            end;

            SetLength(rebuilt_candidates_local, Length(m_candidates) +
                Length(protected_full_query_exacts));
            SetLength(rebuilt_paths_local, Length(rebuilt_candidates_local));
            write_idx_local := 0;

            // Keep the ranking already established by the short-query path,
            // but gather every exact item into one lossless leading cluster.
            for idx_local := 0 to High(m_candidates) do
            begin
                if (not is_protected_full_query_exact_local(
                    m_candidates[idx_local])) or
                    rebuilt_exact_already_emitted_local(
                    Trim(m_candidates[idx_local].text)) then
                begin
                    Continue;
                end;

                if idx_local < Length(m_candidate_segment_paths) then
                begin
                    append_rebuilt_candidate_local(m_candidates[idx_local],
                        m_candidate_segment_paths[idx_local]);
                end
                else
                begin
                    append_rebuilt_candidate_local(m_candidates[idx_local], '');
                end;
            end;

            // Exact rows cut by an earlier candidate cap are restored in the
            // dictionary provider's stable order.
            for exact_idx_local := 0 to High(protected_full_query_exacts) do
            begin
                candidate_text_local := Trim(
                    protected_full_query_exacts[exact_idx_local].text);
                if rebuilt_exact_already_emitted_local(candidate_text_local) then
                begin
                    Continue;
                end;
                append_rebuilt_candidate_local(
                    protected_full_query_exacts[exact_idx_local], '');
            end;

            for idx_local := 0 to High(m_candidates) do
            begin
                if is_protected_full_query_exact_local(
                    m_candidates[idx_local]) then
                begin
                    Continue;
                end;

                if idx_local < Length(m_candidate_segment_paths) then
                begin
                    append_rebuilt_candidate_local(m_candidates[idx_local],
                        m_candidate_segment_paths[idx_local]);
                end
                else
                begin
                    append_rebuilt_candidate_local(m_candidates[idx_local], '');
                end;
            end;

            SetLength(rebuilt_candidates_local, write_idx_local);
            SetLength(rebuilt_paths_local, write_idx_local);
            m_candidates := rebuilt_candidates_local;
            m_candidate_segment_paths := rebuilt_paths_local;
        end;

        procedure clear_segment_path_for_identity(const candidate_value: TncCandidate);
        var
            identity_key_local: string;
        begin
            identity_key_local := build_candidate_identity_key(
                candidate_value.text, candidate_value.comment);
            if identity_key_local = '' then
            begin
                Exit;
            end;

            if m_current_segment_path_map <> nil then
            begin
                m_current_segment_path_map.Remove(identity_key_local);
            end;
            if m_current_segment_path_score_map <> nil then
            begin
                m_current_segment_path_score_map.Remove(identity_key_local);
            end;
        end;

        function segment_path_matches_visible_text(const encoded_path: string;
            const visible_text: string): Boolean;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            joined_text_local: string;
            segment_text_local: string;
        begin
            Result := True;
            if get_encoded_path_segment_count_local(encoded_path) <= 1 then
            begin
                Exit;
            end;

            path_parts_local := encoded_path.Split([c_segment_path_separator]);
            joined_text_local := '';
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                if segment_text_local = '' then
                begin
                    Result := False;
                    Exit;
                end;
                joined_text_local := joined_text_local + segment_text_local;
            end;

            Result := SameText(joined_text_local, Trim(visible_text));
        end;

        procedure sanitize_short_partial_segment_paths;
        var
            idx_local: Integer;
            path_local: string;
        begin
            if (expected_units > 5) or
                (Length(m_candidate_segment_paths) = 0) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(m_candidates) do
            begin
                if (idx_local >= Length(m_candidate_segment_paths)) or
                    (Trim(m_candidates[idx_local].comment) = '') then
                begin
                    Continue;
                end;

                path_local := Trim(m_candidate_segment_paths[idx_local]);
                if get_encoded_path_segment_count_local(path_local) <= 1 then
                begin
                    Continue;
                end;

                if not segment_path_matches_visible_text(path_local,
                    m_candidates[idx_local].text) then
                begin
                    m_candidate_segment_paths[idx_local] := '';
                    clear_segment_path_for_identity(m_candidates[idx_local]);
                end;
            end;
        end;

        procedure normalize_display_candidate(var candidate_value: TncCandidate);
        begin
            if (candidate_value.comment = '') and
                split_trailing_ascii_candidate(candidate_value.text, head_text,
                tail_pinyin) then
            begin
                candidate_value.text := head_text;
                candidate_value.comment := tail_pinyin;
            end;
            if Trim(candidate_value.comment) <> '' then
            begin
                candidate_value.display_kind := cdk_default;
            end;
            if (Trim(candidate_value.comment) = '') and
                (is_current_short_two_single_pair_candidate_supported(
                normalized_pinyin, Trim(candidate_value.text)) or
                is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, Trim(candidate_value.text))) then
            begin
                candidate_value.display_kind := cdk_lm_compound;
            end;
        end;

        function display_candidate_is_explicit_apostrophe_prefix_partial(
            const candidate_value: TncCandidate): Boolean;
        var
            tail_syllables_local: TncPinyinParseResult;
            query_syllables_local: TncPinyinParseResult;
            text_units_local: TArray<string>;
            prefix_key_local: string;
            query_unit_count_local: Integer;
            prefix_units_local: Integer;
            unit_idx_local: Integer;
            is_preferred_local: Boolean;
        begin
            Result := False;
            query_syllables_local := syllables;
            query_unit_count_local := expected_units;
            if Pos('''', get_display_raw_query_text_local) > 0 then
            begin
                query_syllables_local := get_display_query_syllables_local(
                    get_display_raw_query_text_local);
                query_unit_count_local := Length(query_syllables_local);
            end;
            if (Pos('''', get_display_raw_query_text_local) <= 0) or
                (Trim(candidate_value.comment) = '') or
                (query_unit_count_local < 3) or
                (Length(query_syllables_local) < query_unit_count_local) then
            begin
                Exit;
            end;

            tail_syllables_local := get_effective_compact_pinyin_syllables(
                normalize_pinyin_text(candidate_value.comment));
            if Length(tail_syllables_local) <= 0 then
            begin
                Exit;
            end;

            prefix_units_local := query_unit_count_local -
                Length(tail_syllables_local);
            if prefix_units_local < 2 then
            begin
                Exit;
            end;

            text_units_local := split_text_units(Trim(candidate_value.text));
            if Length(text_units_local) <> prefix_units_local then
            begin
                Exit;
            end;

            prefix_key_local := '';
            for unit_idx_local := 0 to prefix_units_local - 1 do
            begin
                prefix_key_local := prefix_key_local +
                    normalize_pinyin_text(query_syllables_local[unit_idx_local].text);
            end;
            if (prefix_key_local <> '') and
                ((display_exact_key_has_text(prefix_key_local,
                Trim(candidate_value.text))) or
                ((m_dictionary <> nil) and
                (m_dictionary.is_base_entry(prefix_key_local,
                Trim(candidate_value.text)) or
                m_dictionary.is_user_entry(prefix_key_local,
                Trim(candidate_value.text))))) then
            begin
                Exit(True);
            end;

            for unit_idx_local := 0 to prefix_units_local - 1 do
            begin
                if not match_single_char_candidate_for_syllable(
                    normalize_pinyin_text(query_syllables_local[unit_idx_local].text),
                    text_units_local[unit_idx_local], is_preferred_local) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function candidate_is_non_strict_one_plus_two_complete(
            const candidate_value: TncCandidate;
            const candidate_index_value: Integer): Boolean;
        var
            candidate_text_local: string;
            units_local: TArray<string>;
            path_local: string;
            path_parts_local: TArray<string>;
            head_key_local: string;
            tail_key_local: string;
            tail_text_local: string;
            fixed_head_text_local: string;
            fixed_tail_units_local: Integer;

            function candidate_is_short_particle_tail_completion_local: Boolean;
            var
                local_head_key: string;
                local_head_text: string;
                local_tail_key: string;
                local_tail_text: string;
                local_query_key: string;

                function try_get_compact_particle_tail_local(
                    out out_tail_key: string; out out_tail_text: string): Boolean;
                begin
                    out_tail_key := '';
                    out_tail_text := '';
                    local_head_key := '';
                    Result := try_get_short_particle_tail_query_parts(
                        local_query_key, out_tail_key, out_tail_text,
                        local_head_key);
                end;
            begin
                Result := False;
                if Length(units_local) <> 3 then
                begin
                    Exit;
                end;

                local_query_key := normalize_pinyin_text(normalized_pinyin);
                if try_get_compact_particle_tail_local(local_tail_key,
                    local_tail_text) then
                begin
                    local_head_text := Trim(units_local[0]) +
                        Trim(units_local[1]);
                    if (local_head_key <> '') and
                        SameText(Trim(units_local[2]), local_tail_text) and
                        (get_effective_compact_pinyin_unit_count(
                        local_head_key) = 2) and
                        (display_exact_key_has_text(local_head_key,
                        local_head_text) or
                        m_dictionary.is_base_entry(local_head_key,
                        local_head_text) or
                        m_dictionary.is_user_entry(local_head_key,
                        local_head_text)) then
                    begin
                        Exit(True);
                    end;
                end;

                if SameText(normalize_pinyin_text(syllables[1].text), 'de') and
                    SameText(normalize_pinyin_text(syllables[2].text), 'hao') and
                    SameText(Trim(units_local[1]) + Trim(units_local[2]),
                    string(Char($5F97)) + string(Char($597D))) then
                begin
                    local_head_key := normalize_pinyin_text(syllables[0].text) +
                        normalize_pinyin_text(syllables[1].text);
                    local_head_text := Trim(units_local[0]) +
                        Trim(units_local[1]);
                    Result := (local_head_key <> '') and
                        (local_head_text <> '') and
                        (display_exact_key_has_text(local_head_key,
                        local_head_text) or
                        m_dictionary.is_base_entry(local_head_key,
                        local_head_text) or
                        m_dictionary.is_user_entry(local_head_key,
                        local_head_text));
                    Exit;
                end;

                local_tail_key := normalize_pinyin_text(syllables[2].text);
                if SameText(local_tail_key, 'de') then
                begin
                    local_tail_text := string(Char($7684));
                end
                else if SameText(local_tail_key, 'le') then
                begin
                    local_tail_text := string(Char($4E86));
                end
                else if SameText(local_tail_key, 'zhe') then
                begin
                    local_tail_text := string(Char($7740));
                end
                else
                begin
                    Exit;
                end;

                if not SameText(Trim(units_local[2]), local_tail_text) then
                begin
                    Exit;
                end;

                local_head_key := normalize_pinyin_text(syllables[0].text) +
                    normalize_pinyin_text(syllables[1].text);
                local_head_text := Trim(units_local[0]) + Trim(units_local[1]);
                Result := (local_head_key <> '') and (local_head_text <> '') and
                    (display_exact_key_has_text(local_head_key,
                    local_head_text) or
                    m_dictionary.is_base_entry(local_head_key, local_head_text) or
                    m_dictionary.is_user_entry(local_head_key, local_head_text));
            end;

            function two_plus_one_head_has_stronger_exact_local(
                const local_head_key: string;
                const local_head_text: string): Boolean;
            const
                c_probe_limit = 16;
                c_min_weight_gap = 240;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
                exact_weight_local: Integer;
                current_weight_local: Integer;
                found_current_local: Boolean;
            begin
                Result := False;
                current_weight_local := 0;
                found_current_local := False;
                if (local_head_key = '') or (local_head_text = '') or
                    (not lookup_display_exact_cached(local_head_key,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                        (exact_text_local = '') or
                        (get_candidate_text_unit_count(exact_text_local) <> 2) then
                    begin
                        Continue;
                    end;

                    if exact_results_local[exact_idx_local].has_dict_weight then
                    begin
                        exact_weight_local :=
                            exact_results_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        exact_weight_local := exact_results_local[exact_idx_local].score;
                    end;

                    if SameText(exact_text_local, local_head_text) then
                    begin
                        current_weight_local := Max(current_weight_local,
                            exact_weight_local);
                        found_current_local := True;
                        Continue;
                    end;

                    if exact_weight_local >= current_weight_local +
                        c_min_weight_gap then
                    begin
                        if (not found_current_local) or
                            (exact_weight_local >= current_weight_local +
                            c_min_weight_gap) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;
            end;
        begin
            Result := False;
            if (m_dictionary = nil) or (expected_units <> 3) or
                (Length(syllables) <> 3) or (normalized_pinyin = '') or
                (Trim(candidate_value.comment) <> '') then
            begin
                Exit;
            end;

            candidate_text_local := Trim(candidate_value.text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <> 3) or
                m_dictionary.is_base_entry(normalized_pinyin,
                candidate_text_local) or
                ((candidate_value.source = cs_user) and
                m_dictionary.is_user_entry(normalized_pinyin,
                candidate_text_local)) then
            begin
                Exit;
            end;

            if is_current_short_three_exact_pair_candidate_supported(
                normalized_pinyin, candidate_text_local) then
            begin
                Exit(False);
            end;

            units_local := split_text_units(candidate_text_local);
            if Length(units_local) <> 3 then
            begin
                Exit;
            end;

            if try_get_fixed_pronoun_tail_query_parts(normalized_pinyin,
                expected_units, head_key_local, fixed_head_text_local,
                tail_key_local, fixed_tail_units_local) and
                SameText(Trim(units_local[0]), fixed_head_text_local) then
            begin
                tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
                if (tail_key_local <> '') and (tail_text_local <> '') and
                    (display_exact_key_has_text(tail_key_local,
                    tail_text_local) or
                    m_dictionary.is_base_entry(tail_key_local,
                    tail_text_local)) then
                begin
                    Exit(False);
                end;
            end;
            if candidate_is_short_particle_tail_completion_local then
            begin
                Exit(False);
            end;

            path_local := get_display_candidate_path_for_index(candidate_value,
                candidate_index_value);
            if get_encoded_path_segment_count_local(path_local) = 2 then
            begin
                path_parts_local := path_local.Split([c_segment_path_separator]);
                if (Length(path_parts_local) = 2) and
                    (get_candidate_text_unit_count(Trim(path_parts_local[0])) = 1) and
                    (get_candidate_text_unit_count(Trim(path_parts_local[1])) = 2) then
                begin
                    Exit(True);
                end;
            end;

            head_key_local := normalize_pinyin_text(syllables[0].text) +
                normalize_pinyin_text(syllables[1].text);
            tail_text_local := Trim(units_local[2]);
            if (head_key_local <> '') and
                is_display_function_or_modifier_single(tail_text_local) and
                two_plus_one_head_has_stronger_exact_local(head_key_local,
                Trim(units_local[0]) + Trim(units_local[1])) then
            begin
                Exit(True);
            end;

            head_key_local := normalize_pinyin_text(syllables[0].text);
            tail_key_local := normalize_pinyin_text(syllables[1].text) +
                normalize_pinyin_text(syllables[2].text);
            tail_text_local := Trim(units_local[1]) + Trim(units_local[2]);
            if (head_key_local = '') or (tail_key_local = '') or
                (tail_text_local = '') or
                (not m_dictionary.single_char_matches_pinyin(head_key_local,
                Trim(units_local[0]))) then
            begin
                Exit;
            end;

            Result := display_exact_key_has_text(tail_key_local,
                tail_text_local) or
                m_dictionary.is_base_entry(tail_key_local, tail_text_local);
        end;

        function forced_visible_top_candidate_applies: Boolean;
        begin
            Result := m_has_forced_visible_top_candidate and
                (m_page_index = 0) and
                (Trim(m_forced_visible_top_candidate.text) <> '') and
                SameText(m_forced_visible_top_composition_text,
                m_composition_text) and
                SameText(m_forced_visible_top_lookup_key, m_last_lookup_key);
        end;

        function same_visible_candidate_local(const left_candidate: TncCandidate;
            const right_candidate: TncCandidate): Boolean;
        begin
            Result := SameText(Trim(left_candidate.text), Trim(right_candidate.text)) and
                SameText(Trim(left_candidate.comment), Trim(right_candidate.comment));
        end;

        procedure ensure_explicit_apostrophe_prefix_partial_visible;
        var
            source_idx_local: Integer;
            existing_idx_local: Integer;
            move_idx_local: Integer;
            best_source_idx_local: Integer;
            candidate_local: TncCandidate;
            best_candidate_local: TncCandidate;
            explicit_syllables_local: TncPinyinParseResult;
            explicit_unit_count_local: Integer;

            procedure restore_explicit_candidate_to_internal_front_local;
            var
                move_idx_local: Integer;
            begin
                if best_source_idx_local = 0 then
                begin
                    m_candidates[0] := best_candidate_local;
                    Exit;
                end;

                if best_source_idx_local > 0 then
                begin
                    for move_idx_local := best_source_idx_local downto 1 do
                    begin
                        m_candidates[move_idx_local] :=
                            m_candidates[move_idx_local - 1];
                        if move_idx_local < Length(m_candidate_segment_paths) then
                        begin
                            if move_idx_local - 1 < Length(m_candidate_segment_paths) then
                            begin
                                m_candidate_segment_paths[move_idx_local] :=
                                    m_candidate_segment_paths[move_idx_local - 1];
                            end
                            else
                            begin
                                m_candidate_segment_paths[move_idx_local] := '';
                            end;
                        end;
                    end;
                    m_candidates[0] := best_candidate_local;
                    if Length(m_candidate_segment_paths) > 0 then
                    begin
                        m_candidate_segment_paths[0] := '';
                    end;
                    Exit;
                end;

                SetLength(m_candidates, Length(m_candidates) + 1);
                if Length(m_candidate_segment_paths) < Length(m_candidates) then
                begin
                    SetLength(m_candidate_segment_paths, Length(m_candidates));
                end;
                for move_idx_local := High(m_candidates) downto 1 do
                begin
                    m_candidates[move_idx_local] := m_candidates[move_idx_local - 1];
                    if move_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[move_idx_local] :=
                            m_candidate_segment_paths[move_idx_local - 1];
                    end;
                end;
                m_candidates[0] := best_candidate_local;
                if Length(m_candidate_segment_paths) > 0 then
                begin
                    m_candidate_segment_paths[0] := '';
                end;
            end;

            function try_build_display_explicit_prefix_candidate_local(
                out out_candidate: TncCandidate): Boolean;
            var
                prefix_count_local: Integer;
                unit_idx_local: Integer;
                prefix_key_local: string;
                raw_prefix_key_local: string;
                tail_comment_local: string;
                exact_results_local: TncCandidateList;
                candidate_text_local: string;
                raw_hit_local: Boolean;
                compact_hit_local: Boolean;

                function try_pick_candidate_from_results_local(
                    const source_results: TncCandidateList): Boolean;
                var
                    pick_idx_local: Integer;
                begin
                    Result := False;
                    for pick_idx_local := 0 to High(source_results) do
                    begin
                        if Trim(source_results[pick_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        candidate_text_local :=
                            Trim(source_results[pick_idx_local].text);
                        if (candidate_text_local = '') or
                            (get_candidate_text_unit_count(candidate_text_local) <>
                            prefix_count_local) then
                        begin
                            Continue;
                        end;

                        out_candidate := source_results[pick_idx_local];
                        out_candidate.comment := tail_comment_local;
                        Exit(True);
                    end;
                end;

                function get_raw_prefix_key_for_count_local(
                    const target_prefix_count: Integer): string;
                var
                    target_compact_len_local: Integer;
                    local_unit_idx: Integer;
                    raw_idx_local: Integer;
                    compact_seen_local: Integer;
                    raw_char_local: Char;
                    raw_query_text_local: string;
                begin
                    Result := '';
                    raw_query_text_local := get_display_raw_query_text_local;
                    target_compact_len_local := 0;
                    for local_unit_idx := 0 to target_prefix_count - 1 do
                    begin
                        Inc(target_compact_len_local,
                            Length(normalize_pinyin_text(
                            explicit_syllables_local[local_unit_idx].text)));
                    end;
                    if target_compact_len_local <= 0 then
                    begin
                        Exit;
                    end;

                    compact_seen_local := 0;
                    for raw_idx_local := 1 to Length(raw_query_text_local) do
                    begin
                        raw_char_local := raw_query_text_local[raw_idx_local];
                        Result := Result + raw_char_local;
                        if raw_char_local <> '''' then
                        begin
                            Inc(compact_seen_local);
                            if compact_seen_local >= target_compact_len_local then
                            begin
                                Break;
                            end;
                        end;
                    end;
                    Result := LowerCase(Trim(Result));
                end;
            begin
                Result := False;
                FillChar(out_candidate, SizeOf(out_candidate), 0);
                if Length(explicit_syllables_local) < explicit_unit_count_local then
                begin
                    Exit;
                end;

                for prefix_count_local := explicit_unit_count_local - 1 downto 2 do
                begin
                    prefix_key_local := '';
                    for unit_idx_local := 0 to prefix_count_local - 1 do
                    begin
                        prefix_key_local := prefix_key_local +
                            normalize_pinyin_text(
                            explicit_syllables_local[unit_idx_local].text);
                    end;

                    tail_comment_local := '';
                    for unit_idx_local := prefix_count_local to
                        explicit_unit_count_local - 1 do
                    begin
                        tail_comment_local := tail_comment_local +
                            normalize_pinyin_text(
                            explicit_syllables_local[unit_idx_local].text);
                    end;

                    raw_prefix_key_local :=
                        get_raw_prefix_key_for_count_local(prefix_count_local);
                    if (prefix_key_local = '') or (tail_comment_local = '') then
                    begin
                        Continue;
                    end;
                    raw_hit_local := (raw_prefix_key_local <> '') and
                        (lookup_display_exact_cached(raw_prefix_key_local,
                        exact_results_local) or
                        m_dictionary.lookup(raw_prefix_key_local,
                        exact_results_local));
                    compact_hit_local := False;
                    if not raw_hit_local then
                    begin
                        compact_hit_local := lookup_display_exact_cached(
                            prefix_key_local, exact_results_local) or
                            m_dictionary.lookup(prefix_key_local,
                            exact_results_local);
                    end;
                    if (not raw_hit_local) and (not compact_hit_local) then
                    begin
                        Continue;
                    end;

                    if try_pick_candidate_from_results_local(
                        exact_results_local) then
                    begin
                        Exit(True);
                    end;
                    if raw_hit_local and
                        (lookup_display_exact_cached(prefix_key_local,
                        exact_results_local) or
                        m_dictionary.lookup(prefix_key_local,
                        exact_results_local)) and
                        try_pick_candidate_from_results_local(
                        exact_results_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (m_page_index <> 0) or (page_size <= 0) or
                (Pos('''', get_display_raw_query_text_local) <= 0) then
            begin
                Exit;
            end;
            explicit_syllables_local := get_display_query_syllables_local(
                get_display_raw_query_text_local);
            explicit_unit_count_local := Length(explicit_syllables_local);
            if explicit_unit_count_local < 3 then
            begin
                Exit;
            end;

            best_source_idx_local := -1;
            for source_idx_local := 0 to High(m_candidates) do
            begin
                candidate_local := m_candidates[source_idx_local];
                normalize_display_candidate(candidate_local);
                if display_candidate_is_explicit_apostrophe_prefix_partial(
                    candidate_local) then
                begin
                    best_candidate_local := candidate_local;
                    best_source_idx_local := source_idx_local;
                    Break;
                end;
            end;

            if best_source_idx_local < 0 then
            begin
                if has_explicit_apostrophe_entry_top_partial_candidate then
                begin
                    best_candidate_local :=
                        explicit_apostrophe_entry_top_partial_candidate;
                end
                else if not try_build_display_explicit_prefix_candidate_local(
                    best_candidate_local) then
                begin
                    Exit;
                end;
            end;

            restore_explicit_candidate_to_internal_front_local;

            for existing_idx_local := 0 to High(Result) do
            begin
                if same_visible_candidate_local(Result[existing_idx_local],
                    best_candidate_local) then
                begin
                    if existing_idx_local = 0 then
                    begin
                        Exit;
                    end;
                    for move_idx_local := existing_idx_local downto 1 do
                    begin
                        Result[move_idx_local] := Result[move_idx_local - 1];
                        if move_idx_local < Length(visible_source_indices) then
                        begin
                            visible_source_indices[move_idx_local] :=
                                visible_source_indices[move_idx_local - 1];
                        end;
                    end;
                    Result[0] := best_candidate_local;
                    if Length(visible_source_indices) > 0 then
                    begin
                        visible_source_indices[0] := best_source_idx_local;
                    end;
                    Exit;
                end;
            end;

            if Length(Result) < page_size then
            begin
                SetLength(Result, Length(Result) + 1);
                SetLength(visible_source_indices, Length(Result));
            end;
            if Length(Result) <= 0 then
            begin
                SetLength(Result, 1);
                SetLength(visible_source_indices, 1);
            end;

            for move_idx_local := High(Result) downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                if move_idx_local < Length(visible_source_indices) then
                begin
                    visible_source_indices[move_idx_local] :=
                        visible_source_indices[move_idx_local - 1];
                end;
            end;
            Result[0] := best_candidate_local;
            visible_source_indices[0] := best_source_idx_local;
        end;

        function find_forced_visible_top_source_index: Integer;
        var
            candidate_idx_local: Integer;
        begin
            Result := -1;
            for candidate_idx_local := 0 to High(m_candidates) do
            begin
                if same_visible_candidate_local(m_candidates[candidate_idx_local],
                    m_forced_visible_top_candidate) then
                begin
                    Result := candidate_idx_local;
                    Exit;
                end;
            end;
        end;

        procedure apply_forced_visible_top_candidate;
        var
            candidate_idx_local: Integer;
            forced_idx_local: Integer;
            forced_source_idx_local: Integer;
            superseding_idx_local: Integer;
            tmp_candidate_local: TncCandidate;
            tmp_source_idx_local: Integer;
            attested_particle_winner_local: string;

            function current_top_supersedes_forced_partial_local(
                const current_top_candidate: TncCandidate;
                const current_candidate_idx: Integer): Boolean;
            var
                current_text_local: string;
                forced_text_local: string;
                current_prefix_key_local: string;
                current_text_units_local: Integer;
                current_tail_units_local: Integer;
                forced_text_units_local: Integer;
                forced_tail_units_local: Integer;

                function current_complete_has_backed_path_local: Boolean;
                var
                    current_path_local: string;
                    current_source_idx_local: Integer;
                begin
                    current_path_local := '';
                    current_source_idx_local := -1;
                    if (current_candidate_idx >= 0) and
                        (current_candidate_idx <
                        Length(visible_source_indices)) then
                    begin
                        current_source_idx_local :=
                            visible_source_indices[current_candidate_idx];
                    end;
                    if (current_source_idx_local >= 0) and
                        (current_source_idx_local < Length(m_candidates)) then
                    begin
                        current_path_local := get_segment_path_for_candidate(
                            m_candidates[current_source_idx_local],
                            current_source_idx_local);
                    end
                    else
                    begin
                        current_path_local := get_segment_path_for_candidate(
                            current_top_candidate);
                    end;
                    Result := get_encoded_path_segment_count_local(
                        current_path_local) > 1;
                end;
            begin
                Result := False;
                if Trim(m_forced_visible_top_candidate.comment) = '' then
                begin
                    Exit;
                end;

                current_text_local := Trim(current_top_candidate.text);
                forced_text_local := Trim(m_forced_visible_top_candidate.text);
                if (current_text_local = '') or (forced_text_local = '') then
                begin
                    Exit;
                end;

                current_text_units_local :=
                    get_candidate_text_unit_count(current_text_local);
                forced_text_units_local :=
                    get_candidate_text_unit_count(forced_text_local);
                forced_tail_units_local :=
                    get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(
                    Trim(m_forced_visible_top_candidate.comment)));
                if (forced_tail_units_local <= 0) or
                    (forced_text_units_local + forced_tail_units_local <>
                    expected_units) then
                begin
                    Exit;
                end;

                if Trim(current_top_candidate.comment) = '' then
                begin
                    Result := (current_text_units_local = expected_units) and
                        (
                            (Copy(current_text_local, 1,
                            Length(forced_text_local)) = forced_text_local) or
                            (
                                m_forced_visible_top_from_incremental_lm_prefix and
                                (display_exact_key_has_text(normalized_pinyin,
                                current_text_local) or
                                display_candidate_has_supported_full_entry(
                                normalized_pinyin, current_top_candidate) or
                                current_complete_has_backed_path_local)
                            )
                        );
                    Exit;
                end;

                current_tail_units_local :=
                    get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(
                    Trim(current_top_candidate.comment)));
                if (current_tail_units_local <= 0) or
                    (current_text_units_local + current_tail_units_local <>
                    expected_units) or
                    (current_text_units_local <= forced_text_units_local) then
                begin
                    Exit;
                end;

                current_prefix_key_local := build_display_query_key(0,
                    current_text_units_local);
                Result := (current_prefix_key_local <> '') and
                    display_exact_key_has_text(current_prefix_key_local,
                    current_text_local);
            end;
        begin
            if (page_size <= 0) or (not forced_visible_top_candidate_applies) then
            begin
                Exit;
            end;

            // A preserved partial must not override an explicit full user word.
            if (Length(Result) > 0) and (Result[0].source = cs_user) and
                is_protected_full_query_exact_local(Result[0]) then
            begin
                Exit;
            end;

            { A forced incremental prefix must not displace a full exact or a
              longer exact phrase prefix that explains more input syllables. }
            attested_particle_winner_local := '';
            if (expected_units = 4) and
                (m_lookup_query_latest_text_cache <> nil) then
                m_lookup_query_latest_text_cache.TryGetValue(
                    'S43W' + #1 + normalized_pinyin,
                    attested_particle_winner_local);
            if (expected_units = 5) and
                (m_lookup_query_latest_text_cache <> nil) then
                m_lookup_query_latest_text_cache.TryGetValue(
                    'S5PW' + #1 + normalized_pinyin,
                    attested_particle_winner_local);
            superseding_idx_local := -1;
            for candidate_idx_local := 0 to High(Result) do
            begin
                if ((Trim(Result[candidate_idx_local].comment) <> '') or
                    m_forced_visible_top_from_incremental_lm_prefix) and
                    current_top_supersedes_forced_partial_local(
                    Result[candidate_idx_local], candidate_idx_local) then
                begin
                    if superseding_idx_local < 0 then
                    begin
                        superseding_idx_local := candidate_idx_local;
                    end;
                    // More input can overturn a prefix prediction. Respect
                    // the full-phrase decision instead of freezing that prefix.
                    if (attested_particle_winner_local <> '') and
                        (Result[candidate_idx_local].comment = '') and
                        (Result[candidate_idx_local].text =
                        attested_particle_winner_local) then
                    begin
                        superseding_idx_local := candidate_idx_local;
                        Break;
                    end;
                    // A complete candidate that directly extends the
                    // preserved LM prefix is the authoritative repair. Only
                    // fall back to an unrelated backed path when no such
                    // extension exists.
                    if (attested_particle_winner_local = '') and
                        (Trim(Result[candidate_idx_local].comment) = '') and
                        (Copy(Trim(Result[candidate_idx_local].text), 1,
                        Length(Trim(m_forced_visible_top_candidate.text))) =
                        Trim(m_forced_visible_top_candidate.text)) then
                    begin
                        superseding_idx_local := candidate_idx_local;
                        Break;
                    end;
                end;
            end;
            if superseding_idx_local >= 0 then
            begin
                if superseding_idx_local > 0 then
                begin
                    tmp_candidate_local := Result[superseding_idx_local];
                    tmp_source_idx_local :=
                        visible_source_indices[superseding_idx_local];
                    for candidate_idx_local := superseding_idx_local downto 1 do
                    begin
                        Result[candidate_idx_local] :=
                            Result[candidate_idx_local - 1];
                        visible_source_indices[candidate_idx_local] :=
                            visible_source_indices[candidate_idx_local - 1];
                    end;
                    Result[0] := tmp_candidate_local;
                    visible_source_indices[0] := tmp_source_idx_local;
                end;

                { The complete path wins, but the preserved LM prefix remains
                  the longest partial and therefore belongs immediately after
                  it rather than disappearing from the visible page. }
                if (page_size > 1) and
                    m_forced_visible_top_from_incremental_lm_prefix then
                begin
                    forced_idx_local := -1;
                    for candidate_idx_local := 1 to High(Result) do
                    begin
                        if same_visible_candidate_local(
                            Result[candidate_idx_local],
                            m_forced_visible_top_candidate) then
                        begin
                            forced_idx_local := candidate_idx_local;
                            Break;
                        end;
                    end;
                    forced_source_idx_local :=
                        find_forced_visible_top_source_index;

                    if forced_idx_local < 0 then
                    begin
                        if Length(Result) < page_size then
                        begin
                            SetLength(Result, Length(Result) + 1);
                            SetLength(visible_source_indices,
                                Length(visible_source_indices) + 1);
                        end;
                        for candidate_idx_local := High(Result) downto 2 do
                        begin
                            Result[candidate_idx_local] :=
                                Result[candidate_idx_local - 1];
                            visible_source_indices[candidate_idx_local] :=
                                visible_source_indices[candidate_idx_local - 1];
                        end;
                        Result[1] := m_forced_visible_top_candidate;
                        visible_source_indices[1] := forced_source_idx_local;
                    end
                    else if forced_idx_local > 1 then
                    begin
                        tmp_candidate_local := Result[forced_idx_local];
                        tmp_source_idx_local :=
                            visible_source_indices[forced_idx_local];
                        for candidate_idx_local := forced_idx_local downto 2 do
                        begin
                            Result[candidate_idx_local] :=
                                Result[candidate_idx_local - 1];
                            visible_source_indices[candidate_idx_local] :=
                                visible_source_indices[candidate_idx_local - 1];
                        end;
                        Result[1] := tmp_candidate_local;
                        visible_source_indices[1] := tmp_source_idx_local;
                    end;

                    if m_forced_visible_top_candidate.display_kind =
                        cdk_lm_compound then
                    begin
                        Result[1].display_kind := cdk_lm_compound;
                    end;
                end;
                Exit;
            end;

            if (Length(Result) > 0) and
                current_top_supersedes_forced_partial_local(Result[0], 0) then
            begin
                Exit;
            end;

            forced_source_idx_local := find_forced_visible_top_source_index;
            if (Length(Result) > 0) and
                same_visible_candidate_local(Result[0],
                m_forced_visible_top_candidate) then
            begin
                if m_forced_visible_top_candidate.display_kind =
                    cdk_lm_compound then
                begin
                    Result[0].display_kind := cdk_lm_compound;
                end;
                if Length(visible_source_indices) > 0 then
                begin
                    visible_source_indices[0] := forced_source_idx_local;
                end;
                Exit;
            end;

            forced_idx_local := -1;
            for candidate_idx_local := 0 to High(Result) do
            begin
                if same_visible_candidate_local(Result[candidate_idx_local],
                    m_forced_visible_top_candidate) then
                begin
                    forced_idx_local := candidate_idx_local;
                    Break;
                end;
            end;

            if forced_idx_local > 0 then
            begin
                tmp_candidate_local := Result[forced_idx_local];
                if m_forced_visible_top_candidate.display_kind =
                    cdk_lm_compound then
                begin
                    tmp_candidate_local.display_kind := cdk_lm_compound;
                end;
                tmp_source_idx_local := -1;
                if forced_idx_local < Length(visible_source_indices) then
                begin
                    tmp_source_idx_local := visible_source_indices[forced_idx_local];
                end;
                for candidate_idx_local := forced_idx_local downto 1 do
                begin
                    Result[candidate_idx_local] := Result[candidate_idx_local - 1];
                    if candidate_idx_local < Length(visible_source_indices) then
                    begin
                        visible_source_indices[candidate_idx_local] :=
                            visible_source_indices[candidate_idx_local - 1];
                    end;
                end;
                Result[0] := tmp_candidate_local;
                if Length(visible_source_indices) > 0 then
                begin
                    visible_source_indices[0] := tmp_source_idx_local;
                end;
                Exit;
            end;

            if Length(Result) < page_size then
            begin
                SetLength(Result, Length(Result) + 1);
                SetLength(visible_source_indices, Length(Result));
            end;
            for candidate_idx_local := High(Result) downto 1 do
            begin
                Result[candidate_idx_local] := Result[candidate_idx_local - 1];
                visible_source_indices[candidate_idx_local] :=
                    visible_source_indices[candidate_idx_local - 1];
            end;
            if Length(Result) > 0 then
            begin
                Result[0] := m_forced_visible_top_candidate;
                visible_source_indices[0] := forced_source_idx_local;
            end;
        end;

        procedure demote_visible_long_sentence_partials_below_complete;
        var
            idx_local: Integer;
            write_idx_local: Integer;
            complete_count_local: Integer;
            partial_count_local: Integer;
            ordered_candidates_local: TArray<TncCandidate>;
            ordered_sources_local: TArray<Integer>;

            function is_visible_full_complete_local(
                const candidate_value: TncCandidate): Boolean;
            begin
                Result := (expected_units >= 6) and
                    (Trim(candidate_value.comment) = '') and
                    (get_candidate_text_unit_count(Trim(candidate_value.text)) =
                    expected_units);
            end;

            function is_visible_long_partial_local(
                const candidate_value: TncCandidate): Boolean;
            var
                text_units_local: Integer;
                comment_units_local: Integer;
            begin
                Result := False;
                if (expected_units < 6) or (Trim(candidate_value.comment) = '') then
                begin
                    Exit;
                end;

                text_units_local := get_candidate_text_unit_count(
                    Trim(candidate_value.text));
                comment_units_local := get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(Trim(candidate_value.comment)));
                Result := (text_units_local >= 3) and (comment_units_local > 0) and
                    (text_units_local + comment_units_local = expected_units);
            end;
        begin
            if (expected_units < 6) or short_exact_query_mode or
                (Length(Result) < 3) then
            begin
                Exit;
            end;

            complete_count_local := 0;
            partial_count_local := 0;
            for idx_local := 0 to High(Result) do
            begin
                if is_visible_full_complete_local(Result[idx_local]) then
                begin
                    Inc(complete_count_local);
                    Continue;
                end;

                if is_visible_long_partial_local(Result[idx_local]) then
                begin
                    Inc(partial_count_local);
                    Continue;
                end;

            end;

            if (complete_count_local <= 0) or (partial_count_local = 0) or
                (Length(Result) <= 1) then
            begin
                Exit;
            end;

            SetLength(ordered_candidates_local, Length(Result));
            SetLength(ordered_sources_local, Length(Result));
            write_idx_local := 0;
            for idx_local := 0 to High(Result) do
            begin
                if is_visible_full_complete_local(Result[idx_local]) then
                begin
                    ordered_candidates_local[write_idx_local] := Result[idx_local];
                    ordered_sources_local[write_idx_local] :=
                        visible_source_indices[idx_local];
                    Inc(write_idx_local);
                end;
            end;
            for idx_local := 0 to High(Result) do
            begin
                if is_visible_long_partial_local(Result[idx_local]) then
                begin
                    ordered_candidates_local[write_idx_local] := Result[idx_local];
                    ordered_sources_local[write_idx_local] :=
                        visible_source_indices[idx_local];
                    Inc(write_idx_local);
                end;
            end;
            for idx_local := 0 to High(Result) do
            begin
                if (not is_visible_full_complete_local(Result[idx_local])) and
                    (not is_visible_long_partial_local(Result[idx_local])) then
                begin
                    ordered_candidates_local[write_idx_local] := Result[idx_local];
                    ordered_sources_local[write_idx_local] :=
                        visible_source_indices[idx_local];
                    Inc(write_idx_local);
                end;
            end;

            for idx_local := 0 to High(Result) do
            begin
                Result[idx_local] := ordered_candidates_local[idx_local];
                visible_source_indices[idx_local] := ordered_sources_local[idx_local];
            end;
        end;

        procedure promote_visible_pathful_complete_over_unbacked_generated_top;
        const
            c_probe_limit = 5;
            c_max_score_deficit = 150000;
            c_min_candidate_segments = 4;
        var
            idx_local: Integer;
            best_idx_local: Integer;
            best_rank_local: Integer;
            candidate_rank_local: Integer;
            top_path_local: string;
            candidate_path_local: string;
            candidate_segments_local: Integer;
            candidate_source_idx_local: Integer;
            move_idx_local: Integer;
            picked_candidate_local: TncCandidate;
            picked_source_idx_local: Integer;

            function visible_candidate_path_local(
                const candidate_value: TncCandidate;
                const source_idx_value: Integer): string;
            var
                inferred_score_local: Integer;
                inferred_count_local: Integer;
            begin
                Result := '';
                if source_idx_value >= 0 then
                begin
                    Result := get_display_candidate_path_for_index(
                        candidate_value, source_idx_value);
                end;
                if (Result = '') and (normalized_pinyin <> '') then
                begin
                    Result := infer_segment_path_for_query_text_with_score(
                        normalized_pinyin, Trim(candidate_value.text),
                        inferred_score_local, inferred_count_local);
                end;
            end;
        begin
            if short_exact_query_mode or (expected_units < 6) or
                (Length(Result) < 2) or (Trim(Result[0].comment) <> '') or
                (get_candidate_text_unit_count(Trim(Result[0].text)) <>
                expected_units) then
            begin
                Exit;
            end;

            top_path_local := visible_candidate_path_local(Result[0],
                visible_source_indices[0]);
            if get_encoded_path_segment_count_local(top_path_local) > 1 then
            begin
                Exit;
            end;
            if (normalized_pinyin <> '') and
                display_exact_key_has_text(normalized_pinyin, Trim(Result[0].text)) then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_rank_local := Low(Integer);
            for idx_local := 1 to Min(c_probe_limit - 1, High(Result)) do
            begin
                if (Trim(Result[idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(Trim(Result[idx_local].text)) <>
                    expected_units) or
                    (Result[idx_local].score + c_max_score_deficit <
                    Result[0].score) then
                begin
                    Continue;
                end;

                candidate_source_idx_local := -1;
                if idx_local < Length(visible_source_indices) then
                begin
                    candidate_source_idx_local := visible_source_indices[idx_local];
                end;
                candidate_path_local := visible_candidate_path_local(
                    Result[idx_local], candidate_source_idx_local);
                candidate_segments_local :=
                    get_encoded_path_segment_count_local(candidate_path_local);
                if candidate_segments_local < c_min_candidate_segments then
                begin
                    Continue;
                end;

                candidate_rank_local := candidate_segments_local * 1000 +
                    Result[idx_local].score div 64;
                if candidate_source_idx_local >= 0 then
                begin
                    Inc(candidate_rank_local, 100);
                end;

                if candidate_rank_local > best_rank_local then
                begin
                    best_rank_local := candidate_rank_local;
                    best_idx_local := idx_local;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            picked_candidate_local := Result[best_idx_local];
            picked_source_idx_local := visible_source_indices[best_idx_local];
            for move_idx_local := best_idx_local downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[0] := picked_candidate_local;
            visible_source_indices[0] := picked_source_idx_local;
        end;

        procedure promote_visible_higher_scored_complete_long_candidate;
        const
            c_probe_limit = 6;
            c_min_score_gain = 12000;
            c_min_coverage_gain = 1200;
            c_max_score_deficit = 120000;
            c_min_protected_exact_weight = 700;
            c_protected_exact_margin = 80;
            c_min_pathless_over_pathful_score_gain = 40000;
            c_min_pathless_over_pathful_coverage_gain = 8000;
        var
            best_idx_local: Integer;
            best_score_local: Integer;
            best_metric_local: Integer;
            score_best_idx_local: Integer;
            score_best_score_local: Integer;
            candidate_idx_local: Integer;
            candidate_score_local: Integer;
            top_coverage_local: Integer;
            candidate_coverage_local: Integer;
            candidate_metric_local: Integer;
            move_idx_local: Integer;
            picked_candidate_local: TncCandidate;
            picked_source_idx_local: Integer;
            top_path_segments_local: Integer;
            candidate_path_segments_local: Integer;
            top_effective_score_local: Integer;
            candidate_text_local: string;
            weak_pathless_over_pathful_local: Boolean;

            function is_complete_long_candidate_local(
                const candidate_value: TncCandidate): Boolean;
            var
                text_local: string;
            begin
                text_local := Trim(candidate_value.text);
                Result := (text_local <> '') and
                    (Trim(candidate_value.comment) = '') and
                    (get_candidate_text_unit_count(text_local) = expected_units);
            end;

            function effective_score_local(
                const candidate_value: TncCandidate): Integer;
            begin
                Result := candidate_value.score;
                if candidate_value.has_dict_weight and
                    (candidate_value.dict_weight > Result) then
                begin
                    Result := candidate_value.dict_weight;
                end;
                if candidate_value.source = cs_user then
                begin
                    Inc(Result, c_user_score_bonus);
                end;
            end;

            function candidate_replaces_stronger_same_position_exact_local(
                const top_candidate_local: TncCandidate;
                const candidate_value: TncCandidate): Boolean;
            const
                c_max_span_units = 4;
            var
                top_units_local: TArray<string>;
                candidate_units_local: TArray<string>;
                diff_idx_local: Integer;
                span_len_local: Integer;
                start_idx_local: Integer;
                query_key_local: string;
                top_span_text_local: string;
                candidate_span_text_local: string;
                top_span_weight_local: Integer;
                candidate_span_weight_local: Integer;

                function join_units_range_local(const units_value: TArray<string>;
                    const range_start_local: Integer;
                    const range_len_local: Integer): string;
                var
                    local_idx: Integer;
                begin
                    Result := '';
                    if (range_start_local < 0) or (range_len_local <= 0) or
                        (range_start_local + range_len_local > Length(units_value)) then
                    begin
                        Exit;
                    end;
                    for local_idx := range_start_local to
                        range_start_local + range_len_local - 1 do
                    begin
                        Result := Result + units_value[local_idx];
                    end;
                end;
            begin
                Result := False;
                top_units_local := split_text_units(Trim(top_candidate_local.text));
                candidate_units_local := split_text_units(Trim(candidate_value.text));
                if (Length(top_units_local) <> expected_units) or
                    (Length(candidate_units_local) <> expected_units) then
                begin
                    Exit;
                end;

                for diff_idx_local := 0 to expected_units - 1 do
                begin
                    if SameText(top_units_local[diff_idx_local],
                        candidate_units_local[diff_idx_local]) then
                    begin
                        Continue;
                    end;

                    for span_len_local := 2 to Min(c_max_span_units,
                        expected_units) do
                    begin
                        for start_idx_local := Max(0,
                            diff_idx_local - span_len_local + 1) to
                            Min(diff_idx_local,
                            expected_units - span_len_local) do
                        begin
                            query_key_local := build_display_query_key(
                                start_idx_local, span_len_local);
                            top_span_text_local := join_units_range_local(
                                top_units_local, start_idx_local,
                                span_len_local);
                            candidate_span_text_local := join_units_range_local(
                                candidate_units_local, start_idx_local,
                                span_len_local);
                            if SameText(top_span_text_local,
                                candidate_span_text_local) then
                            begin
                                Continue;
                            end;

                            top_span_weight_local := 0;
                            candidate_span_weight_local := 0;
                            if (query_key_local <> '') and
                                get_display_exact_text_weight(query_key_local,
                                top_span_text_local, span_len_local,
                                top_span_weight_local) and
                                get_display_exact_text_weight(query_key_local,
                                candidate_span_text_local, span_len_local,
                                candidate_span_weight_local) and
                                (top_span_weight_local >=
                                c_min_protected_exact_weight) and
                                (top_span_weight_local >=
                                candidate_span_weight_local +
                                c_protected_exact_margin) then
                            begin
                                Exit(True);
                            end;
                        end;
                    end;
                end;
            end;

            function visible_candidate_path_segment_count_local(
                const candidate_value: TncCandidate;
                const visible_idx_local: Integer): Integer;
            var
                source_idx_local: Integer;
                path_local: string;
            begin
                path_local := '';
                source_idx_local := -1;
                if visible_idx_local < Length(visible_source_indices) then
                begin
                    source_idx_local := visible_source_indices[visible_idx_local];
                end;
                if source_idx_local >= 0 then
                begin
                    if source_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        path_local := m_candidate_segment_paths[source_idx_local];
                    end;
                    if path_local = '' then
                    begin
                        path_local := get_segment_path_for_candidate(
                            candidate_value, source_idx_local);
                    end;
                end;
                if path_local = '' then
                begin
                    path_local := get_segment_path_for_candidate(
                        candidate_value, source_idx_local);
                end;
                Result := get_encoded_path_segment_count_local(path_local);
            end;
        begin
            if short_exact_query_mode or (expected_units < 6) or
                (Length(Result) < 2) or (Result[0].source = cs_user) or
                (not is_complete_long_candidate_local(Result[0])) then
            begin
                Exit;
            end;

            top_effective_score_local := effective_score_local(Result[0]);
            top_path_segments_local :=
                visible_candidate_path_segment_count_local(Result[0], 0);
            best_idx_local := 0;
            best_score_local := top_effective_score_local;
            score_best_idx_local := 0;
            score_best_score_local := best_score_local;
            top_coverage_local :=
                get_display_complete_exact_span_coverage_score(Result[0]);
            best_metric_local := top_coverage_local + best_score_local div 12;
            for candidate_idx_local := 1 to Min(c_probe_limit - 1,
                High(Result)) do
            begin
                if not is_complete_long_candidate_local(
                    Result[candidate_idx_local]) then
                begin
                    Continue;
                end;

                candidate_score_local := effective_score_local(
                    Result[candidate_idx_local]);
                candidate_text_local := Trim(Result[candidate_idx_local].text);
                candidate_path_segments_local :=
                    visible_candidate_path_segment_count_local(
                    Result[candidate_idx_local], candidate_idx_local);
                weak_pathless_over_pathful_local :=
                    (top_path_segments_local > 1) and
                    (candidate_path_segments_local <= 1) and
                    ((normalized_pinyin = '') or
                    (not display_exact_key_has_text(normalized_pinyin,
                    candidate_text_local))) and
                    (candidate_score_local < top_effective_score_local +
                    c_min_pathless_over_pathful_score_gain);

                if (not weak_pathless_over_pathful_local) and
                    (candidate_score_local > score_best_score_local) then
                begin
                    score_best_score_local := candidate_score_local;
                    score_best_idx_local := candidate_idx_local;
                end;
                candidate_coverage_local :=
                    get_display_complete_exact_span_coverage_score(
                    Result[candidate_idx_local]);
                candidate_metric_local := candidate_coverage_local +
                    candidate_score_local div 12;
                if (candidate_coverage_local >= top_coverage_local +
                    c_min_coverage_gain) and
                    ((not weak_pathless_over_pathful_local) or
                    (candidate_coverage_local >= top_coverage_local +
                    c_min_pathless_over_pathful_coverage_gain)) and
                    (candidate_score_local + c_max_score_deficit >=
                    best_score_local) and
                    (not candidate_replaces_stronger_same_position_exact_local(
                    Result[0], Result[candidate_idx_local])) and
                    (not display_candidate_replaces_protected_conjunction_boundary(
                    Result[candidate_idx_local])) and
                    (candidate_metric_local > best_metric_local) then
                begin
                    best_metric_local := candidate_metric_local;
                    best_score_local := candidate_score_local;
                    best_idx_local := candidate_idx_local;
                end;
            end;

            if (best_idx_local <= 0) and (score_best_idx_local > 0) and
                (score_best_score_local >= effective_score_local(Result[0]) +
                c_min_score_gain) then
            begin
                best_idx_local := score_best_idx_local;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            picked_candidate_local := Result[best_idx_local];
            picked_source_idx_local := visible_source_indices[best_idx_local];
            for move_idx_local := best_idx_local downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[0] := picked_candidate_local;
            visible_source_indices[0] := picked_source_idx_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' vhscore=[idx=%d text=%s]',
                    [best_idx_local, Trim(Result[0].text)]);
            end;
        end;

        procedure promote_visible_short_particle_tail_completion_over_partial;
        var
            partial_idx_local: Integer;
            complete_idx_local: Integer;
            move_idx_local: Integer;
            partial_text_local: string;
            tail_key_local: string;
            tail_text_local: string;
            complete_text_local: string;
            moved_candidate_local: TncCandidate;
            moved_source_idx_local: Integer;

            function particle_tail_text_local(const tail_key_value: string): string;
            begin
                Result := '';
                if tail_key_value = 'de' then
                begin
                    Result := string(Char($7684));
                end
                else if tail_key_value = 'le' then
                begin
                    Result := string(Char($4E86));
                end
                else if tail_key_value = 'zhe' then
                begin
                    Result := string(Char($7740));
                end
                else if tail_key_value = 'la' then
                begin
                    Result := string(Char($5566));
                end
                else if tail_key_value = 'ba' then
                begin
                    Result := string(Char($5427));
                end
                else if tail_key_value = 'ma' then
                begin
                    Result := string(Char($5417));
                end
                else if tail_key_value = 'a' then
                begin
                    Result := string(Char($554A));
                end
                else if tail_key_value = 'hao' then
                begin
                    Result := string(Char($597D));
                end;
            end;

            function text_ends_with_tail_particle_local(
                const text_value: string; const tail_text_value: string): Boolean;
            var
                trimmed_text_local: string;
                last_char_local: string;
            begin
                Result := False;
                trimmed_text_local := Trim(text_value);
                if (trimmed_text_local = '') or (tail_text_value = '') then
                begin
                    Exit;
                end;
                last_char_local := Copy(trimmed_text_local,
                    Length(trimmed_text_local), 1);
                Result := SameText(last_char_local, tail_text_value);
            end;
        begin
            for partial_idx_local := 0 to High(Result) do
            begin
                tail_key_local := normalize_pinyin_text(
                    Trim(Result[partial_idx_local].comment));
                if tail_key_local = '' then
                begin
                    Continue;
                end;

                tail_text_local := particle_tail_text_local(tail_key_local);
                if tail_text_local = '' then
                begin
                    Continue;
                end;

                partial_text_local := Trim(Result[partial_idx_local].text);
                if (get_candidate_text_unit_count(partial_text_local) < 2) or
                    (get_candidate_text_unit_count(partial_text_local) > 3) or
                    text_ends_with_tail_particle_local(partial_text_local,
                    tail_text_local) then
                begin
                    Continue;
                end;

                if SameText(tail_key_local, 'hao') and
                    (not text_ends_with_tail_particle_local(partial_text_local,
                    string(Char($5F97)))) then
                begin
                    Continue;
                end;

                complete_text_local := partial_text_local + tail_text_local;
                for complete_idx_local := partial_idx_local + 1 to High(Result) do
                begin
                    if (Trim(Result[complete_idx_local].comment) = '') and
                        SameText(Trim(Result[complete_idx_local].text),
                        complete_text_local) then
                    begin
                        moved_candidate_local := Result[complete_idx_local];
                        moved_source_idx_local := visible_source_indices[
                            complete_idx_local];
                        for move_idx_local := complete_idx_local downto
                            partial_idx_local + 1 do
                        begin
                            Result[move_idx_local] := Result[move_idx_local - 1];
                            visible_source_indices[move_idx_local] :=
                                visible_source_indices[move_idx_local - 1];
                        end;
                        Result[partial_idx_local] := moved_candidate_local;
                        visible_source_indices[partial_idx_local] :=
                            moved_source_idx_local;
                        Break;
                    end;
                end;
            end;
        end;

        procedure supplement_visible_short_prefix_exact_alternatives;
        const
            c_probe_limit = 8;
            c_max_added_per_prefix = 4;
        var
            base_idx_local: Integer;
            exact_idx_local: Integer;
            existing_idx_local: Integer;
            insert_pos_local: Integer;
            added_count_local: Integer;
            prefix_units_local: Integer;
            tail_units_local: Integer;
            prefix_key_local: string;
            tail_key_local: string;
            candidate_tail_local: string;
            suffix_key_local: string;
            exact_results_local: TncCandidateList;
            exact_text_local: string;
            new_candidate_local: TncCandidate;
            moved_candidate_local: TncCandidate;
            moved_source_local: Integer;
            base_exact_idx_local: Integer;

            procedure find_visible_candidate_index_local(const local_text: string;
                const local_comment: string; out out_idx: Integer);
            var
                local_idx: Integer;
            begin
                out_idx := -1;
                for local_idx := 0 to High(Result) do
                begin
                    if SameText(Trim(Result[local_idx].text), local_text) and
                        SameText(Trim(Result[local_idx].comment),
                        local_comment) then
                    begin
                        out_idx := local_idx;
                        Exit;
                    end;
                end;
            end;

            function exact_results_contain_text_local(
                const local_text: string): Boolean;
            var
                local_idx: Integer;
            begin
                Result := False;
                for local_idx := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[local_idx].comment) = '') and
                        SameText(Trim(exact_results_local[local_idx].text),
                        local_text) and
                        (get_candidate_text_unit_count(
                        Trim(exact_results_local[local_idx].text)) =
                        prefix_units_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function exact_text_index_local(const local_text: string): Integer;
            var
                local_idx: Integer;
            begin
                Result := -1;
                for local_idx := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[local_idx].comment) = '') and
                        SameText(Trim(exact_results_local[local_idx].text),
                        local_text) and
                        (get_candidate_text_unit_count(
                        Trim(exact_results_local[local_idx].text)) =
                        prefix_units_local) then
                    begin
                        Exit(local_idx);
                    end;
                end;
            end;

            function visible_candidate_is_same_prefix_partial_local(
                const local_candidate: TncCandidate): Boolean;
            var
                local_text: string;
                local_comment: string;
                local_units: Integer;
            begin
                local_text := Trim(local_candidate.text);
                local_comment := normalize_pinyin_text(
                    Trim(local_candidate.comment));
                local_units := get_candidate_text_unit_count(local_text);
                Result := (local_text <> '') and
                    SameText(local_comment, tail_key_local) and
                    (local_units = prefix_units_local) and
                    exact_results_contain_text_local(local_text);
            end;

            procedure remove_visible_candidate_local(const local_idx: Integer);
            var
                move_idx: Integer;
            begin
                if (local_idx < 0) or (local_idx > High(Result)) then
                begin
                    Exit;
                end;
                for move_idx := local_idx to High(Result) - 1 do
                begin
                    Result[move_idx] := Result[move_idx + 1];
                    visible_source_indices[move_idx] :=
                        visible_source_indices[move_idx + 1];
                end;
                SetLength(Result, Length(Result) - 1);
                SetLength(visible_source_indices, Length(visible_source_indices) - 1);
            end;

            procedure insert_visible_candidate_local(const local_idx: Integer;
                const local_candidate: TncCandidate;
                const local_source_idx: Integer);
            var
                old_len: Integer;
                new_len: Integer;
                insert_idx: Integer;
                move_idx: Integer;
            begin
                if visible_page_size <= 0 then
                begin
                    Exit;
                end;
                old_len := Length(Result);
                if old_len < visible_page_size then
                begin
                    new_len := old_len + 1;
                end
                else
                begin
                    new_len := old_len;
                end;
                if new_len <= 0 then
                begin
                    Exit;
                end;

                insert_idx := local_idx;
                if insert_idx < 0 then
                begin
                    insert_idx := 0;
                end
                else if insert_idx >= new_len then
                begin
                    insert_idx := new_len - 1;
                end;

                SetLength(Result, new_len);
                SetLength(visible_source_indices, new_len);
                for move_idx := new_len - 1 downto insert_idx + 1 do
                begin
                    Result[move_idx] := Result[move_idx - 1];
                    visible_source_indices[move_idx] :=
                        visible_source_indices[move_idx - 1];
                end;
                Result[insert_idx] := local_candidate;
                visible_source_indices[insert_idx] := local_source_idx;
            end;

            function is_number_unit_for_prefix_partial_local(
                const unit_value: string): Boolean;
            begin
                Result := False;
                if (unit_value = '') or
                    (get_candidate_text_unit_count(unit_value) <> 1) then
                begin
                    Exit;
                end;
                case Ord(unit_value[1]) of
                    $4E00, $4E8C, $4E24, $4FE9, $4E09, $56DB, $4E94,
                    $516D, $4E03, $516B, $4E5D, $5341, $51E0, $534A:
                        Result := True;
                end;
            end;

            function is_classifier_unit_for_prefix_partial_local(
                const unit_value: string): Boolean;
            begin
                Result := False;
                if (unit_value = '') or
                    (get_candidate_text_unit_count(unit_value) <> 1) then
                begin
                    Exit;
                end;
                case Ord(unit_value[1]) of
                    $4E2A, $6761, $53EA, $672C, $53F0, $90E8, $6279,
                    $5339, $6839, $7247, $9875, $4EF6, $9879, $6B21,
                    $6B65, $8F6E, $628A, $526F, $5BF9, $53CC, $74F6,
                    $6876, $76D8, $6247, $95E8, $5B57, $884C, $5217,
                    $5C42, $7AE0, $8282, $6BB5, $680B, $5E62:
                        Result := True;
                end;
            end;

            function is_rejected_quantity_partial_local(
                const text_value: string;
                const tail_key_value: string): Boolean;
            var
                units_local: TArray<string>;
                normalized_tail_local: string;
            begin
                normalized_tail_local := normalize_pinyin_text(tail_key_value);
                if (normalized_tail_local <> 'dao') and
                    (normalized_tail_local <> 'da') and
                    (normalized_tail_local <> 'd') and
                    (normalized_tail_local <> 'le') and
                    (normalized_tail_local <> 'de') and
                    (normalized_tail_local <> 'guo') and
                    (normalized_tail_local <> 'zhe') and
                    (normalized_tail_local <> 'ma') and
                    (normalized_tail_local <> 'ba') and
                    (normalized_tail_local <> 'ne') and
                    (normalized_tail_local <> 'a') and
                    (normalized_tail_local <> 'ya') and
                    (normalized_tail_local <> 'la') then
                begin
                    Exit(False);
                end;
                units_local := split_text_units(Trim(text_value));
                Result := (Length(units_local) = 2) and
                    is_number_unit_for_prefix_partial_local(units_local[0]) and
                    is_classifier_unit_for_prefix_partial_local(units_local[1]);
            end;

            procedure supplement_direct_exact_prefixes_local;
            const
                c_max_direct_added = 4;
            var
                direct_prefix_units_local: Integer;
                direct_tail_units_local: Integer;
                direct_exact_idx_local: Integer;
                direct_existing_idx_local: Integer;
                direct_source_idx_local: Integer;
                direct_scan_idx_local: Integer;
                direct_insert_pos_local: Integer;
                direct_added_local: Integer;
                direct_min_prefix_units_local: Integer;
                direct_visible_prefix_units_local: Integer;
                direct_visible_tail_units_local: Integer;
                direct_prefix_key_local: string;
                direct_tail_key_local: string;
                direct_exact_text_local: string;
                direct_exact_results_local: TncCandidateList;
                direct_candidate_local: TncCandidate;
                direct_moved_candidate_local: TncCandidate;
                direct_moved_source_local: Integer;
                direct_found_for_length_local: Boolean;

                function find_source_candidate_index_local(
                    const local_text: string;
                    const local_comment: string): Integer;
                var
                    local_idx: Integer;
                begin
                    Result := -1;
                    for local_idx := 0 to High(m_candidates) do
                    begin
                        if SameText(Trim(m_candidates[local_idx].text),
                            local_text) and
                            SameText(normalize_pinyin_text(
                            Trim(m_candidates[local_idx].comment)),
                            local_comment) then
                        begin
                            Exit(local_idx);
                        end;
                    end;
                end;

            begin
                direct_added_local := 0;
                direct_insert_pos_local := 0;
                direct_min_prefix_units_local := 2;
                for direct_scan_idx_local := 0 to High(Result) do
                begin
                    direct_visible_prefix_units_local :=
                        get_candidate_text_unit_count(
                        Trim(Result[direct_scan_idx_local].text));
                    direct_visible_tail_units_local :=
                        get_effective_compact_pinyin_unit_count(
                        normalize_pinyin_text(
                        Trim(Result[direct_scan_idx_local].comment)));
                    if (direct_visible_tail_units_local > 0) and
                        (direct_visible_prefix_units_local +
                        direct_visible_tail_units_local = expected_units) and
                        (direct_visible_prefix_units_local >
                        direct_min_prefix_units_local) then
                    begin
                        direct_min_prefix_units_local :=
                            direct_visible_prefix_units_local;
                    end;
                end;
                while (direct_insert_pos_local < Length(Result)) and
                    (Trim(Result[direct_insert_pos_local].comment) = '') do
                begin
                    Inc(direct_insert_pos_local);
                end;
                if direct_insert_pos_local >= visible_page_size then
                begin
                    direct_insert_pos_local := Max(1,
                        visible_page_size - c_max_direct_added);
                end;

                if expected_units - 1 < direct_min_prefix_units_local then
                begin
                    Exit;
                end;
                for direct_prefix_units_local := expected_units - 1 downto
                    direct_min_prefix_units_local do
                begin
                    if direct_added_local >= c_max_direct_added then
                    begin
                        Break;
                    end;
                    direct_tail_units_local := expected_units -
                        direct_prefix_units_local;
                    direct_prefix_key_local := build_display_query_key(0,
                        direct_prefix_units_local);
                    direct_tail_key_local := build_display_query_key(
                        direct_prefix_units_local, direct_tail_units_local);
                    if (direct_prefix_key_local = '') or
                        (direct_tail_key_local = '') or
                        (not lookup_display_exact_cached(
                        direct_prefix_key_local, direct_exact_results_local)) then
                    begin
                        Continue;
                    end;

                    normalize_learned_prefix_exact_scores(
                        direct_prefix_key_local, direct_exact_results_local);
                    direct_found_for_length_local := False;
                    for direct_exact_idx_local := 0 to
                        Min(c_probe_limit - 1,
                        High(direct_exact_results_local)) do
                    begin
                        direct_exact_text_local := Trim(
                            direct_exact_results_local[
                            direct_exact_idx_local].text);
                        if (Trim(direct_exact_results_local[
                            direct_exact_idx_local].comment) <> '') or
                            (direct_exact_text_local = '') or
                            (get_candidate_text_unit_count(
                            direct_exact_text_local) <>
                            direct_prefix_units_local) then
                        begin
                            Continue;
                        end;

                        if is_rejected_quantity_partial_local(
                            direct_exact_text_local,
                            direct_tail_key_local) then
                        begin
                            Continue;
                        end;

                        { Prefer an existing source candidate so selection keeps
                          its path metadata. Some exact prefixes are no longer
                          in the retained pool, so use the dictionary candidate
                          only after applying the same boundary rejection. }
                        direct_source_idx_local :=
                            find_source_candidate_index_local(
                            direct_exact_text_local, direct_tail_key_local);
                        if direct_source_idx_local >= 0 then
                        begin
                            direct_candidate_local :=
                                m_candidates[direct_source_idx_local];
                        end
                        else
                        begin
                            direct_candidate_local :=
                                direct_exact_results_local[
                                direct_exact_idx_local];
                            direct_candidate_local.comment :=
                                direct_tail_key_local;
                        end;

                        if display_candidate_should_drop_short_invalid_partial(
                            direct_candidate_local) then
                        begin
                            Continue;
                        end;
                        direct_found_for_length_local := True;
                        find_visible_candidate_index_local(
                            direct_exact_text_local, direct_tail_key_local,
                            direct_existing_idx_local);
                        if direct_existing_idx_local >= 0 then
                        begin
                            if direct_existing_idx_local >=
                                direct_insert_pos_local then
                            begin
                                direct_moved_candidate_local := Result[
                                    direct_existing_idx_local];
                                direct_moved_source_local :=
                                    visible_source_indices[
                                    direct_existing_idx_local];
                                remove_visible_candidate_local(
                                    direct_existing_idx_local);
                                insert_visible_candidate_local(
                                    direct_insert_pos_local,
                                    direct_moved_candidate_local,
                                    direct_moved_source_local);
                                Inc(direct_insert_pos_local);
                            end;
                            Continue;
                        end;

                        insert_visible_candidate_local(
                            direct_insert_pos_local, direct_candidate_local,
                            direct_source_idx_local);
                        Inc(direct_insert_pos_local);
                        Inc(direct_added_local);
                        if direct_added_local >= c_max_direct_added then
                        begin
                            Break;
                        end;
                    end;
                    if direct_found_for_length_local then
                    begin
                        Break;
                    end;
                end;
            end;
        begin
            if (m_page_index <> 0) or (m_dictionary = nil) or
                (expected_units < 3) or (expected_units > 5) or
                (not is_full_pinyin_key(normalized_pinyin)) or
                (Pos('''', m_last_lookup_key) > 0) or (Length(Result) = 0) then
            begin
                Exit;
            end;

            { Exact phrase prefixes must remain reachable even when an
              incremental fixed-head candidate and rich single-character
              fallbacks would otherwise occupy the whole first page. }
            supplement_direct_exact_prefixes_local;

            for base_idx_local := 0 to High(Result) do
            begin
                candidate_tail_local := Trim(Result[base_idx_local].comment);
                tail_key_local := normalize_pinyin_text(candidate_tail_local);
                if tail_key_local = '' then
                begin
                    Continue;
                end;

                prefix_units_local := get_candidate_text_unit_count(
                    Trim(Result[base_idx_local].text));
                tail_units_local := get_effective_compact_pinyin_unit_count(
                    tail_key_local);
                if (prefix_units_local < 2) or (tail_units_local <= 0) or
                    (prefix_units_local + tail_units_local <> expected_units) then
                begin
                    Continue;
                end;

                prefix_key_local := build_display_query_key(0,
                    prefix_units_local);
                suffix_key_local := build_display_query_key(prefix_units_local,
                    tail_units_local);
                if (prefix_key_local = '') or (suffix_key_local = '') or
                    (not SameText(suffix_key_local, tail_key_local)) or
                    (not lookup_display_exact_cached(prefix_key_local,
                    exact_results_local)) then
                begin
                    Continue;
                end;

                normalize_learned_prefix_exact_scores(prefix_key_local,
                    exact_results_local);
                base_exact_idx_local := exact_text_index_local(
                    Trim(Result[base_idx_local].text));
                if base_exact_idx_local < 0 then
                begin
                    Continue;
                end;

                insert_pos_local := base_idx_local + 1;
                while (insert_pos_local <= High(Result)) and
                    visible_candidate_is_same_prefix_partial_local(
                    Result[insert_pos_local]) do
                begin
                    Inc(insert_pos_local);
                end;

                added_count_local := 0;
                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if exact_idx_local >= c_probe_limit then
                    begin
                        Break;
                    end;
                    if exact_idx_local < base_exact_idx_local then
                    begin
                        Continue;
                    end;

                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                        (exact_text_local = '') or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        prefix_units_local) then
                    begin
                        Continue;
                    end;

                    new_candidate_local := exact_results_local[exact_idx_local];
                    new_candidate_local.comment := candidate_tail_local;
                    if is_rejected_quantity_partial_local(exact_text_local,
                        candidate_tail_local) or
                        display_candidate_should_drop_short_invalid_partial(
                        new_candidate_local) then
                    begin
                        Continue;
                    end;

                    find_visible_candidate_index_local(exact_text_local,
                        candidate_tail_local, existing_idx_local);
                    if existing_idx_local >= 0 then
                    begin
                        if existing_idx_local < insert_pos_local then
                        begin
                            Continue;
                        end;
                        moved_candidate_local := Result[existing_idx_local];
                        moved_source_local := visible_source_indices[existing_idx_local];
                        remove_visible_candidate_local(existing_idx_local);
                        insert_visible_candidate_local(insert_pos_local,
                            moved_candidate_local, moved_source_local);
                        Inc(insert_pos_local);
                        Continue;
                    end;

                    insert_visible_candidate_local(insert_pos_local,
                        new_candidate_local, -1);
                    Inc(insert_pos_local);
                    Inc(added_count_local);
                    if added_count_local >= c_max_added_per_prefix then
                    begin
                        Break;
                    end;
                end;
                Exit;
            end;
        end;

        procedure dedupe_visible_text_comment_candidates;
        var
            seen_keys_local: TDictionary<string, Boolean>;
            read_idx_local: Integer;
            write_idx_local: Integer;
            candidate_key_local: string;
        begin
            if Length(Result) <= 1 then
            begin
                Exit;
            end;

            seen_keys_local := TDictionary<string, Boolean>.Create;
            try
                write_idx_local := 0;
                for read_idx_local := 0 to High(Result) do
                begin
                    candidate_key_local := nc_visible_candidate_key(Result[read_idx_local],
                        normalize_pinyin_text(
                        Trim(Result[read_idx_local].comment)));
                    if (Trim(Result[read_idx_local].text) <> '') and
                        seen_keys_local.ContainsKey(candidate_key_local) then
                    begin
                        Continue;
                    end;

                    if Trim(Result[read_idx_local].text) <> '' then
                    begin
                        seen_keys_local.AddOrSetValue(candidate_key_local, True);
                    end;
                    if write_idx_local <> read_idx_local then
                    begin
                        Result[write_idx_local] := Result[read_idx_local];
                        visible_source_indices[write_idx_local] :=
                            visible_source_indices[read_idx_local];
                    end;
                    Inc(write_idx_local);
                end;
                if write_idx_local <> Length(Result) then
                begin
                    SetLength(Result, write_idx_local);
                    SetLength(visible_source_indices, write_idx_local);
                end;
            finally
                seen_keys_local.Free;
            end;
        end;

        procedure promote_visible_longest_exact_prefix_partial_local;
        var
            idx_local: Integer;
            move_idx_local: Integer;
            target_idx_local: Integer;
            best_idx_local: Integer;
            best_units_local: Integer;
            text_units_local: Integer;
            tail_units_local: Integer;
            prefix_key_local: string;
            support_path_local: string;
            support_score_local: Integer;
            support_segments_local: Integer;
            source_idx_local: Integer;
            picked_candidate_local: TncCandidate;
            picked_source_local: Integer;

            function candidate_has_supported_prefix_path_local(
                const candidate_idx: Integer;
                const query_key: string;
                const text_value: string): Boolean;
            begin
                Result := display_exact_key_has_text(query_key, text_value);
                if Result then
                begin
                    Exit;
                end;

                support_path_local := '';
                source_idx_local := -1;
                if candidate_idx < Length(visible_source_indices) then
                begin
                    source_idx_local := visible_source_indices[candidate_idx];
                end;
                if (source_idx_local >= 0) and
                    (source_idx_local < Length(m_candidates)) then
                begin
                    support_path_local := get_segment_path_for_candidate(
                        m_candidates[source_idx_local], source_idx_local);
                end;
                if get_encoded_path_segment_count_local(
                    support_path_local) > 1 then
                begin
                    Exit(True);
                end;

                support_path_local :=
                    infer_segment_path_for_query_text_with_score(query_key,
                    text_value, support_score_local,
                    support_segments_local, False);
                Result := (support_path_local <> '') and
                    (support_segments_local > 1);
            end;
        begin
            if (expected_units < 3) or (expected_units > 5) or
                (Length(Result) <= 1) or
                (not is_full_pinyin_key(normalized_pinyin)) then
            begin
                Exit;
            end;

            target_idx_local := 0;
            while (target_idx_local < Length(Result)) and
                (Trim(Result[target_idx_local].comment) = '') and
                (get_candidate_text_unit_count(
                Trim(Result[target_idx_local].text)) = expected_units) do
            begin
                Inc(target_idx_local);
            end;
            if target_idx_local >= Length(Result) then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_units_local := 1;
            for idx_local := target_idx_local to High(Result) do
            begin
                if Trim(Result[idx_local].comment) = '' then
                begin
                    Continue;
                end;
                text_units_local := get_candidate_text_unit_count(
                    Trim(Result[idx_local].text));
                tail_units_local := get_effective_compact_pinyin_unit_count(
                    normalize_pinyin_text(Trim(Result[idx_local].comment)));
                if (text_units_local <= best_units_local) or
                    (text_units_local + tail_units_local <> expected_units) then
                begin
                    Continue;
                end;
                prefix_key_local := build_display_query_key(0,
                    text_units_local);
                if (prefix_key_local = '') or
                    (not candidate_has_supported_prefix_path_local(idx_local,
                    prefix_key_local, Trim(Result[idx_local].text))) then
                begin
                    Continue;
                end;
                best_idx_local := idx_local;
                best_units_local := text_units_local;
            end;
            if best_idx_local <= target_idx_local then
            begin
                Exit;
            end;

            picked_candidate_local := Result[best_idx_local];
            picked_source_local := visible_source_indices[best_idx_local];
            for move_idx_local := best_idx_local downto target_idx_local + 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[target_idx_local] := picked_candidate_local;
            visible_source_indices[target_idx_local] := picked_source_local;
        end;

        procedure promote_visible_left_boundary_when_candidate_is_stronger;
        const
            c_probe_limit = 6;
            c_min_weight_slack = 16;
        var
            idx_local: Integer;
            boundary_idx_local: Integer;
            unit_idx_local: Integer;
            best_idx_local: Integer;
            best_rank_local: Integer;
            candidate_rank_local: Integer;
            top_units_local: TArray<string>;
            candidate_units_local: TArray<string>;
            top_right_text_local: string;
            candidate_left_text_local: string;
            top_right_key_local: string;
            candidate_left_key_local: string;
            top_right_weight_local: Integer;
            candidate_left_weight_local: Integer;
            move_idx_local: Integer;
            picked_candidate_local: TncCandidate;
            picked_source_idx_local: Integer;
            outside_same_local: Boolean;
        begin
            if short_exact_query_mode or (expected_units < 6) or
                (Length(Result) < 2) or (Trim(Result[0].comment) <> '') or
                (get_candidate_text_unit_count(Trim(Result[0].text)) <>
                expected_units) then
            begin
                Exit;
            end;

            top_units_local := split_text_units(Trim(Result[0].text));
            if Length(top_units_local) <> expected_units then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_rank_local := Low(Integer);
            for idx_local := 1 to Min(c_probe_limit - 1, High(Result)) do
            begin
                if (Trim(Result[idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(Trim(Result[idx_local].text)) <>
                    expected_units) or
                    (Result[idx_local].score < Result[0].score) then
                begin
                    Continue;
                end;

                candidate_units_local := split_text_units(Trim(Result[idx_local].text));
                if Length(candidate_units_local) <> expected_units then
                begin
                    Continue;
                end;

                for boundary_idx_local := 1 to expected_units - 2 do
                begin
                    if not SameText(top_units_local[boundary_idx_local - 1],
                        candidate_units_local[boundary_idx_local - 1]) then
                    begin
                        Continue;
                    end;

                    outside_same_local := True;
                    for unit_idx_local := 0 to expected_units - 1 do
                    begin
                        if (unit_idx_local >= boundary_idx_local - 1) and
                            (unit_idx_local <= boundary_idx_local + 1) then
                        begin
                            Continue;
                        end;
                        if not SameText(top_units_local[unit_idx_local],
                            candidate_units_local[unit_idx_local]) then
                        begin
                            outside_same_local := False;
                            Break;
                        end;
                    end;
                    if not outside_same_local then
                    begin
                        Continue;
                    end;

                    top_right_text_local := top_units_local[boundary_idx_local] +
                        top_units_local[boundary_idx_local + 1];
                    candidate_left_text_local :=
                        candidate_units_local[boundary_idx_local - 1] +
                        candidate_units_local[boundary_idx_local];
                    top_right_key_local := build_display_query_key(
                        boundary_idx_local, 2);
                    candidate_left_key_local := build_display_query_key(
                        boundary_idx_local - 1, 2);

                    if (top_right_key_local = '') or
                        (candidate_left_key_local = '') or
                        (not get_display_exact_text_weight(top_right_key_local,
                        top_right_text_local, 2, top_right_weight_local)) or
                        (not get_display_exact_text_weight(candidate_left_key_local,
                        candidate_left_text_local, 2, candidate_left_weight_local)) or
                        (candidate_left_weight_local + c_min_weight_slack <
                        top_right_weight_local) then
                    begin
                        Continue;
                    end;

                    candidate_rank_local := candidate_left_weight_local -
                        top_right_weight_local + Result[idx_local].score div 128;
                    if candidate_rank_local > best_rank_local then
                    begin
                        best_rank_local := candidate_rank_local;
                        best_idx_local := idx_local;
                    end;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            picked_candidate_local := Result[best_idx_local];
            picked_source_idx_local := visible_source_indices[best_idx_local];
            for move_idx_local := best_idx_local downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[0] := picked_candidate_local;
            visible_source_indices[0] := picked_source_idx_local;
        end;

        procedure restore_internal_supported_complete_top_over_visible_generated_top;
        var
            internal_top_local: TncCandidate;
            visible_idx_local: Integer;
            move_idx_local: Integer;
            source_idx_local: Integer;
            picked_candidate_local: TncCandidate;
            picked_source_idx_local: Integer;

            function is_complete_long_supported_candidate_local(
                const candidate_value: TncCandidate): Boolean;
            var
                text_local: string;
            begin
                text_local := Trim(candidate_value.text);
                Result := (expected_units >= 6) and
                    (not short_exact_query_mode) and
                    (text_local <> '') and
                    (Trim(candidate_value.comment) = '') and
                    (get_candidate_text_unit_count(text_local) = expected_units) and
                    (candidate_value.has_dict_weight or
                    (candidate_value.source = cs_user));
            end;

            function is_visible_unpathful_complete_local(
                const candidate_value: TncCandidate;
                const visible_index_value: Integer): Boolean;
            var
                text_local: string;
                path_local: string;
                source_idx_value: Integer;
            begin
                text_local := Trim(candidate_value.text);
                Result := False;
                if not ((expected_units >= 6) and
                    (not short_exact_query_mode) and
                    (text_local <> '') and
                    (Trim(candidate_value.comment) = '') and
                    (get_candidate_text_unit_count(text_local) = expected_units) and
                    (candidate_value.source <> cs_user)) then
                begin
                    Exit;
                end;

                path_local := '';
                if (visible_index_value >= 0) and
                    (visible_index_value < Length(visible_source_indices)) then
                begin
                    source_idx_value := visible_source_indices[visible_index_value];
                    if (source_idx_value >= 0) and
                        (source_idx_value < Length(m_candidate_segment_paths)) then
                    begin
                        path_local := Trim(m_candidate_segment_paths[source_idx_value]);
                    end;
                    if (path_local = '') and (source_idx_value >= 0) and
                        (source_idx_value <= High(m_candidates)) then
                    begin
                        path_local := Trim(get_segment_path_for_candidate(
                            m_candidates[source_idx_value], source_idx_value));
                    end;
                end;
                if path_local = '' then
                begin
                    path_local := Trim(get_segment_path_for_candidate(
                        candidate_value, -1));
                end;

                Result := (get_encoded_path_segment_count_local(path_local) <= 1) and
                    ((normalized_pinyin = '') or
                    (not display_exact_key_has_text(normalized_pinyin, text_local)));
            end;
        begin
            if (Length(Result) <= 0) or (Length(m_candidates) <= 0) then
            begin
                Exit;
            end;

            if has_entry_pathful_complete_top then
            begin
                internal_top_local := entry_top_candidate;
            end
            else
            begin
                internal_top_local := m_candidates[0];
            end;
            if (not is_complete_long_supported_candidate_local(
                internal_top_local)) or
                (not is_visible_unpathful_complete_local(Result[0], 0)) or
                SameText(Trim(Result[0].text), Trim(internal_top_local.text)) then
            begin
                Exit;
            end;

            visible_idx_local := -1;
            for source_idx_local := 0 to High(Result) do
            begin
                if same_visible_candidate_local(Result[source_idx_local],
                    internal_top_local) then
                begin
                    visible_idx_local := source_idx_local;
                    Break;
                end;
            end;

            if visible_idx_local > 0 then
            begin
                picked_candidate_local := Result[visible_idx_local];
                picked_source_idx_local := -1;
                if visible_idx_local < Length(visible_source_indices) then
                begin
                    picked_source_idx_local :=
                        visible_source_indices[visible_idx_local];
                end;
                for move_idx_local := visible_idx_local downto 1 do
                begin
                    Result[move_idx_local] := Result[move_idx_local - 1];
                    if move_idx_local < Length(visible_source_indices) then
                    begin
                        visible_source_indices[move_idx_local] :=
                            visible_source_indices[move_idx_local - 1];
                    end;
                end;
                Result[0] := picked_candidate_local;
                if Length(visible_source_indices) > 0 then
                begin
                    visible_source_indices[0] := picked_source_idx_local;
                end;
                Exit;
            end;

            if Length(Result) < page_size then
            begin
                SetLength(Result, Length(Result) + 1);
                SetLength(visible_source_indices, Length(Result));
            end;
            for move_idx_local := High(Result) downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                if move_idx_local < Length(visible_source_indices) then
                begin
                    visible_source_indices[move_idx_local] :=
                        visible_source_indices[move_idx_local - 1];
                end;
            end;
            Result[0] := internal_top_local;
            if Length(visible_source_indices) > 0 then
            begin
                visible_source_indices[0] := 0;
            end;
        end;

        procedure filter_visible_short_nonlexicon_complete_candidates;
        var
            read_idx_local: Integer;
            write_idx_local: Integer;
        begin
            if Length(Result) = 0 then
            begin
                Exit;
            end;

            write_idx_local := 0;
            for read_idx_local := 0 to High(Result) do
            begin
                keep_explicit_prefix_partial :=
                    display_candidate_is_explicit_apostrophe_prefix_partial(
                    Result[read_idx_local]);
                keep_protected_full_exact :=
                    is_protected_full_query_exact_local(
                    Result[read_idx_local]);
                if (not keep_protected_full_exact) and
                    (not keep_explicit_prefix_partial) and
                    (display_candidate_should_drop_short_invalid_partial(
                    Result[read_idx_local]) or
                    display_candidate_should_drop_short_nonlexicon_complete(
                    Result[read_idx_local],
                    visible_source_indices[read_idx_local])) then
                begin
                    Continue;
                end;

                if write_idx_local <> read_idx_local then
                begin
                    Result[write_idx_local] := Result[read_idx_local];
                    if (write_idx_local < Length(visible_source_indices)) and
                        (read_idx_local < Length(visible_source_indices)) then
                    begin
                        visible_source_indices[write_idx_local] :=
                            visible_source_indices[read_idx_local];
                    end;
                end;
                Inc(write_idx_local);
            end;

            if write_idx_local <> Length(Result) then
            begin
                SetLength(Result, write_idx_local);
                if Length(visible_source_indices) > write_idx_local then
                begin
                    SetLength(visible_source_indices, write_idx_local);
                end;
            end;
        end;

        procedure sanitize_visible_short_partial_source_paths;
        var
            idx_local: Integer;
            source_idx_local: Integer;
            path_local: string;
        begin
            if expected_units > 5 then
            begin
                Exit;
            end;

            for idx_local := 0 to High(Result) do
            begin
                if (idx_local >= Length(visible_source_indices)) or
                    (Trim(Result[idx_local].comment) = '') then
                begin
                    Continue;
                end;

                source_idx_local := visible_source_indices[idx_local];
                if (source_idx_local < 0) or
                    (source_idx_local > High(m_candidates)) then
                begin
                    Continue;
                end;

                path_local := '';
                if source_idx_local < Length(m_candidate_segment_paths) then
                begin
                    path_local := Trim(m_candidate_segment_paths[source_idx_local]);
                end;
                if path_local = '' then
                begin
                    path_local := Trim(get_segment_path_for_candidate(
                        m_candidates[source_idx_local], source_idx_local));
                end;
                if get_encoded_path_segment_count_local(path_local) <= 1 then
                begin
                    Continue;
                end;

                if not segment_path_matches_visible_text(path_local,
                    Result[idx_local].text) then
                begin
                    if source_idx_local < Length(m_candidate_segment_paths) then
                    begin
                        m_candidate_segment_paths[source_idx_local] := '';
                    end;
                    clear_segment_path_for_identity(m_candidates[source_idx_local]);
                    clear_segment_path_for_identity(Result[idx_local]);
                end;
            end;
        end;

        function candidate_is_repeated_particle_tail_complete_local(
            const candidate_value: TncCandidate): Boolean;
        var
            normalized_query_local: string;
            tail_key_local: string;
            tail_text_local: string;
            head_key_local: string;
            candidate_text_local: string;
            text_units_local: TArray<string>;
        begin
            Result := False;
            if Trim(candidate_value.comment) <> '' then
            begin
                Exit;
            end;

            normalized_query_local := normalize_pinyin_text(normalized_pinyin);
            if not try_get_short_particle_tail_query_parts(
                normalized_query_local, tail_key_local, tail_text_local,
                head_key_local) then
            begin
                Exit;
            end;

            candidate_text_local := Trim(candidate_value.text);
            text_units_local := split_text_units(candidate_text_local);
            Result := (Length(text_units_local) >= 2) and
                SameText(Trim(text_units_local[High(text_units_local)]),
                tail_text_local) and
                SameText(Trim(text_units_local[High(text_units_local) - 1]),
                tail_text_local);
        end;

        function is_short_repeated_initial_visible_query_local(
            const value: string): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            if (Length(value) < 2) or (Length(value) > 3) then
            begin
                Exit;
            end;
            for local_idx := 1 to Length(value) do
            begin
                if (not CharInSet(value[local_idx], ['b', 'p', 'm', 'f',
                    'd', 't', 'n', 'l', 'g', 'k', 'h', 'j', 'q', 'x',
                    'z', 'c', 's', 'r', 'y', 'w'])) or
                    ((local_idx > 1) and (value[local_idx] <> value[1])) then
                begin
                    Exit;
                end;
            end;
            Result := True;
        end;

        function candidate_is_visible_repeated_initial_reduplicated_local(
            const candidate_value: TncCandidate): Boolean;
        var
            normalized_query_local: string;
            text_units_local: TArray<string>;
            unit_count_local: Integer;
            idx_local: Integer;
            repeated_text_local: Boolean;
            repeated_tail_local: Boolean;
        begin
            Result := False;
            normalized_query_local := normalize_pinyin_text(normalized_pinyin);
            if (Trim(candidate_value.comment) <> '') or
                ((not candidate_value.has_dict_weight) and
                (candidate_value.source <> cs_user)) or
                (not is_short_repeated_initial_visible_query_local(
                normalized_query_local)) then
            begin
                Exit;
            end;

            unit_count_local := Length(normalized_query_local);
            text_units_local := split_text_units(Trim(candidate_value.text));
            if (unit_count_local < 2) or (unit_count_local > 3) or
                (Length(text_units_local) <> unit_count_local) then
            begin
                Exit;
            end;

            repeated_text_local := True;
            for idx_local := 1 to High(text_units_local) do
            begin
                if not SameText(text_units_local[idx_local], text_units_local[0]) then
                begin
                    repeated_text_local := False;
                    Break;
                end;
            end;
            repeated_tail_local := (unit_count_local = 3) and
                SameText(text_units_local[1], text_units_local[2]);
            Result := repeated_text_local or repeated_tail_local;
        end;

        function get_promoted_repeated_initial_candidate_count_local: Integer;
        var
            source_idx_local: Integer;
            candidate_local: TncCandidate;
            normalized_query_local: string;

            procedure try_count_candidate_local(const candidate_value: TncCandidate;
                const source_index_value: Integer);
            begin
                if Result >= page_size then
                begin
                    Exit;
                end;

                candidate_local := candidate_value;
                normalize_display_candidate(candidate_local);
                if candidate_is_visible_repeated_initial_reduplicated_local(
                    candidate_local) and (source_index_value >= page_size) then
                begin
                    Inc(Result);
                end;
            end;
        begin
            Result := 0;
            normalized_query_local := normalize_pinyin_text(normalized_pinyin);
            if (page_size <= 0) or
                (not is_short_repeated_initial_visible_query_local(
                normalized_query_local)) then
            begin
                Exit;
            end;

            for source_idx_local := 0 to
                High(repeated_initial_display_source_candidates) do
            begin
                try_count_candidate_local(
                    repeated_initial_display_source_candidates[source_idx_local],
                    source_idx_local);
                if Result >= page_size then
                begin
                    Exit;
                end;
            end;
            if Length(repeated_initial_display_source_candidates) > 0 then
            begin
                Exit;
            end;

            for source_idx_local := 0 to High(m_candidates) do
            begin
                try_count_candidate_local(m_candidates[source_idx_local],
                    source_idx_local);
                if Result >= page_size then
                begin
                    Exit;
                end;
            end;
        end;

        procedure promote_visible_repeated_initial_reduplicated_candidates;
        var
            ordered_candidates_local: TArray<TncCandidate>;
            ordered_sources_local: TArray<Integer>;
            idx_local: Integer;
            source_idx_local: Integer;
            write_idx_local: Integer;
            max_count_local: Integer;
            normalized_query_local: string;

            function same_display_candidate_local(const left_value,
                right_value: TncCandidate): Boolean;
            begin
                Result := SameText(Trim(left_value.text), Trim(right_value.text)) and
                    SameText(Trim(left_value.comment), Trim(right_value.comment));
            end;

            function ordered_contains_candidate_local(
                const candidate_value: TncCandidate): Boolean;
            var
                ordered_idx_local: Integer;
            begin
                Result := False;
                for ordered_idx_local := 0 to write_idx_local - 1 do
                begin
                    if same_display_candidate_local(
                        ordered_candidates_local[ordered_idx_local], candidate_value) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            procedure append_ordered_candidate_local(
                const candidate_value: TncCandidate; const source_value: Integer);
            begin
                if (write_idx_local >= max_count_local) or
                    ordered_contains_candidate_local(candidate_value) then
                begin
                    Exit;
                end;
                ordered_candidates_local[write_idx_local] := candidate_value;
                ordered_sources_local[write_idx_local] := source_value;
                Inc(write_idx_local);
            end;
        begin
            normalized_query_local := normalize_pinyin_text(normalized_pinyin);
            if (page_size <= 0) or (m_page_index <> 0) or
                (not is_short_repeated_initial_visible_query_local(
                normalized_query_local)) then
            begin
                Exit;
            end;

            max_count_local := page_size;
            SetLength(ordered_candidates_local, max_count_local);
            SetLength(ordered_sources_local, max_count_local);
            write_idx_local := 0;
            for source_idx_local := 0 to
                High(repeated_initial_display_source_candidates) do
            begin
                candidate := repeated_initial_display_source_candidates[source_idx_local];
                normalize_display_candidate(candidate);
                if candidate_is_visible_repeated_initial_reduplicated_local(candidate) then
                begin
                    append_ordered_candidate_local(candidate, -1);
                end;
            end;
            for source_idx_local := 0 to High(m_candidates) do
            begin
                candidate := m_candidates[source_idx_local];
                normalize_display_candidate(candidate);
                if candidate_is_visible_repeated_initial_reduplicated_local(candidate) then
                begin
                    append_ordered_candidate_local(candidate, source_idx_local);
                end;
            end;
            if write_idx_local <= 0 then
            begin
                Exit;
            end;
            for idx_local := 0 to High(Result) do
            begin
                if not candidate_is_visible_repeated_initial_reduplicated_local(
                    Result[idx_local]) then
                begin
                    append_ordered_candidate_local(Result[idx_local],
                        visible_source_indices[idx_local]);
                end;
            end;
            SetLength(Result, write_idx_local);
            SetLength(visible_source_indices, write_idx_local);
            for idx_local := 0 to write_idx_local - 1 do
            begin
                Result[idx_local] := ordered_candidates_local[idx_local];
                visible_source_indices[idx_local] := ordered_sources_local[idx_local];
            end;
        end;

        procedure promote_visible_full_query_exact_over_generated_top;
        const
            c_visible_probe_limit = 9;
            c_latest_session_exact_rank_bonus = 200000000;
            c_context_exact_rank_bonus = 100000000;
            c_query_choice_exact_rank_bonus = 50000000;
            c_query_choice_exact_rank_scale = 1000;
        var
            idx_local: Integer;
            insert_idx_local: Integer;
            best_idx_local: Integer;
            best_rank_local: Integer;
            rank_local: Integer;
            top_text_local: string;
            moved_candidate_local: TncCandidate;
            moved_source_local: Integer;

            function visible_text_has_low_frequency_medical_unit_local(
                const text_value: string): Boolean;
            var
                char_idx_local: Integer;
            begin
                Result := False;
                for char_idx_local := 1 to Length(text_value) do
                begin
                    if (Ord(text_value[char_idx_local]) = $6C28) or
                        (Ord(text_value[char_idx_local]) = $708E) or
                        (Ord(text_value[char_idx_local]) = $75C9) or
                        (Ord(text_value[char_idx_local]) = $7624) or
                        (Ord(text_value[char_idx_local]) = $764C) or
                        (Ord(text_value[char_idx_local]) = $80BC) or
                        (Ord(text_value[char_idx_local]) = $80FA) or
                        (Ord(text_value[char_idx_local]) = $8148) or
                        (Ord(text_value[char_idx_local]) = $817A) or
                        (Ord(text_value[char_idx_local]) = $82C4) or
                        (Ord(text_value[char_idx_local]) = $916E) or
                        (Ord(text_value[char_idx_local]) = $916F) or
                        (Ord(text_value[char_idx_local]) = $9176) or
                        (Ord(text_value[char_idx_local]) = $9187) or
                        (Ord(text_value[char_idx_local]) = $919B) or
                        (Ord(text_value[char_idx_local]) = $94F5) then
                    begin
                        Exit(True);
                    end;
                    case Ord(text_value[char_idx_local]) of
                        $6C28, // 氨
                        $708E, // 炎
                        $75C9, // 痉
                        $7624, // 瘤
                        $764C, // 癌
                        $80BC, // 肼
                        $80FA, // 胺
                        $8148, // 腈
                        $817A, // 腺
                        $82C4, // 苄
                        $916E, // 酮
                        $916F, // 酯
                        $9176, // 酶
                        $9187, // 醇
                        $919B, // 醛
                        $94F5: // 铵
                            Exit(True);
                    end;
                end;
            end;

            function low_frequency_medical_top_has_stronger_exact_local(
                const visible_candidates: TncCandidateList): Boolean;
            const
                c_low_frequency_medical_exact_weight = 520;
                c_min_exact_weight_gap = 120;
            var
                top_weight_local: Integer;
                idx_local: Integer;
                candidate_text_local: string;
                candidate_weight_local: Integer;
            begin
                Result := False;
                if (Length(visible_candidates) <= 1) or
                    (not get_display_exact_text_weight(normalized_pinyin,
                    top_text_local, expected_units, top_weight_local)) or
                    (top_weight_local > c_low_frequency_medical_exact_weight) or
                    (not visible_text_has_low_frequency_medical_unit_local(
                    top_text_local)) then
                begin
                    Exit;
                end;

                for idx_local := 1 to Min(c_visible_probe_limit - 1,
                    High(visible_candidates)) do
                begin
                    candidate_text_local := Trim(visible_candidates[idx_local].text);
                    if (candidate_text_local = '') or
                        (Trim(visible_candidates[idx_local].comment) <> '') or
                        (get_candidate_text_unit_count(candidate_text_local) <>
                        expected_units) or
                        (not get_display_exact_text_weight(normalized_pinyin,
                        candidate_text_local, expected_units,
                        candidate_weight_local)) then
                    begin
                        Continue;
                    end;
                    if not visible_text_has_low_frequency_medical_unit_local(
                        candidate_text_local) then
                    begin
                        Exit(True);
                    end;
                    if candidate_weight_local >= top_weight_local +
                        c_min_exact_weight_gap then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function top_candidate_should_stay_local(
                const visible_candidates: TncCandidateList): Boolean;
            var
                top_query_choice_bonus_local: Integer;
            begin
                Result := True;
                if Length(visible_candidates) <= 0 then
                begin
                    Exit;
                end;

                top_text_local := Trim(visible_candidates[0].text);
                if (top_text_local = '') or
                    (Trim(visible_candidates[0].comment) <> '') or
                    (get_candidate_text_unit_count(top_text_local) <>
                    expected_units) then
                begin
                    Exit;
                end;

                if display_exact_key_has_text(normalized_pinyin,
                    top_text_local) then
                begin
                    if low_frequency_medical_top_has_stronger_exact_local(
                        visible_candidates) then
                    begin
                        Result := False;
                    end;
                    Exit;
                end;

                if is_latest_session_query_choice(top_text_local) or
                    display_candidate_is_persistent_latest_choice(
                    normalized_pinyin, top_text_local) or
                    (get_context_query_latest_bonus(top_text_local) > 0) then
                begin
                    Exit;
                end;

                if (m_dictionary <> nil) then
                begin
                    if m_dictionary.is_user_entry(normalized_pinyin,
                        top_text_local) then
                    begin
                        Exit;
                    end;

                    top_query_choice_bonus_local :=
                        m_dictionary.get_query_choice_bonus(normalized_pinyin,
                        top_text_local);
                    if top_query_choice_bonus_local > 0 then
                    begin
                        Exit;
                    end;
                end;

                Result := False;
            end;

            function full_query_exact_visible_rank_local(
                const candidate_value: TncCandidate; out out_rank: Integer): Boolean;
            var
                candidate_text_local: string;
                exact_weight_local: Integer;
                query_choice_bonus_local: Integer;
                context_bonus_local: Integer;
                suppress_choice_bonus_local: Boolean;
            begin
                Result := False;
                out_rank := Low(Integer);

                candidate_text_local := Trim(candidate_value.text);
                if (candidate_text_local = '') or
                    (Trim(candidate_value.comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    expected_units) or
                    (not get_display_exact_text_weight(normalized_pinyin,
                    candidate_text_local, expected_units,
                    exact_weight_local)) then
                begin
                    Exit;
                end;

                out_rank := exact_weight_local;
                suppress_choice_bonus_local := (exact_weight_local <= 520) and
                    visible_text_has_low_frequency_medical_unit_local(
                    candidate_text_local);
                if (not suppress_choice_bonus_local) and
                    is_latest_session_query_choice(candidate_text_local) then
                begin
                    Inc(out_rank, c_latest_session_exact_rank_bonus);
                end;

                context_bonus_local := get_context_query_latest_bonus(
                    candidate_text_local);
                if (not suppress_choice_bonus_local) and
                    (context_bonus_local > 0) then
                begin
                    Inc(out_rank, c_context_exact_rank_bonus +
                        (context_bonus_local * c_query_choice_exact_rank_scale));
                end;

                if (not suppress_choice_bonus_local) and (m_dictionary <> nil) then
                begin
                    query_choice_bonus_local :=
                        m_dictionary.get_query_choice_bonus(normalized_pinyin,
                        candidate_text_local);
                    if query_choice_bonus_local > 0 then
                    begin
                        Inc(out_rank, c_query_choice_exact_rank_bonus +
                            (query_choice_bonus_local *
                            c_query_choice_exact_rank_scale));
                    end;
                end;

                Result := True;
            end;
        begin
            if (m_page_index <> 0) or (Length(Result) < 2) or
                (normalized_pinyin = '') or (expected_units < 2) or
                ((expected_units > 4) and
                ((expected_units < c_long_sentence_full_path_min_syllables) or
                (Length(protected_full_query_exacts) = 0))) or
                (not is_full_pinyin_key(normalized_pinyin)) or
                (Pos('''', normalized_pinyin) > 0) or
                top_candidate_should_stay_local(Result) then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_rank_local := Low(Integer);
            for idx_local := 1 to Min(c_visible_probe_limit - 1,
                High(Result)) do
            begin
                if full_query_exact_visible_rank_local(Result[idx_local],
                    rank_local) and
                    ((best_idx_local < 0) or (rank_local > best_rank_local)) then
                begin
                    best_idx_local := idx_local;
                    best_rank_local := rank_local;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            moved_candidate_local := Result[best_idx_local];
            moved_source_local := -1;
            if best_idx_local < Length(visible_source_indices) then
            begin
                moved_source_local := visible_source_indices[best_idx_local];
            end;

            for insert_idx_local := best_idx_local downto 1 do
            begin
                Result[insert_idx_local] := Result[insert_idx_local - 1];
                if insert_idx_local < Length(visible_source_indices) then
                begin
                    visible_source_indices[insert_idx_local] :=
                        visible_source_indices[insert_idx_local - 1];
                end;
            end;
            Result[0] := moved_candidate_local;
            if Length(visible_source_indices) > 0 then
            begin
                visible_source_indices[0] := moved_source_local;
            end;
        end;

        procedure rerank_visible_complete_long_candidates_by_lm;
        const
            c_visible_probe_limit = 3;
            c_min_average_lead = 320;
            c_min_supported_boundary_percent = 35;
            c_max_original_score_deficit = 20000;
        var
            top_average_local: Integer;
            ignored_support_local: Integer;
            ignored_boundary_local: Integer;
            top_score_local: Integer;
            idx_local: Integer;
            best_idx_local: Integer;
            average_local: Integer;
            support_local: Integer;
            boundary_local: Integer;
            score_local: Integer;
            best_average_local: Integer;
            best_support_local: Integer;
            best_boundary_local: Integer;
            best_score_local: Integer;
            move_idx_local: Integer;
            moved_candidate_local: TncCandidate;
            moved_source_local: Integer;
            top_text_local: string;
            stats_valid_local: Boolean;

            function get_visible_source_index_local(
                const visible_idx_local: Integer): Integer;
            begin
                Result := -1;
                if (visible_idx_local >= 0) and
                    (visible_idx_local < Length(visible_source_indices)) then
                begin
                    Result := visible_source_indices[visible_idx_local];
                end;
            end;

            function get_visible_original_score_local(
                const visible_idx_local: Integer): Integer;
            var
                source_idx_local: Integer;
            begin
                Result := 0;
                source_idx_local := get_visible_source_index_local(
                    visible_idx_local);
                if (source_idx_local >= 0) and
                    (source_idx_local < Length(m_candidates)) then
                begin
                    Result := m_candidates[source_idx_local].score;
                end;
            end;

            procedure get_visible_lm_stats_local(
                const visible_idx_local: Integer; out out_average: Integer;
                out out_support_count: Integer;
                out out_boundary_count: Integer; out out_valid: Boolean);
            var
                source_idx_local: Integer;
                path_local: string;
                parts_local: TArray<string>;
                part_idx_local: Integer;
                query_offset_local: Integer;
                previous_text_local: string;
                current_text_local: string;
                next_text_local: string;
                previous_units_local: Integer;
                current_units_local: Integer;
                next_units_local: Integer;
                transition_query_local: string;
                bigram_bonus_local: Integer;
                trigram_bonus_local: Integer;
                boundary_bonus_local: Integer;
                total_bonus_local: Integer;
            begin
                out_valid := False;
                out_average := 0;
                out_support_count := 0;
                out_boundary_count := 0;
                if (m_dictionary = nil) or (visible_idx_local < 0) or
                    (visible_idx_local >= Length(Result)) or
                    (Trim(Result[visible_idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(
                    Trim(Result[visible_idx_local].text)) <> expected_units) then
                begin
                    Exit;
                end;

                source_idx_local := get_visible_source_index_local(
                    visible_idx_local);
                if (source_idx_local < 0) or
                    (source_idx_local >= Length(m_candidates)) then
                begin
                    Exit;
                end;

                path_local := '';
                if source_idx_local < Length(m_candidate_segment_paths) then
                begin
                    path_local := Trim(
                        m_candidate_segment_paths[source_idx_local]);
                end;
                if path_local = '' then
                begin
                    path_local := Trim(get_segment_path_for_candidate(
                        Result[visible_idx_local], source_idx_local));
                end;
                if (get_encoded_path_segment_count_local(path_local) <= 1) or
                    (not segment_path_matches_visible_text(path_local,
                    Result[visible_idx_local].text)) then
                begin
                    Exit;
                end;

                parts_local := path_local.Split([c_segment_path_separator]);
                if Length(parts_local) < 2 then
                begin
                    Exit;
                end;

                query_offset_local := 0;
                previous_text_local := '';
                previous_units_local := 0;
                total_bonus_local := 0;
                for part_idx_local := 0 to High(parts_local) - 1 do
                begin
                    current_text_local := Trim(parts_local[part_idx_local]);
                    next_text_local := Trim(parts_local[part_idx_local + 1]);
                    current_units_local := get_candidate_text_unit_count(
                        current_text_local);
                    next_units_local := get_candidate_text_unit_count(
                        next_text_local);
                    if (current_text_local = '') or (next_text_local = '') or
                        (current_units_local <= 0) or (next_units_local <= 0) or
                        (query_offset_local + current_units_local +
                        next_units_local > expected_units) then
                    begin
                        Exit;
                    end;

                    transition_query_local := build_display_query_key(
                        query_offset_local, current_units_local +
                        next_units_local);
                    bigram_bonus_local :=
                        m_dictionary.get_lm_transition_bonus(
                        transition_query_local, current_text_local +
                        c_segment_path_separator + next_text_local);
                    trigram_bonus_local := 0;
                    if (part_idx_local > 0) and
                        (previous_text_local <> '') and
                        (previous_units_local > 0) then
                    begin
                        transition_query_local := build_display_query_key(
                            query_offset_local - previous_units_local,
                            previous_units_local + current_units_local +
                            next_units_local);
                        trigram_bonus_local :=
                            m_dictionary.get_lm_transition_bonus(
                            transition_query_local, previous_text_local +
                            c_segment_path_separator + current_text_local +
                            c_segment_path_separator + next_text_local);
                    end;

                    boundary_bonus_local := Max(bigram_bonus_local,
                        trigram_bonus_local);
                    Inc(total_bonus_local, boundary_bonus_local);
                    if boundary_bonus_local > 0 then
                    begin
                        Inc(out_support_count);
                    end;
                    Inc(out_boundary_count);
                    previous_text_local := current_text_local;
                    previous_units_local := current_units_local;
                    Inc(query_offset_local, current_units_local);
                end;

                Inc(query_offset_local, get_candidate_text_unit_count(
                    Trim(parts_local[High(parts_local)])));
                if (query_offset_local <> expected_units) or
                    (out_boundary_count <= 0) then
                begin
                    Exit;
                end;

                out_average := total_bonus_local div out_boundary_count;
                out_valid := True;
            end;

            function candidate_is_better_local(const candidate_average: Integer;
                const candidate_support: Integer;
                const candidate_boundary: Integer;
                const candidate_score: Integer): Boolean;
            begin
                Result := (best_idx_local < 0) or
                    (candidate_average > best_average_local) or
                    ((candidate_average = best_average_local) and
                    (candidate_support * best_boundary_local >
                    best_support_local * candidate_boundary)) or
                    ((candidate_average = best_average_local) and
                    (candidate_support * best_boundary_local =
                    best_support_local * candidate_boundary) and
                    (candidate_support > best_support_local)) or
                    ((candidate_average = best_average_local) and
                    (candidate_support * best_boundary_local =
                    best_support_local * candidate_boundary) and
                    (candidate_support = best_support_local) and
                    (candidate_score > best_score_local));
            end;

            function candidates_differ_only_in_grammar_particles_local(
                const left_text: string; const right_text: string): Boolean;
            var
                left_units_local: TArray<string>;
                right_units_local: TArray<string>;
                unit_idx_local: Integer;
                has_difference_local: Boolean;

                function is_grammar_particle_local(
                    const unit_text: string): Boolean;
                begin
                    Result := SameText(unit_text, string(Char($7684))) or
                        SameText(unit_text, string(Char($5730))) or
                        SameText(unit_text, string(Char($5F97)));
                end;
            begin
                Result := False;
                left_units_local := split_text_units(Trim(left_text));
                right_units_local := split_text_units(Trim(right_text));
                if (Length(left_units_local) <= 0) or
                    (Length(left_units_local) <> Length(right_units_local)) then
                begin
                    Exit;
                end;

                has_difference_local := False;
                for unit_idx_local := 0 to High(left_units_local) do
                begin
                    if SameText(left_units_local[unit_idx_local],
                        right_units_local[unit_idx_local]) then
                    begin
                        Continue;
                    end;
                    if (not is_grammar_particle_local(
                        left_units_local[unit_idx_local])) or
                        (not is_grammar_particle_local(
                        right_units_local[unit_idx_local])) then
                    begin
                        Exit;
                    end;
                    has_difference_local := True;
                end;
                Result := has_difference_local;
            end;
        begin
            if (m_dictionary = nil) or short_exact_query_mode or
                (m_page_index <> 0) or (expected_units < 6) or
                (Length(Result) < 2) or forced_visible_top_candidate_applies then
            begin
                Exit;
            end;

            top_text_local := Trim(Result[0].text);
            if (top_text_local = '') or
                (Result[0].source = cs_user) or
                is_latest_session_query_choice(top_text_local) or
                display_candidate_is_persistent_latest_choice(
                normalized_pinyin, top_text_local) or
                ((m_dictionary <> nil) and
                m_dictionary.is_user_entry(normalized_pinyin,
                top_text_local)) then
            begin
                Exit;
            end;

            top_average_local := 0;
            ignored_support_local := 0;
            ignored_boundary_local := 0;
            get_visible_lm_stats_local(0, top_average_local,
                ignored_support_local, ignored_boundary_local,
                stats_valid_local);
            top_score_local := get_visible_original_score_local(0);
            best_idx_local := -1;
            best_average_local := 0;
            best_support_local := 0;
            best_boundary_local := 1;
            best_score_local := Low(Integer);

            for idx_local := 1 to Min(c_visible_probe_limit - 1,
                High(Result)) do
            begin
                get_visible_lm_stats_local(idx_local, average_local,
                    support_local, boundary_local, stats_valid_local);
                if not stats_valid_local then
                begin
                    Continue;
                end;
                score_local := get_visible_original_score_local(idx_local);
                if (average_local < top_average_local + c_min_average_lead) or
                    (support_local <= 0) or
                    (support_local * 100 < boundary_local *
                    c_min_supported_boundary_percent) or
                    (top_score_local - score_local >
                    c_max_original_score_deficit) then
                begin
                    Continue;
                end;
                if candidates_differ_only_in_grammar_particles_local(
                    Result[0].text, Result[idx_local].text) then
                begin
                    Continue;
                end;

                if candidate_is_better_local(average_local, support_local,
                    boundary_local, score_local) then
                begin
                    best_idx_local := idx_local;
                    best_average_local := average_local;
                    best_support_local := support_local;
                    best_boundary_local := boundary_local;
                    best_score_local := score_local;
                end;
            end;

            if best_idx_local <= 0 then
            begin
                Exit;
            end;

            moved_candidate_local := Result[best_idx_local];
            moved_source_local := visible_source_indices[best_idx_local];
            for move_idx_local := best_idx_local downto 1 do
            begin
                Result[move_idx_local] := Result[move_idx_local - 1];
                visible_source_indices[move_idx_local] :=
                    visible_source_indices[move_idx_local - 1];
            end;
            Result[0] := moved_candidate_local;
            visible_source_indices[0] := moved_source_local;
        end;

        procedure rerank_visible_complete_long_candidates_by_char_lm;
        const
            c_visible_probe_limit = 5;
            c_original_rank_penalty = 200;
        var
            eligible_indices_local: TArray<Integer>;
            candidate_texts_local: TArray<string>;
            lm_scores_local: TArray<Integer>;
            rerank_scores_local: TArray<Integer>;
            idx_local: Integer;
            eligible_count_local: Integer;
            rank_local: Integer;
            best_rank_local: Integer;
            scan_rank_local: Integer;
            visible_idx_local: Integer;
            best_visible_idx_local: Integer;
            temp_score_local: Integer;
            temp_candidate_local: TncCandidate;
            temp_source_local: Integer;
            top_text_local: string;
        begin
            if (m_dictionary = nil) or short_exact_query_mode or
                (m_page_index <> 0) or (expected_units < 6) or
                (Length(Result) < 2) or forced_visible_top_candidate_applies then
            begin
                Exit;
            end;

            top_text_local := Trim(Result[0].text);
            if (top_text_local = '') or (Result[0].source = cs_user) or
                is_latest_session_query_choice(top_text_local) or
                display_candidate_is_persistent_latest_choice(
                normalized_pinyin, top_text_local) or
                m_dictionary.is_user_entry(normalized_pinyin,
                top_text_local) then
            begin
                Exit;
            end;

            SetLength(eligible_indices_local, c_visible_probe_limit);
            SetLength(candidate_texts_local, c_visible_probe_limit);
            eligible_count_local := 0;
            for idx_local := 0 to Min(c_visible_probe_limit - 1,
                High(Result)) do
            begin
                if (Trim(Result[idx_local].comment) <> '') or
                    (Trim(Result[idx_local].text) = '') or
                    (Result[idx_local].source = cs_user) or
                    (get_candidate_text_unit_count(
                    Trim(Result[idx_local].text)) <> expected_units) then
                begin
                    Continue;
                end;
                eligible_indices_local[eligible_count_local] := idx_local;
                candidate_texts_local[eligible_count_local] :=
                    Trim(Result[idx_local].text);
                Inc(eligible_count_local);
            end;
            if (eligible_count_local < 2) or
                (eligible_indices_local[0] <> 0) then
            begin
                Exit;
            end;
            SetLength(eligible_indices_local, eligible_count_local);
            SetLength(candidate_texts_local, eligible_count_local);
            if not get_cached_char_lm_scores(candidate_texts_local,
                lm_scores_local, clsm_full, '') or
                (Length(lm_scores_local) <> eligible_count_local) then
            begin
                Exit;
            end;

            SetLength(rerank_scores_local, eligible_count_local);
            for rank_local := 0 to eligible_count_local - 1 do
            begin
                rerank_scores_local[rank_local] := lm_scores_local[rank_local] -
                    rank_local * c_original_rank_penalty;
            end;

            for rank_local := 0 to eligible_count_local - 2 do
            begin
                best_rank_local := rank_local;
                for scan_rank_local := rank_local + 1 to
                    eligible_count_local - 1 do
                begin
                    if rerank_scores_local[scan_rank_local] >
                        rerank_scores_local[best_rank_local] then
                    begin
                        best_rank_local := scan_rank_local;
                    end;
                end;
                if best_rank_local = rank_local then
                begin
                    Continue;
                end;

                visible_idx_local := eligible_indices_local[rank_local];
                best_visible_idx_local :=
                    eligible_indices_local[best_rank_local];
                temp_candidate_local := Result[visible_idx_local];
                Result[visible_idx_local] := Result[best_visible_idx_local];
                Result[best_visible_idx_local] := temp_candidate_local;
                temp_source_local := visible_source_indices[visible_idx_local];
                visible_source_indices[visible_idx_local] :=
                    visible_source_indices[best_visible_idx_local];
                visible_source_indices[best_visible_idx_local] :=
                    temp_source_local;
                temp_score_local := rerank_scores_local[rank_local];
                rerank_scores_local[rank_local] :=
                    rerank_scores_local[best_rank_local];
                rerank_scores_local[best_rank_local] := temp_score_local;
            end;
        end;

        procedure rerank_visible_complete_long_candidates_by_local_model_pass(
            const use_pairwise_pool_model: Boolean);
        const
            c_seed_probe_limit = 5;
            c_generated_seed_limit = 1;
            c_single_option_limit = 3;
            c_pairwise_single_option_limit = 6;
            c_hidden_pool_limit = 50;
        var
            pool_local: TArray<TncLongLocalRerankPoolItem>;
            pool_index_by_text_local: TDictionary<string, Integer>;
            retained_texts_local: TDictionary<string, Boolean>;
            candidate_texts_local: TArray<string>;
            lm_scores_local: TArray<Integer>;
            order_local: TArray<Integer>;
            retained_local: TArray<TncLongLocalRerankPoolItem>;
            seed_units_local: TArray<string>;
            consensus_original_units_local: TArray<TArray<string>>;
            consensus_original_weights_local: TArray<Double>;
            consensus_top_units_local: TArray<string>;
            repair_segment_starts_local: TArray<Integer>;
            repair_segment_lengths_local: TArray<Integer>;
            single_options_local: TncCandidateList;
            item_local: TncLongLocalRerankPoolItem;
            previous_local: TncLongLocalRerankPoolItem;
            best_item_local: TncLongLocalRerankPoolItem;
            generated_candidate_local: TncCandidate;
            moved_candidate_local: TncCandidate;
            moved_source_local: Integer;
            top_text_local: string;
            syllable_key_local: string;
            replacement_text_local: string;
            variant_text_local: string;
            repaired_segment_text_local: string;
            repaired_segment_key_local: string;
            pool_key_local: string;
            source_weight_local: Integer;
            visible_idx_local: Integer;
            unit_idx_local: Integer;
            replacement_idx_local: Integer;
            pool_idx_local: Integer;
            order_idx_local: Integer;
            retained_idx_local: Integer;
            move_idx_local: Integer;
            existing_idx_local: Integer;
            baseline_idx_local: Integer;
            best_idx_local: Integer;
            original_count_local: Integer;
            retained_count_local: Integer;
            pairwise_challenger_count_local: Integer;
            pairwise_insert_rank_local: Integer;
            single_option_limit_local: Integer;
            consensus_original_count_local: Integer;
            consensus_total_weight_local: Double;
            repair_segment_start_local: Integer;
            repair_segment_length_local: Integer;
            repair_segment_unit_local: Integer;
            changed_ratio_local: Double;
            pairwise_score_local: Double;
            model_tick_local: UInt64;
            model_elapsed_local: UInt64;

            function candidate_raw_weight_local(
                const value: TncCandidate): Integer;
            begin
                if value.has_dict_weight then
                begin
                    Result := value.dict_weight;
                end
                else
                begin
                    Result := value.score;
                end;
            end;

            procedure initialize_pool_item_local(
                var value: TncLongLocalRerankPoolItem);
            begin
                value.text := '';
                value.seed_rank := 0;
                value.seed_visible_index := -1;
                value.original := False;
                value.substitutions := 0;
                value.changed_position := -1;
                value.source_char_weight := 0;
                value.replacement_char_weight := 0;
                value.char_lm_score := 0;
                value.pool_rank := 0;
                value.consensus_seed_count := 0;
                value.consensus_support_mean := 0.0;
                value.consensus_support_min := 0.0;
                value.consensus_majority_units := 0;
                value.consensus_unanimous_units := 0;
                value.consensus_nearest_distance := 0;
                value.consensus_mean_distance := 0.0;
                value.consensus_changed_support := 0.0;
                value.consensus_changed_top_match := 0;
                value.model_score := 0.0;
            end;

            function get_single_options_local(const syllable_key: string;
                out options: TncCandidateList): Boolean;
            var
                raw_candidates_local: TncCandidateList;
                filtered_local: TList<TncCandidate>;
                seen_local: TDictionary<string, Boolean>;
                candidate_local: TncCandidate;
                sort_candidate_local: TncCandidate;
                text_local: string;
                idx_local: Integer;
                sort_idx_local: Integer;
                insert_idx_local: Integer;
                sort_weight_local: Integer;
            begin
                SetLength(options, 0);
                if (m_long_local_single_options_cache <> nil) and
                    m_long_local_single_options_cache.TryGetValue(
                    syllable_key, options) then
                begin
                    Exit(Length(options) > 0);
                end;
                if (syllable_key = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(
                    syllable_key, raw_candidates_local)) then
                begin
                    if m_long_local_single_options_cache <> nil then
                    begin
                        m_long_local_single_options_cache.AddOrSetValue(
                            syllable_key, options);
                    end;
                    Exit(False);
                end;

                filtered_local := TList<TncCandidate>.Create;
                seen_local := TDictionary<string, Boolean>.Create;
                try
                    for idx_local := 0 to High(raw_candidates_local) do
                    begin
                        candidate_local := raw_candidates_local[idx_local];
                        text_local := Trim(candidate_local.text);
                        if (text_local = '') or
                            (Trim(candidate_local.comment) <> '') or
                            (candidate_local.source = cs_user) or
                            (get_candidate_text_unit_count(text_local) <> 1) or
                            seen_local.ContainsKey(text_local) then
                        begin
                            Continue;
                        end;
                        seen_local.Add(text_local, True);
                        filtered_local.Add(candidate_local);
                    end;
                    for sort_idx_local := 1 to filtered_local.Count - 1 do
                    begin
                        sort_candidate_local := filtered_local[sort_idx_local];
                        sort_weight_local :=
                            candidate_raw_weight_local(sort_candidate_local);
                        insert_idx_local := sort_idx_local - 1;
                        while (insert_idx_local >= 0) and
                            ((candidate_raw_weight_local(
                            filtered_local[insert_idx_local]) <
                            sort_weight_local) or
                            ((candidate_raw_weight_local(
                            filtered_local[insert_idx_local]) =
                            sort_weight_local) and
                            (CompareText(Trim(
                            filtered_local[insert_idx_local].text),
                            Trim(sort_candidate_local.text)) > 0))) do
                        begin
                            filtered_local[insert_idx_local + 1] :=
                                filtered_local[insert_idx_local];
                            Dec(insert_idx_local);
                        end;
                        filtered_local[insert_idx_local + 1] :=
                            sort_candidate_local;
                    end;
                    SetLength(options, filtered_local.Count);
                    for idx_local := 0 to filtered_local.Count - 1 do
                    begin
                        options[idx_local] := filtered_local[idx_local];
                    end;
                finally
                    seen_local.Free;
                    filtered_local.Free;
                end;
                if m_long_local_single_options_cache <> nil then
                begin
                    m_long_local_single_options_cache.AddOrSetValue(
                        syllable_key, Copy(options, 0, Length(options)));
                end;
                Result := Length(options) > 0;
            end;

            function provenance_is_better_local(
                const candidate_value: TncLongLocalRerankPoolItem;
                const previous_value: TncLongLocalRerankPoolItem): Boolean;
            begin
                if candidate_value.substitutions < previous_value.substitutions then
                begin
                    Exit(True);
                end;
                if candidate_value.substitutions > previous_value.substitutions then
                begin
                    Exit(False);
                end;
                if candidate_value.seed_rank < previous_value.seed_rank then
                begin
                    Exit(True);
                end;
                if candidate_value.seed_rank > previous_value.seed_rank then
                begin
                    Exit(False);
                end;
                Result := candidate_value.changed_position <
                    previous_value.changed_position;
            end;

            procedure retain_pool_item_local(
                const value: TncLongLocalRerankPoolItem);
            var
                new_idx_local: Integer;
            begin
                pool_key_local := LowerCase(Trim(value.text));
                if pool_key_local = '' then
                begin
                    Exit;
                end;
                if pool_index_by_text_local.TryGetValue(pool_key_local,
                    existing_idx_local) then
                begin
                    previous_local := pool_local[existing_idx_local];
                    if provenance_is_better_local(value, previous_local) then
                    begin
                        pool_local[existing_idx_local] := value;
                    end;
                    Exit;
                end;
                new_idx_local := Length(pool_local);
                SetLength(pool_local, new_idx_local + 1);
                pool_local[new_idx_local] := value;
                pool_index_by_text_local.Add(pool_key_local, new_idx_local);
            end;

            function build_variant_text_local(const units: TArray<string>;
                const changed_position: Integer;
                const replacement: string): string;
            var
                idx_local: Integer;
            begin
                Result := '';
                for idx_local := 0 to High(units) do
                begin
                    if idx_local = changed_position then
                    begin
                        Result := Result + replacement;
                    end
                    else
                    begin
                        Result := Result + units[idx_local];
                    end;
                end;
            end;

            function is_productive_particle_tail_segment_local(
                const units: TArray<string>; const segment_start: Integer;
                const segment_length: Integer;
                const changed_position: Integer): Boolean;
            var
                tail_text_local: string;
            begin
                Result := False;
                if (segment_length <> 2) or
                    (changed_position <> segment_start) or
                    (segment_start < 0) or
                    (segment_start + 1 > High(units)) then
                begin
                    Exit;
                end;
                tail_text_local := Trim(units[segment_start + 1]);
                if Length(tail_text_local) <> 1 then
                begin
                    Exit;
                end;
                case Ord(tail_text_local[1]) of
                    $7684, $5F97, $5730, $4E86, $7740,
                    $8FC7, $5427, $5417, $5566, $554A:
                        Result := True;
                end;
            end;

            procedure get_residual_repair_segments_local(
                const seed_candidate: TncCandidate;
                const visible_index: Integer;
                out segment_starts: TArray<Integer>;
                out segment_lengths: TArray<Integer>);
            var
                source_idx_local: Integer;
                inferred_score_local: Integer;
                inferred_segments_local: Integer;
                segment_idx_local: Integer;
                unit_idx_local: Integer;
                cursor_local: Integer;
                segment_units_local: TArray<string>;
                path_parts_local: TArray<string>;
                path_local: string;
                reconstructed_local: string;
            begin
                SetLength(segment_starts, expected_units);
                SetLength(segment_lengths, expected_units);
                for unit_idx_local := 0 to expected_units - 1 do
                begin
                    segment_starts[unit_idx_local] := -1;
                    segment_lengths[unit_idx_local] := 0;
                end;
                source_idx_local := -1;
                if (visible_index >= 0) and
                    (visible_index < Length(visible_source_indices)) then
                begin
                    source_idx_local := visible_source_indices[visible_index];
                end;
                path_local := '';
                if (source_idx_local >= 0) and
                    (source_idx_local < Length(m_candidate_segment_paths)) then
                begin
                    path_local := Trim(
                        m_candidate_segment_paths[source_idx_local]);
                end;
                if (path_local = '') and (source_idx_local >= 0) and
                    (source_idx_local <= High(m_candidates)) then
                begin
                    path_local := Trim(get_segment_path_for_candidate(
                        m_candidates[source_idx_local], source_idx_local));
                end;
                if path_local = '' then
                begin
                    path_local := Trim(get_segment_path_for_candidate(
                        seed_candidate, -1));
                end;

                // A one-piece path can be an unsegmented fallback. Re-infer it
                // before deciding which characters are safe local repairs.
                if get_encoded_path_segment_count_local(path_local) <= 1 then
                begin
                    path_local := Trim(
                        infer_segment_path_for_query_text_with_score(
                        normalized_pinyin, Trim(seed_candidate.text),
                        inferred_score_local, inferred_segments_local, True));
                end;
                if path_local = '' then
                begin
                    Exit;
                end;

                path_parts_local := path_local.Split(
                    [c_segment_path_separator]);
                cursor_local := 0;
                reconstructed_local := '';
                for segment_idx_local := 0 to High(path_parts_local) do
                begin
                    segment_units_local := split_text_units(
                        Trim(path_parts_local[segment_idx_local]));
                    if Length(segment_units_local) <= 0 then
                    begin
                        Exit;
                    end;
                    reconstructed_local := reconstructed_local +
                        Trim(path_parts_local[segment_idx_local]);
                    for unit_idx_local := 0 to
                        High(segment_units_local) do
                    begin
                        if cursor_local + unit_idx_local <
                            Length(segment_starts) then
                        begin
                            segment_starts[cursor_local + unit_idx_local] :=
                                cursor_local;
                            segment_lengths[cursor_local + unit_idx_local] :=
                                Length(segment_units_local);
                        end;
                    end;
                    Inc(cursor_local, Length(segment_units_local));
                end;
                if (cursor_local <> expected_units) or
                    (not SameText(reconstructed_local,
                    Trim(seed_candidate.text))) then
                begin
                    for unit_idx_local := 0 to expected_units - 1 do
                    begin
                        segment_starts[unit_idx_local] := -1;
                        segment_lengths[unit_idx_local] := 0;
                    end;
                end;
            end;

            function find_source_weight_local(
                const options: TncCandidateList;
                const source_text: string): Integer;
            var
                idx_local: Integer;
            begin
                Result := 0;
                for idx_local := 0 to High(options) do
                begin
                    if SameText(Trim(options[idx_local].text), source_text) then
                    begin
                        Exit(candidate_raw_weight_local(options[idx_local]));
                    end;
                end;
            end;

            function model_item_is_better_local(
                const candidate_value: TncLongLocalRerankPoolItem;
                const current_value: TncLongLocalRerankPoolItem): Boolean;
            begin
                if candidate_value.model_score > current_value.model_score then
                begin
                    Exit(True);
                end;
                if candidate_value.model_score < current_value.model_score then
                begin
                    Exit(False);
                end;
                Result := candidate_value.seed_rank < current_value.seed_rank;
            end;

            function join_units_local(const units: TArray<string>;
                const first_index: Integer;
                const last_index: Integer): string;
            var
                idx_local: Integer;
            begin
                Result := '';
                for idx_local := first_index to last_index do
                begin
                    Result := Result + units[idx_local];
                end;
            end;

            procedure prepare_consensus_originals_local;
            var
                original_units_local: TArray<string>;
                original_idx_local: Integer;
                weight_local: Double;
            begin
                consensus_original_count_local := 0;
                consensus_total_weight_local := 0.0;
                SetLength(consensus_original_units_local,
                    Length(pool_local));
                SetLength(consensus_original_weights_local,
                    Length(pool_local));
                SetLength(consensus_top_units_local, 0);
                for original_idx_local := 0 to High(pool_local) do
                begin
                    if not pool_local[original_idx_local].original then
                    begin
                        Continue;
                    end;
                    original_units_local := split_text_units(
                        pool_local[original_idx_local].text);
                    if Length(original_units_local) <> expected_units then
                    begin
                        Continue;
                    end;
                    consensus_original_units_local[
                        consensus_original_count_local] :=
                        original_units_local;
                    weight_local := 1.0 / Max(1,
                        pool_local[original_idx_local].seed_rank);
                    consensus_original_weights_local[
                        consensus_original_count_local] := weight_local;
                    consensus_total_weight_local :=
                        consensus_total_weight_local + weight_local;
                    if pool_local[original_idx_local].seed_rank = 1 then
                    begin
                        consensus_top_units_local :=
                            Copy(original_units_local, 0,
                            Length(original_units_local));
                    end;
                    Inc(consensus_original_count_local);
                end;
                SetLength(consensus_original_units_local,
                    consensus_original_count_local);
                SetLength(consensus_original_weights_local,
                    consensus_original_count_local);
            end;

            procedure populate_consensus_features_local(
                var value: TncLongLocalRerankPoolItem);
            var
                candidate_units_local: TArray<string>;
                distances_local: TArray<Integer>;
                compatible_idx_local: Integer;
                position_local: Integer;
                support_local: Double;
                distance_sum_local: Integer;
            begin
                candidate_units_local := split_text_units(value.text);
                if Length(candidate_units_local) <> expected_units then
                begin
                    Exit;
                end;
                if (consensus_original_count_local <= 0) or
                    (consensus_total_weight_local <= 0.0) then
                begin
                    value.consensus_nearest_distance := expected_units;
                    value.consensus_mean_distance := expected_units;
                    Exit;
                end;

                SetLength(distances_local,
                    consensus_original_count_local);
                value.consensus_seed_count :=
                    consensus_original_count_local;
                value.consensus_support_min := 1.0;
                value.consensus_nearest_distance := expected_units;
                for position_local := 0 to expected_units - 1 do
                begin
                    support_local := 0.0;
                    for compatible_idx_local := 0 to
                        consensus_original_count_local - 1 do
                    begin
                        if SameText(consensus_original_units_local[
                            compatible_idx_local][position_local],
                            candidate_units_local[position_local]) then
                        begin
                            support_local := support_local +
                                consensus_original_weights_local[
                                compatible_idx_local];
                        end
                        else
                        begin
                            Inc(distances_local[compatible_idx_local]);
                        end;
                    end;
                    support_local := support_local /
                        consensus_total_weight_local;
                    value.consensus_support_mean :=
                        value.consensus_support_mean + support_local;
                    value.consensus_support_min := Min(
                        value.consensus_support_min, support_local);
                    if support_local >= 0.5 then
                    begin
                        Inc(value.consensus_majority_units);
                    end;
                    if support_local >= 0.999999 then
                    begin
                        Inc(value.consensus_unanimous_units);
                    end;
                    if position_local = value.changed_position then
                    begin
                        value.consensus_changed_support := support_local;
                    end;
                end;
                value.consensus_support_mean :=
                    value.consensus_support_mean / expected_units;
                distance_sum_local := 0;
                for compatible_idx_local := 0 to
                    consensus_original_count_local - 1 do
                begin
                    value.consensus_nearest_distance := Min(
                        value.consensus_nearest_distance,
                        distances_local[compatible_idx_local]);
                    Inc(distance_sum_local,
                        distances_local[compatible_idx_local]);
                end;
                value.consensus_mean_distance :=
                    distance_sum_local /
                    consensus_original_count_local;
                if (value.changed_position >= 0) and
                    (value.changed_position <
                    Length(consensus_top_units_local)) and
                    SameText(consensus_top_units_local[
                    value.changed_position],
                    candidate_units_local[value.changed_position]) then
                begin
                    value.consensus_changed_top_match := 1;
                end;
            end;

            procedure populate_pair_candidate_features_local(
                const value: TncLongLocalRerankPoolItem;
                out features: TncLongLocalPoolCandidateFeatures);
            begin
                features := Default(TncLongLocalPoolCandidateFeatures);
                features.pool_rank := value.pool_rank;
                features.char_lm_score := value.char_lm_score;
                features.seed_rank := value.seed_rank;
                features.original := Ord(value.original);
                features.substitutions := value.substitutions;
                if value.original then
                begin
                    features.changed_position_ratio := -1.0;
                end
                else
                begin
                    features.changed_position_ratio :=
                        value.changed_position / Max(1, expected_units - 1);
                end;
                features.source_char_weight := value.source_char_weight;
                features.replacement_char_weight :=
                    value.replacement_char_weight;
                features.char_weight_delta :=
                    value.replacement_char_weight - value.source_char_weight;
                features.consensus_seed_count := value.consensus_seed_count;
                features.consensus_support_mean :=
                    value.consensus_support_mean;
                features.consensus_support_min := value.consensus_support_min;
                features.consensus_majority_units :=
                    value.consensus_majority_units;
                features.consensus_unanimous_units :=
                    value.consensus_unanimous_units;
                features.consensus_nearest_distance :=
                    value.consensus_nearest_distance;
                features.consensus_mean_distance :=
                    value.consensus_mean_distance;
                features.consensus_changed_support :=
                    value.consensus_changed_support;
                features.consensus_changed_top_match :=
                    value.consensus_changed_top_match;
            end;

            function score_pairwise_pool_local: Boolean;
            var
                challenger_indices_local: TArray<Integer>;
                window_offsets_local: TArray<Integer>;
                window_texts_local: TArray<string>;
                window_scores_local: TArray<Integer>;
                baseline_units_local: TArray<string>;
                candidate_units_local: TArray<string>;
                baseline_features_local: TncLongLocalPoolCandidateFeatures;
                candidate_features_local: TncLongLocalPoolCandidateFeatures;
                relation_features_local: TncLongLocalPoolRelationFeatures;
                top_lm_local: TncLongLocalPoolLmScores;
                candidate_lm_local: TncLongLocalPoolLmScores;
                model_features_local: TncLongLocalPairwisePoolFeatures;
                challenger_local: Integer;
                candidate_idx_local: Integer;
                radius_local: Integer;
                window_start_local: Integer;
                window_end_local: Integer;
                window_count_local: Integer;
            begin
                Result := False;
                pairwise_challenger_count_local := 0;
                pairwise_insert_rank_local := -1;
                SetLength(challenger_indices_local,
                    c_long_local_pairwise_pool_max_challengers);
                for candidate_idx_local := 0 to High(retained_local) do
                begin
                    if retained_local[candidate_idx_local].original then
                    begin
                        Continue;
                    end;
                    if pairwise_challenger_count_local >=
                        c_long_local_pairwise_pool_max_challengers then
                    begin
                        Continue;
                    end;
                    challenger_indices_local[pairwise_challenger_count_local] :=
                        candidate_idx_local;
                    Inc(pairwise_challenger_count_local);
                end;
                if (baseline_idx_local < 0) or
                    (pairwise_challenger_count_local <= 0) then
                begin
                    Exit;
                end;
                SetLength(challenger_indices_local,
                    pairwise_challenger_count_local);
                prepare_consensus_originals_local;
                populate_consensus_features_local(
                    retained_local[baseline_idx_local]);
                for challenger_local := 0 to
                    pairwise_challenger_count_local - 1 do
                begin
                    populate_consensus_features_local(retained_local[
                        challenger_indices_local[challenger_local]]);
                end;
                baseline_units_local := split_text_units(
                    retained_local[baseline_idx_local].text);
                if Length(baseline_units_local) <> expected_units then
                begin
                    Exit;
                end;

                SetLength(window_offsets_local,
                    pairwise_challenger_count_local);
                SetLength(window_texts_local,
                    pairwise_challenger_count_local * 8);
                window_count_local := 0;
                for challenger_local := 0 to
                    pairwise_challenger_count_local - 1 do
                begin
                    candidate_idx_local :=
                        challenger_indices_local[challenger_local];
                    candidate_units_local := split_text_units(
                        retained_local[candidate_idx_local].text);
                    if (Length(candidate_units_local) <> expected_units) or
                        (retained_local[candidate_idx_local].changed_position < 0) or
                        (retained_local[candidate_idx_local].changed_position >=
                        expected_units) then
                    begin
                        Exit;
                    end;
                    window_offsets_local[challenger_local] :=
                        window_count_local;
                    for radius_local := 0 to 3 do
                    begin
                        window_start_local := Max(0,
                            retained_local[candidate_idx_local].changed_position -
                            radius_local);
                        window_end_local := Min(expected_units - 1,
                            retained_local[candidate_idx_local].changed_position +
                            radius_local);
                        window_texts_local[window_count_local] :=
                            join_units_local(baseline_units_local,
                            window_start_local, window_end_local);
                        Inc(window_count_local);
                        window_texts_local[window_count_local] :=
                            join_units_local(candidate_units_local,
                            window_start_local, window_end_local);
                        Inc(window_count_local);
                    end;
                end;
                SetLength(window_texts_local, window_count_local);
                if (window_count_local <= 0) or
                    (not get_cached_char_lm_scores(window_texts_local,
                    window_scores_local, clsm_suffix, '')) or
                    (Length(window_scores_local) <> window_count_local) then
                begin
                    Exit;
                end;

                populate_pair_candidate_features_local(
                    retained_local[baseline_idx_local],
                    baseline_features_local);
                best_idx_local := -1;
                pairwise_score_local := -MaxDouble;
                for challenger_local := 0 to
                    pairwise_challenger_count_local - 1 do
                begin
                    candidate_idx_local :=
                        challenger_indices_local[challenger_local];
                    populate_pair_candidate_features_local(
                        retained_local[candidate_idx_local],
                        candidate_features_local);
                    relation_features_local :=
                        Default(TncLongLocalPoolRelationFeatures);
                    relation_features_local.different_units := 1.0;
                    relation_features_local.different_runs := 1.0;
                    relation_features_local.max_different_run := 1.0;
                    relation_features_local.same_prefix_units :=
                        retained_local[candidate_idx_local].changed_position;
                    relation_features_local.same_suffix_units :=
                        expected_units -
                        retained_local[candidate_idx_local].changed_position - 1;
                    relation_features_local.difference_span_units := 1.0;
                    for radius_local := 0 to 3 do
                    begin
                        top_lm_local[radius_local] := window_scores_local[
                            window_offsets_local[challenger_local] +
                            radius_local * 2];
                        candidate_lm_local[radius_local] := window_scores_local[
                            window_offsets_local[challenger_local] +
                            radius_local * 2 + 1];
                    end;
                    build_long_local_pairwise_pool_features(
                        candidate_features_local, baseline_features_local,
                        relation_features_local, top_lm_local,
                        candidate_lm_local, model_features_local);
                    retained_local[candidate_idx_local].model_score :=
                        long_local_pairwise_pool_score(model_features_local);
                    if (best_idx_local < 0) or
                        (retained_local[candidate_idx_local].model_score >
                        pairwise_score_local) then
                    begin
                        best_idx_local := candidate_idx_local;
                        pairwise_score_local :=
                            retained_local[candidate_idx_local].model_score;
                    end;
                end;
                if best_idx_local < 0 then
                begin
                    Exit;
                end;
                if pairwise_score_local >=
                    c_long_local_pairwise_pool_top1_threshold then
                begin
                    pairwise_insert_rank_local := 0;
                end
                else if pairwise_score_local >=
                    c_long_local_pairwise_pool_top2_threshold then
                begin
                    pairwise_insert_rank_local := 1;
                end
                else
                begin
                    Exit;
                end;
                Result := True;
            end;
        begin
            m_long_local_rerank_generated_text := '';
            m_long_local_rerank_composition_text := '';
            m_long_local_rerank_lookup_key := '';
            if (use_pairwise_pool_model and
                nc_long_ablated(la_local_pairwise_pool)) or
                ((not use_pairwise_pool_model) and
                nc_long_ablated(la_local_residual)) then
            begin
                Exit;
            end;
            if (m_dictionary = nil) or short_exact_query_mode or
                (m_page_index <> 0) or (m_confirmed_text <> '') or
                (expected_units < 6) or (Length(Result) < 2) or
                forced_visible_top_candidate_applies or
                (Length(syllables) <> expected_units) then
            begin
                Exit;
            end;

            top_text_local := Trim(Result[0].text);
            if (top_text_local = '') or (Trim(Result[0].comment) <> '') or
                (get_candidate_text_unit_count(top_text_local) <> expected_units) or
                (Result[0].source = cs_user) or
                is_latest_session_query_choice(top_text_local) or
                display_candidate_is_persistent_latest_choice(
                normalized_pinyin, top_text_local) or
                m_dictionary.is_user_entry(normalized_pinyin,
                top_text_local) or
                (Result[0].has_dict_weight and
                m_dictionary.is_base_entry(normalized_pinyin,
                top_text_local)) then
            begin
                Exit;
            end;

            SetLength(pool_local, 0);
            single_option_limit_local := c_single_option_limit;
            if use_pairwise_pool_model then
            begin
                single_option_limit_local := c_pairwise_single_option_limit;
            end;
            model_tick_local := GetTickCount64;
            pool_index_by_text_local := TDictionary<string, Integer>.Create;
            retained_texts_local := TDictionary<string, Boolean>.Create;
            try
                original_count_local := 0;
                for visible_idx_local := 0 to Min(c_seed_probe_limit - 1,
                    High(Result)) do
                begin
                    if (Trim(Result[visible_idx_local].comment) <> '') or
                        (Trim(Result[visible_idx_local].text) = '') or
                        (Result[visible_idx_local].source = cs_user) or
                        (get_candidate_text_unit_count(
                        Trim(Result[visible_idx_local].text)) <> expected_units) then
                    begin
                        Continue;
                    end;
                    seed_units_local := split_text_units(
                        Trim(Result[visible_idx_local].text));
                    if Length(seed_units_local) <> expected_units then
                    begin
                        Continue;
                    end;
                    initialize_pool_item_local(item_local);
                    item_local.text := Trim(Result[visible_idx_local].text);
                    item_local.seed_rank := visible_idx_local + 1;
                    item_local.seed_visible_index := visible_idx_local;
                    item_local.original := True;
                    item_local.changed_position := -1;
                    retain_pool_item_local(item_local);
                    Inc(original_count_local);

                    if visible_idx_local >= c_generated_seed_limit then
                    begin
                        Continue;
                    end;

                    get_residual_repair_segments_local(
                        Result[visible_idx_local], visible_idx_local,
                        repair_segment_starts_local,
                        repair_segment_lengths_local);

                    for unit_idx_local := 0 to expected_units - 1 do
                    begin
                        if (unit_idx_local >=
                            Length(repair_segment_starts_local)) or
                            (unit_idx_local >=
                            Length(repair_segment_lengths_local)) or
                            (repair_segment_starts_local[unit_idx_local] < 0) or
                            (repair_segment_lengths_local[unit_idx_local] <= 0) then
                        begin
                            Continue;
                        end;
                        syllable_key_local := normalize_pinyin_text(
                            syllables[unit_idx_local].text);
                        if not get_single_options_local(syllable_key_local,
                            single_options_local) then
                        begin
                            Continue;
                        end;
                        source_weight_local := find_source_weight_local(
                            single_options_local, seed_units_local[unit_idx_local]);
                        for replacement_idx_local := 0 to
                            Min(single_option_limit_local - 1,
                            High(single_options_local)) do
                        begin
                            replacement_text_local := Trim(
                                single_options_local[replacement_idx_local].text);
                            if (replacement_text_local = '') or
                                SameText(replacement_text_local,
                                seed_units_local[unit_idx_local]) then
                            begin
                                Continue;
                            end;
                            repair_segment_start_local :=
                                repair_segment_starts_local[unit_idx_local];
                            repair_segment_length_local :=
                                repair_segment_lengths_local[unit_idx_local];
                            if (repair_segment_length_local > 1) and
                                (not is_productive_particle_tail_segment_local(
                                seed_units_local,
                                repair_segment_start_local,
                                repair_segment_length_local,
                                unit_idx_local)) then
                            begin
                                repaired_segment_text_local := '';
                                repaired_segment_key_local := '';
                                for repair_segment_unit_local :=
                                    repair_segment_start_local to
                                    repair_segment_start_local +
                                    repair_segment_length_local - 1 do
                                begin
                                    if repair_segment_unit_local =
                                        unit_idx_local then
                                    begin
                                        repaired_segment_text_local :=
                                            repaired_segment_text_local +
                                            replacement_text_local;
                                    end
                                    else
                                    begin
                                        repaired_segment_text_local :=
                                            repaired_segment_text_local +
                                            seed_units_local[
                                            repair_segment_unit_local];
                                    end;
                                    repaired_segment_key_local :=
                                        repaired_segment_key_local +
                                        normalize_pinyin_text(syllables[
                                        repair_segment_unit_local].text);
                                end;
                                if (repaired_segment_key_local = '') or
                                    (repaired_segment_text_local = '') or
                                    (not m_dictionary.is_base_entry(
                                    repaired_segment_key_local,
                                    repaired_segment_text_local)) then
                                begin
                                    Continue;
                                end;
                            end;
                            variant_text_local := build_variant_text_local(
                                seed_units_local, unit_idx_local,
                                replacement_text_local);
                            initialize_pool_item_local(item_local);
                            item_local.text := variant_text_local;
                            item_local.seed_rank := visible_idx_local + 1;
                            item_local.seed_visible_index := visible_idx_local;
                            item_local.original := False;
                            item_local.substitutions := 1;
                            item_local.changed_position := unit_idx_local;
                            item_local.source_char_weight := source_weight_local;
                            item_local.replacement_char_weight :=
                                candidate_raw_weight_local(
                                single_options_local[replacement_idx_local]);
                            retain_pool_item_local(item_local);
                        end;
                    end;
                end;
                if (original_count_local <= 0) or (Length(pool_local) <= 1) then
                begin
                    Exit;
                end;

                SetLength(candidate_texts_local, Length(pool_local));
                for pool_idx_local := 0 to High(pool_local) do
                begin
                    candidate_texts_local[pool_idx_local] :=
                        pool_local[pool_idx_local].text;
                end;
                if not get_cached_char_lm_scores(candidate_texts_local,
                    lm_scores_local, clsm_full, '') or
                    (Length(lm_scores_local) <> Length(pool_local)) then
                begin
                    Exit;
                end;
                SetLength(order_local, Length(pool_local));
                for pool_idx_local := 0 to High(pool_local) do
                begin
                    pool_local[pool_idx_local].char_lm_score :=
                        lm_scores_local[pool_idx_local];
                    order_local[pool_idx_local] := pool_idx_local;
                end;
                TArray.Sort<Integer>(order_local,
                    TComparer<Integer>.Construct(
                    function(const left_idx: Integer;
                        const right_idx: Integer): Integer
                    var
                        left_item_local: TncLongLocalRerankPoolItem;
                        right_item_local: TncLongLocalRerankPoolItem;
                        text_compare_local: Integer;
                    begin
                        left_item_local := pool_local[left_idx];
                        right_item_local := pool_local[right_idx];
                        if left_item_local.char_lm_score >
                            right_item_local.char_lm_score then
                        begin
                            Exit(-1);
                        end;
                        if left_item_local.char_lm_score <
                            right_item_local.char_lm_score then
                        begin
                            Exit(1);
                        end;
                        if left_item_local.substitutions <
                            right_item_local.substitutions then
                        begin
                            Exit(-1);
                        end;
                        if left_item_local.substitutions >
                            right_item_local.substitutions then
                        begin
                            Exit(1);
                        end;
                        if left_item_local.seed_rank <
                            right_item_local.seed_rank then
                        begin
                            Exit(-1);
                        end;
                        if left_item_local.seed_rank >
                            right_item_local.seed_rank then
                        begin
                            Exit(1);
                        end;
                        text_compare_local := CompareText(
                            left_item_local.text, right_item_local.text);
                        if text_compare_local > 0 then
                        begin
                            Exit(-1);
                        end;
                        if text_compare_local < 0 then
                        begin
                            Exit(1);
                        end;
                        Result := 0;
                    end));

                retained_count_local := Min(c_hidden_pool_limit,
                    Length(order_local));
                SetLength(retained_local, retained_count_local);
                for order_idx_local := 0 to retained_count_local - 1 do
                begin
                    retained_local[order_idx_local] :=
                        pool_local[order_local[order_idx_local]];
                    retained_texts_local.AddOrSetValue(LowerCase(
                        Trim(retained_local[order_idx_local].text)), True);
                end;
                for pool_idx_local := 0 to High(pool_local) do
                begin
                    if (not pool_local[pool_idx_local].original) or
                        retained_texts_local.ContainsKey(LowerCase(
                        Trim(pool_local[pool_idx_local].text))) then
                    begin
                        Continue;
                    end;
                    retained_idx_local := Length(retained_local);
                    SetLength(retained_local, retained_idx_local + 1);
                    retained_local[retained_idx_local] := pool_local[pool_idx_local];
                    retained_texts_local.AddOrSetValue(LowerCase(
                        Trim(pool_local[pool_idx_local].text)), True);
                end;

                baseline_idx_local := -1;
                best_idx_local := -1;
                for retained_idx_local := 0 to High(retained_local) do
                begin
                    retained_local[retained_idx_local].pool_rank :=
                        retained_idx_local + 1;
                    if retained_local[retained_idx_local].original then
                    begin
                        changed_ratio_local := -1.0;
                    end
                    else
                    begin
                        changed_ratio_local :=
                            retained_local[retained_idx_local].changed_position /
                            Max(1, expected_units - 1);
                    end;
                    if use_pairwise_pool_model then
                    begin
                        retained_local[retained_idx_local].model_score := 0.0;
                    end
                    else
                    begin
                        retained_local[retained_idx_local].model_score :=
                            long_local_residual_score(
                            retained_local[retained_idx_local].pool_rank,
                            retained_local[retained_idx_local].char_lm_score,
                            retained_local[retained_idx_local].seed_rank,
                            retained_local[retained_idx_local].original,
                            retained_local[retained_idx_local].substitutions,
                            changed_ratio_local,
                            retained_local[retained_idx_local].source_char_weight,
                            retained_local[retained_idx_local].replacement_char_weight);
                    end;
                    if retained_local[retained_idx_local].original and
                        (retained_local[retained_idx_local].seed_rank = 1) then
                    begin
                        baseline_idx_local := retained_idx_local;
                    end;
                    // The residual model is trained only against generated
                    // one-character repairs. Existing complete candidates
                    // retain their engine order and are not residual rivals.
                    if (not use_pairwise_pool_model) and
                        ((not retained_local[retained_idx_local].original) or
                        (retained_idx_local = baseline_idx_local)) and
                        ((best_idx_local < 0) or model_item_is_better_local(
                        retained_local[retained_idx_local],
                        retained_local[best_idx_local])) then
                    begin
                        best_idx_local := retained_idx_local;
                    end;
                end;
                if use_pairwise_pool_model then
                begin
                    if not score_pairwise_pool_local then
                    begin
                        Exit;
                    end;
                end
                else if (baseline_idx_local < 0) or (best_idx_local < 0) or
                    (best_idx_local = baseline_idx_local) then
                begin
                    Exit;
                end;
                if use_pairwise_pool_model then
                begin
                    // The independently calibrated pairwise model already
                    // selected whether this repair belongs at rank 1 or 2.
                end
                else if retained_local[best_idx_local].model_score <
                    retained_local[baseline_idx_local].model_score +
                    c_long_local_residual_promotion_margin then
                begin
                    Exit;
                end;

                best_item_local := retained_local[best_idx_local];
                if best_item_local.original then
                begin
                    visible_idx_local := best_item_local.seed_visible_index;
                    if (visible_idx_local <= 0) or
                        (visible_idx_local >= Length(Result)) then
                    begin
                        Exit;
                    end;
                    moved_candidate_local := Result[visible_idx_local];
                    moved_source_local := visible_source_indices[visible_idx_local];
                    for move_idx_local := visible_idx_local downto 2 do
                    begin
                        Result[move_idx_local] := Result[move_idx_local - 1];
                        visible_source_indices[move_idx_local] :=
                            visible_source_indices[move_idx_local - 1];
                    end;
                    Result[1] := Result[0];
                    visible_source_indices[1] := visible_source_indices[0];
                    Result[0] := moved_candidate_local;
                    visible_source_indices[0] := moved_source_local;
                    if (m_long_local_rerank_generated_text <> '') and
                        (not SameText(m_long_local_rerank_generated_text,
                        Trim(moved_candidate_local.text))) then
                    begin
                        m_long_local_rerank_generated_text := '';
                        m_long_local_rerank_composition_text := '';
                        m_long_local_rerank_lookup_key := '';
                    end;
                    Exit;
                end;

                generated_candidate_local :=
                    Result[best_item_local.seed_visible_index];
                generated_candidate_local.text := best_item_local.text;
                generated_candidate_local.comment := '';
                generated_candidate_local.source := cs_rule;
                generated_candidate_local.has_dict_weight := False;
                generated_candidate_local.dict_weight := 0;
                if use_pairwise_pool_model and
                    (pairwise_insert_rank_local = 1) then
                begin
                    for move_idx_local := High(Result) downto 2 do
                    begin
                        Result[move_idx_local] := Result[move_idx_local - 1];
                        visible_source_indices[move_idx_local] :=
                            visible_source_indices[move_idx_local - 1];
                    end;
                    Result[1] := generated_candidate_local;
                    visible_source_indices[1] := -1;
                end
                else
                begin
                    for move_idx_local := High(Result) downto 2 do
                    begin
                        Result[move_idx_local] := Result[move_idx_local - 1];
                        visible_source_indices[move_idx_local] :=
                            visible_source_indices[move_idx_local - 1];
                    end;
                    Result[1] := Result[0];
                    visible_source_indices[1] := visible_source_indices[0];
                    Result[0] := generated_candidate_local;
                    visible_source_indices[0] := -1;
                end;
                m_long_local_rerank_generated_text :=
                    Trim(generated_candidate_local.text);
                m_long_local_rerank_composition_text := m_composition_text;
                m_long_local_rerank_lookup_key := m_last_lookup_key;
            finally
                if m_config.debug_mode then
                begin
                    model_elapsed_local := GetTickCount64 - model_tick_local;
                    if m_last_lookup_debug_extra <> '' then
                    begin
                        m_last_lookup_debug_extra :=
                            m_last_lookup_debug_extra + ' ';
                    end;
                    if use_pairwise_pool_model then
                    begin
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('localpair=%d', [model_elapsed_local]);
                    end
                    else
                    begin
                        m_last_lookup_debug_extra := m_last_lookup_debug_extra +
                            Format('localres=%d', [model_elapsed_local]);
                    end;
                end;
                retained_texts_local.Free;
                pool_index_by_text_local.Free;
            end;
        end;

        procedure build_visible_long_sentence_candidate_pool_local;
        const
            c_short_exact_prefix_max_units = 6;
            c_short_compound_prefix_max_units = 5;
        var
            pool_candidates_local: TncCandidateList;
            pool_source_indices_local: TArray<Integer>;
            seen_candidates_local: TDictionary<string, Boolean>;
            long_candidate_count_local: Integer;

            function get_partial_prefix_units_local(
                const candidate_value_local: TncCandidate;
                out prefix_units_local: Integer): Boolean;
            var
                tail_syllables_local: TncPinyinParseResult;
                text_units_local: Integer;
            begin
                Result := False;
                prefix_units_local := umlaut_raw_prefix_units(candidate_value_local);
                if prefix_units_local > 0 then Exit(True);
                prefix_units_local := 0;
                if Trim(candidate_value_local.comment) = '' then
                begin
                    Exit;
                end;

                tail_syllables_local := get_effective_compact_pinyin_syllables(
                    normalize_pinyin_text(candidate_value_local.comment));
                if Length(tail_syllables_local) <= 0 then
                begin
                    Exit;
                end;
                prefix_units_local := expected_units -
                    Length(tail_syllables_local);
                text_units_local := get_candidate_text_unit_count(
                    Trim(candidate_value_local.text));
                Result := (prefix_units_local > 0) and
                    (prefix_units_local < expected_units) and
                    (text_units_local = prefix_units_local);
            end;

            function candidate_is_complete_long_local(
                const candidate_value_local: TncCandidate): Boolean;
            var
                text_local: string;
            begin
                text_local := Trim(candidate_value_local.text);
                Result := (text_local <> '') and
                    (Trim(candidate_value_local.comment) = '');
            end;

            function candidate_has_exact_compound_path_local(
                const candidate_value_local: TncCandidate;
                const source_idx_local: Integer;
                const prefix_units_local: Integer): Boolean;
            var
                path_local: string;
                path_parts_local: TArray<string>;
                part_text_local: string;
                part_key_local: string;
                combined_text_local: string;
                part_units_local: Integer;
                consumed_units_local: Integer;
                part_idx_local: Integer;
                source_is_compound_local: Boolean;
            begin
                Result := False;
                source_is_compound_local :=
                    candidate_value_local.display_kind = cdk_lm_compound;
                if (source_idx_local >= 0) and
                    (source_idx_local < Length(m_candidates)) then
                begin
                    source_is_compound_local := source_is_compound_local or
                        (m_candidates[source_idx_local].display_kind =
                        cdk_lm_compound);
                end;
                if (not source_is_compound_local) or
                    (prefix_units_local > c_short_compound_prefix_max_units)
                then
                begin
                    Exit;
                end;

                path_local := get_segment_path_for_candidate(
                    candidate_value_local, source_idx_local);
                path_parts_local := path_local.Split(
                    [c_segment_path_separator]);
                if Length(path_parts_local) <> 2 then
                begin
                    Exit;
                end;

                consumed_units_local := 0;
                combined_text_local := '';
                for part_idx_local := 0 to High(path_parts_local) do
                begin
                    part_text_local := Trim(path_parts_local[part_idx_local]);
                    part_units_local := get_candidate_text_unit_count(
                        part_text_local);
                    if (part_text_local = '') or (part_units_local <= 0) or
                        (consumed_units_local + part_units_local >
                        prefix_units_local) then
                    begin
                        Exit;
                    end;
                    part_key_local := build_display_query_key(
                        consumed_units_local, part_units_local);
                    if (part_key_local = '') or
                        (not (display_exact_key_has_text(part_key_local,
                        part_text_local) or
                        ((m_dictionary <> nil) and
                        (m_dictionary.is_base_entry(part_key_local,
                        part_text_local) or
                        m_dictionary.is_user_entry(part_key_local,
                        part_text_local))))) then
                    begin
                        Exit;
                    end;
                    combined_text_local := combined_text_local +
                        part_text_local;
                    Inc(consumed_units_local, part_units_local);
                end;

                Result := (consumed_units_local = prefix_units_local) and
                    SameText(combined_text_local,
                    Trim(candidate_value_local.text));
            end;

            function candidate_is_short_prefix_local(
                const candidate_value_local: TncCandidate;
                const source_idx_local: Integer;
                out prefix_units_local: Integer;
                out highlight_compound_local: Boolean): Boolean;
            var
                prefix_key_local: string;
                prefix_text_local: string;
            begin
                Result := False;
                highlight_compound_local := False;
                if not get_partial_prefix_units_local(candidate_value_local,
                    prefix_units_local) then
                begin
                    Exit;
                end;

                if (prefix_units_local <= c_short_exact_prefix_max_units) and
                    ((umlaut_raw_prefix_units(candidate_value_local) > 0) or
                    (alternative_exact_prefix_units(candidate_value_local) > 0)) then Exit(True);

                prefix_key_local := build_display_query_key(0,
                    prefix_units_local);
                prefix_text_local := Trim(candidate_value_local.text);
                if (prefix_key_local = '') or (prefix_text_local = '') then
                begin
                    Exit;
                end;

                if prefix_units_local = 1 then
                begin
                    Exit((m_dictionary <> nil) and
                        (m_dictionary.single_char_matches_pinyin(
                        prefix_key_local, prefix_text_local) or
                        display_exact_key_has_text(prefix_key_local,
                        prefix_text_local)));
                end;

                if (prefix_units_local <=
                    c_short_exact_prefix_max_units) and
                    (display_exact_key_has_text(prefix_key_local,
                    prefix_text_local) or
                    ((m_dictionary <> nil) and
                    (m_dictionary.is_base_entry(prefix_key_local,
                    prefix_text_local) or
                    m_dictionary.is_user_entry(prefix_key_local,
                    prefix_text_local))) or
                    ((candidate_value_local.fuzzy_cost > 0) and
                    candidate_value_local.has_dict_weight)) then
                begin
                    Exit(True);
                end;

                highlight_compound_local :=
                    candidate_has_exact_compound_path_local(
                    candidate_value_local, source_idx_local,
                    prefix_units_local);
                Result := highlight_compound_local;
            end;

            function candidate_is_long_partial_local(
                const candidate_value_local: TncCandidate;
                const source_idx_local: Integer): Boolean;
            var
                prefix_units_local: Integer;
                highlight_compound_local: Boolean;
            begin
                Result := False;
                if not get_partial_prefix_units_local(candidate_value_local,
                    prefix_units_local) then
                begin
                    Exit;
                end;
                if candidate_is_short_prefix_local(candidate_value_local,
                    source_idx_local, prefix_units_local,
                    highlight_compound_local) then
                begin
                    Exit;
                end;
                Result := prefix_units_local >= 3;
            end;

            procedure append_pool_candidate_local(
                const candidate_value_local: TncCandidate;
                const source_idx_local: Integer;
                const is_long_candidate_local: Boolean;
                const highlight_compound_local: Boolean);
            var
                normalized_candidate_local: TncCandidate;
                candidate_key_local: string;
                out_idx_local: Integer;
            begin
                normalized_candidate_local := candidate_value_local;
                normalize_display_candidate(normalized_candidate_local);
                if is_long_candidate_local then
                begin
                    // The accent color denotes an explicit short transition
                    // compound, not a sentence that happened to use LM data.
                    normalized_candidate_local.display_kind := cdk_default;
                    if normalized_candidate_local.comment <> '' then
                        normalized_candidate_local.display_kind := cdk_sentence_prefix;
                end
                else if highlight_compound_local then
                begin
                    normalized_candidate_local.display_kind :=
                        cdk_lm_compound;
                end;

                candidate_key_local := nc_visible_candidate_key(normalized_candidate_local,
                    normalize_pinyin_text(
                    Trim(normalized_candidate_local.comment)));
                if (Trim(normalized_candidate_local.text) = '') or
                    seen_candidates_local.ContainsKey(candidate_key_local) then
                begin
                    Exit;
                end;

                out_idx_local := Length(pool_candidates_local);
                SetLength(pool_candidates_local, out_idx_local + 1);
                SetLength(pool_source_indices_local, out_idx_local + 1);
                pool_candidates_local[out_idx_local] :=
                    normalized_candidate_local;
                pool_source_indices_local[out_idx_local] := source_idx_local;
                seen_candidates_local.Add(candidate_key_local, True);
            end;

            procedure append_complete_candidates_from_result_local;
            var
                idx_local: Integer;
            begin
                for idx_local := 0 to High(Result) do
                begin
                    if long_candidate_count_local >=
                        c_long_sentence_complete_candidate_display_limit then
                    begin
                        Exit;
                    end;
                    if not candidate_is_complete_long_local(Result[idx_local])
                    then
                    begin
                        Continue;
                    end;
                    append_pool_candidate_local(Result[idx_local],
                        visible_source_indices[idx_local], True, False);
                    long_candidate_count_local :=
                        Length(pool_candidates_local);
                end;
            end;

            procedure append_long_partials_from_list_local(
                const candidates_local: TncCandidateList;
                const source_indices_local: TArray<Integer>;
                const use_identity_source_local: Boolean);
            var
                idx_local: Integer;
                source_idx_local: Integer;
                before_count_local: Integer;
            begin
                for idx_local := 0 to High(candidates_local) do
                begin
                    if long_candidate_count_local >=
                        c_long_sentence_complete_candidate_display_limit then
                    begin
                        Exit;
                    end;
                    if use_identity_source_local then
                    begin
                        source_idx_local := idx_local;
                    end
                    else if idx_local < Length(source_indices_local) then
                    begin
                        source_idx_local := source_indices_local[idx_local];
                    end
                    else
                    begin
                        source_idx_local := -1;
                    end;
                    if not candidate_is_long_partial_local(
                        candidates_local[idx_local], source_idx_local) then
                    begin
                        Continue;
                    end;
                    before_count_local := Length(pool_candidates_local);
                    append_pool_candidate_local(candidates_local[idx_local],
                        source_idx_local, True, False);
                    if Length(pool_candidates_local) > before_count_local then
                    begin
                        Inc(long_candidate_count_local);
                    end;
                end;
            end;

            procedure append_short_prefixes_from_list_local(
                const candidates_local: TncCandidateList;
                const source_indices_local: TArray<Integer>;
                const use_identity_source_local: Boolean;
                const append_single_local: Boolean);
            var
                idx_local: Integer;
                source_idx_local: Integer;
                prefix_units_local: Integer;
                highlight_compound_local: Boolean;
            begin
                for idx_local := 0 to High(candidates_local) do
                begin
                    if use_identity_source_local then
                    begin
                        source_idx_local := idx_local;
                    end
                    else if idx_local < Length(source_indices_local) then
                    begin
                        source_idx_local := source_indices_local[idx_local];
                    end
                    else
                    begin
                        source_idx_local := -1;
                    end;
                    if not candidate_is_short_prefix_local(
                        candidates_local[idx_local], source_idx_local,
                        prefix_units_local, highlight_compound_local) then
                    begin
                        Continue;
                    end;
                    if (prefix_units_local = 1) <> append_single_local then
                    begin
                        Continue;
                    end;
                    append_pool_candidate_local(candidates_local[idx_local],
                        source_idx_local, False, highlight_compound_local);
                end;
            end;

            procedure append_all_first_syllable_singles_local;
            var
                first_key_local: string;
                tail_key_local: string;
                exact_singles_local: TncCandidateList;
                single_candidate_local: TncCandidate;
                idx_local: Integer;
            begin
                first_key_local := build_display_query_key(0, 1);
                tail_key_local := build_display_query_key(1,
                    expected_units - 1);
                if (first_key_local = '') or (tail_key_local = '') or
                    (not lookup_display_exact_cached(first_key_local,
                    exact_singles_local)) then
                begin
                    Exit;
                end;

                for idx_local := 0 to High(exact_singles_local) do
                begin
                    single_candidate_local := exact_singles_local[idx_local];
                    if (Trim(single_candidate_local.comment) <> '') or
                        (get_candidate_text_unit_count(
                        Trim(single_candidate_local.text)) <> 1) then
                    begin
                        Continue;
                    end;
                    single_candidate_local.comment := tail_key_local;
                    single_candidate_local.has_dict_weight := False;
                    single_candidate_local.dict_weight := 0;
                    single_candidate_local.display_kind := cdk_default;
                    append_pool_candidate_local(single_candidate_local, -1,
                        False, False);
                end;
            end;

            procedure append_nasal_boundary_singles_local;
            var
                first_key, head_key, tail_key: string;
                tail_parts: TncPinyinParseResult;
                singles: TncCandidateList;
                item, reserved: TncCandidate;
                idx, before_count, first_added, insert_at: Integer;
            begin
                if is_shuangpin_input or (Length(syllables) < 2) or
                    (Pos('''', m_composition_text) > 0) then Exit;
                first_key := normalize_pinyin_text(syllables[0].text);
                if (Length(first_key) < 3) or
                    (Copy(first_key, Length(first_key) - 1, 2) <> 'ng') or
                    (Copy(normalized_pinyin, 1, Length(first_key)) <> first_key) then Exit;
                head_key := Copy(first_key, 1, Length(first_key) - 1);
                if not nc_is_canonical_pinyin_syllable(head_key) then Exit;
                tail_key := Copy(normalized_pinyin, Length(head_key) + 1, MaxInt);
                tail_parts := get_effective_compact_pinyin_syllables(tail_key);
                if (Length(tail_parts) = 0) or (Length(tail_parts[0].text) < 2) or
                    (tail_parts[0].text[1] <> 'g') then Exit;
                for idx := 0 to High(tail_parts) do
                    if not nc_is_canonical_pinyin_syllable(tail_parts[idx].text) then Exit;
                if not lookup_display_exact_cached(head_key, singles) then Exit;

                // Keep the preferred ng parse. Alternative n/g characters are
                // selectable prefixes, not new paths or learned compounds.
                first_added := -1;
                for idx := 0 to High(singles) do
                begin
                    item := singles[idx];
                    if (item.comment <> '') or
                        (get_candidate_text_unit_count(item.text) <> 1) then Continue;
                    item.comment := tail_key;
                    item.display_kind := cdk_default;
                    before_count := Length(pool_candidates_local);
                    append_pool_candidate_local(item, -1, False, False);
                    if (first_added < 0) and
                        (Length(pool_candidates_local) > before_count) then
                        first_added := before_count;
                end;
                if first_added < 0 then Exit;

                // One alternative before the long tail of ng homophones; all
                // remaining characters stay pageable. Never displace Top1/2
                // or move a single character ahead of word/exact candidates.
                insert_at := 0;
                while (insert_at < first_added) and
                    ((get_candidate_text_unit_count(pool_candidates_local[insert_at].text) <> 1) or
                    (pool_candidates_local[insert_at].comment = '')) do Inc(insert_at);
                insert_at := Min(first_added, Max(2, insert_at + 1));
                reserved := pool_candidates_local[first_added];
                for idx := first_added downto insert_at + 1 do
                begin
                    pool_candidates_local[idx] := pool_candidates_local[idx - 1];
                    pool_source_indices_local[idx] := pool_source_indices_local[idx - 1];
                end;
                pool_candidates_local[insert_at] := reserved;
                pool_source_indices_local[insert_at] := -1;
                if expected_units < c_long_sentence_full_path_min_syllables then
                begin
                    Result := Copy(pool_candidates_local, 0, visible_page_size);
                    visible_source_indices := Copy(pool_source_indices_local, 0, visible_page_size);
                end;
            end;

            procedure order_short_pool_prefix_tiers_local;
            var
                prefix_units: TArray<Integer>;
                idx, units: Integer;
            begin
                SetLength(prefix_units, Length(pool_candidates_local));
                for idx := 0 to High(pool_candidates_local) do
                begin
                    if not get_partial_prefix_units_local(
                        pool_candidates_local[idx], units) then Continue;
                    prefix_units[idx] := units;
                end;
                nc_order_candidate_prefix_tiers(pool_candidates_local,
                    pool_source_indices_local, prefix_units, expected_units);
            end;

            procedure build_short_visible_candidate_pool_local;
            var
                candidate_idx_local: Integer;
                source_idx_local: Integer;
                candidate_local: TncCandidate;
                keep_full_exact_local: Boolean;
                keep_apostrophe_partial_local: Boolean;
            begin
                if (m_page_index <> 0) or (expected_units < 2) or
                    (expected_units >= c_long_sentence_full_path_min_syllables) or
                    (normalized_pinyin = '') then
                begin
                    Exit;
                end;

                SetLength(pool_candidates_local, 0);
                SetLength(pool_source_indices_local, 0);
                seen_candidates_local := TDictionary<string, Boolean>.Create;
                try
                    { Collect the processed first page and remaining source
                      candidates once. Merge scored word-prefix groups before
                      pagination, keeping singles last and complete slots fixed. }
                    for candidate_idx_local := 0 to High(Result) do
                    begin
                        if candidate_idx_local < Length(visible_source_indices) then
                        begin
                            source_idx_local :=
                                visible_source_indices[candidate_idx_local];
                        end
                        else
                        begin
                            source_idx_local := -1;
                        end;
                        append_pool_candidate_local(Result[candidate_idx_local],
                            source_idx_local, False,
                            Result[candidate_idx_local].display_kind =
                            cdk_lm_compound);
                    end;

                    for candidate_idx_local := 0 to High(m_candidates) do
                    begin
                        candidate_local := m_candidates[candidate_idx_local];
                        normalize_display_candidate(candidate_local);
                        keep_full_exact_local :=
                            is_protected_full_query_exact_local(candidate_local);
                        keep_apostrophe_partial_local :=
                            display_candidate_is_explicit_apostrophe_prefix_partial(
                            candidate_local);

                        if (not keep_full_exact_local) and
                            candidate_is_visible_repeated_initial_reduplicated_local(
                            candidate_local) then
                        begin
                            Continue;
                        end;
                        if (not keep_full_exact_local) and
                            (not keep_apostrophe_partial_local) and
                            display_candidate_should_drop_short_invalid_partial(
                            candidate_local) then
                        begin
                            Continue;
                        end;
                        if (not keep_full_exact_local) and
                            (not keep_apostrophe_partial_local) and
                            display_candidate_should_drop_short_nonlexicon_complete(
                            candidate_local, candidate_idx_local) then
                        begin
                            Continue;
                        end;
                        if (not keep_full_exact_local) and
                            (not keep_apostrophe_partial_local) and
                            candidate_is_repeated_particle_tail_complete_local(
                            candidate_local) then
                        begin
                            Continue;
                        end;
                        if (not keep_full_exact_local) and
                            (not keep_apostrophe_partial_local) and
                            candidate_is_non_strict_one_plus_two_complete(
                            candidate_local, candidate_idx_local) then
                        begin
                            Continue;
                        end;

                        append_pool_candidate_local(candidate_local,
                            candidate_idx_local, False,
                            candidate_local.display_kind = cdk_lm_compound);
                    end;

                    order_short_pool_prefix_tiers_local;
                    append_nasal_boundary_singles_local;
                    nc_copy_candidate_page(pool_candidates_local, pool_source_indices_local,
                        0, visible_page_size, Result, visible_source_indices);
                    m_long_visible_candidate_pool_cache := Copy(
                        pool_candidates_local, 0, Length(pool_candidates_local));
                    m_long_visible_candidate_pool_source_indices_cache := Copy(
                        pool_source_indices_local, 0,
                        Length(pool_source_indices_local));
                    m_long_visible_candidate_pool_cache_key :=
                        get_long_visible_candidate_pool_cache_key(
                        visible_page_size);
                    m_long_visible_candidate_pool_source_signature :=
                        get_candidate_state_signature;
                    m_long_visible_candidate_pool_cache_valid := True;
                finally
                    seen_candidates_local.Free;
                end;
            end;
        begin
            if expected_units < c_long_sentence_full_path_min_syllables then
            begin
                build_short_visible_candidate_pool_local;
                Exit;
            end;
            if short_exact_query_mode or
                (normalized_pinyin = '') or
                ((expected_units <= 6) and
                (Length(protected_full_query_exacts) > 0)) then
            begin
                Exit;
            end;

            SetLength(pool_candidates_local, 0);
            SetLength(pool_source_indices_local, 0);
            seen_candidates_local := TDictionary<string, Boolean>.Create;
            try
                long_candidate_count_local := 0;
                append_complete_candidates_from_result_local;
                if long_candidate_count_local <
                    c_long_sentence_complete_candidate_display_limit then
                begin
                    append_long_partials_from_list_local(Result,
                        visible_source_indices, False);
                end;
                if long_candidate_count_local <
                    c_long_sentence_complete_candidate_display_limit then
                begin
                    append_long_partials_from_list_local(m_candidates,
                        visible_source_indices, True);
                end;

                // Prefix words precede first-syllable singles, matching the
                // short-word display categories without exposing more
                // sentence-path variants.
                append_short_prefixes_from_list_local(Result,
                    visible_source_indices, False, False);
                append_short_prefixes_from_list_local(m_candidates,
                    visible_source_indices, True, False);
                append_short_prefixes_from_list_local(Result,
                    visible_source_indices, False, True);
                append_short_prefixes_from_list_local(m_candidates,
                    visible_source_indices, True, True);
                append_all_first_syllable_singles_local;
                append_nasal_boundary_singles_local;

                m_long_visible_candidate_pool_cache := Copy(
                    pool_candidates_local, 0, Length(pool_candidates_local));
                m_long_visible_candidate_pool_source_indices_cache := Copy(
                    pool_source_indices_local, 0,
                    Length(pool_source_indices_local));
                m_long_visible_candidate_pool_cache_key :=
                    get_long_visible_candidate_pool_cache_key(
                    visible_page_size);
                m_long_visible_candidate_pool_source_signature :=
                    get_candidate_state_signature;
                m_long_visible_candidate_pool_cache_valid := True;

                nc_copy_candidate_page(pool_candidates_local, pool_source_indices_local,
                    m_page_index, visible_page_size, Result, visible_source_indices);
            finally
                seen_candidates_local.Free;
            end;
        end;
        procedure add_decreasing_sentence_prefixes_local;
        var
            pool, prefixes, exact_items, short_prefixes: TncCandidateList;
            sources: TArray<Integer>;
            words, tails, resolved_words: TArray<string>;
            path, prefix_path, key: string;
            idx, consumed, units, head_count, prefix_idx: Integer;
            function append_exact_words(const span: string): Boolean;
            var remaining, take, word_offset, probe: Integer; part: string;
            begin
                Result := False;
                word_offset := 0;
                remaining := Length(span);
                if remaining <> get_candidate_text_unit_count(span) then Exit;
                while remaining > 0 do
                begin
                    // Some final paths retain a whole decoded prefix as one
                    // segment. Resolve only its word boundaries, not its text
                    // or score. The walk is bounded and reuses exact lookups.
                    take := 0;
                    for probe := Min(4, remaining) downto 1 do
                    begin
                        part := Copy(span, word_offset + 1, probe);
                        if display_exact_key_has_text(
                            build_display_query_key(consumed, probe), part) then
                        begin
                            take := probe;
                            Break;
                        end;
                    end;
                    if take = 0 then Exit;
                    SetLength(resolved_words, Length(resolved_words) + 1);
                    resolved_words[High(resolved_words)] := part;
                    Inc(consumed, take);
                    Inc(word_offset, take);
                    Dec(remaining, take);
                end;
                Result := True;
            end;
            procedure restore_exact_word_prefixes;
            var count, word_units, item_idx, insertion: Integer;
                item: TncCandidate;
                prefix_key, tail: string;
                function already_visible(const value: TncCandidate): Boolean;
                var pool_idx: Integer;
                begin
                    for pool_idx := 0 to High(pool) do
                        if (pool[pool_idx].text = value.text) and
                            (pool[pool_idx].comment = value.comment) then Exit(True);
                    Result := False;
                end;
            begin
                short_prefixes := nil;
                for word_units := Min(6, expected_units - 1) downto 2 do
                begin
                    prefix_key := build_display_query_key(0, word_units);
                    if not lookup_display_exact_cached(prefix_key, exact_items) then Continue;
                    tail := build_display_query_key(word_units, expected_units - word_units);
                    for item_idx := 0 to High(exact_items) do
                    begin
                        item := exact_items[item_idx];
                        if (item.comment <> '') or
                            (get_candidate_text_unit_count(item.text) <> word_units) then Continue;
                        item.comment := tail;
                        item.display_kind := cdk_default;
                        count := Length(short_prefixes);
                        SetLength(short_prefixes, count + 1);
                        short_prefixes[count] := item;
                    end;
                end;
                // Keep existing prefix ordering; fill missing exact words before
                // the single-character tier, with the same page/source mapping.
                insertion := head_count + Length(prefixes);
                while (insertion < Length(pool)) and
                    (get_candidate_text_unit_count(pool[insertion].text) > 1) do Inc(insertion);
                // Insert only missing entries so an existing user/context order
                // and its source metadata cannot be displaced by this fallback.
                count := 0;
                for item_idx := 0 to High(short_prefixes) do
                begin
                    item := short_prefixes[item_idx];
                    if already_visible(item) then Continue;
                    short_prefixes[count] := item;
                    Inc(count);
                end;
                SetLength(short_prefixes, count);
                nc_insert_sentence_prefixes(pool, sources, short_prefixes, insertion);
            end;
        begin
            if (m_page_index <> 0) or short_exact_query_mode or
                (expected_units < c_long_sentence_full_path_min_syllables) or
                (expected_units > 64) or
                (Length(Result) = 0) or (m_dictionary = nil) or
                is_fuzzy_pinyin_active or
                not long_visible_candidate_pool_cache_is_current(visible_page_size) then Exit;
            pool := Copy(m_long_visible_candidate_pool_cache);
            sources := Copy(m_long_visible_candidate_pool_source_indices_cache);
            if Length(pool) = 0 then Exit;
            head_count := 0;
            while (head_count < Length(pool)) and (head_count < 2) and
                (pool[head_count].comment = '') do Inc(head_count);
            // Do not displace either ranked complete result. With no complete
            // path, retain the existing best partial as the anchor instead.
            if head_count = 0 then head_count := 1;
            path := get_segment_path_for_candidate(pool[0], sources[0]);
            if (path = '') or
                (StringReplace(path, c_segment_path_separator, '', [rfReplaceAll]) <>
                pool[0].text) then Exit;
            words := path.Split([c_segment_path_separator], TStringSplitOptions.ExcludeEmpty);
            consumed := 0;
            resolved_words := nil;
            for idx := 0 to High(words) do
            begin
                units := get_candidate_text_unit_count(words[idx]);
                if (units <= 0) or (consumed + units > Length(syllables)) then Exit;
                key := build_display_query_key(consumed, units);
                // Validate the path against this query's syllable alignment.
                // Use the existing display cache; never start another search.
                if display_exact_key_has_text(key, words[idx]) then
                begin
                    SetLength(resolved_words, Length(resolved_words) + 1);
                    resolved_words[High(resolved_words)] := words[idx];
                    Inc(consumed, units);
                end
                else if not append_exact_words(words[idx]) then
                begin
                    // An uncertain tail must not erase already verified earlier
                    // boundaries. Keep it opaque and never offer a cut inside it.
                    if (consumed < 4) or
                        (Length(pool[0].text) <> get_candidate_text_unit_count(pool[0].text)) then Exit;
                    SetLength(resolved_words, Length(resolved_words) + 1);
                    resolved_words[High(resolved_words)] := Copy(pool[0].text, consumed + 1, MaxInt);
                    Break;
                end;
            end;
            words := resolved_words;
            SetLength(tails, Length(words));
            consumed := 0;
            for idx := 0 to High(words) do
            begin
                Inc(consumed, get_candidate_text_unit_count(words[idx]));
                tails[idx] := build_display_query_key(consumed, expected_units - consumed);
            end;
            prefixes := nc_sentence_prefix_candidates(pool[0], words, tails, 4 - head_count);
            if Length(prefixes) = 0 then Exit;
            prefix_path := '';
            consumed := 0;
            for idx := 0 to High(words) do
            begin
                if prefix_path <> '' then prefix_path := prefix_path + c_segment_path_separator;
                prefix_path := prefix_path + words[idx];
                Inc(consumed, Length(words[idx]));
                for prefix_idx := 0 to High(prefixes) do
                    if Length(prefixes[prefix_idx].text) = consumed then
                        remember_segment_path_for_candidate(prefixes[prefix_idx].text,
                            prefixes[prefix_idx].comment, prefix_path);
            end;
            // Replace the old arbitrary second partial, if any, with real
            // decreasing word-boundary stops. All ordinary prefixes stay intact.
            if (head_count = 1) and (Length(pool) > 1) and
                (pool[1].display_kind = cdk_sentence_prefix) then
            begin
                Delete(pool, 1, 1);
                Delete(sources, 1, 1);
            end;
            nc_insert_sentence_prefixes(pool, sources, prefixes, head_count);
            restore_exact_word_prefixes;
            m_long_visible_candidate_pool_cache := pool;
            m_long_visible_candidate_pool_source_indices_cache := sources;
            nc_copy_candidate_page(pool, sources, 0, visible_page_size,
                Result, visible_source_indices);
        end;
        function prepare_paging_candidate(const source_index: Integer;
            const beyond_first_page: Boolean; out value: TncCandidate): Boolean;
        var protected_exact, explicit_prefix: Boolean;
        begin
            value := m_candidates[source_index];
            if (m_dictionary <> nil) and (user_entry_query <> '') and
                (Trim(value.comment) = '') and
                m_dictionary.is_user_entry(user_entry_query, Trim(value.text)) then
            begin
                value.source := cs_user;
                value.has_dict_weight := False;
                value.dict_weight := 0;
            end;
            normalize_display_candidate(value);
            protected_exact := is_protected_full_query_exact_local(value);
            if (not protected_exact) and beyond_first_page and
                candidate_is_visible_repeated_initial_reduplicated_local(value) then
                Exit(False);
            explicit_prefix := display_candidate_is_explicit_apostrophe_prefix_partial(value);
            Result := protected_exact or explicit_prefix or
                not (display_candidate_should_drop_short_invalid_partial(value) or
                display_candidate_should_drop_short_nonlexicon_complete(value, source_index) or
                candidate_is_repeated_particle_tail_complete_local(value) or
                candidate_is_non_strict_one_plus_two_complete(value, source_index));
        end;

        procedure freeze_remaining_pages;
        var idx, count: Integer; value: TncCandidate; key: string;
            pool: TncCandidateList; sources: TArray<Integer>;
        begin
            if ((not m_config.candidate_expand_on_paging) and (not short_context_swapped)) or (m_page_index <> 0) or
                long_visible_candidate_pool_cache_is_current(visible_page_size) then Exit;
            // Most queries already have a final pool. Freeze the same filtered
            // tail for single syllables/long exacts without another search.
            count := Length(Result);
            SetLength(pool, count + Length(m_candidates));
            SetLength(sources, Length(pool));
            emitted_visible_texts.Clear;
            for idx := 0 to count - 1 do
            begin
                pool[idx] := Result[idx];
                sources[idx] := visible_source_indices[idx];
                emitted_visible_texts.AddOrSetValue(
                    nc_visible_candidate_key(pool[idx], pool[idx].comment), True);
            end;
            for idx := 0 to High(m_candidates) do
            begin
                if not prepare_paging_candidate(idx, True, value) then Continue;
                if Trim(value.text) = '' then Continue;
                if (Trim(value.comment) <> '') and
                    complete_visible_texts.ContainsKey(LowerCase(Trim(value.text))) then Continue;
                key := nc_visible_candidate_key(value, value.comment);
                if emitted_visible_texts.ContainsKey(key) then Continue;
                emitted_visible_texts.Add(key, True);
                pool[count] := value;
                sources[count] := idx;
                Inc(count);
            end;
            // A sparse first page must not change when navigating back to it.
            if (Length(Result) < visible_page_size) and (count > Length(Result)) then Exit;
            SetLength(pool, count);
            SetLength(sources, count);
            m_long_visible_candidate_pool_cache := pool;
            m_long_visible_candidate_pool_source_indices_cache := sources;
            m_long_visible_candidate_pool_cache_key :=
                get_long_visible_candidate_pool_cache_key(visible_page_size);
            m_long_visible_candidate_pool_source_signature := get_candidate_state_signature;
            m_long_visible_candidate_pool_cache_valid := True;
        end;
    begin
        capture_supported_transition_top_local;
        capture_short_exact_ranked_order_local;
        retain_all_full_query_exact_candidates_local;
        normalize_first_syllable_single_partial_order_local;
        sanitize_short_partial_segment_paths;
        if not m_last_lookup_prefix_partial_fast then
        begin
            ensure_display_fixed_wo_tail_candidate_visible;
            ensure_display_short_particle_tail_candidate_visible;
            ensure_display_top_complete_prefix_partial_visible;
        end
        else if Pos('spf=particle', m_last_lookup_debug_extra) > 0 then
        begin
            ensure_display_short_particle_tail_candidate_visible;
        end;
        // Short exact candidates already have their final category and
        // dictionary-weight order. The generic promoter uses path/display
        // scores and must not run while assembling this page.
        if (not short_exact_predictive_prefix_only_mode) and
            (not m_last_lookup_prefix_partial_fast) then
        begin
            append_long_display_first_syllable_partials_to_fill_page;
        end;
        if expected_units >= 4 then
        begin
            insert_fixed_quantity_tail_candidate_from_partial;
            remove_bad_fixed_tail_candidates;
        end;
        restore_short_exact_ranked_order_local;
        restore_supported_transition_top_local;
        insert_short_exact_lexicon_completion_local;
        insert_umlaut_raw_prefixes_local;
        if m_last_lookup_prefix_partial_fast then
        begin
            ensure_fuzzy_short_single_prefixes_visible_local;
        end;
        normalize_page_and_selection;
        start_index := m_page_index * visible_page_size;
        promoted_repeated_initial_count := 0;
        if m_page_index <> 0 then
        begin
            promoted_repeated_initial_count :=
                get_promoted_repeated_initial_candidate_count_local;
            if promoted_repeated_initial_count > 0 then
            begin
                start_index := Max(0, start_index -
                    promoted_repeated_initial_count);
            end;
        end;
        end_index := start_index + visible_page_size - 1;
        if end_index > High(m_candidates) then
        begin
            end_index := High(m_candidates);
        end;

        complete_visible_texts := TDictionary<string, Boolean>.Create;
        emitted_visible_texts := TDictionary<string, Boolean>.Create;
        try
            if ((expected_units = 1) or (m_last_lookup_syllable_count = 1)) then
            begin
                for source_idx := 0 to High(m_candidates) do
                begin
                    candidate := m_candidates[source_idx];
                    normalize_display_candidate(candidate);
                    if (Trim(candidate.text) <> '') and
                        (Trim(candidate.comment) = '') then
                    begin
                        complete_visible_texts.AddOrSetValue(
                            LowerCase(Trim(candidate.text)), True);
                    end;
                end;
            end;

            SetLength(Result, visible_page_size);
            SetLength(visible_source_indices, visible_page_size);
            page_idx := 0;
            source_idx := start_index;
            while (source_idx <= High(m_candidates)) and
                (page_idx < visible_page_size) do
            begin
                if not prepare_paging_candidate(source_idx, m_page_index <> 0, candidate) then
                begin
                    Inc(source_idx);
                    Continue;
                end;
                Inc(source_idx);

                candidate_key := LowerCase(Trim(candidate.text));
                if (candidate_key <> '') and (Trim(candidate.comment) <> '') and
                    complete_visible_texts.ContainsKey(candidate_key) then
                begin
                    Continue;
                end;
                if (candidate_key <> '') and
                    emitted_visible_texts.ContainsKey(candidate_key) then
                begin
                    Continue;
                end;

                Result[page_idx] := candidate;
                visible_source_indices[page_idx] := source_idx - 1;
                if candidate_key <> '' then
                begin
                    emitted_visible_texts.AddOrSetValue(candidate_key, True);
                end;
                Inc(page_idx);
            end;

            if page_idx <> Length(Result) then
            begin
                SetLength(Result, page_idx);
                SetLength(visible_source_indices, page_idx);
            end;
            apply_forced_visible_top_candidate;
            promote_visible_short_particle_tail_completion_over_partial;
            supplement_visible_short_prefix_exact_alternatives;
            demote_visible_long_sentence_partials_below_complete;
            promote_visible_pathful_complete_over_unbacked_generated_top;
            sanitize_visible_short_partial_source_paths;
            filter_visible_short_nonlexicon_complete_candidates;
            promote_visible_pathful_complete_over_unbacked_generated_top;
            promote_visible_higher_scored_complete_long_candidate;
            demote_visible_long_sentence_partials_below_complete;
            promote_visible_left_boundary_when_candidate_is_stronger;
            promote_visible_repeated_initial_reduplicated_candidates;
            apply_forced_visible_top_candidate;
            dedupe_visible_text_comment_candidates;
            ensure_explicit_apostrophe_prefix_partial_visible;
            promote_visible_full_query_exact_over_generated_top;
            // Whole-query lexical/user exacts were already boundary-validated
            // and ordered above. Sentence models rank composed paths, not a
            // replacement for an exact entry that happens to be a long word.
            SetLength(m_char_lm_long_pool, 0);
            SetLength(m_char_lm_long_pool_ranks, 0);
            if (expected_units < c_long_sentence_full_path_min_syllables) or
                (Length(protected_full_query_exacts) = 0) then
            begin
                rerank_visible_complete_long_candidates_by_lm;
                rerank_visible_complete_long_candidates_by_char_lm;
                // Keep the proven local model as a first-stage proposal generator.
                // Its output is folded into the internal complete pool below; only
                // the unified pool ranker is allowed to decide the visible order.
                rerank_visible_complete_long_candidates_by_local_model_pass(
                    False);
                // Preserve the established long-sentence pipeline as the
                // first-stage seed ranker. Its visible-looking result remains
                // internal: the complete pool below performs the only final
                // ordering that is exposed to the user.
                apply_long_final_visible_candidate_ranking(Result,
                    visible_source_indices);
                rerank_visible_complete_long_candidates_by_local_model_pass(
                    True);
                apply_long_complete_candidate_pool(Result,
                    visible_source_indices, normalized_pinyin, syllables,
                    expected_units);
            end;
            note_display_phase('longpool');
            promote_strong_short_four_two_exact_path_visible_local(Result,
                visible_source_indices);
            if expected_units >= c_long_sentence_full_path_min_syllables then
            begin
                build_visible_long_sentence_candidate_pool_local;
            end;
            promote_visible_longest_exact_prefix_partial_local;
            restore_visible_supported_transition_top_local;
            if expected_units < c_long_sentence_full_path_min_syllables then
            begin
                build_visible_long_sentence_candidate_pool_local;
            end;
            add_decreasing_sentence_prefixes_local;
            if (m_page_index = 0) and (not m_candidate_navigation_started) and
                (expected_units >= 2) and (expected_units <= 4) and
                (not is_shuangpin_input) and (not is_fuzzy_pinyin_active) then
            begin
                short_context_swapped := False;
                if m_segment_left_context <> '' then
                    char_lm_context := m_segment_left_context
                else if m_external_left_context <> '' then
                    char_lm_context := m_external_left_context
                else
                    char_lm_context := m_left_context;
                // A promotion freezes later pages.
                if apply_char_lm_short_top(Result, visible_source_indices,
                    char_lm_context, normalized_pinyin, visible_page_size) then
                    short_context_swapped := True;
            end;
            if apply_char_lm_long_top(Result, visible_source_indices, expected_units,
                visible_page_size) then
                short_context_swapped := True;
            // The pinyin-conditioned LM repairs the settled top1.
            apply_visible_local_repair(Result, visible_source_indices, expected_units);
            if apply_mixed_abbreviation_top(Result, visible_source_indices,
                visible_page_size) then
                short_context_swapped := True;
            if (Length(Result) > 0) and
                (Trim(Result[0].comment) = '') and
                (get_candidate_text_unit_count(Trim(Result[0].text)) =
                expected_units) then
            begin
                visible_ranked_source_index := visible_source_indices[0];
                if (visible_ranked_source_index >= 0) and
                    (visible_ranked_source_index < Length(m_candidates)) then
                begin
                    visible_ranked_top_path := get_segment_path_for_candidate(
                        m_candidates[visible_ranked_source_index],
                        visible_ranked_source_index);
                    if get_encoded_path_segment_count_local(
                        visible_ranked_top_path) > 1 then
                    begin
                        m_last_ranked_query_key := normalized_pinyin;
                        m_last_ranked_top_path := visible_ranked_top_path;
                    end;
                end;
            end;
            if short_context_swapped and long_visible_candidate_pool_cache_is_current(visible_page_size) then
                for page_idx := 0 to Min(1, Min(High(Result),
                    High(m_long_visible_candidate_pool_cache))) do
                begin
                    m_long_visible_candidate_pool_cache[page_idx] := Result[page_idx];
                    m_long_visible_candidate_pool_source_indices_cache[page_idx] := visible_source_indices[page_idx];
                end;
            freeze_remaining_pages;
            cache_visible_candidate_page(Result, visible_source_indices, visible_page_size);
        finally
            emitted_visible_texts.Free;
            complete_visible_texts.Free;
        end;
        note_display_phase('page');
    end;

    function infer_relaxed_missing_apostrophe_units_from_candidates: Integer;
    var
        idx_local: Integer;
        head_units_local: Integer;
        tail_units_local: Integer;
        tail_key_local: string;
    begin
        Result := 0;
        for idx_local := 0 to High(m_candidates) do
        begin
            tail_key_local := normalize_pinyin_text(
                Trim(m_candidates[idx_local].comment));
            if (tail_key_local = '') or
                (not is_relaxed_no_initial_syllable_text(tail_key_local)) then
            begin
                Continue;
            end;

            head_units_local := get_candidate_text_unit_count(
                Trim(m_candidates[idx_local].text));
            tail_units_local := get_effective_compact_pinyin_unit_count(
                tail_key_local);
            if (head_units_local > 0) and (tail_units_local > 0) and
                (head_units_local + tail_units_local > Result) then
            begin
                Result := head_units_local + tail_units_local;
            end;
        end;
    end;

    function try_get_short_exact_two_syllable_relaxed_tail_keys_local(
        out out_head_key: string; out out_tail_key: string): Boolean;
    var
        parser_local: TncPinyinParser;
        head_key_local: string;
        tail_key_local: string;
    begin
        Result := False;
        out_head_key := '';
        out_tail_key := '';
        if (expected_units <> 2) or (Pos('''', m_composition_text) > 0) then
        begin
            Exit;
        end;

        parser_local := TncPinyinParser.Create;
        try
            if not try_split_relaxed_missing_apostrophe_token(parser_local,
                normalized_pinyin, head_key_local, tail_key_local) then
            begin
                Exit;
            end;
        finally
            parser_local.Free;
        end;

        head_key_local := normalize_pinyin_text(head_key_local);
        tail_key_local := normalize_pinyin_text(tail_key_local);
        if (head_key_local = '') or (tail_key_local = '') or
            (not is_relaxed_no_initial_syllable_text(tail_key_local)) then
        begin
            Exit;
        end;

        out_head_key := head_key_local;
        out_tail_key := tail_key_local;
        Result := True;
    end;

    procedure ensure_short_exact_two_syllable_relaxed_head_partials_local;
    var
        head_key_local: string;
        tail_key_local: string;
        relaxed_syllables_local: TncPinyinParseResult;
    begin
        if try_get_short_exact_two_syllable_relaxed_tail_keys_local(
            head_key_local, tail_key_local) then
        begin
            relaxed_syllables_local :=
                parse_pinyin_with_relaxed_missing_apostrophe(normalized_pinyin);
            if Length(relaxed_syllables_local) = expected_units then
            begin
                syllables := relaxed_syllables_local;
            end;
            ensure_display_head_single_partials_for_keys(head_key_local,
                tail_key_local);
        end;
    end;

    procedure demote_weak_user_single_chain_below_strong_partial;
    const
        c_low_evidence_user_weight = 8;
    var
        top_candidate_local: TncCandidate;
        best_idx_local: Integer;
        best_score_local: Integer;
        idx_local: Integer;
        picked_candidate_local: TncCandidate;
        candidate_units_local: Integer;
        comment_units_local: Integer;

        function is_low_evidence_user_single_chain_local(
            const candidate_value: TncCandidate): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            unit_key_local: string;
        begin
            Result := False;
            if (expected_units < 3) or (m_dictionary = nil) or
                (candidate_value.source <> cs_user) or
                (Trim(candidate_value.comment) <> '') or
                (Trim(candidate_value.text) = '') then
            begin
                Exit;
            end;
            if candidate_value.has_dict_weight and
                (candidate_value.dict_weight > c_low_evidence_user_weight) then
            begin
                Exit;
            end;
            if (m_dictionary <> nil) and
                m_dictionary.is_user_entry(normalized_pinyin,
                Trim(candidate_value.text)) then
            begin
                Exit;
            end;

            text_units_local := split_text_units(Trim(candidate_value.text));
            if Length(text_units_local) <> expected_units then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(text_units_local) do
            begin
                if get_candidate_text_unit_count(text_units_local[unit_idx_local]) <> 1 then
                begin
                    Exit;
                end;
                unit_key_local := build_display_query_key(unit_idx_local, 1);
                if (unit_key_local = '') or
                    (not m_dictionary.single_char_matches_pinyin(unit_key_local,
                    Trim(text_units_local[unit_idx_local]))) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function is_strong_prefix_partial_local(
            const candidate_value: TncCandidate): Boolean;
        begin
            Result := False;
            if (Trim(candidate_value.comment) = '') or
                (not candidate_value.has_dict_weight) then
            begin
                Exit;
            end;
            candidate_units_local := get_candidate_text_unit_count(
                Trim(candidate_value.text));
            if candidate_units_local < 2 then
            begin
                Exit;
            end;
            comment_units_local := get_effective_compact_pinyin_unit_count(
                normalize_pinyin_text(Trim(candidate_value.comment)));
            Result := (comment_units_local > 0) and
                (candidate_units_local + comment_units_local = expected_units);
        end;
    begin
        if Length(m_candidates) <= 1 then
        begin
            Exit;
        end;

        top_candidate_local := m_candidates[0];
        if not is_low_evidence_user_single_chain_local(top_candidate_local) then
        begin
            Exit;
        end;

        best_idx_local := -1;
        best_score_local := top_candidate_local.score;
        for idx_local := 1 to High(m_candidates) do
        begin
            if is_strong_prefix_partial_local(m_candidates[idx_local]) and
                (m_candidates[idx_local].score > best_score_local) then
            begin
                best_idx_local := idx_local;
                best_score_local := m_candidates[idx_local].score;
            end;
        end;

        if best_idx_local <= 0 then
        begin
            Exit;
        end;

        picked_candidate_local := m_candidates[best_idx_local];
        for idx_local := best_idx_local downto 1 do
        begin
            m_candidates[idx_local] := m_candidates[idx_local - 1];
        end;
        m_candidates[0] := picked_candidate_local;
    end;

