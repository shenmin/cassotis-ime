        text_local: string;
    begin
        Result := False;
        FillChar(out_candidate, SizeOf(out_candidate), 0);
        best_idx_local := -1;
        best_score_local := Low(Integer);
        for idx_local := 0 to High(source_candidates) do
        begin
            if Trim(source_candidates[idx_local].comment) <> '' then
            begin
                Continue;
            end;

            text_local := Trim(source_candidates[idx_local].text);
            if (text_local = '') or
                (not predictive_prefix_units_allowed_for_lookup_local(
                get_candidate_text_unit_count(text_local))) then
            begin
                Continue;
            end;

            score_local := source_candidates[idx_local].score;
            if source_candidates[idx_local].has_dict_weight and
                (source_candidates[idx_local].dict_weight > score_local) then
            begin
                score_local := source_candidates[idx_local].dict_weight;
            end;
            if (best_idx_local < 0) or (score_local > best_score_local) then
            begin
                best_idx_local := idx_local;
                best_score_local := score_local;
            end;
        end;

        if best_idx_local < 0 then
        begin
            Exit;
        end;

        out_candidate := source_candidates[best_idx_local];
        out_candidate.comment := '';
        Result := True;
    end;

    function build_single_incomplete_prefix_lookup_candidates_local(
        out out_candidates: TncCandidateList): Boolean;
    var
        prefix_candidates_local: TncCandidateList;
        idx_local: Integer;
        out_idx_local: Integer;
        query_local: string;
    begin
        Result := False;
        SetLength(out_candidates, 0);
        query_local := normalize_pinyin_text(lookup_text);
        if (m_dictionary = nil) or has_explicit_apostrophe_input or
            (input_syllable_count <> 1) or (Length(query_local) < 2) or
            is_full_pinyin_key(query_local) then
        begin
            Exit;
        end;

        if not m_dictionary.lookup_full_pinyin_prefix(query_local,
            prefix_candidates_local) then
        begin
            Exit;
        end;

        SetLength(out_candidates, Length(prefix_candidates_local));
        out_idx_local := 0;
        for idx_local := 0 to High(prefix_candidates_local) do
        begin
            if (Trim(prefix_candidates_local[idx_local].text) = '') or
                (Trim(prefix_candidates_local[idx_local].comment) <> '') then
            begin
                Continue;
            end;

            out_candidates[out_idx_local] := prefix_candidates_local[idx_local];
            out_candidates[out_idx_local].comment := '';
            Inc(out_idx_local);
        end;

        SetLength(out_candidates, out_idx_local);
        Result := out_idx_local > 0;
    end;

    procedure ensure_strict_oracle_sentence_candidates_prepared;
    const
        c_strict_oracle_max_syllables = 24;
    var
        debug_idx: Integer;
        debug_text: string;
    begin
        if strict_oracle_sentence_built then
        begin
            Exit;
        end;

        strict_oracle_sentence_built := True;
        strict_oracle_sentence_ok := False;
        SetLength(strict_oracle_sentence_candidates, 0);
        if (not has_multi_syllable_input) or
            (input_syllable_count < 10) or
            (input_syllable_count > c_strict_oracle_max_syllables) or
            (not is_full_pinyin_key(lookup_text)) or
            all_initial_compact_query or
            has_internal_dangling_initial or
            has_explicit_apostrophe_input then
        begin
            Exit;
        end;

        Inc(m_disable_subspan_standalone_oracle);
        try
            strict_oracle_sentence_ok :=
                build_strict_chunk_oracle_sentence_candidates(lookup_text,
                strict_oracle_sentence_candidates);
        finally
            Dec(m_disable_subspan_standalone_oracle);
        end;
        if m_config.debug_mode and strict_oracle_sentence_ok then
        begin
            debug_text := '';
            for debug_idx := 0 to Min(2, High(strict_oracle_sentence_candidates)) do
            begin
                debug_text := debug_text + Format(' {%d:%s}',
                    [debug_idx + 1,
                    Trim(strict_oracle_sentence_candidates[debug_idx].text)]);
            end;
            if debug_text <> '' then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' oracle=' + debug_text;
            end;
        end;
    end;

    function explicit_apostrophe_exact_text_matches_local(
        const text_value: string): Boolean;
    var
        idx_local: Integer;
    begin
        Result := False;
        if (not has_explicit_apostrophe_input) or
            (explicit_apostrophe_lookup_text = '') or (m_dictionary = nil) then
        begin
            Exit;
        end;

        if not explicit_apostrophe_exact_candidates_loaded then
        begin
            explicit_apostrophe_exact_candidates_loaded := True;
            if not m_dictionary.lookup(explicit_apostrophe_lookup_text,
                explicit_apostrophe_exact_candidates) then
            begin
                SetLength(explicit_apostrophe_exact_candidates, 0);
            end;
        end;

        for idx_local := 0 to High(explicit_apostrophe_exact_candidates) do
        begin
            if (Trim(explicit_apostrophe_exact_candidates[idx_local].comment) = '') and
                SameText(Trim(explicit_apostrophe_exact_candidates[idx_local].text),
                Trim(text_value)) then
            begin
                Exit(True);
            end;
        end;
    end;

    function explicit_apostrophe_complete_text_matches_boundary_local(
        const text_value: string): Boolean;
    var
        parser_local: TncPinyinParser;
        parts_local: TncPinyinParseResult;
        units_local: TArray<string>;
        idx_local: Integer;
    begin
        Result := False;
        if (not has_explicit_apostrophe_input) or (input_syllable_count <= 1) or
            (m_dictionary = nil) then
        begin
            Exit;
        end;

        { A strict explicit-boundary dictionary hit is authoritative even when
          a character has a lexical reading that does not exist in isolation,
          such as lu'an / 六安.  Constructed candidates still pass through
          the per-character alignment checks below. }
        if explicit_apostrophe_exact_text_matches_local(text_value) then
        begin
            Exit(True);
        end;

        units_local := split_text_units(Trim(text_value));
        if Length(units_local) <> input_syllable_count then
        begin
            Exit;
        end;

        parser_local := TncPinyinParser.Create;
        try
            parts_local := parser_local.parse(m_composition_text);
        finally
            parser_local.Free;
        end;

        if Length(parts_local) <> input_syllable_count then
        begin
            Exit;
        end;

        for idx_local := 0 to input_syllable_count - 1 do
        begin
            if not m_dictionary.single_char_matches_pinyin(
                normalize_pinyin_text(Trim(parts_local[idx_local].text)),
                units_local[idx_local]) then
            begin
                Exit;
            end;
        end;

        Result := True;
    end;

    procedure ensure_explicit_apostrophe_aligned_complete_visible_local(
        var candidates: TncCandidateList);
    var
        lookup_results_local: TncCandidateList;
        result_idx_local: Integer;
        existing_idx_local: Integer;
        idx_local: Integer;
        picked_local: TncCandidate;

        procedure consider_candidates_local(const source_candidates: TncCandidateList);
        var
            local_idx: Integer;
            local_text: string;
        begin
            for local_idx := 0 to High(source_candidates) do
            begin
                if Trim(source_candidates[local_idx].comment) <> '' then
                begin
                    Continue;
                end;

                local_text := Trim(source_candidates[local_idx].text);
                if (local_text = '') or
                    (not explicit_apostrophe_complete_text_matches_boundary_local(
                    local_text)) then
                begin
                    Continue;
                end;

                result_idx_local := local_idx;
                picked_local := source_candidates[local_idx];
                Exit;
            end;
        end;
    begin
        if (not has_explicit_apostrophe_input) or (input_syllable_count <= 1) or
            (m_dictionary = nil) then
        begin
            Exit;
        end;

        result_idx_local := -1;
        FillChar(picked_local, SizeOf(picked_local), 0);
        if (explicit_apostrophe_lookup_text <> '') and
            m_dictionary.lookup(explicit_apostrophe_lookup_text,
            lookup_results_local) then
        begin
            consider_candidates_local(lookup_results_local);
        end;
        if (result_idx_local < 0) and
            (explicit_apostrophe_lookup_text <> '') and
            m_dictionary.lookup_exact_full_pinyin(explicit_apostrophe_lookup_text,
            lookup_results_local) then
        begin
            consider_candidates_local(lookup_results_local);
        end;
        if (result_idx_local < 0) and
            m_dictionary.lookup(lookup_text, lookup_results_local) then
        begin
            consider_candidates_local(lookup_results_local);
        end;
        if (result_idx_local < 0) and
            m_dictionary.lookup_exact_full_pinyin(lookup_text, lookup_results_local) then
        begin
            consider_candidates_local(lookup_results_local);
        end;
        if result_idx_local < 0 then
        begin
            Exit;
        end;

        picked_local.comment := '';
        if picked_local.score < 2048 then
        begin
            picked_local.score := picked_local.score + 4096;
        end;

        existing_idx_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                SameText(Trim(candidates[idx_local].text),
                Trim(picked_local.text)) then
            begin
                existing_idx_local := idx_local;
                Break;
            end;
        end;

        if existing_idx_local = 0 then
        begin
            if candidates[0].score < picked_local.score then
            begin
                candidates[0].score := picked_local.score;
            end;
            Exit;
        end;

        if existing_idx_local > 0 then
        begin
            picked_local := candidates[existing_idx_local];
            for idx_local := existing_idx_local downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := picked_local;
            Exit;
        end;

        SetLength(candidates, Length(candidates) + 1);
        for idx_local := High(candidates) downto 1 do
        begin
            candidates[idx_local] := candidates[idx_local - 1];
        end;
        candidates[0] := picked_local;
    end;

    procedure filter_explicit_apostrophe_output_complete_local(
        var candidates: TncCandidateList);
    var
        idx_local: Integer;
        out_idx_local: Integer;
        parts_local: TncPinyinParseResult;
        parts_parsed_local: Boolean;
        function ensure_parts_local: Boolean;
        var
            parser_local: TncPinyinParser;
        begin
            if not parts_parsed_local then
            begin
                parts_parsed_local := True;
                parser_local := TncPinyinParser.Create;
                try
                    parts_local := parser_local.parse(m_composition_text);
                finally
                    parser_local.Free;
                end;
            end;
            Result := Length(parts_local) = input_syllable_count;
        end;

        function contains_non_ascii_text_local(const value: string): Boolean;
        var
            ch: Char;
        begin
            Result := False;
            for ch in value do
            begin
                if Ord(ch) > $7F then
                begin
                    Exit(True);
                end;
            end;
        end;

        function partial_candidate_matches_boundary_local(
            const candidate: TncCandidate): Boolean;
        var
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            expected_tail_local: string;
            is_preferred_local: Boolean;
        begin
            Result := False;
            if Trim(candidate.comment) = '' then
            begin
                Exit;
            end;

            text_units_local := split_text_units(Trim(candidate.text));
            if (Length(text_units_local) <= 0) or
                (Length(text_units_local) >= input_syllable_count) then
            begin
                Exit;
            end;

            if not ensure_parts_local then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(text_units_local) do
            begin
                if not match_single_char_candidate_for_syllable(
                    Trim(parts_local[unit_idx_local].text),
                    text_units_local[unit_idx_local],
                    is_preferred_local) then
                begin
                    Exit;
                end;
            end;

            expected_tail_local := '';
            for unit_idx_local := Length(text_units_local) to input_syllable_count - 1 do
            begin
                expected_tail_local := expected_tail_local +
                    normalize_pinyin_text(parts_local[unit_idx_local].text);
            end;

            Result := (expected_tail_local <> '') and
                SameText(normalize_pinyin_text(Trim(candidate.comment)),
                expected_tail_local);
        end;
    begin
        if (not has_explicit_apostrophe_input) or (input_syllable_count <= 1) then
        begin
            Exit;
        end;

        parts_parsed_local := False;
        SetLength(parts_local, 0);
        out_idx_local := 0;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                (get_candidate_text_unit_count(Trim(candidates[idx_local].text)) =
                input_syllable_count) and
                (not explicit_apostrophe_complete_text_matches_boundary_local(
                candidates[idx_local].text)) then
            begin
                Continue;
            end;

            if (Trim(candidates[idx_local].comment) <> '') and
                contains_non_ascii_text_local(Trim(candidates[idx_local].text)) and
                (not partial_candidate_matches_boundary_local(candidates[idx_local])) then
            begin
                Continue;
            end;

            if out_idx_local <> idx_local then
            begin
                candidates[out_idx_local] := candidates[idx_local];
            end;
            Inc(out_idx_local);
        end;
        SetLength(candidates, out_idx_local);
    end;

    procedure dedupe_visible_candidates_local(var candidates: TncCandidateList;
        out out_removed_count: Integer);
    var
        seen_local: TDictionary<string, Integer>;
        list_local: TList<TncCandidate>;
        idx_local: Integer;
        existing_idx_local: Integer;
        key_local: string;
        candidate_local: TncCandidate;
        existing_local: TncCandidate;

        procedure merge_duplicate_local(var target: TncCandidate;
            const duplicate: TncCandidate);
        begin
            if duplicate.score > target.score then
            begin
                target.score := duplicate.score;
            end;

            if duplicate.has_dict_weight and
                ((not target.has_dict_weight) or
                (duplicate.dict_weight > target.dict_weight)) then
            begin
                target.has_dict_weight := True;
                target.dict_weight := duplicate.dict_weight;
            end;

            if get_source_rank(duplicate.source) < get_source_rank(target.source) then
            begin
                target.source := duplicate.source;
            end;
        end;
    begin
        out_removed_count := 0;
        if Length(candidates) <= 1 then
        begin
            Exit;
        end;

        seen_local := TDictionary<string, Integer>.Create;
        list_local := TList<TncCandidate>.Create;
        try
            for idx_local := 0 to High(candidates) do
            begin
                key_local := build_candidate_identity_key(candidates[idx_local].text,
                    candidates[idx_local].comment);
                if key_local = '' then
                begin
                    list_local.Add(candidates[idx_local]);
                    Continue;
                end;

                if seen_local.TryGetValue(key_local, existing_idx_local) then
                begin
                    if (existing_idx_local >= 0) and
                        (existing_idx_local < list_local.Count) then
                    begin
                        existing_local := list_local[existing_idx_local];
                        merge_duplicate_local(existing_local, candidates[idx_local]);
                        list_local[existing_idx_local] := existing_local;
                    end;
                    Inc(out_removed_count);
                    Continue;
                end;

                candidate_local := candidates[idx_local];
                list_local.Add(candidate_local);
                seen_local.Add(key_local, list_local.Count - 1);
            end;

            if out_removed_count <= 0 then
            begin
                Exit;
            end;

            SetLength(candidates, list_local.Count);
            for idx_local := 0 to list_local.Count - 1 do
            begin
                candidates[idx_local] := list_local[idx_local];
            end;
        finally
            list_local.Free;
            seen_local.Free;
        end;
    end;

    procedure filter_user_completes_misaligned_with_relaxed_no_initial_tail_local(
        var candidates: TncCandidateList; var removed_count: Integer);
    var
        relaxed_parts_local: TncPinyinParseResult;
        relaxed_head_key_local: string;
        relaxed_tail_key_local: string;
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_units_local: TArray<string>;

        function load_relaxed_parts_local: Boolean;
        begin
            relaxed_parts_local := parse_pinyin_with_relaxed_missing_apostrophe(
                m_composition_text);
            if Length(relaxed_parts_local) <> 2 then
            begin
                relaxed_parts_local := parse_pinyin_with_relaxed_missing_apostrophe(
                    lookup_text);
            end;
            Result := Length(relaxed_parts_local) = 2;
        end;

        function has_aligned_relaxed_boundary_partial_local: Boolean;
        var
            candidate_idx_local: Integer;
            partial_units_local: TArray<string>;
        begin
            Result := False;
            for candidate_idx_local := 0 to High(candidates) do
            begin
                if not SameText(normalize_pinyin_text(
                    Trim(candidates[candidate_idx_local].comment)),
                    relaxed_tail_key_local) then
                begin
                    Continue;
                end;

                partial_units_local := split_text_units(
                    Trim(candidates[candidate_idx_local].text));
                if (Length(partial_units_local) = 1) and
                    m_dictionary.single_char_matches_pinyin(
                    relaxed_head_key_local, partial_units_local[0]) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function complete_units_match_relaxed_boundary_local(
            const units_value: TArray<string>): Boolean;
        begin
            Result := (Length(units_value) = 2) and
                m_dictionary.single_char_matches_pinyin(relaxed_head_key_local,
                units_value[0]) and
                m_dictionary.single_char_matches_pinyin(relaxed_tail_key_local,
                units_value[1]);
        end;

        function has_non_user_full_query_exact_support_local(
            const text_value: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            text_key_local: string;
        begin
            Result := False;
            text_key_local := Trim(text_value);
            if (text_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_idx_local].text),
                    text_key_local) and
                    (exact_results_local[exact_idx_local].source <> cs_user) then
                begin
                    Exit(True);
                end;
            end;
        end;
    begin
        if (m_dictionary = nil) or (input_syllable_count <> 2) or
            (Length(candidates) <= 1) or (not load_relaxed_parts_local) then
        begin
            Exit;
        end;

        relaxed_head_key_local := normalize_pinyin_text(
            relaxed_parts_local[0].text);
        relaxed_tail_key_local := normalize_pinyin_text(
            relaxed_parts_local[1].text);
        if (relaxed_head_key_local = '') or (relaxed_tail_key_local = '') or
            (not is_relaxed_no_initial_syllable_text(relaxed_tail_key_local)) or
            (not has_aligned_relaxed_boundary_partial_local) then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(candidates) do
        begin
            if (candidates[in_idx_local].source = cs_user) and
                (Trim(candidates[in_idx_local].comment) = '') then
            begin
                candidate_units_local := split_text_units(
                    Trim(candidates[in_idx_local].text));
                if (Length(candidate_units_local) = 2) and
                    (not complete_units_match_relaxed_boundary_local(
                    candidate_units_local)) and
                    (not has_non_user_full_query_exact_support_local(
                    candidates[in_idx_local].text)) then
                begin
                    Inc(removed_count);
                    Continue;
                end;
            end;

            if out_idx_local <> in_idx_local then
            begin
                candidates[out_idx_local] := candidates[in_idx_local];
            end;
            Inc(out_idx_local);
        end;
        SetLength(candidates, out_idx_local);
    end;

    function debug_target_candidate_present_local(
        const candidates: TncCandidateList): Boolean;
    var
        debug_idx_local: Integer;
    begin
        Result := False;
        if m_debug_target_recall_text = '' then
        begin
            Exit;
        end;
        for debug_idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[debug_idx_local].comment) = '') and
                SameText(Trim(candidates[debug_idx_local].text),
                m_debug_target_recall_text) then
            begin
                Exit(True);
            end;
        end;
    end;

    procedure mark_debug_target_candidate_stage_local(const stage_bit: Integer;
        const candidates: TncCandidateList);
    begin
        if debug_target_candidate_present_local(candidates) then
        begin
            m_debug_target_candidate_stage_mask :=
                m_debug_target_candidate_stage_mask or stage_bit;
        end;
    end;

    procedure finalize_candidates_and_prepare_exit(const debug_extra: string);
    var
        filtered_constructed_count_local: Integer;
        filtered_misaligned_complete_count_local: Integer;
        deduped_candidate_count_local: Integer;
        best_complete_exact_text_local: string;
        strong_tail_completion_text_local: string;
        strong_tail_completion_score_local: Integer;

        function get_exact_query_user_choice_priority_local(
            const candidate_text: string): Integer;
        var
            normalized_query_local: string;
            latest_text_local: string;
            choice_bonus_local: Integer;
            text_key_local: string;
        begin
            Result := 0;
            text_key_local := Trim(candidate_text);
            if (text_key_local = '') or (m_dictionary = nil) then
            begin
                Exit;
            end;

            normalized_query_local := normalize_pinyin_text(lookup_text);
            if normalized_query_local = '' then
            begin
                Exit;
            end;

            if is_latest_session_query_choice(text_key_local) then
            begin
                Inc(Result, 200000);
            end;

            latest_text_local := get_cached_query_latest_choice_text(
                normalized_query_local);
            if (latest_text_local <> '') and SameText(text_key_local,
                latest_text_local) then
            begin
                Inc(Result, 200000);
            end;

            choice_bonus_local := m_dictionary.get_query_choice_bonus(
                normalized_query_local, text_key_local);
            if choice_bonus_local > 0 then
            begin
                Inc(Result, 50000 + (choice_bonus_local * 20));
            end;
        end;

        function is_protected_user_choice_candidate_local(
            const candidate: TncCandidate): Boolean;
        begin
            Result := (candidate.source = cs_user) and
                (Trim(candidate.comment) = '') and
                (get_exact_query_user_choice_priority_local(candidate.text) > 0);
        end;

        function is_complete_single_char_chain_text_local(
            const text_value: string): Boolean;
        var
            syllables_local: TncPinyinParseResult;
            units_local: TArray<string>;
            unit_idx_local: Integer;
            is_preferred_local: Boolean;
        begin
            Result := False;
            syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
            units_local := split_text_units(Trim(text_value));
            if (Length(syllables_local) <> input_syllable_count) or
                (Length(units_local) <> input_syllable_count) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(units_local) do
            begin
                if (get_candidate_text_unit_count(units_local[unit_idx_local]) <> 1) or
                    (not match_single_char_candidate_for_syllable(
                    syllables_local[unit_idx_local].text,
                    units_local[unit_idx_local], is_preferred_local)) then
                begin
                    Exit;
                end;
            end;

            Result := True;
        end;

        function has_complete_exact_phrase_support_local(
            const text_value: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            text_key_local: string;
        begin
            Result := False;
            text_key_local := Trim(text_value);
            if (text_key_local = '') or (m_dictionary = nil) or
                (lookup_text = '') or (input_syllable_count < 2) or
                (not is_full_pinyin_key(lookup_text)) or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                    SameText(Trim(exact_results_local[exact_idx_local].text),
                    text_key_local) and
                    (get_candidate_text_unit_count(Trim(
                    exact_results_local[exact_idx_local].text)) =
                    input_syllable_count) then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_reliable_complete_support_text_local(
            const text_value: string; out out_support_score_local: Integer): Boolean;
        var
            support_segments_local: Integer;
            support_path_local: string;
            text_key_local: string;

            function has_lexicon_longer_prefix_support_local: Boolean;
            var
                prefix_results_local: TncCandidateList;
                prefix_idx_local: Integer;
                text_units_local: TArray<string>;
                prefix_text_local: string;
                unit_idx_local: Integer;
            begin
                Result := False;
                if (m_dictionary = nil) or (lookup_text = '') then
                begin
                    Exit;
                end;

                if not m_dictionary.lookup_full_pinyin_prefix(lookup_text,
                    prefix_results_local) then
                begin
                    Exit;
                end;

                for prefix_idx_local := 0 to High(prefix_results_local) do
                begin
                    if Trim(prefix_results_local[prefix_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    text_units_local := split_text_units(
                        Trim(prefix_results_local[prefix_idx_local].text));
                    if Length(text_units_local) <= input_syllable_count then
                    begin
                        Continue;
                    end;

                    prefix_text_local := '';
                    for unit_idx_local := 0 to input_syllable_count - 1 do
                    begin
                        prefix_text_local := prefix_text_local +
                            text_units_local[unit_idx_local];
                    end;

                    if SameText(prefix_text_local, text_key_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := False;
            out_support_score_local := Low(Integer);
            text_key_local := Trim(text_value);
            if (text_key_local = '') or (input_syllable_count < 2) or
                (get_candidate_text_unit_count(text_key_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if has_lexicon_longer_prefix_support_local then
            begin
                out_support_score_local := 4096;
                Exit(True);
            end;

            support_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, text_key_local, out_support_score_local,
                support_segments_local);
            if (support_path_local = '') or (out_support_score_local < 4096) then
            begin
                Exit;
            end;
            Result := True;
        end;

        function get_complete_exact_query_weight_for_text_local(
            const text_value: string): Integer;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
            exact_weight_local: Integer;
        begin
            Result := -1;
            if (m_dictionary = nil) or (Trim(text_value) = '') or
                (lookup_text = '') or (not is_full_pinyin_key(lookup_text)) or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (exact_text_local = '') or
                    (not SameText(exact_text_local, Trim(text_value))) then
                begin
                    Continue;
                end;

                exact_weight_local := exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight >
                    exact_weight_local) then
                begin
                    exact_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end;

                if exact_weight_local > Result then
                begin
                    Result := exact_weight_local;
                end;
            end;
        end;

        function is_complete_single_char_chain_candidate_local(
            const candidate: TncCandidate): Boolean;
        var
            candidate_weight_local: Integer;
        begin
            Result := False;
            if (candidate.comment <> '') or (input_syllable_count < 2) or
                (get_candidate_text_unit_count(candidate.text) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if has_complete_exact_phrase_support_local(candidate.text) then
            begin
                Exit(False);
            end;

            candidate_weight_local := 0;
            if candidate.has_dict_weight then
            begin
                candidate_weight_local := candidate.dict_weight;
            end;
            if (candidate.source = cs_rule) and candidate.has_dict_weight and
                (candidate_weight_local >= 2500) then
            begin
                Exit(False);
            end;

            Result := is_complete_single_char_chain_text_local(candidate.text);
        end;

        function try_get_best_complete_exact_phrase_candidate_local(
            out out_candidate: TncCandidate; out out_text: string): Boolean;
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
            exact_weight_local: Integer;
            exact_support_score_local: Integer;
            exact_support_segments_local: Integer;
            exact_support_path_local: string;
            exact_choice_priority_local: Integer;
            best_idx_local: Integer;
            best_weight_local: Integer;
            function build_chunk_text_local(const units_local: TArray<string>;
                const start_idx_local: Integer; const unit_count_local: Integer): string;
            var
                unit_idx_local: Integer;
            begin
                Result := '';
                if (unit_count_local <= 0) or (start_idx_local < 0) or
                    (start_idx_local + unit_count_local - 1 > High(units_local)) then
                begin
                    Exit;
                end;

                for unit_idx_local := start_idx_local to
                    start_idx_local + unit_count_local - 1 do
                begin
                    Result := Result + units_local[unit_idx_local];
                end;
            end;

            function get_fixed_head_match_bonus_local(
                const text_value_local: string): Integer;
            begin
                Result := 0;
            end;

            function get_exact_subspan_alignment_bonus_local(
                const text_value_local: string): Integer;
            var
                units_local: TArray<string>;
                syllables_local: TncPinyinParseResult;
                start_idx_local: Integer;
                span_units_local: Integer;
                query_idx_local: Integer;
                query_key_local: string;
                chunk_text_local: string;
                subspan_results_local: TncCandidateList;
                result_idx_local: Integer;
                best_subspan_text_local: string;
                best_subspan_weight_local: Integer;
                candidate_weight_local: Integer;
            begin
                Result := 0;
                units_local := split_text_units(Trim(text_value_local));
                syllables_local := get_effective_compact_pinyin_syllables(
                    lookup_text);
                if (Length(units_local) <> input_syllable_count) or
                    (Length(syllables_local) <> input_syllable_count) or
                    (m_dictionary = nil) then
                begin
                    Exit;
                end;

                for start_idx_local := 0 to input_syllable_count - 1 do
                begin
                    for span_units_local := 2 to Min(5,
                        input_syllable_count - start_idx_local) do
                    begin
                        query_key_local := '';
                        for query_idx_local := start_idx_local to
                            start_idx_local + span_units_local - 1 do
                        begin
                            query_key_local := query_key_local +
                                normalize_pinyin_text(
                                syllables_local[query_idx_local].text);
                        end;
                        if (query_key_local = '') or
                            (not m_dictionary.lookup_exact_full_pinyin(
                            query_key_local, subspan_results_local)) then
                        begin
                            Continue;
                        end;

                        best_subspan_text_local := '';
                        best_subspan_weight_local := Low(Integer);
                        for result_idx_local := 0 to Min(5,
                            High(subspan_results_local)) do
                        begin
                            if Trim(subspan_results_local[result_idx_local].comment) <> '' then
                            begin
                                Continue;
                            end;
                            if get_candidate_text_unit_count(
                                Trim(subspan_results_local[result_idx_local].text)) <>
                                span_units_local then
                            begin
                                Continue;
                            end;

                            if subspan_results_local[result_idx_local].has_dict_weight then
                            begin
                                candidate_weight_local :=
                                    subspan_results_local[result_idx_local].dict_weight;
                            end
                            else
                            begin
                                candidate_weight_local :=
                                    subspan_results_local[result_idx_local].score;
                            end;
                            if candidate_weight_local > best_subspan_weight_local then
                            begin
                                best_subspan_weight_local := candidate_weight_local;
                                best_subspan_text_local := Trim(
                                    subspan_results_local[result_idx_local].text);
                            end;
                        end;
                        if best_subspan_text_local = '' then
                        begin
                            Continue;
                        end;

                        chunk_text_local := build_chunk_text_local(units_local,
                            start_idx_local, span_units_local);
                        if chunk_text_local = '' then
                        begin
                            Continue;
                        end;

                        if SameText(chunk_text_local, best_subspan_text_local) then
                        begin
                            case span_units_local of
                                2:
                                    Inc(Result, 1200);
                                3:
                                    Inc(Result, 4800);
                                4:
                                    Inc(Result, 12000);
                            else
                                Inc(Result, 18000);
                            end;
                        end
                        else if (span_units_local >= 4) or
                            (best_subspan_weight_local >= 12000) then
                        begin
                            case span_units_local of
                                2:
                                    Dec(Result, 1600);
                                3:
                                    Dec(Result, 6400);
                                4:
                                    Dec(Result, 18000);
                            else
                                Dec(Result, 24000);
                            end;
                        end;
                    end;
                end;
            end;
        begin
            Result := False;
            out_text := '';
            best_idx_local := -1;
            best_weight_local := Low(Integer);
            if (m_dictionary = nil) or (lookup_text = '') or
                (input_syllable_count < 2) or
                (not is_full_pinyin_key(lookup_text)) or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                begin
                    Continue;
                end;

                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (exact_text_local = '') or
                    (get_candidate_text_unit_count(exact_text_local) <>
                    input_syllable_count) then
                begin
                    Continue;
                end;

                if not (exact_results_local[exact_idx_local].has_dict_weight or
                    (exact_results_local[exact_idx_local].source = cs_user)) then
                begin
                    Continue;
                end;

                if (m_dictionary.get_candidate_penalty(lookup_text,
                    exact_text_local) > 0) and
                    ((exact_results_local[exact_idx_local].source = cs_user) or
                    (not m_dictionary.is_base_entry(lookup_text,
                    exact_text_local))) then
                begin
                    Continue;
                end;

                if exact_results_local[exact_idx_local].has_dict_weight then
                begin
                    exact_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end
                else
                begin
                    exact_weight_local :=
                        exact_results_local[exact_idx_local].score;
                end;
                if (strong_tail_completion_text_local <> '') and
                    (not SameText(exact_text_local,
                    strong_tail_completion_text_local)) and
                    (exact_weight_local <= 300) then
                begin
                    Continue;
                end;
                exact_support_path_local :=
                    infer_segment_path_for_query_text_with_score(
                    lookup_text, exact_text_local, exact_support_score_local,
                    exact_support_segments_local);
                if (exact_support_path_local <> '') and
                    (exact_support_score_local > 0) then
                begin
                    Inc(exact_weight_local, exact_support_score_local);
                    if exact_support_segments_local >= 3 then
                    begin
                        Inc(exact_weight_local, 12000);
                    end;
                end;
                exact_choice_priority_local :=
                    get_exact_query_user_choice_priority_local(exact_text_local);
                if (exact_choice_priority_local > 0) or
                    (not ((exact_results_local[exact_idx_local].source = cs_user) and
                    (exact_weight_local <= 1) and
                    is_complete_single_char_chain_text_local(exact_text_local))) then
                begin
                    Inc(exact_weight_local, exact_choice_priority_local);
                end;
                Inc(exact_weight_local,
                    get_fixed_head_match_bonus_local(exact_text_local));
                Inc(exact_weight_local,
                    get_exact_subspan_alignment_bonus_local(exact_text_local));

                if (best_idx_local < 0) or
                    (exact_weight_local > best_weight_local) then
                begin
                    best_idx_local := exact_idx_local;
                    best_weight_local := exact_weight_local;
                end;
            end;

            if best_idx_local >= 0 then
            begin
                out_candidate := exact_results_local[best_idx_local];
                out_candidate.comment := '';
                out_text := Trim(out_candidate.text);
                Result := out_text <> '';
            end;
        end;

        procedure ensure_best_complete_exact_phrase_visible_local(
            var candidates: TncCandidateList);
        var
            best_candidate_local: TncCandidate;
            idx_local: Integer;
            move_idx_local: Integer;
            existing_idx_local: Integer;
            best_exact_weight_local: Integer;

            function has_reliable_complete_support_local(
                const candidate_local: TncCandidate;
                out out_support_score_local: Integer): Boolean;
            var
                support_segments_local: Integer;
                support_path_local: string;
                candidate_text_local: string;
            begin
                Result := False;
                out_support_score_local := Low(Integer);
                candidate_text_local := Trim(candidate_local.text);
                if (candidate_text_local = '') or
                    (Trim(candidate_local.comment) <> '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    input_syllable_count) or
                    is_problematic_single_char_chain_candidate_for_query(
                    lookup_text, candidate_local) then
                begin
                    Exit;
                end;

                support_path_local := infer_segment_path_for_query_text_with_score(
                    lookup_text, candidate_text_local, out_support_score_local,
                    support_segments_local);
                if (support_path_local = '') or (out_support_score_local < 4096) then
                begin
                    Exit;
                end;

                Result := True;
            end;

            function get_fixed_head_match_count_local(
                const text_value_local: string): Integer;
            begin
                Result := 0;
            end;

            function is_number_single_text_local(
                const text_value_local: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(text_value_local) <> 1 then
                begin
                    Exit;
                end;

                case Ord(text_value_local[1]) of
                    $4E00, $4E8C, $4E24, $4E09, $56DB, $4E94, $516D,
                    $4E03, $516B, $4E5D, $5341:
                        Result := True;
                end;
            end;

            function is_ordinal_head_text_local(
                const text_value_local: string): Boolean;
            var
                units_local: TArray<string>;
            begin
                units_local := split_text_units(Trim(text_value_local));
                if Length(units_local) <= 0 then
                begin
                    Exit(False);
                end;
                Result := (Length(units_local) >= 2) and
                    SameText(units_local[0], string(Char($7B2C)));
            end;

            function is_quantity_tail_single_text_local(
                const text_value_local: string): Boolean;
            begin
                Result := False;
                if get_candidate_text_unit_count(text_value_local) <> 1 then
                begin
                    Exit;
                end;

                case Ord(text_value_local[1]) of
                    $5B57, $9879, $6761, $4E2A, $70B9, $79CD, $7C7B,
                    $6B21, $6B65, $8F6E, $7AE0, $8282, $9875, $6BB5,
                    $884C, $5217, $5C42:
                        Result := True;
                end;
            end;

            function is_structured_quantity_candidate_local(
                const candidate_local: TncCandidate): Boolean;
            var
                encoded_path_local: string;
                segment_parts_local: TArray<string>;
                inferred_score_local: Integer;
                inferred_segment_count_local: Integer;
                head_text_local: string;
                tail_text_local: string;

                function is_number_quantity_phrase_text_local(
                    const text_value_local: string): Boolean;
                var
                    units_local: TArray<string>;
                begin
                    units_local := split_text_units(Trim(text_value_local));
                    if Length(units_local) <> 2 then
                    begin
                        Exit(False);
                    end;
                    Result := is_number_single_text_local(units_local[0]) and
                        is_quantity_tail_single_text_local(units_local[1]);
                end;
            begin
                Result := False;
                if Trim(candidate_local.comment) <> '' then
                begin
                    Exit;
                end;

                encoded_path_local := get_segment_path_for_candidate(
                    candidate_local);
                if encoded_path_local = '' then
                begin
                    encoded_path_local := infer_segment_path_for_query_text_with_score(
                        lookup_text, Trim(candidate_local.text),
                        inferred_score_local, inferred_segment_count_local);
                end;
                segment_parts_local := encoded_path_local.Split(
                    [c_segment_path_separator]);
                if Length(segment_parts_local) <> 2 then
                begin
                    Exit;
                end;

                head_text_local := Trim(segment_parts_local[0]);
                tail_text_local := Trim(segment_parts_local[1]);
                Result :=
                    (is_quantity_tail_single_text_local(tail_text_local) and
                    (is_number_single_text_local(head_text_local) or
                    is_ordinal_head_text_local(head_text_local))) or
                    (SameText(head_text_local, string(Char($7B2C))) and
                    is_number_quantity_phrase_text_local(tail_text_local));
            end;

            function should_keep_existing_complete_chain_first_local: Boolean;
            var
                current_weight_local: Integer;
                current_support_score_local: Integer;
                best_support_score_local: Integer;
                current_head_match_local: Integer;
                best_head_match_local: Integer;
            begin
                Result := False;
                if (Length(candidates) = 0) or
                    (Trim(candidates[0].comment) <> '') or
                    SameText(Trim(candidates[0].text),
                    best_complete_exact_text_local) or
                    (get_candidate_text_unit_count(Trim(candidates[0].text)) <>
                    input_syllable_count) then
                begin
                    Exit;
                end;

                if best_candidate_local.has_dict_weight then
                begin
                    best_exact_weight_local := best_candidate_local.dict_weight;
                end
                else if (best_candidate_local.source = cs_user) and
                    (not is_latest_session_query_choice(
                    best_complete_exact_text_local)) then
                begin
                    best_exact_weight_local := 0;
                end
                else
                begin
                    best_exact_weight_local := best_candidate_local.score;
                end;
                if ((best_candidate_local.source = cs_user) or
                    best_candidate_local.has_dict_weight) and
                    (candidates[0].source <> cs_user) and
                    (not candidates[0].has_dict_weight) then
                begin
                    Exit(False);
                end;
                if (input_syllable_count <= 3) and
                    (candidates[0].source <> cs_user) and
                    (m_dictionary <> nil) and
                    (not m_dictionary.is_base_entry(lookup_text,
                    Trim(candidates[0].text))) then
                begin
                    if is_structured_quantity_candidate_local(candidates[0]) then
                    begin
                        current_weight_local := candidates[0].score;
                        if candidates[0].has_dict_weight and
                            (candidates[0].dict_weight > current_weight_local) then
                        begin
                            current_weight_local := candidates[0].dict_weight;
                        end;
                        if current_weight_local > best_exact_weight_local then
                        begin
                            Exit(True);
                        end;
                    end;
                    Exit(False);
                end;
                if best_exact_weight_local >= 700 then
                begin
                    current_head_match_local := get_fixed_head_match_count_local(
                        candidates[0].text);
                    best_head_match_local := get_fixed_head_match_count_local(
                        best_complete_exact_text_local);
                    if current_head_match_local > best_head_match_local then
                    begin
                        Exit(True);
                    end;
                    if has_reliable_complete_support_local(candidates[0],
                        current_support_score_local) then
                    begin
                        if (not has_reliable_complete_support_local(
                            best_candidate_local, best_support_score_local)) or
                            (current_support_score_local + 2048 >=
                            best_support_score_local) then
                        begin
                            Exit(True);
                        end;
                    end;
                    Exit;
                end;

                current_weight_local := candidates[0].score;
                if candidates[0].has_dict_weight and
                    (candidates[0].dict_weight > current_weight_local) then
                begin
                    current_weight_local := candidates[0].dict_weight;
                end;
                Result := current_weight_local > best_exact_weight_local;
            end;
        begin
            best_complete_exact_text_local := '';
            if not try_get_best_complete_exact_phrase_candidate_local(
                best_candidate_local, best_complete_exact_text_local) then
            begin
                Exit;
            end;

            if (Length(candidates) > 0) and
                SameText(Trim(candidates[0].text),
                best_complete_exact_text_local) and
                (Trim(candidates[0].comment) = '') then
            begin
                Exit;
            end;

            if should_keep_existing_complete_chain_first_local then
            begin
                Exit;
            end;

            existing_idx_local := -1;
            for idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[idx_local].comment) = '') and
                    SameText(Trim(candidates[idx_local].text),
                    best_complete_exact_text_local) then
                begin
                    existing_idx_local := idx_local;
                    Break;
                end;
            end;

            if existing_idx_local >= 0 then
            begin
                best_candidate_local := candidates[existing_idx_local];
                for move_idx_local := existing_idx_local downto 1 do
                begin
                    candidates[move_idx_local] := candidates[move_idx_local - 1];
                end;
                candidates[0] := best_candidate_local;
                Exit;
            end;

            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := best_candidate_local;
        end;

        procedure ensure_best_tail_exact_completion_visible_local(
            var candidates: TncCandidateList);
        const
            c_tail_probe_limit = 12;
        var
            idx_local: Integer;
            tail_idx_local: Integer;
            existing_idx_local: Integer;
            move_idx_local: Integer;
            prefix_text_local: string;
            tail_key_local: string;
            tail_syllable_count_local: Integer;
            prefix_unit_count_local: Integer;
            tail_results_local: TncCandidateList;
            tail_text_local: string;
            tail_weight_local: Integer;
            best_tail_text_local: string;
            best_tail_weight_local: Integer;
            completion_candidate_local: TncCandidate;
            completion_text_local: string;
            completion_score_local: Integer;

            function has_stronger_complete_exact_phrase_local(
                const completion_text: string): Boolean;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
                exact_weight_local: Integer;
            begin
                Result := False;
                if (m_dictionary = nil) or (Trim(completion_text) = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(lookup_text,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (exact_text_local = '') or
                        SameText(exact_text_local, Trim(completion_text)) or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        input_syllable_count) then
                    begin
                        Continue;
                    end;

                    if exact_results_local[exact_idx_local].has_dict_weight then
                    begin
                        exact_weight_local :=
                            exact_results_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        exact_weight_local := exact_results_local[exact_idx_local].score;
                    end;

                    if exact_weight_local >= 500 then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            strong_tail_completion_text_local := '';
            strong_tail_completion_score_local := 0;
            if (Length(candidates) = 0) or (m_dictionary = nil) or
                (input_syllable_count < 3) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(candidates) do
            begin
                prefix_text_local := Trim(candidates[idx_local].text);
                tail_key_local := normalize_pinyin_text(
                    Trim(candidates[idx_local].comment));
                if (prefix_text_local = '') or (tail_key_local = '') or
                    (not is_full_pinyin_key(tail_key_local)) then
                begin
                    Continue;
                end;

                prefix_unit_count_local :=
                    get_candidate_text_unit_count(prefix_text_local);
                tail_syllable_count_local :=
                    get_effective_compact_pinyin_unit_count(tail_key_local);
                if (prefix_unit_count_local < 2) or
                    (tail_syllable_count_local < 1) or
                    (tail_syllable_count_local > 4) or
                    (prefix_unit_count_local + tail_syllable_count_local <>
                    input_syllable_count) then
                begin
                    Continue;
                end;

                if not lookup_exact_full_pinyin_cached_local(tail_key_local,
                    tail_results_local) then
                begin
                    Continue;
                end;

                best_tail_text_local := '';
                best_tail_weight_local := Low(Integer);
                for tail_idx_local := 0 to High(tail_results_local) do
                begin
                    if tail_idx_local >= c_tail_probe_limit then
                    begin
                        Break;
                    end;
                    if Trim(tail_results_local[tail_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    tail_text_local := Trim(tail_results_local[tail_idx_local].text);
                    if (tail_text_local = '') or
                        (get_candidate_text_unit_count(tail_text_local) <>
                        tail_syllable_count_local) then
                    begin
                        Continue;
                    end;

                    tail_weight_local := tail_results_local[tail_idx_local].score;
                    if tail_results_local[tail_idx_local].has_dict_weight and
                        (tail_results_local[tail_idx_local].dict_weight >
                        tail_weight_local) then
                    begin
                        tail_weight_local :=
                            tail_results_local[tail_idx_local].dict_weight;
                    end;

                    if tail_weight_local > best_tail_weight_local then
                    begin
                        best_tail_weight_local := tail_weight_local;
                        best_tail_text_local := tail_text_local;
                    end;
                end;

                if (best_tail_text_local = '') or
                    (best_tail_weight_local < 260) then
                begin
                    Continue;
                end;

                completion_text_local := prefix_text_local + best_tail_text_local;
                completion_score_local := candidates[idx_local].score +
                    best_tail_weight_local + 50000 +
                    (tail_syllable_count_local * 1200);
                if completion_score_local > strong_tail_completion_score_local then
                begin
                    strong_tail_completion_score_local := completion_score_local;
                    strong_tail_completion_text_local := completion_text_local;
                    FillChar(completion_candidate_local,
                        SizeOf(completion_candidate_local), 0);
                    completion_candidate_local.text := completion_text_local;
                    completion_candidate_local.comment := '';
                    completion_candidate_local.score := completion_score_local;
                    completion_candidate_local.source := cs_rule;
                    completion_candidate_local.has_dict_weight := True;
                    completion_candidate_local.dict_weight :=
                        completion_score_local;
                end;
            end;

            if strong_tail_completion_text_local = '' then
            begin
                Exit;
            end;

            if has_stronger_complete_exact_phrase_local(
                strong_tail_completion_text_local) then
            begin
                strong_tail_completion_text_local := '';
                strong_tail_completion_score_local := 0;
                Exit;
            end;

            existing_idx_local := -1;
            for idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[idx_local].comment) = '') and
                    SameText(Trim(candidates[idx_local].text),
                    strong_tail_completion_text_local) then
                begin
                    existing_idx_local := idx_local;
                    Break;
                end;
            end;

            if existing_idx_local >= 0 then
            begin
                completion_candidate_local := candidates[existing_idx_local];
                completion_candidate_local.score := Max(
                    completion_candidate_local.score,
                    strong_tail_completion_score_local);
                completion_candidate_local.has_dict_weight := True;
                completion_candidate_local.dict_weight := Max(
                    completion_candidate_local.dict_weight,
                    completion_candidate_local.score);
                for move_idx_local := existing_idx_local downto 1 do
                begin
                    candidates[move_idx_local] := candidates[move_idx_local - 1];
                end;
                candidates[0] := completion_candidate_local;
                Exit;
            end;

            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := completion_candidate_local;
        end;

        function try_build_learned_exact_query_choice_candidate_local(
            out out_candidate: TncCandidate): Boolean;
        var
            normalized_query_local: string;
            learned_text_local: string;
            session_text_local: string;
            latest_from_session_local: Boolean;
            latest_from_dictionary_local: Boolean;
            trusted_latest_choice_local: Boolean;
            syllables_local: TncPinyinParseResult;
            units_local: TArray<string>;
            unit_idx_local: Integer;
            is_preferred_local: Boolean;
            choice_priority_local: Integer;
            learned_source_local: TncCandidateSource;
            learned_has_dict_weight_local: Boolean;
            learned_dict_weight_local: Integer;

            function get_exact_weight_for_text_local(
                const target_text: string): Integer;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
                exact_weight_local: Integer;
            begin
                Result := -1;
                if (m_dictionary = nil) or (Trim(target_text) = '') or
                    (not lookup_exact_full_pinyin_cached_local(
                    normalized_query_local, exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (exact_text_local = '') or
                        (not SameText(exact_text_local, Trim(target_text))) then
                    begin
                        Continue;
                    end;

                    if exact_results_local[exact_idx_local].has_dict_weight then
                    begin
                        exact_weight_local :=
                            exact_results_local[exact_idx_local].dict_weight;
                    end
                    else
                    begin
                        exact_weight_local := exact_results_local[exact_idx_local].score;
                    end;

                    if exact_weight_local > Result then
                    begin
                        Result := exact_weight_local;
                    end;
                end;
            end;

            function get_best_competing_exact_weight_local: Integer;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
                exact_weight_local: Integer;
            begin
                Result := -1;
                if (m_dictionary = nil) or
                    (not lookup_exact_full_pinyin_cached_local(
                    normalized_query_local, exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;

                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (exact_text_local = '') or
                        SameText(exact_text_local, learned_text_local) or
                        (get_candidate_text_unit_count(exact_text_local) <>
                        input_syllable_count) then
                    begin
                        Continue;
                    end;

                    exact_weight_local := exact_results_local[exact_idx_local].score;
                    if exact_results_local[exact_idx_local].has_dict_weight and
                        (exact_results_local[exact_idx_local].dict_weight >
                        exact_weight_local) then
                    begin
                        exact_weight_local :=
                            exact_results_local[exact_idx_local].dict_weight;
                    end;

                    if exact_weight_local > Result then
                    begin
                        Result := exact_weight_local;
                    end;
                end;
            end;

            function weak_learned_choice_is_blocked_by_strong_exact_local: Boolean;
            const
                c_strong_exact_protection_min = 260;
                c_strong_exact_protection_gap = 700;
                c_weak_learned_exact_max = 80;
            var
                learned_exact_weight_local: Integer;
                competing_exact_weight_local: Integer;
            begin
                Result := False;
                learned_exact_weight_local :=
                    get_exact_weight_for_text_local(learned_text_local);
                competing_exact_weight_local :=
                    get_best_competing_exact_weight_local;
                if (learned_exact_weight_local >= 0) and
                    (learned_exact_weight_local <= c_weak_learned_exact_max) and
                    (competing_exact_weight_local >= c_strong_exact_protection_min) and
                    (competing_exact_weight_local >= learned_exact_weight_local +
                    c_strong_exact_protection_gap) then
                begin
                    Result := True;
                end;
            end;

        begin
            Result := False;
            FillChar(out_candidate, SizeOf(out_candidate), 0);

            if (lookup_text = '') or (input_syllable_count < 2) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            normalized_query_local := normalize_pinyin_text(lookup_text);
            learned_text_local := '';
            latest_from_session_local := False;
            latest_from_dictionary_local := False;
            if (m_session_query_latest_text <> nil) and
                m_session_query_latest_text.TryGetValue(normalized_query_local,
                session_text_local) then
            begin
                learned_text_local := Trim(session_text_local);
                latest_from_session_local := learned_text_local <> '';
            end;
            if (learned_text_local = '') and (m_dictionary <> nil) then
            begin
                learned_text_local := get_cached_query_latest_choice_text(
                    normalized_query_local);
                latest_from_dictionary_local := learned_text_local <> '';
            end;
            trusted_latest_choice_local := latest_from_session_local or
                latest_from_dictionary_local;

            if (learned_text_local = '') or
                (get_candidate_text_unit_count(learned_text_local) <>
                input_syllable_count) then
            begin
                Exit;
            end;

            if (m_dictionary <> nil) and
                (m_dictionary.get_candidate_penalty(normalized_query_local,
                learned_text_local) > 0) and
                (not m_dictionary.is_base_entry(normalized_query_local,
                learned_text_local)) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(
                normalized_query_local);
            units_local := split_text_units(learned_text_local);
            if (Length(syllables_local) <> input_syllable_count) or
                (Length(units_local) <> input_syllable_count) then
            begin
                Exit;
            end;

            for unit_idx_local := 0 to High(units_local) do
            begin
                if (get_candidate_text_unit_count(units_local[unit_idx_local]) <> 1) or
                    (not match_single_char_candidate_for_syllable(
                    syllables_local[unit_idx_local].text,
                    units_local[unit_idx_local], is_preferred_local)) then
                begin
                    Exit;
                end;
            end;

            choice_priority_local :=
                get_exact_query_user_choice_priority_local(learned_text_local);
            if latest_from_session_local then
            begin
                Inc(choice_priority_local, 200000);
            end;
            if choice_priority_local <= 0 then
            begin
                choice_priority_local := get_session_query_bonus(
                    learned_text_local);
            end;
            if choice_priority_local <= 0 then
            begin
                Exit;
            end;

            if latest_from_dictionary_local and (not latest_from_session_local) and
                (m_dictionary <> nil) and
                is_low_evidence_admin_place_alias_cached(
                normalized_query_local, learned_text_local) then
            begin
                Exit;
            end;
            if (not trusted_latest_choice_local) and
                weak_learned_choice_is_blocked_by_strong_exact_local then
            begin
                Exit;
            end;
            if (strong_tail_completion_text_local <> '') and
                (not trusted_latest_choice_local) and
                (not SameText(learned_text_local,
                strong_tail_completion_text_local)) and
                (get_exact_weight_for_text_local(learned_text_local) <= 300) then
            begin
                Exit;
            end;

            learned_source_local := cs_user;
            learned_has_dict_weight_local := False;
            learned_dict_weight_local := 0;
            if (m_dictionary <> nil) and
                m_dictionary.is_base_entry(normalized_query_local,
                learned_text_local) then
            begin
                learned_source_local := cs_rule;
                learned_dict_weight_local :=
                    get_exact_weight_for_text_local(learned_text_local);
                learned_has_dict_weight_local := learned_dict_weight_local > 0;
            end;

            out_candidate.text := learned_text_local;
            out_candidate.comment := '';
            out_candidate.source := learned_source_local;
            out_candidate.has_dict_weight := learned_has_dict_weight_local;
            out_candidate.score := 50000 + choice_priority_local;
            if out_candidate.score < 120000 then
            begin
                out_candidate.score := 120000;
            end;
            out_candidate.dict_weight := learned_dict_weight_local;
            Result := True;
        end;

        procedure ensure_learned_exact_query_choice_visible_local(
            var candidates: TncCandidateList);
        var
            learned_candidate_local: TncCandidate;
            existing_candidate_local: TncCandidate;
            idx_local: Integer;
            existing_idx_local: Integer;
            move_idx_local: Integer;
        begin
            if not try_build_learned_exact_query_choice_candidate_local(
                learned_candidate_local) then
            begin
                Exit;
            end;

            if Length(candidates) > 0 then
            begin
                if learned_candidate_local.score <= candidates[0].score then
                begin
                    learned_candidate_local.score := candidates[0].score + 4096;
                end;
                if SameText(Trim(candidates[0].text),
                    learned_candidate_local.text) and
                    (Trim(candidates[0].comment) = '') then
                begin
                    if candidates[0].score < learned_candidate_local.score then
                    begin
                        candidates[0].score := learned_candidate_local.score;
                    end;
                    candidates[0].source := learned_candidate_local.source;
                    if learned_candidate_local.has_dict_weight then
                    begin
                        candidates[0].has_dict_weight := True;
                        candidates[0].dict_weight := Max(candidates[0].dict_weight,
                            learned_candidate_local.dict_weight);
                    end;
                    Exit;
                end;
            end;

            existing_idx_local := -1;
            for idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[idx_local].comment) = '') and
                    SameText(Trim(candidates[idx_local].text),
                    learned_candidate_local.text) then
                begin
                    existing_idx_local := idx_local;
                    Break;
                end;
            end;

            if existing_idx_local >= 0 then
            begin
                existing_candidate_local := candidates[existing_idx_local];
                if existing_candidate_local.score > learned_candidate_local.score then
                begin
                    learned_candidate_local.score :=
                        existing_candidate_local.score;
                end;
                if existing_candidate_local.has_dict_weight then
                begin
                    learned_candidate_local.dict_weight := Max(
                        learned_candidate_local.dict_weight,
                        existing_candidate_local.dict_weight);
                    learned_candidate_local.has_dict_weight := True;
                end;
                if Length(candidates) > 0 then
                begin
                    learned_candidate_local.score := Max(
                        learned_candidate_local.score,
                        candidates[0].score + 4096);
                end;
                for move_idx_local := existing_idx_local downto 1 do
                begin
                    candidates[move_idx_local] := candidates[move_idx_local - 1];
                end;
                candidates[0] := learned_candidate_local;
                Exit;
            end;

            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := learned_candidate_local;
        end;

        procedure filter_constructed_complete_candidates_with_exact_phrase_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            filtered_support_score_local: Integer;

            function has_multi_segment_candidate_path_local(
                const candidate: TncCandidate): Boolean;
            var
                encoded_path_local: string;
            begin
                Result := False;
                encoded_path_local := get_segment_path_for_candidate(candidate);
                if encoded_path_local = '' then
                begin
                    Exit;
                end;
                Result := get_encoded_path_segment_count_local(
                    encoded_path_local) > 1;
            end;

            function weak_complete_exact_is_blocked_by_tail_local(
                const candidate: TncCandidate): Boolean;
            var
                blocked_text_local: string;
                blocked_support_score_local: Integer;
            begin
                Result := False;
                blocked_text_local := Trim(candidate.text);
                if (strong_tail_completion_text_local = '') or
                    (blocked_text_local = '') or
                    (Trim(candidate.comment) <> '') or
                    SameText(blocked_text_local,
                    strong_tail_completion_text_local) or
                    (get_candidate_text_unit_count(blocked_text_local) <>
                    input_syllable_count) then
                begin
                    Exit;
                end;

                if candidate.source = cs_user then
                begin
                    Exit(not is_protected_user_choice_candidate_local(candidate));
                end;

                if (strong_tail_completion_text_local <> '') and
                    (candidate.source <> cs_user) and
                    (not candidate.has_dict_weight) then
                begin
                    Exit(True);
                end;

                if has_reliable_complete_support_text_local(blocked_text_local,
                    blocked_support_score_local) then
                begin
                    Exit(False);
                end;

                if has_multi_segment_candidate_path_local(candidate) then
                begin
                    Exit(False);
                end;

                Result := get_complete_exact_query_weight_for_text_local(
                    blocked_text_local) <= 300;
            end;
        begin
            filtered_constructed_count_local := 0;
            if (Length(candidates) = 0) or (input_syllable_count < 2) or
                ((best_complete_exact_text_local = '') and
                (strong_tail_completion_text_local = '')) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if is_fuzzy_pinyin_active and
                    (candidates[in_idx_local].fuzzy_cost > 0) and
                    (Trim(candidates[in_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) then
                begin
                    if out_idx_local <> in_idx_local then
                    begin
                        candidates[out_idx_local] := candidates[in_idx_local];
                    end;
                    Inc(out_idx_local);
                    Continue;
                end;
                if (Trim(candidates[in_idx_local].comment) = '') and
                    ((((best_complete_exact_text_local <> '') and
                    SameText(candidate_text_local,
                    best_complete_exact_text_local) and
                    (not weak_complete_exact_is_blocked_by_tail_local(
                    candidates[in_idx_local]))) or
                    ((strong_tail_completion_text_local <> '') and
                    SameText(candidate_text_local,
                    strong_tail_completion_text_local)))) then
                begin
                    if out_idx_local <> in_idx_local then
                    begin
                        candidates[out_idx_local] := candidates[in_idx_local];
                    end;
                    Inc(out_idx_local);
                    Continue;
                end;

                if is_complete_single_char_chain_candidate_local(
                    candidates[in_idx_local]) then
                begin
                    if not is_protected_user_choice_candidate_local(
                        candidates[in_idx_local]) then
                    begin
                        Inc(filtered_constructed_count_local);
                        Continue;
                    end;
                end;

                if (best_complete_exact_text_local <> '') and
                    (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (candidates[in_idx_local].source <> cs_user) and
                    (not candidates[in_idx_local].has_dict_weight) and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (not SameText(candidate_text_local,
                    best_complete_exact_text_local)) and
                    ((strong_tail_completion_text_local = '') or
                    (not SameText(candidate_text_local,
                    strong_tail_completion_text_local))) then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if (best_complete_exact_text_local <> '') and
                    (Trim(candidates[in_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (not SameText(candidate_text_local,
                    best_complete_exact_text_local)) and
                    ((strong_tail_completion_text_local = '') or
                    (not SameText(candidate_text_local,
                    strong_tail_completion_text_local))) and
                    (get_complete_exact_query_weight_for_text_local(
                    candidate_text_local) < 0) and
                    ((not has_multi_segment_candidate_path_local(
                    candidates[in_idx_local])) or
                    (not candidates[in_idx_local].has_dict_weight)) and
                    (not has_reliable_complete_support_text_local(
                    candidate_text_local, filtered_support_score_local)) and
                    (not is_protected_user_choice_candidate_local(
                    candidates[in_idx_local])) then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if weak_complete_exact_is_blocked_by_tail_local(
                    candidates[in_idx_local]) then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure filter_unsupported_nonlexicon_complete_candidates_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            candidate_is_unsupported_complete_local: Boolean;

            function span_query_key_local(const syllables_value:
                TncPinyinParseResult; const start_idx: Integer;
                const span_len: Integer): string;
            var
                syllable_idx_local: Integer;
            begin
                Result := '';
                if (start_idx < 0) or (span_len <= 0) or
                    (start_idx + span_len > Length(syllables_value)) then
                begin
                    Exit;
                end;

                for syllable_idx_local := start_idx to start_idx + span_len - 1 do
                begin
                    Result := Result + normalize_pinyin_text(
                        syllables_value[syllable_idx_local].text);
                end;
            end;

            function span_has_exact_text_local(const query_key: string;
                const target_text: string; const target_units: Integer): Boolean;
            var
                exact_results_local: TncCandidateList;
                exact_idx_local: Integer;
                exact_text_local: string;
            begin
                Result := False;
                if (query_key = '') or (target_text = '') or
                    (m_dictionary = nil) or
                    (not lookup_exact_full_pinyin_cached_local(query_key,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(exact_text_local, target_text) and
                        (get_candidate_text_unit_count(exact_text_local) =
                        target_units) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function unsupported_four_syllable_ab_cd_runtime_complete_local(
                const text_value: string): Boolean;
            var
                syllables_local: TncPinyinParseResult;
                units_local: TArray<string>;
                head_text_local: string;
                tail_text_local: string;
                head_query_local: string;
                tail_query_local: string;
            begin
                Result := False;
                if (input_syllable_count <> 4) or (m_dictionary = nil) then
                begin
                    Exit;
                end;

                syllables_local := get_effective_compact_pinyin_syllables(
                    lookup_text);
                units_local := split_text_units(text_value);
                if (Length(syllables_local) <> 4) or (Length(units_local) <> 4) then
                begin
                    Exit;
                end;

                head_text_local := units_local[0] + units_local[1];
                tail_text_local := units_local[2] + units_local[3];
                head_query_local := span_query_key_local(syllables_local, 0, 2);
                tail_query_local := span_query_key_local(syllables_local, 2, 2);

                if not (span_has_exact_text_local(head_query_local,
                    head_text_local, 2) and
                    span_has_exact_text_local(tail_query_local,
                    tail_text_local, 2)) then
                begin
                    Exit;
                end;

                Result := True;
            end;
        begin
            if (Length(candidates) = 0) or (input_syllable_count < 3) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                candidate_is_unsupported_complete_local :=
                    (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    ((not is_fuzzy_pinyin_active) or
                    (candidates[in_idx_local].fuzzy_cost <= 0)) and
                    (candidates[in_idx_local].source <> cs_user) and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (get_candidate_text_unit_count(candidate_text_local) >= 3) and
                    (not has_complete_exact_phrase_support_local(
                    candidate_text_local));
                if candidate_is_unsupported_complete_local and
                    ((input_syllable_count = 3) or
                    (not candidates[in_idx_local].has_dict_weight) or
                    unsupported_four_syllable_ab_cd_runtime_complete_local(
                    candidate_text_local)) then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure ensure_complete_phrase_head_partial_visible_local(
            var candidates: TncCandidateList);
        var
            syllables_local: TncPinyinParseResult;
            units_local: TArray<string>;
            head_text_local: string;
            remaining_pinyin_local: string;
            head_results_local: TncCandidateList;
            head_candidate_local: TncCandidate;
            idx_local: Integer;
            existing_idx_local: Integer;
            target_idx_local: Integer;
            move_idx_local: Integer;
            found_local: Boolean;
        begin
            if (Length(candidates) = 0) or (input_syllable_count < 2) or
                (Trim(candidates[0].comment) <> '') or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
            if Length(syllables_local) < 2 then
            begin
                Exit;
            end;

            units_local := split_text_units(Trim(candidates[0].text));
            if Length(units_local) < 2 then
            begin
                Exit;
            end;

            head_text_local := Trim(units_local[0]);
            if (head_text_local = '') or
                (get_candidate_text_unit_count(head_text_local) <> 1) then
            begin
                Exit;
            end;

            remaining_pinyin_local := '';
            for idx_local := 1 to High(syllables_local) do
            begin
                remaining_pinyin_local := remaining_pinyin_local +
                    syllables_local[idx_local].text;
            end;
            if remaining_pinyin_local = '' then
            begin
                Exit;
            end;

            if not lookup_exact_full_pinyin_cached_local(syllables_local[0].text,
                head_results_local) then
            begin
                Exit;
            end;

            found_local := False;
            FillChar(head_candidate_local, SizeOf(head_candidate_local), 0);
            for idx_local := 0 to High(head_results_local) do
            begin
                if (Trim(head_results_local[idx_local].comment) <> '') or
                    (Trim(head_results_local[idx_local].text) <>
                    head_text_local) or
                    (get_candidate_text_unit_count(Trim(
                    head_results_local[idx_local].text)) <> 1) then
                begin
                    Continue;
                end;

                head_candidate_local := head_results_local[idx_local];
                found_local := True;
                Break;
            end;
            if not found_local then
            begin
                Exit;
            end;

            head_candidate_local.comment := remaining_pinyin_local;
            if head_candidate_local.score >= candidates[0].score then
            begin
                head_candidate_local.score := candidates[0].score - 64;
            end;
            if head_candidate_local.has_dict_weight and
                (head_candidate_local.dict_weight >= candidates[0].score) then
            begin
                head_candidate_local.dict_weight := head_candidate_local.score;
            end;

            existing_idx_local := -1;
            for idx_local := 0 to High(candidates) do
            begin
                if SameText(Trim(candidates[idx_local].text),
                    head_candidate_local.text) and
                    SameText(Trim(candidates[idx_local].comment),
                    head_candidate_local.comment) then
                begin
                    existing_idx_local := idx_local;
                    Break;
                end;
            end;

            target_idx_local := 1;
            for idx_local := 1 to High(candidates) do
            begin
                if (Trim(candidates[idx_local].comment) <> '') and
                    (get_candidate_text_unit_count(Trim(candidates[idx_local].text)) >= 2) then
                begin
                    target_idx_local := idx_local + 1;
                    Break;
                end;
            end;
            if existing_idx_local = target_idx_local then
            begin
                Exit;
            end;

            if existing_idx_local >= 0 then
            begin
                head_candidate_local := candidates[existing_idx_local];
                if existing_idx_local < target_idx_local then
                begin
                    // Removing an earlier item shifts the insertion point left.
                    Dec(target_idx_local);
                    for move_idx_local := existing_idx_local to
                        target_idx_local - 1 do
                    begin
                        candidates[move_idx_local] :=
                            candidates[move_idx_local + 1];
                    end;
                end
                else
                begin
                    for move_idx_local := existing_idx_local downto
                        target_idx_local + 1 do
                    begin
                        candidates[move_idx_local] :=
                            candidates[move_idx_local - 1];
                    end;
                end;
                candidates[target_idx_local] := head_candidate_local;
                Exit;
            end;

            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto target_idx_local + 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[target_idx_local] := head_candidate_local;
        end;

        procedure ensure_single_syllable_best_exact_visible_local(
            var candidates: TncCandidateList);
        var
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            best_idx_local: Integer;
            existing_idx_local: Integer;
            move_idx_local: Integer;
            target_idx_local: Integer;
            best_weight_local: Integer;
            exact_weight_local: Integer;
            exact_text_local: string;
            exact_candidate_local: TncCandidate;
        begin
            if (Length(candidates) = 0) or (input_syllable_count <> 1) or
                (not is_full_pinyin_key(lookup_text)) or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            best_idx_local := -1;
            best_weight_local := Low(Integer);
            for exact_idx_local := 0 to High(exact_results_local) do
            begin
                exact_text_local := Trim(exact_results_local[exact_idx_local].text);
                if (Trim(exact_results_local[exact_idx_local].comment) <> '') or
                    (exact_text_local = '') or
                    (get_candidate_text_unit_count(exact_text_local) <> 1) then
                begin
                    Continue;
                end;

                exact_weight_local := exact_results_local[exact_idx_local].score;
                if exact_results_local[exact_idx_local].has_dict_weight and
                    (exact_results_local[exact_idx_local].dict_weight >
                    exact_weight_local) then
                begin
                    exact_weight_local :=
                        exact_results_local[exact_idx_local].dict_weight;
                end;

                if exact_weight_local > best_weight_local then
                begin
                    best_weight_local := exact_weight_local;
                    best_idx_local := exact_idx_local;
                end;
            end;

            if best_idx_local < 0 then
            begin
                Exit;
            end;

            exact_candidate_local := exact_results_local[best_idx_local];
            exact_candidate_local.comment := '';
            existing_idx_local := -1;
            for exact_idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[exact_idx_local].comment) = '') and
                    SameText(Trim(candidates[exact_idx_local].text),
                    exact_candidate_local.text) then
                begin
                    existing_idx_local := exact_idx_local;
                    Break;
                end;
            end;

            if existing_idx_local = 0 then
            begin
                Exit;
            end;

            target_idx_local := 1;
            if Length(candidates) = 1 then
            begin
                target_idx_local := 0;
            end;

            if existing_idx_local >= 0 then
            begin
                if existing_idx_local <= c_default_page_size - 1 then
                begin
                    Exit;
                end;

                for move_idx_local := existing_idx_local downto target_idx_local + 1 do
                begin
                    candidates[move_idx_local] := candidates[move_idx_local - 1];
                end;
                candidates[target_idx_local] := exact_candidate_local;
                Exit;
            end;

            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto target_idx_local + 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[target_idx_local] := exact_candidate_local;
        end;

        procedure filter_misaligned_complete_candidates_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            query_syllables_local: TncPinyinParseResult;

            function complete_candidate_matches_query_units_local(
                const candidate: TncCandidate; const text_value: string): Boolean;
            var
                candidate_units_local: TArray<string>;
                unit_idx_local: Integer;
                exact_results_local: TncCandidateList;
                encoded_path_local: string;
                inferred_path_local: string;
                inferred_score_local: Integer;
                inferred_segments_local: Integer;
                transition_particle_path_local: string;
                transition_particle_evidence_local: Integer;

                function full_query_exact_matches_text_local: Boolean;
                var
                    local_idx: Integer;
                begin
                    Result := False;
                    if (m_dictionary = nil) or (Trim(text_value) = '') or
                        (not lookup_exact_full_pinyin_cached_local(lookup_text,
                        exact_results_local)) then
                    begin
                        Exit;
                    end;

                    for local_idx := 0 to High(exact_results_local) do
                    begin
                        if (Trim(exact_results_local[local_idx].comment) = '') and
                            SameText(Trim(exact_results_local[local_idx].text),
                            text_value) and
                            (get_candidate_text_unit_count(Trim(
                            exact_results_local[local_idx].text)) =
                            input_syllable_count) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

                function build_segment_query_key_local(
                    const start_idx_local: Integer;
                    const count_local: Integer): string;
                var
                    query_idx_local: Integer;
                begin
                    Result := '';
                    if (start_idx_local < 0) or (count_local <= 0) or
                        (start_idx_local + count_local >
                        Length(query_syllables_local)) then
                    begin
                        Exit;
                    end;

                    for query_idx_local := start_idx_local to
                        start_idx_local + count_local - 1 do
                    begin
                        Result := Result + normalize_pinyin_text(
                            query_syllables_local[query_idx_local].text);
                    end;
                end;

                function segment_matches_query_local(
                    const start_idx_local: Integer;
                    const segment_value_local: string;
                    const segment_units_count_local: Integer): Boolean;
                var
                    segment_key_local: string;
                    segment_results_local: TncCandidateList;
                    segment_result_idx_local: Integer;

                    function structural_single_segment_matches_query_local(
                        const key_value_local: string;
                        const text_value_local: string): Boolean;
                    begin
                        Result := False;
                        if get_candidate_text_unit_count(text_value_local) <> 1 then
                        begin
                            Exit;
                        end;

                        if ((key_value_local = 'yi') and
                            (text_value_local = string(Char($4E00)))) or
                            (((key_value_local = 'er') or
                            (key_value_local = 'liang')) and
                            ((text_value_local = string(Char($4E8C))) or
                            (text_value_local = string(Char($4E24))))) or
                            ((key_value_local = 'san') and
                            (text_value_local = string(Char($4E09)))) or
                            ((key_value_local = 'si') and
                            (text_value_local = string(Char($56DB)))) or
                            ((key_value_local = 'wu') and
                            (text_value_local = string(Char($4E94)))) or
                            ((key_value_local = 'liu') and
                            (text_value_local = string(Char($516D)))) or
                            ((key_value_local = 'qi') and
                            (text_value_local = string(Char($4E03)))) or
                            ((key_value_local = 'ba') and
                            (text_value_local = string(Char($516B)))) or
                            ((key_value_local = 'jiu') and
                            (text_value_local = string(Char($4E5D)))) or
                            ((key_value_local = 'shi') and
                            (text_value_local = string(Char($5341)))) or
                            ((key_value_local = 'di') and
                            (text_value_local = string(Char($7B2C)))) or
                            ((key_value_local = 'zi') and
                            (text_value_local = string(Char($5B57)))) or
                            ((key_value_local = 'xiang') and
                            (text_value_local = string(Char($9879)))) or
                            ((key_value_local = 'ci') and
                            (text_value_local = string(Char($6B21)))) or
                            ((key_value_local = 'ge') and
                            (text_value_local = string(Char($4E2A)))) or
                            ((key_value_local = 'tiao') and
                            (text_value_local = string(Char($6761)))) or
                            ((key_value_local = 'zhang') and
                            (text_value_local = string(Char($5F20)))) or
                            ((key_value_local = 'dian') and
                            (text_value_local = string(Char($70B9)))) or
                            ((key_value_local = 'bu') and
                            (text_value_local = string(Char($6B65)))) or
                            ((key_value_local = 'lun') and
                            (text_value_local = string(Char($8F6E)))) or
                            ((key_value_local = 'jie') and
                            (text_value_local = string(Char($8282)))) or
                            ((key_value_local = 'ye') and
                            (text_value_local = string(Char($9875)))) or
                            ((key_value_local = 'duan') and
                            (text_value_local = string(Char($6BB5)))) or
                            ((key_value_local = 'hang') and
                            (text_value_local = string(Char($884C)))) or
                            ((key_value_local = 'lie') and
                            (text_value_local = string(Char($5217)))) then
                        begin
                            Exit(True);
                        end;
                    end;
                begin
                    Result := False;
                    if (segment_value_local = '') or
                        (segment_units_count_local <= 0) then
                    begin
                        Exit;
                    end;

                    segment_key_local := build_segment_query_key_local(
                        start_idx_local, segment_units_count_local);
                    if segment_key_local = '' then
                    begin
                        Exit;
                    end;

                    if segment_units_count_local = 1 then
                    begin
                        if structural_single_segment_matches_query_local(
                            segment_key_local, segment_value_local) then
                        begin
                            Exit(True);
                        end;
                        Exit(m_dictionary.single_char_matches_pinyin(
                            segment_key_local, segment_value_local));
                    end;

                    if not lookup_exact_full_pinyin_cached_local(
                        segment_key_local, segment_results_local) then
                    begin
                        Exit(False);
                    end;

                    for segment_result_idx_local := 0 to
                        High(segment_results_local) do
                    begin
                        if Trim(segment_results_local[segment_result_idx_local].comment) <> '' then
                        begin
                            Continue;
                        end;
                        if SameText(Trim(
                            segment_results_local[segment_result_idx_local].text),
                            segment_value_local) then
                        begin
                            Exit(True);
                        end;
                    end;
                end;

                function encoded_path_matches_query_local(
                    const path_value_local: string): Boolean;
                var
                    local_path_segments: TArray<string>;
                    local_segment_idx: Integer;
                    local_segment_text: string;
                    local_segment_units: Integer;
                    local_query_offset: Integer;
                begin
                    Result := False;
                    if path_value_local = '' then
                    begin
                        Exit;
                    end;

                    local_path_segments := path_value_local.Split(
                        [c_segment_path_separator]);
                    local_query_offset := 0;
                    for local_segment_idx := 0 to High(local_path_segments) do
                    begin
                        local_segment_text := Trim(
                            local_path_segments[local_segment_idx]);
                        if local_segment_text = '' then
                        begin
                            Continue;
                        end;
                        local_segment_units := get_candidate_text_unit_count(
                            local_segment_text);
                        if (local_segment_units <= 0) or
                            (local_query_offset + local_segment_units >
                            input_syllable_count) or
                            (not segment_matches_query_local(local_query_offset,
                            local_segment_text, local_segment_units)) then
                        begin
                            Exit(False);
                        end;
                        Inc(local_query_offset, local_segment_units);
                    end;
                    Result := local_query_offset = input_syllable_count;
                end;
            begin
                Result := True;
                if is_fuzzy_pinyin_active and
                    (candidate.fuzzy_cost > 0) then
                begin
                    Exit;
                end;
                if (m_dictionary = nil) or (candidate.source = cs_user) or
                    (Trim(candidate.comment) <> '') or
                    (get_candidate_text_unit_count(text_value) <>
                    input_syllable_count) then
                begin
                    Exit;
                end;

                if Length(query_syllables_local) <> input_syllable_count then
                begin
                    Exit;
                end;

                if (candidate.source = cs_rule) and candidate.has_dict_weight and
                    (candidate.dict_weight > 0) then
                begin
                    Exit(True);
                end;

                if full_query_exact_matches_text_local then
                begin
                    Exit(True);
                end;

                if (input_syllable_count = 4) and
                    get_short_four_transition_particle_path_evidence(
                    lookup_text, text_value,
                    transition_particle_path_local,
                    transition_particle_evidence_local) then
                begin
                    Exit(True);
                end;

                if (candidate.source = cs_rule) and candidate.has_dict_weight and
                    (candidate.score >= 20000) then
                begin
                    Exit(True);
                end;

                encoded_path_local := get_segment_path_for_candidate(candidate);
                if encoded_path_local = '' then
                begin
                    inferred_path_local :=
                        infer_segment_path_for_query_text_with_score(lookup_text,
                        text_value, inferred_score_local,
                        inferred_segments_local);
                    if (inferred_path_local <> '') and
                        encoded_path_matches_query_local(inferred_path_local) then
                    begin
                        remember_segment_path_for_candidate(text_value, '',
                            inferred_path_local, candidate.score);
                        Exit(True);
                    end;
                end;

                if encoded_path_local <> '' then
                begin
                    if encoded_path_matches_query_local(encoded_path_local) then
                    begin
                        Exit(True);
                    end;

                    inferred_path_local :=
                        infer_segment_path_for_query_text_with_score(lookup_text,
                        text_value, inferred_score_local,
                        inferred_segments_local);
                    if (inferred_path_local <> '') and
                        (not SameText(inferred_path_local, encoded_path_local)) and
                        encoded_path_matches_query_local(inferred_path_local) then
                    begin
                        remember_segment_path_for_candidate(text_value, '',
                            inferred_path_local, candidate.score);
                        Exit(True);
                    end;

                    Exit(False);
                end;

                candidate_units_local := split_text_units(text_value);
                if Length(candidate_units_local) <> input_syllable_count then
                begin
                    Exit(False);
                end;

                for unit_idx_local := 0 to High(candidate_units_local) do
                begin
                    if (get_candidate_text_unit_count(
                        candidate_units_local[unit_idx_local]) <> 1) or
                        (not m_dictionary.single_char_matches_pinyin(
                        normalize_pinyin_text(
                        query_syllables_local[unit_idx_local].text),
                        candidate_units_local[unit_idx_local])) then
                    begin
                        Exit(False);
                    end;
                end;
            end;
        begin
            filtered_misaligned_complete_count_local := 0;
            if (Length(candidates) = 0) or (input_syllable_count <= 1) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            query_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    input_syllable_count) then
                begin
                    Inc(filtered_misaligned_complete_count_local);
                    Continue;
                end;
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) =
                    input_syllable_count) and
                    (not complete_candidate_matches_query_units_local(
                    candidates[in_idx_local], candidate_text_local)) then
                begin
                    Inc(filtered_misaligned_complete_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure filter_rejected_user_candidate_texts_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;
            penalty_local: Integer;
        begin
            if (m_dictionary = nil) or (lookup_text = '') or
                (Length(candidates) = 0) then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if (candidate_text_local <> '') and
                    (Trim(candidates[in_idx_local].comment) = '') then
                begin
                    penalty_local := m_dictionary.get_candidate_penalty(
                        lookup_text, candidate_text_local);
                    if (penalty_local > 0) and
                        ((candidates[in_idx_local].source = cs_user) or
                        (not m_dictionary.is_base_entry(lookup_text,
                        candidate_text_local))) then
                    begin
                        Continue;
                    end;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;

            if out_idx_local < Length(candidates) then
            begin
                SetLength(candidates, out_idx_local);
            end;
        end;

        procedure ensure_lexicon_longer_prefix_complete_visible_local(
            var candidates: TncCandidateList);
        const
            c_prefix_total_limit = 6;
            c_prefix_base_bonus = 2100;
            c_prefix_unit_bonus = 260;
            c_prefix_complete_bonus = 980;
            c_prefix_remaining_penalty = 90;
        var
            prefix_results_local: TncCandidateList;
            prefix_candidates_local: TncCandidateList;
            prefix_idx_local: Integer;
            accepted_total_local: Integer;
            candidate_text_local: string;
            prefix_text_local: string;
            text_units_local: TArray<string>;
            unit_idx_local: Integer;
            candidate_local: TncCandidate;
            base_score_local: Integer;

            function is_safe_longer_prefix_suffix_local(const units: TArray<string>;
                const suffix_start_idx: Integer): Boolean;
            var
                suffix_head: string;
            begin
                Result := False;
                if (suffix_start_idx < 0) or (suffix_start_idx > High(units)) then
                begin
                    Exit;
                end;

                suffix_head := units[suffix_start_idx];
                if get_candidate_text_unit_count(suffix_head) <> 1 then
                begin
                    Exit;
                end;

                Result :=
                    (suffix_head = string(Char($533A))) or
                    (suffix_head = string(Char($5E02))) or
                    (suffix_head = string(Char($7701))) or
                    (suffix_head = string(Char($53BF))) or
                    (suffix_head = string(Char($9547))) or
                    (suffix_head = string(Char($4E61))) or
                    (suffix_head = string(Char($8DEF))) or
                    (suffix_head = string(Char($8857))) or
                    (suffix_head = string(Char($9053))) or
                    (suffix_head = string(Char($4E0B))) or
                    (suffix_head = string(Char($4E0A))) or
                    (suffix_head = string(Char($4E2D))) or
                    (suffix_head = string(Char($5185))) or
                    (suffix_head = string(Char($5916))) or
                    (suffix_head = string(Char($524D))) or
                    (suffix_head = string(Char($540E))) or
                    (suffix_head = string(Char($4E1C))) or
                    (suffix_head = string(Char($897F))) or
                    (suffix_head = string(Char($5357))) or
                    (suffix_head = string(Char($5317))) or
                    (suffix_head = string(Char($8FB9))) or
                    (suffix_head = string(Char($9762))) or
                    (suffix_head = string(Char($7248))) or
                    (suffix_head = string(Char($53F7))) or
                    (suffix_head = string(Char($5E97)));
            end;
        begin
            if (m_dictionary = nil) or (lookup_text = '') or
                (input_syllable_count < 2) or (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            if not m_dictionary.lookup_full_pinyin_prefix(lookup_text,
                prefix_results_local) then
            begin
                Exit;
            end;

            SetLength(prefix_candidates_local, 0);
            accepted_total_local := 0;
            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                if accepted_total_local >= c_prefix_total_limit then
                begin
                    Break;
                end;
                if (prefix_results_local[prefix_idx_local].source = cs_user) or
                    (Trim(prefix_results_local[prefix_idx_local].comment) <> '') then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                if candidate_text_local = '' then
                begin
                    Continue;
                end;

                text_units_local := split_text_units(candidate_text_local);
                if Length(text_units_local) <= input_syllable_count then
                begin
                    Continue;
                end;

                prefix_text_local := '';
                for unit_idx_local := 0 to input_syllable_count - 1 do
                begin
                    prefix_text_local := prefix_text_local +
                        text_units_local[unit_idx_local];
                end;

                if (prefix_text_local = '') or
                    m_dictionary.is_base_entry(lookup_text, prefix_text_local) then
                begin
                    Continue;
                end;
                if not is_safe_longer_prefix_suffix_local(text_units_local,
                    input_syllable_count) then
                begin
                    Continue;
                end;

                candidate_local := prefix_results_local[prefix_idx_local];
                candidate_local.text := prefix_text_local;
                candidate_local.comment := '';
                base_score_local := candidate_local.score;
                if candidate_local.has_dict_weight and
                    (candidate_local.dict_weight > base_score_local) then
                begin
                    base_score_local := candidate_local.dict_weight;
                end;
                if base_score_local < 0 then
                begin
                    base_score_local := 0;
                end;

                candidate_local.score := base_score_local + c_prefix_base_bonus +
                    (input_syllable_count * c_prefix_unit_bonus) +
                    c_prefix_complete_bonus -
                    ((Length(text_units_local) - input_syllable_count) *
                    c_prefix_remaining_penalty);
                candidate_local.dict_weight := base_score_local;
                candidate_local.has_dict_weight := True;

                SetLength(prefix_candidates_local,
                    Length(prefix_candidates_local) + 1);
                prefix_candidates_local[High(prefix_candidates_local)] :=
                    candidate_local;
                Inc(accepted_total_local);
            end;

            if Length(prefix_candidates_local) <= 0 then
            begin
                Exit;
            end;

            candidates := merge_candidate_lists(prefix_candidates_local,
                candidates, 0);
        end;

        procedure note_finalize_debug_elapsed_local(const phase_name: string;
            const phase_start_tick_local: UInt64);
        var
            elapsed_ms_local: UInt64;
        begin
            if not m_config.debug_mode then
            begin
                Exit;
            end;

            elapsed_ms_local := GetTickCount64 - phase_start_tick_local;
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                Format(' %s=%d', [phase_name, elapsed_ms_local]);
        end;

        procedure ensure_final_supported_complete_candidate_local(
            var candidates: TncCandidateList);
        const
            c_probe_limit = 8;
            c_promote_margin = 1024;
            c_support_weight = 12;
        var
            idx_local: Integer;
            best_idx_local: Integer;
            top_score_local: Integer;
            best_score_local: Integer;
            candidate_score_local: Integer;
            picked_local: TncCandidate;

            function get_fixed_head_bonus_local(
                const text_value_local: string): Integer;
            begin
                Result := 0;
            end;

            function try_get_bridge_prefix_for_syllable_local(
                const syllable_text_local: string; out out_text_local: string): Boolean;
            var
                normalized_local: string;
            begin
                Result := True;
                out_text_local := '';
                normalized_local := normalize_pinyin_text(syllable_text_local);
                if normalized_local = 'bu' then
                    out_text_local := string(Char($4E0D))
                else if normalized_local = 'zai' then
                    out_text_local := string(Char($5728))
                else if normalized_local = 'you' then
                    out_text_local := string(Char($6709))
                else if normalized_local = 'ye' then
                    out_text_local := string(Char($4E5F))
                else if normalized_local = 'hai' then
                    out_text_local := string(Char($8FD8))
                else if normalized_local = 'dou' then
                    out_text_local := string(Char($90FD))
                else if normalized_local = 'jiu' then
                    out_text_local := string(Char($5C31))
                else if normalized_local = 'de' then
                    out_text_local := string(Char($7684))
                else if normalized_local = 'dui' then
                    out_text_local := string(Char($5BF9))
                else if normalized_local = 'dao' then
                    out_text_local := string(Char($5230))
                else if normalized_local = 'cong' then
                    out_text_local := string(Char($4ECE))
                else if normalized_local = 'he' then
                    out_text_local := string(Char($548C))
                else if normalized_local = 'yu' then
                    out_text_local := string(Char($4E0E))
                else if normalized_local = 'ba' then
                    out_text_local := string(Char($628A))
                else if normalized_local = 'bei' then
                    out_text_local := string(Char($88AB))
                else if normalized_local = 'gei' then
                    out_text_local := string(Char($7ED9))
                else if normalized_local = 'rang' then
                    out_text_local := string(Char($8BA9))
                else if normalized_local = 'suo' then
                    out_text_local := string(Char($6240))
                else if normalized_local = 'shi' then
                    out_text_local := string(Char($662F))
                else if normalized_local = 'yi' then
                    out_text_local := string(Char($4E00))
                else
                    Result := False;
            end;

            function is_directional_location_phrase_text_local(
                const text_value_local: string): Boolean;
            var
                text_units_local: TArray<string>;
                head_text_local: string;
                tail_text_local: string;
            begin
                Result := False;
                text_units_local := split_text_units(Trim(text_value_local));
                if Length(text_units_local) <> 2 then
                begin
                    Exit;
                end;

                head_text_local := text_units_local[0];
                tail_text_local := text_units_local[1];
                if (get_candidate_text_unit_count(head_text_local) <> 1) or
                    (get_candidate_text_unit_count(tail_text_local) <> 1) then
                begin
                    Exit;
                end;

                case Ord(head_text_local[1]) of
                    $5317, $5357, $4E1C, $897F, $524D, $540E, $4E0A, $4E0B,
                    $91CC, $5185, $5916, $5DE6, $53F3:
                        case Ord(tail_text_local[1]) of
                            $9762, $8FB9, $4FA7, $65B9, $90E8, $7AEF, $5934:
                                Result := True;
                        end;
                end;
            end;

            function get_final_complete_score_local(
                const candidate_local: TncCandidate): Integer;
            var
                candidate_text_local: string;
                support_score_local: Integer;
                support_segments_local: Integer;
                support_path_local: string;
                units_local: TArray<string>;
                syllables_local: TncPinyinParseResult;
                start_idx_local: Integer;
                span_units_local: Integer;
                query_idx_local: Integer;
                query_key_local: string;
                chunk_text_local: string;
                exact_results_local: TncCandidateList;
                result_idx_local: Integer;
                best_exact_text_local: string;
                best_exact_weight_local: Integer;
                chunk_exact_weight_local: Integer;
                candidate_weight_local: Integer;
                candidate_contextual_weight_local: Integer;
                has_direction_context_local: Boolean;
                bridge_prefix_text_local: string;
                bridge_tail_units_local: Integer;
                bridge_tail_key_local: string;
                bridge_tail_text_local: string;
                bridge_tail_weight_local: Integer;
                bridge_span_text_local: string;

                function is_place_context_unit_local(
                    const unit_value_local: string): Boolean;
                begin
                    Result := (unit_value_local = string(Char($5BB6))) or
                        (unit_value_local = string(Char($5E97))) or
                        (unit_value_local = string(Char($5C4B))) or
                        (unit_value_local = string(Char($697C))) or
                        (unit_value_local = string(Char($57CE))) or
                        (unit_value_local = string(Char($6751))) or
                        (unit_value_local = string(Char($53BF))) or
                        (unit_value_local = string(Char($5E02))) or
                        (unit_value_local = string(Char($6821))) or
                        (unit_value_local = string(Char($9662))) or
                        (unit_value_local = string(Char($5382))) or
                        (unit_value_local = string(Char($9986))) or
                        (unit_value_local = string(Char($7AD9))) or
                        (unit_value_local = string(Char($5C40))) or
                        (unit_value_local = string(Char($6240))) or
                        (unit_value_local = string(Char($56ED))) or
                        (unit_value_local = string(Char($533A))) or
                        (unit_value_local = string(Char($5708))) or
                        (unit_value_local = string(Char($8DEF))) or
                        (unit_value_local = string(Char($8857))) or
                        (unit_value_local = string(Char($95E8))) or
                        (unit_value_local = string(Char($5BA4))) or
                        (unit_value_local = string(Char($623F))) or
                        (unit_value_local = string(Char($5385))) or
                        (unit_value_local = string(Char($573A))) or
                        (unit_value_local = string(Char($53F8)));
                end;

                function has_directional_location_span_context_local(
                    const local_start_idx: Integer;
                    const local_span_units: Integer): Boolean;
                var
                    next_key_local: string;
                begin
                    Result := False;
                    if (local_span_units <> 2) or (local_start_idx <= 0) or
                        (local_start_idx > High(units_local)) or
                        (not is_place_context_unit_local(
                        units_local[local_start_idx - 1])) then
                    begin
                        Exit;
                    end;

                    if local_start_idx + local_span_units >=
                        Length(syllables_local) then
                    begin
                        Exit(True);
                    end;

                    next_key_local := normalize_pinyin_text(
                        syllables_local[local_start_idx +
                        local_span_units].text);
                    Result := SameText(next_key_local, 'de');
                end;

                function get_directional_contextual_weight_local(
                    const text_value_local: string;
                    const raw_weight_local: Integer;
                    const has_direction_context_value_local: Boolean): Integer;
                const
                    c_final_directional_context_bonus = 12000;
                begin
                    Result := raw_weight_local;
                    if has_direction_context_value_local and
                        is_directional_location_phrase_text_local(
                        text_value_local) then
                    begin
                        Inc(Result, c_final_directional_context_bonus);
                    end;
                end;
            begin
                Result := Low(Integer);
                if Trim(candidate_local.comment) <> '' then
                begin
                    Exit;
                end;

                candidate_text_local := Trim(candidate_local.text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <>
                    input_syllable_count) or
                    is_problematic_single_char_chain_candidate_for_query(
                    lookup_text, candidate_local) then
                begin
                    Exit;
                end;

                Result := get_rank_score(candidate_local);
                support_path_local := infer_segment_path_for_query_text_with_score(
                    lookup_text, candidate_text_local, support_score_local,
                    support_segments_local);
                if support_path_local <> '' then
                begin
                    Inc(Result, support_score_local * c_support_weight);
                    if support_segments_local > 0 then
                    begin
                        Inc(Result, 8192 - (support_segments_local * 384));
                    end;
                end
                else
                begin
                    Dec(Result, 4096);
                end;
                Inc(Result, get_fixed_head_bonus_local(candidate_text_local));

                units_local := split_text_units(candidate_text_local);
                syllables_local := get_effective_compact_pinyin_syllables(
                    lookup_text);
                if (Length(units_local) = input_syllable_count) and
                    (Length(syllables_local) = input_syllable_count) and
                    (m_dictionary <> nil) then
                begin
                    for start_idx_local := 1 to input_syllable_count - 3 do
                    begin
                        if has_directional_location_span_context_local(
                            start_idx_local, 2) and
                            is_directional_location_phrase_text_local(
                            units_local[start_idx_local] +
                            units_local[start_idx_local + 1]) then
                        begin
                            Inc(Result, 18000);
                            Break;
                        end;
                    end;

                    for start_idx_local := 0 to input_syllable_count - 1 do
                    begin
                        for span_units_local := 2 to Min(4,
                            input_syllable_count - start_idx_local) do
                        begin
                            query_key_local := '';
                            for query_idx_local := start_idx_local to
                                start_idx_local + span_units_local - 1 do
                            begin
                                query_key_local := query_key_local +
                                    normalize_pinyin_text(
                                    syllables_local[query_idx_local].text);
                            end;
                            if (query_key_local = '') or
                                (not m_dictionary.lookup_exact_full_pinyin(
                                query_key_local, exact_results_local)) then
                            begin
                                Continue;
                            end;

                            chunk_text_local := '';
                            for query_idx_local := start_idx_local to
                                start_idx_local + span_units_local - 1 do
                            begin
                                chunk_text_local := chunk_text_local +
                                    units_local[query_idx_local];
                            end;

                            best_exact_text_local := '';
                            best_exact_weight_local := Low(Integer);
                            chunk_exact_weight_local := Low(Integer);
                            has_direction_context_local :=
                                has_directional_location_span_context_local(
                                start_idx_local, span_units_local);
                            for result_idx_local := 0 to Min(5,
                                High(exact_results_local)) do
                            begin
                                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                if get_candidate_text_unit_count(
                                    Trim(exact_results_local[result_idx_local].text)) <>
                                    span_units_local then
                                begin
                                    Continue;
                                end;

                                if exact_results_local[result_idx_local].has_dict_weight then
                                begin
                                    candidate_weight_local :=
                                        exact_results_local[result_idx_local].dict_weight;
                                end
                                else
                                begin
                                    candidate_weight_local :=
                                        exact_results_local[result_idx_local].score;
                                end;
                                candidate_contextual_weight_local :=
                                    get_directional_contextual_weight_local(
                                    Trim(exact_results_local[result_idx_local].text),
                                    candidate_weight_local,
                                    has_direction_context_local);
                                if candidate_contextual_weight_local >
                                    best_exact_weight_local then
                                begin
                                    best_exact_weight_local :=
                                        candidate_contextual_weight_local;
                                    best_exact_text_local := Trim(
                                        exact_results_local[result_idx_local].text);
                                end;
                                if SameText(Trim(exact_results_local[result_idx_local].text),
                                    chunk_text_local) and
                                    (candidate_contextual_weight_local >
                                    chunk_exact_weight_local) then
                                begin
                                    chunk_exact_weight_local :=
                                        candidate_contextual_weight_local;
                                end;
                            end;
                            if best_exact_text_local = '' then
                            begin
                                Continue;
                            end;

                            if SameText(chunk_text_local, best_exact_text_local) then
                            begin
                                case span_units_local of
                                    2:
                                        Inc(Result, 3200);
                                    3:
                                        Inc(Result, 7200);
                                else
                                    Inc(Result, 12000);
                                end;
                            end
                            else if best_exact_weight_local >= 1200 then
                            begin
                                case span_units_local of
                                    2:
                                        Dec(Result, 3600);
                                    3:
                                        Dec(Result, 8800);
                                else
                                    Dec(Result, 14000);
                                end;
                            end;

                            if (span_units_local = 2) and
                                (chunk_exact_weight_local > Low(Integer)) and
                                is_directional_location_phrase_text_local(
                                chunk_text_local) and
                                has_direction_context_local then
                            begin
                                Inc(Result, 9600 +
                                    Min(2400, chunk_exact_weight_local div 2));
                            end;
                        end;
                    end;

                    for start_idx_local := 0 to input_syllable_count - 3 do
                    begin
                        if not try_get_bridge_prefix_for_syllable_local(
                            syllables_local[start_idx_local].text,
                            bridge_prefix_text_local) then
                        begin
                            Continue;
                        end;
                        for bridge_tail_units_local := 2 to Min(4,
                            input_syllable_count - start_idx_local - 1) do
                        begin
                            bridge_tail_key_local := '';
                            for query_idx_local := start_idx_local + 1 to
                                start_idx_local + bridge_tail_units_local do
                            begin
                                bridge_tail_key_local := bridge_tail_key_local +
                                    normalize_pinyin_text(
                                    syllables_local[query_idx_local].text);
                            end;
                            if (bridge_tail_key_local = '') or
                                (not m_dictionary.lookup_exact_full_pinyin(
                                bridge_tail_key_local, exact_results_local)) then
                            begin
                                Continue;
                            end;

                            bridge_tail_text_local := '';
                            bridge_tail_weight_local := Low(Integer);
                            for result_idx_local := 0 to Min(5,
                                High(exact_results_local)) do
                            begin
                                if Trim(exact_results_local[result_idx_local].comment) <> '' then
                                begin
                                    Continue;
                                end;
                                if get_candidate_text_unit_count(
                                    Trim(exact_results_local[result_idx_local].text)) <>
                                    bridge_tail_units_local then
                                begin
                                    Continue;
                                end;
                                if exact_results_local[result_idx_local].has_dict_weight then
                                begin
                                    candidate_weight_local :=
                                        exact_results_local[result_idx_local].dict_weight;
                                end
                                else
                                begin
                                    candidate_weight_local :=
                                        exact_results_local[result_idx_local].score;
                                end;
                                if candidate_weight_local > bridge_tail_weight_local then
                                begin
                                    bridge_tail_weight_local := candidate_weight_local;
                                    bridge_tail_text_local := Trim(
                                        exact_results_local[result_idx_local].text);
                                end;
                            end;
                            if (bridge_tail_text_local = '') or
                                (bridge_tail_weight_local < 500) then
                            begin
                                Continue;
                            end;

                            bridge_span_text_local := '';
                            for query_idx_local := start_idx_local to
                                start_idx_local + bridge_tail_units_local do
                            begin
                                bridge_span_text_local := bridge_span_text_local +
                                    units_local[query_idx_local];
                            end;
                            if SameText(bridge_span_text_local,
                                bridge_prefix_text_local + bridge_tail_text_local) then
                            begin
                                Inc(Result, 9000 + bridge_tail_units_local * 1800);
                            end
                            else
                            begin
                                Dec(Result, 9000 + bridge_tail_units_local * 1800);
                            end;
                        end;
                    end;
                end;
            end;
        begin
            if (Length(candidates) <= 1) or (input_syllable_count < 4) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            top_score_local := get_final_complete_score_local(candidates[0]);
            best_idx_local := -1;
            best_score_local := top_score_local;
            for idx_local := 1 to Min(c_probe_limit - 1, High(candidates)) do
            begin
                candidate_score_local := get_final_complete_score_local(
                    candidates[idx_local]);
                if candidate_score_local > best_score_local then
                begin
                    best_score_local := candidate_score_local;
                    best_idx_local := idx_local;
                end;
            end;

            if (best_idx_local <= 0) or
                (best_score_local <= top_score_local + c_promote_margin) then
            begin
                Exit;
            end;

            picked_local := candidates[best_idx_local];
            for idx_local := best_idx_local downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := picked_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' ffinal=[promote text=%s score=%d top=%d]',
                    [Trim(picked_local.text), best_score_local, top_score_local]);
            end;
        end;

        procedure promote_highest_scored_complete_candidate_local(
            var candidates: TncCandidateList);
        const
            c_probe_limit = 8;
            c_promote_margin = 512;
        var
            idx_local: Integer;
            best_idx_local: Integer;
            best_score_local: Integer;
            top_score_local: Integer;
            adjusted_score_local: Integer;
            picked_local: TncCandidate;

            function is_place_context_unit_for_candidate_local(
                const unit_value_local: string): Boolean;
            begin
                Result := (unit_value_local = string(Char($5BB6))) or
                    (unit_value_local = string(Char($5E97))) or
                    (unit_value_local = string(Char($5C4B))) or
                    (unit_value_local = string(Char($697C))) or
                    (unit_value_local = string(Char($57CE))) or
                    (unit_value_local = string(Char($6751))) or
                    (unit_value_local = string(Char($53BF))) or
                    (unit_value_local = string(Char($5E02))) or
                    (unit_value_local = string(Char($6821))) or
                    (unit_value_local = string(Char($9662))) or
                    (unit_value_local = string(Char($5382))) or
                    (unit_value_local = string(Char($9986))) or
                    (unit_value_local = string(Char($7AD9))) or
                    (unit_value_local = string(Char($5C40))) or
                    (unit_value_local = string(Char($6240))) or
                    (unit_value_local = string(Char($56ED))) or
                    (unit_value_local = string(Char($533A))) or
                    (unit_value_local = string(Char($5708))) or
                    (unit_value_local = string(Char($8DEF))) or
                    (unit_value_local = string(Char($8857))) or
                    (unit_value_local = string(Char($95E8))) or
                    (unit_value_local = string(Char($5BA4))) or
                    (unit_value_local = string(Char($623F))) or
                    (unit_value_local = string(Char($5385))) or
                    (unit_value_local = string(Char($573A))) or
                    (unit_value_local = string(Char($53F8)));
            end;

            function exact_span_contains_text_local(const local_start_idx: Integer;
                const local_span_units: Integer; const text_value_local: string):
                Boolean;
            var
                syllables_local: TncPinyinParseResult;
                query_idx_local: Integer;
                query_key_local: string;
                exact_results_local: TncCandidateList;
                result_idx_local: Integer;
            begin
                Result := False;
                syllables_local := get_effective_compact_pinyin_syllables(
                    lookup_text);
                if (local_start_idx < 0) or (local_span_units <= 0) or
                    (local_start_idx + local_span_units >
                    Length(syllables_local)) then
                begin
                    Exit;
                end;

                query_key_local := '';
                for query_idx_local := local_start_idx to
                    local_start_idx + local_span_units - 1 do
                begin
                    query_key_local := query_key_local + normalize_pinyin_text(
                        syllables_local[query_idx_local].text);
                end;
                if (query_key_local = '') or
                    (not m_dictionary.lookup_exact_full_pinyin(query_key_local,
                    exact_results_local)) then
                begin
                    Exit;
                end;

                for result_idx_local := 0 to High(exact_results_local) do
                begin
                    if Trim(exact_results_local[result_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    if SameText(Trim(exact_results_local[result_idx_local].text),
                        text_value_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;

            function is_directional_location_phrase_for_candidate_local(
                const text_value_local: string): Boolean;
            var
                units_local: TArray<string>;
                first_unit_local: string;
                second_unit_local: string;
            begin
                Result := False;
                units_local := split_text_units(Trim(text_value_local));
                if Length(units_local) <> 2 then
                begin
                    Exit;
                end;

                first_unit_local := units_local[0];
                second_unit_local := units_local[1];
                if not (SameText(first_unit_local, string(Char($5317))) or
                    SameText(first_unit_local, string(Char($5357))) or
                    SameText(first_unit_local, string(Char($4E1C))) or
                    SameText(first_unit_local, string(Char($897F))) or
                    SameText(first_unit_local, string(Char($524D))) or
                    SameText(first_unit_local, string(Char($540E))) or
                    SameText(first_unit_local, string(Char($4E0A))) or
                    SameText(first_unit_local, string(Char($4E0B))) or
                    SameText(first_unit_local, string(Char($91CC))) or
                    SameText(first_unit_local, string(Char($5185))) or
                    SameText(first_unit_local, string(Char($5916))) or
                    SameText(first_unit_local, string(Char($5DE6))) or
                    SameText(first_unit_local, string(Char($53F3)))) then
                begin
                    Exit;
                end;

                Result := SameText(second_unit_local, string(Char($9762))) or
                    SameText(second_unit_local, string(Char($8FB9))) or
                    SameText(second_unit_local, string(Char($4FA7))) or
                    SameText(second_unit_local, string(Char($65B9))) or
                    SameText(second_unit_local, string(Char($90E8)));
            end;

            function get_directional_context_promote_bonus_local(
                const candidate: TncCandidate): Integer;
            const
                c_directional_context_candidate_bonus = 12000;
            var
                candidate_text_local: string;
                units_local: TArray<string>;
                syllables_local: TncPinyinParseResult;
                start_idx_local: Integer;
                span_text_local: string;
                next_key_local: string;
            begin
                Result := 0;
                if (m_dictionary = nil) or (Trim(candidate.comment) <> '') then
                begin
                    Exit;
                end;

                candidate_text_local := Trim(candidate.text);
                units_local := split_text_units(candidate_text_local);
                syllables_local := get_effective_compact_pinyin_syllables(
                    lookup_text);
                if (Length(units_local) <> input_syllable_count) or
                    (Length(syllables_local) <> input_syllable_count) then
                begin
                    Exit;
                end;

                for start_idx_local := 1 to input_syllable_count - 3 do
                begin
                    if not is_place_context_unit_for_candidate_local(
                        units_local[start_idx_local - 1]) then
                    begin
                        Continue;
                    end;
                    next_key_local := normalize_pinyin_text(
                        syllables_local[start_idx_local + 2].text);
                    if not SameText(next_key_local, 'de') then
                    begin
                        Continue;
                    end;
                    span_text_local := units_local[start_idx_local] +
                        units_local[start_idx_local + 1];
                    if is_directional_location_phrase_for_candidate_local(
                        span_text_local) and
                        exact_span_contains_text_local(start_idx_local, 2,
                        span_text_local) then
                    begin
                        if m_config.debug_mode then
                        begin
                            m_last_full_path_debug_info :=
                                m_last_full_path_debug_info +
                                Format(' dirctxpromote=[text=%s span=%s idx=%d]',
                                [candidate_text_local, span_text_local,
                                start_idx_local]);
                        end;
                        Exit(c_directional_context_candidate_bonus);
                    end;
                end;
            end;
        begin
            if (Length(candidates) <= 1) or (input_syllable_count < 4) then
            begin
                Exit;
            end;
            best_idx_local := -1;
            best_score_local := Low(Integer);
            for idx_local := 0 to Min(c_probe_limit - 1, High(candidates)) do
            begin
                if (Trim(candidates[idx_local].comment) <> '') or
                    (get_candidate_text_unit_count(Trim(candidates[idx_local].text)) <>
                    input_syllable_count) or
                    (is_problematic_single_char_chain_candidate_for_query(
                    lookup_text, candidates[idx_local]) and
                    (get_segment_path_for_candidate(candidates[idx_local]) = '')) then
                begin
                    Continue;
                end;
                adjusted_score_local := candidates[idx_local].score +
                    get_directional_context_promote_bonus_local(
                    candidates[idx_local]);
                if (best_idx_local < 0) or
                    (adjusted_score_local > best_score_local) then
                begin
                    best_idx_local := idx_local;
                    best_score_local := adjusted_score_local;
                end;
            end;
            if best_idx_local <= 0 then
            begin
                Exit;
            end;
            top_score_local := candidates[0].score +
                get_directional_context_promote_bonus_local(candidates[0]);
            if best_score_local <= top_score_local + c_promote_margin then
            begin
                Exit;
            end;

            picked_local := candidates[best_idx_local];
            for idx_local := best_idx_local downto 1 do
            begin
                candidates[idx_local] := candidates[idx_local - 1];
            end;
            candidates[0] := picked_local;
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' rawscorepromote=[text=%s score=%d top=%d]',
                    [Trim(picked_local.text), best_score_local, top_score_local]);
            end;
        end;

        procedure filter_empty_text_candidates_local(var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
        begin
            if Length(candidates) = 0 then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                if Trim(candidates[in_idx_local].text) = '' then
                begin
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        procedure filter_exact_single_syllable_prefix_partials_local(
            var candidates: TncCandidateList);
        var
            in_idx_local: Integer;
            out_idx_local: Integer;
            full_results_local: TncCandidateList;
            full_idx_local: Integer;
            has_full_multi_anchor_local: Boolean;
            has_plain_single_local: Boolean;

            function is_full_multi_anchor_candidate_local(
                const candidate: TncCandidate): Boolean;
            var
                candidate_text_local: string;
                anchor_idx_local: Integer;
            begin
                Result := False;
                if (not has_full_multi_anchor_local) or
                    (Trim(candidate.comment) <> '') then
                begin
                    Exit;
                end;

                candidate_text_local := Trim(candidate.text);
                if (candidate_text_local = '') or
                    (get_candidate_text_unit_count(candidate_text_local) <= 1) then
                begin
                    Exit;
                end;

                for anchor_idx_local := 0 to High(full_results_local) do
                begin
                    if (Trim(full_results_local[anchor_idx_local].comment) = '') and
                        SameText(Trim(full_results_local[anchor_idx_local].text),
                        candidate_text_local) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (Length(candidates) = 0) or (input_syllable_count <> 1) then
            begin
                Exit;
            end;

            has_full_multi_anchor_local := False;
            if (m_dictionary <> nil) and (lookup_text <> '') and
                m_dictionary.lookup(lookup_text, full_results_local) then
            begin
                for full_idx_local := 0 to High(full_results_local) do
                begin
                    if (Trim(full_results_local[full_idx_local].comment) = '') and
                        (get_candidate_text_unit_count(Trim(
                        full_results_local[full_idx_local].text)) > 1) then
                    begin
                        has_full_multi_anchor_local := True;
                        Break;
                    end;
                end;
            end;

            has_plain_single_local := False;
            for in_idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[in_idx_local].comment) = '') and
                    (get_candidate_text_unit_count(Trim(
                    candidates[in_idx_local].text)) = 1) then
                begin
                    has_plain_single_local := True;
                    Break;
                end;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                if Trim(candidates[in_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                if get_candidate_text_unit_count(Trim(
                    candidates[in_idx_local].text)) <> 1 then
                begin
                    if has_plain_single_local and
                        (not is_full_multi_anchor_candidate_local(
                        candidates[in_idx_local])) then
                    begin
                        Continue;
                    end;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;

        function should_use_fast_two_syllable_complete_exit_local: Boolean;
        var
            top_text_local: string;
        begin
            Result := False;
            if (input_syllable_count <> 2) or head_only_multi_syllable or
                (Length(m_candidates) = 0) or
                (not is_full_pinyin_key(lookup_text)) then
            begin
                Exit;
            end;

            if Trim(m_candidates[0].comment) <> '' then
            begin
                Exit;
            end;

            top_text_local := Trim(m_candidates[0].text);
            Result := (top_text_local <> '') and
                (get_candidate_text_unit_count(top_text_local) = 2) and
                has_complete_exact_phrase_support_local(top_text_local);
        end;

        procedure filter_two_syllable_fast_complete_candidates_local(
            var candidates: TncCandidateList);
        var
            exact_results_local: TncCandidateList;
            in_idx_local: Integer;
            out_idx_local: Integer;
            candidate_text_local: string;

            function exact_complete_text_exists_local(
                const text_value: string): Boolean;
            var
                exact_idx_local: Integer;
            begin
                Result := False;
                if text_value = '' then
                begin
                    Exit;
                end;

                for exact_idx_local := 0 to High(exact_results_local) do
                begin
                    if (Trim(exact_results_local[exact_idx_local].comment) = '') and
                        SameText(Trim(exact_results_local[exact_idx_local].text),
                        text_value) and
                        (get_candidate_text_unit_count(Trim(
                        exact_results_local[exact_idx_local].text)) = 2) then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            if (Length(candidates) = 0) or
                (not lookup_exact_full_pinyin_cached_local(lookup_text,
                exact_results_local)) then
            begin
                Exit;
            end;

            out_idx_local := 0;
            for in_idx_local := 0 to High(candidates) do
            begin
                candidate_text_local := Trim(candidates[in_idx_local].text);
                if candidate_text_local = '' then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if Trim(candidates[in_idx_local].comment) <> '' then
                begin
                    if out_idx_local <> in_idx_local then
                    begin
                        candidates[out_idx_local] := candidates[in_idx_local];
                    end;
                    Inc(out_idx_local);
                    Continue;
                end;

                if get_candidate_text_unit_count(candidate_text_local) <> 2 then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if (candidates[in_idx_local].source <> cs_user) and
                    (not exact_complete_text_exists_local(candidate_text_local)) then
                begin
                    Inc(filtered_constructed_count_local);
                    Continue;
                end;

                if out_idx_local <> in_idx_local then
                begin
                    candidates[out_idx_local] := candidates[in_idx_local];
                end;
                Inc(out_idx_local);
            end;
            SetLength(candidates, out_idx_local);
        end;
    begin
