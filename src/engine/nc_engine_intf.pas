    m_last_ranked_top_path := '';
    m_last_candidates_incrementally_reusable := True;
    m_composition_built_incrementally := False;
    // Ranked paths are speculative ordering state from the current composition,
    // not user-confirmed learning. Keep them from leaking into the next query.
    if m_session_ranked_query_paths <> nil then
    begin
        m_session_ranked_query_paths.Clear;
    end;
    if m_session_ranked_query_path_scores <> nil then
    begin
