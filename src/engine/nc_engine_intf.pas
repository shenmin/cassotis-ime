        function get_first_text_unit_for_guard_local(const text_value: string): string;
        var
            text_units_local: TArray<string>;
        begin
            Result := '';
            text_units_local := split_text_units(Trim(text_value));
            if Length(text_units_local) > 0 then
            begin
                Result := text_units_local[0];
            end;
        end;

        function should_skip_weak_fixed_head_exact_local(
            const local_start_idx: Integer; const local_chunk_syllables: Integer;
            const candidate_text_value: string; const candidate_weight_value: Integer;
            const candidate_source_value: TncCandidateSource): Boolean;
        var
            fixed_head_text_local: string;
            candidate_head_text_local: string;
        begin
            Result := False;
            if (local_chunk_syllables <> 2) or
                (local_start_idx < 0) or
                (local_start_idx > High(exact_subspan_cache_syllables)) or
                (candidate_source_value = cs_user) or
                (candidate_weight_value >= c_weak_fixed_head_exact_weight) then
            begin
                Exit;
            end;

            fixed_head_text_local := get_fixed_boundary_single_char_local(
                exact_subspan_cache_syllables[local_start_idx].text);
            if fixed_head_text_local = '' then
            begin
                Exit;
            end;

            candidate_head_text_local :=
                get_first_text_unit_for_guard_local(candidate_text_value);
            Result := (candidate_head_text_local <> '') and
                (not SameText(candidate_head_text_local, fixed_head_text_local));
        end;

        procedure try_update_with_candidate(const local_pos: Integer;
            const local_chunk_syllables: Integer; const chunk_text: string;
            const base_weight: Integer);
        begin
            candidate_text := Trim(chunk_text);
            if candidate_text = '' then
            begin
                Exit;
            end;
            candidate_units := get_candidate_text_unit_count(candidate_text);
            if candidate_units <> local_chunk_syllables then
            begin
                Exit;
            end;

            next_pos := local_pos + local_chunk_syllables;
            total_score := base_weight +
                (local_chunk_syllables * local_chunk_syllables * c_chunk_length_bonus);
            local_has_anchor := local_chunk_syllables >= 3;
            if local_has_anchor then
            begin
                Inc(total_score, c_chunk_anchor_bonus);
            end;

            total_segments := 1;
            total_has_anchor := local_has_anchor;
            if local_has_anchor then
            begin
                total_anchor_units := local_chunk_syllables;
            end
            else
            begin
                total_anchor_units := 0;
            end;
            combined_text := candidate_text;
            combined_path := candidate_text;

            if next_pos < span_syllables then
            begin
                Inc(total_score, best_scores[next_pos]);
                Inc(total_score, get_suffix_context_bonus_local(candidate_text,
                    best_paths[next_pos]));
                Inc(total_score, get_suffix_base_prefix_bonus_local(candidate_text,
                    best_paths[next_pos]));
                Inc(total_segments, best_segments[next_pos]);
                if best_has_anchor[next_pos] then
                begin
                    total_has_anchor := True;
                    if best_anchor_units[next_pos] > total_anchor_units then
                    begin
                        total_anchor_units := best_anchor_units[next_pos];
                    end;
                end;
                combined_text := combined_text + best_texts[next_pos];
                if best_paths[next_pos] <> '' then
                begin
                    combined_path := combined_path + c_segment_path_separator +
                        best_paths[next_pos];
                end;
            end;

            if (local_chunk_syllables = 1) and
                (next_pos < span_syllables) and
                (best_paths[next_pos] <> '') then
            begin
                suffix_first_unit_local :=
                    get_first_path_text_unit_local(best_paths[next_pos]);
                if (suffix_first_unit_local <> '') and
                    try_get_best_exact_two_unit_text_local(start_idx + local_pos,
                    expected_pair_text_local, expected_pair_weight_local) then
                begin
                    actual_pair_text_local := candidate_text +
                        suffix_first_unit_local;
                    if SameText(expected_pair_text_local,
                        actual_pair_text_local) then
                    begin
                        Inc(total_score, 1200 +
                            Min(4800, expected_pair_weight_local div 4));
                    end
                else
                begin
                    suffix_first_segment_local :=
                        get_first_path_segment_text_local(best_paths[next_pos]);
                    suffix_first_segment_units_local :=
                        get_candidate_text_unit_count(suffix_first_segment_local);
                    if is_structural_particle_text_local(candidate_text) and
                        (suffix_first_segment_units_local >= 2) then
                    begin
                        Inc(total_score, 1800);
                    end
                    else
                    begin
                        Dec(total_score, 24000 +
                            Min(48000, expected_pair_weight_local * 8));
                    end;
                end;
            end;
            end;

            better_candidate := False;
            if total_score > best_scores[local_pos] then
            begin
                better_candidate := True;
            end
            else if total_score = best_scores[local_pos] then
            begin
                if total_has_anchor and (not best_has_anchor[local_pos]) then
                begin
                    better_candidate := True;
                end
                else if total_has_anchor = best_has_anchor[local_pos] then
                begin
                    if total_anchor_units > best_anchor_units[local_pos] then
                    begin
                        better_candidate := True;
                    end
                    else if total_anchor_units = best_anchor_units[local_pos] then
                    begin
                        if total_segments < best_segments[local_pos] then
                        begin
                            better_candidate := True;
                        end
                        else if (total_segments = best_segments[local_pos]) and
                            ((best_texts[local_pos] = '') or
                            (CompareText(combined_text, best_texts[local_pos]) < 0)) then
                        begin
                            better_candidate := True;
                        end;
                    end;
                end;
            end;

            if better_candidate then
            begin
                best_scores[local_pos] := total_score;
                best_segments[local_pos] := total_segments;
                best_anchor_units[local_pos] := total_anchor_units;
                best_has_anchor[local_pos] := total_has_anchor;
                best_texts[local_pos] := combined_text;
                best_paths[local_pos] := combined_path;
            end;
        end;

        procedure collect_exact_chunk_candidates_local(
            const local_start_idx: Integer;
            const local_chunk_syllables: Integer;
            out out_texts: TArray<string>; out out_weights: TArray<Integer>);
        var
            query_key_local: string;
            local_results: TncCandidateList;
            local_result_idx: Integer;
            candidate_text_local: string;
            raw_weight_local: Integer;
            exact_bonus_local: Integer;
            option_idx_local: Integer;
        begin
            SetLength(out_texts, 0);
            SetLength(out_weights, 0);
            if (m_dictionary = nil) or (local_start_idx < 0) or
                (local_start_idx > High(exact_subspan_cache_syllables)) or
                (local_chunk_syllables < 2) or
                (local_chunk_syllables > c_span_max_syllables) then
            begin
                Exit;
            end;

            if exact_subspan_chunk_cache_prepared[local_start_idx][
                local_chunk_syllables] then
            begin
                out_texts := exact_subspan_chunk_cache_texts[
                    local_start_idx][local_chunk_syllables];
                out_weights := exact_subspan_chunk_cache_weights[
                    local_start_idx][local_chunk_syllables];
                Exit;
            end;
            exact_subspan_chunk_cache_prepared[local_start_idx][
                local_chunk_syllables] := True;

            query_key_local := build_query_key_local(local_start_idx,
                local_chunk_syllables);
            if query_key_local = '' then
            begin
                Exit;
            end;
            if not lookup_exact_full_pinyin_cached_local(query_key_local,
                local_results) then
            begin
                if (local_chunk_syllables > 2) or
                    (not m_dictionary.lookup(query_key_local, local_results)) then
                begin
                    Exit;
                end;
            end;

            for local_result_idx := 0 to High(local_results) do
            begin
                if local_result_idx >= c_probe_limit then
                begin
                    Break;
                end;
                if Trim(local_results[local_result_idx].comment) <> '' then
                begin
                    Continue;
                end;
                if is_runtime_chain_candidate(local_results[local_result_idx]) or
                    is_runtime_common_pattern_candidate(
                    local_results[local_result_idx]) or
                    is_runtime_redup_candidate(local_results[local_result_idx]) then
                begin
                    Continue;
                end;

                candidate_text_local := Trim(
                    local_results[local_result_idx].text);
                if get_candidate_text_unit_count(candidate_text_local) <>
                    local_chunk_syllables then
                begin
                    Continue;
                end;
                if not is_valid_cjk_phrase_text_local(candidate_text_local,
                    local_chunk_syllables) then
                begin
                    Continue;
                end;

                raw_weight_local := get_candidate_effective_weight_local(
                    local_results[local_result_idx], local_chunk_syllables);
                exact_bonus_local := get_preferred_exact_subspan_bonus_local(
                    query_key_local, candidate_text_local);
                Inc(raw_weight_local, get_preferred_query_phrase_bonus_local(
                    query_key_local, candidate_text_local));
                if should_skip_weak_fixed_head_exact_local(local_start_idx,
                    local_chunk_syllables, candidate_text_local,
                    raw_weight_local, local_results[local_result_idx].source) then
                begin
                    Continue;
                end;
                Inc(raw_weight_local, exact_bonus_local);
                if (local_chunk_syllables >= 3) and
                    (exact_bonus_local > 0) then
                begin
                    Inc(raw_weight_local, 12000);
                end;
                raw_weight_local := normalize_long_sentence_chunk_weight_local(
                    raw_weight_local, local_chunk_syllables);

                option_idx_local := Length(out_texts);
                SetLength(out_texts, option_idx_local + 1);
                SetLength(out_weights, option_idx_local + 1);
                out_texts[option_idx_local] := candidate_text_local;
                out_weights[option_idx_local] := raw_weight_local;
            end;

            exact_subspan_chunk_cache_texts[local_start_idx][
                local_chunk_syllables] := out_texts;
            exact_subspan_chunk_cache_weights[local_start_idx][
                local_chunk_syllables] := out_weights;
        end;

    begin
        out_text := '';
        out_score := 0;
        out_segments := 0;
        out_path := '';
        out_has_anchor := False;
        out_anchor_units := -1;
        if (span_syllables <= 0) or (span_syllables > c_span_max_syllables) then
        begin
            Exit(False);
        end;
        if (start_idx < 0) or
            (start_idx + span_syllables - 1 >= input_syllable_count) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit(False);
        end;

        prepare_exact_subspan_cache_local;
        if not exact_subspan_cache_prepared then
        begin
            Exit(False);
        end;
        if (start_idx > High(exact_subspan_cache_syllables)) or
            (exact_subspan_cache_states = nil) then
        begin
            Exit(False);
        end;

        if exact_subspan_cache_states[start_idx][span_syllables] = c_state_hit then
        begin
            out_text := exact_subspan_cache_texts[start_idx][span_syllables];
            out_score := exact_subspan_cache_scores[start_idx][span_syllables];
            out_segments := exact_subspan_cache_segments[start_idx][span_syllables];
            out_path := exact_subspan_cache_paths[start_idx][span_syllables];
            out_has_anchor := exact_subspan_cache_has_anchor[start_idx][span_syllables];
            out_anchor_units := exact_subspan_cache_anchor_units[start_idx][span_syllables];
            Exit(True);
        end;
        if exact_subspan_cache_states[start_idx][span_syllables] = c_state_miss then
        begin
            Exit(False);
        end;

        SetLength(best_scores, span_syllables + 1);
        SetLength(best_segments, span_syllables + 1);
        SetLength(best_anchor_units, span_syllables + 1);
        SetLength(best_has_anchor, span_syllables + 1);
        SetLength(best_texts, span_syllables + 1);
        SetLength(best_paths, span_syllables + 1);
        for pos := 0 to span_syllables do
        begin
            best_scores[pos] := Low(Integer);
            best_segments[pos] := MaxInt;
            best_anchor_units[pos] := -1;
            best_has_anchor[pos] := False;
            best_texts[pos] := '';
            best_paths[pos] := '';
        end;
        best_scores[span_syllables] := 0;
        best_segments[span_syllables] := 0;
        best_anchor_units[span_syllables] := -1;
        best_has_anchor[span_syllables] := False;
        best_texts[span_syllables] := '';
        best_paths[span_syllables] := '';

        for pos := span_syllables - 1 downto 0 do
        begin
            global_idx := start_idx + pos;
            fixed_text := get_fixed_boundary_single_char_local(
                exact_subspan_cache_syllables[global_idx].text);
            if (fixed_text <> '') and ((pos + 1 = span_syllables) or
                (best_scores[pos + 1] > Low(Integer))) then
            begin
                if not try_get_exact_single_char_weight_local(global_idx, fixed_text,
                    fixed_weight) then
                begin
                    fixed_weight := 520;
                end;
                Inc(fixed_weight, get_preferred_query_phrase_bonus_local(
                    normalize_pinyin_text(exact_subspan_cache_syllables[global_idx].text),
                    fixed_text));
                try_update_with_candidate(pos, 1, fixed_text,
                    normalize_long_sentence_chunk_weight_local(
                    fixed_weight + c_fixed_single_bonus, 1));
            end;

            if ((pos + 1 = span_syllables) or (best_scores[pos + 1] > Low(Integer))) then
            begin
                collect_exact_single_char_candidates_local(global_idx, 6,
                    single_text_options, single_weight_options);
                for single_option_idx := 0 to High(single_text_options) do
                begin
                    if SameText(single_text_options[single_option_idx], fixed_text) then
                    begin
                        Continue;
                    end;
                    try_update_with_candidate(pos, 1,
                        single_text_options[single_option_idx],
                        normalize_long_sentence_chunk_weight_local(
                        single_weight_options[single_option_idx], 1));
                end;
            end;

            for chunk_syllables := 2 to Min(c_span_max_syllables, span_syllables - pos) do
            begin
                next_pos := pos + chunk_syllables;
                if (next_pos < span_syllables) and
                    (best_scores[next_pos] = Low(Integer)) then
                begin
                    Continue;
                end;

                query_key := build_query_key_local(global_idx, chunk_syllables);
                if query_key = '' then
                begin
                    Continue;
                end;

                preferred_text := '';
                preferred_bonus := 0;
                if try_get_preferred_query_phrase_text_local(query_key, preferred_text,
                    preferred_bonus) and
                    is_valid_cjk_phrase_text_local(preferred_text,
                    chunk_syllables) then
                begin
                    try_update_with_candidate(pos, chunk_syllables, preferred_text,
                        preferred_bonus + 12000);
                end;

                collect_exact_chunk_candidates_local(global_idx,
                    chunk_syllables, chunk_text_options,
                    chunk_weight_options);
                for chunk_option_idx := 0 to High(chunk_text_options) do
                begin
                    try_update_with_candidate(pos, chunk_syllables,
                        chunk_text_options[chunk_option_idx],
                        chunk_weight_options[chunk_option_idx]);
                end;
            end;
        end;

        if (best_scores[0] = Low(Integer)) or (best_texts[0] = '') then
        begin
            store_cache_result_local(start_idx, span_syllables, False, '', 0, 0, '',
                False, -1);
            Exit(False);
        end;
        if try_get_best_direct_exact_candidate_local(start_idx, span_syllables,
            direct_text, direct_score, direct_has_anchor, direct_anchor_units,
            direct_exact_bonus) and
            (direct_text <> '') and
            ((best_segments[0] > 1) or
            ((direct_exact_bonus > 0) and (not SameText(direct_text, best_texts[0])))) then
        begin
            same_first_unit_local := False;
            if span_syllables = 2 then
            begin
                direct_units := split_text_units(direct_text);
                best_units := split_text_units(best_texts[0]);
                same_first_unit_local := (Length(direct_units) > 0) and
                    (Length(best_units) > 0) and
                    SameText(direct_units[0], best_units[0]);
            end;

            if SameText(direct_text, best_texts[0]) then
            begin
                // Keep the DP result when it already resolves to the same text.
            end
            else if (direct_exact_bonus > 0) or
                ((span_syllables = 2) and
                (best_segments[0] > 1) and
                (direct_score >= best_scores[0] - 512) and
                same_first_unit_local) or
                ((best_segments[0] >= 3) and
                (direct_score >= best_scores[0] + 2048)) then
            begin
                best_texts[0] := direct_text;
                best_scores[0] := direct_score;
                best_segments[0] := 1;
                best_has_anchor[0] := direct_has_anchor;
                best_anchor_units[0] := direct_anchor_units;
                best_paths[0] := direct_text;
            end;
        end;
        query_key := build_query_key_local(start_idx, span_syllables);

        boundary_resolved_local := False;
        if span_syllables = 3 then
        begin
            boundary_resolved_local :=
                try_get_best_three_syllable_fixed_boundary_compound_local(
                start_idx, boundary_resolved_text, boundary_resolved_score,
                boundary_resolved_has_anchor, boundary_resolved_anchor_units);
        end;
        if boundary_resolved_local and
            (boundary_resolved_text <> '') then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    Format(' tfix3=[text=%s score=%d]',
                    [boundary_resolved_text, boundary_resolved_score]);
            end;
            current_preferred_bonus_local := 0;
            if (query_key <> '') and (best_texts[0] <> '') then
            begin
                current_preferred_bonus_local :=
                    get_preferred_exact_subspan_bonus_local(query_key,
                    best_texts[0]);
            end;
            boundary_preferred_bonus := 0;
            if query_key <> '' then
            begin
                boundary_preferred_bonus :=
                    get_preferred_exact_subspan_bonus_local(query_key,
                    boundary_resolved_text);
            end;

            if (best_texts[0] = '') or
                SameText(boundary_resolved_text, best_texts[0]) or
                ((best_segments[0] > 1) and
                (boundary_resolved_score >= best_scores[0] - 1024)) or
                ((not best_has_anchor[0]) and
                (boundary_resolved_score >= best_scores[0] - 512)) or
                ((boundary_preferred_bonus > current_preferred_bonus_local) and
                (boundary_resolved_score >= best_scores[0] - 2048)) or
                (boundary_resolved_score > best_scores[0] + 2048) then
            begin
                best_texts[0] := boundary_resolved_text;
                best_scores[0] := Max(best_scores[0], boundary_resolved_score);
                best_segments[0] := 1;
                best_has_anchor[0] := boundary_resolved_has_anchor;
                best_anchor_units[0] := Max(best_anchor_units[0],
                    boundary_resolved_anchor_units);
                best_paths[0] := boundary_resolved_text;
            end;
        end;

        oracle_preferred_text := '';
        oracle_preferred_bonus := 0;
        if query_key <> '' then
        begin
            oracle_preferred_text := '';
            oracle_preferred_bonus := 0;
            try_get_preferred_query_phrase_text_local(query_key,
                oracle_preferred_text, oracle_preferred_bonus);
            standalone_promote_bonus_local := 4096;
            if (span_syllables >= 4) and
                (start_idx + span_syllables >= input_syllable_count - 1) then
            begin
                standalone_promote_bonus_local := 49152;
            end
            else if span_syllables >= 6 then
            begin
                standalone_promote_bonus_local := 32768;
            end
            else if subspan_has_fixed_boundary_local(start_idx, span_syllables) then
            begin
                standalone_promote_bonus_local := 16384;
            end;
            if ((((span_syllables >= 4) and
                (start_idx + span_syllables >= input_syllable_count - 1)) or
                (span_syllables >= 6) or
                subspan_has_fixed_boundary_local(start_idx, span_syllables)) and
                try_get_best_subspan_standalone_query_candidate_local(query_key,
                span_syllables, direct_text, direct_score)) and
                (direct_text <> '') then
            begin
                direct_exact_bonus := get_preferred_exact_subspan_bonus_local(
                    query_key, direct_text);
                oracle_span_quality_local :=
                    get_exact_span_coverage_quality_local(start_idx,
                    span_syllables, direct_text);
                current_span_quality_local :=
                    get_exact_span_coverage_quality_local(start_idx,
                    span_syllables, best_texts[0]);
                if (direct_exact_bonus <= 0) and
                    (current_span_quality_local > 0) and
                    (current_span_quality_local >=
                    oracle_span_quality_local + 1800) then
                begin
                    if m_config.debug_mode then
                    begin
                        m_last_full_path_debug_info :=
                            m_last_full_path_debug_info +
                            Format(' oraclekeep=[curq=%d oraq=%d]',
                            [current_span_quality_local,
                            oracle_span_quality_local]);
                    end;
                end
                else if (best_texts[0] = '') or
                    SameText(direct_text, best_texts[0]) or
                    (direct_exact_bonus > 0) or
                    (best_segments[0] > 1) or
                    ((span_syllables >= 4) and
                    (direct_score + standalone_promote_bonus_local >=
                    best_scores[0] - 512)) or
                    (direct_score + standalone_promote_bonus_local >=
                    best_scores[0] + 512) or
                    ((not best_has_anchor[0]) and
                    (direct_score + standalone_promote_bonus_local >=
                    best_scores[0] - 1024)) then
                begin
                    best_texts[0] := direct_text;
                    best_scores[0] := Max(best_scores[0],
                        direct_score + standalone_promote_bonus_local);
                    best_segments[0] := 1;
                    best_has_anchor[0] := True;
                    best_anchor_units[0] := span_syllables;
                    best_paths[0] := direct_text;
                end;
            end;
        end;

        out_text := best_texts[0];
        out_score := best_scores[0];
        out_segments := best_segments[0];
        out_path := best_paths[0];
        out_has_anchor := best_has_anchor[0];
        out_anchor_units := best_anchor_units[0];
        store_cache_result_local(start_idx, span_syllables, True, out_text, out_score,
            out_segments, out_path, out_has_anchor, out_anchor_units);
        Result := True;
    end;

    procedure promote_preferred_query_phrase_candidate_for_query(
        const query_key: string; var candidates: TncCandidateList);
    var
        idx: Integer;
        best_idx: Integer;
        best_bonus: Integer;
        current_top_bonus: Integer;
        best_is_complete: Boolean;
        current_is_complete: Boolean;
        tmp: TncCandidate;
        candidate_text: string;
        preferred_text: string;
        preferred_bonus: Integer;
        preferred_units: TArray<string>;
        query_syllables: TncPinyinParseResult;
        can_insert_preferred: Boolean;
    begin
        if (Length(candidates) = 0) or (query_key = '') then
        begin
            Exit;
        end;

        preferred_text := '';
        preferred_bonus := 0;
        query_syllables := get_effective_compact_pinyin_syllables(query_key);
        can_insert_preferred :=
            try_get_preferred_query_phrase_text_local(query_key,
            preferred_text, preferred_bonus);
        if can_insert_preferred then
        begin
            preferred_units := split_text_units(preferred_text);
            can_insert_preferred :=
                (Length(query_syllables) > 0) and
                (Length(preferred_units) = Length(query_syllables)) and
                is_full_pinyin_key(query_key);
        end;

        best_idx := -1;
        best_bonus := 0;
        best_is_complete := False;
        current_top_bonus := get_preferred_query_phrase_bonus_local(query_key,
            Trim(candidates[0].text));

        for idx := 0 to High(candidates) do
        begin
            if Trim(candidates[idx].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text := Trim(candidates[idx].text);
            if candidate_text = '' then
            begin
                Continue;
            end;

            current_is_complete := Pos('/', candidate_text) = 0;
            if idx = 0 then
            begin
                best_is_complete := current_is_complete;
            end;

            if get_preferred_query_phrase_bonus_local(query_key, candidate_text) >
                best_bonus then
            begin
                best_idx := idx;
                best_bonus := get_preferred_query_phrase_bonus_local(query_key,
                    candidate_text);
                best_is_complete := current_is_complete;
                Continue;
            end;

            if (best_idx >= 0) and
                (get_preferred_query_phrase_bonus_local(query_key, candidate_text) =
                best_bonus) and (best_bonus > 0) then
            begin
                if current_is_complete and (not best_is_complete) then
                begin
                    best_idx := idx;
                    best_is_complete := True;
                end
                else if current_is_complete = best_is_complete then
                begin
                    if get_candidate_text_unit_count(candidate_text) >
                        get_candidate_text_unit_count(Trim(candidates[best_idx].text)) then
                    begin
                        best_idx := idx;
                    end;
                end;
            end;
        end;

        if (best_idx < 0) and can_insert_preferred and (preferred_bonus > 0) then
        begin
            if SameText(Trim(candidates[0].text), preferred_text) then
            begin
                Exit;
            end;

            FillChar(tmp, SizeOf(tmp), 0);
            tmp.text := preferred_text;
            tmp.comment := '';
            tmp.source := cs_rule;
            tmp.has_dict_weight := False;
            tmp.dict_weight := 0;
            tmp.score := Max(candidates[0].score + 2048,
                preferred_bonus + 50000);

            SetLength(candidates, Length(candidates) + 1);
            for idx := High(candidates) downto 1 do
            begin
                candidates[idx] := candidates[idx - 1];
            end;
            candidates[0] := tmp;
            Exit;
        end;

        if (best_idx <= 0) or (best_bonus <= 0) then
        begin
            Exit;
        end;

        if best_bonus < current_top_bonus then
        begin
            Exit;
        end;

        tmp := candidates[best_idx];
        for idx := best_idx downto 1 do
        begin
            candidates[idx] := candidates[idx - 1];
        end;
        candidates[0] := tmp;
    end;

    function should_use_delayed_long_decode_mode_local: Boolean;
    begin
        Result := m_config.enable_segment_candidates and has_multi_syllable_input and
            (input_syllable_count >= c_long_sentence_full_path_min_syllables) and
            (not all_initial_compact_query) and
            (not has_internal_dangling_initial) and
            (not has_explicit_apostrophe_input);
    end;

    function has_extendable_same_syllable_tail_local(const pinyin_key: string;
        const expected_syllable_count: Integer): Boolean;
    var
        suffix_ch: Char;
        extended_key: string;
    begin
        Result := False;
        if extendable_same_tail_cache_valid and
            SameText(extendable_same_tail_cache_key, pinyin_key) and
            (extendable_same_tail_cache_expected_count = expected_syllable_count) then
        begin
            Exit(extendable_same_tail_cache_value);
        end;

        extendable_same_tail_cache_valid := True;
        extendable_same_tail_cache_key := pinyin_key;
        extendable_same_tail_cache_expected_count := expected_syllable_count;
        extendable_same_tail_cache_value := False;

        if (pinyin_key = '') or (expected_syllable_count < 4) then
        begin
            Exit;
        end;

        for suffix_ch := 'a' to 'z' do
        begin
            extended_key := pinyin_key + suffix_ch;
            if get_effective_compact_pinyin_unit_count(extended_key) =
                expected_syllable_count then
            begin
                extendable_same_tail_cache_value := True;
                Exit(True);
            end;
        end;
    end;

    function has_precise_extendable_tail_syllable_local(
        const pinyin_key: string): Boolean;
    var
        syllables_local: TncPinyinParseResult;
        tail_text_local: string;
        suffix_ch_local: Char;
        extended_tail_local: string;
    begin
        Result := False;
        if (pinyin_key = '') or (not is_full_pinyin_key(pinyin_key)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(pinyin_key);
        if Length(syllables_local) = 0 then
        begin
            Exit;
        end;

        tail_text_local := normalize_pinyin_text(
            syllables_local[High(syllables_local)].text);
        if tail_text_local = '' then
        begin
            Exit;
        end;

        for suffix_ch_local := 'a' to 'z' do
        begin
            extended_tail_local := tail_text_local + suffix_ch_local;
            if is_full_pinyin_key(extended_tail_local) and
                (get_effective_compact_pinyin_unit_count(
                extended_tail_local) = 1) then
            begin
                Exit(True);
            end;
        end;
    end;

    function has_short_extendable_tail_prefix_local: Boolean;
    var
        syllables_local: TncPinyinParseResult;
        tail_text_local: string;
        suffix_ch_local: Char;
        extended_key_local: string;
    begin
        Result := False;
        if short_extendable_tail_cache_valid then
        begin
            Exit(short_extendable_tail_cache_value);
        end;

        short_extendable_tail_cache_valid := True;
        short_extendable_tail_cache_value := False;

        if has_safe_trailing_initial_typing_state then
        begin
            short_extendable_tail_cache_value := True;
            Exit(True);
        end;

        if (not is_full_pinyin_key(lookup_text)) or
            (lookup_text = '') then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) <= 0 then
        begin
            Exit;
        end;

        tail_text_local := normalize_pinyin_text(
            syllables_local[High(syllables_local)].text);
        if (tail_text_local = '') or (Length(tail_text_local) > 2) then
        begin
            Exit;
        end;

        for suffix_ch_local := 'a' to 'z' do
        begin
            extended_key_local := lookup_text + suffix_ch_local;
            if get_effective_compact_pinyin_unit_count(extended_key_local) =
                Length(syllables_local) then
            begin
                short_extendable_tail_cache_value := True;
                Exit(True);
            end;
        end;
    end;

    function has_complete_exact_tail_phrase_local(
        const tail_syllable_count: Integer): Boolean;
    const
        c_min_tail_exact_weight_for_no_defer = 700;
    var
        syllables_local: TncPinyinParseResult;
        tail_key_local: string;
        idx_local: Integer;
        exact_results_local: TncCandidateList;
        result_idx_local: Integer;
        candidate_text_local: string;
        candidate_weight_local: Integer;
    begin
        Result := False;
        if (m_dictionary = nil) or (tail_syllable_count < 2) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < tail_syllable_count then
        begin
            Exit;
        end;

        tail_key_local := '';
        for idx_local := Length(syllables_local) - tail_syllable_count to
            High(syllables_local) do
        begin
            tail_key_local := tail_key_local +
                normalize_pinyin_text(syllables_local[idx_local].text);
        end;
        if tail_key_local = '' then
        begin
            Exit;
        end;

        if not lookup_exact_full_pinyin_cached_local(tail_key_local,
            exact_results_local) then
        begin
            Exit;
        end;

        for result_idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[result_idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(exact_results_local[result_idx_local].text);
            if (candidate_text_local <> '') and
                (get_candidate_text_unit_count(candidate_text_local) =
                tail_syllable_count) then
            begin
                if (not m_dictionary.is_base_entry(tail_key_local,
                    candidate_text_local)) and
                    (not m_dictionary.is_user_entry(tail_key_local,
                    candidate_text_local)) then
                begin
                    Continue;
                end;
                if is_problematic_single_char_chain_candidate_for_query(
                    tail_key_local, exact_results_local[result_idx_local]) then
                begin
                    Continue;
                end;
                candidate_weight_local := exact_results_local[result_idx_local].score;
                if exact_results_local[result_idx_local].has_dict_weight and
                    (exact_results_local[result_idx_local].dict_weight >
                    candidate_weight_local) then
                begin
                    candidate_weight_local :=
                        exact_results_local[result_idx_local].dict_weight;
                end;
                if candidate_weight_local >= c_min_tail_exact_weight_for_no_defer then
                begin
                    Exit(True);
                end;
            end;
        end;
    end;

    function is_place_context_tail_unit_local(
        const unit_value_local: string): Boolean;
    begin
        Result := False;
        if Length(unit_value_local) <> 1 then
        begin
            Exit;
        end;
        case Ord(unit_value_local[1]) of
            $5BB6, $5E97, $5C4B, $697C, $57CE, $6751, $53BF, $5E02,
            $6821, $9662, $5382, $9986, $7AD9, $5C40, $6240, $56ED,
            $533A, $5708, $8DEF, $8857, $95E8, $5BA4, $623F, $5385,
            $573A, $53F8:
                Result := True;
        end;
    end;

    function has_contextual_directional_exact_tail_candidate_local: Boolean;
    const
        c_context_probe_limit = 8;
    var
        syllables_local: TncPinyinParseResult;
        tail_key_local: string;
        tail_results_local: TncCandidateList;
        result_idx_local: Integer;
        candidate_text_local: string;
        has_directional_tail_local: Boolean;
        back_len_local: Integer;
        context_key_local: string;
        context_results_local: TncCandidateList;
        context_text_local: string;
        context_units_local: TArray<string>;
        context_idx_local: Integer;
        syllable_idx_local: Integer;

        function is_directional_locative_text_local(
            const text_value_local: string): Boolean;
        var
            units_local: TArray<string>;
            head_unit_local: string;
            tail_unit_local: string;
        begin
            Result := False;
            units_local := split_text_units(Trim(text_value_local));
            if Length(units_local) <> 2 then
            begin
                Exit;
            end;
            head_unit_local := units_local[0];
            tail_unit_local := units_local[1];
            Result := ((head_unit_local = string(Char($4E1C))) or
                (head_unit_local = string(Char($5357))) or
                (head_unit_local = string(Char($897F))) or
                (head_unit_local = string(Char($5317))) or
                (head_unit_local = string(Char($4E0A))) or
                (head_unit_local = string(Char($4E0B))) or
                (head_unit_local = string(Char($524D))) or
                (head_unit_local = string(Char($540E))) or
                (head_unit_local = string(Char($91CC))) or
                (head_unit_local = string(Char($5916))) or
                (head_unit_local = string(Char($5DE6))) or
                (head_unit_local = string(Char($53F3)))) and
                ((tail_unit_local = string(Char($9762))) or
                (tail_unit_local = string(Char($8FB9))) or
                (tail_unit_local = string(Char($65B9))) or
                (tail_unit_local = string(Char($4FA7))) or
                (tail_unit_local = string(Char($90E8))));
        end;
    begin
        Result := False;
        if (m_dictionary = nil) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;
        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < 3 then
        begin
            Exit;
        end;

        tail_key_local := '';
        for syllable_idx_local := Length(syllables_local) - 2 to
            High(syllables_local) do
        begin
            tail_key_local := tail_key_local + normalize_pinyin_text(
                syllables_local[syllable_idx_local].text);
        end;
        if (tail_key_local = '') or
            (not lookup_exact_full_pinyin_cached_local(tail_key_local,
            tail_results_local)) then
        begin
            Exit;
        end;

        has_directional_tail_local := False;
        for result_idx_local := 0 to Min(c_context_probe_limit - 1,
            High(tail_results_local)) do
        begin
            candidate_text_local := Trim(tail_results_local[result_idx_local].text);
            if (Trim(tail_results_local[result_idx_local].comment) = '') and
                (get_candidate_text_unit_count(candidate_text_local) = 2) and
                is_directional_locative_text_local(candidate_text_local) then
            begin
                has_directional_tail_local := True;
                Break;
            end;
        end;
        if not has_directional_tail_local then
        begin
            Exit;
        end;

        for back_len_local := 1 to Min(4, Length(syllables_local) - 2) do
        begin
            context_key_local := '';
            for syllable_idx_local := Length(syllables_local) - 2 -
                back_len_local to Length(syllables_local) - 3 do
            begin
                context_key_local := context_key_local + normalize_pinyin_text(
                    syllables_local[syllable_idx_local].text);
            end;
            if (context_key_local = '') or
                (not lookup_exact_full_pinyin_cached_local(context_key_local,
                context_results_local)) then
            begin
                Continue;
            end;
            for context_idx_local := 0 to Min(c_context_probe_limit - 1,
                High(context_results_local)) do
            begin
                if Trim(context_results_local[context_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                context_text_local := Trim(
                    context_results_local[context_idx_local].text);
                context_units_local := split_text_units(context_text_local);
                if (Length(context_units_local) > 0) and
                    is_place_context_tail_unit_local(
                    context_units_local[High(context_units_local)]) then
                begin
                    Exit(True);
                end;
            end;
        end;
    end;

    function has_reliable_exact_tail_candidate_local(
        const tail_syllable_count: Integer): Boolean;
    const
        c_min_reliable_tail_weight = 560;
    var
        syllables_local: TncPinyinParseResult;
        tail_key_local: string;
        idx_local: Integer;
        exact_results_local: TncCandidateList;
        result_idx_local: Integer;
        candidate_text_local: string;
        candidate_weight_local: Integer;
    begin
        Result := False;
        if (m_dictionary = nil) or (tail_syllable_count < 2) or
            (tail_syllable_count > 4) or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < tail_syllable_count then
        begin
            Exit;
        end;

        tail_key_local := '';
        for idx_local := Length(syllables_local) - tail_syllable_count to
            High(syllables_local) do
        begin
            tail_key_local := tail_key_local + normalize_pinyin_text(
                syllables_local[idx_local].text);
        end;
        if (tail_key_local = '') or
            (not lookup_exact_full_pinyin_cached_local(tail_key_local,
            exact_results_local)) then
        begin
            Exit;
        end;

        for result_idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[result_idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(
                exact_results_local[result_idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                tail_syllable_count) then
            begin
                Continue;
            end;
            candidate_weight_local := exact_results_local[result_idx_local].score;
            if exact_results_local[result_idx_local].has_dict_weight and
                (exact_results_local[result_idx_local].dict_weight >
                candidate_weight_local) then
            begin
                candidate_weight_local :=
                    exact_results_local[result_idx_local].dict_weight;
            end;
            Inc(candidate_weight_local, get_preferred_query_phrase_bonus_local(
                tail_key_local, candidate_text_local));
            if candidate_weight_local >= c_min_reliable_tail_weight then
            begin
                Exit(True);
            end;
        end;
    end;

    function has_preferred_tail_phrase_local(
        const tail_syllable_count: Integer): Boolean;
    var
        syllables_local: TncPinyinParseResult;
        tail_key_local: string;
        idx_local: Integer;
        preferred_text_local: string;
        preferred_bonus_local: Integer;
    begin
        Result := False;
        if (tail_syllable_count < 2) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        if Length(syllables_local) < tail_syllable_count then
        begin
            Exit;
        end;

        tail_key_local := '';
        for idx_local := Length(syllables_local) - tail_syllable_count to
            High(syllables_local) do
        begin
            tail_key_local := tail_key_local +
                normalize_pinyin_text(syllables_local[idx_local].text);
        end;

        Result := (tail_key_local <> '') and
            try_get_preferred_query_phrase_text_local(tail_key_local,
            preferred_text_local, preferred_bonus_local) and
            (Length(split_text_units(preferred_text_local)) =
            tail_syllable_count);
    end;

    function should_defer_exact_chain_for_extendable_tail_local: Boolean;
    begin
        // A previously validated full query is not an unfinished-tail guess.
        // Rebuild and revalidate it when backspace/retyping returns to that query.
        Result := has_multi_syllable_input and (input_syllable_count >= 7) and
            is_full_pinyin_key(lookup_text) and (not all_initial_compact_query) and
            (not has_internal_dangling_initial) and
            (has_short_extendable_tail_prefix_local or
            has_extendable_same_syllable_tail_local(lookup_text,
            input_syllable_count)) and
            (not has_preferred_tail_phrase_local(2)) and
            (not has_complete_exact_tail_phrase_local(2)) and
            (not has_preferred_tail_phrase_local(3)) and
            (not has_complete_exact_tail_phrase_local(3));
    end;

    function has_complete_top_candidate_for_fast_exit_local(
        const candidates: TncCandidateList): Boolean;
    var
        candidate_text: string;
        candidate_path: string;
        top_candidate_local: TncCandidate;
        support_score_local: Integer;
        support_segments_local: Integer;
        inferred_path_local: string;
    begin
        Result := False;
        if (Length(candidates) = 0) or (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        if Trim(candidates[0].comment) <> '' then
        begin
            Exit;
        end;

        candidate_text := Trim(candidates[0].text);
        if (candidate_text = '') or
            (get_candidate_text_unit_count(candidate_text) <> input_syllable_count) then
        begin
            Exit;
        end;

        if input_syllable_count <= 4 then
        begin
            Exit(True);
        end;

        top_candidate_local := candidates[0];
        if is_problematic_single_char_chain_candidate_for_query(lookup_text,
            top_candidate_local) then
        begin
            Exit(False);
        end;

        if top_candidate_local.source = cs_user then
        begin
            Exit(True);
        end;

        if (m_dictionary <> nil) and
            m_dictionary.is_base_entry(lookup_text, candidate_text) then
        begin
            Exit(True);
        end;

        candidate_path := Trim(get_segment_path_for_candidate(top_candidate_local));
        if input_syllable_count >= 8 then
        begin
            inferred_path_local := infer_segment_path_for_query_text_with_score(
                lookup_text, candidate_text, support_score_local,
                support_segments_local);
            Exit(((inferred_path_local <> '') and (support_segments_local > 1) and
                (support_score_local > -960)) or
                ((candidate_path <> '') and
                (get_encoded_path_segment_count_local(candidate_path) > 1)));
        end;

        Result := (candidate_path <> '') and
            (Pos(c_segment_path_separator, candidate_path) > 0);
    end;

    function top_candidate_has_natural_complete_segment_path_local(
        const candidates: TncCandidateList): Boolean;
    var
        top_candidate_local: TncCandidate;
        candidate_text: string;
        encoded_path: string;
        support_score_local: Integer;
        support_segments_local: Integer;
        inferred_path_local: string;
    begin
        Result := False;
        if (Length(candidates) = 0) or
            (Trim(candidates[0].comment) <> '') then
        begin
            Exit;
        end;

        top_candidate_local := candidates[0];
        candidate_text := Trim(candidates[0].text);
        if (candidate_text = '') or
            (get_candidate_text_unit_count(candidate_text) <> input_syllable_count) then
        begin
            Exit;
        end;

        if is_problematic_single_char_chain_candidate_for_query(lookup_text,
            top_candidate_local) then
        begin
            Exit;
        end;

        if top_candidate_local.source = cs_user then
        begin
            Exit(True);
        end;

        if (m_dictionary <> nil) and
            m_dictionary.is_base_entry(lookup_text, candidate_text) then
        begin
            Exit(True);
        end;

        encoded_path := get_segment_path_for_candidate(candidates[0]);
        if (Trim(encoded_path) <> '') and
            (get_encoded_path_segment_count_local(encoded_path) > 1) then
        begin
            Exit(True);
        end;

        inferred_path_local := infer_segment_path_for_query_text_with_score(
            lookup_text, candidate_text, support_score_local,
            support_segments_local);
        if inferred_path_local = '' then
        begin
            Exit(False);
        end;

        if input_syllable_count <= 4 then
        begin
            Exit(support_score_local > -960);
        end;

        Result := (support_segments_local > 1) and
            (support_score_local > -960);
    end;

    function top_partial_tail_has_multi_syllable_local(
        const candidates: TncCandidateList): Boolean;
    var
        tail_key_local: string;
    begin
        Result := False;
        if Length(candidates) = 0 then
        begin
            Exit;
        end;

        tail_key_local := normalize_pinyin_text(Trim(candidates[0].comment));
        Result := (tail_key_local <> '') and
            (get_effective_compact_pinyin_unit_count(tail_key_local) >= 2);
    end;

    function top_candidate_is_stable_non_modal_partial_local(
        const candidates: TncCandidateList): Boolean;
    var
        top_text_local: string;
        top_comment_local: string;
        text_units_local: Integer;
        comment_units_local: Integer;

        function is_modal_tail_key_local(const value: string): Boolean;
        begin
            Result := (value = 'ba') or (value = 'ma') or
                (value = 'ne') or (value = 'a') or
                (value = 'ya') or (value = 'la') or
                (value = 'le') or (value = 'wa');
        end;
    begin
        Result := False;
        if Length(candidates) = 0 then
        begin
            Exit;
        end;

        top_text_local := Trim(candidates[0].text);
        top_comment_local := normalize_pinyin_text(Trim(candidates[0].comment));
        if (top_text_local = '') or (top_comment_local = '') or
            is_modal_tail_key_local(top_comment_local) then
        begin
            Exit;
        end;

        text_units_local := get_candidate_text_unit_count(top_text_local);
        comment_units_local := get_effective_compact_pinyin_unit_count(top_comment_local);
        Result := (text_units_local >= 2) and (comment_units_local > 0) and
            (text_units_local + comment_units_local = input_syllable_count);
    end;

    procedure filter_overlong_partial_candidates_for_current_query(
        var candidates: TncCandidateList);
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_text_local: string;
    begin
        if (Length(candidates) = 0) or (input_syllable_count <= 0) then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(candidates) do
        begin
            candidate_text_local := Trim(candidates[in_idx_local].text);
            if (Trim(candidates[in_idx_local].comment) <> '') and
                (candidate_text_local <> '') and
                (get_candidate_text_unit_count(candidate_text_local) >
                input_syllable_count) then
            begin
                Continue;
            end;

            if out_idx_local <> in_idx_local then
            begin
                candidates[out_idx_local] := candidates[in_idx_local];
            end;
            Inc(out_idx_local);
        end;
        SetLength(candidates, out_idx_local);
    end;

    procedure filter_single_char_partial_candidates_for_current_query(
        var candidates: TncCandidateList);
    const
        c_min_phrase_prefix_weight = 500;
    var
        in_idx_local: Integer;
        out_idx_local: Integer;
        candidate_text_local: string;
        candidate_units_local: Integer;
        candidate_weight_local: Integer;

        function is_normalized_learned_exact_prefix_local(
            const candidate_value: TncCandidate): Boolean;
        var
            full_key, tail_key, head_key: string;
            exact_results: TncCandidateList;
            exact_candidate: TncCandidate;
        begin
            Result := False;
            if (candidate_value.source <> cs_rule) or
                (not candidate_value.has_dict_weight) then Exit;
            full_key := normalize_pinyin_text(lookup_text);
            tail_key := normalize_pinyin_text(candidate_value.comment);
            if (tail_key = '') or (Length(tail_key) >= Length(full_key)) or
                (Copy(full_key, Length(full_key) - Length(tail_key) + 1,
                MaxInt) <> tail_key) then Exit;
            head_key := Copy(full_key, 1, Length(full_key) - Length(tail_key));
            if (not lookup_exact_full_pinyin_cached_local(head_key, exact_results)) or
                (not normalize_learned_prefix_exact_scores(head_key, exact_results)) then Exit;
            for exact_candidate in exact_results do
                if (exact_candidate.source = cs_rule) and
                    (exact_candidate.comment = '') and
                    (exact_candidate.text = candidate_value.text) then Exit(True);
        end;
    begin
        if Length(candidates) = 0 then
        begin
            Exit;
        end;

        out_idx_local := 0;
        for in_idx_local := 0 to High(candidates) do
        begin
            candidate_text_local := Trim(candidates[in_idx_local].text);
            if (Trim(candidates[in_idx_local].comment) <> '') and
                (candidate_text_local <> '') then
            begin
                candidate_units_local :=
                    get_candidate_text_unit_count(candidate_text_local);
                if candidate_units_local < 2 then
                begin
                    Continue;
                end;

                candidate_weight_local := candidates[in_idx_local].score;
                if candidates[in_idx_local].has_dict_weight then
                begin
                    candidate_weight_local :=
                        candidates[in_idx_local].dict_weight;
                end;
                if (candidates[in_idx_local].source <> cs_user) and
                    (candidate_weight_local < c_min_phrase_prefix_weight) and
                    // This cutoff historically used retrieval bonuses. A raw
                    // learned-prefix weight must not erase an admitted exact.
                    (not is_normalized_learned_exact_prefix_local(
                    candidates[in_idx_local])) then
                begin
                    Continue;
                end;
            end;

            if out_idx_local <> in_idx_local then
            begin
                candidates[out_idx_local] := candidates[in_idx_local];
            end;
            Inc(out_idx_local);
        end;
        SetLength(candidates, out_idx_local);
    end;

    function has_full_query_exact_complete_candidate_local: Boolean;
    var
        exact_results_local: TncCandidateList;
        idx_local: Integer;
        text_local: string;
    begin
        Result := False;
        if (m_dictionary = nil) or (lookup_text = '') or
            (not is_full_pinyin_key(lookup_text)) then
        begin
            Exit;
        end;

        if not lookup_exact_full_pinyin_cached_local(lookup_text,
            exact_results_local) then
        begin
            Exit;
        end;

        for idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            text_local := Trim(exact_results_local[idx_local].text);
            if (text_local <> '') and
                (get_candidate_text_unit_count(text_local) =
                input_syllable_count) then
            begin
                Exit(True);
            end;
        end;
    end;

    function has_strong_full_query_exact_complete_candidate_local: Boolean;
    const
        c_min_strong_complete_weight = 700;
    var
        exact_results_local: TncCandidateList;
        idx_local: Integer;
        text_local: string;
        candidate_weight_local: Integer;
    begin
        Result := False;
        if (m_dictionary = nil) or (lookup_text = '') then
        begin
            Exit;
        end;

        if not lookup_exact_full_pinyin_cached_local(lookup_text,
            exact_results_local) then
        begin
            Exit;
        end;

        for idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            text_local := Trim(exact_results_local[idx_local].text);
            if (text_local = '') or
                (get_candidate_text_unit_count(text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;
            if (not m_dictionary.is_base_entry(lookup_text, text_local)) and
                (not m_dictionary.is_user_entry(lookup_text, text_local)) then
            begin
                Continue;
            end;

            candidate_weight_local := exact_results_local[idx_local].score;
            if exact_results_local[idx_local].has_dict_weight and
                (exact_results_local[idx_local].dict_weight >
                candidate_weight_local) then
            begin
                candidate_weight_local := exact_results_local[idx_local].dict_weight;
            end;
            if candidate_weight_local >= c_min_strong_complete_weight then
            begin
                Exit(True);
            end;
        end;
    end;

    function try_get_best_complete_exact_candidate_local(
        const candidates: TncCandidateList; out out_candidate: TncCandidate): Boolean;
    var
        idx_local: Integer;
        best_idx_local: Integer;
        best_score_local: Integer;
        candidate_score_local: Integer;
        candidate_text_local: string;
    begin
        Result := False;
        best_idx_local := -1;
        best_score_local := Low(Integer);
        for idx_local := 0 to High(candidates) do
        begin
            if Trim(candidates[idx_local].comment) <> '' then
            begin
                Continue;
            end;

            candidate_text_local := Trim(candidates[idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;

            candidate_score_local := candidates[idx_local].score;
            if candidates[idx_local].has_dict_weight and
                (candidates[idx_local].dict_weight > candidate_score_local) then
            begin
                candidate_score_local := candidates[idx_local].dict_weight;
            end;

            if (best_idx_local < 0) or
                (candidate_score_local > best_score_local) then
            begin
                best_idx_local := idx_local;
                best_score_local := candidate_score_local;
            end;
        end;

        if best_idx_local >= 0 then
        begin
            out_candidate := candidates[best_idx_local];
            Result := True;
        end;
    end;

    procedure promote_candidate_to_front_local(var candidates: TncCandidateList;
        const preferred_candidate: TncCandidate);
    var
        idx_local: Integer;
        target_idx_local: Integer;
        front_candidate_local: TncCandidate;
    begin
        if Length(candidates) = 0 then
        begin
            SetLength(candidates, 1);
            candidates[0] := preferred_candidate;
            Exit;
        end;

        target_idx_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if SameText(Trim(candidates[idx_local].text),
                Trim(preferred_candidate.text)) and
                SameText(Trim(candidates[idx_local].comment),
                Trim(preferred_candidate.comment)) then
            begin
                target_idx_local := idx_local;
                Break;
            end;
        end;

        if target_idx_local = 0 then
        begin
            Exit;
        end;

        if target_idx_local > 0 then
        begin
            front_candidate_local := candidates[0];
            candidates[0] := candidates[target_idx_local];
            candidates[target_idx_local] := front_candidate_local;
            Exit;
        end;

        SetLength(candidates, Length(candidates) + 1);
        for idx_local := High(candidates) downto 1 do
        begin
            candidates[idx_local] := candidates[idx_local - 1];
        end;
        candidates[0] := preferred_candidate;
    end;

    function get_directional_locative_span_bonus_local(const text_value: string): Integer;
    const
        c_directional_locative_bonus = 180;
    var
        units_local: TArray<string>;
        head_unit_local: string;
        tail_unit_local: string;
        function is_direction_unit_local(const unit_value: string): Boolean;
        begin
            Result := (unit_value = string(Char($4E1C))) or
                (unit_value = string(Char($5357))) or
                (unit_value = string(Char($897F))) or
                (unit_value = string(Char($5317))) or
                (unit_value = string(Char($4E0A))) or
                (unit_value = string(Char($4E0B))) or
                (unit_value = string(Char($524D))) or
                (unit_value = string(Char($540E))) or
                (unit_value = string(Char($91CC))) or
                (unit_value = string(Char($5916))) or
                (unit_value = string(Char($5DE6))) or
                (unit_value = string(Char($53F3)));
        end;
        function is_locative_tail_unit_local(const unit_value: string): Boolean;
        begin
            Result := (unit_value = string(Char($9762))) or
                (unit_value = string(Char($8FB9))) or
                (unit_value = string(Char($65B9))) or
                (unit_value = string(Char($4FA7))) or
                (unit_value = string(Char($90E8)));
        end;
    begin
        Result := 0;
        units_local := split_text_units(Trim(text_value));
        if Length(units_local) <> 2 then
        begin
            Exit;
        end;

        head_unit_local := Trim(units_local[0]);
        tail_unit_local := Trim(units_local[1]);
        if is_direction_unit_local(head_unit_local) and
            is_locative_tail_unit_local(tail_unit_local) then
        begin
            Result := c_directional_locative_bonus;
        end;
    end;

    procedure promote_multi_syllable_partial_without_full_exact_local(
        var candidates: TncCandidateList);
    const
        c_strong_partial_head_weight = 900;
    var
        idx_local: Integer;
        move_idx_local: Integer;
        tail_key_local: string;
        head_weight_local: Integer;
        picked_local: TncCandidate;
    begin
        if (Length(candidates) <= 1) or
            has_full_query_exact_complete_candidate_local then
        begin
            Exit;
        end;

        for idx_local := 0 to High(candidates) do
        begin
            tail_key_local := normalize_pinyin_text(
                Trim(candidates[idx_local].comment));
            if (tail_key_local = '') or
                (get_effective_compact_pinyin_unit_count(tail_key_local) < 2) or
                (get_candidate_text_unit_count(Trim(candidates[idx_local].text)) < 2) then
            begin
                Continue;
            end;

            if candidates[idx_local].has_dict_weight then
            begin
                head_weight_local := candidates[idx_local].dict_weight;
            end
            else
            begin
                head_weight_local := candidates[idx_local].score;
            end;
            if head_weight_local >= c_strong_partial_head_weight then
            begin
                Continue;
            end;

            if idx_local = 0 then
            begin
                Exit;
            end;

            picked_local := candidates[idx_local];
            for move_idx_local := idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_local;
            Exit;
        end;
    end;

    procedure promote_full_query_exact_complete_phrase_local(
        var candidates: TncCandidateList);
    var
        exact_results_local: TncCandidateList;
        idx_local: Integer;
        best_idx_local: Integer;
        best_weight_local: Integer;
        best_visible_idx_local: Integer;
        best_visible_weight_local: Integer;
        candidate_text_local: string;
        candidate_weight_local: Integer;
        existing_idx_local: Integer;
        move_idx_local: Integer;
        picked_local: TncCandidate;
        normalized_query_local: string;
        latest_choice_text_local: string;
        query_syllables_local: TncPinyinParseResult;

        function get_exact_candidate_weight_local(
            const candidate: TncCandidate; const candidate_text: string): Integer;
        var
            choice_bonus_local: Integer;
        begin
            if candidate.has_dict_weight then
            begin
                Result := candidate.dict_weight;
            end
            else
            begin
                Result := candidate.score;
            end;

            if Result < 0 then
            begin
                Result := 0;
            end;

            choice_bonus_local := get_session_query_bonus(candidate_text);
            if (normalized_query_local <> '') and (m_dictionary <> nil) then
            begin
                choice_bonus_local := Max(choice_bonus_local,
                    m_dictionary.get_query_choice_bonus(normalized_query_local,
                    candidate_text));
            end;

            if choice_bonus_local > 0 then
            begin
                Inc(Result, 50000 + (choice_bonus_local * 20));
            end;
            if is_latest_session_query_choice(candidate_text) or
                ((latest_choice_text_local <> '') and SameText(candidate_text,
                latest_choice_text_local)) then
            begin
                Inc(Result, 200000);
            end;

            if candidate.source = cs_user then
            begin
                Inc(Result, 2048);
            end;
        end;

        function get_visible_candidate_weight_local(
            const candidate: TncCandidate): Integer;
        begin
            Result := get_rank_score(candidate);
            Inc(Result, Max(0, get_segment_path_support_score(candidate)));
            Inc(Result, Max(0, get_candidate_path_confidence_score(candidate)) * 32);
        end;

        function build_segment_query_key_local(const segment_start: Integer;
            const segment_units: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            if (segment_start < 0) or (segment_units <= 0) or
                (segment_start + segment_units > Length(query_syllables_local)) then
            begin
                Exit;
            end;

            for syllable_idx_local := segment_start to
                segment_start + segment_units - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    query_syllables_local[syllable_idx_local].text);
            end;
        end;

        function segment_text_is_visible_primary_local(
            const query_key_value: string; const segment_text_value: string;
            const segment_units_value: Integer): Boolean;
        var
            lookup_results_local: TncCandidateList;
            lookup_idx_local: Integer;
            lookup_text_local: string;
        begin
            Result := True;
            if (query_key_value = '') or (segment_text_value = '') or
                (segment_units_value <= 1) or (m_dictionary = nil) or
                (not m_dictionary.lookup(query_key_value, lookup_results_local)) then
            begin
                Exit;
            end;

            for lookup_idx_local := 0 to High(lookup_results_local) do
            begin
                if Trim(lookup_results_local[lookup_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                lookup_text_local := Trim(
                    lookup_results_local[lookup_idx_local].text);
                if (lookup_text_local = '') or
                    (get_candidate_text_unit_count(lookup_text_local) <>
                    segment_units_value) then
                begin
                    Continue;
                end;
                Exit(SameText(lookup_text_local, segment_text_value));
            end;
        end;

        function path_has_nonprimary_multi_char_segment_local(
            const encoded_path_value: string): Boolean;
        var
            path_parts_local: TArray<string>;
            part_idx_local: Integer;
            segment_start_local: Integer;
            segment_units_local: Integer;
            segment_text_local: string;
            query_key_local: string;
        begin
            Result := False;
            if (encoded_path_value = '') or
                (get_encoded_path_segment_count_local(encoded_path_value) <= 1) or
                (Length(query_syllables_local) <> input_syllable_count) then
            begin
                Exit;
            end;

            path_parts_local := encoded_path_value.Split([c_segment_path_separator]);
            segment_start_local := 0;
            for part_idx_local := 0 to High(path_parts_local) do
            begin
                segment_text_local := Trim(path_parts_local[part_idx_local]);
                segment_units_local :=
                    get_candidate_text_unit_count(segment_text_local);
                if (segment_text_local = '') or (segment_units_local <= 0) then
                begin
                    Exit;
                end;

                if segment_units_local > 1 then
                begin
                    query_key_local := build_segment_query_key_local(
                        segment_start_local, segment_units_local);
                    if not segment_text_is_visible_primary_local(query_key_local,
                        segment_text_local, segment_units_local) then
                    begin
                        Exit(True);
                    end;
                end;
                Inc(segment_start_local, segment_units_local);
            end;
        end;

        function candidate_has_nonprimary_path_local(
            const candidate: TncCandidate; const candidate_index: Integer): Boolean;
        var
            encoded_path_local: string;
        begin
            encoded_path_local := get_segment_path_for_candidate(candidate,
                candidate_index);
            Result := path_has_nonprimary_multi_char_segment_local(
                encoded_path_local);
        end;

        function visible_text_has_nonprimary_path_local(
            const text_value: string): Boolean;
        var
            visible_idx_local: Integer;
        begin
            Result := False;
            if text_value = '' then
            begin
                Exit;
            end;

            for visible_idx_local := 0 to High(candidates) do
            begin
                if (Trim(candidates[visible_idx_local].comment) = '') and
                    SameText(Trim(candidates[visible_idx_local].text),
                    text_value) then
                begin
                    Exit(candidate_has_nonprimary_path_local(
                        candidates[visible_idx_local], visible_idx_local));
                end;
            end;
        end;

        function has_explicit_query_choice_local(
            const candidate: TncCandidate; const candidate_text: string): Boolean;
        begin
            Result := (candidate.source = cs_user) or
                is_latest_session_query_choice(candidate_text) or
                ((latest_choice_text_local <> '') and SameText(candidate_text,
                latest_choice_text_local)) or
                ((normalized_query_local <> '') and (m_dictionary <> nil) and
                (m_dictionary.get_query_choice_bonus(normalized_query_local,
                candidate_text) > 0));
        end;
    begin
        if (m_dictionary = nil) or (lookup_text = '') or
            (not is_full_pinyin_key(lookup_text)) or
            (input_syllable_count < 4) then
        begin
            Exit;
        end;

        if not lookup_exact_full_pinyin_cached_local(lookup_text,
            exact_results_local) then
        begin
            Exit;
        end;

        normalized_query_local := normalize_pinyin_text(lookup_text);
        latest_choice_text_local := '';
        if normalized_query_local <> '' then
        begin
            latest_choice_text_local := get_cached_query_latest_choice_text(
                normalized_query_local);
        end;
        query_syllables_local := get_effective_compact_pinyin_syllables(
            lookup_text);

        best_visible_idx_local := -1;
        best_visible_weight_local := Low(Integer);
        for idx_local := 0 to High(candidates) do
        begin
            if Trim(candidates[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(candidates[idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;
            candidate_weight_local := get_visible_candidate_weight_local(
                candidates[idx_local]);
            if candidate_has_nonprimary_path_local(candidates[idx_local],
                idx_local) then
            begin
                Dec(candidate_weight_local, 240000);
            end;
            if candidate_weight_local > best_visible_weight_local then
            begin
                best_visible_weight_local := candidate_weight_local;
                best_visible_idx_local := idx_local;
            end;
        end;

        best_idx_local := -1;
        best_weight_local := Low(Integer);
        for idx_local := 0 to High(exact_results_local) do
        begin
            if Trim(exact_results_local[idx_local].comment) <> '' then
            begin
                Continue;
            end;
            candidate_text_local := Trim(exact_results_local[idx_local].text);
            if (candidate_text_local = '') or
                (get_candidate_text_unit_count(candidate_text_local) <>
                input_syllable_count) then
            begin
                Continue;
            end;
            candidate_weight_local := get_exact_candidate_weight_local(
                exact_results_local[idx_local], candidate_text_local);
            if visible_text_has_nonprimary_path_local(candidate_text_local) and
                (not has_explicit_query_choice_local(
                exact_results_local[idx_local], candidate_text_local)) then
            begin
                Continue;
            end;
            if candidate_weight_local > best_weight_local then
            begin
                best_weight_local := candidate_weight_local;
                best_idx_local := idx_local;
            end;
        end;

        if best_idx_local < 0 then
        begin
            if best_visible_idx_local < 0 then
            begin
                Exit;
            end;
            candidate_text_local := Trim(candidates[best_visible_idx_local].text);
        end
        else if ((exact_results_local[best_idx_local].source <> cs_user) or
            (best_weight_local >= best_visible_weight_local + 512)) then
        begin
            candidate_text_local := Trim(exact_results_local[best_idx_local].text);
        end
        else if best_visible_idx_local >= 0 then
        begin
            candidate_text_local := Trim(candidates[best_visible_idx_local].text);
        end
        else
        begin
            candidate_text_local := Trim(exact_results_local[best_idx_local].text);
        end;
        if (Length(candidates) > 0) and
            SameText(Trim(candidates[0].text), candidate_text_local) and
            (Trim(candidates[0].comment) = '') then
        begin
            Exit;
        end;

        existing_idx_local := -1;
        for idx_local := 0 to High(candidates) do
        begin
            if (Trim(candidates[idx_local].comment) = '') and
                SameText(Trim(candidates[idx_local].text), candidate_text_local) then
            begin
                existing_idx_local := idx_local;
                Break;
            end;
        end;

        if existing_idx_local >= 0 then
        begin
            picked_local := candidates[existing_idx_local];
        end
        else
        begin
            picked_local := exact_results_local[best_idx_local];
            picked_local.comment := '';
            if picked_local.score < 0 then
            begin
                picked_local.score := 0;
            end;
        end;

        if existing_idx_local > 0 then
        begin
            for move_idx_local := existing_idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_local;
        end
        else if existing_idx_local < 0 then
        begin
            SetLength(candidates, Length(candidates) + 1);
            for move_idx_local := High(candidates) downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_local;
        end;
    end;

    function promote_stable_prefix_partial_candidate_local(
        var candidates: TncCandidateList; const min_head_units: Integer): Boolean;
    const
        c_prefix_head_unit_bonus = 64;
        c_prefix_tail_unit_penalty = 32;
        c_prefix_support_rank_max_syllables = 6;
        c_prefix_support_rank_max_candidates = 24;
    var
        idx_local: Integer;
        move_idx_local: Integer;
        picked_idx_local: Integer;
        head_units_local: Integer;
        tail_units_local: Integer;
        head_syllables_local: Integer;
        tail_key_local: string;
        head_query_key_local: string;
        picked_local: TncCandidate;
        best_head_units_local: Integer;
        best_score_local: Integer;
        best_rank_score_local: Integer;
        candidate_score_local: Integer;
        candidate_rank_score_local: Integer;
        best_reliable_local: Boolean;
        candidate_reliable_local: Boolean;
        query_syllables_local: TncPinyinParseResult;
        support_segments_local: Integer;
        support_path_local: string;
        rank_debug_local: string;

        function build_query_prefix_key_local(
            const prefix_syllable_count: Integer): string;
        var
            syllable_idx_local: Integer;
        begin
            Result := '';
            if (prefix_syllable_count <= 0) or
                (prefix_syllable_count > Length(query_syllables_local)) then
            begin
                Exit;
            end;

            for syllable_idx_local := 0 to prefix_syllable_count - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    query_syllables_local[syllable_idx_local].text);
            end;
        end;

        function get_stable_single_text_local(const syllable_text: string): string;
        var
            normalized_syllable_local: string;
            lookup_results_local: TncCandidateList;
            idx_local: Integer;
            candidate_text_local: string;
        begin
            Result := '';
            normalized_syllable_local := normalize_pinyin_text(syllable_text);
            if (normalized_syllable_local = '') or (m_dictionary = nil) or
                (not m_dictionary.lookup(normalized_syllable_local,
                lookup_results_local)) then
            begin
                Exit;
            end;

            for idx_local := 0 to High(lookup_results_local) do
            begin
                if Trim(lookup_results_local[idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                candidate_text_local := Trim(lookup_results_local[idx_local].text);
                if (candidate_text_local <> '') and
                    (get_candidate_text_unit_count(candidate_text_local) = 1) then
                begin
                    Result := candidate_text_local;
                    Exit;
                end;
            end;
        end;

        function has_strong_phrase_for_head_local(
            const prefix_syllable_count: Integer): Boolean;
        var
            prefix_key_local: string;
            prefix_results_local: TncCandidateList;
            prefix_idx_local: Integer;
            prefix_text_local: string;
        begin
            Result := False;
            if (prefix_syllable_count < 2) or (m_dictionary = nil) or
                (Length(query_syllables_local) <> input_syllable_count) then
            begin
                Exit;
            end;

            prefix_key_local := build_query_prefix_key_local(prefix_syllable_count);
            if prefix_key_local = '' then
            begin
                Exit;
            end;

            if not (m_dictionary.lookup_exact_full_pinyin(prefix_key_local,
                prefix_results_local) or
                m_dictionary.lookup(prefix_key_local, prefix_results_local)) then
            begin
                Exit;
            end;

            for prefix_idx_local := 0 to High(prefix_results_local) do
            begin
                if Trim(prefix_results_local[prefix_idx_local].comment) <> '' then
                begin
                    Continue;
                end;
                prefix_text_local := Trim(prefix_results_local[prefix_idx_local].text);
                if get_candidate_text_unit_count(prefix_text_local) =
                    prefix_syllable_count then
                begin
                    Exit(True);
                end;
            end;
        end;

        function get_natural_prefix_adjustment_local(
            const candidate_text: string; const head_units: Integer): Integer;
        var
            candidate_units_local: TArray<string>;
            anchor_syllables_local: Integer;
            anchor_key_local: string;
            anchor_results_local: TncCandidateList;
            anchor_idx_local: Integer;
            anchor_text_local: string;
            anchor_units_local: TArray<string>;
            unit_idx_local: Integer;
            mismatch_local: Boolean;
            stable_text_local: string;
            occupied_units_local: TArray<Boolean>;
            covered_units_local: Integer;
            span_len_local: Integer;
            start_idx_local: Integer;
            query_span_key_local: string;
            span_text_local: string;
            preferred_text_local: string;
            preferred_bonus_local: Integer;
            exact_results_local: TncCandidateList;
            exact_idx_local: Integer;
            exact_text_local: string;
            exact_score_local: Integer;
            best_exact_score_local: Integer;

            function build_query_span_key_local(const local_start_idx: Integer;
                const local_span_len: Integer): string;
            var
                local_idx: Integer;
            begin
                Result := '';
                if (local_start_idx < 0) or (local_span_len <= 0) or
                    (local_start_idx + local_span_len > Length(query_syllables_local)) then
                begin
                    Exit;
                end;
                for local_idx := local_start_idx to
                    local_start_idx + local_span_len - 1 do
                begin
                    Result := Result + normalize_pinyin_text(
                        query_syllables_local[local_idx].text);
                end;
            end;

            function join_units_local(const local_start_idx: Integer;
                const local_span_len: Integer): string;
            var
                local_idx: Integer;
            begin
                Result := '';
                for local_idx := local_start_idx to
                    local_start_idx + local_span_len - 1 do
                begin
                    Result := Result + candidate_units_local[local_idx];
                end;
            end;

            function any_occupied_local(const local_start_idx: Integer;
                const local_span_len: Integer): Boolean;
            var
                local_idx: Integer;
            begin
                Result := False;
                for local_idx := local_start_idx to
                    local_start_idx + local_span_len - 1 do
                begin
                    if occupied_units_local[local_idx] then
                    begin
                        Exit(True);
                    end;
                end;
            end;
        begin
            Result := 0;
            if Length(query_syllables_local) <> input_syllable_count then
            begin
                Exit;
            end;
            candidate_units_local := split_text_units(Trim(candidate_text));
            if Length(candidate_units_local) <> head_units then
            begin
                Exit;
            end;

            for anchor_syllables_local := 2 to Min(3, head_units) do
            begin
                anchor_key_local := build_query_prefix_key_local(
                    anchor_syllables_local);
                if (anchor_key_local = '') or (m_dictionary = nil) then
                begin
                    Continue;
                end;
                if not (m_dictionary.lookup_exact_full_pinyin(anchor_key_local,
                    anchor_results_local) or
                    m_dictionary.lookup(anchor_key_local, anchor_results_local)) then
                begin
                    Continue;
                end;

                anchor_text_local := '';
                for anchor_idx_local := 0 to High(anchor_results_local) do
                begin
                    if Trim(anchor_results_local[anchor_idx_local].comment) <> '' then
                    begin
                        Continue;
                    end;
                    anchor_text_local := Trim(anchor_results_local[anchor_idx_local].text);
                    if get_candidate_text_unit_count(anchor_text_local) =
                        anchor_syllables_local then
                    begin
                        Break;
                    end;
                    anchor_text_local := '';
                end;
                if anchor_text_local = '' then
                begin
                    Continue;
                end;

                anchor_units_local := split_text_units(anchor_text_local);
                if Length(anchor_units_local) <> anchor_syllables_local then
                begin
                    Continue;
                end;

                mismatch_local := False;
                for unit_idx_local := 0 to anchor_syllables_local - 1 do
                begin
                    if not SameText(candidate_units_local[unit_idx_local],
                        anchor_units_local[unit_idx_local]) then
                    begin
                        mismatch_local := True;
                        Break;
                    end;
                end;
                if mismatch_local then
                begin
                    Dec(Result, 7000);
                end
                else
                begin
                    Inc(Result, 5200);
                end;
                Break;
            end;

            for unit_idx_local := 1 to head_units - 1 do
            begin
                stable_text_local := get_stable_single_text_local(
                    query_syllables_local[unit_idx_local].text);
                if (stable_text_local = '') or
                    (not has_strong_phrase_for_head_local(unit_idx_local)) then
                begin
                    Continue;
                end;
                if SameText(candidate_units_local[unit_idx_local],
                    stable_text_local) then
                begin
                    Inc(Result, 2800);
                end
                else
                begin
                    Dec(Result, 4200);
                end;
            end;

            SetLength(occupied_units_local, head_units);
            covered_units_local := 0;
            for span_len_local := Min(6, head_units) downto 2 do
            begin
                for start_idx_local := 0 to head_units - span_len_local do
                begin
                    if any_occupied_local(start_idx_local, span_len_local) then
                    begin
                        Continue;
                    end;

                    query_span_key_local := build_query_span_key_local(
                        start_idx_local, span_len_local);
                    if query_span_key_local = '' then
                    begin
                        Continue;
                    end;
                    span_text_local := join_units_local(start_idx_local,
                        span_len_local);
                    if span_text_local = '' then
                    begin
                        Continue;
                    end;

                    if try_get_preferred_query_phrase_text_local(
                        query_span_key_local, preferred_text_local,
                        preferred_bonus_local) then
                    begin
                        if not SameText(span_text_local, preferred_text_local) then
                        begin
                            if span_len_local >= 3 then
                            begin
                                Dec(Result, span_len_local * 2400);
                            end;
                            Continue;
                        end;

                        for unit_idx_local := start_idx_local to
                            start_idx_local + span_len_local - 1 do
                        begin
                            occupied_units_local[unit_idx_local] := True;
                        end;
                        Inc(covered_units_local, span_len_local);
                        Inc(Result, span_len_local * 2200);
                        Inc(Result, Min(2400, Max(0, preferred_bonus_local)));
                        Continue;
                    end;

                    exact_score_local := Low(Integer);
                    best_exact_score_local := Low(Integer);
                    if (m_dictionary <> nil) and
                        lookup_exact_full_pinyin_cached_local(
                        query_span_key_local, exact_results_local) then
                    begin
                        for exact_idx_local := 0 to High(exact_results_local) do
                        begin
                            if Trim(exact_results_local[exact_idx_local].comment) <> '' then
                            begin
                                Continue;
                            end;
                            exact_text_local := Trim(
                                exact_results_local[exact_idx_local].text);
                            if (exact_text_local = '') or
                                (get_candidate_text_unit_count(exact_text_local) <>
                                span_len_local) then
                            begin
                                Continue;
                            end;
                            if exact_results_local[exact_idx_local].score >
                                best_exact_score_local then
                            begin
                                best_exact_score_local :=
                                    exact_results_local[exact_idx_local].score;
                            end;
                            if SameText(exact_text_local, span_text_local) then
                            begin
                                exact_score_local :=
                                    exact_results_local[exact_idx_local].score;
                            end;
                        end;
                    end;

                    if (exact_score_local = Low(Integer)) or
                        ((span_len_local = 2) and (exact_score_local < 4096)) then
                    begin
                        if (span_len_local >= 3) and
                            (best_exact_score_local >= 8192) then
                        begin
                            Dec(Result, span_len_local * 2200);
                        end;
                        Continue;
                    end;

                    for unit_idx_local := start_idx_local to
                        start_idx_local + span_len_local - 1 do
                    begin
                        occupied_units_local[unit_idx_local] := True;
                    end;
                    Inc(covered_units_local, span_len_local);
                    Inc(Result, span_len_local * 1500);
                    Inc(Result, Min(1600, Max(0, exact_score_local div 8)));
                end;
            end;

            if covered_units_local >= Max(4, head_units - 2) then
            begin
                Inc(Result, 3200);
            end;
        end;
    begin
        Result := False;
        picked_idx_local := -1;
        best_head_units_local := -1;
        best_score_local := Low(Integer);
        best_rank_score_local := Low(Integer);
        best_reliable_local := False;
        if Length(candidates) = 0 then
        begin
            Exit;
        end;
        rank_debug_local := '';
        if is_full_pinyin_key(lookup_text) then
        begin
            query_syllables_local := get_effective_compact_pinyin_syllables(
                lookup_text);
        end
        else
        begin
            SetLength(query_syllables_local, 0);
        end;

        for idx_local := 0 to High(candidates) do
        begin
            tail_key_local := normalize_pinyin_text(Trim(candidates[idx_local].comment));
            if tail_key_local = '' then
            begin
                Continue;
            end;

            head_units_local :=
                get_candidate_text_unit_count(Trim(candidates[idx_local].text));
            if head_units_local < min_head_units then
            begin
                Continue;
            end;

            tail_units_local := get_effective_compact_pinyin_unit_count(
                tail_key_local);
            if (tail_units_local <= 0) and has_safe_trailing_initial_typing_state then
            begin
                tail_units_local := 1;
            end;
            if tail_units_local <= 0 then
            begin
                Continue;
            end;
            head_syllables_local := input_syllable_count - tail_units_local;
            if head_syllables_local <= 0 then
            begin
                Continue;
            end;

            if (input_syllable_count >= 8) and (head_units_local < 3) then
            begin
                Continue;
            end;

            candidate_score_local := candidates[idx_local].score;
            if candidates[idx_local].has_dict_weight and
                (candidates[idx_local].dict_weight > candidate_score_local) then
            begin
                candidate_score_local := candidates[idx_local].dict_weight;
            end;
            candidate_reliable_local :=
                (candidates[idx_local].has_dict_weight and
                (candidates[idx_local].dict_weight > 0)) or
                (candidates[idx_local].source = cs_user);

            candidate_rank_score_local := candidate_score_local;
            if (input_syllable_count <= c_prefix_support_rank_max_syllables) and
                (Length(candidates) <= c_prefix_support_rank_max_candidates) and
                (Length(query_syllables_local) = input_syllable_count) then
            begin
                head_query_key_local := build_query_prefix_key_local(
                    head_syllables_local);
                if head_query_key_local <> '' then
                begin
                    support_path_local := infer_segment_path_for_query_text_with_score(
                        head_query_key_local, Trim(candidates[idx_local].text),
                        candidate_score_local, support_segments_local);
                    if (support_path_local <> '') and
                        (candidate_score_local > candidate_rank_score_local) then
                    begin
                        candidate_rank_score_local := candidate_score_local;
                        candidate_reliable_local := True;
                    end;
                end;
            end;
            candidate_rank_score_local := candidate_rank_score_local +
                (head_units_local * c_prefix_head_unit_bonus) -
                (tail_units_local * c_prefix_tail_unit_penalty);
            Inc(candidate_rank_score_local,
                get_natural_prefix_adjustment_local(
                Trim(candidates[idx_local].text), head_units_local));
            if m_config.debug_mode and (idx_local <= 5) then
            begin
                rank_debug_local := rank_debug_local + Format(
                    ' prank[%d]=%s/%s hs=%d ts=%d rank=%d raw=%d rel=%d',
                    [idx_local, Trim(candidates[idx_local].text),
                    Trim(candidates[idx_local].comment), head_units_local,
                    tail_units_local, candidate_rank_score_local,
                    candidate_score_local, Ord(candidate_reliable_local)]);
            end;

            if ((candidate_reliable_local = best_reliable_local) and
                ((candidate_rank_score_local > best_rank_score_local) or
                ((candidate_rank_score_local = best_rank_score_local) and
                (head_units_local > best_head_units_local)) or
                ((candidate_rank_score_local = best_rank_score_local) and
                (head_units_local = best_head_units_local) and
                (candidate_score_local > best_score_local)))) or
                (candidate_reliable_local and (not best_reliable_local) and
                (candidate_rank_score_local + 96 >= best_rank_score_local)) or
                ((not candidate_reliable_local) and best_reliable_local and
                (candidate_rank_score_local > best_rank_score_local + 256)) then
            begin
                picked_idx_local := idx_local;
                best_head_units_local := head_units_local;
                best_score_local := candidate_score_local;
                best_rank_score_local := candidate_rank_score_local;
                best_reliable_local := candidate_reliable_local;
            end;
        end;

        if picked_idx_local < 0 then
        begin
            Exit;
        end;

        if picked_idx_local > 0 then
        begin
            picked_local := candidates[picked_idx_local];
            for move_idx_local := picked_idx_local downto 1 do
            begin
                candidates[move_idx_local] := candidates[move_idx_local - 1];
            end;
            candidates[0] := picked_local;
        end;
        if m_config.debug_mode and (rank_debug_local <> '') then
        begin
            m_last_full_path_debug_info := m_last_full_path_debug_info +
                rank_debug_local;
        end;
        Result := True;
    end;

    function prepare_prefix_partial_fast_exit_local(
        var candidates: TncCandidateList; const min_head_units: Integer): Boolean;
    begin
        if input_syllable_count >= 8 then
        begin
            Result := False;
            Exit;
        end;
        if has_full_query_exact_complete_candidate_local then
        begin
            Result := False;
            Exit;
        end;
        Result := promote_stable_prefix_partial_candidate_local(candidates,
            min_head_units);
        if Result and (Length(candidates) > 0) and
            (Trim(candidates[0].comment) = '') and
            (get_candidate_text_unit_count(Trim(candidates[0].text)) =
            input_syllable_count) and
            (not has_strong_top_complete_candidate_for_postprocess_lock_local(
            candidates)) then
        begin
            if m_config.debug_mode then
            begin
                m_last_full_path_debug_info := m_last_full_path_debug_info +
                    ' pfast=[defer-weak-complete]';
            end;
            Result := False;
        end;
    end;

    function top_candidate_has_preferred_subspan_coverage_for_fast_exit_local(
        const candidates: TncCandidateList): Boolean;
    const
        c_max_span = 6;
    var
        syllables_local: TncPinyinParseResult;
        top_units_local: TArray<string>;
        occupied_units_local: TArray<Boolean>;
        covered_units_local: Integer;
        required_units_local: Integer;
        start_idx_local: Integer;
        span_len_local: Integer;
        unit_idx_local: Integer;
        query_key_local: string;
        span_text_local: string;
        preferred_text_local: string;
        preferred_bonus_local: Integer;
        has_unmatched_preferred_anchor_local: Boolean;

        function build_query_key_local(const local_start_idx: Integer;
            const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + normalize_pinyin_text(
                    syllables_local[local_idx].text);
            end;
        end;

        function join_units_local(const local_start_idx: Integer;
            const local_span_len: Integer): string;
        var
            local_idx: Integer;
        begin
            Result := '';
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                Result := Result + top_units_local[local_idx];
            end;
        end;

        function any_occupied_local(const local_start_idx: Integer;
            const local_span_len: Integer): Boolean;
        var
            local_idx: Integer;
        begin
            Result := False;
            for local_idx := local_start_idx to
                local_start_idx + local_span_len - 1 do
            begin
                if occupied_units_local[local_idx] then
                begin
                    Exit(True);
                end;
            end;
        end;

        function has_fixed_boundary_single_local(const syllable_text: string): Boolean;
        var
            normalized_syllable_local: string;
        begin
            normalized_syllable_local := normalize_pinyin_text(syllable_text);
            Result := (normalized_syllable_local = 'ni') or
                (normalized_syllable_local = 'wo') or
                (normalized_syllable_local = 'ta') or
                (normalized_syllable_local = 'he') or
                (normalized_syllable_local = 'qu') or
                (normalized_syllable_local = 'shi') or
                (normalized_syllable_local = 'shuo') or
                (normalized_syllable_local = 'de') or
                (normalized_syllable_local = 'ba') or
                (normalized_syllable_local = 'yi') or
                (normalized_syllable_local = 'yu') or
                (normalized_syllable_local = 'zai') or
                (normalized_syllable_local = 'le') or
                (normalized_syllable_local = 'zhe') or
                (normalized_syllable_local = 'hui');
        end;

        function should_preoccupy_fixed_boundary_single_local(
            const syllable_text: string): Boolean;
        var
            normalized_syllable_local: string;
        begin
            normalized_syllable_local := normalize_pinyin_text(syllable_text);
            Result := (normalized_syllable_local = 'ni') or
                (normalized_syllable_local = 'wo') or
                (normalized_syllable_local = 'he') or
                (normalized_syllable_local = 'yu') or
                (normalized_syllable_local = 'de') or
                (normalized_syllable_local = 'shi') or
                (normalized_syllable_local = 'shuo') or
                (normalized_syllable_local = 'zai');
        end;
    begin
        Result := False;
        if (not has_complete_top_candidate_for_fast_exit_local(candidates)) or
            (input_syllable_count < 7) then
        begin
            Exit;
        end;

        syllables_local := get_effective_compact_pinyin_syllables(lookup_text);
        top_units_local := split_text_units(Trim(candidates[0].text));
        if (Length(syllables_local) <> input_syllable_count) or
            (Length(top_units_local) <> input_syllable_count) then
        begin
            Exit;
        end;

        SetLength(occupied_units_local, input_syllable_count);
        covered_units_local := 0;
        has_unmatched_preferred_anchor_local := False;
        for span_len_local := c_max_span downto 2 do
        begin
            for start_idx_local := 0 to input_syllable_count - span_len_local do
            begin
                if any_occupied_local(start_idx_local, span_len_local) then
                begin
                    Continue;
                end;

                query_key_local := build_query_key_local(start_idx_local,
                    span_len_local);
                if not try_get_preferred_query_phrase_text_local(query_key_local,
                    preferred_text_local, preferred_bonus_local) then
                begin
                    Continue;
                end;

                span_text_local := join_units_local(start_idx_local,
                    span_len_local);
                if not SameText(span_text_local, preferred_text_local) then
                begin
                    if span_len_local >= 4 then
                    begin
                        has_unmatched_preferred_anchor_local := True;
                    end;
                    Continue;
                end;

                for unit_idx_local := start_idx_local to
                    start_idx_local + span_len_local - 1 do
                begin
                    occupied_units_local[unit_idx_local] := True;
                end;
                Inc(covered_units_local, span_len_local);
            end;
        end;

        for unit_idx_local := 0 to input_syllable_count - 1 do
        begin
            if (not occupied_units_local[unit_idx_local]) and
                has_fixed_boundary_single_local(syllables_local[unit_idx_local].text) then
            begin
                occupied_units_local[unit_idx_local] := True;
                Inc(covered_units_local);
            end;
        end;

        required_units_local := Min(input_syllable_count,
            Max(8, input_syllable_count div 2));
        Result := (not has_unmatched_preferred_anchor_local) and
            (covered_units_local >= required_units_local);
    end;

