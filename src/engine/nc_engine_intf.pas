        function try_get_function_particle_boundary_alternative_local(
            const syllable_text_local: string; const current_text_local: string;
            const suffix_text_local: string; out out_text_local: string;
            out out_adjustment_local: Integer): Boolean;
        var
            normalized_syllable_local: string;
            suffix_first_unit_local: string;
            current_units_local: TArray<string>;
            prefix_text_local: string;
            left_unit_local: string;
            unit_idx_local: Integer;
            replacement_text_local: string;
        begin
            Result := False;
            out_text_local := '';
            out_adjustment_local := 0;
            if (current_text_local = '') or (suffix_text_local = '') or
                (get_candidate_text_unit_count(current_text_local) < 1) then
            begin
                Exit;
            end;

            normalized_syllable_local := normalize_pinyin_text(syllable_text_local);
            if normalized_syllable_local <> 'de' then
            begin
                Exit;
            end;

            suffix_first_unit_local :=
                get_first_text_unit_context_local(suffix_text_local);
            replacement_text_local := '';
            current_units_local := split_text_units(Trim(current_text_local));
            if Length(current_units_local) = 0 then
            begin
                Exit;
            end;
            left_unit_local := '';
            if Length(current_units_local) >= 2 then
            begin
                left_unit_local := current_units_local[High(current_units_local) - 1];
            end;

            if normalized_syllable_local = 'de' then
            begin
                if is_de_adverbial_predicate_head_unit_context_local(
                    suffix_first_unit_local) then
                begin
                    replacement_text_local := string(Char($5730));
                    out_adjustment_local := 42000;
                end
                else if is_result_complement_head_unit_context_local(
                    suffix_first_unit_local) then
                begin
                    replacement_text_local := string(Char($5F97));
                    out_adjustment_local := 18000;
                end;
            end;
            if replacement_text_local = '' then
            begin
                Exit;
            end;

            if Length(current_units_local) < 2 then
            begin
                Exit;
            end;

            if (replacement_text_local = string(Char($5730))) and
                (not is_de_adverbial_left_unit_context_local(left_unit_local)) then
            begin
                Exit;
            end;
            if (replacement_text_local = string(Char($5F97))) and
                (not is_predicate_head_unit_context_local(left_unit_local)) then
            begin
                Exit;
            end;

            if SameText(current_units_local[High(current_units_local)],
                replacement_text_local) then
            begin
                Exit;
            end;

            prefix_text_local := '';
            for unit_idx_local := 0 to High(current_units_local) - 1 do
            begin
                prefix_text_local := prefix_text_local +
                    current_units_local[unit_idx_local];
            end;
            out_text_local := prefix_text_local + replacement_text_local;
            Result := out_text_local <> '';
        end;

