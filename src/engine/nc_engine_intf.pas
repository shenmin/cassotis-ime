        function get_candidate_effective_weight_local(const local_candidate: TncCandidate): Integer;
        var
            local_units: Integer;
        begin
            Result := local_candidate.score;
            if Result <= 0 then
            begin
                if ((not is_fuzzy_pinyin_active) or
                    (local_candidate.fuzzy_cost <= 0)) and
                    local_candidate.has_dict_weight then
                begin
                    Result := local_candidate.dict_weight;
                end
                else
                begin
                    Result := 0;
                end;
            end
            else if ((not is_fuzzy_pinyin_active) or
                (local_candidate.fuzzy_cost <= 0)) and
                local_candidate.has_dict_weight then
            begin
                Result := Max(Result, local_candidate.dict_weight div 2);
            end;

            local_units := get_candidate_text_unit_count(Trim(local_candidate.text));
            case local_units of
                1:
                    if Result > 180 then
                    begin
                        Result := 180 + ((Result - 180) div 12);
                    end;
                2:
                    if Result > 240 then
                    begin
                        Result := 240 + ((Result - 240) div 10);
                    end;
            end;
        end;

        function get_candidate_raw_weight_local(const local_candidate: TncCandidate): Integer;
        begin
            if local_candidate.has_dict_weight then
            begin
                Result := local_candidate.dict_weight;
            end
            else
            begin
                Result := local_candidate.score;
            end;
        end;

