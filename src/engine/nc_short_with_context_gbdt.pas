function nc_short_with_context_score(const features: array of Double): Double;
var
    tree, node: Integer;
begin
    Result := 0.0;
    if Length(features) < c_short_with_context_feature_count then
        Exit;
    for tree := 0 to c_tree_count - 1 do
    begin
        node := c_roots[tree];
        while node >= 0 do
            if features[c_split_features[node]] <= c_thresholds[node] then
                node := c_left_children[node]
            else
                node := c_right_children[node];
        Result := Result + c_leaf_values[-node - 1];
    end;
end;

end.
